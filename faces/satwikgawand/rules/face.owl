face "rules" {
  // The rules and reminders you live by, filling a whole page left of home.
  // All of them are on show at once, sharing the screen; no scrolling.
  // A tap does nothing. A long press anywhere opens the editor, where the list
  // can be added to, changed, reordered and trimmed.

  meta {
    owl: 11
    description: "The rules and reminders you live by, filling a whole page. Hold anywhere to add, reorder and trim them."
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  // It runs no commands and needs no packages; declared so the store can say so.
  requires { pacman: [] }

  page: -1

  // Kept by the launcher across restarts. This is only the starting list:
  // long press to make it yours.
  state rules = [
    "Do the hardest thing first.",
    "Say no so you can say yes to what matters.",
    "Sleep is not negotiable.",
    "Slow is smooth, smooth is fast.",
    "Compare yourself to who you were yesterday."
  ] persist
  state editing = false
  state draft = ""
  state editIdx = -1
  // The rule last added or saved, marked in the list until the next tap, so
  // adding one says so.
  state justAdded = -1

  // A veil over the wallpaper, darker where the text sits.
  background: linear(0, 0, 0, 1, [alpha(background, 0.85), alpha(background, 0.3), alpha(background, 0.9)])
  // The rules run edge to edge: the container is the whole screen.
  padding: 0

  Box {
    fill: true
    // A long press no node takes opens the editor.
    onLongPress: { haptic(); editing = true }

    // Every rule at once, each taking an equal share of the screen.
    Column {
      fill: true
      gap: 0

      if len(rules) == 0 {
        Column {
          fill: true
          gap: 8
          align: center
          justify: center
          Text { text: "nothing to remember yet"; style: title; color: muted; align: center; padding: [24, 0] }
          Text { text: "hold anywhere to add your first rule"; style: small; color: muted; align: center; padding: [24, 0] }
        }
      } else {
        for r, i in rules {
          Box {
            fill: width
            weight: 1
            clip: true
            align: center
            Text {
              text: r
              fill: width
              align: center
              padding: [32, 12]
              fontSize: len(rules) <= 2 ? 36 : len(rules) <= 4 ? 28 : len(rules) <= 6 ? 22 : len(rules) <= 9 ? 17 : len(rules) <= 13 ? 14 : 12
              fontWeight: len(rules) <= 4 ? 300 : 400
            }
          }
          if i < len(rules) - 1 {
            Row {
              padding: [28, 0]
              gap: 0
              Box { weight: 1; height: 1; background: alpha(foreground, 0.1) }
            }
          }
        }
      }
    }

    // A whisper of a hint, in the corner the text doesn't reach.
    Box {
      fill: true
      align: bottomEnd
      Column {
        align: end
        Text { text: "hold to edit"; style: label; color: alpha(muted, 0.6); padding: [16, 10] }
        Spacer { height: screenInset }
      }
    }

    // The editor: a long press opens it; done closes it.
    if editing {
      Column {
        fill: true
        gap: 12
        padding: [20, 16]
        frost: 24
        background: alpha(background, 0.96)

        Row {
          align: center
          Text { text: "your rules"; style: title; weight: 1 }
          Text { text: "done"; style: body; color: accent; padding: [14, 6]; onTap: { haptic(); editing = false; justAdded = -1 } }
        }

        Column {
          gap: 8
          weight: 1
          scroll: true
          if len(rules) == 0 {
            Text { text: "tap a rule to change it, ✕ to drop it, ▲▼ to reorder"; style: small; color: muted; align: center; padding: 12 }
          }
          for r, i in rules {
            Row {
              gap: 10
              align: center
              padding: [12, 10]
              radius: 12 * corners
              background: i == editIdx ? alpha(accent, 0.18) : i == justAdded ? alpha(accent, 0.1) : alpha(surface, 0.5)
              Text {
                text: r
                weight: 1
                color: i == editIdx || i == justAdded ? accent : foreground
                onTap: { haptic(); draft = r; editIdx = i; justAdded = -1 }
              }
              Column {
                gap: 0
                align: center
                Text {
                  text: "▲"
                  style: small
                  color: i == 0 ? alpha(muted, 0.35) : muted
                  padding: [10, 5]
                  onTap: {
                  justAdded = -1
                  if i > 0 {
                    haptic()
                    rules = set(set(rules, i, rules[i - 1]), i - 1, r)
                    if editIdx == i { editIdx = i - 1 } else if editIdx == i - 1 { editIdx = i }
                  }
                }
                }
                Text {
                  text: "▼"
                  style: small
                  color: i == len(rules) - 1 ? alpha(muted, 0.35) : muted
                  padding: [10, 5]
                  onTap: {
                  justAdded = -1
                  if i < len(rules) - 1 {
                    haptic()
                    rules = set(set(rules, i, rules[i + 1]), i + 1, r)
                    if editIdx == i { editIdx = i + 1 } else if editIdx == i + 1 { editIdx = i }
                  }
                }
                }
              }
              Text {
                text: "✕"
                color: muted
                padding: [10, 8]
                onTap: {
                  haptic()
                  justAdded = -1
                  rules = remove(rules, i)
                  if editIdx == i {
                    editIdx = -1
                    draft = ""
                  } else if editIdx > i {
                    editIdx = editIdx - 1
                  }
                }
              }
            }
          }
        }

        // Add at the bottom, within reach of a thumb: the list is just above it,
        // so a rule goes in where the eye already is, marked as the one just
        // added. The keyboard's send key does the same.
        Row {
          gap: 8
          align: center
          Input {
            text: draft
            clear: true
            placeholder: editIdx >= 0 ? "edit the rule…" : "add a rule…"
            weight: 1
            onChange: { draft = value; justAdded = -1 }
            onSubmit: {
              let t = trim(value)
              haptic()
              if t != "" {
                if editIdx >= 0 {
                  justAdded = editIdx
                  rules = set(rules, editIdx, t)
                  editIdx = -1
                } else {
                  rules = [t] + rules
                  justAdded = 0
                }
              }
              draft = ""
            }
          }
          Button {
            text: editIdx >= 0 ? "save" : "add"
            color: trim(draft) == "" ? muted : accent
            onTap: {
              let t = trim(draft)
              haptic()
              if t != "" {
                if editIdx >= 0 {
                  justAdded = editIdx
                  rules = set(rules, editIdx, t)
                  editIdx = -1
                } else {
                  rules = [t] + rules
                  justAdded = 0
                }
              }
              draft = ""
            }
          }
        }

        // Lifts the add row above the keyboard while typing.
        Spacer { height: screenInset }
      }
    }
  }
}
