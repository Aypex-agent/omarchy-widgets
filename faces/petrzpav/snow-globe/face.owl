face "snow globe" {
  meta { owl: 21; description: "A pixel-art snow globe that fills up as you get ready for Christmas: gifts bought land under the tree, tasks done hang on it. Shake it to see what's left"; version: "1.0"; license: "MIT"; category: "fun" }

  // How it works: gifts and tasks are kept by the launcher (persist). What's done shows in the globe:
  // a box under the tree for each gift bought (wrapped ones get paper and a ribbon), an ornament for each
  // task done, the scene's extras at a quarter and at half, lights (and the northern lights) at three
  // quarters, and the star when it's all done. Four scenes, picked with the arrows on the stand. The art
  // is ASCII pixel art whose letters are colors mixed from the theme (PAL), so it follows theme changes.
  // The snow is ~70 flakes moved in `every frame` along the phone's real gravity (android.motion):
  // tilting tips it, and a quick turn or shake (the tilt changing fast) or a tap stirs it up. As it
  // stirs, the globe picks one thing still to do and shows it.

  padding: 0
  background: linear(0, 0, 0, 1, [alpha(background, 0.92), alpha(background, 0.72), alpha(background, 0.95)])

  source now = clock every 1m
  source m = android.motion

  strings {
    en {
      untilXmas: d => d == 1 ? "day until Christmas" : "days until Christmas"
      today: "It's Christmas!"
      after: "Merry Christmas!"
      left: n => n == 0 ? "all ready" : (n == 1 ? "1 thing left" : "${n} things left")
      empty: "add gifts and tasks below"
      shakeHint: "shake the phone or tap the globe"
      scene: i => ["Forest cabin", "Village", "Mountains", "North Pole"][i]
      gifts: "Gifts"
      tasks: "To do"
      idea: "idea"
      bought: "bought"
      wrapped: "wrapped"
      giftPh: "Who: what 30"
      noGifts: "Add who you're buying for, like \"Anna: scarf 30\". Every gift you buy lands under the tree."
      taskPh: "Add a task…"
      spent: a => "spent ${a} of"
      budget: "set budget"
      helpGifts: "enter: add · tap: idea → bought → wrapped · hold: delete"
      helpTasks: "enter: add · tap: done · hold: delete"
      helpEggs: "find all ten and the snow turns gold · hold the countdown for a full globe"
      locked: "from 25 % of your list"
      spentOnly: a => "spent ${a}"
      eggs: "Secrets"
      eggName: i => ["Moon wink", "Flying hat", "Rudolph", "Chimney Santa", "Midnight bell", "Igloo guest", "Ticklish penguin", "Gift from the sky", "Wish", "Upside down"][i]
      eggHint: i => ["Say hello to the moon.", "Someone's hat sits loose.", "Boop a red nose in the mountains.", "Who's stuck in the chimney?", "Ring for midnight mass.", "Knock on the ice house.", "Tickle whoever walks past the stand.", "Catch the sleigh as it flies over.", "Make a wish on a falling star.", "Turn the world upside down."][i]
      found: (name, n, t) => "Secret ${n}/${t}: ${name}"
      allEggs: "All ten secrets found! The snow turns gold."
      undo: "undo"
      needGift: w => "${w} has no gift yet"
      needWrap: w => "Wrap the gift for ${w}"
      todo: t => "Still to do: ${t}"
      allDone: "All done. Happy holidays!"
      seeds: "Put up the snow globe|Bake cookies|Get a tree|Decorate the tree|Send cards|Plan Christmas dinner|Clean up"
      preview: "preview · hold the number to leave"
    }
    cs {
      untilXmas: d => d == 1 ? "den do Štědrého dne" : (d >= 2 && d <= 4 ? "dny do Štědrého dne" : "dní do Štědrého dne")
      today: "Dnes je Štědrý den!"
      after: "Veselé Vánoce!"
      left: n => n == 0 ? "vše připraveno" : (n == 1 ? "zbývá 1 věc" : (n <= 4 ? "zbývají ${n} věci" : "zbývá ${n} věcí"))
      empty: "dole přidej dárky a úkoly"
      shakeHint: "zatřes telefonem nebo klepni na kouli"
      scene: i => ["Lesní chaloupka", "Vesnice", "Hory", "Severní pól"][i]
      gifts: "Dárky"
      tasks: "Úkoly"
      idea: "nápad"
      bought: "koupeno"
      wrapped: "zabaleno"
      giftPh: "Komu: co 500"
      noGifts: "Přidej, komu kupuješ, třeba „Anna: šála 500“. Každý koupený dárek přistane pod stromkem."
      taskPh: "Přidat úkol…"
      spent: a => "utraceno ${a} z"
      budget: "nastav rozpočet"
      helpGifts: "enter: přidat · klepni: nápad → koupeno → zabaleno · podrž: smazat"
      helpTasks: "enter: přidat · klepni: hotovo · podrž: smazat"
      helpEggs: "najdi všech deset a sníh zezlátne · podrž číslo dní pro plnou kouli"
      locked: "od 25 % seznamu"
      spentOnly: a => "utraceno ${a}"
      eggs: "Tajemství"
      eggName: i => ["Mrkající měsíc", "Létající klobouk", "Rudolf", "Santa v komíně", "Zvon na půlnoční", "Host v iglú", "Lechtivý tučňák", "Dárek z nebe", "Přání", "Vzhůru nohama"][i]
      eggHint: i => ["Pozdrav měsíc.", "Někomu nedrží klobouk.", "Zmáčkni červený nos v horách.", "Kdo uvízl v komíně?", "Zazvoň na půlnoční.", "Zaklepej na ledový dům.", "Polechtej toho, kdo chodí kolem podstavce.", "Chyť sáně, až poletí kolem.", "Přej si něco, když padá hvězda.", "Obrať svět vzhůru nohama."][i]
      found: (name, n, t) => "Tajemství ${n}/${t}: ${name}"
      allEggs: "Všech deset tajemství nalezeno! Sníh zezlátne."
      undo: "vrátit"
      needGift: w => "${w} ještě nemá dárek"
      needWrap: w => "Zabalit dárek: ${w}"
      todo: t => "Ještě: ${t}"
      allDone: "Vše hotovo. Krásné svátky!"
      seeds: "Postavit sněžnou kouli|Upéct cukroví|Koupit stromek|Ozdobit stromek|Koupit kapra|Napsat přáníčka|Uklidit"
      preview: "ukázka · podrž číslo pro návrat"
    }
  }

  // {id, who, what, price, st}: st 0 idea, 1 bought, 2 wrapped
  state gifts = [] persist
  // {id, name, done}; null until the first start fills in a few to begin with
  state tasks = null persist
  state budget = 0 persist
  state tab = "gifts" persist
  state scene = 0 persist
  state shaken = false persist
  state addReq = null
  state undo = null
  // a full globe for screenshots, without touching the lists
  state demo = false

  // the snow: x, y in globe radii from its middle (y down), speed, settled, fall speed, phase
  state flakes = range(70).map(i => {x: random() * 1.6 - 0.8, y: random() * 1.1 - 0.95, vx: 0, vy: 0, s: false, f: 0.2 + random() * 0.22, ph: random() * 6.28})
  state calm = false
  state pm = null
  state shakeE = 0
  state kick = 0
  state gt = 0
  state hint = ""
  state hintAt = -100
  state hintFor = 12
  // Now and then something happens: a sleigh flies over the page, a star shoots across the globe, a penguin
  // walks along the stand, and the snowman's hat jumps off when the globe is shaken.
  state flyAt = -100
  state nextFly = random(6, 12)
  state shootAt = -100
  state nextShoot = random(8, 20)
  state walkAt = -100
  state nextWalk = random(15, 25)
  state hatAt = -100
  // Easter eggs: ten hidden things to find, kept across restarts. A tap on a spot in the scene, on the walking
  // penguin, on a shooting star or on the flying sleigh finds one; so does holding the phone upside down.
  state eggs = [] persist
  state foundReq = null
  // the egg playing in the scene now: {id, at, p}
  state egg = null
  state slipAt = -100
  state wishAt = -100
  state dropAt = -100
  state dropX = 0
  state dropY = 0
  state upT = 0
  state pdt = 0

  when tasks == null { tasks = split(str.seeds, "|").map((s, i) => {id: i + 1, name: s, done: i == 0}) }

  let EGG_IDS = ["moon", "snowman", "rudolph", "chimney", "bell", "igloo", "penguin", "sleigh", "wish", "upside"]
  // the progress a secret needs before its spot shows up anywhere
  let EGG_LV = [0, 0.25, 0.25, 0, 0, 0.25, 0, 0, 0, 0]

  when foundReq != null {
    let id = foundReq
    if !contains(eggs, id) {
      eggs = eggs + [id]
      hint = len(eggs) >= len(EGG_IDS) ? str.allEggs : str.found(str.eggName(indexOf(EGG_IDS, id)), len(eggs), len(EGG_IDS))
      hintAt = gt - 0.8
      hintFor = 5
      haptic()
    }
    foundReq = null
  }

  when addReq != null {
    let v = trim(addReq)
    if v != "" {
      if tab == "gifts" {
        let pm2 = match(v, "^(.*?)[\\s,;]*(\\d+)\\s*(?:kč|Kč|KČ|,-|€|\\$|£|eur|EUR|usd|USD)?$")
        let body = pm2 == null ? v : trim(pm2[0])
        let price = pm2 == null ? 0 : num(pm2[1], 0)
        let sep = contains(body, ":") ? ":" : " - "
        let parts = split(body, sep)
        let who = trim(parts[0])
        let what = trim(join(drop(parts, 1), sep))
        gifts = gifts + [{id: random(1000000000), who: who == "" ? v : who, what: what, price: price, st: 0}]
      } else {
        tasks = (tasks ?? []) + [{id: random(1000000000), name: v, done: false}]
      }
      undo = null
    }
    addReq = null
  }

  // Light themes: Omarchy themes say "mode = light" in colors.toml. There the globe keeps its night by
  // swapping background and foreground; without Linux (no files to read) it takes the theme as dark.
  source styleToml = file("~/.config/omalauncher/style/style.toml") optional
  let themeName = (match(styleToml ?? "", "(?m)^theme\\s*=\\s*\"([^\"]+)\"") ?? ["-"])[0]
  source themeToml = file("~/.config/omarchy/themes/${themeName}/colors.toml") optional
  let LIGHT = contains(themeToml ?? "", "mode = \"light\"")
  let NIGHT = LIGHT ? foreground : background
  let SNOW = LIGHT ? background : foreground

  // ---- ART: made by /root/src/omalauncher-snowglobe/art2.py from ASCII art; letters are theme colors (PAL) ----
  let PAL = {
    a: mix(NIGHT, blue, 0.07),
    b: mix(NIGHT, blue, 0.11),
    c: mix(NIGHT, blue, 0.15),
    d: mix(mix(NIGHT, blue, 0.2), magenta, 0.06),
    e: mix(mix(NIGHT, blue, 0.24), magenta, 0.12),
    u: mix(NIGHT, blue, 0.05),
    v: mix(NIGHT, blue, 0.1),
    x: mix(NIGHT, mix(blue, magenta, 0.5), 0.17),
    M: mix(NIGHT, mix(blue, magenta, 0.5), 0.27),
    w: mix(SNOW, mix(blue, magenta, 0.5), 0.38),
    L: mix(SNOW, blue, 0.5),
    S: SNOW,
    s: mix(SNOW, blue, 0.14),
    t: mix(mix(SNOW, blue, 0.4), NIGHT, 0.32),
    T: mix(mix(SNOW, blue, 0.4), NIGHT, 0.55),
    G: mix(green, NIGHT, 0.18),
    g: mix(green, NIGHT, 0.42),
    E: mix(green, NIGHT, 0.66),
    K: mix(orange, NIGHT, 0.38),
    k: mix(orange, NIGHT, 0.6),
    m: mix(SNOW, yellow, 0.25),
    n: mix(mix(SNOW, yellow, 0.25), NIGHT, 0.25),
    y: yellow,
    Y: mix(yellow, NIGHT, 0.72),
    W: mix(yellow, SNOW, 0.55),
    r: red,
    R: mix(red, NIGHT, 0.42),
    j: mix(NIGHT, SNOW, 0.08),
    J: mix(NIGHT, SNOW, 0.24),
    l: orange,
    i: mix(SNOW, NIGHT, 0.5),
    I: mix(SNOW, NIGHT, 0.68),
    A: mix(magenta, NIGHT, 0.5),
    B: mix(magenta, NIGHT, 0.68),
    C: mix(blue, NIGHT, 0.55),
    D: mix(blue, NIGHT, 0.72),
    F: mix(orange, NIGHT, 0.45),
    f: mix(orange, NIGHT, 0.62),
    H: mix(orange, SNOW, 0.45),
    o: alpha(mix(muted, SNOW, 0.35), 0.55),
    O: alpha(muted, 0.32),
    h: alpha(SNOW, 0.5),
    p: mix(NIGHT, accent, 0.24),
    P: mix(NIGHT, accent, 0.08),
    q: mix(accent, NIGHT, 0.52),
    Q: mix(accent, NIGHT, 0.28),
    U: accent,
    z: alpha(NIGHT, 0.55)
  }
  let ART_W = 132
  let ART_H = 148
  let ART_CX = 66
  let ART_CY = 62
  let ART_R = 59.0
  let ART_S = 2
  let STAND_Y = 112
  let PLAQUE_Y = 126
  let ARROWS = [24, 102, 122]
  let TREE = [
    ".......................G.......................",
    ".......................G.......................",
    "......................GEE......................",
    "......................ggE......................",
    ".....................SGgEE.....................",
    "....................GGGggEE....................",
    "....................GGGggEE....................",
    "....................SggggEE....................",
    "...................GGGgggEEE...................",
    "..................GGGGgggEEEE..................",
    "..................SGGGggggEEE..................",
    "..................GGgGEgggEEE..................",
    ".................GSSGSSgggEssE.................",
    "................GSSGSSgEggEsEsE................",
    "................SSGSSgSggggEssE................",
    ".................g..gGgEEEE..E.................",
    ".................g.SEGEgEgEE.E.................",
    ".................EGEGEgEgEEEEE.................",
    "..................GGGGgggggEE..................",
    ".................SgGGGggggEEEE.................",
    "................GGGGGEggggggEEE................",
    "..............GGGGGGGggggggEEEEEE..............",
    "...............SGGGGGgEggggEgEEE...............",
    "..............GGGgGGGgggggggEEEEE..............",
    ".............SGSSGSSgggEggggEgEsEs.............",
