        "................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt................",
        ".................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt.................",
        ".................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt.................",
        "..................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt..................",
        "...................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt...................",
        "....................ttttsssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssstttt....................",
        "....................tttttssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssttttt....................",
        ".....................ttttttststststststststststststststststststststststststststststststststststststststststtttt.....................",
        "......................ttttttstststststststststststststststststststststststststststststststststststststststtttt......................",
        ".......................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt.......................",
        "........................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt........................",
        ".........................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt.........................",
        "..........................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt..........................",
        "...........................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt...........................",
        "............................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt............................",
        "..............................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt..............................",
        "...............................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt...............................",
        "................................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt................................",
        "..................................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt..................................",
        "...................................tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt..................................."
      ]
    }
  ]
  // ---- END ART ----

  // the pixel font, from Google Fonts (OFL)
  let BLOCK = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"

  let demoGifts = [
    {id: 1, who: "Anna", what: "scarf", price: 30, st: 2}, {id: 2, who: "Dad", what: "book", price: 20, st: 2},
    {id: 3, who: "Mum", what: "mug", price: 15, st: 2}, {id: 4, who: "Tom", what: "lego", price: 60, st: 2},
    {id: 5, who: "Eva", what: "puzzle", price: 25, st: 2}, {id: 6, who: "Grandpa", what: "slippers", price: 25, st: 2},
    {id: 7, who: "Kim", what: "socks", price: 10, st: 2}, {id: 8, who: "Leo", what: "sled", price: 40, st: 2},
    {id: 9, who: "Mia", what: "paints", price: 18, st: 2}
  ]
  let demoTasks = split(str.seeds, "|").map((s, i) => {id: i + 1, name: s, done: true})
  let GL = demo ? demoGifts : gifts
  let TL = demo ? demoTasks : (tasks ?? [])
  let nBought = count(GL, g => g.st >= 1)
  let nWrapped = count(GL, g => g.st == 2)
  let nDone = count(TL, t => t.done)
  let total = len(TL) + 2 * len(GL)
  let prog = total == 0 ? 0 : (nDone + nBought + nWrapped) / total
  let leftN = len(TL) - nDone + len(GL) - nWrapped
  let spent = sum(GL.filter(g => g.st >= 1).map(g => g.price ?? 0))

  // Christmas Eve where it's the day (Czech, Slovak, German, Polish, Hungarian), Christmas Day elsewhere
  let yr = num(fmtTime(now, "yyyy"))
  let xday = contains(["cs", "sk", "de", "pl", "hu"], lang()) ? 24 : 25
  let today0 = parseTime(fmtTime(now, "yyyy-MM-dd"))
  let past = today0 > parseTime("${yr}-12-26")
  let xyear = past ? yr + 1 : yr
  let days = round((parseTime("${xyear}-12-${xday}") - today0) / 86400)

  let SC = SCENES[scene]
  // the ground's top in globe radii, column by column, for the snow to land on
  let GNDN = SC.gnd.map(v => (v - ART_CY) / ART_R)
  // ornaments and the lights' colors, from the theme
  let ORNC = [red, yellow, magenta, orange, accent, blue]
  let LITC = [yellow, red, accent, green]
  let WRAPS = [[red, yellow], [blue, yellow], [green, red], [magenta, yellow], [yellow, red], [orange, green]]
  let KRAFT = {V: mix(orange, NIGHT, 0.42), X: mix(orange, NIGHT, 0.6), Z: mix(orange, NIGHT, 0.72)}
  // a box under the tree for each gift bought, back row first
  let shown = GL.filter(g => g.st >= 1).take(9).map((g, i) => {
    k: floor(hash(g.id, 4) * 4), sx: SLOTS[i][0], sy: SLOTS[i][1],
    pal: g.st == 2 ? {V: WRAPS[floor(hash(g.id, 3) * 6)][0], X: mix(WRAPS[floor(hash(g.id, 3) * 6)][0], NIGHT, 0.4), Z: WRAPS[floor(hash(g.id, 3) * 6)][1], N: WRAPS[floor(hash(g.id, 3) * 6)][1]} : KRAFT
  }).sortBy(p => p.sy)

  // the page: portrait, the globe over the lists; wide (unfolded, sideways), side by side
  let W = tileWidth ?? 400
  let H = tileHeight ?? 800
  let wide = W > H
  let typing = (screenInset ?? 0) > 120
  // the size of an art pixel in dp, in half dp steps
  let PX = max(1, floor(4 * (wide ? min((W * 0.5 - 40) / ART_W, (H - 140) / ART_H) : min((W - 32) / ART_W, H * 0.45 / ART_H))) / 4)
  let CW = ART_W * PX
  let CH = ART_H * PX
  let hintOn = hint != "" && gt - hintAt > 0.8 && gt - hintAt < hintFor
  let flying = gt >= flyAt && gt - flyAt < 7
  let shooting = gt >= shootAt && gt - shootAt < 1.4
  let walking = gt >= walkAt && gt - walkAt < 6
  let hatting = gt >= hatAt && gt - hatAt < 1
  let eggOn = egg != null && gt >= egg.at && gt - egg.at < 2.5
  let busy = flying || shooting || walking || hatting || eggOn
  let golden = len(eggs) >= len(EGG_IDS)
  // frames: few while the snow lies still, more while it falls or something happens
  fps: calm && !busy ? 12 : 30

  // how much the tilt has to change, summed over about a third of a second: a little stirs the snow,
  // picking the phone up does about 0.5 to 1.2; a real shake shows what's left to do
  let SHAKE = 0.9
  let SHAKE_HINT = 1.6
  let RF = (ART_R - 1.5) / ART_R

  every frame {
    gt = gt + dt
    let has_motion = m.available == true
    if gt > nextFly { flyAt = gt; nextFly = gt + random(45, 110) }
    if gt > nextShoot { shootAt = gt; nextShoot = gt + random(12, 35) }
    if gt > nextWalk { walkAt = gt; nextWalk = gt + random(70, 160) }
    // holding the phone upside down for a moment and a half finds an egg
    upT = has_motion && m.y < -0.7 ? upT + dt : 0
    if upT > 1.5 { upT = -100; foundReq = "upside" }
    if nextFly > gt + 200 || nextShoot > gt + 100 || nextWalk > gt + 300 { nextFly = gt + 40; nextShoot = gt + 15; nextWalk = gt + 80 }
    let has = m.available == true
    let mx = has ? m.x : 0
    let my = has ? m.y : 1
    let mz = has ? m.z : 0
    // How far the tilt moved since the last frame. The first reading after the sensor starts, after a
    // pause (dt is capped at 0.1) or after a reload, can jump further in one frame than a hand moves it:
    // that's the globe catching up, not a shake.
    let delta = pm == null || !has ? 0 : abs(mx - pm[0]) + abs(my - pm[1]) + abs(mz - pm[2])
    let pause = dt >= 0.099 && pdt < 0.099
    let jump = delta > max(0.9, dt * 12) || pause
    pdt = dt
    pm = has ? [mx, my, mz] : null
    shakeE = shakeE * pow(0.03, dt) + (jump ? 0 : delta)
    // gravity across the screen; lying flat there's little, so the snow still drifts down slowly
    let glen = sqrt(mx * mx + my * my)
    let gX = mx
    let gY = glen < 0.6 ? my + 0.6 - glen : my
    let stir = shakeE > SHAKE ? min((shakeE - SHAKE) * 2, 3) : 0
    // a tap (kick 1.4) or a real shake picks what to show; the stand's arrows (kick 0.5) only stir the snow
    if (kick >= 1 || shakeE > SHAKE_HINT) && (calm || gt - hintAt > 10) {
      let cands = GL.filter(g => g.st == 0).map(g => str.needGift(g.who)) + GL.filter(g => g.st == 1).map(g => str.needWrap(g.who)) + TL.filter(t => !t.done).map(t => str.todo(t.name))
      hint = len(cands) > 0 ? cands[random(len(cands))] : (total == 0 ? str.empty : (days < 0 ? str.after : str.allDone))
      hintAt = gt
      hintFor = 12
      shaken = true
      haptic()
      if SC.hat != null && prog >= 0.25 && random() < 0.5 { hatAt = gt; foundReq = "snowman" }
      if !walking && random() < 0.35 { nextWalk = min(nextWalk, gt + 2) }
    }
    if kick > 0 {
      flakes = flakes.map(f => merge(f, {vx: f.vx + (random() - 0.5) * 2 * kick - gX * random() * kick, vy: f.vy + (random() - 0.5) * kick - gY * random() * kick * 1.6, s: false}))
      kick = 0
    }
    if stir > 0 {
      flakes = flakes.map(f => merge(f, {vx: f.vx + ((random() - 0.5) * 2 - gX * random()) * stir * 6 * dt, vy: f.vy + ((random() - 0.5) * 2 - gY * random() * 1.5) * stir * 6 * dt, s: false}))
    }
    // snow that lies somewhere comes loose once the globe turns away from it
    flakes = flakes.map(f => !f.s ? f : (f.y >= GNDN[clamp(floor(ART_CX + f.x * ART_R), 0, ART_W - 1)] - 0.02 ? (gY > 0.12 ? f : merge(f, {s: false})) : ((gX * f.x + gY * f.y) / max(sqrt(f.x * f.x + f.y * f.y), 0.01) > 0.55 ? f : merge(f, {s: false}))))
    if any(flakes, f => !f.s) {
      let ease = 1 - pow(0.3, dt)
      flakes = flakes
        .map(f => f.s ? f : merge(f, {vx: lerp(f.vx, gX * f.f + 0.05 * sin(gt * 1.3 + f.ph), ease), vy: lerp(f.vy, gY * f.f + 0.03 * cos(gt * 1.1 + f.ph), ease)}))
        .map(f => f.s ? f : merge(f, {x: f.x + f.vx * dt, y: f.y + f.vy * dt}))
        .map(f => f.s ? f : merge(f, {d: max(sqrt(f.x * f.x + f.y * f.y), 0.001)}))
        // the glass: slide along it, and rest on it where gravity presses the snow into it
        .map(f => f.s || f.d <= RF ? f : merge(f, {
          x: f.x * RF / f.d, y: f.y * RF / f.d,
          vx: f.vx - max(0, (f.vx * f.x + f.vy * f.y) / f.d) * f.x / f.d,
          vy: f.vy - max(0, (f.vx * f.x + f.vy * f.y) / f.d) * f.y / f.d,
          s: (gX * f.x + gY * f.y) / f.d > 0.75
        }))
        // the snowy ground
        .map(f => f.s || f.y < GNDN[clamp(floor(ART_CX + f.x * ART_R), 0, ART_W - 1)] ? f : merge(f, {y: GNDN[clamp(floor(ART_CX + f.x * ART_R), 0, ART_W - 1)], vy: min(f.vy, 0), vx: f.vx * 0.5, s: gY > 0.2}))
    }
    calm = all(flakes, f => f.s)
  }

  component Globe() {
    Box {
      ripple: false
      // a tap finds an egg where there's one to find, and otherwise shakes the globe
      onTap: {
        let ax = x / PX
        let ay = y / PX
        let pw = lerp(LIP[0], LIP[1], (gt - walkAt) / 6)
        let sst = min(1, (gt - shootAt) / 1.4)
        let shx = ART_CX - 0.6 * ART_R + hash(floor(shootAt), 1) * 0.35 * ART_R + sst * 34 * ART_S
        let shy = ART_CY - 0.82 * ART_R + hash(floor(shootAt), 2) * 0.2 * ART_R + sst * 12 * ART_S
        let spot = SC.spots.find(sp => prog >= sp.lv && ax >= sp.b[0] && ax <= sp.b[2] && ay >= sp.b[1] && ay <= sp.b[3])
        if walking && ax >= pw - 4 && ax <= pw + 14 && ay >= LIP[2] - 4 && ay <= LIP[2] + 16 {
          slipAt = gt
          foundReq = "penguin"
        } else if gt >= shootAt && gt - shootAt < 2.2 && abs(ax - shx) < 22 && abs(ay - shy) < 22 {
          wishAt = gt
          foundReq = "wish"
        } else if spot != null {
          egg = {id: spot.id, at: gt, p: spot.p}
          if spot.id == "snowman" { hatAt = gt }
          foundReq = spot.id
        } else {
          kick = 1.4
        }
      }

      // the sky, the same in every scene
      Canvas {
        width: CW
        height: CH
        sprite(SKY, 0, 0, PX, palette: PAL)
      }
      // what stands against it, and the snowy ground
      Canvas {
        width: CW
        height: CH
        sprite(SC.land, 0, 0, PX, palette: PAL)
      }
      // what grows with the lists: the scene's extras, the tree with its ornaments and star, the boxes
      Canvas {
        width: CW
        height: CH
        for u in SC.unlocks {
          if prog >= u.lv { sprite(u.spr, u.x * PX, u.y * PX, PX, palette: PAL) }
        }
        if prog >= 0.5 {
          for w in SC.lit { sprite(w.spr, w.x * PX, w.y * PX, PX, palette: PAL) }
        }
        sprite(TREE, SC.tx * PX, SC.ty * PX, PX, palette: PAL)
        for o, j in ORN.take(min(nDone, 18)) {
          rect((SC.tx + o[0]) * PX, (SC.ty + o[1] + 2) * PX, 2 * PX, PX, fill: PAL.E)
          rect((SC.tx + o[0]) * PX, (SC.ty + o[1]) * PX, 2 * PX, 2 * PX, fill: ORNC[j % 6])
          rect((SC.tx + o[0]) * PX, (SC.ty + o[1]) * PX, PX, PX, fill: alpha(SNOW, 0.55))
        }
        if total > 0 && prog >= 1 { sprite(STAR, STAR_AT[0] * PX, (SC.ty + STAR_AT[1]) * PX, PX, palette: PAL) }
        for p in shown {
          rect((p.sx - floor(len(PRESENTS[p.k][0]) / 2) + 1) * PX, (p.sy + 1) * PX, len(PRESENTS[p.k][0]) * PX, PX, fill: PAL.T)
          sprite(PRESENTS[p.k], (p.sx - floor(len(PRESENTS[p.k][0]) / 2)) * PX, (p.sy - len(PRESENTS[p.k]) + 1) * PX, PX, palette: p.pal)
        }
      }

      // what moves: stars, a shooting star, the northern lights, smoke, lights, the hat, the nose, the sleigh,
      // the penguin and the snow
      Canvas {
        width: CW
        height: CH
        for s, i in SC.stars {
          rect(s[0] * PX, s[1] * PX, PX, PX, fill: alpha(SNOW, 0.35 + 0.65 * abs(sin(time * (0.4 + hash(i, 7)) + i))))
        }
        if shooting {
          let st = (gt - shootAt) / 1.4
          let wished = wishAt >= shootAt
          let sx0 = ART_CX - 0.6 * ART_R + hash(floor(shootAt), 1) * 0.35 * ART_R
          let sy0 = ART_CY - 0.82 * ART_R + hash(floor(shootAt), 2) * 0.2 * ART_R
          for k in range(7) {
            rect(floor(sx0 + (st * 34 - k * 1.6) * ART_S) * PX, floor(sy0 + (st * 12 - k * 0.55) * ART_S) * PX, PX, PX, fill: alpha(wished ? yellow : SNOW, (1 - k / 7) * min(1, (1 - st) * 3)))
          }
          if wished {
            for k in range(8) {
              let wr = (gt - wishAt) * 26
              rect(floor(sx0 + st * 34 * ART_S + cos(k * 0.785) * wr) * PX, floor(sy0 + st * 12 * ART_S + sin(k * 0.785) * wr) * PX, PX, PX, fill: alpha(yellow, max(0, 1 - (gt - wishAt) * 1.2)))
            }
          }
        }
        if SC.aurora && prog >= 0.75 {
          for c in range(12 * ART_S, 60 * ART_S) {
            let rim = ART_CY - sqrt(max(0, ART_R * ART_R - (c + 0.5 - ART_CX) * (c + 0.5 - ART_CX))) + 6 * ART_S
            let top = max(ceil(rim), round((9 + 2 * sin(c / ART_S * 0.19 + time * 0.45) + 1.5 * sin(c / ART_S * 0.47 - time * 0.8)) * ART_S))
            let bot = min(SC.sky[c] - 2, 22 * ART_S, round(top + (7 + 3 * sin(c / ART_S * 0.13 + time * 0.3)) * ART_S) - floor(hash(c, 3) * 5))
            let fold = 0.5 + 0.5 * sin(c / ART_S * 0.55 - time * 1.3)
            if bot > top + 3 {
              rect(c * PX, (top + 3) * PX, PX, (bot - top - 3) * PX, fill: alpha(mix(green, accent, c / ART_W), 0.14 + 0.4 * fold))
              rect(c * PX, top * PX, PX, 3 * PX, fill: alpha(mix(green, magenta, c / ART_W), 0.35 + 0.6 * fold))
            }
          }
        }
        for sm in SC.smoke {
          if prog >= sm.lv {
            for k in range(5) {
              let ph = (time * 0.25 + k / 5 + sm.x * 0.03) % 1
              rect(floor(sm.x + (sin(ph * 6.28 + k) * 1.2 + ph * 2.5) * ART_S) * PX, floor(sm.y - ph * 10 * ART_S) * PX, (ph > 0.4 ? 3 : 2) * PX, (ph > 0.4 ? 3 : 2) * PX, fill: alpha(SNOW, 0.4 * (1 - ph)))
            }
          }
        }
        if prog >= 0.75 {
          for l, i in LIGHTS {
            if sin(time * 2.2 + i * 1.7) > -0.3 {
              rect((SC.tx + l[0] - 1) * PX, (SC.ty + l[1] - 1) * PX, 3 * PX, 3 * PX, fill: alpha(LITC[i % 4], 0.28))
              rect((SC.tx + l[0]) * PX, (SC.ty + l[1]) * PX, PX, PX, fill: LITC[i % 4])
            } else {
              rect((SC.tx + l[0]) * PX, (SC.ty + l[1]) * PX, PX, PX, fill: alpha(LITC[i % 4], 0.35))
            }
          }
        }
        // the snowman's hat, which jumps off now and then when the globe is shaken
        if SC.hat != null && prog >= 0.25 {
          let ht = hatting ? (gt - hatAt) : 0
          sprite(SC.hat.spr, (SC.hat.x + round(sin(ht * 14) * 2 * (1 - ht))) * PX, (SC.hat.y - round(sin(ht * 3.14159) * 14)) * PX, PX, palette: PAL)
        }
        // the egg found last, playing in the scene
        if eggOn {
          let et = gt - egg.at
          if egg.id == "moon" {
            rect((egg.p[0] + 3) * PX, (egg.p[1] + 6) * PX, 3 * PX, PX, fill: PAL.j)
            rect((egg.p[0] + 9) * PX, (egg.p[1] + 5) * PX, PX, 2 * PX, fill: PAL.j)
            for k in range(5) {
              rect((egg.p[0] + 5 + k) * PX, (egg.p[1] + (k == 0 || k == 4 ? 9 : 10)) * PX, PX, PX, fill: PAL.j)
            }
          }
          if egg.id == "chimney" {
            let kk = floor(time * 7) % 2
            let rise = min(et * 30, 8)
            sprite(BOOT, (egg.p[0] - 2) * PX, (egg.p[1] - rise - kk) * PX, PX, palette: PAL)
            sprite(BOOT, (egg.p[0] + 2) * PX, (egg.p[1] - rise - 1 + kk) * PX, PX, palette: PAL)
          }
          if egg.id == "bell" {
            for k in range(2) {
              let rr = (et * 14 + k * 7) % 16 + 3
              for a in range(12) {
                rect(floor(egg.p[0] + cos(a * 0.5236) * rr) * PX, floor(egg.p[1] + sin(a * 0.5236) * rr * 0.7) * PX, 2 * PX, 2 * PX, fill: alpha(yellow, 1 - rr / 20))
              }
            }
          }
          if egg.id == "igloo" {
            let up = round(clamp(min(et * 10, 6) - max(0, et - 1.9) * 12, 0, 6))
            sprite(PENGUIN_HEAD, (egg.p[0] - 5) * PX, (egg.p[1] - up - 5) * PX, PX, palette: PAL)
          }
          if egg.id == "rudolph" {
            let gl = 0.7 + 0.3 * sin(et * 12)
            rect((egg.p[0] - 4) * PX, egg.p[1] * PX, 10 * PX, 2 * PX, fill: alpha(red, 0.3 * gl))
            rect(egg.p[0] * PX, (egg.p[1] - 4) * PX, 2 * PX, 10 * PX, fill: alpha(red, 0.3 * gl))
            rect((egg.p[0] - 2) * PX, (egg.p[1] - 2) * PX, 6 * PX, 6 * PX, fill: alpha(red, 0.35 * gl))
            rect(egg.p[0] * PX, egg.p[1] * PX, 2 * PX, 2 * PX, fill: mix(red, SNOW, 0.6))
          }
        }
        // the deer's red nose, glowing now and then
        if SC.nose != null && prog >= 0.25 {
          let glow = pow(max(0, sin(time * 1.1)), 16)
          if glow > 0.04 {
            rect((SC.nose[0] - 2) * PX, (SC.nose[1] - 2) * PX, 6 * PX, 6 * PX, fill: alpha(red, 0.3 * glow))
            rect(SC.nose[0] * PX, SC.nose[1] * PX, 2 * PX, 2 * PX, fill: mix(red, SNOW, 0.5 * glow))
          }
        }
        if SC.sleigh && total > 0 && prog >= 1 {
          let sx = (54 - (time * 4) % 90) * ART_S
          if sx > 15 * ART_S && sx < 29 * ART_S { sprite(SLEIGH, floor(sx) * PX, floor((9 + sin(time * 1.5)) * ART_S) * PX, PX, palette: PAL) }
        }
        for f in flakes {
          // snow lying on the ground is part of it; draw only what's in the air or on the glass
          if f.s && f.y >= GNDN[clamp(floor(ART_CX + f.x * ART_R), 0, ART_W - 1)] - 0.02 {
          } else if f.ph < 2.5 {
            rect(floor(ART_CX + f.x * ART_R) * PX, floor(ART_CY + f.y * ART_R) * PX, PX, PX, fill: alpha(golden ? yellow : SNOW, 0.5))
          } else {
            rect(floor(ART_CX + f.x * ART_R) * PX, floor(ART_CY + f.y * ART_R) * PX, 2 * PX, 2 * PX, fill: alpha(golden ? mix(yellow, SNOW, 0.35) : SNOW, 0.92))
          }
        }
      }

      // the glass in front, and the stand with the scene's name on its plaque
      Canvas {
        width: CW
        height: CH
        sprite(GLASS, 0, 0, PX, palette: PAL)
        sprite(STAND, 0, STAND_Y * PX, PX, palette: PAL)
        sprite(ARROW_L, ARROWS[0] * PX, ARROWS[2] * PX, PX, palette: PAL)
        sprite(ARROW_R, ARROWS[1] * PX, ARROWS[2] * PX, PX, palette: PAL)
        text(upper(str.scene(scene)), ART_CX * PX, PLAQUE_Y * PX, size: min(1.8 * ART_S * PX, 28 * ART_S * PX / len(str.scene(scene))), color: golden ? yellow : accent, align: center, font: BLOCK)
      }

      // a penguin out for a walk on the table, in front of the stand
      if walking {
        Canvas {
          width: CW
          height: CH
          let wt = (gt - walkAt) / 6
          let step = floor(time * 6) % 2
          let pxl = floor(lerp(LIP[0], LIP[1], wt))
          layer(clamp(min(wt, 1 - wt) * 10, 0, 1)) {
            if gt >= slipAt && gt - slipAt < 1.3 {
              rotate(90, (pxl + 5) * PX, (LIP[2] + 7) * PX) { sprite(PENGUIN[0], pxl * PX, (LIP[2] + 2) * PX, PX, palette: PAL) }
              for k in range(3) {
                rect((pxl + 5 + cos(time * 9 + k * 2.1) * 6) * PX, (LIP[2] + 1 + sin(time * 9 + k * 2.1) * 2) * PX, PX, PX, fill: yellow)
              }
            } else {
              sprite(PENGUIN[step], pxl * PX, (LIP[2] - step) * PX, PX, palette: PAL)
            }
          }
        }
      }

      // what's still to do, as a notification in the sky once the snow is stirred
      Column {
        width: CW
        padding: [0, 0, 0, 0]
        align: center
        Text {
          text: hint
          width: floor(PX * 56 * ART_S)
          align: center
          maxLines: 2
          fontSize: 12
          color: foreground
          padding: [10, 7]
          background: alpha(background, 0.88)
          border: 2
          borderColor: accent
          radius: 4 * corners
          opacity: hintOn ? 1 : 0
          animate opacity: tween(500ms, "ease")
        }
      }

      // the arrows on the stand turn to the next scene
      Column {
        width: CW
        gap: 0
        Spacer { height: (ARROWS[2] - 2 * ART_S) * PX }
        Row {
          gap: 0
          width: CW
          Spacer { width: 8 * ART_S * PX }
          Box {
            width: 11 * ART_S * PX
            height: 9 * ART_S * PX
            ripple: false
            onTap: { scene = (scene + 3) % 4; kick = 0.5; hint = str.scene((scene + 3) % 4); hintAt = gt - 0.8; hintFor = 3 }
          }
          Box {
            weight: 1
            height: 9 * ART_S * PX
            ripple: false
            onLongPress: { if m.available != true { foundReq = "upside" } }
          }
          Box {
            width: 11 * ART_S * PX
            height: 9 * ART_S * PX
            ripple: false
            onTap: { scene = (scene + 1) % 4; kick = 0.5; hint = str.scene((scene + 1) % 4); hintAt = gt - 0.8; hintFor = 3 }
          }
          Spacer { width: 8 * ART_S * PX }
        }
      }
    }
  }

  component Header() {
    Row {
      gap: 14
      align: center
      Box {
        width: 34 * len(days > 0 ? "${days}" : "*") + 6
        height: 40
        onLongPress: demo = !demo
        Text { text: days > 0 ? "${days}" : "*"; font: BLOCK; fontSize: 34; color: mix(accent, background, 0.65); offset: [3, 3]; maxLines: 1 }
        Text { text: days > 0 ? "${days}" : "*"; font: BLOCK; fontSize: 34; color: accent; maxLines: 1 }
      }
      Column {
        weight: 1
        gap: 6
        Text { text: days > 0 ? str.untilXmas(days) : (days == 0 ? str.today : str.after); style: body; maxLines: 1 }
        Row {
          gap: 10
          align: center
          Text { text: demo ? str.preview : (total == 0 ? str.empty : str.left(leftN)); style: small; color: demo ? accent : muted; maxLines: 1 }
          if total > 0 && !demo {
            // 20 blocks in four groups: each group is one step of the globe (extras, more extras, lights, the star)
            Canvas {
              weight: 1
              height: 8
              let bw = (width - 19 * 2 - 3 * 3) / 20
              for i in range(20) {
                rect(i * (bw + 2) + floor(i / 5) * 3, 0, bw, 8, fill: i < round(prog * 20) ? accent : mix(background, accent, 0.2))
              }
            }
          }
        }
      }
    }
  }

  component Tab(tabId, caption) {
    Text {
      text: caption
      style: small
      color: tab == tabId ? accent : muted
      border: 1
      borderColor: tab == tabId ? accent : alpha(border, 0)
      padding: [12, 6]
      radius: 3 * corners
      onTap: tab = tabId
    }
  }

  // a gift's state as a little pixel picture: a bulb for an idea, a plain box, a wrapped one
  component GiftIcon(st, gid) {
    Canvas {
      width: 22
      height: 22
      if st == 0 {
        sprite([".yyy.", "yyWyy", "yyyyy", ".yyy.", ".JJJ.", "..J.."], 3.5, 2, 3, palette: PAL)
      } else {
        sprite(PRESENTS[0], 3, 1, 2, palette: st == 2 ? {V: WRAPS[floor(hash(gid, 3) * 6)][0], X: mix(WRAPS[floor(hash(gid, 3) * 6)][0], NIGHT, 0.4), Z: WRAPS[floor(hash(gid, 3) * 6)][1], N: WRAPS[floor(hash(gid, 3) * 6)][1]} : KRAFT)
      }
    }
  }

  component GiftRow(g, i) {
    Row {
      gap: 10
      align: center
      padding: [4, 3]
      onTap: { if demo { demo = false } else { gifts = gifts.map(it => it.id == g.id ? merge(it, {st: (it.st + 1) % 3}) : it) } }
      onLongPress: { if demo { demo = false } else { undo = {k: "g", item: g, i: i}; gifts = gifts.filter(it => it.id != g.id) } }
      GiftIcon { st: g.st; gid: g.id }
      Column {
        weight: 1
        gap: 0
        Text { text: g.who; maxLines: 1; color: g.st == 2 ? muted : foreground }
        if g.what != "" { Text { text: g.what; style: small; color: muted; maxLines: 1 } }
      }
      if g.price > 0 { Text { text: fmtNum(g.price); style: small; color: muted } }
      Text { text: g.st == 0 ? str.idea : (g.st == 1 ? str.bought : str.wrapped); style: small; color: g.st == 0 ? yellow : (g.st == 1 ? orange : green) }
    }
  }

  component TaskRow(t, i) {
    Row {
      gap: 10
      align: center
      padding: [4, 4]
      onTap: { if demo { demo = false } else { tasks = tasks.map(it => it.id == t.id ? merge(it, {done: !it.done}) : it) } }
      onLongPress: { if demo { demo = false } else { undo = {k: "t", item: t, i: i}; tasks = tasks.filter(it => it.id != t.id) } }
      Text { text: t.done ? "[x]" : "[ ]"; color: t.done ? green : muted }
      Text { text: t.name; weight: 1; maxLines: 2; color: t.done ? muted : foreground }
    }
  }

  // an egg in the collection: its name once found, its riddle always
  // one line per secret: its name once found, its riddle (and what it waits for) until then; a bauble icon
  component EggRow(e, i) {
    Row {
      gap: 10
      align: center
      padding: [4, 3]
      Canvas {
        width: 16
        height: 18
        sprite(["..cc..", "..cc..", ".abba.", "abWbba", "abbbba", "abbbba", ".abba.", "..aa.."], 2, 1, 2, palette: contains(eggs, e) ? {a: mix(red, NIGHT, 0.3), b: red, c: yellow, W: mix(red, SNOW, 0.6)} : {a: alpha(muted, 0.6), b: alpha(muted, 0.25), c: alpha(muted, 0.5), W: alpha(muted, 0.4)})
      }
      Text {
        text: contains(eggs, e) ? str.eggName(i) : (prog < EGG_LV[i] ? "${str.eggHint(i)} (${str.locked})" : str.eggHint(i))
        weight: 1
        maxLines: 1
        style: small
        color: contains(eggs, e) ? foreground : muted
      }
      if contains(eggs, e) { Text { text: "✓"; style: small; color: green } }
    }
  }

  component Lists() {
    Column {
      gap: 8
      padding: 12
      background: alpha(background, tileOpacity)
      frost: tileFrost
      border: borderWidth
      borderColor: border
      radius: 8 * corners
      Row {
        gap: 6
        align: center
        Tab { tabId: "gifts"; caption: "${str.gifts} ${nWrapped}/${len(GL)}" }
        Tab { tabId: "tasks"; caption: "${str.tasks} ${nDone}/${len(TL)}" }
        Tab { tabId: "eggs"; caption: "${str.eggs} ${len(eggs)}/${len(EGG_IDS)}" }
        Spacer { weight: 1 }
        if undo != null {
          Text {
            text: "↶ ${str.undo}"
            style: small
            color: accent
            padding: [8, 6]
            onTap: {
              if undo.k == "g" { gifts = take(gifts, undo.i) + [undo.item] + drop(gifts, undo.i) } else { tasks = take(tasks, undo.i) + [undo.item] + drop(tasks, undo.i) }
              undo = null
            }
          }
        }
      }
      if tab == "gifts" {
        Row {
          gap: 6
          align: center
          Text { text: budget > 0 ? str.spent(fmtNum(spent)) : str.spentOnly(fmtNum(spent)); style: small; color: muted }
          if !demo { Input { text: budget > 0 ? "${budget}" : ""; placeholder: str.budget; width: 96; fontSize: 13; color: muted; onSubmit: budget = num(value, 0) } }
        }
        if budget > 0 { Progress { value: min(spent, budget); max: budget; color: spent > budget ? red : green } }
      }
      Column {
        weight: 1
        scroll: true
        gap: 2
        if tab == "gifts" {
          if len(GL) == 0 { Text { text: str.noGifts; style: small; color: muted; padding: [4, 8] } }
          for g, i in GL key g.id { GiftRow { g: g; i: i } }
        } else if tab == "tasks" {
          for t, i in TL key t.id { TaskRow { t: t; i: i } }
        } else {
          for e, i in EGG_IDS { EggRow { e: e; i: i } }
        }
      }
      // the list's last rows fade out, so it shows there's more to scroll to
      Spacer { fill: width; height: 14; offset: [0, -18]; background: linear(0, 0, 0, 1, [alpha(background, 0), alpha(background, 0.8)]) }
      // Enter adds, and puts the keyboard away
      if tab != "eggs" && !demo { Input { placeholder: tab == "gifts" ? str.giftPh : str.taskPh; clear: true; onSubmit: addReq = value } }
      Text { text: tab == "gifts" ? str.helpGifts : (tab == "tasks" ? str.helpTasks : str.helpEggs); style: small; color: muted }
    }
  }

  Box {
    fill: true
    Column {
      fill: true
      padding: [16, 8, 16, 8]
      gap: 10
      Header { }
      if wide {
        Row {
          gap: 16
          weight: 1
          Column {
            align: center
            justify: center
            Globe { }
            if !shaken { Text { text: str.shakeHint; style: small; color: muted } }
          }
          Lists { weight: 1 }
        }
      } else {
        if !typing {
          Column {
            fill: width
            align: center
            gap: 4
            Globe { }
            if !shaken { Text { text: str.shakeHint; style: small; color: muted; align: center } }
          }
        }
        Lists { weight: 1 }
      }
      Spacer { height: screenInset ?? 0 }
    }
    // the sleigh, flying over the page from right to left, with a trail of sparkles
    if flying {
      Canvas {
        fill: width
        height: 170
        onTap: {
          let ft2 = (gt - flyAt) / 7
          let sw2 = len(SLEIGH[0]) * PX
          let fx2 = lerp(W + 10, -sw2 - 120, ft2)
          let fy2 = 18 + 70 * ft2 + 10 * sin(ft2 * 8)
          if x >= fx2 - 20 && x <= fx2 + sw2 + 20 && y >= fy2 - 20 && y <= fy2 + 18 * PX + 20 {
            dropAt = gt
            dropX = x
            dropY = y
            foundReq = "sleigh"
          } else {
            kick = 1.4
          }
        }
        let ft = (gt - flyAt) / 7
        let sw = len(SLEIGH[0]) * PX
        let fx = lerp(width + 10, -sw - 120, ft)
        let fy = 18 + 70 * ft + 10 * sin(ft * 8)
        for k in range(12) {
          let tx = fx + sw + 6 + k * 9
          let tw = abs(sin(time * 9 + k * 1.7))
          rect(floor(tx / PX) * PX, floor((fy + 10 * PX - k * 2.2 + 4 * sin(k * 1.3 + time * 3)) / PX) * PX, PX, PX, fill: alpha(k % 3 == 0 ? yellow : SNOW, (1 - k / 12) * tw))
        }
        sprite(SLEIGH, floor(fx / PX) * PX, floor(fy / PX) * PX, PX, palette: PAL)
        if dropAt >= flyAt && gt - dropAt < 1.6 {
          let dt2 = gt - dropAt
          sprite(PRESENTS[0], floor(dropX / PX) * PX, floor((dropY + 220 * dt2 * dt2) / PX) * PX, PX, palette: {V: red, X: mix(red, NIGHT, 0.4), Z: yellow, N: yellow})
        }
      }
    }
  }
}
