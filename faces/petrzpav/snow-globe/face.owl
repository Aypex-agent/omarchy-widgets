    ".....................KKKkk.....................",
    ".....................KKKkk.....................",
    ".....................KKKkk.....................",
    ".....................KKKkk.....................",
    ".................TTTTKKKkkTTTTTTT.............."
  ]
  let ORN = [[23, 44], [22, 6], [28, 23], [15, 31], [37, 47], [10, 45], [32, 35], [19, 18], [24, 31], [16, 40], [30, 42], [17, 47], [30, 29], [25, 18], [22, 23], [19, 35], [24, 11], [28, 47]]
  let LIGHTS = [[20, 16], [20, 17], [21, 17], [21, 18], [22, 18], [23, 19], [24, 20], [25, 20], [27, 21], [28, 21], [30, 22], [18, 26], [18, 27], [19, 28], [20, 28], [22, 29], [23, 30], [25, 31], [27, 32], [29, 32], [31, 33], [34, 34], [16, 38], [17, 39], [18, 40], [19, 40], [21, 41], [23, 42], [25, 43], [28, 44], [30, 44], [34, 45], [37, 46]]
  let STAR = [
    ".............",
    "......y......",
    "......y......",
    "......y......",
    ".....yyy.....",
    ".yyyyWWWyyyy.",
    "..yyWWWWWyy..",
