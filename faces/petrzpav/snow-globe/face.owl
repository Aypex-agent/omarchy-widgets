    "...yy...yy...",
    "...y.....y...",
    "............."
  ]
  let STAR_AT = [60, -10]
  let SLEIGH = [
    "..KK..KK..........KK..KK..........................",
    "..KK..KK..........KK..KK..........................",
    "...KKKK............KKKK..................rrrSS....",
    "....KK..............KK.................rrrrrSS....",
    "...FFF.............FFF.................rrrrr......",
    "..FFFFF...........FFFFF...............rrrrrr......",
    "rrFFFFFFFFFFF.....FFFFFFFFFFF.........SSSSSS......",
    "rrFFFFFFFFFFFF....FFFFFFFFFFFF........SSSSSS......",
    "...FFFFFFFFFFFiiiiiFFFFFFFFFFFiiiiiiHHSSSSSr......",
    "....FFFFFFFFFFiiiiiiFFFFFFFFFFiiiiiiHSSSSrrrr.....",
    "....FFF..FFFF.......FFF..FFFF.....rrSSSSSrrrrrrrR.",
    "....FF....FF........FF....FF......rrrSSrrrrrrrrrRR",
    "..................................RrrrrrrrrrrrrrRR",
    "...................................RrrrrrrrrrrrrR.",
    "....................................ii........ii..",
    "...................................iiii......iiii.",
    "..................................iiiiiiiiiiiiiiii",
    "..................................iiiiiiiiiiiiiiii"
  ]
  let PENGUIN = [
    [
      "...jjjj...",
      "..jjjjjj..",
      "..jjjjSj..",
      ".jjjjjjll.",
      ".jjjjSSl..",
      "jjjjSSSS..",
      "jjjSSSSSS.",
      "jjjSSSSSS.",
