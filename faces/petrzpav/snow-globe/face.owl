    "............GSSGSSGGggggEgggEEgEsEs............",
    "..............gGggGGEggEggEEEEEEE..............",
    "..............EGEgEgEgEgEEEEEEEgE..............",
    "..............SEGEGEGEgEgEgEEEEEE..............",
    "..............GGGGGGGgggggEgEEEEg..............",
    "............GGGgGGGGgEggggggEEEEEEE............",
    "............SGGGGGgGgggggggEEEEEEgE............",
    "...........GGGGGGGGGggEggggggEEEEEEE...........",
    "..........GgGGGGGGGgggggggggEEEEEEgEE..........",
    "........GSGGGGgGGGGggggEgggggEEEEEEEEEE........",
    "........GSSGSSGGGgGggggggggggEEEEEEgssE........",
    "........SSGSSGGGGGGgggggEgggggEEEEEEsEs........",
    ".......SSGSSGSGGGGggggggggggggEEEEEEgssE.......",
    "........g..gGggGGgGGEggEgEEggEEEEEEE..E........",
    "........E..gEGEGEGEGEgEgEgEgEEEEEEEE..E........",
    "...........SGEGEGEGEgEgEgEEEgEEEEEEE...........",
    "..........GGGGGGGGGGgggggggggEEEEEEEE..........",
    "........GGGGgGGGGGGggggggggEgggEEEEEEEE........",
    "........SGGGGGGgGGGgggggggggggEEEEEEEEE........",
    ".......GGGGGGGGGGGggggggggggEgEgEEEEEEEE.......",
    "......GGgGGGGGGGGGgggggggggggggEEEEEEEEEg......",
    "....GSGGGGGgGGGGGGEggggggggggEgEgEEEEEEEEEE....",
    "....SGSSGSGGGGgGGGggggggggggggggEEEEEEEEsgs....",
    "...SgSSGSGGGGGGGGggEggggggggggEgEgEEEEEEEssE...",
    ".SSGSSGSGGGGGGGGGggggggggggggggggEEEEEEEEEgssE.",
    "..g..g..g..g..g..E..E..E..E..E..E..E..E..E..E..",
    "..g..g..g..g.........KKKkk.........E..E..E..E..",
    ".....................KKKkk.....................",
