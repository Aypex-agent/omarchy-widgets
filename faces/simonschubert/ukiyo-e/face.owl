    de {
      date: "EEEE, d. MMMM"; weather: "wetter"; sun: "sonne"; moon: "mond"; letters: "briefe"; quiet: "der himmel ist still"; sets: t => "untergang ${t}"; risesSets: "kommt und geht"
      allow: "Erlaube der Seite, deine Benachrichtigungen zu lesen, dann kommen sie hier als Briefe an."
