face "ukiyo-e" {
  // A woodblock print. A mountain over the sea under a graded sky, with a pine in front and bands of mist across: the
  // sky follows the hour, from sunrise to sunset as the weather reports them, the moon is in its real phase, rain falls
  // in straight lines and snow in flakes, and the mountain's snow grows with the winter. The title cartouche names the
  // season of the old Japanese calendar, one of 72 of about five days each; the page under the print has it in
  // English, the weather, the sun and the moon, your newest notifications as letters and your most used apps.
  // The print is the theme's paper and ink, with its blue, red and green for the inks between.

  meta {
    owl: 16
    description: "A woodblock print that follows the hour, the weather and the moon, the 72 seasons of the old Japanese calendar, your letters and apps"
    version: "1.3"
    license: "MIT"
    category: "fun"
  }

  // What the page says, in the phone's language where it has a set. Day and month names come from the phone. The
  // kanji, their readings and the seal are the print's own and stay in every language; ko and sekki give the meaning
  // of the season by its first day, ja and zh name the sekki as they are written there.
  strings {
    en {
      date: "EEEE d MMMM"; weather: "weather"; sun: "sun"; moon: "moon"; letters: "letters"; quiet: "the sky is quiet"; sets: t => "sets at ${t}"; risesSets: "rises and sets"
      allow: "Let the page read your notifications, and they arrive here as letters."
      empty: "No letters today. Only the wind in the pines."
      now: "now"; mins: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}w"; years: n => "${n}y"
      moonName: k => k
      next: (d, m, what) => "next on ${d} ${["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m - 1]}: ${lower(what)}"
      ko: (md, en) => en
      sky: (code, desc) => desc
      sekki: (md, kanji, en) => en
    }
    id {
      date: "EEEE, d MMMM"; weather: "cuaca"; sun: "matahari"; moon: "bulan"; letters: "surat"; quiet: "langit sedang tenang"; sets: t => "terbenam ${t}"; risesSets: "terbit, terbenam"
      allow: "Izinkan halaman ini membaca notifikasimu, dan semuanya tiba di sini sebagai surat."
      empty: "Tak ada surat hari ini. Hanya angin di pepohonan pinus."
      now: "kini"; mins: n => "${n}m"; hours: n => "${n}j"; days: n => "${n}h"; weeks: n => "${n}mg"; years: n => "${n}th"
      moonName: k => get({"new moon": "bulan baru", "waxing crescent": "sabit awal", "first quarter": "kuartir pertama", "waxing gibbous": "cembung awal", "full moon": "purnama", "waning gibbous": "cembung akhir", "last quarter": "kuartir akhir", "waning crescent": "sabit akhir"}, k, k)
      next: (d, m, what) => "mulai ${d} ${["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"][m - 1]}: ${lower(what)}"
      ko: (md, en) => get({
        "204": "Angin timur mencairkan es", "209": "Burung warbler mulai berkicau di gunung", "214": "Ikan muncul dari balik es", "219": "Hujan membasahi tanah",
        "224": "Kabut mulai menggantung", "301": "Rumput bertunas, pohon berkuncup", "306": "Serangga bangun dari tidur panjang", "311": "Bunga persik pertama mekar",
        "316": "Ulat menjadi kupu-kupu", "321": "Burung gereja mulai bersarang", "326": "Bunga sakura pertama mekar", "331": "Guruh di kejauhan",
        "405": "Burung layang-layang kembali", "410": "Angsa liar terbang ke utara", "415": "Pelangi pertama", "420": "Gelagah mulai bertunas",
        "425": "Embun beku terakhir, bibit padi tumbuh", "430": "Peoni mekar", "505": "Katak mulai bersahutan", "510": "Cacing muncul ke permukaan",
        "515": "Rebung mulai tumbuh", "521": "Ulat sutra melahap daun murbei", "526": "Kesumba mekar", "531": "Gandum matang dan dipanen",
        "606": "Belalang sembah menetas", "611": "Rumput busuk menjadi kunang-kunang", "616": "Buah plum menguning", "621": "Prunela layu",
        "627": "Iris mekar", "702": "Pinellia bertunas", "707": "Angin hangat berembus", "712": "Teratai pertama mekar",
        "717": "Elang muda belajar terbang", "723": "Pohon paulownia berbiji", "729": "Tanah lembap, udara gerah", "803": "Hujan lebat sesekali turun",
        "808": "Angin sejuk berembus", "813": "Tonggeret senja berbunyi", "818": "Kabut tebal turun", "823": "Bunga kapas merekah",
        "828": "Panas mulai mereda", "902": "Padi menguning", "908": "Embun putih berkilau di rumput", "913": "Burung kicuit berkicau",
        "918": "Burung layang-layang pergi", "923": "Guruh berhenti", "928": "Serangga bersembunyi di dalam tanah", "1003": "Petani mengeringkan sawah",
        "1008": "Angsa liar kembali", "1013": "Krisan mekar", "1018": "Jangkrik mengerik di dekat pintu", "1023": "Embun beku pertama",
        "1028": "Hujan ringan sesekali turun", "1102": "Daun maple dan tanaman rambat menguning", "1107": "Kamelia mekar", "1112": "Tanah mulai membeku",
        "1117": "Bunga narsis mekar", "1122": "Pelangi bersembunyi", "1127": "Angin utara merontokkan daun", "1202": "Jeruk tachibana menguning",
        "1207": "Dingin tiba, musim dingin dimulai", "1212": "Beruang mulai tidur di sarangnya", "1216": "Salmon berkumpul dan berenang ke hulu", "1222": "Prunela bertunas",
        "1227": "Rusa menanggalkan tanduknya", "101": "Gandum bertunas di bawah salju", "105": "Peterseli tumbuh subur", "110": "Mata air mencair",
        "115": "Burung pegar mulai bersuara", "120": "Fuki mulai berkuncup", "125": "Es menebal di sungai", "130": "Ayam betina mulai bertelur"
      }, "${md}", en)
      sky: (code, desc) => get({
        "113": "cerah", "116": "cerah berawan", "119": "berawan", "122": "mendung", "143": "kabut tipis",
        "176": "hujan lokal", "179": "salju lokal", "182": "hujan salju lokal", "185": "gerimis beku lokal",
        "200": "badai petir", "227": "salju tertiup angin", "230": "badai salju", "248": "kabut", "260": "kabut beku",
        "263": "gerimis ringan lokal", "266": "gerimis ringan", "281": "gerimis beku", "284": "gerimis beku lebat",
        "293": "hujan ringan lokal", "296": "hujan ringan", "299": "kadang hujan sedang", "302": "hujan sedang",
        "305": "kadang hujan lebat", "308": "hujan lebat", "311": "hujan beku ringan", "314": "hujan beku lebat",
        "317": "hujan salju ringan", "320": "hujan salju lebat", "323": "salju ringan lokal", "326": "salju ringan",
        "329": "salju sedang lokal", "332": "salju sedang", "335": "salju lebat lokal", "338": "salju lebat",
        "350": "butiran es", "353": "hujan ringan sesaat", "356": "hujan lebat sesaat", "359": "hujan deras",
        "362": "hujan salju ringan sesaat", "365": "hujan salju lebat sesaat", "368": "salju ringan sesaat",
        "371": "salju lebat sesaat", "374": "butiran es ringan", "377": "butiran es lebat",
        "386": "hujan ringan berpetir", "389": "hujan lebat berpetir", "392": "salju ringan berpetir",
        "395": "salju lebat berpetir"
      }, code, lower(trim(desc)))
      sekki: (md, kanji, en) => get({
        "101": "titik balik musim dingin", "105": "dingin kecil", "120": "dingin besar", "204": "awal musim semi", "219": "air hujan",
        "306": "serangga bangun", "321": "ekuinoks musim semi", "405": "cerah dan bening", "420": "hujan biji-bijian", "505": "awal musim panas",
        "521": "biji mulai berisi", "606": "bulir gandum", "621": "titik balik musim panas", "707": "panas kecil", "723": "panas besar",
        "808": "awal musim gugur", "823": "akhir panas", "908": "embun putih", "923": "ekuinoks musim gugur", "1008": "embun dingin",
        "1023": "embun beku turun", "1107": "awal musim dingin", "1122": "salju kecil", "1207": "salju besar", "1222": "titik balik musim dingin"
      }, "${md}", en)
    }
    es {
      date: "EEEE, d 'de' MMMM"; weather: "clima"; sun: "sol"; moon: "luna"; letters: "cartas"; quiet: "el cielo está en calma"; sets: t => "ocaso ${t}"; risesSets: "sale y se pone"
      allow: "Deja que la página lea tus notificaciones y llegarán aquí como cartas."
      empty: "Hoy no hay cartas. Solo el viento entre los pinos."
      now: "ahora"; mins: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n} sem"; years: n => "${n} a"
      moonName: k => get({"new moon": "luna nueva", "waxing crescent": "creciente", "first quarter": "cuarto creciente", "waxing gibbous": "gibosa creciente", "full moon": "luna llena", "waning gibbous": "gibosa menguante", "last quarter": "cuarto menguante", "waning crescent": "menguante"}, k, k)
      next: (d, m, what) => "desde el ${d} de ${["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sept", "oct", "nov", "dic"][m - 1]}: ${lower(what)}"
      ko: (md, en) => get({
        "204": "El viento del este derrite el hielo", "209": "Los ruiseñores cantan en los montes", "214": "Los peces asoman entre el hielo", "219": "La lluvia humedece la tierra",
        "224": "La neblina empieza a quedarse", "301": "Brota la hierba, los árboles echan yemas", "306": "Los insectos despiertan", "311": "Primeras flores del melocotonero",
        "316": "Las orugas se vuelven mariposas", "321": "Los gorriones empiezan a anidar", "326": "Primeras flores del cerezo", "331": "Truenos lejanos",
        "405": "Vuelven las golondrinas", "410": "Los gansos salvajes vuelan al norte", "415": "Primeros arcoíris", "420": "Brotan los primeros juncos",
        "425": "Última helada, crecen los plantones de arroz", "430": "Florecen las peonías", "505": "Las ranas empiezan a cantar", "510": "Salen las lombrices",
        "515": "Asoman los brotes de bambú", "521": "Los gusanos de seda devoran la morera", "526": "Florece el cártamo", "531": "El trigo madura y se cosecha",
        "606": "Nacen las mantis", "611": "La hierba podrida se vuelve luciérnagas", "616": "Amarillean las ciruelas", "621": "Se marchita la prunela",
        "627": "Florecen los lirios", "702": "Brota la pinelia", "707": "Soplan vientos cálidos", "712": "Primeras flores de loto",
        "717": "Los halcones aprenden a volar", "723": "La paulonia da semillas", "729": "Tierra húmeda, aire bochornoso", "803": "A veces caen grandes lluvias",
        "808": "Soplan vientos frescos", "813": "Cantan las cigarras al atardecer", "818": "Baja una niebla espesa", "823": "Se abren las flores del algodón",
        "828": "El calor empieza a remitir", "902": "Madura el arroz", "908": "El rocío brilla blanco en la hierba", "913": "Cantan las lavanderas",
        "918": "Se van las golondrinas", "923": "Cesan los truenos", "928": "Los insectos se refugian bajo tierra", "1003": "Los campesinos drenan los campos",
        "1008": "Vuelven los gansos salvajes", "1013": "Florecen los crisantemos", "1018": "Los grillos cantan junto a la puerta", "1023": "Primera helada",
        "1028": "A veces cae una lluvia fina", "1102": "Amarillean los arces y la hiedra", "1107": "Florecen las camelias", "1112": "La tierra empieza a helarse",
        "1117": "Florecen los narcisos", "1122": "Se esconden los arcoíris", "1127": "El viento del norte arranca las hojas", "1202": "Amarillean los cítricos tachibana",
        "1207": "Llega el frío, empieza el invierno", "1212": "Los osos se retiran a hibernar", "1216": "Los salmones remontan el río", "1222": "Brota la prunela",
        "1227": "Los ciervos mudan la cornamenta", "101": "El trigo brota bajo la nieve", "105": "Crece el perejil", "110": "Se deshielan los manantiales",
        "115": "Los faisanes empiezan a cantar", "120": "Brotan los petasites", "125": "El hielo se espesa en los arroyos", "130": "Las gallinas empiezan a poner"
      }, "${md}", en)
      sky: (code, desc) => get({
        "113": "despejado", "116": "parcialmente nublado", "119": "nublado", "122": "cubierto", "143": "neblina",
        "176": "lluvia dispersa", "179": "nieve dispersa", "182": "aguanieve dispersa", "185": "llovizna helada dispersa",
        "200": "tormenta eléctrica", "227": "nieve con viento", "230": "ventisca", "248": "niebla", "260": "niebla helada",
        "263": "llovizna ligera dispersa", "266": "llovizna ligera", "281": "llovizna helada", "284": "llovizna helada intensa",
        "293": "lluvia ligera dispersa", "296": "lluvia ligera", "299": "a ratos lluvia moderada", "302": "lluvia moderada",
        "305": "a ratos lluvia fuerte", "308": "lluvia fuerte", "311": "lluvia helada ligera", "314": "lluvia helada fuerte",
        "317": "aguanieve ligera", "320": "aguanieve fuerte", "323": "nevada ligera dispersa", "326": "nevada ligera",
        "329": "nevada moderada dispersa", "332": "nevada moderada", "335": "nevada fuerte dispersa", "338": "nevada fuerte",
        "350": "granizo fino", "353": "chubascos ligeros", "356": "chubascos fuertes", "359": "aguacero",
        "362": "chubascos de aguanieve ligeros", "365": "chubascos de aguanieve fuertes", "368": "chubascos de nieve ligeros",
        "371": "chubascos de nieve fuertes", "374": "chubascos de granizo fino ligeros", "377": "chubascos de granizo fino fuertes",
        "386": "lluvia ligera con truenos", "389": "lluvia fuerte con truenos", "392": "nieve ligera con truenos",
        "395": "nieve fuerte con truenos"
      }, code, lower(trim(desc)))
      sekki: (md, kanji, en) => get({
        "101": "solsticio de invierno", "105": "frío menor", "120": "gran frío", "204": "comienzo de la primavera", "219": "agua de lluvia",
        "306": "despertar de los insectos", "321": "equinoccio de primavera", "405": "pura claridad", "420": "lluvia de grano", "505": "comienzo del verano",
        "521": "grano lleno", "606": "grano en espiga", "621": "solsticio de verano", "707": "calor menor", "723": "gran calor",
        "808": "comienzo del otoño", "823": "fin del calor", "908": "rocío blanco", "923": "equinoccio de otoño", "1008": "rocío frío",
        "1023": "cae la escarcha", "1107": "comienzo del invierno", "1122": "nieve menor", "1207": "gran nieve", "1222": "solsticio de invierno"
      }, "${md}", en)
    }
    pt {
      date: "EEEE, d 'de' MMMM"; weather: "clima"; sun: "sol"; moon: "lua"; letters: "cartas"; quiet: "o céu está calmo"; sets: t => "ocaso ${t}"; risesSets: "nasce e se põe"
      allow: "Deixe a página ler suas notificações e elas chegam aqui como cartas."
      empty: "Nenhuma carta hoje. Só o vento nos pinheiros."
      now: "agora"; mins: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n} sem"; years: n => "${n} a"
      moonName: k => get({"new moon": "lua nova", "waxing crescent": "crescente", "first quarter": "quarto crescente", "waxing gibbous": "crescente gibosa", "full moon": "lua cheia", "waning gibbous": "minguante gibosa", "last quarter": "quarto minguante", "waning crescent": "minguante"}, k, k)
      next: (d, m, what) => "a partir de ${d} de ${["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"][m - 1]}: ${lower(what)}"
      ko: (md, en) => get({
        "204": "O vento leste derrete o gelo", "209": "Os rouxinóis cantam nas montanhas", "214": "Os peixes despontam entre o gelo", "219": "A chuva umedece a terra",
        "224": "A névoa começa a pairar", "301": "A grama brota, as árvores ganham botões", "306": "Os insetos despertam", "311": "Primeiras flores do pessegueiro",
        "316": "As lagartas viram borboletas", "321": "Os pardais começam a fazer ninho", "326": "Primeiras flores da cerejeira", "331": "Trovões ao longe",
        "405": "As andorinhas voltam", "410": "Os gansos selvagens voam para o norte", "415": "Primeiros arco-íris", "420": "Brotam os primeiros juncos",
        "425": "Última geada, as mudas de arroz crescem", "430": "As peônias florescem", "505": "As rãs começam a cantar", "510": "As minhocas saem da terra",
        "515": "Despontam os brotos de bambu", "521": "Os bichos-da-seda devoram a amoreira", "526": "O cártamo floresce", "531": "O trigo amadurece e é colhido",
        "606": "Nascem os louva-a-deus", "611": "A grama podre vira vaga-lumes", "616": "As ameixas amarelam", "621": "A prunela murcha",
        "627": "As íris florescem", "702": "Brota a pinélia", "707": "Sopram ventos quentes", "712": "Primeiras flores de lótus",
        "717": "Os falcões aprendem a voar", "723": "A paulównia dá sementes", "729": "Terra úmida, ar abafado", "803": "Às vezes caem grandes chuvas",
        "808": "Sopram ventos frescos", "813": "As cigarras cantam ao entardecer", "818": "Desce uma névoa espessa", "823": "As flores do algodão se abrem",
        "828": "O calor começa a diminuir", "902": "O arroz amadurece", "908": "O orvalho brilha branco na grama", "913": "As alvéolas cantam",
        "918": "As andorinhas partem", "923": "Cessam os trovões", "928": "Os insetos se recolhem sob a terra", "1003": "Os agricultores drenam os campos",
        "1008": "Os gansos selvagens voltam", "1013": "Os crisântemos florescem", "1018": "Os grilos cantam junto à porta", "1023": "Primeira geada",
        "1028": "Às vezes cai uma chuva fina", "1102": "Bordos e heras amarelam", "1107": "As camélias florescem", "1112": "A terra começa a congelar",
        "1117": "Os narcisos florescem", "1122": "Os arco-íris se escondem", "1127": "O vento norte arranca as folhas", "1202": "Os citros tachibana amarelam",
        "1207": "Chega o frio, começa o inverno", "1212": "Os ursos se recolhem para hibernar", "1216": "Os salmões se reúnem e sobem o rio", "1222": "Brota a prunela",
        "1227": "Os cervos perdem os chifres", "101": "O trigo brota sob a neve", "105": "A salsa viceja", "110": "As nascentes degelam",
        "115": "Os faisões começam a cantar", "120": "Brotam os petasites", "125": "O gelo engrossa nos riachos", "130": "As galinhas começam a pôr ovos"
      }, "${md}", en)
      sky: (code, desc) => get({
