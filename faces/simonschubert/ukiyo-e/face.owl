    }
    it {
      date: "EEEE d MMMM"; weather: "meteo"; sun: "sole"; moon: "luna"; letters: "lettere"; quiet: "il cielo è calmo"; sets: t => "tramonta alle ${t}"; risesSets: "sorge e tramonta"
      allow: "Lascia che la pagina legga le tue notifiche, e arriveranno qui come lettere."
      empty: "Nessuna lettera oggi. Solo il vento tra i pini."
      now: "ora"; mins: n => "${n} min"; hours: n => "${n} h"; days: n => "${n} g"; weeks: n => "${n} sett"; years: n => n < 2 ? "${n} anno" : "${n} anni"
      moonName: k => get({"new moon": "luna nuova", "waxing crescent": "falce crescente", "first quarter": "primo quarto", "waxing gibbous": "gibbosa crescente", "full moon": "luna piena", "waning gibbous": "gibbosa calante", "last quarter": "ultimo quarto", "waning crescent": "falce calante"}, k, k)
      next: (d, m, what) => "dal ${d == 1 ? "1°" : d} ${["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"][m - 1]}: ${lower(what)}"
      ko: (md, en) => get({
        "204": "Il vento d’est scioglie il ghiaccio", "209": "Gli usignoli cantano sui monti", "214": "I pesci escono dal ghiaccio", "219": "La pioggia inumidisce la terra",
        "224": "La foschia comincia a indugiare", "301": "L’erba spunta, gli alberi germogliano", "306": "Gli insetti si risvegliano", "311": "Primi fiori di pesco",
