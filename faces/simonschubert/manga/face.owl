      nothing: "Nada de novo. A cidade dorme, ou finge que dorme."
      tapAllow: "Toque para a página ler suas notificações."
      none: "nenhum"; uptime: "uptime"; pkgs: "pacotes"; theme: "tema"; apps: n => "${n} apps"
