        "386": "leichter regen mit gewitter", "389": "starker regen mit gewitter", "392": "leichter schnee mit gewitter",
        "395": "starker schnee mit gewitter"
      }, code, lower(trim(desc)))
    }
    zh {
      date: "M月d日 EEE"; inbox: "收件箱"; notifications: "通知"; quiet: "静悄悄"; allow: "允许访问"
      nothing: "没有新消息。城市睡着了，或者在装睡。"
      tapAllow: "点按一下，让这一页读取你的通知。"
      none: "无"; uptime: "运行时间"; pkgs: "软件包"; theme: "主题"; apps: n => "${n} 个应用"
      mem: "内存"; disk: "存储"; bat: "电池"; free: b => "可用 ${b}"; comments: n => "${n} 评论"
      ago: s => s < 60 ? "刚刚" : s < 3600 ? "${floor(s / 60)}分钟" : s < 86400 ? "${floor(s / 3600)}小时" : "${floor(s / 86400)}天"
      sky: (code, desc) => get({
        "113": "晴", "116": "局部多云", "119": "多云", "122": "阴", "143": "薄雾",
        "176": "局部有雨", "179": "局部有雪", "182": "局部雨夹雪", "185": "局部冻毛毛雨",
