        "395": "сильный снег с грозой"
      }, code, lower(trim(desc)))
    }
    ja {
      date: "M月d日 EEE"; inbox: "受信箱"; notifications: "通知"; quiet: "しーん…"; allow: "許可が必要"
      nothing: "何もない。街は眠っている——いや、眠ったふりか。"
      tapAllow: "タップして、このページに通知を読ませよう。"
      none: "なし"; uptime: "稼働時間"; pkgs: "pkgs"; theme: "テーマ"; apps: n => "アプリ ${n} 個"
      mem: "メモリ"; disk: "ストレージ"; bat: "電池"; free: b => "空き ${b}"; comments: n => "コメント ${n}"
      ago: s => s < 60 ? "今" : s < 3600 ? "${floor(s / 60)} 分" : s < 86400 ? "${floor(s / 3600)} 時間" : "${floor(s / 86400)} 日"
      sky: (code, desc) => get({
        "113": "晴れ", "116": "晴れ時々曇り", "119": "曇り", "122": "本曇り", "143": "もや",
        "176": "ところにより雨", "179": "ところにより雪", "182": "ところによりみぞれ", "185": "ところにより着氷性の霧雨",
        "200": "ところにより雷", "227": "地吹雪", "230": "猛吹雪", "248": "霧", "260": "着氷性の霧",
        "263": "ところにより弱い霧雨", "266": "弱い霧雨", "281": "着氷性の霧雨", "284": "強い着氷性の霧雨",
        "293": "ところにより小雨", "296": "小雨", "299": "時々雨", "302": "雨",
        "305": "時々強い雨", "308": "強い雨", "311": "弱い着氷性の雨", "314": "強い着氷性の雨",
