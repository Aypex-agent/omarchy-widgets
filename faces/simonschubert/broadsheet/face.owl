face "broadsheet" {
  // A broadsheet of the 1890s. The masthead has today as the issue, its volume counted from 1890 and its number the day of
  // the year, and the edition by the hour. Hacker News' front page leads, its first story under an engraving of the town
  // that follows the hour, the sun and the moon and the weather; BBC World's wires and Arch Linux's notices run in the
  // next column. The weather is a woodcut in the masthead's ear, your notifications are classified advertisements and
  // the phone's fastfetch is the stock exchange. The paper is the theme's background, printed in its foreground.

  meta {
    owl: 16
    description: "A broadsheet of the 1890s: Hacker News, BBC World and Arch news in columns, an engraving of the town, the weather as a woodcut, notices as classified ads and fastfetch as the stock tables"
    version: "1.2"
    license: "MIT"
    category: "news"
  }

  // What the paper says, in the phone's language where it has a set. Day and month names come from the phone. The
  // paper's name, its editions, the weather and the stock names are worked out in English and looked up here.
  strings {
    en {
      // The masthead in blackletter where its letters are; Old Standard, cut after Russian type of the 1800s, elsewhere.
      blackletter: true
      title: t => t; edition: e => e; motto: "“All the News that Fits the Screen.”"; est: "ESTABLISHED 1890"
      date: "EEEE, MMMM d, yyyy"; vol: r => "VOL. ${r}"; no: d => "No. ${d}"; price: "One Penny"
      sky: s => s; wind: (d, s) => "wind ${d}, ${s}"
      view: w => "VIEW OF THE TOWN ${w}.—From a Drawing by Our Artist."
      presses: "THE PRESSES ARE RUNNING."; firstEdition: "Our first edition is on its way from the wire."
      heads: host => "A Matter from ${host} Heads the Front Page"; special: "SPECIAL TO THE HERALD."
      quiet: "—The wires are quiet, and our correspondents await the morning's despatches."
      account: (by, pts, com, host) => "—The matter, laid before the readers of the Hacker News by Mr. ${by}, had by this hour drawn ${pts} votes and ${com} remarks, and stands at the head of the front page. The full account may be had at ${host}; the remarks of readers, by a long press upon this column."
      meta: (host, pts, com) => "${host} · ${pts} votes · ${com} remarks"
      dateline: t => t == null ? "LONDON.—" : "LONDON, ${t}.—"
      fromHN: "From the Hacker News"; continued: "Continued"; telegraph: "By Telegraph"; notices: "Official Notices"
      hnLate: "The wire from Mountain View is late this hour."; cableSilent: "The cable is silent; despatches are expected hourly."
      ads: "Advertisements"; wanted: "WANTED."
      wantedText: "A Reader of Notices, of good character, to bring the Public's letters to this column. Apply by a tap."
      noAds: "No advertisements have been received at this office today."; notice: "notice"
      ago: (t, nw) => fmtAgo(t, nw); more: n => "${n} more within."
      exchange: "The Exchange"; stock: "STOCK"; close: "CLOSE"; chg: "CHG."; unch: "unch."; stockName: s => s
      pkgs: n => "${n} pkgs"
    }
    id {
      title: t => t == "The Morning Herald" ? "Pewarta Pagi" : "Pewarta Petang"
      blackletter: true
      edition: e => get({"Night Edition": "Edisi Malam", "Morning Edition": "Edisi Pagi", "Afternoon Edition": "Edisi Siang", "Evening Edition": "Edisi Petang", "Late Edition": "Edisi Akhir"}, e, e)
      motto: "“Semua Berita yang Muat di Layar.”"; est: "BERDIRI SEJAK 1890"
      date: "EEEE, d MMMM yyyy"; vol: r => "JIL. ${r}"; no: d => "No. ${d}"; price: "Satu Sen"
      sky: s => get({"thunder": "badai petir", "snow": "salju", "showers": "hujan sesaat", "rain": "hujan", "fog": "kabut", "cloudy": "berawan", "overcast": "mendung", "fair to cloudy": "cerah berawan", "clouding over": "mulai berawan", "fair": "cerah", "clear": "langit cerah"}, s, s)
      wind: (d, s) => "angin ${replace(replace(replace(d, "N", "U"), "E", "T"), "W", "B")}, ${get({"calm": "tenang", "light": "pelan", "fresh": "sedang", "a gale": "kencang"}, s, s)}"
      view: w => "PEMANDANGAN KOTA ${get({"BY NIGHT": "DI MALAM HARI", "AT DAWN": "KALA FAJAR", "THIS MORNING": "PAGI INI", "AT NOON": "TENGAH HARI", "THIS AFTERNOON": "SORE INI", "AT DUSK": "KALA SENJA"}, w, w)}.—Dari Sketsa Juru Gambar Kami."
      presses: "MESIN CETAK SEDANG BERPUTAR."; firstEdition: "Edisi pertama kami masih dalam perjalanan lewat kawat."
      heads: host => "Kabar dari ${host} Menjadi Berita Utama"; special: "LAPORAN KHUSUS PEWARTA."
      quiet: "—Kawat sedang sepi, dan para koresponden kami menanti kiriman berita pagi."
      account: (by, pts, com, host) => "—Perkara ini, yang diajukan kepada pembaca Hacker News oleh Tuan ${by}, hingga jam ini telah meraih ${pts} suara dan ${com} tanggapan, dan kini memuncaki halaman depan. Kisah lengkapnya dapat dibaca di ${host}; tanggapan pembaca, dengan menekan lama kolom ini."
      meta: (host, pts, com) => "${host} · ${pts} suara · ${com} tanggapan"
      dateline: t => t == null ? "LONDON.—" : "LONDON, ${t}.—"
      fromHN: "Dari Hacker News"; continued: "Sambungan"; telegraph: "Lewat Telegraf"; notices: "Pengumuman Resmi"
      hnLate: "Kawat dari Mountain View terlambat jam ini."; cableSilent: "Kabel membisu; kiriman berita ditunggu tiap jam."
      ads: "Iklan"; wanted: "DICARI."
      wantedText: "Seorang Pembaca Pemberitahuan, berbudi baik, untuk membawa surat-surat Khalayak ke kolom ini. Lamar dengan sekali ketuk."
      noAds: "Hari ini belum ada iklan yang diterima kantor kami."; notice: "pengumuman"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "kini" : nw - t < 3600 ? "${floor((nw - t) / 60)}m" : nw - t < 86400 ? "${floor((nw - t) / 3600)}j" : "${floor((nw - t) / 86400)}h"
      more: n => "${n} lagi di halaman dalam."
      exchange: "Bursa"; stock: "SAHAM"; close: "TUTUP"; chg: "+/-"; unch: "tetap"
      stockName: s => get({"Memory": "Memori", "Storage": "Penyimpanan", "Battery": "Baterai", "Uptime": "Aktif", "Apps": "Aplikasi", "Chip": "Cip", "Theme": "Tema"}, s, s)
      pkgs: n => "${n} paket"
    }
    es {
      title: t => t == "The Morning Herald" ? "Heraldo Matutino" : "Heraldo Vespertino"
      blackletter: true
      edition: e => get({"Night Edition": "Edición Nocturna", "Morning Edition": "Edición Matinal", "Afternoon Edition": "Edición de Tarde", "Evening Edition": "Edición de Noche", "Late Edition": "Última Edición"}, e, e)
      motto: "“Todas las noticias que caben en la pantalla.”"; est: "FUNDADO EN 1890"
      date: "EEEE, d 'de' MMMM 'de' yyyy"; vol: r => "AÑO ${r}"; no: d => "Núm. ${d}"; price: "Cinco Céntimos"
      sky: s => get({"thunder": "tormenta", "snow": "nieve", "showers": "chubascos", "rain": "lluvia", "fog": "niebla", "cloudy": "nuboso", "overcast": "cubierto", "fair to cloudy": "intervalos nubosos", "clouding over": "nublándose", "fair": "buen tiempo", "clear": "despejado"}, s, s)
      wind: (d, s) => "viento ${replace(d, "W", "O")}, ${get({"calm": "en calma", "light": "flojo", "fresh": "fresco", "a gale": "temporal"}, s, s)}"
      view: w => "VISTA DE LA CIUDAD ${get({"BY NIGHT": "DE NOCHE", "AT DAWN": "AL AMANECER", "THIS MORNING": "ESTA MAÑANA", "AT NOON": "A MEDIODÍA", "THIS AFTERNOON": "ESTA TARDE", "AT DUSK": "AL ANOCHECER"}, w, w)}.—De un dibujo de nuestro artista."
      presses: "LAS PRENSAS ESTÁN EN MARCHA."; firstEdition: "Nuestra primera edición viene en camino por el cable."
      heads: host => "Un asunto de ${host} encabeza la portada"; special: "ESPECIAL PARA EL HERALDO."
      quiet: "—Los cables guardan silencio, y nuestros corresponsales aguardan los despachos de la mañana."
      account: (by, pts, com, host) => "—El asunto, presentado a los lectores de Hacker News por el Sr. ${by}, había reunido a esta hora ${pts} votos y ${com} comentarios, y encabeza la portada. La crónica completa puede leerse en ${host}; los comentarios de los lectores, con una pulsación larga sobre esta columna."
      meta: (host, pts, com) => "${host} · ${pts} votos · ${com} comentarios"
      dateline: t => t == null ? "LONDRES.—" : "LONDRES, ${t}.—"
      fromHN: "De Hacker News"; continued: "Continuación"; telegraph: "Por Telégrafo"; notices: "Avisos Oficiales"
      hnLate: "El cable de Mountain View se retrasa a esta hora."; cableSilent: "El cable calla; se esperan despachos cada hora."
      ads: "Anuncios"; wanted: "SE BUSCA."
      wantedText: "Lector de Notificaciones, de buena conducta, que traiga a esta columna las cartas del Público. Preséntese con un toque."
      noAds: "Hoy no se ha recibido ningún anuncio en esta redacción."; notice: "aviso"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "ahora" : fmtAgo(t, nw)
      more: n => "${n} más en páginas interiores."
      exchange: "La Bolsa"; stock: "VALOR"; close: "CIERRE"; chg: "VAR."; unch: "igual"
      stockName: s => get({"Memory": "Memoria", "Storage": "Almacenamiento", "Battery": "Batería", "Uptime": "Uptime", "Apps": "Apps", "Kernel": "Kernel", "Chip": "Chip", "Theme": "Tema"}, s, s)
      pkgs: n => "${n} paq."
    }
    pt {
      title: t => t == "The Morning Herald" ? "Arauto Matutino" : "Arauto Vespertino"
      blackletter: true
      edition: e => get({"Night Edition": "Edição Noturna", "Morning Edition": "Edição Matutina", "Afternoon Edition": "Edição da Tarde", "Evening Edition": "Edição da Noite", "Late Edition": "Última Edição"}, e, e)
      motto: "“Todas as notícias que cabem na tela.”"; est: "FUNDADO EM 1890"
      date: "EEEE, d 'de' MMMM 'de' yyyy"; vol: r => "ANO ${r}"; no: d => "N.º ${d}"; price: "Cem Réis"
      sky: s => get({"thunder": "trovoada", "snow": "neve", "showers": "pancadas de chuva", "rain": "chuva", "fog": "nevoeiro", "cloudy": "nublado", "overcast": "encoberto", "fair to cloudy": "parcialmente nublado", "clouding over": "fechando o tempo", "fair": "bom tempo", "clear": "céu limpo"}, s, s)
      wind: (d, s) => "vento ${replace(d, "W", "O")}, ${get({"calm": "calmo", "light": "fraco", "fresh": "fresco", "a gale": "vendaval"}, s, s)}"
      view: w => "VISTA DA CIDADE ${get({"BY NIGHT": "À NOITE", "AT DAWN": "AO AMANHECER", "THIS MORNING": "ESTA MANHÃ", "AT NOON": "AO MEIO-DIA", "THIS AFTERNOON": "ESTA TARDE", "AT DUSK": "AO ANOITECER"}, w, w)}.—De um desenho do nosso artista."
      presses: "AS PRENSAS ESTÃO RODANDO."; firstEdition: "Nossa primeira edição está a caminho pelo telégrafo."
      heads: host => "Um assunto de ${host} abre a primeira página"; special: "EXCLUSIVO PARA O ARAUTO."
      quiet: "—Os fios estão calados, e nossos correspondentes aguardam os despachos da manhã."
      account: (by, pts, com, host) => "—O assunto, apresentado aos leitores do Hacker News pelo Sr. ${by}, havia reunido até esta hora ${pts} votos e ${com} comentários, e encabeça a primeira página. O relato completo pode ser lido em ${host}; os comentários dos leitores, com um toque longo nesta coluna."
      meta: (host, pts, com) => "${host} · ${pts} votos · ${com} comentários"
      dateline: t => t == null ? "LONDRES.—" : "LONDRES, ${t}.—"
      fromHN: "Do Hacker News"; continued: "Continuação"; telegraph: "Pelo Telégrafo"; notices: "Avisos Oficiais"
      hnLate: "O telegrama de Mountain View está atrasado nesta hora."; cableSilent: "O cabo está mudo; aguardam-se despachos a cada hora."
      ads: "Anúncios"; wanted: "PROCURA-SE."
      wantedText: "Leitor de Notificações, de boa índole, para trazer as cartas do Público a esta coluna. Candidate-se com um toque."
      noAds: "Nenhum anúncio foi recebido nesta redação hoje."; notice: "aviso"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "agora" : fmtAgo(t, nw)
      more: n => "Mais ${n} nas páginas internas."
      exchange: "A Bolsa"; stock: "AÇÃO"; close: "FECH."; chg: "VAR."; unch: "igual"
      stockName: s => get({"Memory": "Memória", "Storage": "Armazenamento", "Battery": "Bateria", "Uptime": "Uptime", "Apps": "Apps", "Kernel": "Kernel", "Chip": "Chip", "Theme": "Tema"}, s, s)
      pkgs: n => "${n} pac."
    }
    de {
      title: t => t == "The Morning Herald" ? "Der Morgenbote" : "Der Abendbote"
      blackletter: true
      edition: e => get({"Night Edition": "Nachtausgabe", "Morning Edition": "Morgenausgabe", "Afternoon Edition": "Mittagsausgabe", "Evening Edition": "Abendausgabe", "Late Edition": "Spätausgabe"}, e, e)
      motto: "„Alle Nachrichten, die auf den Schirm passen.“"; est: "GEGRÜNDET 1890"
      date: "EEEE, d. MMMM yyyy"; vol: r => "JAHRG. ${r}"; no: d => "Nr. ${d}"; price: "Zehn Pfennig"
      sky: s => get({"thunder": "Gewitter", "snow": "Schnee", "showers": "Schauer", "rain": "Regen", "fog": "Nebel", "cloudy": "wolkig", "overcast": "bedeckt", "fair to cloudy": "heiter bis wolkig", "clouding over": "zieht zu", "fair": "heiter", "clear": "klar"}, s, s)
      wind: (d, s) => "Wind ${replace(d, "E", "O")}, ${get({"calm": "still", "light": "schwach", "fresh": "frisch", "a gale": "stürmisch"}, s, s)}"
      view: w => "ANSICHT DER STADT ${get({"BY NIGHT": "BEI NACHT", "AT DAWN": "IN DER FRÜHE", "THIS MORNING": "AM MORGEN", "AT NOON": "ZU MITTAG", "THIS AFTERNOON": "AM NACHMITTAG", "AT DUSK": "AM ABEND"}, w, w)}.—Nach einer Zeichnung unseres Künstlers."
      presses: "DIE PRESSEN LAUFEN."; firstEdition: "Unsere erste Ausgabe ist über den Draht unterwegs."
      heads: host => "Eine Meldung aus ${host} führt das Blatt an"; special: "EIGENBERICHT."
      quiet: "—Die Drähte schweigen, und unsere Korrespondenten erwarten die Depeschen des Morgens."
      account: (by, pts, com, host) => "—Die Sache, den Lesern der Hacker News von Herrn ${by} vorgelegt, hatte zu dieser Stunde ${pts} Stimmen und ${com} Bemerkungen auf sich gezogen und steht an der Spitze der Titelseite. Der vollständige Bericht ist bei ${host} zu haben; die Bemerkungen der Leser durch langes Drücken auf diese Spalte."
      meta: (host, pts, com) => "${host} · ${pts} Stimmen · ${com} Kommentare"
      dateline: t => t == null ? "LONDON.—" : "LONDON, ${t}.—"
      fromHN: "Aus Hacker News"; continued: "Fortsetzung"; telegraph: "Per Telegraph"; notices: "Amtliches"
      hnLate: "Die Depesche aus Mountain View hat Verspätung."; cableSilent: "Das Kabel schweigt; Depeschen werden stündlich erwartet."
      ads: "Anzeigen"; wanted: "GESUCHT."
      wantedText: "Ein Leser von Benachrichtigungen, von gutem Leumund, der die Briefe des Publikums in diese Spalte bringt. Bewerbung durch Antippen."
      noAds: "Heute sind bei uns keine Anzeigen eingegangen."; notice: "Anzeige"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "jetzt" : nw - t < 3600 ? "${floor((nw - t) / 60)} min" : nw - t < 86400 ? "${floor((nw - t) / 3600)} std" : "${floor((nw - t) / 86400)} tg"
      more: n => "Weitere ${n} im Innenteil."
      exchange: "Die Börse"; stock: "WERT"; close: "SCHLUSS"; chg: "+/-"; unch: "unv."
      stockName: s => get({"Memory": "Arbeitsspeicher", "Storage": "Speicher", "Battery": "Akku", "Uptime": "Laufzeit", "Apps": "Apps", "Kernel": "Kernel", "Chip": "Chip", "Theme": "Thema"}, s, s)
      pkgs: n => "${n} Pakete"
    }
    zh {
      title: t => t == "The Morning Herald" ? "先驱晨报" : "先驱晚报"
      blackletter: false
      edition: e => get({"Night Edition": "夜间版", "Morning Edition": "早间版", "Afternoon Edition": "午后版", "Evening Edition": "晚间版", "Late Edition": "深夜版"}, e, e)
      motto: "“屏幕装得下的新闻，尽在于此。”"; est: "创刊于 1890 年"
      date: "yyyy年M月d日 EEEE"; vol: r => "第 ${r} 卷"; no: d => "第 ${d} 号"; price: "每份一分"
      sky: s => get({"thunder": "雷暴", "snow": "雪", "showers": "阵雨", "rain": "雨", "fog": "雾", "cloudy": "多云", "overcast": "阴", "fair to cloudy": "晴间多云", "clouding over": "转阴", "fair": "晴", "clear": "晴朗"}, s, s)
      wind: (d, s) => s == "calm" ? "静风" : "${get({"N": "北", "NNE": "北", "NE": "东北", "ENE": "东", "E": "东", "ESE": "东", "SE": "东南", "SSE": "南", "S": "南", "SSW": "南", "SW": "西南", "WSW": "西", "W": "西", "WNW": "西", "NW": "西北", "NNW": "北"}, d, d)}风 ${get({"light": "轻微", "fresh": "较强", "a gale": "强劲"}, s, s)}"
      view: w => "${get({"BY NIGHT": "夜色中的城镇", "AT DAWN": "黎明时分的城镇", "THIS MORNING": "今晨的城镇", "AT NOON": "正午的城镇", "THIS AFTERNOON": "今日午后的城镇", "AT DUSK": "黄昏时分的城镇"}, w, w)}。——据本报画师素描。"
      presses: "印刷机正在运转。"; firstEdition: "本报首版正经电报传来。"
      heads: host => "来自 ${host} 的消息登上头版头条"; special: "本报特稿。"
      quiet: "——电讯沉寂，本报记者正静候晨间电文。"
      account: (by, pts, com, host) => "——此事由 ${by} 先生呈于 Hacker News 读者面前，截至此时已获 ${pts} 票、${com} 条评论，高居头版之首。全文见于 ${host}；读者评论，长按本栏即可查阅。"
      meta: (host, pts, com) => "${host} · ${pts} 票 · ${com} 条评论"
      dateline: t => t == null ? "伦敦电——" : "伦敦 ${t} 电——"
      fromHN: "Hacker News 消息"; continued: "续前栏"; telegraph: "电讯"; notices: "官方公告"
      hnLate: "山景城的电讯此刻尚未到达。"; cableSilent: "电缆沉寂，电文预计每小时到达。"
      ads: "广告"; wanted: "招聘。"
      wantedText: "诚聘通知阅读员一名，品行端正，负责将公众来信送至本栏。轻点即可应聘。"
      noAds: "本报今日尚未收到任何广告。"; notice: "启事"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "刚刚" : nw - t < 3600 ? "${floor((nw - t) / 60)}分钟" : nw - t < 86400 ? "${floor((nw - t) / 3600)}小时" : "${floor((nw - t) / 86400)}天"
      more: n => "另有 ${n} 条，见内页。"
      exchange: "股市行情"; stock: "股票"; close: "收盘"; chg: "涨跌"; unch: "持平"
      stockName: s => get({"Memory": "内存", "Storage": "存储", "Battery": "电池", "Uptime": "运行时间", "Apps": "应用", "Kernel": "内核", "Chip": "芯片", "Theme": "主题"}, s, s)
      pkgs: n => "${n} 个包"
    }
    ru {
      title: t => t == "The Morning Herald" ? "Утренний вестник" : "Вечерний вестник"
      blackletter: false
      edition: e => get({"Night Edition": "Ночной выпуск", "Morning Edition": "Утренний выпуск", "Afternoon Edition": "Дневной выпуск", "Evening Edition": "Вечерний выпуск", "Late Edition": "Поздний выпуск"}, e, e)
      motto: "«Все новости, что уместились на экране»"; est: "ОСНОВАНА В 1890 г."
      date: "EEEE, d MMMM yyyy"; vol: r => "ГОД ${r}"; no: d => "№ ${d}"; price: "Цена 5 коп."
      sky: s => get({"thunder": "гроза", "snow": "снег", "showers": "ливень", "rain": "дождь", "fog": "туман", "cloudy": "облачно", "overcast": "пасмурно", "fair to cloudy": "переменная облачность", "clouding over": "затягивает", "fair": "ясно", "clear": "безоблачно"}, s, s)
      wind: (d, s) => "ветер ${replace(replace(replace(replace(d, "N", "С"), "E", "В"), "S", "Ю"), "W", "З")}, ${get({"calm": "штиль", "light": "слабый", "fresh": "свежий", "a gale": "шторм"}, s, s)}"
      view: w => "ВИД ГОРОДА ${get({"BY NIGHT": "НОЧЬЮ", "AT DAWN": "НА РАССВЕТЕ", "THIS MORNING": "СЕГОДНЯ УТРОМ", "AT NOON": "В ПОЛДЕНЬ", "THIS AFTERNOON": "СЕГОДНЯ ДНЁМ", "AT DUSK": "В СУМЕРКАХ"}, w, w)}.—С рисунка нашего художника."
      presses: "ПЕЧАТНЫЕ МАШИНЫ ЗАПУЩЕНЫ."; firstEdition: "Наш первый выпуск уже идёт по проводам."
      heads: host => "Сообщение с ${host} — на первой полосе"; special: "СПЕЦИАЛЬНО ДЛЯ «ВЕСТНИКА»."
      quiet: "—Провода молчат, наши корреспонденты ждут утренних депеш."
      account: (by, pts, com, host) => "—Дело, вынесенное г-ном ${by} на суд читателей Hacker News, к этому часу собрало голосов — ${pts}, отзывов — ${com} и возглавляет первую полосу. Полный отчёт — на ${host}; отзывы читателей — долгим нажатием на эту колонку."
      meta: (host, pts, com) => "${host} · голосов: ${pts} · отзывов: ${com}"
      dateline: t => t == null ? "ЛОНДОН.—" : "ЛОНДОН, ${t}.—"
      fromHN: "Из Hacker News"; continued: "Продолжение"; telegraph: "По телеграфу"; notices: "Официально"
      hnLate: "Депеша из Маунтин-Вью в этот час запаздывает."; cableSilent: "Кабель молчит; депеши ожидаются ежечасно."
      ads: "Объявления"; wanted: "ТРЕБУЕТСЯ."
      wantedText: "Чтец уведомлений, благонадёжный, — доставлять письма публики в эту колонку. Обращаться касанием."
      noAds: "Сегодня в редакцию не поступило ни одного объявления."; notice: "объявление"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "сейчас" : nw - t < 3600 ? "${floor((nw - t) / 60)} мин" : nw - t < 86400 ? "${floor((nw - t) / 3600)} ч" : "${floor((nw - t) / 86400)} д"
      more: n => "Ещё ${n} — внутри номера."
      exchange: "Биржа"; stock: "БУМАГА"; close: "ЗАКР."; chg: "ИЗМ."; unch: "б/и"
      stockName: s => get({"Memory": "Память", "Storage": "Хранилище", "Battery": "Батарея", "Uptime": "Аптайм", "Apps": "Приложения", "Kernel": "Ядро", "Chip": "Чип", "Theme": "Тема"}, s, s)
      pkgs: n => "${n} пак."
    }
    ja {
      title: t => t == "The Morning Herald" ? "ヘラルド朝刊" : "ヘラルド夕刊"
      blackletter: false
      edition: e => get({"Night Edition": "深夜版", "Morning Edition": "朝刊", "Afternoon Edition": "午後版", "Evening Edition": "夕刊", "Late Edition": "最終版"}, e, e)
      motto: "「画面に収まるニュースは、すべてここに」"; est: "1890 年創刊"
      date: "yyyy年M月d日 EEEE"; vol: r => "第 ${r} 巻"; no: d => "第 ${d} 号"; price: "定価一銭"
      sky: s => get({"thunder": "雷雨", "snow": "雪", "showers": "にわか雨", "rain": "雨", "fog": "霧", "cloudy": "曇り", "overcast": "本曇り", "fair to cloudy": "晴れ時々曇り", "clouding over": "次第に曇り", "fair": "晴れ", "clear": "快晴"}, s, s)
      wind: (d, s) => s == "calm" ? "無風" : "${get({"N": "北", "NNE": "北", "NE": "北東", "ENE": "東", "E": "東", "ESE": "東", "SE": "南東", "SSE": "南", "S": "南", "SSW": "南", "SW": "南西", "WSW": "西", "W": "西", "WNW": "西", "NW": "北西", "NNW": "北"}, d, d)}の風${get({"light": "", "fresh": " やや強く", "a gale": " 強く"}, s, "")}"
      view: w => "${get({"BY NIGHT": "夜", "AT DAWN": "夜明け", "THIS MORNING": "今朝", "AT NOON": "正午", "THIS AFTERNOON": "今日の午後", "AT DUSK": "夕暮れ"}, w, w)}の町の眺め。——本紙画家のスケッチより。"
      presses: "輪転機、稼働中。"; firstEdition: "本紙第一版は電信にて到着予定。"
      heads: host => "${host} 発の話題が一面トップに"; special: "本紙特報。"
      quiet: "——電信は静まり返り、本紙特派員は朝の電報を待っている。"
      account: (by, pts, com, host) => "——${by} 氏により Hacker News の読者に示されたこの件は、この時刻までに ${pts} 票と ${com} 件の意見を集め、一面の筆頭を占めている。詳報は ${host} にて。読者の意見は、本欄の長押しにてご覧いただける。"
      meta: (host, pts, com) => "${host} · ${pts} 票 · 意見 ${com} 件"
      dateline: t => t == null ? "ロンドン発——" : "ロンドン ${t} 発——"
      fromHN: "Hacker News より"; continued: "前欄より続く"; telegraph: "電信"; notices: "告示"
      hnLate: "マウンテンビューからの電信が遅れております。"; cableSilent: "海底電線は沈黙。電報は毎時到着の見込み。"
      ads: "広告"; wanted: "求む。"
      wantedText: "通知を読む者、品行方正なる方。読者諸賢の便りを本欄へ届けられたし。応募はタップにて。"
      noAds: "本日、当社への広告の申し込みはありません。"; notice: "お知らせ"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "今" : nw - t < 3600 ? "${floor((nw - t) / 60)} 分" : nw - t < 86400 ? "${floor((nw - t) / 3600)} 時間" : "${floor((nw - t) / 86400)} 日"
      more: n => "ほか ${n} 件は中面に。"
      exchange: "株式市況"; stock: "銘柄"; close: "終値"; chg: "前比"; unch: "横ばい"
      stockName: s => get({"Memory": "メモリ", "Storage": "ストレージ", "Battery": "バッテリー", "Uptime": "稼働時間", "Apps": "アプリ", "Kernel": "カーネル", "Chip": "チップ", "Theme": "テーマ"}, s, s)
      pkgs: n => "${n} 個"
    }
    uk {
      title: t => t == "The Morning Herald" ? "Ранковий вісник" : "Вечірній вісник"
      blackletter: false
      edition: e => get({"Night Edition": "Нічний випуск", "Morning Edition": "Ранковий випуск", "Afternoon Edition": "Денний випуск", "Evening Edition": "Вечірній випуск", "Late Edition": "Пізній випуск"}, e, e)
      motto: "«Усі новини, що вмістилися на екрані»"; est: "ЗАСНОВАНА 1890 р."
      date: "EEEE, d MMMM yyyy"; vol: r => "РІК ${r}"; no: d => "№ ${d}"; price: "Ціна 5 коп."
      sky: s => get({"thunder": "гроза", "snow": "сніг", "showers": "злива", "rain": "дощ", "fog": "туман", "cloudy": "хмарно", "overcast": "похмуро", "fair to cloudy": "мінлива хмарність", "clouding over": "хмарніє", "fair": "ясно", "clear": "безхмарно"}, s, s)
      wind: (d, s) => "вітер ${get({"N": "Пн", "NNE": "Пн", "NE": "ПнСх", "ENE": "Сх", "E": "Сх", "ESE": "Сх", "SE": "ПдСх", "SSE": "Пд", "S": "Пд", "SSW": "Пд", "SW": "ПдЗх", "WSW": "Зх", "W": "Зх", "WNW": "Зх", "NW": "ПнЗх", "NNW": "Пн"}, d, d)}, ${get({"calm": "штиль", "light": "слабкий", "fresh": "свіжий", "a gale": "шторм"}, s, s)}"
      view: w => "ВИГЛЯД МІСТА ${get({"BY NIGHT": "ВНОЧІ", "AT DAWN": "НА СВІТАНКУ", "THIS MORNING": "СЬОГОДНІ ВРАНЦІ", "AT NOON": "ОПІВДНІ", "THIS AFTERNOON": "СЬОГОДНІ ВДЕНЬ", "AT DUSK": "У СУТІНКАХ"}, w, w)}.—З малюнка нашого художника."
      presses: "ДРУКАРСЬКІ МАШИНИ ЗАПУЩЕНО."; firstEdition: "Наш перший випуск уже йде дротами."
      heads: host => "Повідомлення з ${host} — на першій шпальті"; special: "СПЕЦІАЛЬНО ДЛЯ «ВІСНИКА»."
      quiet: "—Дроти мовчать, наші кореспонденти чекають ранкових депеш."
      account: (by, pts, com, host) => "—Справа, яку пан ${by} виніс на суд читачів Hacker News, на цю годину зібрала голосів — ${pts}, відгуків — ${com} і очолює першу шпальту. Повний звіт — на ${host}; відгуки читачів — довгим натисканням на цю колонку."
      meta: (host, pts, com) => "${host} · голосів: ${pts} · відгуків: ${com}"
      dateline: t => t == null ? "ЛОНДОН.—" : "ЛОНДОН, ${t}.—"
      fromHN: "З Hacker News"; continued: "Продовження"; telegraph: "Телеграфом"; notices: "Офіційно"
      hnLate: "Депеша з Маунтін-В'ю цієї години запізнюється."; cableSilent: "Кабель мовчить; депеші очікуються щогодини."
      ads: "Оголошення"; wanted: "ПОТРІБЕН."
      wantedText: "Читач сповіщень, доброї вдачі, — доставляти листи публіки до цієї колонки. Звертатися дотиком."
      noAds: "Сьогодні до редакції не надійшло жодного оголошення."; notice: "оголошення"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "зараз" : nw - t < 3600 ? "${floor((nw - t) / 60)} хв" : nw - t < 86400 ? "${floor((nw - t) / 3600)} год" : "${floor((nw - t) / 86400)} дн"
      more: n => "Ще ${n} — усередині номера."
      exchange: "Біржа"; stock: "ПАПІР"; close: "ЗАКР."; chg: "ЗМІН."; unch: "б/з"
      stockName: s => get({"Memory": "Пам'ять", "Storage": "Сховище", "Battery": "Батарея", "Uptime": "Аптайм", "Apps": "Додатки", "Kernel": "Ядро", "Chip": "Чип", "Theme": "Тема"}, s, s)
      pkgs: n => "${n} пак."
    }
    fr {
      title: t => t == "The Morning Herald" ? "L’Écho du Matin" : "L’Écho du Soir"
      blackletter: true
      edition: e => get({"Night Edition": "Édition de nuit", "Morning Edition": "Édition du matin", "Afternoon Edition": "Édition de midi", "Evening Edition": "Édition du soir", "Late Edition": "Dernière édition"}, e, e)
      motto: "« Toutes les nouvelles qui tiennent sur l’écran. »"; est: "FONDÉ EN 1890"
      date: "EEEE d MMMM yyyy"; vol: r => "${r}e ANNÉE"; no: d => "N° ${d}"; price: "Cinq centimes"
      sky: s => get({"thunder": "orage", "snow": "neige", "showers": "averses", "rain": "pluie", "fog": "brouillard", "cloudy": "nuageux", "overcast": "couvert", "fair to cloudy": "passages nuageux", "clouding over": "se couvre", "fair": "beau temps", "clear": "dégagé"}, s, s)
      wind: (d, s) => "vent ${replace(d, "W", "O")}, ${get({"calm": "calme", "light": "faible", "fresh": "frais", "a gale": "tempête"}, s, s)}"
      view: w => "VUE DE LA VILLE ${get({"BY NIGHT": "LA NUIT", "AT DAWN": "À L’AUBE", "THIS MORNING": "CE MATIN", "AT NOON": "À MIDI", "THIS AFTERNOON": "CET APRÈS-MIDI", "AT DUSK": "AU CRÉPUSCULE"}, w, w)}.—D’après un dessin de notre artiste."
      presses: "LES PRESSES TOURNENT."; firstEdition: "Notre première édition arrive par le fil."
      heads: host => "Une nouvelle de ${host} fait la une"; special: "SERVICE SPÉCIAL DE L’ÉCHO."
      quiet: "—Les fils sont muets, et nos correspondants attendent les dépêches du matin."
      account: (by, pts, com, host) => "—L’affaire, soumise aux lecteurs de Hacker News par M. ${by}, avait recueilli à cette heure ${pts} voix et ${com} remarques, et tient la tête de la une. Le compte rendu complet se trouve chez ${host} ; les remarques des lecteurs, en appuyant longuement sur cette colonne."
      meta: (host, pts, com) => "${host} · ${pts} voix · ${com} remarques"
      dateline: t => t == null ? "LONDRES.—" : "LONDRES, ${t}.—"
      fromHN: "De Hacker News"; continued: "Suite"; telegraph: "Par télégraphe"; notices: "Avis officiels"
      hnLate: "Le fil de Mountain View a du retard à cette heure."; cableSilent: "Le câble est muet ; on attend des dépêches d’heure en heure."
      ads: "Petites annonces"; wanted: "ON DEMANDE."
      wantedText: "Lecteur de notifications, de bonne moralité, pour porter à cette colonne les lettres du public. Se présenter d’une touche."
      noAds: "Aucune annonce n’est parvenue à nos bureaux aujourd’hui."; notice: "avis"
      ago: (t, nw) => t == null ? "" : nw - t < 60 ? "à l’instant" : nw - t < 3600 ? "il y a ${floor((nw - t) / 60)} min" : nw - t < 86400 ? "il y a ${floor((nw - t) / 3600)} h" : "il y a ${floor((nw - t) / 86400)} j"
      more: n => n == 1 ? "Une autre en pages intérieures." : "${n} autres en pages intérieures."
      exchange: "La Bourse"; stock: "VALEUR"; close: "CLÔTURE"; chg: "VAR."; unch: "inch."
      stockName: s => get({"Memory": "Mémoire", "Storage": "Stockage", "Battery": "Batterie", "Uptime": "Uptime", "Apps": "Applis", "Kernel": "Noyau", "Chip": "Puce", "Theme": "Thème"}, s, s)
      pkgs: n => "${n} paq."
    }
  }

  background: background
  padding: 0

  source now = clock every 1m
  source n = android.notifications
  source dev = android.device
  source sys = android.system every 1m
  source bat = android.battery
  source hn = http("https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=20") every 15m timeout 15s json
  source bbc = http("https://feeds.bbci.co.uk/news/world/rss.xml") every 30m timeout 15s
  source arch = http("https://archlinux.org/feeds/news/") every 6h timeout 15s
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json
  // Arch, once Linux is installed; base tools only, so the page still works without it.
  source lx = cmd("""
    . /etc/os-release
    printf '%s\t%s\n' "$PRETTY_NAME" "$(pacman -Qq | wc -l)"
  """) every 1h optional

  let fraktur = "https://raw.githubusercontent.com/google/fonts/main/ofl/unifrakturmaguntia/UnifrakturMaguntia-Book.ttf"
  let roman = "https://raw.githubusercontent.com/google/fonts/main/ofl/oldstandardtt/OldStandard-Regular.ttf"
  let bold = "https://raw.githubusercontent.com/google/fonts/main/ofl/oldstandardtt/OldStandard-Bold.ttf"
  let italic = "https://raw.githubusercontent.com/google/fonts/main/ofl/oldstandardtt/OldStandard-Italic.ttf"
  let ink = foreground
  let paper = background

  // The issue: volume 1 was 1890, the number is the day of the year.
  let year = num(fmtTime(now, "yyyy"))
  let vol = year - 1889
  let rom = [["", "C", "CC", "CCC"][floor(vol / 100) % 4], ["", "X", "XX", "XXX", "XL", "L", "LX", "LXX", "LXXX", "XC"][floor(vol / 10) % 10], ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX"][vol % 10]]
  let h = num(fmtTime(now, "H")) + num(fmtTime(now, "m")) / 60
  let edition = h < 5 ? "Night Edition" : h < 12 ? "Morning Edition" : h < 17 ? "Afternoon Edition" : h < 21 ? "Evening Edition" : "Late Edition"
  let title = h >= 5 && h < 12 ? "The Morning Herald" : "The Evening Herald"

  // The weather, in the words of the day's forecasts.
  let cur = wx.current_condition[0]
  let code = cur.weatherCode ?? "113"
  let rain = contains(["176", "263", "266", "281", "284", "293", "296", "299", "302", "305", "308", "311", "314", "353", "356", "359"], code) ? 1 : 0
  let storm = contains(["200", "386", "389", "392", "395"], code) ? 1 : 0
  let snow = contains(["179", "182", "185", "227", "230", "317", "320", "323", "326", "329", "332", "335", "338", "350", "362", "365", "368", "371", "374", "377"], code) ? 1 : 0
  let fog = contains(["143", "248", "260"], code) ? 1 : 0
  let cloud = code == "113" ? 0.0 : code == "116" ? 0.5 : 1.0
  let ast = wx.weather[0].astronomy[0]
  let sun = [ast.sunrise, ast.sunset].map(s => [match(s ?? "", "([0-9]+):([0-9]+) (AM|PM)")].map(g => g == null ? null : num(g[0]) % 12 + (g[2] == "PM" ? 12 : 0) + num(g[1]) / 60)[0])
  let rise = sun[0] ?? 6.5
  let set = sun[1] ?? 18.5
  let day = h > rise && h < set
  let phase = ((now - 947182440) / 86400 % 29.530588853) / 29.530588853
  let sky = storm ? "thunder" : snow ? "snow" : rain ? (code == "176" || code == "353" || code == "263" || code == "266" ? "showers" : "rain") : fog ? "fog" : cloud > 0.9 ? (code == "119" ? "cloudy" : "overcast") : cloud > 0.4 ? (day ? "fair to cloudy" : "clouding over") : (day ? "fair" : "clear")
  let skyText = str.sky(sky)
  let glyph = storm || rain ? "rain" : snow ? "snow" : fog ? "fog" : cloud > 0.9 ? "cloud" : cloud > 0.4 ? "part" : day ? "sun" : "moon"
  let wind = cur == null ? null : str.wind(cur.winddir16Point, num(cur.windspeedKmph) < 6 ? "calm" : num(cur.windspeedKmph) < 20 ? "light" : num(cur.windspeedKmph) < 40 ? "fresh" : "a gale")

  // The news. Hacker News' front page, then the wires: an RSS item's title and description, CDATA or escaped.
  let stories = (hn.hits ?? []).filter(x => x.title != null).map(x => {
    title: x.title, id: x.objectID, by: x.author, pts: x.points ?? 0, com: x.num_comments ?? 0,
    link: x.url ?? "https://news.ycombinator.com/item?id=${x.objectID}",
    host: (match(x.url ?? "", "https?://(?:www\\.)?([^/:?]+)") ?? [])[0] ?? "news.ycombinator.com"
  })
  let lead = stories[0]
  // Entities are decoded over the whole feed first, &amp; last; an Arch notice's escaped HTML is never shown.
  let feeds = [bbc, arch].map(f => replace(replace(replace(replace(replace(replace(replace(replace(replace(f ?? "", "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&#39;", "'"), "&#x27;", "'"), "&rsquo;", "’"), "&lsquo;", "‘"), "&nbsp;", " "), "&amp;", "&")).map(f => matchAll(f, "<item>([\\s\\S]*?)</item>").map(m => m[0]).map(it => {
    title: trim((match(it, "<title>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</title>") ?? [])[0] ?? ""),
    text: trim((match(it, "<description>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</description>") ?? [])[0] ?? ""),
    link: (match(it, "<link>(?:<!\\[CDATA\\[)?\\s*(https?://[^<\\]\\s]+)") ?? [])[0],
    at: match(it, "<pubDate>[^<]*?(\\d{1,2} \\w{3})[^<]*?(\\d\\d:\\d\\d)") ?? []
  }).filter(i => i.title != ""))
  let wires = feeds[0].take(8).map(i => { title: i.title, text: i.text, link: i.link, time: i.at[1] })
  let notices = feeds[1].take(3).map(i => { title: i.title, link: i.link, date: i.at[0] })

  // The exchange: the phone's fastfetch, at the minute's close against the minute before.
  let lxs = lx == null || lx == "" ? null : split(lx, "\t")
  let memPct = sys.memory == null || !sys.memory.total ? null : sys.memory.used / sys.memory.total * 100
  let diskPct = sys.storage == null || !sys.storage.total ? null : sys.storage.used / sys.storage.total * 100
  let memWas = prev(memPct)
  let diskWas = prev(diskPct)
  let batWas = prev(bat.level)
  let stocks = [
    ["Memory", memPct == null ? null : "${round(memPct)}%", memPct == null || memWas == null ? 0 : memPct - memWas],
    ["Storage", diskPct == null ? null : "${round(diskPct)}%", diskPct == null || diskWas == null ? 0 : diskPct - diskWas],
    ["Battery", bat.level == null ? null : "${bat.level}%", bat.level == null || batWas == null ? 0 : bat.level - batWas],
    ["Uptime", sys.uptime == null ? null : fmtDuration(sys.uptime), null],
    linux && lxs != null ? ["Pacman", str.pkgs(fmtNum(num(lxs[1]))), null] : ["Apps", sys.apps == null ? null : "${sys.apps}", null],
    ["Kernel", sys.kernel == null ? null : first(split(sys.kernel, "-")), null],
    ["Android", dev == null ? null : "${dev.android}", null],
    ["Chip", sys.cpu == null ? null : (sys.cpu.soc == "" || sys.cpu.soc == null ? sys.cpu.hardware : sys.cpu.soc), null],
    ["Theme", sys.theme == null ? null : lower(sys.theme), null]
  ]

  // The page, laid out by its size: two columns of news on a phone, four on a wide screen.
  let W = tileWidth ?? 412
  let H = tileHeight ?? 900
  let wide = W > H
  let m = 12
  let CW = W - 2 * m
  let plateW = wide ? floor(CW * 0.3) : floor(CW * 0.56)
  // On its side a phone is short: the plate takes what the masthead and the headline leave.
  let plateH = wide ? floor(clamp(H - 310 - screenInset, 70, plateW * 0.62)) : floor(plateW * 0.7)
  // What the columns have left, under the masthead (about 150), the lead and above the advertisements (about 190), at
  // about 60 dp a story, as an estimate: a column is clipped below anyway.
  let colH = H - 24 - screenInset - 150 - (wide ? 0 : plateH + 80) - (wide ? 0 : 200)
  let nStories = clamp(floor(colH / 62), 2, 12)
  let ads = n.available ? n.items.take(wide ? 4 : 3) : []

  let plate = """
    uniform half4 paper;
    uniform half4 ink;
    uniform float dpw;
    uniform float hour;
    uniform float rise;
    uniform float sset;
    uniform float cloud;
    uniform float rain;
    uniform float snow;
    uniform float fog;
    uniform float phase;
    uniform float seed;
    float h1(float n) { return fract(sin(n * 12.9898) * 43758.5453); }
    float h2(float2 p) { return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453); }
    float vn(float2 p) {
      float2 i = floor(p);
      float2 f = fract(p);
      float2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(h2(i), h2(i + float2(1.0, 0.0)), u.x), mix(h2(i + float2(0.0, 1.0)), h2(i + float2(1.0, 1.0)), u.x), u.y);
    }
    float fbm(float2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) { v += a * vn(p); p = p * 2.03 + float2(17.0, 9.0); a *= 0.5; }
      return v;
    }
    // Parallel lines at an angle, sp dp apart, as thick as the tone asks: the engraver's whole palette.
    float hatch(float2 q, float ang, float sp, float tone, float aa) {
      float d = abs(fract(dot(q, float2(cos(ang), sin(ang))) / sp) - 0.5) * sp;
      float w = clamp(tone, 0.0, 1.0) * sp * 0.5;
      return 1.0 - smoothstep(w - aa, w + aa, d);
    }
    // Darker tones take a second layer across the first, the darkest a third.
    float engrave(float2 q, float tone, float ang, float aa) {
      float k = hatch(q, ang, 2.4, tone * 1.2, aa);
      if (tone > 0.5) { k = max(k, hatch(q, ang + 1.5708, 2.4, (tone - 0.5) * 1.5, aa)); }
      if (tone > 0.8) { k = max(k, hatch(q, ang + 0.7854, 2.4, (tone - 0.8) * 2.5, aa)); }
      return k;
    }
    float cover(float d, float w, float aa) { return 1.0 - smoothstep(w - aa, w + aa, d); }
    half4 main(float2 p) {
      float s = size.x / dpw;
      float2 q = p / s;
      float W = dpw;
      float H = size.y / s;
      float aa = 0.55 / s;
      float day = smoothstep(rise - 0.6, rise + 0.6, hour) * (1.0 - smoothstep(sset - 0.6, sset + 0.6, hour));
      float wet = max(rain, snow);
      float hz = H * 0.66;
      float L = 0.0;

      // The sky in level lines, heavier towards the top, and heavy all over by night.
      float t = clamp(q.y / hz, 0.0, 1.0);
      float tone = mix(mix(0.7, 0.42, t), mix(0.34, 0.04, t), day);
      tone = mix(tone, max(tone, 0.5 - 0.2 * t), wet * 0.8);
      // Clouds are left as paper, shaded underneath and outlined.
      float cf = fbm(float2(q.x * 0.018 + seed, q.y * 0.045));
      float lim = 0.62 - 0.22 * cloud - 0.1 * wet;
      float inC = smoothstep(lim, lim + 0.03, cf) * step(q.y, hz * 0.85) * step(0.2, cloud + wet);
      // Shaded where the cloud thins going down: its underside.
      float ctone = mix(0.04, 0.42, clamp((cf - fbm(float2(q.x * 0.018 + seed, (q.y + 4.0) * 0.045))) * 8.0 + 0.2, 0.0, 1.0));
      ctone = mix(ctone * 0.6 + 0.18, ctone, day);
      tone = mix(tone, ctone, inC);
      float skyL = hatch(q + float2(0.0, 0.5 * sin(q.x * 0.04)), 1.5708, 2.2, tone, aa);

      // The sun crosses from sunrise to sunset with its rays ruled round it, the moon from sunset to sunrise in its phase.
      float dp = clamp((hour - rise) / max(sset - rise, 1.0), 0.0, 1.0);
      float np = clamp(mod(hour - sset + 24.0, 24.0) / max(24.0 - (sset - rise), 1.0), 0.0, 1.0);
      float pr = day > 0.5 ? dp : np;
      float2 c = float2(W * (0.12 + 0.5 * pr), hz - hz * 0.72 * sin(3.14159 * pr));
      float r = H * 0.085;
      float2 dv = q - c;
      float d = length(dv);
      float vis = 1.0 - 0.85 * max(wet, step(0.9, cloud));
      if (day > 0.5) {
        if (d < r * 2.4 && vis > 0.5) {
          // 30 rays, each a wedge narrowing outwards.
          float f = abs(fract(atan(dv.y, dv.x) * 4.7746) - 0.5);
          skyL = d < r * 1.3 ? 0.0 : max(skyL * smoothstep(r * 1.3, r * 2.4, d), cover(f * d, 0.4, aa) * smoothstep(r * 2.4, r * 1.4, d));
        }
        L = max(L, cover(abs(d - r), 0.45, aa) * vis);
      } else if (vis > 0.5) {
        if (d < r) {
          float2 mq = dv / r;
          float k = cos(6.2831853 * phase);
          float ry = sqrt(max(1.0 - mq.y * mq.y, 0.0));
          float lit = phase < 0.5 ? step(k * ry, mq.x) : step(mq.x, -k * ry);
          skyL = (1.0 - lit) * hatch(q, 0.7854, 1.8, 0.55, aa);
        }
        L = max(L, cover(abs(d - r), 0.4, aa));
        // A few stars: crosses left in the lines.
        float2 cell = floor(q / 13.0);
        float2 sc = (cell + 0.3 + 0.4 * float2(h2(cell + seed), h2(cell + 5.0))) * 13.0;
        if (h2(cell + 9.0) > 0.8 - 0.4 * (1.0 - cloud) && q.y < hz * 0.7 && inC < 0.5) {
          float2 e = abs(q - sc);
          if (min(e.x, e.y) < 0.4 && max(e.x, e.y) < 1.8) { skyL = 0.0; }
        }
      }
      L = max(L, skyL);

      // Far hills, hatched on the slant; fog thins them to nothing.
      float yh = hz - H * (0.05 + 0.13 * fbm(float2(q.x * 0.012 + seed * 0.7, 1.0)));
      if (q.y > yh && q.y < hz) {
        L = engrave(q, (0.42 + 0.2 * (q.y - yh) / max(hz - yh, 1.0)) * (1.0 - 0.75 * fog) * mix(1.25, 1.0, day), 0.52, aa);
        L = max(L, cover(abs(q.y - yh), 0.45, aa) * (1.0 - fog * 0.7));
      }

      // The town on the far bank: roofs, a spire and chimneys, the walls in upright lines, dark in their shadow; by
      // night the windows are lit.
      float x0 = W * 0.36;
      float bw = 11.0;
      float bi = floor((q.x - x0) / bw);
      float bx = fract((q.x - x0) / bw);
      if (q.x > x0 && q.x < W * 0.97) {
        float bh = H * (0.07 + 0.1 * h1(bi + seed * 1.3));
        float roof = H * 0.05 * h1(bi * 3.1 + 2.0) * (1.0 - abs(bx * 2.0 - 1.0));
        float top = hz - bh - roof;
        bool spire = mod(bi, 9.0) == 4.0;
        if (spire) { top = hz - bh - H * 0.26 * (1.0 - smoothstep(0.0, 0.5, abs(bx - 0.5))); }
        bool chim = !spire && h1(bi * 7.7 + seed) > 0.6 && abs(bx - 0.3) < 0.08;
        float topC = chim ? hz - bh - H * 0.04 : top;
        if (q.y > min(top, topC) && q.y < hz) {
          float shade = bx < 0.28 ? 0.78 : 0.3;
          float tn = mix(shade + 0.25, shade, day);
          L = engrave(q, tn, 0.0, aa);
          // Windows in rows.
          float2 wc = float2(floor(bx * 3.0), floor((hz - q.y) / 6.0));
          bool win = !spire && bx > 0.3 && fract(bx * 3.0) > 0.35 && fract(bx * 3.0) < 0.75 && fract((hz - q.y) / 6.0) > 0.35 && fract((hz - q.y) / 6.0) < 0.75 && q.y > top + 4.0 && hz - q.y > 2.0;
          if (win) { L = day > 0.5 ? 1.0 : (h2(wc + bi + seed) > 0.45 ? 0.0 : 1.0); }
          L = max(L, cover(abs(q.y - top), 0.45, aa));
          L = max(L, cover(abs(bx) * bw, 0.4, aa));
        }
      }

      // The river: level strokes broken into lengths, closer towards the far bank, the sun's or moon's light a broken
      // path down it, the town upside down in it.
      if (q.y >= hz) {
        float st = clamp((q.y - hz) / (H - hz), 0.0, 1.0);
        float sp = 1.5 + 2.3 * st;
        float row = (q.y - hz) / sp;
        float ri = floor(row);
        // Strokes of random lengths, swelling in the middle and tapering at the ends.
        float len = 10.0 + 28.0 * st;
        float sx = q.x / len + h1(ri + seed) * 7.0;
        float brk = step(0.22, h1(floor(sx) * 1.3 + ri * 7.7 + seed)) * (0.35 + 0.65 * sin(3.14159 * fract(sx)));
        float wt = mix(mix(0.5, 0.32, day), mix(0.36, 0.2, day), st);
        float path = exp(-pow((q.x - c.x) / (r * (0.9 + 1.5 * st)), 2.0)) * vis;
        wt *= 1.0 - 0.85 * path;
        float my = hz - (q.y - hz) * 1.2;
        if (q.x > x0 && q.x < W * 0.97 && my > hz - H * 0.15 * (0.5 + h1(bi + seed * 1.3))) { wt = max(wt, 0.7 * (1.0 - st)); }
        L = cover(abs(fract(row) - 0.5), wt * 0.5 * brk, aa / sp);
        L = max(L, cover(abs(q.y - hz), 0.5, aa));
      }

      // Rain in ruled slants, snow as flakes left white.
      if (rain > 0.5) {
        float lane = (q.x - q.y * 0.35) / 4.0;
        float li = floor(lane);
        if (abs(fract(lane) - 0.5) < 0.09 && fract(q.y / (14.0 + 10.0 * h1(li)) + h1(li * 1.7 + seed)) < 0.5) { L = 1.0; }
      }
      if (snow > 0.5) {
        float2 cell = floor(q / 9.0);
        float2 fc = (cell + 0.2 + 0.6 * float2(h2(cell), h2(cell + 7.0))) * 9.0;
        if (length(q - fc) < 1.1 + 0.6 * h2(cell + 3.0)) { L = 0.0; }
      }

      float3 P = float3(paper.rgb);
      float3 K = float3(ink.rgb);
      float3 col = mix(P, K, clamp(L, 0.0, 1.0) * (0.9 + 0.1 * h2(floor(q * 1.7))));
      return half4(half3(col), 1.0);
    }
  """

  component Rule(weight = 0.75) {
    Box { height: weight; fill: width; background: ink }
  }

  // A thick rule over a thin one, as under a masthead.
  component DoubleRule() {
    Column {
      gap: 2
      fill: width
      Box { height: 2.5; fill: width; background: ink }
      Box { height: 0.75; fill: width; background: ink }
    }
  }

  component VRule() {
    Box { width: 0.75; fill: height; background: ink }
  }

  component Head(text) {
    Column {
      gap: 3
      fill: width
      Rule {}
      Text { text: upper(text); font: bold; fontSize: 10; letterSpacing: 1.6; color: ink; align: center; maxLines: 1 }
      Rule {}
    }
  }

  // The woodcut: a cut block, heavy black with white gouges, under the weather in words.
  component Woodcut() {
    Column {
      gap: 0
      padding: 2
      border: 1.5
      borderColor: ink
      onTap: url("https://wttr.in/")
      Column {
        gap: 1
        padding: [6, 4]
        border: 0.75
        borderColor: ink
        align: center
        Canvas {
          width: 64
          height: 30
          let cx = 32
          let cy = 15
          if glyph == "sun" {
            for i in range(12) {
              rotate(i * 30, cx, cy) { path([[cx - 2.6, cy - 9], [cx, cy - 15], [cx + 2.6, cy - 9]], closed: true, fill: ink) }
            }
            circle(cx, cy, 8, fill: ink)
            circle(cx, cy, 5, stroke: paper, width: 1)
            circle(cx, cy, 2, fill: paper)
          } else if glyph == "moon" {
            circle(cx, cy, 11, fill: ink)
            circle(cx + 6, cy - 3, 10, fill: paper)
            for s in [[10, 6], [52, 9], [58, 23], [6, 24]] { line(s[0] - 2.5, s[1], s[0] + 2.5, s[1], stroke: ink, width: 1.2); line(s[0], s[1] - 2.5, s[0], s[1] + 2.5, stroke: ink, width: 1.2) }
          } else {
            if glyph == "part" {
              for i in range(7) {
                rotate(i * 30 - 90, cx + 9, cy - 3) { path([[cx + 7, cy - 11], [cx + 9, cy - 16], [cx + 11, cy - 11]], closed: true, fill: ink) }
              }
              circle(cx + 9, cy - 3, 7, fill: ink)
            }
            if glyph != "fog" {
              let cy2 = glyph == "rain" || glyph == "snow" ? cy - 4 : cy + 1
              // The cloud: four puffs on a flat foot, with a white gouge along each.
              circle(cx - 10, cy2 + 2, 7, fill: ink)
              circle(cx - 2, cy2 - 3, 9, fill: ink)
              circle(cx + 9, cy2, 7.5, fill: ink)
              rect(cx - 17, cy2 + 2, 33, 7, fill: ink)
              arc(cx - 2, cy2 - 3, 6, 290, 80, stroke: paper, width: 1.1)
              arc(cx + 9, cy2, 4.5, 330, 70, stroke: paper, width: 1)
              line(cx - 13, cy2 + 6, cx + 12, cy2 + 6, stroke: paper, width: 0.9)
              if glyph == "rain" {
                for i in range(6) { line(cx - 14 + i * 5.6, cy2 + 12, cx - 17 + i * 5.6, cy2 + 19, stroke: ink, width: 1.6, cap: round) }
              }
              if glyph == "snow" {
                for i in range(4) {
                  let fx = cx - 12 + i * 8
                  let fy = cy2 + 15 + (i % 2) * 3
                  line(fx - 2.5, fy, fx + 2.5, fy, stroke: ink, width: 1.1)
                  line(fx - 1.3, fy - 2.2, fx + 1.3, fy + 2.2, stroke: ink, width: 1.1)
                  line(fx + 1.3, fy - 2.2, fx - 1.3, fy + 2.2, stroke: ink, width: 1.1)
                }
              }
            } else {
              for i in range(4) { rect(4 + (i % 2) * 6, 4 + i * 6.5, 50, 3.2, fill: ink) }
            }
          }
        }
        Text { text: cur == null ? "…" : "${upper(sub(skyText, 0, 1))}${sub(skyText, 1, len(skyText))}, ${cur.temp_C}°"; font: bold; fontSize: 11; color: ink; align: center; maxLines: 2 }
        Text { text: wind ?? ""; font: italic; fontSize: 9; color: ink; align: center; maxLines: 1 }
      }
    }
  }

  // The right-hand ear: the edition, the hour and the price.
  component Ear() {
    Column {
      gap: 1
      padding: [4, 6]
      border: 0.75
      borderColor: ink
      align: center
      onTap: refresh()
      Text { text: upper(str.edition(edition)); font: bold; fontSize: 7.5; letterSpacing: 0.5; color: ink; align: center; maxLines: 1 }
      Text { text: fmtTime(now, "HH:mm"); font: bold; fontSize: 24; color: ink; align: center }
      Text { text: str.price; font: italic; fontSize: 10; color: ink; align: center; maxLines: 1 }
    }
  }

  component Masthead() {
    Column {
      gap: 4
      fill: width
      Row {
        fill: width
        align: center
        gap: 6
        Woodcut { width: 92 }
        Column {
          weight: 1
          gap: 2
          align: center
          Text { text: str.motto; font: italic; fontSize: 10.5; color: ink; align: center; maxLines: 2 }
          if wide { Text { text: str.title(title); font: str.blackletter ? fraktur : bold; fontSize: str.blackletter ? 40 : 34; color: ink; align: center; maxLines: 1 } }
          Text { text: str.est; font: roman; fontSize: 8; letterSpacing: 2; color: ink; align: center; maxLines: 1 }
        }
        Ear { width: 92 }
      }
      if !wide { Text { text: str.title(title); font: str.blackletter ? fraktur : bold; fontSize: str.blackletter ? min(46, CW / 8.2) : min(40, CW / 9.6); color: ink; align: center; maxLines: 1; fill: width } }
      DoubleRule {}
      Row {
        fill: width
        align: center
        Text { text: str.vol(join(rom, "")); font: bold; fontSize: 9; letterSpacing: 0.6; color: ink; maxLines: 1 }
        Text { text: upper(fmtTime(now, str.date)); font: bold; fontSize: 9; letterSpacing: 0.6; color: ink; align: center; weight: 1; maxLines: 1 }
        Text { text: str.no(fmtTime(now, "D")); font: bold; fontSize: 9; letterSpacing: 0.6; color: ink; maxLines: 1 }
      }
      Rule {}
    }
  }

  // The engraving, framed, with its caption.
  component Plate() {
    Column {
      gap: 3
      align: center
      Box {
        padding: 2
        border: 0.75
        borderColor: ink
        Shader {
          width: plateW - 4
          height: plateH
          fallback: paper
          uniforms: { paper: paper, ink: ink, dpw: plateW - 4, hour: h, rise: rise, sset: set, cloud: cloud, rain: max(rain, storm), snow: snow, fog: fog, phase: phase, seed: floor(now / 86400) % 53 }
          code: plate
        }
      }
      Text {
        text: str.view(h < 5 ? "BY NIGHT" : h < rise + 1 ? "AT DAWN" : h < 11 ? "THIS MORNING" : h < 14 ? "AT NOON" : h < set - 1 ? "THIS AFTERNOON" : h < set + 1 ? "AT DUSK" : "BY NIGHT")
        font: roman
        fontSize: 8.5
        color: ink
        align: center
        maxLines: 2
        width: plateW
      }
    }
  }

  // The lead: Hacker News' first story in a headline in decks, and the correspondent's account of it.
  component Lead() {
    Column {
      gap: 5
      fill: width
      onTap: url(lead.link)
      onLongPress: url("https://news.ycombinator.com/item?id=${lead.id}")
      Text { text: lead == null ? str.presses : upper(lead.title); font: bold; fontSize: wide ? 17 : 19; color: ink; align: center; maxLines: 3 }
      Text { text: lead == null ? str.firstEdition : str.heads(lead.host); font: italic; fontSize: wide ? 10.5 : 12; color: ink; align: center; maxLines: wide ? 2 : 1 }
      Box { width: 60; height: 0.75; background: ink }
      // Wide, the column is the plate's width, and the account gives way to it.
      if wide { Plate {} } else {
      Row {
        fill: width
        gap: 10
        align: top
        Plate {}
        Text {
          weight: 1
          spans: [
            {text: str.special, font: bold, letterSpacing: 0.4},
            lead == null ? str.quiet : str.account(lead.by, fmtNum(lead.pts), fmtNum(lead.com), lead.host)
          ]
          font: roman
          fontSize: 11
          color: ink
          maxLines: floor(plateH / 13)
        }
      }
      }
    }
  }

  component Story(s) {
    Column {
      gap: 2
      fill: width
      onTap: url(s.link)
      onLongPress: url("https://news.ycombinator.com/item?id=${s.id}")
      Text { text: upper(s.title); font: bold; fontSize: 11; color: ink; align: center; maxLines: 3 }
      Text { text: str.meta(s.host, fmtNum(s.pts), fmtNum(s.com)); font: italic; fontSize: 9; color: ink; align: center; maxLines: 1 }
      Box { width: 26; height: 0.75; background: ink; offset: [0, 3] }
    }
  }

  component Wire(w) {
    Column {
      gap: 1
      fill: width
      onTap: url(w.link ?? "https://www.bbc.co.uk/news/world")
      Text { text: upper(w.title); font: bold; fontSize: 10.5; color: ink; align: center; maxLines: 3 }
      Text {
        spans: [{text: str.dateline(w.time), font: bold, fontSize: 8.5, letterSpacing: 0.4}, w.text ?? ""]
        font: roman
        fontSize: 10
        color: ink
        maxLines: 3
      }
    }
  }

  component HNColumn(list, head) {
    Column {
      gap: 9
      clip: true
      Head { text: head }
      if len(list) == 0 { Text { text: str.hnLate; font: italic; fontSize: 10.5; color: ink; align: center } }
      for s in list key s.id { Story { s: s } }
    }
  }

  component WireColumn() {
    Column {
      gap: 9
      clip: true
      Head { text: str.telegraph }
      if len(wires) == 0 { Text { text: str.cableSilent; font: italic; fontSize: 10.5; color: ink; align: center } }
      for w in wires.take(wide ? 6 : max(2, nStories - 2)) { Wire { w: w } }
      if len(notices) > 0 {
        Head { text: str.notices }
        for o in notices {
          Text {
            onTap: url(o.link ?? "https://archlinux.org/news/")
            spans: [{text: "ARCH LINUX", font: bold, fontSize: 8.5, letterSpacing: 0.4}, o.date == null ? ".—" : ", ${o.date}.—", o.title]
            font: roman
            fontSize: 10
            color: ink
            maxLines: 3
          }
        }
      }
    }
  }

  // The classified advertisements: each notification boxed, its app the heading.
  component Classifieds() {
    Column {
      gap: 6
      clip: true
      Head { text: str.ads }
      if !n.available {
        Column {
          gap: 1
          padding: 5
          border: 0.75
          borderColor: ink
          fill: width
          onTap: notification("open", "")
          Text { text: str.wanted; font: bold; fontSize: 10; letterSpacing: 1; color: ink; align: center }
          Text { text: str.wantedText; font: roman; fontSize: 10; color: ink; align: center }
        }
      } else if len(ads) == 0 {
        Text { text: str.noAds; font: italic; fontSize: 10.5; color: ink; align: center }
      } else {
        for a in ads key a.key {
          Column {
            gap: 0
            padding: [5, 3]
            border: 0.75
            borderColor: ink
            fill: width
            onTap: notification("open", a.key)
            onLongPress: { haptic(); notification("dismiss", a.key) }
            Text { text: upper(a.app ?? str.notice); font: bold; fontSize: 9; letterSpacing: 1.2; color: ink; align: center; maxLines: 1 }
            Text {
              spans: [{text: a.title ?? "", font: bold}, a.text == null || a.text == "" ? "" : "—${a.text}", {text: "  ${str.ago(a.time, now)}", font: italic}]
              font: roman
              fontSize: 10
              color: ink
              maxLines: 2
            }
          }
        }
        if n.count > len(ads) { Text { text: str.more(n.count - len(ads)); font: italic; fontSize: 9; color: ink; align: end; fill: width } }
      }
    }
  }

  // The stock exchange: the phone's fastfetch at the close, the movers marked up and down.
  component Exchange(rows = 9) {
    Column {
      gap: 2
      clip: true
      Head { text: str.exchange }
      Row {
        fill: width
        Text { text: str.stock; font: bold; fontSize: 8; letterSpacing: 0.8; color: ink; weight: 1 }
        Text { text: str.close; font: bold; fontSize: 8; letterSpacing: 0.8; color: ink }
        Text { text: str.chg; font: bold; fontSize: 8; letterSpacing: 0.8; color: ink; width: 34; align: end }
      }
      Rule { weight: 0.5 }
      for s in stocks.filter(x => x[1] != null).take(rows) {
        Row {
          fill: width
          align: bottom
          gap: 3
          Text { text: str.stockName(s[0]); font: roman; fontSize: 10; color: ink }
          // Leaders between the name and its price.
          Text { text: "....................................................."; font: roman; fontSize: 10; color: ink; weight: 1; maxLines: 1 }
          Text { text: s[1]; font: bold; fontSize: 10; color: ink; maxLines: 1 }
          Text {
            text: s[2] == null ? "" : abs(s[2]) < 0.5 ? str.unch : "${s[2] > 0 ? "▲" : "▼"}${round(abs(s[2]))}"
            font: roman
            fontSize: 9.5
            color: ink
            width: 34
            align: end
          }
        }
      }
    }
  }

  Column {
    fill: true
    gap: 8
    padding: [m, 6, m, 0]
    Masthead {}
    if wide {
      Row {
        weight: 1
        fill: width
        gap: 8
        align: top
        Column {
          width: plateW + 16
          fill: height
          gap: 8
          Lead {}
        }
        VRule {}
        HNColumn { list: stories.drop(1).take(nStories); head: "Hacker News"; weight: 1; fill: height }
        VRule {}
        HNColumn { list: stories.drop(1 + nStories).take(nStories); head: str.continued; weight: 1; fill: height }
        VRule {}
        WireColumn { weight: 1; fill: height }
        VRule {}
        Column {
          width: 160
          fill: height
          gap: 8
          Exchange { rows: H < 560 ? 4 : 9 }
          Classifieds { weight: 1 }
        }
      }
    } else {
      Lead {}
      DoubleRule {}
      Row {
        weight: 1
        fill: width
        gap: 8
        align: top
        HNColumn { list: stories.drop(1).take(nStories); head: str.fromHN; weight: 1; fill: height }
        VRule {}
        WireColumn { weight: 1; fill: height }
      }
      DoubleRule {}
      Row {
        fill: width
        height: 160
        gap: 8
        align: top
        Classifieds { weight: 1; fill: height }
        VRule {}
        Exchange { weight: 1; fill: height }
      }
    }
    Spacer { height: screenInset + 4 }
  }
}
