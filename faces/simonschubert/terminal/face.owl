face "terminal" {
  // A shell session over digital rain: each command's output is the phone's state, live.

  meta { owl: 19; description: "A hacker's terminal over digital rain: the date, uptime, battery, weather and notifications as command output, your apps as an ls, and a prompt that finds an app as you type"; version: "1.4"; license: "MIT"; category: "fun" }

  // The output in the phone's language where it has a set; the commands stay as typed in any shell. The date
  // keeps its pattern: the phone names the day and month. "up" is what uptime itself prints, kept where the script is Latin.
  strings {
    en {
      uptime: (up, used, total, free) => "up ${up} · mem ${used}/${total} · disk ${free} free"
      bat: "bat"; charging: "charging"; connecting: "connecting…"; denied: "tail: permission denied (tap to grant)"
      empty: "(empty)"; noMatch: "no app matches; enter asks the agent"; placeholder: "type an app name"; wake: "wake up, neo…"
    }
    id {
      uptime: (up, used, total, free) => "up ${up} · ram ${used}/${total} · disk ${free} sisa"
      bat: "bat"; charging: "mengisi"; connecting: "menghubungkan…"; denied: "tail: akses ditolak (ketuk untuk izinkan)"
      empty: "(kosong)"; noMatch: "tak ada yang cocok; enter tanya agen"; placeholder: "nama aplikasi"; wake: "bangun, neo…"
    }
    es {
      uptime: (up, used, total, free) => "up ${up} · mem ${used}/${total} · disco ${free} libre"
      bat: "bat"; charging: "cargando"; connecting: "conectando…"; denied: "tail: sin permiso (toca para conceder)"
      empty: "(vacío)"; noMatch: "nada coincide; enter pregunta al agente"; placeholder: "nombre de la app"; wake: "despierta, neo…"
    }
    pt {
      uptime: (up, used, total, free) => "up ${up} · mem ${used}/${total} · disco ${free} livre"
      bat: "bat"; charging: "carregando"; connecting: "conectando…"; denied: "tail: sem permissão (toque para permitir)"
      empty: "(vazio)"; noMatch: "nada encontrado; enter pergunta ao agente"; placeholder: "nome do app"; wake: "acorde, neo…"
    }
    de {
      uptime: (up, used, total, free) => "up ${up} · ram ${used}/${total} · speicher ${free} frei"
      bat: "akku"; charging: "lädt"; connecting: "verbinde…"; denied: "tail: kein zugriff (tippen zum erlauben)"
      empty: "(leer)"; noMatch: "keine app passt; enter fragt den agenten"; placeholder: "app-name tippen"; wake: "wach auf, neo…"
    }
    zh {
      uptime: (up, used, total, free) => "运行 ${up} · 内存 ${used}/${total} · 磁盘剩余 ${free}"
      bat: "电量"; charging: "充电中"; connecting: "连接中…"; denied: "tail: 无权限（轻触授权）"
      empty: "(空)"; noMatch: "没有匹配的应用；回车询问智能体"; placeholder: "输入应用名称"; wake: "醒醒，尼奥…"
    }
    ru {
      uptime: (up, used, total, free) => "up ${up} · озу ${used}/${total} · диск ${free} своб."
      bat: "бат"; charging: "зарядка"; connecting: "подключение…"; denied: "tail: нет доступа (нажмите, чтобы дать)"
      empty: "(пусто)"; noMatch: "совпадений нет; enter спросит агента"; placeholder: "имя приложения"; wake: "проснись, нео…"
    }
    ja {
      uptime: (up, used, total, free) => "稼働 ${up} · メモリ ${used}/${total} · 空き容量 ${free}"
      bat: "電池"; charging: "充電中"; connecting: "接続中…"; denied: "tail: 権限がありません（タップで許可）"
      empty: "(空)"; noMatch: "一致するアプリなし。enter でエージェントに質問"; placeholder: "アプリ名を入力"; wake: "起きろ、ネオ…"
    }
    uk {
      uptime: (up, used, total, free) => "up ${up} · озп ${used}/${total} · диск ${free} вільно"
      bat: "бат"; charging: "заряджання"; connecting: "підключення…"; denied: "tail: немає доступу (торкніться, щоб дати)"
      empty: "(порожньо)"; noMatch: "збігів немає; enter запитає агента"; placeholder: "назва застосунку"; wake: "прокинься, нео…"
    }
    fr {
      uptime: (up, used, total, free) => "up ${up} · mém ${used}/${total} · disque ${free} libre"
      bat: "bat"; charging: "en charge"; connecting: "connexion…"; denied: "tail: accès refusé (touche pour autoriser)"
      empty: "(vide)"; noMatch: "aucune appli ; enter demande à l’agent"; placeholder: "nom de l’appli"; wake: "réveille-toi, neo…"
    }
  }
  // The rain steps a whole row at a time, at most 14 rows a second: 20 frames a second show every step.
  fps: modes.saver ? 10 : 20
  source modes = android.modes

  statusBar: false

  source now = clock every 1s
  source dev = android.device
  source sys = android.system every 1m
  source bat = android.battery
  source n = android.notifications
  source apps = android.apps
  source wx = http("https://wttr.in/?format=j1") every 30m timeout 10s json

  let mono = "https://raw.githubusercontent.com/google/fonts/main/ofl/jetbrainsmono/JetBrainsMono%5Bwght%5D.ttf"
  let host = lower(replace(trim(dev.model ?? "phone"), " ", "-"))
  let cur = wx.current_condition[0]
  let place = lower(wx.nearest_area[0].areaName[0].value ?? "")
  let level = bat.level ?? 0
  let bars = round(level / 10)
  state q = ""
  // A work profile or a clone has the same name: ls shows each name once.
  let all = values(groupBy((apps ?? []).sortBy(a => -a.score), a => a.name)).map(g => g[0])
  let top = all.filter(a => !a.system || a.score > 0).take(12)
  // What's typed at the prompt greps the apps: names that start with it first, then names that hold it.
  let needle = lower(trim(q))
  let found = needle == "" ? top : flatten([
    all.filter(a => startsWith(lower(a.name), needle)),
    all.filter(a => !startsWith(lower(a.name), needle) && contains(lower(a.name), needle))
  ]).take(12)
  let glyphs = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789Z:.=*+-<>"
  let ink = mix(green, foreground, 0.15)
  let rainRows = floor((tileHeight ?? 900) / 18) + 1
  let drops = range(floor((tileWidth ?? 412) / 20) + 1).filter(c => hash(c, 5) < 0.85).map(c => {
    c: c,
    speed: 5 + hash(c, 1) * 9,
    tail: 6 + floor(hash(c, 2) * 10),
    period: rainRows + 16 + floor(hash(c, 3) * rainRows * 0.4),
    start: hash(c, 4) * rainRows * 2,
    flicker: 1 + hash(c, 6) * 3
  })

  background: alpha(mix(background, #000000, 0.75), 0.97)
  padding: 0

  component Prompt(cmd) {
    Text { spans: [{text: "neo@${host}", color: green, bold: true}, ":", {text: "~", color: blue, bold: true}, "$ ", {text: cmd, color: foreground}]; font: mono; fontSize: 13; maxLines: 1 }
  }

  component Out(line, tint = muted) {
    Text { text: line; font: mono; fontSize: 13; color: tint; maxLines: 1 }
  }

  Box {
    fill: true

    // Digital rain: a drop in most columns, each falling at its own speed with its
    // glyphs flickering. What a drop is doesn't change with time, so it's worked out once, not every frame.
    Canvas {
      fill: true
      layer(0.6) {
        for d in drops {
          let head = floor((time * d.speed + d.start) % d.period)
          for k in range(d.tail) {
            let r = head - k
            if r >= 0 && r < rainRows {
              let g = floor(hash(d.c, r) * 997 + time * d.flicker) % len(glyphs)
              text(sub(glyphs, g, g + 1), d.c * 20 + 10, r * 18 + 9, size: 13, align: center, font: mono, color: k == 0 ? mix(foreground, green, 0.25) : alpha(green, 1 - k / d.tail))
            }
          }
        }
      }
    }

    Column {
      fill: true
      gap: 0
      padding: [14, 12]

      Spacer { height: 28 }
      Column {
        fill: width
        gap: 3
        padding: [14, 14]
        background: alpha(mix(background, #000000, 0.8), 0.82)
        border: 1
        borderColor: alpha(green, 0.45)
        radius: 6 * corners

        Out { line: "omalauncher ${sys.launcher ?? ""} (tty1) · android ${dev.android ?? "…"}"; tint: alpha(ink, 0.6) }
        Spacer { height: 8 }

        Prompt { cmd: "date" }
        Out { line: lower(fmtTime(now, "EEE d MMM yyyy  HH:mm:ss")); tint: ink }
        Spacer { height: 8 }

        Prompt { cmd: "uptime" }
        Out { line: str.uptime(fmtDuration(sys.uptime ?? 0), fmtBytes(sys.memory.used ?? 0), fmtBytes(sys.memory.total ?? 0), fmtBytes(sys.storage.free ?? 0)); tint: ink }
        Text {
          spans: [
            "${str.bat} [",
            {text: sub("##########", 0, bars), color: level < 20 ? red : green},
            {text: sub("··········", 0, 10 - bars), color: alpha(muted, 0.6)},
            "] ${level}%",
            {text: bat.charging ? "  ${str.charging}" : "", color: yellow}
          ]
          font: mono
          fontSize: 13
          color: ink
          maxLines: 1
        }
        Spacer { height: 8 }

        Prompt { cmd: "curl wttr.in" }
        if cur {
          Text { spans: [{text: "${cur.temp_C}°C ", color: yellow, bold: true}, lower(trim(cur.weatherDesc[0].value)), {text: place == "" ? "" : "  @ ${place}", color: muted}]; font: mono; fontSize: 13; color: ink; maxLines: 1 }
        } else {
          Out { line: str.connecting }
        }
        Spacer { height: 8 }

        Prompt { cmd: "tail -3 notify.log" }
        if !n.available {
          Text { text: str.denied; font: mono; fontSize: 13; color: red; maxLines: 1; onTap: notification("open", "") }
        } else if n.count == 0 {
          Out { line: str.empty }
        } else {
          for item in n.items.take(3) key item.key {
            Text {
              spans: [{text: "[${fmtTime(item.time, "HH:mm")}] ", color: muted}, {text: "${lower(item.app ?? "")} ", color: cyan}, item.title]
              font: mono
              fontSize: 13
              color: ink
              maxLines: 1
              onTap: notification("open", item.key)
              onLongPress: { haptic(); notification("dismiss", item.key) }
            }
          }
        }
        Spacer { height: 8 }

        Prompt { cmd: needle == "" ? "ls ~/apps" : "ls ~/apps | grep ${needle}" }
        // Coloured as ls colours directories; while grepping, the first match is what Enter opens.
        Flow {
          gap: 12
          for a, i in found key a.key {
            Text {
              text: lower(replace(trim(a.name), " ", "-"))
              font: mono
              fontSize: 13
              color: needle != "" && i == 0 ? background : blue
              background: needle != "" && i == 0 ? green : alpha(green, 0)
              bold: true
              maxLines: 1
              onTap: { q = ""; androidApp(a.key) }
            }
          }
        }
        if needle != "" && len(found) == 0 {
          Out { line: str.noMatch }
        }
        Spacer { height: 8 }

        // A real prompt: type to grep the apps, Enter opens the first match or asks the agent.
        Row {
          gap: 0
          align: center
          Prompt { cmd: "" }
          Input {
            weight: 1
            text: q
            placeholder: str.placeholder
            color: foreground
            fontSize: 13
            underline: false
            clear: true
            onChange: q = value
            onSubmit: {
              if len(found) > 0 && needle != "" {
                androidApp(found[0].key)
              } else if trim(value) != "" {
                ask(value)
              }
              q = ""
            }
          }
        }
      }

      Spacer { weight: 1 }
      Text { text: str.wake; font: mono; fontSize: 11; color: alpha(green, 0.55); align: center; fill: width; padding: [0, 10] }
      Spacer { height: screenInset }
    }
  }
}
