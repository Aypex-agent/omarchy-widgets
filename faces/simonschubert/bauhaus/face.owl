face "bauhaus" {
  // A Bauhaus poster for the Linux side and its coding agents, on a grid of squares in red, blue and yellow: Arch's
  // packages and its updates, a fastfetch, Claude Code's running sessions and its limits, the latest Grok sessions,
  // Grok's weekly pool and Grok Bot's. The squares left over are the poster's own, a new pattern every day or at a tap.
  // Lowercase, as the Bauhaus wrote after 1925, in Jost, a Futura of Google Fonts. Its commands use base tools only,
  // so it runs on any Linux install, and logins are read from the agents' own files and only sent to their own servers.

  meta {
    owl: 14
    description: "A Bauhaus poster in three pages: Linux, Claude Code and Grok sessions and limits; notifications, music and apps; the phone's battery, storage, network and switches"
    version: "1.0"
    license: "MIT"
    category: "dev"
  }

  source now = clock every 1m
  source drawer = android.drawer
  source ag = android.agents

  // Arch: the release, kernel, packages and the last full upgrade (from pacman's log).
  source lx = cmd("""
    . /etc/os-release
    printf '{"os":"%s","kernel":"%s","pkgs":%s,"explicit":%s,"shell":"%s","upgraded":"%s"}\n' \
      "$PRETTY_NAME" "$(uname -r)" "$(pacman -Qq | wc -l)" "$(pacman -Qqe | wc -l)" "$(basename "${SHELL:-bash}")" \
      "$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -1 | cut -c2-25)"
  """) every 30m json optional

  // Claude Code's running sessions: each registers itself in ~/.claude/sessions/<pid>.json (name, folder, busy or idle)
  // while its process lives.
  source cs = cmd("""
    sep=""
    printf '['
    for f in ~/.claude/sessions/*.json; do
      [ -e "$f" ] || continue
      p=${f##*/}; p=${p%.json}
      case $p in ''|*[!0-9]*) continue ;; esac
      [ -d /proc/$p ] || continue
      printf '%s' "$sep"; tr -d '\n' < "$f"; sep=,
    done
    printf ']\n'
  """) every 10s json optional

  // Claude Code's limits, as /usage shows them, with the login Claude Code keeps; the last good answer is kept, so a
  // failed fetch shows it rather than nothing.
  source cl = cmd("""
    c=~/.cache/bauhaus-claude-usage.json
    mkdir -p ~/.cache
    t=$(tr -d '\n' 2>/dev/null < ~/.claude/.credentials.json | grep -o '"accessToken" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$t" ] || { echo '{"error":"no login"}'; exit 0; }
    code=$(printf 'Authorization: Bearer %s\n' "$t" | curl -s -m 15 -o "$c.new" -w '%{http_code}' -H @- -H 'anthropic-beta: oauth-2025-04-20' https://api.anthropic.com/api/oauth/usage)
    [ "$code" = 200 ] && mv "$c.new" "$c"
    rm -f "$c.new"
    cat "$c" 2>/dev/null || echo '{"error":"offline"}'
  """) every 10m json timeout 30s optional

  // The latest four Grok sessions: their summary (title, folder, model, last active) and signals (how full the context is).
  source gs = cmd("""
    sep=""
    printf '['
    for f in $(ls -t ~/.grok/sessions/*/*/summary.json 2>/dev/null | head -4); do
      g=${f%summary.json}signals.json
      printf '%s{"sum":' "$sep"; tr -d '\n' < "$f"
      printf ',"sig":'; if [ -f "$g" ]; then tr -d '\n' < "$g"; else printf null; fi
      printf '}'; sep=,
    done
    printf ']\n'
  """) every 30s json optional

  // Grok's plan and its weekly pool, with the login Grok keeps.
  source ga = cmd("""
    a=$(tr -d '\n' 2>/dev/null < ~/.grok/auth.json)
    t=$(printf '%s' "$a" | grep -o '"key" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    u=$(printf '%s' "$a" | grep -o '"user_id" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$t" ] || { echo '{"error":"no login"}'; exit 0; }
    b=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$t" "$u" | curl -s -m 15 -A 'omarchy-widgets/bauhaus' -H @- -H 'Accept: application/json' 'https://cli-chat-proxy.grok.com/v1/billing?format=credits')
    p=$(printf 'Authorization: Bearer %s\nx-userid: %s\n' "$t" "$u" | curl -s -m 15 -A 'omarchy-widgets/bauhaus' -H @- -H 'Accept: application/json' 'https://cli-chat-proxy.grok.com/v1/user?include=subscription' | grep -o '"subscriptionTier" *: *"[^"]*"' | head -1)
    case $b in '{'*) ;; *) b=null ;; esac
    printf '{"billing":%s,%s}\n' "$b" "${p:-"\"subscriptionTier\":null"}"
  """) every 15m json timeout 40s optional

  // Grok Bot's weekly usage, metered on the Cursor login rather than Grok's.
  source gb = cmd("""
    t=$(tr -d '\n' 2>/dev/null < ~/.config/cursor/auth.json | grep -o '"accessToken" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$t" ] || { echo '{"error":"no login"}'; exit 0; }
    r=$(printf 'Authorization: Bearer %s\n' "$t" | curl -s -m 15 -X POST -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}' \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetSandUsageStatus')
    case $r in '{'*) printf '%s\n' "$r" ;; *) echo '{"error":"offline"}' ;; esac
  """) every 15m json timeout 30s optional

  let rowsA = 3
  let rowsB = 3
  let pageNo = "nº 1"
  let pageWhat = "linux · agents"
  let salt = 1

  // The poster is printed in its own colours whatever the theme, so the status bar steps aside.
  statusBar: false
  edge: true
  padding: 0
  background: #EEE6D3

  // Tapping the poster's own squares lays out a new pattern; it also changes with the day.
  state seed = 1923 persist

  let jost = "https://raw.githubusercontent.com/google/fonts/main/ofl/jost/Jost%5Bwght%5D.ttf"
  let paper = #EEE6D3
  let ink = #1E1D1B
  let bRed = #D63A27
  let bBlue = #22509C
  let bYellow = #F2B02A
  let bOrange = #E5732C
  let bPink = #E9A196
  let pal = [paper, bRed, bBlue, bYellow, ink, bOrange, bPink]
  let kinds = ["qtl", "qbr", "qbl", "qtr", "dome", "bowl", "circle", "tri", "bow", "stripes", "target", "eyes", "dots", "steps", "split"]

  // The grid: square cells c dp across, four columns, two blocks of four side by side when the screen is wide. The page's
  // squares take rowsA rows in the first block and rowsB in the second; the rows left over are the poster's own.
  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  let m = 16
  let headH = 52
  let footH = 26
  let availW = W - 2 * m - screenLeft - screenRight
  let availH = H - screenTop - 8 - headH - footH - screenInset
  let c = floor(min(availW / (wide ? 8 : 4), availH / (wide ? max(rowsA, rowsB) : rowsA + rowsB)))
  let rowsFit = floor(availH / c)
  let day = floor(now / 86400)
  // A shape and three colours for each of the poster's own squares, never on the paper itself.
  let cells = range(48).map(i => {
    k: kinds[floor(hash(seed, day, salt, i, 0) * 15)],
    b: 1 + floor(hash(seed, day, salt, i, 1) * 6),
    f: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 2) * 6)) % 7,
    a: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 3) * 6)) % 7
  })

  // One square of the poster: a shape in fg on bg, with ac for a second one.
  component Tile(k, bg, fg, ac) {
    Canvas {
      rect(0, 0, width, height, fill: bg)
      if k == "qtl" { arc(0, 0, width, 90, 90, fill: fg) }
      if k == "qbr" { arc(width, height, width, 270, 90, fill: fg) }
      if k == "qbl" { arc(0, height, width, 0, 90, fill: fg) }
      if k == "qtr" { arc(width, 0, width, 180, 90, fill: fg) }
      if k == "dome" {
        arc(width / 2, height, width / 2, 270, 180, fill: fg)
        arc(width / 2, height, width / 5, 270, 180, fill: ac)
      }
      if k == "bowl" { arc(width / 2, 0, width / 2, 90, 180, fill: fg) }
      if k == "circle" {
        circle(width / 2, height / 2, width * 0.4, fill: fg)
        circle(width / 2, height / 2, width * 0.14, fill: ac)
      }
      if k == "tri" { path([[0, height], [width, 0], [width, height]], closed: true, fill: fg) }
      if k == "bow" {
        path([[0, 0], [width, 0], [width / 2, height / 2]], closed: true, fill: fg)
        path([[0, height], [width, height], [width / 2, height / 2]], closed: true, fill: ac)
      }
      if k == "stripes" {
        for i in range(4) { rect(width * (i * 2 + 1) / 8, 0, width / 8, height, fill: fg) }
      }
      if k == "target" {
        circle(width / 2, height / 2, width * 0.44, fill: fg)
        circle(width / 2, height / 2, width * 0.32, fill: bg)
        circle(width / 2, height / 2, width * 0.2, fill: fg)
        circle(width / 2, height / 2, width * 0.08, fill: ac)
      }
      if k == "eyes" {
        arc(0, height / 2, height / 2, 0, 180, fill: fg)
        arc(width, height / 2, height / 2, 180, 180, fill: ac)
      }
      if k == "dots" {
        for i in range(9) { circle(width * (i % 3 + 0.5) / 3, height * (floor(i / 3) + 0.5) / 3, width * 0.11, fill: fg) }
      }
      if k == "steps" {
        rect(0, height * 2 / 3, width, height / 3, fill: fg)
        rect(width / 3, height / 3, width * 2 / 3, height / 3, fill: fg)
        rect(width * 2 / 3, 0, width / 3, height / 3, fill: fg)
      }
      if k == "split" {
        rect(0, 0, width / 2, height, fill: fg)
        arc(width / 2, height / 2, width * 0.36, 180, 180, fill: ac)
        arc(width / 2, height / 2, width * 0.36, 0, 180, fill: fg)
      }
    }
  }

  // n rows of the poster's own squares, from the cell list at off.
  component Filler(n, off) {
    Column {
      gap: 0
      onTap: seed = random(1000000)
      ripple: false
      for r in range(n) {
        Row {
          gap: 0
          for col in range(4) {
            Tile { k: cells[off + r * 4 + col].k; bg: pal[cells[off + r * 4 + col].b]; fg: pal[cells[off + r * 4 + col].f]; ac: pal[cells[off + r * 4 + col].a]; size: c }
          }
        }
      }
    }
  }

  component Label(t, tint = ink) {
    Text { text: t; font: jost; fontSize: 12; fontWeight: 500; letterSpacing: 1; color: tint; maxLines: 1 }
  }

  // The hour in a bBlue circle, the minutes in a bRed square.
  component Header(no, what) {
    Row {
      align: bottom
      height: headH
      width: c * (wide ? 8 : 4)
      padding: [0, 0, 0, 8]
      Text { text: "bauhaus"; font: jost; fontSize: 30; fontWeight: 600; letterSpacing: 4; color: ink; weight: 1; maxLines: 1 }
      Column {
        gap: 0
        Text { text: no; font: jost; fontSize: 11; fontWeight: 600; letterSpacing: 2; color: bRed; align: end }
        Text { text: what; font: jost; fontSize: 11; fontWeight: 500; letterSpacing: 2; color: ink; align: end }
      }
    }
  }
  let agents = ag.installed ?? []
  let claudeAg = agents.find(a => a.bin == "claude")
  let grokAg = agents.find(a => a.bin == "grok")
  let updates = num(drawer.updates, 0)
  let upgraded = parseTime(lx.upgraded ?? "")

  // Claude Code: the busy sessions first, then the limits for five hours and for the week.
  let sess = (cs ?? []).sortBy(s => s.status == "idle" ? 1 : 0)
  let busy = len(sess.filter(s => s.status != "idle"))
  let lims = cl.limits ?? []
  let five = lims.find(l => l.kind == "session")
  let week = lims.find(l => l.kind == "weekly_all")

  // Grok: the latest sessions, the plan and the weekly pool, and Grok Bot's week.
  let grok = (gs ?? []).map(x => {
    id: x.sum.info.id,
    cwd: x.sum.info.cwd,
    title: x.sum.session_summary ?? x.sum.generated_title ?? "grok",
    model: x.sum.current_model_id,
    last: parseTime(x.sum.last_active_at ?? x.sum.updated_at ?? ""),
    ctx: x.sig.contextWindowUsage
  })
  let bill = ga.billing.config
  // Why a number is missing: not signed in on the Linux side, or the server said no.
  let gErr = !linux ? "no linux" : ga == null ? null : ga.error ?? (bill == null ? "no login" : null)
  let botErr = !linux ? "no linux" : gb == null ? null : gb.error ?? (gb.code == "unauthenticated" ? "no login" : gb.usagePercent == null ? "not on plan" : null)
  let clErr = !linux ? "no linux" : cl == null ? null : cl.error ?? (cl.limits == null ? "offline" : null)
  let gPct = bill == null ? null : bill.creditUsagePercent ?? 0
  let gReset = parseTime(str(bill.currentPeriod.end ?? bill.billingPeriodEnd ?? ""))
  let tier = ga.subscriptionTier
  let tierName = tier == null ? "grok" : get({SuperGrokHeavy: "heavy", supergrok_heavy: "heavy", SuperGrokPlus: "supergrok+", supergrok_plus: "supergrok+", SuperGrok: "supergrok", supergrok: "supergrok", SuperGrokLite: "lite", supergrok_lite: "lite", XPremiumPlus: "premium+", x_premium_plus: "premium+", XPremium: "premium", x_premium: "premium", XBasic: "basic", x_basic: "basic", Free: "free", free: "free"}, tier, lower(tier))
  let botPct = gb.usagePercent
  let botReset = parseTime(gb.nextResetTimestampUtc ?? "")

  // One list of strips: Claude's running sessions, then Grok's latest, four in all.
  let strips = (sess.map(s => {
    kind: "claude",
    title: s.name ?? "claude",
    cwd: s.cwd ?? "",
    note: s.status == "idle" ? "idle" : "${s.status} ${fmtDuration(max(0, now - num(s.statusUpdatedAt, 0) / 1000))}",
    hot: s.status != "idle",
    id: s.sessionId
  }) + grok.map(g => {
    kind: "grok",
    title: g.title,
    cwd: g.cwd ?? "",
    note: g.last == null ? "" : now - g.last < 180 ? "active" : fmtAgo(g.last, now),
    hot: g.last != null && now - g.last < 180,
    id: g.id,
    model: g.model,
    ctx: g.ctx
  })).take(4)

  // A number over a label, with how full it is as a column at the right.
  component Meter(label, value, sub, frac, bg, tint, txt, onBar = bYellow) {
    Box {
      size: c
      Canvas {
        let f = clamp(num(frac, 0), 0, 1)
        rect(0, 0, width, height, fill: bg)
        rect(width * 0.8, 0, width * 0.2, height, fill: alpha(txt, 0.12))
        rect(width * 0.8, height * (1 - f), width * 0.2, height * f, fill: f >= 0.9 ? (bg == bRed ? ink : bRed) : tint)
      }
      Column {
        gap: 0
        padding: 8
        width: c * 0.8
        Text { text: value; font: jost; fontSize: c * 0.22; fontWeight: 600; color: txt; maxLines: 1 }
        Text { text: label; font: jost; fontSize: 12; fontWeight: 500; letterSpacing: 0.5; color: txt; maxLines: 1 }
        Spacer { weight: 1 }
        Text { text: sub; font: jost; fontSize: 11; fontWeight: 500; color: alpha(txt, 0.7); maxLines: 1 }
      }
    }
  }

  // A square that starts an agent: a triangle to play.
  component Start(name, bg, fg) {
    Box {
      size: c
      Canvas {
        rect(0, 0, width, height, fill: bg)
        path([[width * 0.58, height * 0.6], [width * 0.58, height * 0.9], [width * 0.86, height * 0.75]], closed: true, fill: fg)
      }
      Column {
        gap: 0
        padding: 8
        Text { text: "new"; font: jost; fontSize: c * 0.22; fontWeight: 600; color: fg }
        Label { t: name; tint: fg }
      }
    }
  }

  // Arch: the packages in a blue square under its A, and a fastfetch beside it.
  component Arch() {
    Row {
      gap: 0
      Box {
        size: 2 * c
        onTap: terminal("bash -l", "arch")
        Canvas {
          let s = width
          rect(0, 0, s, s, fill: bBlue)
          path([[0.5, 0], [1, 1], [0.7, 0.84], [0.62, 0.62], [0.5, 0.56], [0.38, 0.62], [0.3, 0.84], [0, 1]].map(p => [s * (0.48 + p[0] * 0.48), s * (0.42 + p[1] * 0.5)]), closed: true, fill: paper)
        }
        Column {
          gap: 0
          padding: 10
          Label { t: linux ? lower(lx.os ?? "arch linux") : "arch linux"; tint: paper }
          Text { text: !linux ? "—" : lx == null ? "…" : str(lx.pkgs); font: jost; fontSize: c * 0.5; fontWeight: 600; color: paper; maxLines: 1 }
          Label { t: !linux ? "not installed" : "packages"; tint: paper }
          Label { t: !linux || lx == null ? "" : "${lx.explicit} explicit"; tint: alpha(paper, 0.7) }
        }
      }
      Box {
        size: 2 * c
        Canvas { rect(0, 0, width, height, fill: paper) }
        if !linux {
          Column {
            gap: 8
            padding: 12
            onTap: launcher("linux")
            Text { text: "install linux to see arch, claude code and grok here"; font: jost; fontSize: 15; color: ink; maxLines: 4 }
            Spacer { weight: 1 }
            Text { text: "install"; font: jost; fontSize: 14; fontWeight: 600; color: paper; background: bRed; padding: [12, 8] }
          }
        } else {
          Column {
            gap: 3
            padding: 10
            fill: true
            for r in [["kernel", first(split(lx.kernel ?? "…", "-"))], ["shell", lx.shell ?? "…"], ["upgraded", upgraded == null ? "never" : fmtAgo(upgraded, now) + " ago"], ["agents", len(agents) == 0 ? "none" : agents.map(a => a.bin).join(" ")]] {
              Row {
                gap: 6
                Text { text: r[0]; font: jost; fontSize: 12; fontWeight: 600; color: bRed; width: 58; maxLines: 1 }
                Text { text: r[1]; font: jost; fontSize: 12; color: ink; weight: 1; maxLines: 1 }
              }
            }
            Spacer { weight: 1 }
            Box {
              fill: width
              padding: [10, 8]
              background: updates > 0 ? bYellow : alpha(ink, 0.08)
              onTap: if updates > 0 { terminal("pacman -Syu", "update") }
              Text { text: updates > 0 ? "${updates} ${updates == 1 ? "update" : "updates"} · upgrade" : "up to date"; font: jost; fontSize: 13; fontWeight: 600; color: ink; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  // Claude Code: its running sessions, its two limits and a new session.
  component ClaudeRow() {
    Row {
      gap: 0
      Box {
        size: c
        onTap: launcher("agents")
        Canvas {
          rect(0, 0, width, height, fill: bOrange)
          circle(width * 0.76, height * 0.76, width * 0.17, fill: busy > 0 ? paper : alpha(paper, 0.35))
        }
        Column {
          gap: 0
          padding: 8
          Text { text: linux ? str(len(sess)) : "—"; font: jost; fontSize: c * 0.22; fontWeight: 600; color: ink }
          Label { t: "claude code" }
          Spacer { weight: 1 }
          Text { text: busy > 0 ? "${busy} busy" : "none busy"; font: jost; fontSize: 11; fontWeight: 500; color: alpha(ink, 0.7) }
        }
      }
      Meter {
        label: "5 hours"
        value: five == null ? "—" : "${round(five.percent)}%"
        sub: five == null ? (clErr ?? "") : five.resets_at == null ? "" : "in ${fmtDuration(max(0, parseTime(five.resets_at) - now))}"
        frac: five == null ? 0 : five.percent / 100
        bg: paper; tint: bOrange; txt: ink
      }
      Meter {
        label: "week"
        value: week == null ? "—" : "${round(week.percent)}%"
        sub: week == null ? (clErr ?? "") : week.resets_at == null ? "" : lower(fmtTime(parseTime(week.resets_at), "EEE HH:mm"))
        frac: week == null ? 0 : week.percent / 100
        bg: ink; tint: bOrange; txt: paper
      }
      Box {
        onTap: if claudeAg != null { open(claudeAg.key) } else { launcher("agents") }
        Start { name: "claude"; bg: bYellow; fg: ink }
      }
    }
  }

  // Grok: the plan, the weekly pool, Grok Bot's week and a new session.
  component GrokRow() {
    Row {
      gap: 0
      Box {
        size: c
        onTap: url("https://grok.com")
        Canvas {
          rect(0, 0, width, height, fill: ink)
          path([[width * 0.62, height], [width * 0.86, height], [width, height * 0.72], [width, height * 0.42]], closed: true, fill: paper)
        }
        Column {
          gap: 0
          padding: 8
          width: c * 0.9
          Text { text: gErr != null ? "—" : tierName; font: jost; fontSize: c * 0.15; fontWeight: 600; color: paper; maxLines: 1 }
          Label { t: "grok plan"; tint: alpha(paper, 0.7) }
        }
      }
      Meter {
        label: "grok pool"
        value: gPct == null ? "—" : "${round(gPct)}%"
        sub: gErr != null ? gErr : gReset == null ? "" : lower(fmtTime(gReset, "EEE HH:mm"))
        frac: gPct == null ? 0 : gPct / 100
        bg: bYellow; tint: ink; txt: ink
      }
      Box {
        onTap: url("https://cursor.com/dashboard/usage")
        Meter {
          label: "grok bot"
          value: botPct == null ? "—" : "${round(botPct)}%"
          sub: botPct == null ? (botErr ?? "") : botReset == null ? "" : lower(fmtTime(botReset, "EEE HH:mm"))
          frac: botPct == null ? 0 : botPct / 100
          bg: bBlue; tint: bYellow; txt: paper
        }
      }
      Box {
        onTap: if grokAg != null { open(grokAg.key) } else { launcher("agents") }
        Start { name: "grok"; bg: bRed; fg: paper }
      }
    }
  }

  // The running Claude Code sessions and the latest Grok ones as strips; a Grok one taps open where it left off.
  component Sessions() {
    Column {
      gap: 0
      width: 4 * c
      height: 2 * c
      if len(strips) == 0 {
        Box {
          width: 4 * c
          height: 2 * c
          onTap: launcher("agents")
          Canvas {
            rect(0, 0, width, height, fill: paper)
            arc(width - height * 0.55, height, height * 0.5, 270, 180, fill: bOrange)
            arc(width - height * 0.55, height, height * 0.22, 270, 180, fill: ink)
          }
          Column {
            gap: 0
            padding: 12
            Spacer { weight: 1 }
            Text { text: "quiet"; font: jost; fontSize: c * 0.32; fontWeight: 600; color: ink }
            Label { t: linux ? "no agent sessions yet" : "no linux yet" }
          }
        }
      } else {
        for s, i in strips key s.id {
          Row {
            gap: 0
            height: c / 2
            width: 4 * c
            background: i % 2 == 0 ? paper : #E4DAC3
            align: center
            onTap: if s.kind == "grok" { terminal("cd ${sh(s.cwd)} && grok -r ${sh(s.id)}", "grok") } else { launcher("agents") }
            Box {
              size: c / 2
              align: center
              background: s.kind == "claude" ? (s.hot ? bOrange : bPink) : (s.hot ? ink : bBlue)
              Text { text: s.kind == "claude" ? "c" : "g"; font: jost; fontSize: c * 0.26; fontWeight: 600; color: s.kind == "claude" ? ink : paper; align: center }
            }
            Column {
              gap: 0
              weight: 1
              padding: [10, 0]
              Text { text: lower(s.title); font: jost; fontSize: 14; fontWeight: 600; color: ink; maxLines: 1 }
              Text { text: [last(split(s.cwd, "/")), s.model, s.ctx == null ? null : "${round(s.ctx)}% context"].filter(x => x != null && x != "").join(" · "); font: jost; fontSize: 12; color: alpha(ink, 0.7); maxLines: 1 }
            }
            Text { text: s.note; font: jost; fontSize: 11; fontWeight: 600; color: s.hot ? bRed : alpha(ink, 0.6); padding: [0, 0, 10, 0]; maxLines: 1 }
          }
        }
        // The strips left over are small squares of the poster's own.
        for i in range(4 - len(strips)) {
          Row {
            gap: 0
            for j in range(8) {
              Tile { k: cells[(i * 8 + j + 16) % 48].k; bg: pal[cells[(i * 8 + j + 16) % 48].b]; fg: pal[cells[(i * 8 + j + 16) % 48].f]; ac: pal[cells[(i * 8 + j + 16) % 48].a]; size: c / 2 }
            }
          }
        }
      }
    }
  }

  component PartA() {
    Column {
      gap: 0
      Arch { }
      ClaudeRow { }
    }
  }

  component PartB() {
    Column {
      gap: 0
      Sessions { }
      GrokRow { }
    }
  }

  Column {
    fill: true
    gap: 0
    align: center
    padding: [m + screenLeft, screenTop + 8, m + screenRight, 0]
    Header { no: pageNo; what: pageWhat }
    Spacer { weight: 1 }
    if wide {
      Row {
        gap: 0
        Column {
          gap: 0
          PartA { }
          Filler { n: max(rowsFit - rowsA, 0); off: 0 }
        }
        Column {
          gap: 0
          PartB { }
          Filler { n: max(rowsFit - rowsB, 0); off: 24 }
        }
      }
    } else {
      Column {
        gap: 0
        PartA { }
        PartB { }
        Filler { n: max(rowsFit - rowsA - rowsB, 0); off: 0 }
      }
    }
    Spacer { weight: 1 }
    Box {
      height: footH
      align: center
      Text { text: "staatliches bauhaus"; font: jost; fontSize: 10; fontWeight: 500; letterSpacing: 3; color: alpha(ink, 0.6) }
    }
    Spacer { height: screenInset }
  }
}
