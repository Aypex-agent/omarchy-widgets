face "bauhaus phone" {
  // The bauhaus face's third page: the battery as a half sun, memory and storage, the network's speed and signal,
  // switches for Wi-Fi, Bluetooth, Do Not Disturb and the torch, the volume as a staircase and the phone itself.

  meta { owl: 14 }

  source now = clock every 1m
  source bat = android.battery
  source sys = android.system every 30s
  source dev = android.device
  source net = android.network every 3s
  source sim = android.sim
  source modes = android.modes
  source vol = android.volume

  let rowsA = 3
  let rowsB = 3
  let pageNo = "nº 3"
  let salt = 3
  let pageWhat = "phone"

  // The poster is printed in its own colours whatever the theme, so the status bar steps aside.
  statusBar: false
  edge: true
  padding: 0
  background: #EEE6D3

  // Tapping the poster's own squares lays out a new pattern; it also changes with the day.
  state seed = 1923 persist

  let jost = "https://raw.githubusercontent.com/google/fonts/main/ofl/jost/Jost%5Bwght%5D.ttf"
  let paper = #EEE6D3
  let ink = #1E1D1B
  let bRed = #D63A27
  let bBlue = #22509C
  let bYellow = #F2B02A
  let bOrange = #E5732C
  let bPink = #E9A196
  let pal = [paper, bRed, bBlue, bYellow, ink, bOrange, bPink]
  let kinds = ["qtl", "qbr", "qbl", "qtr", "dome", "bowl", "circle", "tri", "bow", "stripes", "target", "eyes", "dots", "steps", "split"]

  // The grid: square cells c dp across, four columns, two blocks of four side by side when the screen is wide. The page's
  // squares take rowsA rows in the first block and rowsB in the second; the rows left over are the poster's own.
  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  let m = 16
  let headH = 52
  let footH = 26
  let availW = W - 2 * m - screenLeft - screenRight
  let availH = H - screenTop - 8 - headH - footH - screenInset
  let c = floor(min(availW / (wide ? 8 : 4), availH / (wide ? max(rowsA, rowsB) : rowsA + rowsB)))
  let rowsFit = floor(availH / c)
  let day = floor(now / 86400)
  // A shape and three colours for each of the poster's own squares, never on the paper itself.
  let cells = range(48).map(i => {
    k: kinds[floor(hash(seed, day, salt, i, 0) * 15)],
    b: 1 + floor(hash(seed, day, salt, i, 1) * 6),
    f: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 2) * 6)) % 7,
    a: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 3) * 6)) % 7
  })

  // One square of the poster: a shape in fg on bg, with ac for a second one.
  component Tile(k, bg, fg, ac) {
    Canvas {
      rect(0, 0, width, height, fill: bg)
      if k == "qtl" { arc(0, 0, width, 90, 90, fill: fg) }
      if k == "qbr" { arc(width, height, width, 270, 90, fill: fg) }
      if k == "qbl" { arc(0, height, width, 0, 90, fill: fg) }
      if k == "qtr" { arc(width, 0, width, 180, 90, fill: fg) }
      if k == "dome" {
        arc(width / 2, height, width / 2, 270, 180, fill: fg)
        arc(width / 2, height, width / 5, 270, 180, fill: ac)
      }
      if k == "bowl" { arc(width / 2, 0, width / 2, 90, 180, fill: fg) }
      if k == "circle" {
        circle(width / 2, height / 2, width * 0.4, fill: fg)
        circle(width / 2, height / 2, width * 0.14, fill: ac)
      }
      if k == "tri" { path([[0, height], [width, 0], [width, height]], closed: true, fill: fg) }
      if k == "bow" {
        path([[0, 0], [width, 0], [width / 2, height / 2]], closed: true, fill: fg)
        path([[0, height], [width, height], [width / 2, height / 2]], closed: true, fill: ac)
      }
      if k == "stripes" {
        for i in range(4) { rect(width * (i * 2 + 1) / 8, 0, width / 8, height, fill: fg) }
      }
      if k == "target" {
        circle(width / 2, height / 2, width * 0.44, fill: fg)
        circle(width / 2, height / 2, width * 0.32, fill: bg)
        circle(width / 2, height / 2, width * 0.2, fill: fg)
        circle(width / 2, height / 2, width * 0.08, fill: ac)
      }
      if k == "eyes" {
        arc(0, height / 2, height / 2, 0, 180, fill: fg)
        arc(width, height / 2, height / 2, 180, 180, fill: ac)
      }
      if k == "dots" {
        for i in range(9) { circle(width * (i % 3 + 0.5) / 3, height * (floor(i / 3) + 0.5) / 3, width * 0.11, fill: fg) }
      }
      if k == "steps" {
        rect(0, height * 2 / 3, width, height / 3, fill: fg)
        rect(width / 3, height / 3, width * 2 / 3, height / 3, fill: fg)
        rect(width * 2 / 3, 0, width / 3, height / 3, fill: fg)
      }
      if k == "split" {
        rect(0, 0, width / 2, height, fill: fg)
        arc(width / 2, height / 2, width * 0.36, 180, 180, fill: ac)
        arc(width / 2, height / 2, width * 0.36, 0, 180, fill: fg)
      }
    }
  }

  // n rows of the poster's own squares, from the cell list at off.
  component Filler(n, off) {
    Column {
      gap: 0
      onTap: seed = random(1000000)
      ripple: false
      for r in range(n) {
        Row {
          gap: 0
          for col in range(4) {
            Tile { k: cells[off + r * 4 + col].k; bg: pal[cells[off + r * 4 + col].b]; fg: pal[cells[off + r * 4 + col].f]; ac: pal[cells[off + r * 4 + col].a]; size: c }
          }
        }
      }
    }
  }

  component Label(t, tint = ink) {
    Text { text: t; font: jost; fontSize: 12; fontWeight: 500; letterSpacing: 1; color: tint; maxLines: 1 }
  }

  // The hour in a bBlue circle, the minutes in a bRed square.
  component Header(no, what) {
    Row {
      align: bottom
      height: headH
      width: c * (wide ? 8 : 4)
      padding: [0, 0, 0, 8]
      Text { text: "bauhaus"; font: jost; fontSize: 30; fontWeight: 600; letterSpacing: 4; color: ink; weight: 1; maxLines: 1 }
      Column {
        gap: 0
        Text { text: no; font: jost; fontSize: 11; fontWeight: 600; letterSpacing: 2; color: bRed; align: end }
        Text { text: what; font: jost; fontSize: 11; fontWeight: 500; letterSpacing: 2; color: ink; align: end }
      }
    }
  }
  // The network's speed, from the change in its byte counters between two polls.
  state down = null
  state up = null
  on net { if old != null && value.rx >= old.rx && value.uptime > old.uptime { down = (value.rx - old.rx) / (value.uptime - old.uptime); up = (value.tx - old.tx) / (value.uptime - old.uptime) } }

  let level = num(bat.level, 0)
  let batTint = bat.charging ? bBlue : level < 20 ? bRed : bYellow
  let memF = sys.memory == null || !sys.memory.total ? 0 : sys.memory.used / sys.memory.total
  let diskF = sys.storage == null || !sys.storage.total ? 0 : sys.storage.used / sys.storage.total
  let volLv = num(vol.level, 0)

  // The battery as a half sun that fills, and memory and storage as bars and a pie.
  component Power() {
    Row {
      gap: 0
      Box {
        size: 2 * c
        onTap: settings("battery")
        Canvas {
          let r = width * 0.38
          let cy = height * 0.56
          rect(0, 0, width, height, fill: paper)
          arc(width / 2, cy, r, 270, 180, fill: ink)
          arc(width / 2, cy, r, 270, level * 1.8, fill: batTint)
          arc(width / 2, cy, r * 0.3, 270, 180, fill: paper)
          line(width * 0.06, cy, width * 0.94, cy, stroke: ink, width: 2)
        }
        Column {
          gap: 0
          padding: 10
          Label { t: "battery" }
          Spacer { weight: 1 }
          Text { text: "${bat.level ?? "…"}%"; font: jost; fontSize: c * 0.36; fontWeight: 600; color: ink; maxLines: 1 }
          Label { t: [bat.charging ? "charging" : "on battery", bat.temp == null ? null : "${round(bat.temp)}°c", bat.voltage == null ? null : "${fixed(bat.voltage, 2)} v"].filter(x => x != null).join(" · "); tint: alpha(ink, 0.7) }
        }
      }
      Column {
        gap: 0
        Box {
          width: 2 * c
          height: c
          Canvas {
            rect(0, 0, width, height, fill: bBlue)
            for i in range(8) {
              let x = width * 0.5 + i * (width * 0.5 - 10) / 8
              rect(x, 12, (width * 0.5 - 10) / 8 - 3, height - 24, fill: i < round(memF * 8) ? bYellow : alpha(paper, 0.2))
            }
          }
          Column {
            gap: 0
            padding: 10
            Label { t: "memory"; tint: paper }
            Spacer { weight: 1 }
            Text { text: "${round(memF * 100)}%"; font: jost; fontSize: c * 0.24; fontWeight: 600; color: paper }
            Label { t: sys.memory == null ? "…" : "${fmtBytes(sys.memory.available)} free"; tint: alpha(paper, 0.75) }
          }
        }
        Box {
          width: 2 * c
          height: c
          Canvas {
            let r = height * 0.36
            rect(0, 0, width, height, fill: bRed)
            circle(width - r - 14, height / 2, r, fill: ink)
            arc(width - r - 14, height / 2, r, 0, diskF * 360, fill: paper)
          }
          Column {
            gap: 0
            padding: 10
            Label { t: "storage"; tint: paper }
            Spacer { weight: 1 }
            Text { text: "${round(diskF * 100)}%"; font: jost; fontSize: c * 0.24; fontWeight: 600; color: paper }
            Label { t: sys.storage == null ? "…" : "${fmtBytes(sys.storage.free)} free"; tint: alpha(paper, 0.75) }
          }
        }
      }
    }
  }

  // Down and up as triangles, the signal as a staircase, and how long the phone has been on.
  component Net() {
    Row {
      gap: 0
      Box {
        size: c
        Canvas {
          rect(0, 0, width, height, fill: ink)
          path([[width * 0.5, height * 0.62], [width * 0.94, height * 0.62], [width * 0.72, height * 0.94]], closed: true, fill: bYellow)
        }
        Column {
          gap: 0
          padding: 8
          Text { text: down == null ? "…" : fmtBytes(down); font: jost; fontSize: c * 0.2; fontWeight: 600; color: paper; maxLines: 1 }
          Label { t: "down /s"; tint: alpha(paper, 0.7) }
        }
      }
      Box {
        size: c
        Canvas {
          rect(0, 0, width, height, fill: paper)
          path([[width * 0.5, height * 0.94], [width * 0.94, height * 0.94], [width * 0.72, height * 0.62]], closed: true, fill: bRed)
        }
        Column {
          gap: 0
          padding: 8
          Text { text: up == null ? "…" : fmtBytes(up); font: jost; fontSize: c * 0.2; fontWeight: 600; color: ink; maxLines: 1 }
          Label { t: "up /s" }
        }
      }
      Box {
        size: c
        onTap: settings("internet")
        Canvas {
          let bw = width * 0.11
          rect(0, 0, width, height, fill: bYellow)
          for i in range(4) {
            rect(width * 0.4 + i * (bw + 3), height * (0.9 - (i + 1) * 0.08), bw, height * (i + 1) * 0.08, fill: sim.signal != null && i < sim.signal ? ink : alpha(ink, 0.2))
          }
        }
        Column {
          gap: 0
          padding: 8
          Text { text: !sim.available ? "wi-fi" : !sim.present ? "no sim" : lower(sim.carrier ?? "…"); font: jost; fontSize: 14; fontWeight: 600; color: ink; maxLines: 1 }
          Label { t: sim.data ? "mobile data" : "signal" }
        }
      }
      Box {
        size: c
        Canvas {
          rect(0, 0, width, height, fill: bBlue)
          circle(width * 0.72, height * 0.72, width * 0.2, stroke: paper, width: 5)
          line(width * 0.72, height * 0.72, width * 0.72, height * 0.6, stroke: paper, width: 4, cap: round)
          line(width * 0.72, height * 0.72, width * 0.8, height * 0.72, stroke: paper, width: 4, cap: round)
        }
        Column {
          gap: 0
          padding: 8
          Text { text: sys.uptime == null ? "…" : fmtDuration(sys.uptime); font: jost; fontSize: c * 0.18; fontWeight: 600; color: paper; maxLines: 1 }
          Label { t: "uptime"; tint: alpha(paper, 0.7) }
        }
      }
    }
  }

  // A switch: its colour when on, the paper when off, with a shape for each.
  component Switch(name, on, tint, shape) {
    Box {
      size: c
      Canvas {
        let w = width
        let h = height
        let f = on ? (tint == bYellow ? ink : paper) : alpha(ink, 0.2)
        rect(0, 0, w, h, fill: on ? tint : paper)
        if shape == "wifi" {
          for i in range(3) { arc(w * 0.92, h * 0.92, w * (0.2 + i * 0.17), 270, 90, stroke: f, width: w * 0.07) }
        }
        if shape == "bt" {
          path([[w * 0.55, h * 0.48], [w * 0.9, h * 0.48], [w * 0.725, h * 0.7]], closed: true, fill: f)
          path([[w * 0.55, h * 0.92], [w * 0.9, h * 0.92], [w * 0.725, h * 0.7]], closed: true, fill: f)
        }
        if shape == "dnd" {
          circle(w * 0.72, h * 0.72, w * 0.21, fill: f)
          rect(w * 0.6, h * 0.69, w * 0.24, h * 0.06, fill: on ? tint : paper)
        }
        if shape == "torch" {
          path([[w * 0.72, h * 0.94], [w * 0.5, h * 0.46], [w * 0.94, h * 0.46]], closed: true, fill: f)
        }
      }
      Column {
        gap: 0
        padding: 8
        Text { text: name; font: jost; fontSize: 15; fontWeight: 600; color: on && tint != bYellow ? paper : ink; maxLines: 1 }
        Label { t: on ? "on" : "off"; tint: on && tint != bYellow ? alpha(paper, 0.7) : alpha(ink, 0.6) }
      }
    }
  }

  component Switches() {
    Row {
      gap: 0
      Box { onTap: settings("wifi"); Switch { name: "wi-fi"; on: modes.wifi == true; tint: bBlue; shape: "wifi" } }
      Box { onTap: settings("bluetooth"); Switch { name: "bluetooth"; on: modes.bluetooth == true; tint: ink; shape: "bt" } }
      Box { onTap: dnd("toggle"); Switch { name: "quiet"; on: modes.dnd == true; tint: bRed; shape: "dnd" } }
      Box { onTap: if modes.torch != null { torch("toggle") }; Switch { name: "torch"; on: modes.torch == true; tint: bYellow; shape: "torch" } }
    }
  }

  // The volume as a staircase: tap a step to set it.
  component Volume() {
    Box {
      width: 4 * c
      height: c
      onTap: volume(clamp(ceil(x / (4 * c) * 10), 0, 10) * 10)
      Canvas {
        let sw = (width - 16) / 10
        rect(0, 0, width, height, fill: paper)
        for i in range(10) {
          let sh = (height - 20) * (i + 1) / 10
          rect(8 + i * sw + 1, height - 8 - sh, sw - 2, sh, fill: !vol.muted && volLv > i * 10 ? bRed : alpha(ink, 0.12))
        }
      }
      Column {
        gap: 0
        padding: 10
        Label { t: vol.muted ? "muted" : "volume ${volLv}%" }
        Label { t: lower(vol.output.name ?? vol.output.type ?? ""); tint: alpha(ink, 0.6) }
      }
    }
  }

  // The phone itself, on a black band.
  component Device() {
    Box {
      width: 4 * c
      height: c
      Canvas {
        rect(0, 0, width, height, fill: ink)
        arc(width, height / 2, height * 0.42, 180, 180, fill: bYellow)
      }
      Column {
        gap: 0
        padding: 10
        width: 4 * c - c * 0.5
        Spacer { weight: 1 }
        Text { text: dev == null ? "…" : lower("${dev.maker} ${dev.model}"); font: jost; fontSize: c * 0.22; fontWeight: 600; color: paper; maxLines: 1 }
        Label { t: [dev.android == null ? null : "android ${dev.android}", sys.kernel == null ? null : "linux ${first(split(sys.kernel, "-"))}", sys.launcher == null ? null : "omalauncher ${sys.launcher}"].filter(x => x != null).join(" · "); tint: alpha(paper, 0.7) }
      }
    }
  }

  component PartA() {
    Column {
      gap: 0
      Power { }
      Net { }
    }
  }

  component PartB() {
    Column {
      gap: 0
      Switches { }
      Volume { }
      Device { }
    }
  }

  Column {
    fill: true
    gap: 0
    align: center
    padding: [m + screenLeft, screenTop + 8, m + screenRight, 0]
    Header { no: pageNo; what: pageWhat }
    Spacer { weight: 1 }
    if wide {
      Row {
        gap: 0
        Column {
          gap: 0
          PartA { }
          Filler { n: max(rowsFit - rowsA, 0); off: 0 }
        }
        Column {
          gap: 0
          PartB { }
          Filler { n: max(rowsFit - rowsB, 0); off: 24 }
        }
      }
    } else {
      Column {
        gap: 0
        PartA { }
        PartB { }
        Filler { n: max(rowsFit - rowsA - rowsB, 0); off: 0 }
      }
    }
    Spacer { weight: 1 }
    Box {
      height: footH
      align: center
      Text { text: "staatliches bauhaus"; font: jost; fontSize: 10; fontWeight: 500; letterSpacing: 3; color: alpha(ink, 0.6) }
    }
    Spacer { height: screenInset }
  }
}
