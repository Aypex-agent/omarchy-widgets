face "bauhaus today" {
  // The bauhaus face's second page: what's playing on a record, the newest notifications in coloured strips and your
  // most used apps as lettered squares. Tap a notification to open it, hold it to dismiss it.

  meta { owl: 14 }

  source now = clock every 1m
  source mp = android.media
  source n = android.notifications
  // Ranked as the drawer's search ranks them: opened often and lately first.
  source apps = android.apps

  let rowsA = 4
  let rowsB = 2
  let pageNo = "nº 2"
  let salt = 2
  let pageWhat = !n.available || n.count == 0 ? "today" : n.count == 1 ? "1 notification" : "${n.count} notifications"

  // The poster is printed in its own colours whatever the theme, so the status bar steps aside.
  statusBar: false
  edge: true
  padding: 0
  background: #EEE6D3

  // Tapping the poster's own squares lays out a new pattern; it also changes with the day.
  state seed = 1923 persist

  let jost = "https://raw.githubusercontent.com/google/fonts/main/ofl/jost/Jost%5Bwght%5D.ttf"
  let paper = #EEE6D3
  let ink = #1E1D1B
  let bRed = #D63A27
  let bBlue = #22509C
  let bYellow = #F2B02A
  let bOrange = #E5732C
  let bPink = #E9A196
  let pal = [paper, bRed, bBlue, bYellow, ink, bOrange, bPink]
  let kinds = ["qtl", "qbr", "qbl", "qtr", "dome", "bowl", "circle", "tri", "bow", "stripes", "target", "eyes", "dots", "steps", "split"]

  // The grid: square cells c dp across, four columns, two blocks of four side by side when the screen is wide. The page's
  // squares take rowsA rows in the first block and rowsB in the second; the rows left over are the poster's own.
  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  let m = 16
  let headH = 52
  let footH = 26
  let availW = W - 2 * m - screenLeft - screenRight
  let availH = H - screenTop - 8 - headH - footH - screenInset
  let c = floor(min(availW / (wide ? 8 : 4), availH / (wide ? max(rowsA, rowsB) : rowsA + rowsB)))
  let rowsFit = floor(availH / c)
  let day = floor(now / 86400)
  // A shape and three colours for each of the poster's own squares, never on the paper itself.
  let cells = range(48).map(i => {
    k: kinds[floor(hash(seed, day, salt, i, 0) * 15)],
    b: 1 + floor(hash(seed, day, salt, i, 1) * 6),
    f: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 2) * 6)) % 7,
    a: (1 + floor(hash(seed, day, salt, i, 1) * 6) + 1 + floor(hash(seed, day, salt, i, 3) * 6)) % 7
  })

  // One square of the poster: a shape in fg on bg, with ac for a second one.
  component Tile(k, bg, fg, ac) {
    Canvas {
      rect(0, 0, width, height, fill: bg)
      if k == "qtl" { arc(0, 0, width, 90, 90, fill: fg) }
      if k == "qbr" { arc(width, height, width, 270, 90, fill: fg) }
      if k == "qbl" { arc(0, height, width, 0, 90, fill: fg) }
      if k == "qtr" { arc(width, 0, width, 180, 90, fill: fg) }
      if k == "dome" {
        arc(width / 2, height, width / 2, 270, 180, fill: fg)
        arc(width / 2, height, width / 5, 270, 180, fill: ac)
      }
      if k == "bowl" { arc(width / 2, 0, width / 2, 90, 180, fill: fg) }
      if k == "circle" {
        circle(width / 2, height / 2, width * 0.4, fill: fg)
        circle(width / 2, height / 2, width * 0.14, fill: ac)
      }
      if k == "tri" { path([[0, height], [width, 0], [width, height]], closed: true, fill: fg) }
      if k == "bow" {
        path([[0, 0], [width, 0], [width / 2, height / 2]], closed: true, fill: fg)
        path([[0, height], [width, height], [width / 2, height / 2]], closed: true, fill: ac)
      }
      if k == "stripes" {
        for i in range(4) { rect(width * (i * 2 + 1) / 8, 0, width / 8, height, fill: fg) }
      }
      if k == "target" {
        circle(width / 2, height / 2, width * 0.44, fill: fg)
        circle(width / 2, height / 2, width * 0.32, fill: bg)
        circle(width / 2, height / 2, width * 0.2, fill: fg)
        circle(width / 2, height / 2, width * 0.08, fill: ac)
      }
      if k == "eyes" {
        arc(0, height / 2, height / 2, 0, 180, fill: fg)
        arc(width, height / 2, height / 2, 180, 180, fill: ac)
      }
      if k == "dots" {
        for i in range(9) { circle(width * (i % 3 + 0.5) / 3, height * (floor(i / 3) + 0.5) / 3, width * 0.11, fill: fg) }
      }
      if k == "steps" {
        rect(0, height * 2 / 3, width, height / 3, fill: fg)
        rect(width / 3, height / 3, width * 2 / 3, height / 3, fill: fg)
        rect(width * 2 / 3, 0, width / 3, height / 3, fill: fg)
      }
      if k == "split" {
        rect(0, 0, width / 2, height, fill: fg)
        arc(width / 2, height / 2, width * 0.36, 180, 180, fill: ac)
        arc(width / 2, height / 2, width * 0.36, 0, 180, fill: fg)
      }
    }
  }

  // n rows of the poster's own squares, from the cell list at off.
  component Filler(n, off) {
    Column {
      gap: 0
      onTap: seed = random(1000000)
      ripple: false
      for r in range(n) {
        Row {
          gap: 0
          for col in range(4) {
            Tile { k: cells[off + r * 4 + col].k; bg: pal[cells[off + r * 4 + col].b]; fg: pal[cells[off + r * 4 + col].f]; ac: pal[cells[off + r * 4 + col].a]; size: c }
          }
        }
      }
    }
  }

  component Label(t, tint = ink) {
    Text { text: t; font: jost; fontSize: 12; fontWeight: 500; letterSpacing: 1; color: tint; maxLines: 1 }
  }

  // The hour in a bBlue circle, the minutes in a bRed square.
  component Header(no, what) {
    Row {
      align: bottom
      height: headH
      width: c * (wide ? 8 : 4)
      padding: [0, 0, 0, 8]
      Text { text: "bauhaus"; font: jost; fontSize: 30; fontWeight: 600; letterSpacing: 4; color: ink; weight: 1; maxLines: 1 }
      Column {
        gap: 0
        Text { text: no; font: jost; fontSize: 11; fontWeight: 600; letterSpacing: 2; color: bRed; align: end }
        Text { text: what; font: jost; fontSize: 11; fontWeight: 500; letterSpacing: 2; color: ink; align: end }
      }
    }
  }
  let has = mp != null && mp.title != null && mp.title != ""
  let playing = has && mp.playing == true
  let notes = n.available ? n.items.take(4) : []
  let top = (apps ?? []).filter(a => !a.system || a.score > 0).sortBy(a => -a.score).take(8)
  let stripes = [bRed, bBlue, bYellow, ink]
  let appLooks = [[bRed, ink, paper], [bBlue, bYellow, paper], [bYellow, bRed, ink], [ink, bBlue, paper], [paper, bBlue, ink], [bOrange, ink, ink], [bPink, bRed, ink], [bBlue, bRed, paper]]

  // What's playing: a record with the cover on its label, then the title and three keys.
  component Music() {
    Row {
      gap: 0
      Box {
        size: 2 * c
        align: center
        onTap: media("open")
        Canvas {
          let r = width * 0.44
          rect(0, 0, width, height, fill: bYellow)
          circle(width / 2, height / 2, r, fill: ink)
          for i in range(4) { circle(width / 2, height / 2, r * (0.88 - i * 0.12), stroke: alpha(paper, 0.14), width: 1.5) }
          circle(width / 2, height / 2, width * 0.17, fill: bRed)
          circle(width / 2, height / 2, 3, fill: paper)
        }
        if has && mp.art != null {
          Box {
            size: c * 0.68
            radius: c * 0.34
            clip: true
            Image { src: mp.art; fit: cover; fill: true }
          }
        }
      }
      Box {
        size: 2 * c
        Canvas { rect(0, 0, width, height, fill: paper) }
        Column {
          gap: 2
          padding: 12
          fill: true
          Label { t: !has ? (mp.available == false ? "music" : "nothing playing") : playing ? "now playing" : "paused"; tint: bRed }
          Text { text: has ? mp.title : mp.available == false ? "allow notification access to see music here" : "play something and it shows here"; font: jost; fontSize: has ? 20 : 15; fontWeight: has ? 600 : 400; color: ink; maxLines: 3 }
          if has {
            Text { text: mp.artist ?? lower(mp.app ?? ""); font: jost; fontSize: 13; color: alpha(ink, 0.7); maxLines: 1 }
          }
          Spacer { weight: 1 }
          Row {
            gap: 0
            justify: spaceBetween
            fill: width
            align: center
            Box {
              size: c * 0.5
              onTap: media("previous")
              Canvas {
                let s = width
                path([[s * 0.62, s * 0.28], [s * 0.62, s * 0.72], [s * 0.28, s * 0.5]], closed: true, fill: ink)
                rect(s * 0.22, s * 0.28, s * 0.07, s * 0.44, fill: ink)
              }
            }
            Box {
              size: c * 0.62
              onTap: media("toggle")
              Canvas {
                let s = width
                circle(s / 2, s / 2, s / 2, fill: bRed)
                if playing {
                  rect(s * 0.36, s * 0.32, s * 0.1, s * 0.36, fill: paper)
                  rect(s * 0.54, s * 0.32, s * 0.1, s * 0.36, fill: paper)
                } else {
                  path([[s * 0.4, s * 0.3], [s * 0.4, s * 0.7], [s * 0.72, s * 0.5]], closed: true, fill: paper)
                }
              }
            }
            Box {
              size: c * 0.5
              onTap: media("next")
              Canvas {
                let s = width
                path([[s * 0.38, s * 0.28], [s * 0.38, s * 0.72], [s * 0.72, s * 0.5]], closed: true, fill: ink)
                rect(s * 0.71, s * 0.28, s * 0.07, s * 0.44, fill: ink)
              }
            }
          }
        }
      }
    }
  }

  // The newest four notifications, each a strip behind a coloured square with its app's icon.
  component Notes() {
    Column {
      gap: 0
      width: 4 * c
      height: 2 * c
      if !n.available {
        Box {
          width: 4 * c
          height: 2 * c
          onTap: notification("open", "")
          Tile { k: "stripes"; bg: paper; fg: bBlue; ac: bBlue }
          Text { text: "allow notification access to see them here"; font: jost; fontSize: 16; fontWeight: 500; color: ink; background: paper; padding: [12, 8]; align: center; width: 3 * c }
        }
      } else if n.count == 0 {
        Box {
          width: 4 * c
          height: 2 * c
          Canvas {
            rect(0, 0, width, height, fill: paper)
            circle(width - height / 2, height / 2, height * 0.42, fill: bBlue)
            path([[width - height * 0.68, height * 0.52], [width - height * 0.55, height * 0.65], [width - height * 0.3, height * 0.36]], stroke: paper, width: 7, cap: round)
          }
          Column {
            gap: 0
            padding: 12
            Spacer { weight: 1 }
            Text { text: "all clear"; font: jost; fontSize: c * 0.32; fontWeight: 600; color: ink }
            Label { t: "no notifications" }
          }
        }
      } else {
        for item, i in notes key item.key {
          Row {
            gap: 0
            height: c / 2
            width: 4 * c
            background: i % 2 == 0 ? paper : #E4DAC3
            align: center
            onTap: notification("open", item.key)
            onLongPress: { haptic(); notification("dismiss", item.key) }
            Box {
              size: c / 2
              align: center
              background: stripes[i % 4]
              Canvas { circle(width / 2, height / 2, width * 0.34, fill: paper) }
              Image { src: item.icon; size: c * 0.26 }
            }
            Column {
              gap: 0
              weight: 1
              padding: [10, 0]
              Text { text: item.title; font: jost; fontSize: 14; fontWeight: 600; color: ink; maxLines: 1 }
              if item.text != "" {
                Text { text: item.text; font: jost; fontSize: 12; color: alpha(ink, 0.7); maxLines: 1 }
              }
            }
            Text { text: fmtAgo(item.time, now); font: jost; fontSize: 11; fontWeight: 500; color: alpha(ink, 0.6); padding: [0, 0, 10, 0] }
          }
        }
        // The strips left over are small squares of the poster's own.
        for i in range(4 - len(notes)) {
          Row {
            gap: 0
            for j in range(8) {
              Tile { k: cells[(i * 8 + j + 16) % 48].k; bg: pal[cells[(i * 8 + j + 16) % 48].b]; fg: pal[cells[(i * 8 + j + 16) % 48].f]; ac: pal[cells[(i * 8 + j + 16) % 48].a]; size: c / 2 }
            }
          }
        }
      }
    }
  }

  // Four of the most used apps, from the from-th: a letter and a shape for each.
  component AppRow(from) {
    Row {
      gap: 0
      for i in range(4) {
        Box {
          size: c
          onTap: if top[from + i] != null { androidApp(top[from + i].key) }
          let a = top[from + i]
          let look = appLooks[from + i]
          Canvas {
            let w = width
            let h = height
            rect(0, 0, w, h, fill: look[0])
            if (from + i) % 4 == 0 { arc(w, h, w * 0.34, 270, 90, fill: look[1]) }
            if (from + i) % 4 == 1 { arc(w * 0.72, h, w * 0.24, 270, 180, fill: look[1]) }
            if (from + i) % 4 == 2 { path([[w * 0.6, h], [w, h * 0.6], [w, h]], closed: true, fill: look[1]) }
            if (from + i) % 4 == 3 { circle(w * 0.78, h * 0.78, w * 0.15, fill: look[1]) }
          }
          if a != null {
            Column {
              gap: 0
              padding: 8
              Text { text: lower(sub(a.name, 0, 1)); font: jost; fontSize: c * 0.34; fontWeight: 600; color: look[2]; maxLines: 1 }
              Text { text: lower(a.name); font: jost; fontSize: 11; fontWeight: 500; color: look[2]; maxLines: 1; width: c - 16 }
            }
          }
        }
      }
    }
  }

  component PartA() {
    Column {
      gap: 0
      Music { }
      if wide {
        AppRow { from: 0 }
        AppRow { from: 4 }
      } else {
        Notes { }
      }
    }
  }

  component PartB() {
    Column {
      gap: 0
      if wide {
        Notes { }
      } else {
        AppRow { from: 0 }
        AppRow { from: 4 }
      }
    }
  }

  Column {
    fill: true
    gap: 0
    align: center
    padding: [m + screenLeft, screenTop + 8, m + screenRight, 0]
    Header { no: pageNo; what: pageWhat }
    Spacer { weight: 1 }
    if wide {
      Row {
        gap: 0
        Column {
          gap: 0
          PartA { }
          Filler { n: max(rowsFit - rowsA, 0); off: 0 }
        }
        Column {
          gap: 0
          PartB { }
          Filler { n: max(rowsFit - rowsB, 0); off: 24 }
        }
      }
    } else {
      Column {
        gap: 0
        PartA { }
        PartB { }
        Filler { n: max(rowsFit - rowsA - rowsB, 0); off: 0 }
      }
    }
    Spacer { weight: 1 }
    Box {
      height: footH
      align: center
      Text { text: "staatliches bauhaus"; font: jost; fontSize: 10; fontWeight: 500; letterSpacing: 3; color: alpha(ink, 0.6) }
    }
    Spacer { height: screenInset }
  }
}
