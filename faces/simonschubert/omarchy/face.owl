face "omarchy" {
  // A session in the Omarchy way: a bar, gaps, and tiled windows on the wallpaper.
  // Its windows have home's tile glass: widgets.opacity and frosted glass from settings › style.
  // Workspace 1 is the desktop. 2 apps, 3 quattro, 4 notifications, 5 agents.

  meta {
    owl: 23
    description: "An Omarchy session: a bar, tiled windows, fastfetch, quattro commits, and your apps"
    version: "1.4"
    license: "MIT"
    category: "system"
  }

  // What it says, in the phone's language where it has a set. Day names come from the phone. The fetch keeps
  // fastfetch's own keys where they're Linux words (os, host, kernel, shell, wm, cpu); apps, commits,
  // notifications and agents come as they are.
  strings {
    en {
      bar: "EEE d  HH:mm"; dnd: "dnd"
      uptime: "uptime"; packages: "pkgs"; theme: "theme"; memory: "memory"; battery: "battery"; byDefault: "default"
      apps: "apps"; appCount: n => "${n} apps"; charging: "charging"
      rateLimited: "rate limited"; offline: "offline"
      recent: "recent"; all: "all"; notifications: "notifications"; allow: "allow notification access"; allClear: "all clear"
      agents: "agents"; manage: "manage"; noAgent: "no agent installed"
      now: "now"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}w"; years: n => "${n}y"
    }
    id {
      bar: "EEE d  HH:mm"; dnd: "jangan ganggu"
      uptime: "aktif"; packages: "paket"; theme: "tema"; memory: "memori"; battery: "baterai"; byDefault: "default"
      apps: "aplikasi"; appCount: n => "${n} aplikasi"; charging: "mengisi"
      rateLimited: "kena batas"; offline: "offline"
      recent: "terbaru"; all: "semua"; notifications: "notifikasi"; allow: "izinkan akses notifikasi"; allClear: "semua sudah dibaca"
      agents: "agen"; manage: "kelola"; noAgent: "belum ada agen terpasang"
      now: "kini"; minutes: n => "${n}m"; hours: n => "${n}j"; days: n => "${n}h"; weeks: n => "${n}mg"; years: n => "${n}th"
    }
    es {
      bar: "EEE d  HH:mm"; dnd: "no molestar"
      uptime: "uptime"; packages: "paquetes"; theme: "tema"; memory: "memoria"; battery: "batería"; byDefault: "predeterminado"
      apps: "apps"; appCount: n => "${n} apps"; charging: "cargando"
      rateLimited: "límite alcanzado"; offline: "sin conexión"
      recent: "recientes"; all: "todas"; notifications: "notificaciones"; allow: "permitir acceso a las notificaciones"; allClear: "todo al día"
      agents: "agentes"; manage: "gestionar"; noAgent: "ningún agente instalado"
      now: "ahora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}sem"; years: n => "${n}a"
    }
    pt {
      bar: "EEE d  HH:mm"; dnd: "não perturbe"
      uptime: "uptime"; packages: "pacotes"; theme: "tema"; memory: "memória"; battery: "bateria"; byDefault: "padrão"
      apps: "apps"; appCount: n => "${n} apps"; charging: "carregando"
      rateLimited: "limite atingido"; offline: "offline"
      recent: "recentes"; all: "todos"; notifications: "notificações"; allow: "permitir acesso às notificações"; allClear: "tudo em dia"
      agents: "agentes"; manage: "gerenciar"; noAgent: "nenhum agente instalado"
      now: "agora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}sem"; years: n => "${n}a"
    }
    de {
      bar: "EEE d.  HH:mm"; dnd: "nicht stören"
      uptime: "uptime"; packages: "pakete"; theme: "theme"; memory: "ram"; battery: "akku"; byDefault: "standard"
      apps: "apps"; appCount: n => "${n} apps"; charging: "lädt"
      rateLimited: "zu viele anfragen"; offline: "offline"
      recent: "zuletzt"; all: "alle"; notifications: "benachrichtigungen"; allow: "zugriff auf benachrichtigungen erlauben"; allClear: "alles gelesen"
      agents: "agenten"; manage: "verwalten"; noAgent: "kein agent installiert"
      now: "jetzt"; minutes: n => "${n} min"; hours: n => "${n} std"; days: n => "${n} tg"; weeks: n => "${n} wo"; years: n => "${n} j"
    }
    zh {
      bar: "d日 EEE  HH:mm"; dnd: "勿扰"
      uptime: "运行时间"; packages: "软件包"; theme: "主题"; memory: "内存"; battery: "电池"; byDefault: "默认"
      apps: "应用"; appCount: n => "${n} 个应用"; charging: "充电中"
      rateLimited: "请求过多"; offline: "离线"
      recent: "最近"; all: "全部"; notifications: "通知"; allow: "允许访问通知"; allClear: "全部看完了"
      agents: "智能体"; manage: "管理"; noAgent: "未安装智能体"
      now: "刚刚"; minutes: n => "${n}分钟"; hours: n => "${n}小时"; days: n => "${n}天"; weeks: n => "${n}周"; years: n => "${n}年"
    }
    ru {
      bar: "EEE d  HH:mm"; dnd: "не беспокоить"
      uptime: "аптайм"; packages: "пакеты"; theme: "тема"; memory: "память"; battery: "батарея"; byDefault: "по умолчанию"
      apps: "приложения"; charging: "заряжается"
      appCount: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "приложение" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "приложения" : "приложений")
      rateLimited: "лимит запросов"; offline: "офлайн"
      recent: "недавние"; all: "все"; notifications: "уведомления"; allow: "разрешить доступ к уведомлениям"; allClear: "всё прочитано"
      agents: "агенты"; manage: "настроить"; noAgent: "агенты не установлены"
      now: "сейчас"; minutes: n => "${n} мин"; hours: n => "${n} ч"; days: n => "${n} д"; weeks: n => "${n} нед"; years: n => "${n} г"
    }
    ja {
      bar: "d日(EEE)  HH:mm"; dnd: "サイレント"
      uptime: "稼働時間"; packages: "パッケージ"; theme: "テーマ"; memory: "メモリ"; battery: "バッテリー"; byDefault: "デフォルト"
      apps: "アプリ"; appCount: n => "アプリ ${n} 個"; charging: "充電中"
      rateLimited: "リクエスト制限中"; offline: "オフライン"
      recent: "最近"; all: "すべて"; notifications: "通知"; allow: "通知へのアクセスを許可"; allClear: "新しい通知はありません"
      agents: "エージェント"; manage: "管理"; noAgent: "エージェントがインストールされていません"
      now: "今"; minutes: n => "${n} 分"; hours: n => "${n} 時間"; days: n => "${n} 日"; weeks: n => "${n} 週間"; years: n => "${n} 年"
    }
    uk {
      bar: "EEE d  HH:mm"; dnd: "не турбувати"
      uptime: "аптайм"; packages: "пакети"; theme: "тема"; memory: "пам'ять"; battery: "батарея"; byDefault: "типово"
      apps: "додатки"; charging: "заряджається"
      appCount: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "додаток" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "додатки" : "додатків")
      rateLimited: "ліміт запитів"; offline: "офлайн"
      recent: "нещодавні"; all: "усі"; notifications: "сповіщення"; allow: "дозволити доступ до сповіщень"; allClear: "усе прочитано"
      agents: "агенти"; manage: "керувати"; noAgent: "агентів не встановлено"
      now: "зараз"; minutes: n => "${n} хв"; hours: n => "${n} год"; days: n => "${n} дн"; weeks: n => "${n} тиж"; years: n => "${n} р"
    }
    fr {
      bar: "EEE d  HH:mm"; dnd: "silence"
      uptime: "uptime"; packages: "paquets"; theme: "thème"; memory: "mémoire"; battery: "batterie"; byDefault: "par défaut"
      apps: "applis"; appCount: n => "${n} " + (n < 2 ? "appli" : "applis"); charging: "en charge"
      rateLimited: "trop de requêtes"; offline: "hors ligne"
      recent: "récentes"; all: "toutes"; notifications: "notifications"; allow: "autoriser l’accès aux notifications"; allClear: "tout est lu"
      agents: "agents"; manage: "gérer"; noAgent: "aucun agent installé"
      now: "maint."; minutes: n => "${n} min"; hours: n => "${n} h"; days: n => "${n} j"; weeks: n => "${n} sem"; years: n => n < 2 ? "${n} an" : "${n} ans"
    }
    tr {
      bar: "EEE d  HH:mm"; dnd: "rahatsız etme"
      uptime: "uptime"; packages: "paket"; theme: "tema"; memory: "bellek"; battery: "pil"; byDefault: "varsayılan"
      apps: "uygulama"; appCount: n => "${n} uygulama"; charging: "şarj oluyor"
      rateLimited: "çok fazla istek"; offline: "çevrimdışı"
      recent: "son"; all: "tümü"; notifications: "bildirimler"; allow: "bildirim erişimine izin ver"; allClear: "hepsi okundu"
      agents: "ajanlar"; manage: "yönet"; noAgent: "yüklü ajan yok"
      now: "şimdi"; minutes: n => "${n} dk"; hours: n => "${n} sa"; days: n => "${n} g"; weeks: n => "${n} hf"; years: n => "${n} y"
    }
    it {
      bar: "EEE d  HH:mm"; dnd: "silenzio"
      uptime: "uptime"; packages: "pacchetti"; theme: "tema"; memory: "ram"; battery: "batteria"; byDefault: "predefinito"
      apps: "app"; appCount: n => "${n} app"; charging: "in carica"
      rateLimited: "troppe richieste"; offline: "offline"
      recent: "recenti"; all: "tutte"; notifications: "notifiche"; allow: "consenti l’accesso alle notifiche"; allClear: "tutto letto"
      agents: "agenti"; manage: "gestisci"; noAgent: "nessun agente installato"
      now: "ora"; minutes: n => "${n} min"; hours: n => "${n} h"; days: n => "${n} g"; weeks: n => "${n} sett"; years: n => n < 2 ? "${n} anno" : "${n} anni"
    }
  }

  statusBar: false
  padding: 0

  source now = clock every 1m
  source dev = android.device
  source sys = android.system every 1m
  source bat = android.battery
  source modes = android.modes
  source m = android.media
  source n = android.notifications
  source apps = android.apps
  source rec = android.recent
  source ag = android.agents
  // Arch, once Linux is installed. Base tools only, so the face still runs without it. Hourly: each run starts
  // a process in Linux, and the release, the package count and the shell hardly change.
  source lx = cmd("""
    . /etc/os-release
    printf '%s\t%s\t%s\n' "$PRETTY_NAME" "$(pacman -Qq | wc -l)" "$(basename "$SHELL")"
  """) every 1h optional
  source raw = http("https://api.github.com/repos/omacom/omarchy/commits?sha=quattro&per_page=20", {Accept: "application/vnd.github+json"}) every 10m timeout 15s json status

  state ws = 1
  state focused = "fetch"

  let host = lower(replace(trim(dev.model ?? "phone"), " ", "-"))
  let user = linux ? "root" : "user"
  let mem = sys.memory
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let playing = m != null && m.title != null && m.title != ""
  let osName = !linux ? (dev == null ? null : "Android ${dev.android}") : (lx == null || lx == "" ? null : trim(split(lx, "\t")[0]))
  let pkgLine = !linux ? (sys.apps == null ? null : "${sys.apps} (${str.apps})") : (lx == null || lx == "" ? null : "${trim(split(lx, "\t")[1])} (pacman) · ${str.appCount(sys.apps)}")
  let shellName = !linux || lx == null || lx == "" ? null : trim(split(lx, "\t")[2])
  let cpuLine = sys.cpu == null ? null : trim("${sys.cpu.soc == "" || sys.cpu.soc == null ? sys.cpu.hardware : sys.cpu.soc} (${sys.cpu.cores})")
  let memLine = mem == null || !mem.total ? null : "${fmtBytes(mem.used)} / ${fmtBytes(mem.total)}"
  let batLine = bat == null ? null : "${bat.level}%${bat.charging ? " · ${str.charging}" : ""}"
  let themeName = lower(sys.theme ?? str.byDefault)
  let problem = raw == null || raw.ok ? null : raw.code == 403 ? str.rateLimited : str.offline
  let commits = (raw != null && raw.ok ? raw.out ?? [] : []).map(c => {
    sha: c.sha,
    url: c.html_url,
    subject: first(split(c.commit.message ?? "", "\n")) ?? "",
    author: c.author.login ?? c.commit.author.name ?? "",
    at: parseTime(c.commit.author.date)
  })
  let top = values(groupBy((apps ?? []).filter(a => !a.system || a.score > 0).sortBy(a => -a.score), a => a.name)).map(g => g[0])
  let sideApps = len(rec ?? []) > 0 ? (rec ?? []).take(10) : top.take(10)
  let ink = alpha(muted, 0.55)
  let glass = alpha(background, tileOpacity)
  let gap = 5

  component Ws(n) {
    Column {
      gap: 2
      align: center
      width: 22
      padding: [0, 1]
      onTap: { ws = n; haptic("light") }
      Text { text: "${n}"; font: mono; fontSize: 14; fontWeight: ws == n ? 700 : 500; color: ws == n ? accent : alpha(foreground, 0.55); align: center; width: 22 }
      Box { width: 14; height: 2; background: ws == n ? accent : alpha(foreground, 0) }
    }
  }

  component Line(key, value) {
    Row {
      gap: 12
      Text { text: key; font: mono; fontSize: 14; color: accent; width: 76; maxLines: 1 }
      Text { text: value; font: mono; fontSize: 14; maxLines: 1; weight: 1 }
    }
  }

  component Palette() {
    Column {
      gap: 3
      for row in [[color0, color1, color2, color3, color4, color5, color6, color7], [color8, color9, color10, color11, color12, color13, color14, color15]] {
        Row {
          gap: 3
          for c in row { Box { width: 16; height: 8; background: c } }
        }
      }
    }
  }

  component Fetch() {
    Column {
      fill: width
      gap: 10
      padding: [14, 12]
      background: glass
      frost: tileFrost
      border: 2
      borderColor: focused == "fetch" ? accent : ink
      clip: true
      onTap: focused = "fetch"
      Text { text: "omarchy"; font: mono; fontSize: 26; fontWeight: 700; letterSpacing: 1; maxLines: 1; onTap: launcher("style") }
      Text {
        spans: [{text: user, color: accent, bold: true}, "@", {text: host, color: accent, bold: true}]
        font: mono
        fontSize: 16
        maxLines: 1
      }
      Palette {}
      Column {
        gap: 3
        Line { key: "os"; value: osName }
        Line { key: "host"; value: dev == null ? null : "${dev.maker} ${dev.model}" }
        Line { key: "kernel"; value: sys.kernel }
        Line { key: str.uptime; value: sys.uptime == null ? null : fmtDuration(sys.uptime) }
        Line { key: str.packages; value: pkgLine }
        if linux { Line { key: "shell"; value: shellName } }
        Line { key: "wm"; value: sys.launcher == null ? null : "omalauncher ${sys.launcher}" }
        Row {
          gap: 12
          onTap: launcher("themes")
          Text { text: str.theme; font: mono; fontSize: 14; color: accent; width: 76; maxLines: 1 }
          Text { text: themeName; font: mono; fontSize: 14; maxLines: 1; weight: 1 }
        }
        Line { key: "cpu"; value: cpuLine }
        Line { key: str.memory; value: memLine }
        Line { key: str.battery; value: batLine }
      }
    }
  }

  component CommitRow(c, showAuthor) {
    Row {
      gap: 8
      align: center
      padding: [0, 5]
      onTap: { focused = "commits"; url(c.url) }
      Column {
        gap: 0
        weight: 1
        Text { text: c.subject; font: mono; fontSize: 12; maxLines: 1 }
        if showAuthor {
          Text { text: c.author; font: mono; fontSize: 11; color: muted; maxLines: 1 }
        }
      }
      let age = abs(now - c.at)
      Text { text: age < 60 ? str.now : age < 3600 ? str.minutes(floor(age / 60)) : age < 86400 ? str.hours(floor(age / 3600)) : age < 604800 ? str.days(floor(age / 86400)) : age < 31536000 ? str.weeks(floor(age / 604800)) : str.years(floor(age / 31536000)); font: mono; fontSize: 11; color: muted; maxLines: 1 }
    }
  }

  component Commits(full = false) {
    Column {
      fill: true
      gap: 6
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: (full || focused == "commits") ? accent : ink
      clip: true
      onTap: focused = "commits"
      Row {
        align: center
        Text { text: "quattro"; font: mono; fontSize: 12; color: accent; weight: 1; onTap: url("https://github.com/omacom/omarchy/commits/quattro") }
        Text { text: problem ?? (raw == null ? "…" : "${len(commits)}"); font: mono; fontSize: 11; color: muted; maxLines: 1 }
      }
      if problem != null {
        Text { text: problem; font: mono; fontSize: 13; color: muted }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 0
          for c in commits key c.sha {
            CommitRow { c: c; showAuthor: full }
          }
        }
      }
    }
  }

  component AppGrid(list, columns, iconSize) {
    Grid {
      columns: columns
      gap: 14
      for a in list key a.key {
        Column {
          gap: 5
          align: center
          onTap: open(a.key)
          Image { src: a.icon; size: iconSize }
          Text { text: lower(a.name); font: mono; fontSize: 11; align: center; maxLines: 1 }
        }
      }
    }
  }

  component Apps(full = false) {
    Column {
      fill: true
      gap: 10
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: (full || focused == "apps") ? accent : ink
      clip: true
      onTap: focused = "apps"
      Row {
        align: center
        Text { text: full ? str.apps : str.recent; font: mono; fontSize: 12; color: muted; weight: 1 }
        Text { text: str.all; font: mono; fontSize: 12; color: accent; onTap: launcher("drawer") }
      }
      Column {
        scroll: true
        weight: 1
        AppGrid { list: full ? top.take(16) : sideApps; columns: full ? (wide ? 6 : 4) : 2; iconSize: full ? 52 : 44 }
      }
    }
  }

  component Notes() {
    Column {
      fill: true
      gap: 8
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: accent
      clip: true
      Row {
        align: center
        Text { text: str.notifications; font: mono; fontSize: 12; color: muted; weight: 1 }
        if n.available && n.count > 0 {
          Text { text: "${n.count}"; font: mono; fontSize: 12; color: accent }
        }
      }
      if !n.available {
        Text { text: str.allow; font: mono; fontSize: 14; color: accent; onTap: notification("open", "") }
      } else if n.count == 0 {
        Text { text: str.allClear; font: mono; fontSize: 14; color: muted }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 2
          for item in n.items.take(20) key item.key {
            Row {
              gap: 10
              align: center
              padding: [0, 6]
              onTap: notification("open", item.key)
              onLongPress: { haptic(); notification("dismiss", item.key) }
              Image { src: item.icon; size: 28 }
              Column {
                gap: 0
                weight: 1
                Text { text: item.title; font: mono; fontSize: 13; maxLines: 1 }
                let age = abs(now - item.time)
                Text { text: "${lower(item.app)} · ${age < 60 ? str.now : age < 3600 ? str.minutes(floor(age / 60)) : age < 86400 ? str.hours(floor(age / 3600)) : age < 604800 ? str.days(floor(age / 86400)) : age < 31536000 ? str.weeks(floor(age / 604800)) : str.years(floor(age / 31536000))}"; font: mono; fontSize: 11; color: muted; maxLines: 1 }
              }
            }
          }
        }
      }
    }
  }

  component Agents() {
    Column {
      fill: true
      gap: 8
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: accent
      clip: true
      Row {
        align: center
        Text { text: str.agents; font: mono; fontSize: 12; color: muted; weight: 1 }
        Text { text: str.manage; font: mono; fontSize: 12; color: accent; onTap: launcher("agents") }
      }
      if len(ag.installed ?? []) == 0 {
        Text { text: str.noAgent; font: mono; fontSize: 14; color: muted; onTap: launcher("agents") }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 4
          for a in ag.installed key a.key {
            Row {
              gap: 10
              align: center
              padding: [0, 6]
              onTap: open(a.key)
              if a.icon != null { Image { src: a.icon; size: 28 } }
              Column {
                gap: 0
                weight: 1
                Text { text: a.name; font: mono; fontSize: 14; color: ag.default != null && a.key == ag.default.key ? accent : foreground; maxLines: 1 }
                if a.description != null && a.description != "" {
                  Text { text: a.description; font: mono; fontSize: 11; color: muted; maxLines: 2 }
                }
              }
            }
          }
        }
      }
    }
  }

  component Desk() {
    Column {
      fill: true
      gap: gap
      Fetch {}
      Row {
        gap: gap
        weight: 1
        fill: width
        Commits { weight: 1; fill: true }
        Apps { weight: 1; fill: true }
      }
    }
  }

  Column {
    fill: true
    gap: 0

    // The bar. Logo opens the style screen, the way the Omarchy mark opens its menu.
    Row {
      align: center
      padding: [10, 6]
      background: background
      Row {
        width: 132
        gap: 0
        align: center
        Text { text: "●"; fontSize: 10; color: accent; width: 14; align: center; onTap: launcher("style") }
        Ws { n: 1 }
        Ws { n: 2 }
        Ws { n: 3 }
        Ws { n: 4 }
        Ws { n: 5 }
      }
      Spacer { weight: 1 }
      Text { text: fmtTime(now, str.bar); font: mono; fontSize: 13; maxLines: 1 }
      Spacer { weight: 1 }
      Row {
        width: 132
        gap: 8
        align: center
        justify: end
        if modes.dnd { Text { text: str.dnd; font: mono; fontSize: 12; color: yellow } }
        Text {
          text: bat == null ? null : "${bat.level}%"
          font: mono
          fontSize: 13
          color: bat.charging ? green : bat.level <= 15 ? red : bat.level <= 30 ? yellow : foreground
        }
      }
    }

    if playing {
      Row {
        gap: 8
        align: center
        padding: [12, 5]
        background: background
        onTap: media("toggle")
        Text { text: m.playing == true ? "▶" : "⏸"; font: mono; fontSize: 11; color: accent }
        Text { text: "${m.artist ?? lower(m.app ?? "")} — ${m.title}"; font: mono; fontSize: 12; color: muted; maxLines: 1; weight: 1 }
      }
    }

    Column {
      weight: 1
      fill: width
      gap: gap
      padding: 10
      if ws == 1 {
        Desk { fill: true }
      } else if ws == 2 {
        Apps { full: true; fill: true }
      } else if ws == 3 {
        Commits { full: true; fill: true }
      } else if ws == 4 {
        Notes { fill: true }
      } else {
        Agents { fill: true }
      }
    }

    Spacer { height: screenInset }
  }
}
