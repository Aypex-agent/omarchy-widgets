face "control" {
  // Mission control: the phone and its Linux at a glance, and the means to act on both.
  // Gauges and history up top, a panel of processes, network, a shell, a live terminal and the inbox,
  // the phone's switches, recent apps, and a prompt bar that asks your agent (or runs "!command").

  meta {
    owl: 23
    description: "Mission control: live CPU, memory, storage and latency, processes you can kill, a shell, a terminal, your inbox, phone switches and an agent prompt"
    version: "1.3"
    license: "MIT"
    category: "system"
  }

  // What it says, in the phone's language where it has a set. Day and month names come from the phone; wttr names
  // the sky in English, so other languages name it from wttr's codes. Commands, processes, interfaces, apps and
  // notifications come as they are.
  strings {
    en {
      day: "EEEE d MMMM"; sky: (code, desc) => lower(trim(desc))
      up: d => "up ${d}"; updates: n => n == 1 ? "↑ 1 update" : "↑ ${n} updates"; dnd: "dnd"; saver: "saver"; ringer: r => r
      mem: "MEM"; disk: "DISK"; bat: "BAT"; cores: n => "${n} cores"; free: b => "${b} free"; word: w => w
      cpu3m: "CPU 3M"; offline: "offline"
      procs: "procs"; net: "net"; term: "term"; inbox: "inbox"; inboxN: n => "inbox ${n}"
      process: "PROCESS"; running: n => "${n} running"; off: "off"; endHint: "tap a process to end it"
      latency: "LATENCY MS"; stats: (lo, mean, hi) => "min ${lo} · avg ${mean} · max ${hi}"; measuring: "measuring…"
      public: "PUBLIC"; interfaces: "INTERFACES"
      command: "run a command…"; busy: "running…"; outputHint: "output shows here. long-press a saved command to forget it."
      termHint: "tap to type · tap outside or Back to let go"
      allowHint: "allow notification access to see them here"; allow: "allow"; inboxZero: "inbox zero"
      openHint: "tap to open · hold to dismiss"
      now: "now"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}w"; years: n => "${n}y"
      runOnly: "!command to run"; ask: a => "ask ${a} · !command to run"
    }
    id {
      day: "EEEE, d MMMM"
      sky: (code, desc) => get({
        "113": "cerah", "116": "cerah berawan", "119": "berawan", "122": "mendung", "143": "kabut tipis",
        "176": "hujan lokal", "179": "salju lokal", "182": "hujan salju lokal", "185": "gerimis beku lokal",
        "200": "badai petir", "227": "salju tertiup angin", "230": "badai salju", "248": "kabut", "260": "kabut beku",
        "263": "gerimis ringan lokal", "266": "gerimis ringan", "281": "gerimis beku", "284": "gerimis beku lebat",
        "293": "hujan ringan lokal", "296": "hujan ringan", "299": "kadang hujan sedang", "302": "hujan sedang",
        "305": "kadang hujan lebat", "308": "hujan lebat", "311": "hujan beku ringan", "314": "hujan beku lebat",
        "317": "hujan salju ringan", "320": "hujan salju lebat", "323": "salju ringan lokal", "326": "salju ringan",
        "329": "salju sedang lokal", "332": "salju sedang", "335": "salju lebat lokal", "338": "salju lebat",
        "350": "butiran es", "353": "hujan ringan sesaat", "356": "hujan lebat sesaat", "359": "hujan deras",
        "362": "hujan salju ringan sesaat", "365": "hujan salju lebat sesaat", "368": "salju ringan sesaat",
        "371": "salju lebat sesaat", "374": "butiran es ringan", "377": "butiran es lebat",
        "386": "hujan ringan berpetir", "389": "hujan lebat berpetir", "392": "salju ringan berpetir",
        "395": "salju lebat berpetir"
      }, code, lower(trim(desc)))
      up: d => "aktif ${d}"; updates: n => "↑ ${n} pembaruan"; dnd: "jangan ganggu"; saver: "hemat daya"
      ringer: r => get({"vibrate": "getar", "silent": "senyap"}, r, r)
      mem: "RAM"; disk: "DISK"; bat: "BAT"; cores: n => "${n} inti"; free: b => "sisa ${b}"
      word: w => get({
        "charging": "mengisi", "plugged in": "tercolok", "on battery": "tanpa cas", "good": "baik",
        "overheating": "kepanasan", "dead": "tidak berfungsi", "over voltage": "tegangan berlebih", "cold": "dingin",
        "failing": "bermasalah", "wireless": "nirkabel", "dock": "dok"
      }, w, w)
      cpu3m: "CPU 3 MNT"; offline: "offline"
      procs: "proses"; net: "jaringan"; term: "terminal"; inbox: "notif"; inboxN: n => "notif ${n}"
      process: "PROSES"; running: n => "${n} berjalan"; off: "mati"; endHint: "ketuk proses untuk mengakhirinya"
      latency: "LATENSI MS"; stats: (lo, mean, hi) => "min ${lo} · rerata ${mean} · maks ${hi}"; measuring: "mengukur…"
      public: "IP PUBLIK"; interfaces: "ANTARMUKA"
      command: "jalankan perintah…"; busy: "berjalan…"; outputHint: "keluaran muncul di sini. tekan lama perintah tersimpan untuk melupakannya."
      termHint: "ketuk untuk mengetik · ketuk di luar atau Kembali untuk melepas"
      allowHint: "izinkan akses notifikasi untuk melihatnya di sini"; allow: "izinkan"; inboxZero: "semua sudah dibaca"
      openHint: "ketuk untuk membuka · tahan untuk menutup"
      now: "kini"; minutes: n => "${n}m"; hours: n => "${n}j"; days: n => "${n}h"; weeks: n => "${n}mg"; years: n => "${n}th"
      runOnly: "!perintah untuk dijalankan"; ask: a => "tanya ${a} · !perintah"
    }
    es {
      day: "EEEE d 'de' MMMM"
      sky: (code, desc) => get({
        "113": "despejado", "116": "parcialmente nublado", "119": "nublado", "122": "cubierto", "143": "neblina",
        "176": "lluvia dispersa", "179": "nieve dispersa", "182": "aguanieve dispersa", "185": "llovizna helada dispersa",
