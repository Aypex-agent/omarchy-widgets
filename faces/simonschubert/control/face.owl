      latency: "LATÊNCIA MS"; stats: (lo, mean, hi) => "mín ${lo} · média ${mean} · máx ${hi}"; measuring: "medindo…"
      public: "IP PÚBLICO"; interfaces: "INTERFACES"
      command: "execute um comando…"; busy: "executando…"; outputHint: "a saída aparece aqui. toque e segure um comando salvo para esquecê-lo."
      termHint: "toque para digitar · toque fora ou Voltar para sair"
      allowHint: "permita o acesso às notificações para vê-las aqui"; allow: "permitir"; inboxZero: "tudo em dia"
      openHint: "toque para abrir · segure para dispensar"
      now: "agora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}sem"; years: n => "${n}a"
      runOnly: "!comando para executar"; ask: a => "pergunte a ${a} · !comando"
    }
