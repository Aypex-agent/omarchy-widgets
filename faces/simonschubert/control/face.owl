        "386": "lluvia ligera con truenos", "389": "lluvia fuerte con truenos", "392": "nieve ligera con truenos",
        "395": "nieve fuerte con truenos"
      }, code, lower(trim(desc)))
      up: d => "uptime ${d}"; updates: n => n == 1 ? "↑ 1 actualización" : "↑ ${n} actualizaciones"; dnd: "no molestar"; saver: "ahorro"
      ringer: r => get({"vibrate": "vibración", "silent": "silencio"}, r, r)
      mem: "RAM"; disk: "DISCO"; bat: "BAT"; cores: n => "${n} núcleos"; free: b => "${b} libres"
      word: w => get({
        "charging": "cargando", "plugged in": "conectado", "on battery": "desconectado", "good": "buena",
        "overheating": "sobrecalentada", "dead": "inservible", "over voltage": "sobrevoltaje", "cold": "fría",
        "failing": "fallando", "wireless": "inalámbrica", "dock": "base"
      }, w, w)
      cpu3m: "CPU 3 MIN"; offline: "sin red"
      procs: "procesos"; net: "red"; term: "terminal"; inbox: "avisos"; inboxN: n => "avisos ${n}"
      process: "PROCESO"; running: n => "${n} activos"; off: "desactivada"; endHint: "toca un proceso para cerrarlo"
      latency: "LATENCIA MS"; stats: (lo, mean, hi) => "mín ${lo} · media ${mean} · máx ${hi}"; measuring: "midiendo…"
      public: "IP PÚBLICA"; interfaces: "INTERFACES"
      command: "ejecuta un comando…"; busy: "ejecutando…"; outputHint: "la salida aparece aquí. mantén pulsado un comando guardado para olvidarlo."
      termHint: "toca para escribir · toca fuera o Atrás para salir"
      allowHint: "permite el acceso a las notificaciones para verlas aquí"; allow: "permitir"; inboxZero: "todo al día"
      openHint: "toca para abrir · mantén para descartar"
      now: "ahora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; weeks: n => "${n}sem"; years: n => "${n}a"
      runOnly: "!comando para ejecutar"; ask: a => "pregunta a ${a} · !comando"
    }
    pt {
      day: "EEEE, d 'de' MMMM"
      sky: (code, desc) => get({
        "113": "céu limpo", "116": "parcialmente nublado", "119": "nublado", "122": "encoberto", "143": "névoa",
