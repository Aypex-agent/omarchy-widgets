face "minarchy" {
  // Distraction-free home page inspired by Olauncher. Heavily edited version based on minimal by Simon Schubert.

  meta { owl: 13; description: "Olauncher-inspired minimalist home page (based on minimal by Simon Schubert) with a customizable text app list, custom app renaming & emojis, settings sheet, and 20 languages"; version: "1.2"; license: "MIT"; category: "productivity" }
  requires { pacman: ["ttf-jetbrains-mono"] }

  state showStatusBar = false persist
  statusBar: showStatusBar

  source now = clock every 1m
  source bat = android.battery
  source alarm = android.alarm
  source n = android.notifications
  source apps = android.apps

  state slots = null persist
  state renames = {} persist
  state actionSlot = null
  state renamingSlot = null
  state renameText = ""
  state pickerSlot = null
  state search = ""
  state showSettings = false
  state showLangDropdown = false
  state langSearch = ""
  state scrollY = 0
  state pullDrawer = 0

  // Settings states
  state lang = "Auto" persist
  state fontPref = {} persist
  state showHeader = true persist
  state showTime = true persist
  state showDate = true persist
  state showBattery = true persist
  state clockFormat = "12-hour (AM/PM)" persist
  state appAlignment = "Left" persist
  state boldFont = false persist
  state textSize = 1.0 persist
  state appSpacing = "Normal" persist

  // Multi-language support (20 widely used languages + Auto detection)
  let langMeta = split("en:English:en|es:Español:Spanish|fr:Français:French|de:Deutsch:German|zh:简体中文:Simplified Chinese|it:Italiano:Italian|pt:Português:Portuguese|nl:Nederlands:Dutch|pl:Polski:Polish|tr:Türkçe:Turkish|ru:Русский:Russian|uk:Українська:Ukrainian|sv:Svenska:Swedish|id:Indonesia:Indonesian|vi:Tiếng Việt:Vietnamese|el:Ελληνικά:Greek|ja:日本語:Japanese|ko:한국어:Korean|ar:العربية:Arabic|hi:हिन्दी:Hindi", "|").map(s => split(s, ":"))
  let sysStamp = fmtTime(0, "MMMM EEEE", "UTC")
  let detected = langMeta.find(m => fmtTime(0, "MMMM EEEE", "UTC", m[0]) == sysStamp) ?? langMeta[0]
  let activeEntry = (lang == "Auto" ? null : langMeta.find(m => m[0] == lang)) ?? detected
  let activeLang = activeEntry[0]
  let langList = [{id: "Auto", name: "Auto (${detected[1]})", alias: "System default auto"}] + langMeta.map(m => {id: m[0], name: m[1], alias: "${m[2]} ${m[0]}"})
  let filteredLangs = trim(langSearch) != "" ? rank(langList, langSearch) : langList

  let i18n = {
    en: split("ADD APP|search|settings|+ app|Change App|Rename|minarchy settings|Remove from home|Rename App|App name or emoji|Cancel|Save|Add App|Search...|Done|distraction-free home for omalauncher|Layout|Show header|Show time|Show date|Show battery|Time format|App alignment|Appearance|Wallpaper & Theme style|Open ❯|Notification bar|Bold font|Text size|On|Off|Left|Center|Right|Language|Font not supported|JetBrains Mono doesn't support this language. Download a similar font or use the system font?|System font|Download|App spacing|Compact|Normal|Spacious|Extra Spacious", "|"),
    es: split("AÑADIR APP|buscar|ajustes|+ app|Cambiar app|Renombrar|ajustes de minarchy|Quitar de inicio|Renombrar app|Nombre o emoji|Cancelar|Guardar|Añadir app|Buscar...|Listo|inicio sin distracciones para omalauncher|Diseño|Mostrar encabezado|Mostrar hora|Mostrar fecha|Mostrar batería|Formato de hora|Alineación|Apariencia|Fondo y estilo|Abrir ❯|Barra de estado|Letra en negrita|Tamaño de texto|Sí|No|Izquierda|Centro|Derecha|Idioma|Fuente no compatible|JetBrains Mono no admite este idioma. ¿Descargar una fuente similar o usar la del sistema?|Fuente del sistema|Descargar|Espaciado|Compacto|Normal|Espacioso|Muy espacioso", "|"),
    fr: split("AJOUTER|chercher|réglages|+ app|Changer d'app|Renommer|réglages minarchy|Retirer de l'accueil|Renommer l'app|Nom ou émoji|Annuler|Enregistrer|Ajouter une app|Rechercher...|OK|accueil sans distraction pour omalauncher|Disposition|Afficher l'en-tête|Afficher l'heure|Afficher la date|Afficher la batterie|Format de l'heure|Alignement|Apparence|Fond et thème|Ouvrir ❯|Barre d'état|Police grasse|Taille du texte|Oui|Non|Gauche|Centre|Droite|Langue|Police non prise en charge|JetBrains Mono ne prend pas en charge cette langue. Télécharger une police similaire ou utiliser celle du système ?|Police système|Télécharger|Espacement|Compact|Normal|Spacieux|Très spacieux", "|"),
    de: split("APP HINZUFÜGEN|suche|einstellungen|+ app|App ändern|Umbenennen|minarchy-Einstellungen|Vom Startbildschirm entfernen|App umbenennen|App-Name oder Emoji|Abbrechen|Speichern|App hinzufügen|Suchen...|Fertig|ablenkungsfreier Startbildschirm für omalauncher|Layout|Kopfzeile anzeigen|Uhrzeit anzeigen|Datum anzeigen|Akku anzeigen|Zeitformat|App-Ausrichtung|Darstellung|Hintergrund & Themenstil|Öffnen ❯|Statusleiste|Fettschrift|Textgröße|Ein|Aus|Links|Mitte|Rechts|Sprache|Schriftart nicht unterstützt|JetBrains Mono unterstützt diese Sprache nicht. Ähnliche Schriftart herunterladen oder Systemschrift verwenden?|Systemschrift|Herunterladen|Abstand|Kompakt|Normal|Weit|Sehr weit", "|"),
    zh: split("添加应用|搜索|设置|+ 应用|更换应用|重命名|minarchy 设置|从主屏幕移除|重命名应用|应用名称或表情符号|取消|保存|添加应用|搜索...|完成|omalauncher 专用的极简无干扰主屏幕|布局|显示顶栏|显示时间|显示日期|显示电量|时间格式|应用对齐|外观|壁纸与主题样式|打开 ❯|状态栏|粗体字|文字大小|开|关|居左|居中|居右|语言|主字体不支持|主字体 (JetBrains Mono) 不支持当前语言。是否下载相似字体，或使用系统默认字体？|系统默认|下载字体|应用间距|紧凑|标准|宽松|超宽松", "|"),
    it: split("AGGIUNGI APP|cerca|impostazioni|+ app|Cambia app|Rinomina|impostazioni minarchy|Rimuovi da home|Rinomina app|Nome o emoji|Annulla|Salva|Aggiungi app|Cerca...|Fatto|home senza distrazioni per omalauncher|Layout|Mostra intestazione|Mostra ora|Mostra data|Mostra batteria|Formato ora|Allineamento|Aspetto|Sfondo e stile|Apri ❯|Barra di stato|Grassetto|Dimensione testo|Sì|No|Sinistra|Centro|Destra|Lingua|Font non supportato|JetBrains Mono non supporta questa lingua. Scaricare un font simile o usare quello di sistema?|Font di sistema|Scarica|Spaziatura|Compatto|Normale|Ampio|Molto ampio", "|"),
    pt: split("ADICIONAR APP|buscar|ajustes|+ app|Trocar app|Renomear|ajustes do minarchy|Remover do início|Renomear app|Nome ou emoji|Cancelar|Salvar|Adicionar app|Buscar...|Concluído|início sem distrações para omalauncher|Layout|Mostrar cabeçalho|Mostrar hora|Mostrar data|Mostrar bateria|Formato da hora|Alinhamento|Aparência|Papel de parede e estilo|Abrir ❯|Barra de status|Fonte em negrito|Tamanho do texto|Sim|Não|Esquerda|Centro|Direita|Idioma|Fonte não suportada|JetBrains Mono não suporta este idioma. Baixar uma fonte similar ou usar a padrão do sistema?|Fonte do sistema|Baixar|Espaçamento|Compacto|Normal|Espaçoso|Muito espaçoso", "|"),
    nl: split("APP TOEVOEGEN|zoeken|instellingen|+ app|App wijzigen|Hernoemen|minarchy-instellingen|Verwijderen van start|App hernoemen|App-naam of emoji|Annuleren|Opslaan|App toevoegen|Zoeken...|Klaar|afleidingsvrij startscherm voor omalauncher|Indeling|Koptekst tonen|Tijd tonen|Datum tonen|Batterij tonen|Tijdnotatie|Uitlijning|Weergave|Achtergrond & stijl|Openen ❯|Statusbalk|Vetgedrukt|Tekstgrootte|Aan|Uit|Links|Midden|Rechts|Taal|Lettertype niet ondersteund|JetBrains Mono ondersteunt deze taal niet. Een vergelijkbaar lettertype downloaden of systeemlettertype gebruiken?|Systeemlettertype|Downloaden|Afstand|Compact|Normaal|Ruim|Zeer ruim", "|"),
    pl: split("DODAJ APKĘ|szukaj|ustawienia|+ apka|Zmień aplikację|Zmień nazwę|ustawienia minarchy|Usuń z ekranu|Zmień nazwę|Nazwa lub emoji|Anuluj|Zapisz|Dodaj aplikację|Szukaj...|Gotowe|ekran główny bez rozpraszaczy dla omalauncher|Układ|Pokaż nagłówek|Pokaż czas|Pokaż datę|Pokaż baterię|Format czasu|Wyrównanie|Wygląd|Tapeta i styl|Otwórz ❯|Pasek stanu|Pogrubiona czcionka|Rozmiar tekstu|Wł.|Wył.|Do lewej|Wyśrodkuj|Do prawej|Język|Nieobsługiwana czcionka|JetBrains Mono nie obsługuje tego języka. Pobrać podobną czcionkę czy użyć systemowej?|Czcionka systemowa|Pobierz|Odstępy|Kompaktowe|Normalne|Przestronne|Bardzo przestronne", "|"),
    tr: split("UYGULAMA EKLE|ara|ayarlar|+ ekle|Uygulamayı değiştir|Yeniden adlandır|minarchy ayarları|Ana ekrandan kaldır|Yeniden adlandır|Ad veya emoji|İptal|Kaydet|Uygulama ekle|Ara...|Bitti|omalauncher için sade ana ekran|Düzen|Başlığı göster|Saati göster|Tarihi göster|Pili göster|Saat biçimi|Hizalama|Görünüm|Duvar kağıdı ve stil|Aç ❯|Durum çubuğu|Kalın yazı tipi|Metin boyutu|Açık|Kapalı|Sol|Orta|Sağ|Dil|Yazı tipi desteklenmiyor|JetBrains Mono bu dili desteklemiyor. Benzer bir yazı tipi indirilsin mi yoksa sistem yazı tipi mi kullanılsın?|Sistem yazı tipi|İndir|Boşluk|Sıkışık|Normal|Geniş|Çok geniş", "|"),
    ru: split("ДОБАВИТЬ|поиск|настройки|+ прил.|Сменить приложение|Переименовать|настройки minarchy|Убрать с экрана|Переименовать|Имя или эмодзи|Отмена|Сохранить|Добавить приложение|Поиск...|Готово|минималистичный экран для omalauncher|Макет|Показать шапку|Показать время|Показать дату|Показать заряд|Формат времени|Выравнивание|Внешний вид|Обои и стиль темы|Открыть ❯|Строка состояния|Жирный шрифт|Размер текста|Вкл|Выкл|Слева|По центру|Справа|Язык|Шрифт не поддерживается|JetBrains Mono не поддерживает этот язык. Скачать похожий шрифт или использовать системный?|Системный шрифт|Скачать|Интервал|Компактный|Обычный|Просторный|Очень просторный", "|"),
    uk: split("ДОДАТИ|пошук|налаштування|+ дод.|Змінити додаток|Перейменувати|налаштування minarchy|Прибрати з екрана|Перейменувати|Назва або емодзі|Скасувати|Зберегти|Додати додаток|Пошук...|Готово|мінімалістичний екран для omalauncher|Макет|Показати шапку|Показати час|Показати дату|Показати заряд|Формат часу|Вирівнювання|Вигляд|Шпалери та стиль|Відкрити ❯|Рядок стану|Жирний шрифт|Розмір тексту|Увімк.|Вимк.|Ліворуч|По центру|Праворуч|Мова|Шрифт не підтримується|JetBrains Mono не підтримує цю мову. Завантажити схожий шрифт чи використати системний?|Системний шрифт|Завантажити|Інтервал|Компактний|Звичайний|Просторий|Дуже просторий", "|"),
    sv: split("LÄGG TILL APP|sök|inställningar|+ app|Byt app|Byt namn|minarchy-inställningar|Ta bort från hem|Byt namn på app|Appnamn eller emoji|Avbryt|Spara|Lägg till app|Sök...|Klar|distraktionsfri hemskärm för omalauncher|Layout|Visa sidhuvud|Visa tid|Visa datum|Visa batteri|Tidsformat|Justering|Utseende|Bakgrund & stil|Öppna ❯|Statusfält|Fetstil|Textstorlek|På|Av|Vänster|Mitten|Höger|Språk|Typsnitt stöds inte|JetBrains Mono stöder inte detta språk. Ladda ner ett liknande typsnitt eller använda systemets?|Systemtypsnitt|Ladda ner|Mellanrum|Kompakt|Normal|Luftig|Mycket luftig", "|"),
    id: split("TAMBAH APLIKASI|cari|pengaturan|+ app|Ganti Aplikasi|Ubah Nama|pengaturan minarchy|Hapus dari beranda|Ubah Nama Aplikasi|Nama atau emoji|Batal|Simpan|Tambah Aplikasi|Cari...|Selesai|beranda bebas gangguan untuk omalauncher|Tata Letak|Tampilkan header|Tampilkan waktu|Tampilkan tanggal|Tampilkan baterai|Format waktu|Perataan aplikasi|Tampilan|Wallpaper & gaya tema|Buka ❯|Bilah status|Huruf tebal|Ukuran teks|Aktif|Nonaktif|Kiri|Tengah|Kanan|Bahasa|Font tidak didukung|JetBrains Mono tidak mendukung bahasa ini. Unduh font serupa atau gunakan font sistem?|Font sistem|Unduh|Jarak|Rapat|Normal|Renggang|Sangat renggang", "|"),
    vi: split("THÊM ỨNG DỤNG|tìm|cài đặt|+ thêm|Đổi ứng dụng|Đổi tên|cài đặt minarchy|Xóa khỏi màn hình|Đổi tên ứng dụng|Tên hoặc emoji|Hủy|Lưu|Thêm ứng dụng|Tìm...|Xong|màn hình chính tối giản cho omalauncher|Bố cục|Hiện đầu trang|Hiện giờ|Hiện ngày|Hiện pin|Định dạng giờ|Căn chỉnh|Giao diện|Hình nền & chủ đề|Mở ❯|Thanh trạng thái|Chữ đậm|Cỡ chữ|Bật|Tắt|Trái|Giữa|Phải|Ngôn ngữ|Không hỗ trợ phông chữ|JetBrains Mono không hỗ trợ ngôn ngữ này. Tải phông chữ tương tự hay dùng phông hệ thống?|Phông hệ thống|Tải xuống|Khoảng cách|Thu gọn|Bình thường|Rộng rãi|Rất rộng rãi", "|"),
    el: split("ΠΡΟΣΘΗΚΗ|αναζήτηση|ρυθμίσεις|+ εφαρμ.|Αλλαγή εφαρμογής|Μετονομασία|ρυθμίσεις minarchy|Αφαίρεση από αρχική|Μετονομασία|Όνομα ή emoji|Ακύρωση|Αποθήκευση|Προσθήκη εφαρμογής|Αναζήτηση...|Τέλος|αρχική χωρίς περισπασμούς για το omalauncher|Διάταξη|Εμφάνιση κεφαλίδας|Εμφάνιση ώρας|Εμφάνιση ημερομηνίας|Εμφάνιση μπαταρίας|Μορφή ώρας|Στοίχιση|Εμφάνιση|Ταπετσαρία & στυλ|Άνοιγμα ❯|Γραμμή κατάστασης|Έντονη γραφή|Μέγεθος κειμένου|Ναι|Όχι|Αριστερά|Κέντρο|Δεξιά|Γλώσσα|Μη υποστηριζόμενη γραμματοσειρά|Το JetBrains Mono δεν υποστηρίζει αυτή τη γλώσσα. Λήψη παρόμοιας γραμματοσειράς ή χρήση συστήματος;|Γραμματοσειρά συστήματος|Λήψη|Διάστιχο|Συμπαγές|Κανονικό|Ευρύχωρο|Πολύ ευρύχωρο", "|"),
    ja: split("アプリを追加|検索|設定|+ 追加|アプリを変更|名前を変更|minarchy 設定|ホームから削除|アプリ名を変更|名前または絵文字|キャンセル|保存|アプリを追加|検索...|完了|omalauncher 用のミニマルなホーム画面|レイアウト|ヘッダーを表示|時刻を表示|日付を表示|バッテリーを表示|時刻表示|アプリの配置|外観|壁纸とテーマスタイル|開く ❯|ステータスバー|太字フォント|文字サイズ|オン|オフ|左揃え|中央|右揃え|言語|フォント非対応|メインフォント(JetBrains Mono)はこの言語に対応していません。類似フォントをダウンロードしますか？|システム標準|ダウンロード|アプリの間隔|コンパクト|標準|広め|とても広め", "|"),
    ko: split("앱 추가|검색|설정|+ 앱|앱 변경|이름 변경|minarchy 설정|홈에서 제거|앱 이름 변경|앱 이름 또는 이모지|취소|저장|앱 추가|검색...|완료|omalauncher를 위한 미니멀 홈 화면|레이아웃|헤더 표시|시간 표시|날짜 표시|배터리 표시|시간 형식|앱 정렬|모양|배경화면 및 테마 스타일|열기 ❯|상태 표시줄|굵은 글꼴|글자 크기|켜짐|꺼짐|왼쪽|가운데|오른쪽|언어|기본 글꼴 미지원|기본 글꼴(JetBrains Mono)이 현재 언어를 지원하지 않습니다. 유사한 글꼴을 다운로드할까요, 아니면 시스템 글꼴을 사용할까요?|시스템 기본값|다운로드|앱 간격|좁게|보통|넓게|아주 넓게", "|"),
    ar: split("إضافة تطبيق|بحث|الإعدادات|+ تطبيق|تغيير التطبيق|إعادة تسمية|إعدادات minarchy|إزالة من الرئيسية|إعادة تسمية التطبيق|اسم أو رمز تعبيري|إلغاء|حفظ|إضافة تطبيق|بحث...|تم|شاشة رئيسية خالية من التشتيت لـ omalauncher|التخطيط|إظهار الرأس|إظهار الوقت|إظهار التاريخ|إظهار البطارية|تنسيق الوقت|محاذاة التطبيقات|المظهر|الخلفية ونمط السمة|فتح ❯|شريط الحالة|خط عريض|حجم النص|مفعل|متوقف|يسار|وسط|يمين|اللغة|الخط الأساسي غير مدعوم|خط JetBrains Mono لا يدعم هذه اللغة. هل تريد تنزيل خط مشابه أم استخدام خط النظام الافتراضي؟|خط النظام|تنزيل|تباعد التطبيقات|مضغوط|عادي|واسع|واسع جداً", "|"),
    hi: split("ऐप जोड़ें|खोजें|सेटिंग्स|+ ऐप|ऐप बदलें|नाम बदलें|minarchy सेटिंग्स|होम से हटाएं|ऐप का नाम बदलें|ऐप का नाम या इमोजी|रद्द करें|सहेजें|ऐप जोड़ें|खोजें...|पूर्ण|omalauncher के लिए ध्यान-भंग मुक्त होम स्क्रीन|लेआउट|हेडर दिखाएं|समय दिखाएं|तारीख दिखाएं|बैटरी दिखाएं|समय प्रारूप|ऐप संरेखण|दिखावट|वॉलपेपर और थीम शैली|खोलें ❯|स्टेटस बार|बोल्ड फ़ॉन्ट|टेक्स्ट का आकार|चालू|बंद|बाएं|बीच में|दाएं|भाषा|प्राथमिक फ़ॉन्ट समर्थित नहीं है|JetBrains Mono इस भाषा का समर्थन नहीं करता है। क्या समान फ़ॉन्ट डाउनलोड करें या सिस्टम डिफ़ॉल्ट का उपयोग करें?|सिस्टम डिफ़ॉल्ट|डाउनलोड करें|ऐप रिक्ति|संक्षिप्त|सामान्य|खुला|अति खुला", "|")
  }
  let t = i18n[activeLang] ?? i18n.en

  // Alternative fonts for scripts not covered by JetBrains Mono (only downloaded if user selects Download)
  let altFontUrls = {
    ja: "https://raw.githubusercontent.com/google/fonts/main/ofl/mplus1code/MPLUS1Code%5Bwght%5D.ttf",
    zh: "https://raw.githubusercontent.com/google/fonts/main/ofl/zcoolxiaowei/ZCOOLXiaoWei-Regular.ttf",
    ko: "https://raw.githubusercontent.com/google/fonts/main/ofl/nanumgothiccoding/NanumGothicCoding-Regular.ttf",
    ar: "https://raw.githubusercontent.com/google/fonts/main/ofl/ibmplexsansarabic/IBMPlexSansArabic-Regular.ttf",
    hi: "https://raw.githubusercontent.com/google/fonts/main/ofl/notosansdevanagari/NotoSansDevanagari%5Bwdth%2Cwght%5D.ttf"
  }
  let altUrl = altFontUrls[activeLang]
  let needsAltFont = altUrl != null
  let curFontPref = (fontPref ?? {})[activeLang]
  let showFontPrompt = needsAltFont && curFontPref == null
  let jbFont = boldFont ? "/usr/share/fonts/TTF/JetBrainsMono-Bold.ttf" : "/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf"
  let activeFont = needsAltFont ? (curFontPref == "download" ? altUrl : "sans") : jbFont
  let localeArg = lang == "Auto" ? null : activeLang

  // System apps matching
  let clockApp = (apps ?? []).find(a => a.profile == null && (contains(["com.google.android.deskclock", "com.sec.android.app.clockpackage", "com.android.deskclock"], a.package) || contains(lower(a.name), "clock")))
  let calApp = (apps ?? []).find(a => a.profile == null && (contains(["com.google.android.calendar", "com.samsung.android.calendar", "com.android.calendar", "org.fossify.calendar", "ws.xsoh.etar"], a.package) || contains(lower(a.name), "calendar")))

  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let clockRoom = wide ? ((tileWidth ?? 360) - 136) / 2 : (tileWidth ?? 360) - 48

  let phoneApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.dialer", "com.samsung.android.dialer", "com.android.dialer", "org.fossify.phone"], a.package))
  let msgsApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.apps.messaging", "com.samsung.android.messaging", "com.android.mms", "com.android.messaging", "org.fossify.messages"], a.package))
  let topApps = values(groupBy((apps ?? []).filter(a => (!a.system || a.score > 0) && a.package != phoneApp.package && a.package != msgsApp.package).sortBy(a => -a.score), a => a.name)).map(g => g[0].key)
  let defaultSlots = ([phoneApp.key, msgsApp.key].filter(k => k != null) + topApps + ["slot:1", "slot:2", "slot:3", "slot:4", "slot:5", "slot:6"]).take(6)
  let activeSlots = (slots ?? defaultSlots).take(12)

  let allApps = (apps ?? []).filter(a => a.name != null && a.name != "").sortBy(a => lower(a.name))
  let pickerApps = trim(search) != "" ? rank(allApps, search) : allApps

  let textAlignment = appAlignment == "Center" ? "center" : (appAlignment == "Right" ? "end" : "start")
  let alignLabel = appAlignment == "Center" ? t[32] : (appAlignment == "Right" ? t[33] : t[31])
  let appSpacingPad = appSpacing == "Compact" ? 4 : (appSpacing == "Spacious" ? 14 : (appSpacing == "Extra Spacious" ? 20 : 8))
  let spacingLabel = appSpacing == "Compact" ? t[40] : (appSpacing == "Spacious" ? t[42] : (appSpacing == "Extra Spacious" ? t[43] : t[41]))
  let appWeight = boldFont ? 700 : 400
  let appSize = round(26 * textSize)
  let clockText = clockFormat == "24-hour" ? fmtTime(now, "HH:mm", null, localeArg) : (clockFormat == "12-hour" ? fmtTime(now, "h:mm", null, localeArg) : fmtTime(now, "h:mm a", null, localeArg))
  let cjkClockExtra = clockFormat != "24-hour" && clockFormat != "12-hour" && contains(["zh", "ja", "ko"], activeLang) ? 2 : 0
  let clockUnits = max(5, len(clockText) + cjkClockExtra)
  let clockSize = min(round(76 * textSize), floor(clockRoom / (clockUnits * 0.64)))
  let subLine = (showDate ? fmtTime(now, "EEE, d MMM", null, localeArg) : "") + (showDate && showBattery && bat != null ? ", " : "") + (showBattery && bat != null ? "${bat.level}%" : "")
  let headerVisible = showHeader && (showTime || subLine != "")
  let headerH = headerVisible ? (showTime ? round(clockSize * 1.32) : 0) + (subLine != "" ? round(20 * textSize) : 0) + 36 : 0
  let availH = max(120, (tileHeight ?? 800) - (wide ? 128 : 196 + headerH))
  let slotsH = len(activeSlots) * (round(34 * textSize) + (appSpacingPad * 2))
  let maxScroll = max(0, slotsH - availH)
  let needsScroll = maxScroll > 16
  let curY = clamp(scrollY, 0, maxScroll)

  padding: 0

  // The Header: modern digital clock and unified date & battery line
  component Day() {
    Column {
      gap: 4
      fill: width
      align: textAlignment
      onLongPress: {
        haptic()
        showLangDropdown = false
        showSettings = true
      }
      if showTime {
        Text {
          text: clockText
          font: activeFont
          fontSize: clockSize
          fontWeight: appWeight
          letterSpacing: -2
          maxLines: 1
          align: textAlignment
          onTap: {
            if alarm != null && alarm.app != null {
              androidApp(alarm.app)
            } else if clockApp != null {
              androidApp(clockApp.key)
            }
          }
        }
      }
      if subLine != "" {
        Text {
          text: subLine
          font: activeFont
          fontSize: round(15 * textSize)
          fontWeight: appWeight
          color: alpha(foreground, 0.9)
          maxLines: 1
          align: textAlignment
          padding: [2, 0]
          onTap: {
            if showDate {
              if calApp != null {
                androidApp(calApp.key)
              } else {
                url("content://com.android.calendar/time/")
              }
            }
          }
        }
      }
    }
  }

  component SlotItem(slotKey, i) {
    let itemApp = (apps ?? []).find(a => a.key == slotKey || a.package == slotKey)
    let badge = n.available && itemApp != null ? len(n.items.filter(nItem => nItem.package == itemApp.package)) : 0
    let defaultName = itemApp != null ? itemApp.name : t[0]
    let label = (renames ?? {})[slotKey] ?? defaultName

    Text {
      spans: [label, badge > 0 ? {text: "  ${badge}", color: accent, fontSize: 15, fontWeight: 400} : ""]
      font: activeFont
      fontSize: appSize
      fontWeight: appWeight
      letterSpacing: -0.5
      maxLines: 1
      fill: width
      align: textAlignment
      padding: [0, appSpacingPad]
      onTap: {
        if itemApp != null {
          androidApp(itemApp.key)
        } else if contains(slotKey, ".") {
          androidApp(slotKey)
        } else {
          haptic()
          pickerSlot = i
          search = ""
        }
      }
      onLongPress: {
        haptic()
        actionSlot = i
      }
    }
  }

  // The apps as Title Case words, aligned per setting
  component Apps() {
    Column {
      weight: 1
      scroll: needsScroll
      justify: needsScroll ? "start" : "center"
      gap: 0
      fill: width
      clip: true
      align: textAlignment
      if needsScroll {
        Column {
          gap: 0
          fill: width
          align: textAlignment
          offset: [0, -curY]
          animate offset: spring(1.0, 500)
          drag: vertical
          onDrag: {
            if curY < maxScroll - 8 {
              pullDrawer = -1
            }
            if dy < 0 && curY >= maxScroll - 4 && pullDrawer >= 0 {
              pullDrawer = pullDrawer - dy
              if pullDrawer > 36 {
                pullDrawer = -1
                launcher("drawer")
              }
            } else {
              scrollY = clamp(curY - dy, 0, maxScroll)
              if pullDrawer > 0 {
                pullDrawer = max(0, pullDrawer - dy)
              }
            }
          }
          onDragEnd: {
            if pullDrawer > 0 && vy < -250 {
              launcher("drawer")
            } else if pullDrawer < 0 && abs(vy) > 200 {
              scrollY = clamp(scrollY - vy * 0.12, 0, maxScroll)
            }
            pullDrawer = 0
          }
          for k, i in activeSlots key k + ":" + i {
            SlotItem { slotKey: k; i: i }
          }
        }
      } else {
        for k, i in activeSlots key k + ":" + i {
          SlotItem { slotKey: k; i: i }
        }
      }
    }
  }

  // Bottom action bar
  component BottomBar() {
    Row {
      fill: width
      align: center
      Text { text: t[1]; font: activeFont; fontSize: 13; letterSpacing: 2; color: alpha(foreground, 0.45); padding: [6, 12]; onTap: launcher("drawer") }
      Spacer { weight: 1 }
      Text {
        text: t[2]
        font: activeFont
        fontSize: 13
        letterSpacing: 2
        color: alpha(foreground, 0.45)
        padding: [6, 12]
        onTap: {
          haptic()
          showLangDropdown = false
          showSettings = true
        }
      }
      if len(activeSlots) < 12 {
        Spacer { weight: 1 }
        Text {
          text: t[3]
          font: activeFont
          fontSize: 13
          letterSpacing: 2
          color: alpha(foreground, 0.45)
          padding: [6, 12]
          onTap: {
            haptic()
            pickerSlot = -1
            search = ""
          }
        }
      }
    }
  }

  // Divider line
  component Sep() {
    Spacer { height: 1; fill: width; background: alpha(border, 0.2) }
  }

  // Popup when primary font (JetBrains Mono) does not support the active language's script
  component FontModal() {
    Column {
      fill: true
      padding: wide ? [40, 24] : [36, 24]
      Spacer { weight: 1 }
      Column {
        fill: width
        background: alpha(surface, 0.96)
        border: 1
        borderColor: alpha(border, 0.6)
        radius: 16 * corners
        padding: [20, 20]
        gap: 14
        Text { text: t[35]; fontSize: 18; fontWeight: 600 }
        Text { text: t[36]; fontSize: 14; color: alpha(foreground, 0.85) }
        Row {
          fill: width
          align: center
          Text {
            text: t[37]
            fontSize: 14
            color: muted
            padding: [6, 10]
            onTap: {
              haptic()
              fontPref = set(fontPref ?? {}, activeLang, "system")
            }
          }
          Spacer { weight: 1 }
          Text {
            text: t[38]
            fontSize: 14
            fontWeight: 600
            color: accent
            padding: [6, 10]
            onTap: {
              haptic()
              fontPref = set(fontPref ?? {}, activeLang, "download")
            }
          }
        }
      }
      Spacer { weight: 1 }
      Spacer { height: screenInset }
    }
  }

  // Action sheet for long-press on an app slot
  component ActionSheet() {
    let targetKey = activeSlots[actionSlot]
    let itemApp = (apps ?? []).find(a => a.key == targetKey || a.package == targetKey)
    let targetName = (renames ?? {})[targetKey] ?? (itemApp != null ? itemApp.name : t[0])
    Column {
      fill: true
      padding: wide ? [40, 24] : [24, 20]
      onTap: actionSlot = null
      Spacer { weight: 1 }
      Column {
        fill: width
        scroll: true
        background: alpha(surface, 0.96)
        border: 1
        borderColor: alpha(border, 0.4)
        radius: 16 * corners
        padding: [16, 20]
        gap: 4
        Row {
          fill: width
          align: center
          padding: [0, 4, 8, 4]
          Text { text: targetName; fontSize: 18; fontWeight: 500 }
          Spacer { weight: 1 }
          Text { text: "✕"; fontSize: 16; color: muted; padding: [4, 8]; onTap: actionSlot = null }
        }
        Sep { }
        Text {
          text: t[4]
          fontSize: 16
          fill: width
          padding: [14, 4]
          onTap: {
            pickerSlot = actionSlot
            actionSlot = null
            search = ""
          }
        }
        Sep { }
        Text {
          text: t[5]
          fontSize: 16
          fill: width
          padding: [14, 4]
          onTap: {
            renamingSlot = actionSlot
            actionSlot = null
            renameText = targetName
          }
        }
        Sep { }
        Text {
          text: t[6]
          fontSize: 16
          fill: width
          padding: [14, 4]
          onTap: {
            actionSlot = null
            haptic()
            showLangDropdown = false
            showSettings = true
          }
        }
        Sep { }
        Text {
          text: t[7]
          fontSize: 16
          color: red
          fill: width
          padding: [14, 4]
          onTap: {
            slots = remove(activeSlots, actionSlot)
            actionSlot = null
          }
        }
      }
      Spacer { height: screenInset + 16 }
    }
  }

  // Inline rename dialog
  component RenameModal() {
    let targetKey = activeSlots[renamingSlot ?? 0]
    let trimmed = trim(renameText)
    Column {
      fill: true
      padding: wide ? [40, 24] : [36, 24]
      Spacer { weight: 1 }
      Column {
        fill: width
        background: alpha(surface, 0.96)
        border: 1
        borderColor: alpha(border, 0.6)
        radius: 16 * corners
        padding: [20, 20]
        gap: 14
        Text { text: t[8]; fontSize: 18 }
        Input {
          text: renameText
          placeholder: t[9]
          fill: width
          underline: false
          padding: [10, 12]
          background: alpha(background, 0.5)
          radius: 8 * corners
          onChange: renameText = value
          onSubmit: {
            if renamingSlot != null {
              renames = trimmed != "" ? set(renames ?? {}, targetKey, trimmed) : remove(renames ?? {}, targetKey)
            }
            renamingSlot = null
            renameText = ""
          }
        }
        Row {
          fill: width
          align: center
          Text {
            text: t[10]
            fontSize: 14
            color: muted
            padding: [6, 10]
            onTap: {
              renamingSlot = null
              renameText = ""
            }
          }
          Spacer { weight: 1 }
          Text {
            text: t[11]
            fontSize: 14
            color: accent
            padding: [6, 10]
            onTap: {
              if renamingSlot != null {
                renames = trimmed != "" ? set(renames ?? {}, targetKey, trimmed) : remove(renames ?? {}, targetKey)
              }
              renamingSlot = null
              renameText = ""
            }
          }
        }
      }
      Spacer { weight: 1 }
      Spacer { height: screenInset }
    }
  }

  // App picker view to select an app for a slot or add a new slot.
  component Picker() {
    Column {
      fill: true
      gap: 12
      padding: wide ? [40, 24] : [36, 24]
      Spacer { height: 16 }
      Row {
        fill: width
        align: center
        Text { text: pickerSlot == -1 ? t[12] : t[4]; fontSize: 24; fontWeight: 300; letterSpacing: -0.5 }
        Spacer { weight: 1 }
        Text {
          text: t[10]
          fontSize: 13
          letterSpacing: 2
          color: muted
          padding: [6, 8]
          onTap: {
            pickerSlot = null
            search = ""
          }
        }
      }
      if pickerSlot >= 0 {
        Text {
          text: "✕  " + t[7]
          fontSize: 14
          letterSpacing: 1
          color: red
          padding: [4, 0]
          onTap: {
            slots = remove(activeSlots, pickerSlot)
            pickerSlot = null
            search = ""
          }
        }
      }
      Input {
        placeholder: t[13]
        fill: width
        underline: false
        padding: [10, 12]
        background: alpha(surface, 0.4)
        radius: 8 * corners
        onChange: search = value
      }
      Column {
        weight: 1
        fill: width
        scroll: true
        lazy: true
        gap: 2
        for a in pickerApps key a.key {
          Text {
            text: a.name
            fontSize: 22
            fontWeight: 300
            letterSpacing: -0.5
            fill: width
            padding: [8, 4]
            onTap: {
              slots = pickerSlot == -1 ? activeSlots + [a.key] : set(activeSlots, pickerSlot, a.key)
              pickerSlot = null
              search = ""
            }
          }
        }
      }
      Spacer { height: screenInset }
    }
  }

  component SettingRow(label, valueText, active = true, sub = false) {
    Row {
      fill: width
      align: center
      padding: sub ? [28, 6, 12, 6] : [12, 6]
      Text { text: label; fontSize: sub ? 15 : 16; color: sub ? alpha(foreground, 0.85) : foreground }
      Spacer { weight: 1 }
      Text { text: valueText; fontSize: sub ? 15 : 16; fontWeight: 600; color: active ? foreground : muted }
    }
  }

  // Settings View
  component SettingsView() {
    Column {
      fill: true
      scroll: !showLangDropdown
      gap: 16
      padding: wide ? [36, 40] : [24, 20]

      Row {
        fill: width
        align: center
        padding: [8, 4]
        Text { text: t[6]; fontSize: 22; fontWeight: 500 }
        Spacer { weight: 1 }
        Text {
          text: t[14]
          fontSize: 16
          fontWeight: 500
          color: accent
          padding: [6, 12]
          onTap: {
            haptic()
            showLangDropdown = false
            showSettings = false
          }
        }
      }

      if !showLangDropdown {
        // Card 1: Launcher Header Card
        Column {
          fill: width
          background: alpha(surface, 0.45)
          border: 1
          borderColor: alpha(border, 0.3)
          radius: 20 * corners
          padding: [16, 20]
          gap: 2
          Text { text: "minarchy"; font: activeFont; fontSize: 24; fontWeight: 700 }
          Text { text: t[15]; font: activeFont; fontSize: 12; color: muted }
        }

        // Card 2: Home screen Card
        Column {
          fill: width
          background: alpha(surface, 0.45)
          border: 1
          borderColor: alpha(border, 0.3)
          radius: 20 * corners
          padding: [16, 20]
          gap: 2

          Text { text: t[16]; fontSize: 24; padding: [4, 0, 12, 0] }

          Box {
            onTap: {
              haptic()
              showHeader = !showHeader
            }
            SettingRow { label: t[17]; valueText: showHeader ? t[29] : t[30]; active: showHeader }
          }

          if showHeader {
            Box {
              onTap: {
                haptic()
                showTime = !showTime
              }
              SettingRow { label: t[18]; valueText: showTime ? t[29] : t[30]; active: showTime; sub: true }
            }
            Box {
              onTap: {
                haptic()
                showDate = !showDate
              }
              SettingRow { label: t[19]; valueText: showDate ? t[29] : t[30]; active: showDate; sub: true }
            }
            Box {
              onTap: {
                haptic()
                showBattery = !showBattery
              }
              SettingRow { label: t[20]; valueText: showBattery ? t[29] : t[30]; active: showBattery; sub: true }
            }
          }

          if showHeader && showTime {
            Sep { }
            Box {
              onTap: {
                haptic()
                let formats = ["12-hour (AM/PM)", "12-hour", "24-hour"]
                let idx = indexOf(formats, clockFormat)
                clockFormat = formats[idx < 0 ? 0 : (idx + 1) % len(formats)]
              }
              SettingRow { label: t[21]; valueText: contains(["12-hour (AM/PM)", "12-hour", "24-hour"], clockFormat) ? clockFormat : "12-hour (AM/PM)" }
            }
          }
        }
      }

      // Card 3: Appearance Card
      Column {
        fill: width
        weight: showLangDropdown ? 1 : 0
        background: alpha(surface, 0.45)
        border: 1
        borderColor: alpha(border, 0.3)
        radius: 20 * corners
        padding: [16, 20]
        gap: 2

        Text { text: t[23]; fontSize: 24; padding: [4, 0, 12, 0] }

        Box {
          onTap: {
            haptic()
            showLangDropdown = !showLangDropdown
            langSearch = ""
          }
          SettingRow {
            label: t[34]
            valueText: (lang == "Auto" ? "Auto (${detected[1]})" : activeEntry[1]) + (showLangDropdown ? " ▴" : " ▾")
          }
        }

        if showLangDropdown {
          Column {
            fill: width
            weight: 1
            background: alpha(background, 0.5)
            border: 1
            borderColor: alpha(border, 0.4)
            radius: 12 * corners
            padding: [12, 10]
            gap: 8
            Input {
              text: langSearch
              placeholder: t[13]
              fill: width
              underline: false
              padding: [10, 8]
              background: alpha(surface, 0.6)
              radius: 8 * corners
              onChange: langSearch = value
            }
            Column {
              fill: width
              weight: 1
              scroll: true
              lazy: true
              gap: 2
              for item in filteredLangs key item.id {
                Row {
                  fill: width
                  align: center
                  padding: [8, 8]
                  radius: 8 * corners
                  background: lang == item.id ? alpha(accent, 0.15) : alpha(accent, 0)
                  onTap: {
                    haptic()
                    lang = item.id
                    showLangDropdown = false
                    langSearch = ""
                  }
                  Text { text: item.name; fontSize: 15; fontWeight: lang == item.id ? 600 : 400; color: lang == item.id ? accent : foreground }
                  Spacer { weight: 1 }
                  if lang == item.id {
                    Text { text: "✓"; fontSize: 15; color: accent; fontWeight: 600 }
                  }
                }
              }
            }
          }
        } else {
          Sep { }
          Box {
            onTap: {
              haptic()
              appAlignment = appAlignment == "Left" ? "Center" : (appAlignment == "Center" ? "Right" : "Left")
            }
            SettingRow { label: t[22]; valueText: alignLabel }
          }
          Sep { }
          Box {
            onTap: {
              haptic()
              let spacings = ["Compact", "Normal", "Spacious", "Extra Spacious"]
              let idx = indexOf(spacings, appSpacing)
              appSpacing = spacings[idx < 0 ? 1 : (idx + 1) % len(spacings)]
            }
            SettingRow { label: t[39]; valueText: spacingLabel }
          }
          Sep { }
          Box {
            onTap: {
              haptic()
              let sizes = [0.8, 1.0, 1.2, 1.4]
              let sIdx = indexOf(sizes, textSize)
              textSize = sizes[sIdx < 0 ? 1 : (sIdx + 1) % len(sizes)]
            }
            SettingRow { label: t[28]; valueText: str(textSize) }
          }
          Sep { }
          Box {
            onTap: {
              haptic()
              boldFont = !boldFont
            }
            SettingRow { label: t[27]; valueText: boldFont ? t[29] : t[30]; active: boldFont }
          }
          Sep { }
          Box {
            onTap: {
              haptic()
              showStatusBar = !showStatusBar
            }
            SettingRow { label: t[26]; valueText: showStatusBar ? t[29] : t[30]; active: showStatusBar }
          }
          Sep { }
          Box {
            onTap: {
              haptic()
              launcher("style")
            }
            SettingRow { label: t[24]; valueText: t[25]; active: false }
          }
        }
      }

      Spacer { height: screenInset + (showLangDropdown ? 4 : 20) }
    }
  }

  // Screen layout
  if showFontPrompt {
    FontModal { }
  } else if showSettings {
    SettingsView { }
  } else if actionSlot != null {
    ActionSheet { }
  } else if renamingSlot != null {
    RenameModal { }
  } else if pickerSlot != null {
    Picker { }
  } else if wide {
    Row {
      fill: true
      gap: 56
      padding: [40, 20]
      onLongPress: {
        haptic()
        showLangDropdown = false
        showSettings = true
      }
      if headerVisible {
        Column {
          weight: 1
          gap: 0
          align: textAlignment
          Spacer { weight: 1 }
          Day { }
          Spacer { weight: 1 }
        }
      }
      Column {
        weight: 1
        gap: 0
        align: textAlignment
        Apps { }
        BottomBar { }
        Spacer { height: screenInset }
      }
    }
  } else {
    Column {
      fill: true
      gap: 0
      padding: [32, 24]
      onLongPress: {
        haptic()
        showLangDropdown = false
        showSettings = true
      }
      Spacer { height: 36 }
      if headerVisible {
        Day { }
      }
      Apps { }
      BottomBar { }
      Spacer { height: screenInset + 12 }
    }
  }
}
