face "t9" {
  // A dumb phone, reimagined in your own frosted glass: the keypad is the whole launcher. Tap keys and they spell,
  // the old predictive way: 2-2-6 is CAMera, 8-6-7-2-4 is TORCH, any three digits or more can be dialled, and the
  // pick shows beside the digits as an LCD pixel icon. Keys sink onto their edge as the thumb lands, tick as it lifts
  // and play their real touch-tones. The LCD lights like hardware: LEDs under the glass snap on, the light guide warms
  // to full, it dims eight seconds after the last touch and goes out four later with an afterglow. A round-dot matrix
  // clock; a ring round the nav pad that blinks for what's new and traces the playing song; new messages that type
  // themselves onto the LCD; and a player, opened from the song line, that draws the album cover in LCD dots.
  // Hold a key after spelling something and it's on speed dial there; hold it from the idle screen to open it.
  // Hold # for key tones off and on. *#06# says what phone this is. Theme colours throughout, so it follows the
  // Omarchy theme, and the glass follows settings › style.

  meta {
    owl: 23
    description: "A dumb phone in frosted glass: the keypad is the launcher. T9 spells apps, dials, speed-dials; keys sink and play touch-tones, an LCD lights like hardware, with a dot-matrix clock"
    version: "2.0"
    license: "MIT"
    category: "productivity"
  }

  source now = clock every 1m
  source sec = clock every 1s
  source apps = android.apps
  source n = android.notifications
  source alarm = android.alarm
  source bat = android.battery
  source sim = android.sim
  source modes = android.modes
  source m = android.media
  source vol = android.volume
  source dev = android.device

  // Telephone-band sounds, 8 kHz: each key's DTMF pair, then the earcons (open, busy, nothing there, saved, *#06#).
  asset k1 = base64""
  asset k2 = base64""
  asset k3 = base64""
  asset k4 = base64""
  asset k5 = base64""
  asset k6 = base64""
  asset k7 = base64""
  asset k8 = base64""
  asset k9 = base64""
  asset k0 = base64""
  asset kStar = base64""
  asset kHash = base64""
  asset sConnect = base64""
  asset sBusy = base64""
  asset sNope = base64""
  asset sSaved = base64""
  asset sSit = base64""
  // What's typed, the result picked, seconds left of the backlight, of a message and of the volume bar.
  state q = ""
  state sel = 0
  state lit = 0
  state flash = ""
  state flashN = 0
  state volN = 0
  // Speed dial: a key's digit to what it opens.
  state speed = {} persist
  // Key tones and earcons on; the time of the last touch, so only newer notifications light the ring.
  state tones = true persist
  state seenAt = 0 persist
  // The control under the finger, the nav pad's pressed zone, and the LCD's screen ("" or "player").
  state down = ""
  state navZ = ""
  state view = ""
  // A line typing itself in: which, when it started (frame time) and seconds left.
  state revealK = ""
  state revealAt = 0
  state revealN = 0
  // The last commit and a counter, so one trigger holds the command chain.
  state go = {n: 0, c: null, t: 0}
  state goN = 0
  // A held key whose speed dial would be replaced: held again while the question shows, it is.
  state armK = ""

  statusBar: false
  edge: true
  padding: 0
  // A tap that no key, line or row takes (the LCD glass, the gaps, the margins) still lights the LCD.
  onTap: lit = LIT
  // Only seen between the glass parts (frost paints the wallpaper under each one), or everywhere with frost off.
  background: linear(0, 0, 0, 1, [alpha(background, 0.08), alpha(background, 0.16), alpha(background, 0.34)])

  let lcdFont = "https://raw.githubusercontent.com/google/fonts/main/ofl/vt323/VT323-Regular.ttf"
  let inter = "https://raw.githubusercontent.com/google/fonts/main/ofl/inter/Inter%5Bopsz,wght%5D.ttf"

  // ---- sizes ----
  let W = tileWidth ?? 412
  let H = tileHeight ?? 915
  let wide = W > H
  let kh = clamp((H - 420) / 7.2, 46, 70)
  let navH = clamp(kh * 1.6, 84, 112)
  let rowsN = H > 800 ? 5 : 4
  let bigT = clamp(((wide ? W * 0.5 : W) - 70) / 2.6, 70, 150)
  // The LCD's width in dp, for its pixel grid.
  let lcdW = wide ? W - 48 - num(screenLeft, 0) - num(screenRight, 0) - min(W * 0.42, 380) : W - 28 - num(screenLeft, 0) - num(screenRight, 0)
  // The user's tile glass, a key's edge depth (and travel), its corner, the soft-key and call/end slots.
  let glassA = num(tileOpacity, 0.46)
  // The LCD is a display, not a window: denser smoked glass than the keys, so it reads over a bright wallpaper.
  let lcdA = clamp(glassA + 0.2, 0.62, 0.92)
  let kd = 3
  let kr = 14 * corners
  // The digit fits its cap on short screens and in landscape.
  let digitFs = min(30, (kh - kd - 12) / 1.21)
  let softH = (navH - 10) / 2.3
  let callH = navH - 10 - softH
  let artS = clamp(min(lcdW - 32, H * 0.2), 96, 200)

  // ---- the backlight: seconds of light a touch gives (8 full, then 4 dim), and a wake (2 full, 4 dim) ----
  let LIT = 12
  let WAKE = 6
  let bl = lit > 4 ? 1 : lit > 0 ? 0.35 : 0
  let inkLvl = bl >= 1 ? 1 : bl > 0 ? 0.9 : 0.8

  // ---- the look: an LCD tinted by the theme's accent, ink a touch of it too, one light colour ----
  let ink = mix(foreground, accent, 0.2)
  let faint = alpha(ink, 0.5)
  let glowC = mix(accent, foreground, 0.15)
  let plateC = mix(background, accent, 0.08)
  let lcdSolid = mix(background, accent, 0.12)
  let edgeC = alpha(foreground, 0.16)

  // ---- T9: every app's words as the digits that spell them ----
  let t9 = {a: "2", b: "2", c: "2", d: "3", e: "3", f: "3", g: "4", h: "4", i: "4", j: "5", k: "5", l: "5", m: "6", n: "6", o: "6", p: "7", q: "7", r: "7", s: "7", t: "8", u: "8", v: "8", w: "9", x: "9", y: "9", z: "9"}
  let cmds = [
    {kind: "cmd", id: "torch", name: "Torch"},
    {kind: "cmd", id: "quiet", name: "Quiet"},
    {kind: "cmd", id: "wifi", name: "Wifi"},
    {kind: "cmd", id: "bluetooth", name: "Bluetooth"},
    {kind: "cmd", id: "music", name: "Music"},
    {kind: "cmd", id: "next", name: "Next track"},
    {kind: "cmd", id: "settings", name: "Settings"},
    {kind: "cmd", id: "menu", name: "Menu"}
  ]
  // Only what spelling needs from each app: opening an app changes its score, not this, so the codes aren't redone.
  let appNames = (apps ?? []).map(a => {key: a.key, name: a.name, work: a.profile})
  let pool = (appNames.map(a => {kind: "app", key: a.key, id: null, name: join(words(a.name), " "), work: a.work, ws: words(lower(a.name))})
    + cmds.map(c => merge(c, {work: null, ws: words(lower(c.name))})))
    .map(p => merge(p, {codes: p.ws.map(w => join(range(len(w)).map(i => contains("0123456789", sub(w, i, i + 1)) ? sub(w, i, i + 1) : get(t9, sub(w, i, i + 1), "")), ""))}))
  // How much each app is used, by key, for the ranking: cheap to redo after every launch.
  let usage = groupBy((apps ?? []).filter(a => num(a.score, 0) > 0), a => a.key)

  let typing = q != ""
  let spell = typing && !contains(q, "*") && !contains(q, "#") && !contains(q, "+")
  let info = q == "*#06#"
  // A whole word spelled first, then a name's start, then any word's start; apps before commands, used ones first.
  let found = !spell ? [] : pool
    .filter(p => any(p.codes, c => startsWith(c, q)))
    .map(p => merge(p, {wi: range(len(p.codes)).find(i => startsWith(p.codes[i], q)), score: p.kind == "app" ? num(get(usage, p.key, [])[0].score, 0) : 0}))
    .sortBy(p => (p.codes[p.wi] == q ? 0 : 1000000) + (p.wi == 0 ? 0 : 300000) + (p.kind == "cmd" ? 100000 : 0) - p.score)
    .take(8)
    .map(p => merge(p, {off: sum(range(p.wi).map(j => len(p.ws[j]) + 1))}))
  let cands = found + (len(q) >= 3 && !info ? [{kind: "call", name: "Call ${q}", num: q}] : [])
  let at = len(cands) == 0 ? 0 : clamp(sel, 0, len(cands) - 1)
  let cur = len(cands) == 0 ? null : cands[at]
  let from = max(0, at - rowsN + 1)
  let shown = cands.drop(from).take(rowsN)
  let selI = at - from

  // ---- dialling abroad: the country code's city and the time there, so nobody gets rung at 3 a.m. ----
  let zones = [
    {c: "1", city: "New York", z: "America/New_York"}, {c: "1", city: "Los Angeles", z: "America/Los_Angeles"},
    {c: "7", city: "Moscow", z: "Europe/Moscow"}, {c: "20", city: "Cairo", z: "Africa/Cairo"},
    {c: "27", city: "Johannesburg", z: "Africa/Johannesburg"}, {c: "30", city: "Athens", z: "Europe/Athens"},
    {c: "31", city: "Amsterdam", z: "Europe/Amsterdam"}, {c: "32", city: "Brussels", z: "Europe/Brussels"},
    {c: "33", city: "Paris", z: "Europe/Paris"}, {c: "34", city: "Madrid", z: "Europe/Madrid"}, {c: "36", city: "Budapest", z: "Europe/Budapest"},
    {c: "39", city: "Rome", z: "Europe/Rome"}, {c: "40", city: "Bucharest", z: "Europe/Bucharest"}, {c: "41", city: "Zurich", z: "Europe/Zurich"},
    {c: "43", city: "Vienna", z: "Europe/Vienna"}, {c: "44", city: "London", z: "Europe/London"},
    {c: "45", city: "Copenhagen", z: "Europe/Copenhagen"}, {c: "46", city: "Stockholm", z: "Europe/Stockholm"},
    {c: "47", city: "Oslo", z: "Europe/Oslo"}, {c: "48", city: "Warsaw", z: "Europe/Warsaw"}, {c: "49", city: "Berlin", z: "Europe/Berlin"},
    {c: "51", city: "Lima", z: "America/Lima"}, {c: "52", city: "Mexico City", z: "America/Mexico_City"},
    {c: "54", city: "Buenos Aires", z: "America/Argentina/Buenos_Aires"}, {c: "55", city: "Sao Paulo", z: "America/Sao_Paulo"},
    {c: "56", city: "Santiago", z: "America/Santiago"}, {c: "57", city: "Bogota", z: "America/Bogota"},
    {c: "60", city: "Kuala Lumpur", z: "Asia/Kuala_Lumpur"}, {c: "61", city: "Sydney", z: "Australia/Sydney"},
    {c: "62", city: "Jakarta", z: "Asia/Jakarta"}, {c: "63", city: "Manila", z: "Asia/Manila"}, {c: "64", city: "Auckland", z: "Pacific/Auckland"},
    {c: "65", city: "Singapore", z: "Asia/Singapore"}, {c: "66", city: "Bangkok", z: "Asia/Bangkok"}, {c: "81", city: "Tokyo", z: "Asia/Tokyo"},
    {c: "82", city: "Seoul", z: "Asia/Seoul"}, {c: "84", city: "Hanoi", z: "Asia/Ho_Chi_Minh"}, {c: "86", city: "Beijing", z: "Asia/Shanghai"},
    {c: "90", city: "Istanbul", z: "Europe/Istanbul"}, {c: "91", city: "New Delhi", z: "Asia/Kolkata"},
    {c: "92", city: "Karachi", z: "Asia/Karachi"}, {c: "234", city: "Lagos", z: "Africa/Lagos"}, {c: "254", city: "Nairobi", z: "Africa/Nairobi"},
    {c: "351", city: "Lisbon", z: "Europe/Lisbon"}, {c: "353", city: "Dublin", z: "Europe/Dublin"},
    {c: "358", city: "Helsinki", z: "Europe/Helsinki"}, {c: "380", city: "Kyiv", z: "Europe/Kiev"}, {c: "420", city: "Prague", z: "Europe/Prague"},
    {c: "852", city: "Hong Kong", z: "Asia/Hong_Kong"}, {c: "886", city: "Taipei", z: "Asia/Taipei"}, {c: "966", city: "Riyadh", z: "Asia/Riyadh"},
    {c: "971", city: "Dubai", z: "Asia/Dubai"}, {c: "972", city: "Tel Aviv", z: "Asia/Jerusalem"}
  ]
  let intl = startsWith(q, "+") ? sub(q, 1, len(q)) : startsWith(q, "00") ? sub(q, 2, len(q)) : ""
  let zoneHits = intl == "" ? [] : zones.filter(z => startsWith(intl, z.c))
  let zoneLen = reduce(zoneHits, (best, z) => max(best, len(z.c)), 0)
  let zoneShow = zoneHits.filter(z => len(z.c) == zoneLen).take(2)

  // ---- the phone, as a dumb phone would tell it ----
  let phoneApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.dialer", "com.samsung.android.dialer", "com.android.dialer", "org.fossify.phone"], a.package))
  let msgApp = (apps ?? []).find(a => a.profile == null && contains(["com.google.android.apps.messaging", "com.samsung.android.messaging", "com.android.mms", "com.android.messaging", "org.fossify.messages"], a.package))
  let items = n.available ? n.items : []
  let missed = phoneApp == null ? 0 : len(items.filter(i => i.package == phoneApp.package))
  let unread = msgApp == null ? 0 : len(items.filter(i => i.package == msgApp.package))
  let rest = items.filter(i => (phoneApp == null || i.package != phoneApp.package) && (msgApp == null || i.package != msgApp.package))
  let lines = [
    missed > 0 ? {k: "call", t: missed == 1 ? "1 missed call" : "${missed} missed calls"} : null,
    unread > 0 ? {k: "sms", t: unread == 1 ? "1 message" : "${unread} messages"} : null,
    len(rest) > 0 ? {k: "note", t: len(rest) == 1 ? "1 notification" : "${len(rest)} notifications"} : null,
    alarm.set ? {k: "bell", t: "alarm " + lower(fmtTime(alarm.time, "EEE HH:mm"))} : null
  ].filter(x => x != null)
  let song = m.available && m.title != null ? [m.title, m.artist].filter(x => x != null && x != "").join(" - ") : null
  // android.media is pushed every second while playing (its position): what changes per track goes through lets,
  // so only the ring, the blocks and the times follow the second.
  let mPlaying = m.playing == true
  let mArt = m.art
  let mTitle = m.title
  let mArtist = m.artist
  let mPkg = m.package
  let mAppName = m.app
  // The player's own name, from the apps list; some apps only give their package.
  let mediaApp = mPkg == null ? null : ((apps ?? []).find(a => a.package == mPkg)).name ?? (mAppName != null && !contains(mAppName, ".") ? mAppName : null)
  let songBy = [mArtist, mediaApp].filter(x => x != null && x != "").join(" · ")
  // Null until the notifications and the apps have loaded, so loading never looks like something arriving.
  let counts = n == null || n.available != true || apps == null || len(apps) == 0 ? null : [missed, unread, len(rest)]
  let charged = bat == null || bat.charging == null ? null : bat.charging == true && num(bat.level, 0) >= 100
  // Plugged in, charging or held below full: bat.charging alone flips while the cable stays in.
  let plugged = bat == null || bat.status == null ? null : bat.status != "on battery"

  // ---- the ring's LED: notifications newer than the last touch; red for a call, accent for a message ----
  let fresh = items.filter(i => num(i.time, 0) > seenAt)
  let freshCall = phoneApp != null && any(fresh, i => i.package == phoneApp.package)
  let freshMsg = msgApp != null && any(fresh, i => i.package == msgApp.package)
  let ledC = freshCall ? red : freshMsg ? accent : len(fresh) > 0 ? blue : null
  let ledOn = ledC != null && (revealK != "" || modes.saver == true || sec % 4 == 0)
  let callT = freshCall ? num(first(fresh.filter(i => i.package == phoneApp.package)).time, 0) : 0
  let wob = callT > 0 && sec - callT < 120 && sec % 4 == 0

  // ---- sound: never over music, on a quiet ringer, in Do Not Disturb, or into headphones ----
  let soundOk = m.playing != true && modes.ringer == "normal" && modes.dnd != true && (vol.output == null || vol.output.type == "speaker")
  let voice = tones && soundOk

  // ---- what the soft keys and the nav centre do now, as the LCD labels them ----
  let softL = view == "player" ? "Prev" : "Menu"
  let softM = view == "player" ? (m.playing == true ? "Pause" : "Play") : info ? "Close" : typing ? (cur != null ? "Select" : "") : modes.dnd ? "Loud" : "Quiet"
  let softR = view == "player" ? "Next" : typing ? "Clear" : modes.torch == true ? "Dark" : "Light"
  let callMix = bl > 0 ? (typing && cur != null ? 0.45 : 0.38) : 0.25
  let endMix = bl > 0 ? (typing ? 0.42 : 0.36) : 0.25

  // ---- the clock as a 5x7 round-dot matrix: digit, gap, digit, gap, colon, gap, digit, gap, digit ----
  let dm = [
    ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
    ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
    ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
    ["11111", "00010", "00100", "00010", "00001", "10001", "01110"],
    ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
    ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
    ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
    ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
    ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
    ["01110", "10001", "10001", "01111", "00001", "00010", "01100"]
  ]
  let hm = fmtTime(now, "HHmm")
  let dg = range(4).map(i => dm[num(sub(hm, i, i + 1), 0)])
  let dotRows = range(7).map(r => dg[0][r] + "0" + dg[1][r] + "000" + dg[2][r] + "0" + dg[3][r])
  // The same rows as numbers for the GPU: columns 0-12 and 13-24 as bits, the leftmost highest.
  let dotBits = dotRows.map(s => [reduce(range(13), (acc, i) => acc * 2 + (sub(s, i, i + 1) == "1" ? 1 : 0), 0), reduce(range(12), (acc, i) => acc * 2 + (sub(s, 13 + i, 14 + i) == "1" ? 1 : 0), 0)])
  // Shaders need Android 13; older phones draw the same with Canvas calls.
  let gpu = num(dev.sdk, 33) >= 33

  // Pixel icons, one letter per LCD pixel.
  let sprites = {
    call: [".xxxxxxx.", "xx.....xx", "xx.xxx.xx", "...xxx...", "..xxxxx..", "..xxxxx.."],
    sms: ["xxxxxxxxx", "xx.....xx", "x.x...x.x", "x..x.x..x", "x...x...x", "xxxxxxxxx"],
    note: [".xxxxxxx.", "x.......x", "x.x.x.x.x", "x.......x", ".xxxxxxx.", ".xx......"],
    bell: ["...x...", "..xxx..", ".xxxxx.", ".xxxxx.", "xxxxxxx", "...x..."],
    song: ["..xxxxx", "..x...x", "..x...x", "xxx.xxx", "xxx.xxx", "......."],
    handset: ["...xxxxxxx...", ".xxxxxxxxxxx.", "xxxx.....xxxx", "xxx.......xxx", ".x.........x."]
  }
  let sunArt = ["...x...", ".x...x.", "..xxx..", "x.xxx.x", "..xxx..", ".x...x.", "...x..."]
  let moonArt = ["..xxx..", ".xx....", "xx.....", "xx.....", "xx.....", ".xx....", "..xxx.."]
  let muteArt = ["...x.....", "..xx.x..x", "xxxx..xx.", "xxxx..xx.", "..xx.x..x", "...x....."]
  // What a command or a call looks like as a 16x16 LCD icon; apps show their own silhouette.
  let px16 = {
    torch: [".x.....xx.....x.", "..x....xx....x..", "................", "...xxxxxxxxxx...", "...x........x...", "....x......x....", ".....xxxxxx.....", ".....x....x.....", ".....x.xx.x.....", ".....x.xx.x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....x....x.....", ".....xxxxxx....."],
    quiet: ["................", ".....xxxx.......", "...xxxx.........", "..xxx...........", ".xxx............", ".xxx............", "xxx.............", "xxx.............", "xxx.............", "xxx............x", ".xxx..........xx", ".xxxx.......xxx.", "..xxxxx...xxxx..", "...xxxxxxxxxx...", ".....xxxxxx.....", "................"],
    wifi: ["................", "................", "....xxxxxxxx....", "..xxx......xxx..", ".xx..........xx.", "xx............xx", "......xxxx......", "....xxx..xxx....", "...xx......xx...", "..x..........x..", "................", "......xxxx......", ".....xx..xx.....", "................", ".......xx.......", ".......xx......."],
    bluetooth: [".......x........", ".......xx.......", ".......x.x......", "...x...x..x.....", "....x..x...x....", ".....x.x..x.....", "......xx.x......", ".......xx.......", ".......xx.......", "......xx.x......", ".....x.x..x.....", "....x..x...x....", "...x...x..x.....", ".......x.x......", ".......xx.......", ".......x........"],
    music: ["................", ".....xxxxxxxxxx.", ".....xxxxxxxxxx.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x........x.", ".....x.....xxxx.", "..xxxx....xxxxx.", ".xxxxx....xxxxx.", ".xxxxx.....xxx..", "..xxx...........", "................", "................"],
    next: ["................", "................", "................", ".x.....x.....xx.", ".xx....xx....xx.", ".xxx...xxx...xx.", ".xxxx..xxxx..xx.", ".xxxxx.xxxxx.xx.", ".xxxxx.xxxxx.xx.", ".xxxx..xxxx..xx.", ".xxx...xxx...xx.", ".xx....xx....xx.", ".x.....x.....xx.", "................", "................", "................"],
    settings: ["......xxxx......", "..xx..xxxx..xx..", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", "..xxxx....xxxx..", "..xxx......xxx..", "xxxx........xxxx", "xxxx........xxxx", "xxxx........xxxx", "xxxx........xxxx", "..xxx......xxx..", "..xxxx....xxxx..", ".xxxxxxxxxxxxxx.", ".xxxxxxxxxxxxxx.", "..xx..xxxx..xx..", "......xxxx......"],
    menu: ["xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "................", "................", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "................", "................", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx", "xxxx..xxxx..xxxx"],
    call: ["................", "..xxx...........", ".xxxxx..........", ".xxxxx..........", ".xxxx...........", "..xxx...........", "..xxx...........", "...xxx..........", "....xxx.........", ".....xxx..xxx...", "......xxxxxxxx..", ".......xxxxxxxx.", "........xxxxxxx.", "..........xxxx..", "................", "................"]
  }

  // A command's or a call's icon, and the player's note, as 16 rows of bits for the GPU.
  let pxArt = cur == null || cur.kind == "app" ? null : get(px16, cur.kind == "call" ? "call" : cur.id, px16.menu)
  let pxBits = pxArt == null ? [] : pxArt.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))
  let noteBits = px16.music.map(r => reduce(range(16), (acc, i) => acc * 2 + (sub(r, i, i + 1) == "x" ? 1 : 0), 0))

  // Each key: its digit, its letters and its touch-tone.
  let pad = [{d: "1", l: "o_o", t: k1}, {d: "2", l: "abc", t: k2}, {d: "3", l: "def", t: k3}, {d: "4", l: "ghi", t: k4}, {d: "5", l: "jkl", t: k5}, {d: "6", l: "mno", t: k6}, {d: "7", l: "pqrs", t: k7}, {d: "8", l: "tuv", t: k8}, {d: "9", l: "wxyz", t: k9}, {d: "*", l: " ", t: kStar}, {d: "0", l: "+", t: k0}, {d: "#", l: " ", t: kHash}]

  // ---- shaders: none reads time, so each runs again only when its uniforms change ----
  // Three LEDs under the LCD's bottom edge, through a light guide: brightest along the bottom, darker corners.
  let guideCode = """
    uniform half4 glow;
    uniform half4 bg;
    half4 main(float2 p) {
      float2 uv = p / size;
      float ar = size.x / size.y;
      float a = 0.05 * exp(-(1.0 - uv.y) * 6.0);
      for (int i = 0; i < 3; i++) {
        float2 d = float2((uv.x - 0.2 - 0.3 * float(i)) * ar, uv.y - 1.04);
        a += 0.09 * exp(-dot(d, d) * 30.0);
      }
      float vx = uv.x * 2.0 - 1.0;
      a = min(a * (1.0 - 0.3 * vx * vx), 0.2);
      // Light on a dark theme is the glow colour; on a light one, the light background is.
      half3 c = dot(float3(glow.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333)) ? glow.rgb : bg.rgb;
      return half4(c * a, a);
    }
  """
  // The pixel grid: 0.7 dp gaps every 4 dp, under the ink, and the bezel's recess shadow along the top, both in the
  // darker of the theme's background and foreground, so they show on light themes too.
  let gridCode = """
    uniform half4 gap;
    uniform half4 fg;
    uniform float wdp;
    half4 main(float2 p) {
      float k = size.x / wdp;
      float c = 4.0 * k;
      float w = 0.7 * k;
      float2 q = mod(p, c);
      float lx = 1.0 - smoothstep(w - 0.5, w + 0.5, q.x);
      float ly = 1.0 - smoothstep(w - 0.5, w + 0.5, q.y);
      float g = max(lx, ly) * gap.a;
      half3 dk = dot(float3(fg.rgb), float3(0.333)) < dot(float3(gap.rgb), float3(0.333)) ? fg.rgb : gap.rgb;
      float rc = 0.28 * (1.0 - smoothstep(0.0, 10.0 * k, p.y));
      float o = max(g, rc);
      return half4(dk * o, o);
    }
  """
  // The clock's dots: lit ones in ink, the rest faintly there.
  let dotsCode = """
    uniform float2 bits[7];
    uniform half4 inkc;
    uniform float ghostA;
    float bitAt(float2 cell) {
      if (cell.x < 0.0 || cell.x > 24.0 || cell.y < 0.0 || cell.y > 6.0) { return 0.0; }
      float2 m = float2(0.0, 0.0);
      for (int i = 0; i < 7; i++) {
        if (float(i) == cell.y) { m = bits[i]; }
      }
      float word = cell.x < 13.0 ? m.x : m.y;
      float b = cell.x < 13.0 ? 12.0 - cell.x : 24.0 - cell.x;
      return mod(floor(word / exp2(b)), 2.0);
    }
    half4 main(float2 p) {
      float pw = min(size.x / 25.0, size.y / 7.0);
      float2 o = (size - float2(25.0, 7.0) * pw) * 0.5;
      float2 g = (p - o) / pw;
      float2 cell = floor(g);
      if (cell.x < 0.0 || cell.x > 24.0 || cell.y < 0.0 || cell.y > 6.0) { return half4(0.0); }
      float r = length(g - cell - 0.5);
      float aa = 0.75 / pw;
      float inside = 1.0 - smoothstep(0.38 - aa, 0.38 + aa, r);
      float a = inside * inkc.a * (bitAt(cell) > 0.5 ? 1.0 : ghostA);
      return half4(inkc.rgb * a, a);
    }
  """
  // A soft glow round the clock's lit dots (on dark themes: on a light one it would be a smudge).
  let haloCode = """
    uniform float2 bits[7];
    uniform half4 glowc;
    uniform half4 bg;
    float bitAt(float2 cell) {
      if (cell.x < 0.0 || cell.x > 24.0 || cell.y < 0.0 || cell.y > 6.0) { return 0.0; }
      float2 m = float2(0.0, 0.0);
      for (int i = 0; i < 7; i++) {
        if (float(i) == cell.y) { m = bits[i]; }
      }
      float word = cell.x < 13.0 ? m.x : m.y;
      float b = cell.x < 13.0 ? 12.0 - cell.x : 24.0 - cell.x;
      return mod(floor(word / exp2(b)), 2.0);
    }
    half4 main(float2 p) {
      float pw = min(size.x / 25.0, size.y / 7.0);
      float2 o = (size - float2(25.0, 7.0) * pw) * 0.5;
      float2 g = (p - o) / pw;
      float2 cell = floor(g);
      float h = 0.0;
      for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
          float2 nc = cell + float2(float(dx), float(dy));
          if (bitAt(nc) > 0.5) {
            float2 d = g - (nc + 0.5);
            h += exp(-dot(d, d) * 4.0);
          }
        }
      }
      float a = clamp(h * 0.2, 0.0, 0.35) * step(dot(float3(bg.rgb), float3(0.333)), dot(float3(glowc.rgb), float3(0.333)));
      return half4(glowc.rgb * a, a);
    }
  """
  // The light guide's slow wash, rising toward the LEDs at the bottom.
  let washCode = """
    uniform half4 glow;
    uniform half4 bg;
    half4 main(float2 p) {
      float y = p.y / size.y;
      float a = 0.12 * y * y;
      half3 c = dot(float3(glow.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333)) ? glow.rgb : bg.rgb;
      return half4(c * a, a);
    }
  """
  // A 16x16 pixel icon from 16 rows of bits, the leftmost highest; cells inset 10%.
  let pxCode = """
    uniform float bits[16];
    uniform half4 inkc;
    uniform half4 ghost;
    half4 main(float2 p) {
      float2 g = p / size * 16.0;
      float2 cell = floor(g);
      float m = 0.0;
      for (int i = 0; i < 16; i++) {
        if (float(i) == cell.y) { m = bits[i]; }
      }
      float on = mod(floor(m / exp2(15.0 - cell.x)), 2.0);
      float2 f = g - cell;
      float inside = step(0.1, f.x) * step(f.x, 0.9) * step(0.1, f.y) * step(f.y, 0.9);
      half4 c = on > 0.5 ? inkc : ghost;
      return half4(c.rgb * c.a, c.a) * inside;
    }
  """
  // Album art as a 4x4 ordered dither in ink, for light and dark themes alike.
  let coverCode = """
    uniform shader art;
    uniform half4 ink;
    uniform half4 plate;
    uniform half4 bg;
    uniform float cells;
    half4 main(float2 p) {
      float c = size.x / cells;
      float2 g = floor(p / c);
      // Levels from 16 samples of the cover, so dark and pale artwork still fill the plate.
      float lo = 1.0;
      float hi = 0.0;
      for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
          float v = dot(float3(art.eval((float2(float(i), float(j)) + 0.5) / 4.0).rgb), float3(0.299, 0.587, 0.114));
          lo = min(lo, v);
          hi = max(hi, v);
        }
      }
      half3 s = art.eval((g + 0.5) / cells).rgb;
      float span = max(hi - lo, 0.2);
      // Dark covers start the window at their darkest sample, pale ones end it at their lightest: a flat cover keeps
      // its brightness.
      float base = mix(lo, hi - span, smoothstep(0.3, 0.7, lo));
      float l = clamp((dot(float3(s), float3(0.299, 0.587, 0.114)) - base) / span, 0.0, 1.0);
      float2 o = mod(g, 2.0);
      float2 h = mod(floor(g / 2.0), 2.0);
      float t = (4.0 * mod(2.0 * o.x + 3.0 * o.y, 4.0) + mod(2.0 * h.x + 3.0 * h.y, 4.0) + 0.5) / 16.0;
      bool lightInk = dot(float3(ink.rgb), float3(0.333)) > dot(float3(bg.rgb), float3(0.333));
      bool inked = lightInk ? l > t : l < t;
      float2 f = fract(p / c);
      half4 col = plate;
      if (inked && f.x < 0.84 && f.y < 0.84) { col = ink; }
      return half4(col.rgb * col.a, col.a);
    }
  """

  fps: revealK != "" && revealN > 1 ? (modes.saver ? 15 : 30) : typing ? 2 : mPlaying ? (modes.saver ? 4 : 8) : 1

  // ---- triggers ----
  // One clock for every countdown. A jump means home is back (the screen was off or an app was in front): the light
  // wakes, and after more than 30 seconds away the LCD goes back to its idle screen.
  on sec {
    if value - old > 4 {
      lit = WAKE
      flashN = 0
      volN = 0
      down = ""
      navZ = ""
      if value - old > 30 {
        q = ""
        sel = 0
        view = ""
      }
    } else {
      if lit > 0 { lit = lit - 1 }
      if flashN > 0 { flashN = flashN - 1 }
      if volN > 0 { volN = volN - 1 }
      if revealN > 0 {
        revealN = revealN - 1
        if revealN == 0 { revealK = "" }
      }
    }
  }
  // A touch gives the full light, which marks every notification seen; a wake never reaches it.
  on lit { if value > old && value >= LIT { seenAt = sec } }
  // Something new: the light wakes, and on the idle screen its line types itself in.
  on counts {
    let newK = value[0] > old[0] ? "call" : value[1] > old[1] ? "sms" : value[2] > old[2] ? "note" : ""
    if newK != "" {
      lit = max(lit, WAKE)
      if q == "" && view == "" {
        revealK = newK
        revealAt = time
        revealN = 3
      }
    }
  }
  on plugged {
    flash = !value ? "unplugged" : bat.charging == true ? "charging" : "plugged in"
    flashN = 3
    lit = max(lit, WAKE)
  }
  on charged {
    if value {
      flash = "battery full"
      flashN = 4
    }
  }
  when view == "player" && song == null { view = "" }
  // Every commit (green, Select, the picked row, the pixel icon, a held speed dial) ends up here.
  on go {
    let c = value.c
    if c != null {
      if c.kind == "app" { androidApp(c.key) } else if c.kind == "call" { url("tel:${enc(c.num)}") } else if c.id == "torch" { torch(modes.torch == true ? 0 : 100) } else if c.id == "quiet" { dnd("toggle") } else if c.id == "wifi" { settings("wifi") } else if c.id == "bluetooth" { settings("bluetooth") } else if c.id == "music" { media("toggle") } else if c.id == "next" { media("next") } else if c.id == "settings" { launcher("settings") } else if c.id == "menu" { launcher("drawer") }
    }
  }

  // ---- glass ----
  // A glass cap on a solid edge kd lower. Whatever is drawn over a cap moves with it: give that node the same
  // offset and spring.
  component Cap(pressed, ht, tint, glass, rad, rim) {
    Box {
      fill: width
      height: ht
      Box { fill: width; height: ht - kd; offset: [0, kd]; radius: rad; background: rim }
      Box {
        fill: width
        height: ht - kd
        offset: [0, pressed ? kd : 0]
        animate offset: spring(0.62, 1600)
        radius: rad
        frost: tileFrost ?? 0
        border: 1
        borderColor: alpha(foreground, 0.07)
        background: alpha(tint, pressed ? min(1, glass + 0.42) : glass)
        animate background: tween(120ms, "out")
      }
    }
  }

  // ---- the LCD ----
  component Status() {
    Row {
      fill: width
      height: 22
      gap: 8
      align: center
      Canvas {
        width: 24
        height: 16
        for i in range(4) {
          rect(i * 6, 16 - (i + 1) * 4, 4, (i + 1) * 4, fill: i < num(sim.signal, 0) ? ink : alpha(ink, 0.18))
        }
      }
      Text { text: upper(sim.carrier ?? (sim.available ? "no sim" : "no service")); font: lcdFont; fontSize: 19; color: ink; maxLines: 1; weight: 1 }
      // Away from the big clock, the time sits here.
      if typing || view != "" {
        Text { text: fmtTime(now, "HH:mm"); font: lcdFont; fontSize: 19; color: ink; maxLines: 1 }
      }
      if modes.dnd {
        Text { text: " QUIET "; font: lcdFont; fontSize: 16; color: lcdSolid; background: ink; radius: 3 * corners; maxLines: 1 }
      }
      if modes.torch == true {
        Text { text: " LIGHT "; font: lcdFont; fontSize: 16; color: lcdSolid; background: ink; radius: 3 * corners; maxLines: 1 }
      }
      if !tones {
        Canvas { width: 18; height: 12; sprite(muteArt, 0, 0, 2, fill: ink) }
      }
      Text { text: bat == null ? "" : "${bat.charging ? "+" : ""}${bat.level}"; font: lcdFont; fontSize: 19; color: ink; maxLines: 1 }
      // Bars climb from the level to full once a second while charging; the outline blinks under 15% unplugged.
      Canvas {
        width: 28
        height: 14
        let lv = num(bat.level, 0)
        let base = floor(lv / 25)
        rect(0.75, 0.75, 23.5, 12.5, stroke: lv < 15 && bat.charging != true && modes.saver != true && sec % 2 == 1 ? alpha(ink, 0.3) : ink, width: 1.5)
        rect(24.5, 4, 3, 6, fill: ink)
        let filled = bat.charging == true && base < 4 ? base + sec % (5 - base) : ceil(lv / 25)
        for i in range(4) {
          rect(3 + i * 5, 3, 4, 8, fill: i < filled ? ink : alpha(ink, 0.15))
        }
      }
    }
  }

  // A soft key's label; it inverts while its key is held.
  component SoftLabel(t, held, place) {
    Row {
      weight: 1
      justify: place
      Text { text: t; font: lcdFont; fontSize: 23; maxLines: 1; padding: [4, 0]; radius: 2 * corners; color: held ? lcdSolid : ink; background: held ? ink : alpha(ink, 0); animate color: tween(80ms, "out"); animate background: tween(80ms, "out") }
    }
  }

  component Soft() {
    Row {
      fill: width
      height: 26
      gap: 4
      align: center
      SoftLabel { t: softL; held: down == "softL"; place: "start" }
      SoftLabel { t: softM; held: navZ == "mid" && softM != ""; place: "center" }
      SoftLabel { t: softR; held: down == "softR"; place: "end" }
    }
  }

  // A message, or the volume as ten blocks.
  component Banner() {
    if volN > 0 {
      Row {
        fill: width
        height: 30
        gap: 10
        align: center
        Text { text: "VOL"; font: lcdFont; fontSize: 22; color: ink }
        Canvas {
          weight: 1
          height: 14
          for i in range(10) {
            rect(i * width / 10, 0, width / 10 - 3, height, fill: i < round(num(vol.level, 0) / 10) ? ink : alpha(ink, 0.15))
          }
        }
      }
    } else if flashN > 0 {
      Text { text: upper(flash); font: lcdFont; fontSize: 22; color: lcdSolid; background: ink; align: center; maxLines: 1; padding: [6, 2]; radius: 3 * corners }
    }
  }

  // The time in round dots; unlit cells stay faintly there. Only the colon changes between minutes.
  component DotClock() {
    Box {
      fill: width
      height: bigT * 0.56
      if gpu {
        // A soft glow round the lit dots, only while the light is on; fading it never runs the shader again.
        Shader { fill: true; fallback: alpha(background, 0); opacity: bl >= 1 ? 1 : bl > 0 ? 0.4 : 0; animate opacity: tween(400ms, "out"); uniforms: { bits: dotBits, glowc: glowC, bg: background }; code: haloCode }
        Shader { fill: true; fallback: alpha(background, 0); uniforms: { bits: dotBits, inkc: ink, ghostA: 0.07 }; code: dotsCode }
      } else {
        Canvas {
          fill: true
          let p = min(width / 25, height / 7)
          let x0 = (width - p * 25) / 2
          let y0 = (height - p * 7) / 2
          for r in range(7) {
            for c in range(25) {
              circle(x0 + (c + 0.5) * p, y0 + (r + 0.5) * p, p * 0.38, fill: sub(dotRows[r], c, c + 1) == "1" ? ink : alpha(ink, 0.07))
            }
          }
        }
      }
      // The colon, the face's one heartbeat at rest: it dims and comes back once a second.
      Canvas {
        fill: true
        opacity: modes.saver == true || sec % 2 == 0 ? 1 : 0.3
        let p = min(width / 25, height / 7)
        let x0 = (width - p * 25) / 2
        let y0 = (height - p * 7) / 2
        circle(x0 + 12.5 * p, y0 + 2.5 * p, p * 0.38, fill: ink)
        circle(x0 + 12.5 * p, y0 + 4.5 * p, p * 0.38, fill: ink)
      }
    }
  }

  component Idle() {
    Box {
    fill: true
    Column {
      fill: true
      gap: 0
      Spacer { weight: 1 }
      DotClock { }
      Spacer { height: bigT * 0.1 }
      Text { text: upper(fmtTime(now, "EEE d MMM")); font: lcdFont; fontSize: 24; letterSpacing: 4; color: faint; align: center; maxLines: 1 }
      Spacer { weight: 1 }
      Spacer { height: 6 }
      for it in lines key it.k {
        Row {
          fill: width
          height: 28
          gap: 10
          align: center
          radius: 3 * corners
          ripple: false
          background: down == "l:" + it.k ? ink : alpha(ink, 0)
          animate background: tween(80ms, "out")
          onPress: down = "l:" + it.k
          onRelease: { if down == "l:" + it.k { down = "" } }
          onLongPress: lit = LIT
          onTap: {
            lit = LIT
            haptic("strong")
            if voice { sound(sConnect) }
            if it.k == "call" {
              if phoneApp != null { androidApp(phoneApp.key) }
            } else if it.k == "sms" {
              if msgApp != null { androidApp(msgApp.key) }
            } else if it.k == "note" {
              notification("open", rest[0].key)
            } else if it.k == "bell" {
              androidApp(alarm.app)
            }
          }
          Canvas { width: 22; height: 14; sprite(get(sprites, it.k), 2, 1, 2, fill: down == "l:" + it.k ? lcdSolid : ink) }
          // A line that just arrived types itself in behind a cursor, then holds.
          if revealK == it.k && revealN > 1 {
            Box {
              weight: 1
              height: 28
              Canvas {
                fill: true
                let s = upper(it.t)
                let nc = clamp(floor((time - revealAt) * 32), 0, len(s))
                text(sub(s, 0, nc) + (nc < len(s) ? "_" : ""), 0, height / 2, size: 22, font: lcdFont, color: down == "l:" + it.k ? lcdSolid : ink)
              }
            }
          } else {
            Text { text: upper(it.t); font: lcdFont; fontSize: 22; color: down == "l:" + it.k ? lcdSolid : ink; maxLines: 1; weight: 1 }
          }
        }
      }
      if song != null {
        Row {
          fill: width
          height: 28
          gap: 10
          align: center
          radius: 3 * corners
          ripple: false
          background: down == "song" ? ink : alpha(ink, 0)
          animate background: tween(80ms, "out")
          onPress: down = "song"
          onRelease: { if down == "song" { down = "" } }
          onLongPress: lit = LIT
          onTap: { lit = LIT; haptic("medium"); view = "player" }
          let s = upper(song)
          let col = down == "song" ? lcdSolid : mPlaying ? ink : alpha(ink, 0.75)
          Canvas { width: 22; height: 14; sprite(get(sprites, "song"), 4, 1, 2, fill: down == "song" ? lcdSolid : ink) }
          // A long title scrolls like a ticker, in whole 4 dp pixel steps, only while it plays and the light is on;
          // at rest it sits still, so nothing animates.
          if mPlaying && bl > 0 && len(s) * 10 > lcdW - 64 {
            Canvas {
              weight: 1
              height: 24
              let tw = len(s) * 10 + 48
              let x = -floor(((time * 32) % tw) / 4) * 4
              clip(0, 0, width, height) {
                text(s, x, height / 2, size: 22, font: lcdFont, color: col)
                text(s, x + tw, height / 2, size: 22, font: lcdFont, color: col)
              }
            }
          } else {
            Text { text: s; font: lcdFont; fontSize: 22; color: col; maxLines: 1; weight: 1 }
          }
        }
      }
      if len(lines) == 0 && song == null {
        Text { text: "NOTHING NEW"; font: lcdFont; fontSize: 22; color: faint; align: center }
      }
      Spacer { height: 6 }
    }
    // A banner or the volume floats just above the lines: the clock never moves, and on a short screen it covers the
    // date for its few seconds instead of being cut. It takes no taps.
    Column {
      fill: true
      gap: 0
      Spacer { weight: 1 }
      Banner { }
      Spacer { height: 12 + (len(lines) == 0 && song == null ? 26 : 28 * (len(lines) + (song != null ? 1 : 0))) }
    }
    }
  }

  // The pick as a 16x16 LCD icon: an app's own silhouette, a command's or a call's pixel art. Tap to open it.
  component PixelIcon() {
    Box {
      size: 48
      ripple: false
      scale: down == "icon" ? 0.92 : 1
      animate scale: spring(0.6, 1400)
      onPress: down = "icon"
      onRelease: { if down == "icon" { down = "" } }
      onLongPress: lit = LIT
      onTap: {
        lit = LIT
        haptic("strong")
        if voice { sound(sConnect) }
        goN = goN + 1
        go = {n: goN, c: cur, t: sec}
        q = ""
        sel = 0
      }
      if cur.kind == "app" {
        // The app's initial on an LCD badge: its own silhouette needs owl 24, which the store doesn't take yet.
        if gpu {
          Shader { fill: true; fallback: alpha(background, 0); uniforms: { bits: range(16).map(i => 0), inkc: ink, ghost: alpha(ink, 0.06) }; code: pxCode }
        }
        Box {
          fill: true
          align: center
          Text { text: upper(sub(cur.name, 0, 1)); font: lcdFont; fontSize: 46; color: ink; maxLines: 1; align: center }
        }
      } else if gpu {
        Shader { fill: true; fallback: alpha(background, 0); uniforms: { bits: pxBits, inkc: ink, ghost: alpha(ink, 0.06) }; code: pxCode }
      } else {
        Canvas {
          fill: true
          let art = get(px16, cur.kind == "call" ? "call" : cur.id, px16.menu)
          let cs = width / 16
          for r in range(16) {
            for c in range(16) {
              rect(c * cs + cs * 0.1, r * cs + cs * 0.1, cs * 0.8, cs * 0.8, fill: sub(art[r], c, c + 1) == "x" ? ink : alpha(ink, 0.06))
            }
          }
        }
      }
    }
  }

  component Typing() {
    Column {
      fill: true
      gap: 3
      Row {
        fill: width
        height: 60
        gap: 0
        align: center
        if cur != null && len(q) <= 8 {
          PixelIcon { }
        }
        Spacer { weight: 1 }
        Text { text: q; font: lcdFont; fontSize: len(q) > 12 ? 36 : 56; color: ink; maxLines: 1 }
        Canvas {
          width: 14
          height: 44
          // It blinks while the light is on; at rest it stays, so nothing animates.
          if bl == 0 || floor(time * 2) % 2 == 0 { rect(5, 4, 6, 36, fill: ink) }
        }
      }
      Spacer { height: 4 }
      // Dialling abroad: the time where the call would ring; faint and a moon while they're asleep.
      for z in zoneShow key z.city {
        Row {
          fill: width
          height: 30
          gap: 10
          align: center
          let hr = num(fmtTime(now, "H", z.z), 12)
          let night = hr >= 22 || hr < 7
          Canvas { width: 14; height: 14; sprite(hr >= 7 && hr < 19 ? sunArt : moonArt, 0, 0, 2, fill: night ? faint : ink) }
          Text { text: upper(z.city); font: lcdFont; fontSize: 22; color: ink; maxLines: 1; weight: 1 }
          Text { text: upper(fmtTime(now, "EEE HH:mm", z.z)); font: lcdFont; fontSize: 22; color: night ? faint : ink; maxLines: 1 }
        }
      }
      if info {
        Column {
          fill: width
          gap: 0
          Text { text: "PHONE"; font: lcdFont; fontSize: 18; color: faint }
          Text { text: upper("${dev.maker ?? ""} ${dev.model ?? ""}"); font: lcdFont; fontSize: 26; color: ink; maxLines: 1 }
          Text { text: "ANDROID ${dev.android ?? "…"} · SDK ${dev.sdk ?? "…"}"; font: lcdFont; fontSize: 22; color: ink; maxLines: 1 }
          Text { text: upper(dev.soc ?? ""); font: lcdFont; fontSize: 22; color: ink; maxLines: 1 }
          Text { text: bat == null ? "" : "BATTERY ${round(num(bat.temp, 0) * 9 / 5 + 32)}°F · ${upper(bat.health ?? "ok")}"; font: lcdFont; fontSize: 22; color: ink; maxLines: 1 }
          Text { text: "HOLD # · KEY TONES ${tones ? (soundOk ? "ON" : "ON · SILENT NOW") : "OFF"}"; font: lcdFont; fontSize: 18; color: faint; maxLines: 1 }
        }
      } else if len(cands) == 0 {
        if len(zoneShow) == 0 {
          Text { text: "NO MATCH"; font: lcdFont; fontSize: 24; color: faint }
        }
      } else {
        // The selection is one bar that glides between the rows (32 high, 3 apart).
        Box {
          fill: width
          Box { fill: width; height: 32; radius: 3 * corners; background: ink; offset: [0, selI * 35]; animate offset: spring(0.8, 900) }
          Column {
            fill: width
            gap: 3
            for c, i in shown key "${c.kind}${c.key ?? c.id ?? c.num}" {
              Row {
                fill: width
                height: 32
                gap: 8
                align: center
                padding: [6, 0]
                ripple: false
                onLongPress: lit = LIT
                onTap: {
                  lit = LIT
                  if i == selI {
                    haptic("strong")
                    if voice { sound(sConnect) }
                    goN = goN + 1
                    go = {n: goN, c: c, t: sec}
                    q = ""
                    sel = 0
                  } else {
                    haptic("light")
                    sel = from + i
                  }
                }
                Text {
                  spans: c.kind == "call" ? ["Call ", {text: c.num, color: i == selI ? background : accent}] : c.wi == null ? [c.name] : [sub(c.name, 0, c.off), {text: sub(c.name, c.off, min(c.off + len(q), len(c.name))), color: i == selI ? background : accent}, sub(c.name, min(c.off + len(q), len(c.name)), len(c.name))]
                  font: lcdFont
                  fontSize: 27
                  color: i == selI ? alpha(lcdSolid, 0.6) : ink
                  animate color: tween(90ms, "out")
                  maxLines: 1
                  weight: 1
                }
                Text {
                  text: upper(c.kind == "app" ? (c.work ?? "") : c.kind == "call" ? "dial" : c.id == "torch" ? (modes.torch == true ? "on" : "off") : c.id == "quiet" ? (modes.dnd ? "on" : "off") : c.id == "music" ? (mPlaying ? "pause" : "play") : "cmd")
                  font: lcdFont
                  fontSize: 18
                  color: i == selI ? lcdSolid : faint
                  animate color: tween(90ms, "out")
                  maxLines: 1
                }
              }
            }
          }
        }
      }
      Spacer { weight: 1 }
      Banner { }
      Spacer { height: 4 }
    }
  }

  // What's playing, as an LCD would show it: the cover in dots, a ticker, who and where, blocks and times.
  component Player() {
    Column {
      fill: true
      gap: 0
      align: center
      Spacer { weight: 1 }
      Box {
        size: artS
        radius: 3 * corners
        clip: true
        if m.art != null {
          if gpu {
            Shader { fill: true; fallback: alpha(plateC, 0.85); uniforms: { art: mArt, ink: ink, plate: alpha(plateC, 0.85), bg: background, cells: floor(artS / 3) }; code: coverCode }
          } else {
            Image { src: m.art; fit: cover; fill: true; opacity: 0.85 }
          }
        } else if gpu {
          Shader { fill: true; fallback: alpha(background, 0); uniforms: { bits: noteBits, inkc: ink, ghost: alpha(ink, 0.06) }; code: pxCode }
        } else {
          Canvas {
            fill: true
            let art = px16.music
            let cs = width / 16
            for r in range(16) {
              for c in range(16) {
                rect(c * cs + cs * 0.1, r * cs + cs * 0.1, cs * 0.8, cs * 0.8, fill: sub(art[r], c, c + 1) == "x" ? ink : alpha(ink, 0.06))
              }
            }
          }
        }
      }
      Spacer { height: 10 }
      Box {
        fill: width
        height: 28
        align: center
        let s = upper(mTitle ?? "")
        // A long title scrolls only while it plays and the light is on.
        if mPlaying && bl > 0 && len(s) * 10 > lcdW - 32 {
          Canvas {
            fill: true
            let tw = len(s) * 10 + 48
            let x = -floor(((time * 32) % tw) / 4) * 4
            clip(0, 0, width, height) {
              text(s, x, height / 2, size: 22, font: lcdFont, color: ink)
              text(s, x + tw, height / 2, size: 22, font: lcdFont, color: ink)
            }
          }
        } else {
          Text { text: s; font: lcdFont; fontSize: 22; color: ink; maxLines: 1; align: center }
        }
      }
      Text { text: upper(songBy); font: lcdFont; fontSize: 18; color: faint; maxLines: 1; align: center }
      Spacer { weight: 1 }
      Canvas {
        fill: width
        height: 12
        let f = num(m.duration, 0) > 0 ? clamp(num(m.position, 0) / m.duration, 0, 1) : 0
        for i in range(20) {
          rect(i * width / 20, 0, width / 20 - 2, height, fill: i < round(f * 20) ? ink : alpha(ink, 0.15))
        }
      }
      Spacer { height: 4 }
      Row {
        fill: width
        gap: 8
        Text { text: fmtTime(num(m.position, 0), num(m.duration, 0) >= 3600 ? "H:mm:ss" : "m:ss", "UTC"); font: lcdFont; fontSize: 20; color: ink; maxLines: 1; weight: 1 }
        Text { text: num(m.duration, 0) > 0 ? fmtTime(m.duration, m.duration >= 3600 ? "H:mm:ss" : "m:ss", "UTC") : ""; font: lcdFont; fontSize: 20; color: faint; maxLines: 1 }
      }
      Box { fill: width; height: 30; align: center; Banner { } }
      Spacer { height: 4 }
    }
  }

  component Lcd() {
    Box {
      fill: true
      radius: 6 + 14 * corners
      clip: true
      frost: tileFrost ?? 0
      border: 1
      borderColor: alpha(foreground, 0.10)
      background: alpha(bl > 0 ? mix(background, accent, 0.13) : plateC, min(1, lcdA + (bl >= 1 ? 0.06 : bl > 0 ? 0.03 : 0)))
      animate background: tween(450ms, "ease")
      // 1 · the light guide's slow wash: it warms up as the light comes on and is the afterglow as it goes.
      if gpu {
        Shader { fill: true; fallback: alpha(background, 0); opacity: bl; animate opacity: tween(1600ms, "out"); uniforms: { glow: glowC, bg: background }; code: washCode }
      } else {
        Box { fill: true; opacity: bl; animate opacity: tween(1600ms, "out"); background: linear(0, 0, 0, 1, [alpha(glowC, 0), alpha(glowC, 0.03), alpha(glowC, 0.12)]) }
      }
      // 2 · three LEDs under the bottom edge: they snap on and off.
      Box {
        fill: true
        opacity: bl
        animate opacity: tween(140ms, "out")
        Shader { fill: true; fallback: alpha(background, 0); uniforms: { glow: glowC, bg: background }; code: guideCode }
      }
      // 3 · the pixel grid under the ink, and the bezel's recess shadow under its top edge.
      Shader { fill: true; fallback: alpha(background, 0); uniforms: { gap: alpha(background, 0.22), fg: foreground, wdp: lcdW }; code: gridCode }
      if !gpu {
        Box { fill: width; height: 10; background: linear(0, 0, 0, 1, [alpha(background, 0.28), alpha(background, 0)]) }
      }
      // 4 · the bezel's lit chamfer.
      Box { fill: width; height: 1; background: linear(0, 0, 1, 0, [alpha(foreground, 0), alpha(foreground, 0.22), alpha(foreground, 0)]) }
      // 5 · the ink, which sits back while the light is off.
      Column {
        fill: true
        gap: 0
        padding: [16, 12, 16, 10]
        opacity: inkLvl
        animate opacity: tween(220ms, "out")
        Status { }
        if view == "player" { Player { weight: 1; fill: width } } else if typing { Typing { weight: 1; fill: width } } else { Idle { weight: 1; fill: width } }
        Soft { }
      }
    }
  }

  // ---- the keys ----
  component Nav() {
    Row {
      fill: width
      height: navH
      gap: 12
      align: center
      Column {
        weight: 1
        gap: 10
        // Left soft key: the app drawer (Prev in the player; held, ten seconds back).
        Box {
          fill: width
          height: softH
          align: center
          ripple: false
          onPress: down = "softL"
          onRelease: { if down == "softL" { down = "" } }
          onTap: {
            lit = LIT
            haptic("medium")
            if view == "player" { media("previous") } else { launcher("drawer") }
          }
          onLongPress: {
            lit = LIT
            if view == "player" {
              if m.canSeek == true {
                media("seek", max(0, num(m.position, 0) - 10))
              } else {
                flash = "can't seek"
                flashN = 2
              }
            } else {
              launcher("drawer")
            }
          }
          Box {
            fill: width
            height: 28 + kd
            Cap { pressed: down == "softL"; ht: 28 + kd; tint: background; glass: glassA; rad: 14 * corners; rim: edgeC }
            Box {
              fill: width
              height: 28
              align: center
              offset: [0, down == "softL" ? kd : 0]
              animate offset: spring(0.62, 1600)
              Box { width: 40; height: 5; radius: 2.5; background: down == "softL" || bl > 0 ? glowC : alpha(foreground, 0.9); border: 1; borderColor: alpha(background, 0.35); animate background: tween(200ms, "out") }
            }
          }
        }
        // Call: what's picked, or the phone app; the player's own screen in the player.
        Box {
          fill: width
          height: callH
          ripple: false
          onPress: down = "call"
          onRelease: { if down == "call" { down = "" } }
          onTap: {
            lit = LIT
            if view == "player" {
              haptic("strong")
              media("open")
            } else if info {
              haptic("medium")
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                haptic("strong")
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                haptic("medium")
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              // A second press right after opening something: the new app is on its way, so nothing more.
              haptic("medium")
            } else {
              haptic("strong")
              if voice { sound(sConnect) }
              if phoneApp != null { androidApp(phoneApp.key) } else { url("tel:") }
            }
          }
          // Held, it does the same (the launcher gives the buzz), so a slow press still calls.
          onLongPress: {
            lit = LIT
            if view == "player" {
              media("open")
            } else if info {
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              // A second press right after opening something: the new app is on its way, so nothing more.
              lit = LIT
            } else {
              if voice { sound(sConnect) }
              if phoneApp != null { androidApp(phoneApp.key) } else { url("tel:") }
            }
          }
          Cap { pressed: down == "call"; ht: callH; tint: mix(background, green, callMix); glass: glassA; rad: 30 * corners; rim: alpha(green, 0.35) }
          Box {
            fill: width
            height: callH - kd
            align: center
            offset: [0, down == "call" ? kd : 0]
            animate offset: spring(0.62, 1600)
            // It rocks like a ringing phone for two minutes after a missed call.
            Canvas { width: 40; height: 16; rotation: wob ? 14 : 0; animate rotation: spring(0.15, 700); sprite(get(sprites, "handset"), 1, 1, 3, fill: alpha(background, 0.55)); sprite(get(sprites, "handset"), 0, 0, 3, fill: green) }
          }
        }
      }
      // The navigation pad: up, select, down. Its ring is the one indicator: the LED and the song's progress.
      Box {
        width: navH
        height: navH
        ripple: false
        scale: navZ != "" ? 0.97 : 1
        animate scale: spring(0.6, 1400)
        onPress: navZ = y < navH * 0.34 ? "up" : y > navH * 0.66 ? "down" : "mid"
        onRelease: navZ = ""
        onLongPress: lit = LIT
        onTap: {
          lit = LIT
          let zone = y < navH * 0.34 ? "up" : y > navH * 0.66 ? "down" : "mid"
          if zone == "mid" {
            if view == "player" {
              haptic("medium")
              media("toggle")
            } else if info {
              haptic("medium")
              q = ""
              sel = 0
            } else if typing {
              if cur != null {
                haptic("strong")
                if voice { sound(sConnect) }
                goN = goN + 1
                go = {n: goN, c: cur, t: sec}
                q = ""
                sel = 0
              } else {
                haptic("medium")
                if voice { sound(sNope) }
              }
            } else if sec >= num(go.t, 0) && sec - num(go.t, 0) < 2 {
              // A second press right after opening something doesn't switch Do Not Disturb by accident.
              haptic("medium")
            } else {
              haptic("medium")
              dnd("toggle")
            }
          } else if info {
            haptic("medium")
          } else if typing {
            if zone == "up" {
              haptic(at <= 0 ? "medium" : "light")
              sel = max(0, at - 1)
            } else {
              haptic(at >= len(cands) - 1 ? "medium" : "light")
              sel = min(max(0, len(cands) - 1), at + 1)
            }
          } else {
            let lv = num(vol.level, 50)
            haptic((zone == "up" && lv >= 100) || (zone == "down" && lv <= 0) ? "medium" : "light")
            if zone == "up" { volume("up") } else { volume("down") }
            volN = 2
          }
        }
        Box { fill: true; radius: navH / 2; frost: tileFrost ?? 0; background: alpha(background, glassA); border: 1; borderColor: alpha(foreground, 0.08) }
        Canvas {
          fill: true
          let r = width / 2
          let rr = r - 1.5
          circle(r, r, rr, stroke: alpha(foreground, 0.16), width: 1.5)
          if m.playing == true && num(m.duration, 0) > 0 {
            arc(r, r, rr, 0, 360 * clamp(num(m.position, 0) / m.duration, 0, 1), stroke: alpha(foreground, 0.4), width: 1.5, cap: round)
          }
          if ledOn {
            arc(r, r, rr - 2.5, -9, 18, stroke: alpha(ledC, 0.28), width: 5, cap: round)
            arc(r, r, rr - 2.5, -6, 12, stroke: ledC, width: 3, cap: round)
          }
          circle(r, r, r * 0.3, fill: navZ == "mid" ? alpha(glowC, 0.7) : bl > 0 ? alpha(glowC, 0.45) : alpha(foreground, 0.22))
          circle(r, r, r * 0.3, stroke: alpha(background, 0.3), width: 1)
          // The arrows on a dark keyline, so they read on bright glass too.
          let up = [[r - 7, r * 0.42], [r + 7, r * 0.42], [r, r * 0.42 - 8]]
          let dn = [[r - 7, r * 1.58], [r + 7, r * 1.58], [r, r * 1.58 + 8]]
          path(up, closed: true, stroke: alpha(background, 0.45), width: 3)
          path(dn, closed: true, stroke: alpha(background, 0.45), width: 3)
          path(up, closed: true, fill: navZ == "up" ? glowC : foreground)
          path(dn, closed: true, fill: navZ == "down" ? glowC : foreground)
        }
      }
      Column {
        weight: 1
        gap: 10
        // Right soft key: back a letter while typing (held, clear), the torch when idle (held, dimmed); Next in the player.
        Box {
          fill: width
          height: softH
          align: center
          ripple: false
          onPress: down = "softR"
          onRelease: { if down == "softR" { down = "" } }
          onTap: {
            lit = LIT
            if view == "player" {
              haptic("medium")
              media("next")
            } else if typing {
              haptic("light")
              q = sub(q, 0, len(q) - 1)
              sel = 0
            } else {
              haptic("medium")
              // At full, by name: a toggle would keep the last level, the dim one after a hold.
              torch(modes.torch == true ? 0 : 100)
            }
          }
          onLongPress: {
            lit = LIT
            if view == "player" {
              if m.canSeek == true {
                media("seek", num(m.position, 0) + 10)
              } else {
                flash = "can't seek"
                flashN = 2
              }
            } else if typing {
              q = ""
              sel = 0
            } else {
              torch(25)
              flash = modes.torchLevel == null ? "light" : "light 25%"
              flashN = 3
            }
          }
          Box {
            fill: width
            height: 28 + kd
            Cap { pressed: down == "softR"; ht: 28 + kd; tint: background; glass: glassA; rad: 14 * corners; rim: edgeC }
            Box {
              fill: width
              height: 28
              align: center
              offset: [0, down == "softR" ? kd : 0]
              animate offset: spring(0.62, 1600)
              Box { width: 40; height: 5; radius: 2.5; background: down == "softR" || bl > 0 ? glowC : alpha(foreground, 0.9); border: 1; borderColor: alpha(background, 0.35); animate background: tween(200ms, "out") }
            }
          }
        }
        // End: hang up, which clears, goes back to the idle screen and puts the light out.
        Box {
          fill: width
          height: callH
          ripple: false
          onPress: down = "end"
          onRelease: { if down == "end" { down = "" } }
          onTap: {
            if q != "" {
              haptic("strong")
              if voice { sound(sBusy) }
            } else {
              haptic("medium")
            }
            q = ""
            sel = 0
            view = ""
            lit = 0
            flashN = 0
            volN = 0
            revealN = 0
            revealK = ""
            seenAt = sec
          }
          // Held, it hangs up all the same.
          onLongPress: {
            q = ""
            sel = 0
            view = ""
            lit = 0
            flashN = 0
            volN = 0
            revealN = 0
            revealK = ""
            seenAt = sec
          }
          Cap { pressed: down == "end"; ht: callH; tint: mix(background, red, endMix); glass: glassA; rad: 30 * corners; rim: alpha(red, 0.35) }
          Box {
            fill: width
            height: callH - kd
            align: center
            offset: [0, down == "end" ? kd : 0]
            animate offset: spring(0.62, 1600)
            Canvas { width: 40; height: 16; rotate(180, 20, 8) { sprite(get(sprites, "handset"), 0, 0, 3, fill: alpha(background, 0.55)); sprite(get(sprites, "handset"), 1, 1, 3, fill: red) } }
          }
        }
      }
    }
  }

  component Keypad() {
    Grid {
      columns: 3
      gap: 6
      fill: width
      for k, i in pad key k.d {
        Box {
          fill: width
          height: kh
          ripple: false
          onPress: down = k.d
          onRelease: { if down == k.d { down = "" } }
          onTap: {
            haptic("light")
            lit = LIT
            if voice { sound((q + k.d) == "*#06#" ? sSit : k.t) }
            view = ""
            if len(q) < 24 { q = q + k.d }
            sel = 0
          }
          onLongPress: {
            lit = LIT
            if k.d == "0" {
              view = ""
              q = q + "+"
              sel = 0
            } else if k.d == "#" {
              let turnOn = !tones
              tones = turnOn
              flash = !turnOn ? "key tones off" : soundOk ? "key tones on" : "key tones on · silent now"
              flashN = 3
              if turnOn && soundOk { sound(kHash) }
            } else if k.d == "*" {
              view = ""
              q = q + "*"
              sel = 0
            } else if len(q) == 1 && q == k.d && get(speed, k.d, null) != null {
              // A tap came first (a hold let go too soon): this hold still opens the speed dial.
              q = ""
              sel = 0
              armK = ""
              if voice { sound(sConnect) }
              goN = goN + 1
              go = {n: goN, c: get(speed, k.d, null), t: sec}
            } else if typing && cur != null {
              let had = get(speed, k.d, null)
              if had != null && had.name != cur.name && !(armK == k.d && flashN > 0 && startsWith(flash, "replace ")) {
                // Something else is on this key: ask before replacing it.
                armK = k.d
                flash = "replace ${had.name}? hold ${k.d} again"
                flashN = 3
              } else {
                armK = ""
                speed = set(speed, k.d, {kind: cur.kind, key: cur.key, id: cur.id, num: cur.num, name: cur.name})
                flash = "${cur.name} on ${k.d}"
                flashN = 3
                if voice { sound(sSaved) }
                q = ""
                sel = 0
              }
            } else if get(speed, k.d, null) != null {
              if voice { sound(sConnect) }
              goN = goN + 1
              go = {n: goN, c: get(speed, k.d, null), t: sec}
            } else {
              flash = "spell a name, hold ${k.d}"
              flashN = 3
            }
          }
          Cap { pressed: down == k.d; ht: kh; tint: bl > 0 ? mix(background, glowC, 0.08) : background; glass: glassA; rad: kr; rim: edgeC }
          Column {
            fill: width
            height: kh - kd
            offset: [0, down == k.d ? kd : 0]
            animate offset: spring(0.62, 1600)
            gap: 0
            align: center
            justify: center
            // The legends light row by row from the top as the backlight comes on.
            Text { text: k.d; font: inter; fontSize: digitFs; fontWeight: 300; align: center; offset: [0, k.d == "*" ? 0.16 * digitFs : 0]; color: bl > 0 ? mix(foreground, glowC, 0.45) : foreground; animate color: tween(0.15 + floor(i / 3) * 0.15, "in") }
            Text { text: upper(k.l); font: inter; fontSize: 9; fontWeight: 500; letterSpacing: 2.5; align: center; color: bl > 0 ? alpha(glowC, 0.9) : alpha(foreground, 0.72); animate color: tween(0.15 + floor(i / 3) * 0.15, "in") }
          }
          // A light where a speed dial waits.
          if get(speed, k.d, null) != null {
            Canvas {
              fill: width
              height: kh - kd
              offset: [0, down == k.d ? kd : 0]
              animate offset: spring(0.62, 1600)
              if bl > 0 { circle(width - 12, 12, 5.5, fill: alpha(glowC, 0.22)) }
              circle(width - 12, 12, 2.5, fill: bl > 0 ? glowC : alpha(accent, 0.55))
            }
          }
        }
      }
    }
  }

  if wide {
    Row {
      fill: true
      gap: 20
      padding: [14 + screenLeft, screenTop + 10, 14 + screenRight, 10 + screenInset]
      Lcd { weight: 1; fill: height }
      Column {
        width: min(W * 0.42, 380)
        fill: height
        gap: 12
        Spacer { weight: 1 }
        Nav { }
        Keypad { }
      }
    }
  } else {
    Column {
      fill: true
      gap: 0
      padding: [14 + screenLeft, screenTop + 10, 14 + screenRight, 0]
      Lcd { weight: 1; fill: width }
      Spacer { height: 14 }
      Nav { }
      Spacer { height: 12 }
      Keypad { }
      Spacer { height: screenInset + 10 }
    }
  }
}
