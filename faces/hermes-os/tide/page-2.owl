face "tide · now" {
  // Tide: one look over four pages, frosted glass in the Omarchy theme's colours over its wallpaper, so it follows
  // whichever theme and background are picked. Each thing has one home: Calendar (the month and the day's events) ·
  // Now (this page: your tasks) · Pulse (Claude usage, notifications, switches) · Pond (koi, and the music). What's
  // read sits high up; what's tapped sits low, under the thumb, and the dock and the page bar stay put across pages.
  // This page: the time and weather, battery, Claude and the next alarm at a glance, then
  // your tasks in one list to scroll, and the dock.
  meta {
    owl: 23
    description: "Tide · Now: the time, weather, battery, Claude usage and alarm at a glance, and your tasks"
    version: "1.2"
    license: "MIT"
    category: "productivity"
  }
  edge: true
  padding: 0
  // While the dock is arranged the page keeps every touch, so an app held before it's dragged doesn't open home's menu.
  lock: dkEdit
  // Only the dock's jiggle, while it's arranged, moves by the clock.
  fps: 40
  asset i_battery_full = base64""
  asset i_bolt = base64""
  asset i_alarm = base64""
  asset i_check = base64""
  asset i_add = base64""
  asset i_close = base64""
  asset i_chevron_right = base64""
  asset i_refresh = base64""
  asset i_arrow_upward = base64""
  asset dk_add = base64""
  asset dk_close = base64""
  asset dk_remove = base64""
  asset dk_search = base64""

  source now = clock every 1m
  source bat = android.battery
  source alarm = android.alarm
  source here = android.location
  source apps = android.apps
  // The dock as you arranged it, in one small file in Linux that the four pages share. Each page keeps its own copy
  // too, so it holds while Linux is off.
  source dkFile = file("~/.local/share/tide/dock.json") optional

  // The weather where the phone is, once location is allowed; until then wttr's guess from the IP.
  source wx = http(here == null ? null : here.available ? "https://wttr.in/${fixed(here.lat, 2)},${fixed(here.lon, 2)}?format=j1" : "https://wttr.in/?format=j1") every 30m timeout 10s json

  // Your tasks, kept in one small file in Linux so other pages and scripts can read them too.
  source tf = file("~/.local/share/tide/tasks.json") optional
  state pend = null
  on tf { pend = null }
  // Claude's plan limits, as /usage shows them, with the login Claude Code keeps (sent only to Anthropic, as Claude
  // Code itself does); the last good answer is kept, so a failed fetch shows it rather than nothing.
  source cl = cmd("""
    c=~/.cache/tide-claude-usage.json
    mkdir -p ~/.cache
    j=$(tr -d '\n' 2>/dev/null < ~/.claude/.credentials.json)
    t=$(printf '%s' "$j" | grep -o '"accessToken" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    p=$(printf '%s' "$j" | grep -o '"subscriptionType" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    if [ -n "$t" ]; then
      code=$(printf 'Authorization: Bearer %s\n' "$t" | curl -s -m 15 -o "$c.new" -w '%{http_code}' -H @- -H 'anthropic-beta: oauth-2025-04-20' https://api.anthropic.com/api/oauth/usage)
      [ "$code" = 200 ] && mv "$c.new" "$c"
      rm -f "$c.new"
    fi
    if [ -s "$c" ]; then printf '{"at":%s,"plan":"%s","login":%s,"u":' "$(stat -c %Y "$c")" "$p" "$([ -n "$t" ] && echo true || echo false)"; cat "$c"; printf '}\n'; else echo '{"error":"no data"}'; fi
  """) every 10m json timeout 30s optional

  state unitF = true persist
  state held = ""
  // The dock: its apps in order (null: the fourteen as shipped) and whether it's being arranged; the app under the
  // finger, where it came from and how far it's been carried; the app picker (-2 shut, -1 adding, else the place being
  // changed) and what's typed in it; whether Reset was tapped once, and when arranging ends by itself. dkDirty says
  // this page's order hasn't been seen in the shared file yet (kept, so an order arranged while Linux was off is
  // written once it's there), and dkTries how often it was written again over another page's.
  state dock = null persist
  state dkEdit = false
  state dkId = ""
  state dkFrom = 0
  state dkX = 0
  state dkY = 0
  state dkPick = -2
  state dkQ = ""
  state dkDirty = false persist
  state dkTries = 0
  state dkSure = false
  state dkEnds = 0
  // The row of the list last touched (so roughly how far down it's scrolled), and a count that, raised, builds the
  // list anew at its top: the back-to-top key.
  state seen = 0
  state topGen = 0
  // A task being typed, the add box's key (raised to let go of the focus when the keyboard goes away), and how much
  // of the bottom the navigation bar covers, kept from while the keyboard is down.
  state draft = ""
  state inputGen = 0
  state navInset = 0

  // ── look ──────────────────────────────────────────────────────────────────────────────────────────────────────
  let inter = "https://raw.githubusercontent.com/google/fonts/main/ofl/inter/Inter%5Bopsz,wght%5D.ttf"
  let R = 22 * (corners ?? 1)
  let r2 = 14 * (corners ?? 1)
  let glass = alpha(background, clamp(tileOpacity ?? 0.55, 0.45, 0.9))
  let fz = tileFrost ?? 0
  let hair = alpha(foreground, 0.10)
  let soft = alpha(foreground, 0.66)
  let faint = alpha(foreground, 0.40)
  let tabs = [{id: "plan", name: "Calendar", p: -3}, {id: "now", name: "Now", p: -2}, {id: "pulse", name: "Pulse", p: -1}, {id: "pond", name: "Pond", p: 0}]

  // ── data ──────────────────────────────────────────────────────────────────────────────────────────────────────
  let hour = num(fmtTime(now, "H"))
  let greeting = hour < 5 ? "Good night" : hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening"
  let cur = wx.current_condition[0]
  let night = hour < 6 || hour >= 18
  let temp = unitF ? cur.temp_F : cur.temp_C
  let hi = unitF ? wx.weather[0].maxtempF : wx.weather[0].maxtempC
  let lo = unitF ? wx.weather[0].mintempF : wx.weather[0].mintempC
  let skyTint = contains(["113", "116"], cur.weatherCode) ? (night ? blue : yellow) : foreground

  let tasks = pend ?? (tf == null || tf == "" ? [] : parseJson(tf) ?? [])
  let todo = tasks.filter(t => !t.done)
  let done = tasks.filter(t => t.done)
  let openCount = len(todo)
  // The list under its headings: what's still to do, then what's ticked off.
  let rows = flatten([
    len(todo) > 0 ? [{id: "h-mine", head: "TO DO · ${len(todo)}"}] : [],
    todo,
    len(done) > 0 ? [{id: "h-done", head: "DONE · ${len(done)}"}] : [],
    done
  ])
  // The keyboard is up, adding a task. Nothing on the page moves for it (the keyboard covers the dock): a page that
  // moves under a focused field makes Android bring the keyboard back after it's put away.
  let inset = screenInset ?? 0
  let kb = inset > 120
  // Halfway down a list long enough to want it, the key back to the top shows.
  let showTop = len(rows) > 12 && seen >= len(rows) / 2

  let u = cl.u
  let week = u.seven_day.utilization
  let five = u.five_hour.utilization
  let worst = max(week ?? 0, five ?? 0)
  let usageTint = worst >= 90 ? red : worst >= 70 ? yellow : green

  // The fourteen apps, found among the phone's by package, else by name; a link stands in for one that isn't there.
  // They're what the dock starts with, and what Reset brings back; spotifyApp and clockApp are found among them too.
  let A = apps ?? []
  let slots = [
    {id: "phone", label: "Phone", tint: green, alt: "tel:", pk: ["com.google.android.dialer", "com.samsung.android.dialer", "com.android.dialer"], nm: ["phone"]},
    {id: "msg", label: "Messages", tint: blue, alt: "sms:", pk: ["com.google.android.apps.messaging", "com.samsung.android.messaging"], nm: ["messages", "messaging"]},
    {id: "gmail", label: "Gmail", tint: red, alt: "https://mail.google.com", pk: ["com.google.android.gm"], nm: ["gmail"]},
    {id: "yahoo", label: "Yahoo", tint: magenta, alt: "https://mail.yahoo.com", pk: ["com.yahoo.mobile.client.android.mail"], nm: ["yahoo mail", "yahoo"]},
    {id: "chrome", label: "Chrome", tint: yellow, alt: "https://www.google.com", pk: ["com.android.chrome"], nm: ["chrome"]},
    {id: "camera", label: "Camera", tint: foreground, alt: "", pk: ["com.google.android.GoogleCamera", "com.sec.android.app.camera", "com.android.camera", "com.android.camera2"], nm: ["camera"]},
    {id: "spotify", label: "Spotify", tint: green, alt: "https://open.spotify.com", pk: ["com.spotify.music"], nm: ["spotify"]},
    {id: "maps", label: "Maps", tint: cyan, alt: "geo:0,0", pk: ["com.google.android.apps.maps"], nm: ["maps"]},
    {id: "clock", label: "Clock", tint: blue, alt: "", pk: ["com.google.android.deskclock", "com.sec.android.app.clockpackage", "com.android.deskclock"], nm: ["clock"]},
    {id: "photos", label: "Photos", tint: orange, alt: "", pk: ["com.google.android.apps.photos", "com.sec.android.gallery3d"], nm: ["photos", "gallery"]},
    {id: "cal", label: "Calendar", tint: accent, alt: "calendar", pk: ["com.google.android.calendar", "com.samsung.android.calendar"], nm: ["calendar"]},
    {id: "bc", label: "Basecamp", tint: yellow, alt: "https://launchpad.37signals.com", pk: ["com.basecamp.bc3"], nm: ["basecamp"]},
    {id: "settings", label: "Settings", tint: blue, alt: "", pk: ["com.android.settings"], nm: ["settings"]},
    {id: "claude", label: "Claude", tint: orange, alt: "https://claude.ai", pk: ["com.anthropic.claude"], nm: ["claude"]}
  ].map(s => merge(s, {app: A.find(a => a.profile == null && contains(s.pk, a.package)) ?? A.find(a => a.profile == null && contains(s.nm, lower(a.name)))}))
  let spotifyApp = slots[6].app
  let clockApp = slots[8].app

  // The dock's apps in order. The first six are the dock, the same on every page; the Calendar page shows all of them
  // (fourteen at most), seven to a row, the first seven below. Until it's arranged it's the fourteen above: the dock's
  // six and Claude, then the other seven. An app picked from the phone is kept by its key, package and name, and gets
  // a tint of its own from the theme.
  let dkWide = false
  let dkDef = ["phone", "msg", "gmail", "yahoo", "chrome", "camera", "claude", "spotify", "maps", "clock", "photos", "cal", "bc", "settings"].map(s => {id: s})
  let dkTints = [green, blue, red, magenta, yellow, cyan, orange, accent]
  let dkEnts = (dock ?? dkDef).filter(e => e.key != null || any(slots, s => s.id == e.id)).take(14)
  let dkAll = dkEnts.map(e => e.key == null ? slots.find(s => s.id == e.id) : {id: e.id, label: e.name, tint: dkTints[floor(hash(e.pkg) * 8)], alt: "", app: A.find(a => a.key == e.key) ?? A.find(a => a.profile == null && a.package == e.pkg)})
  let dkPer = dkWide ? 7 : 6
  let dkShown = dkAll.take(dkWide ? 14 : 6).map((s, i) => merge(s, {i: i}))
  let dkN = len(dkShown)
  // While arranging, a free place shows as an Add key after the last app.
  let dkAdd = dkEdit && dkN < (dkWide ? 14 : 6)
  let dkCells = dkN + (dkAdd ? 1 : 0)
  let dkRows = dkCells > dkPer ? 2 : 1
  // While arranging, the keys are placed by hand, so they can slide: the dock's width inside its glass, a key's share
  // of it, and how far one row is from the next (a key, its name and the gap). Each row is centred.
  let dkW = (tileWidth ?? 420) - 44
  let dkCw = dkW / dkPer
  let dkPitch = 70
  let dkAddR = floor(dkN / dkPer)
  let dkAddX = (dkW - (dkAddR == 0 ? min(dkCells, dkPer) : dkCells - dkPer) * dkCw) / 2 + (dkN - dkAddR * dkPer) * dkCw
  // The app being carried: its row and where its left edge is, and from them the place it would land in.
  let dkR0 = floor(dkFrom / dkPer)
  let dkLeft = (dkW - (dkR0 == 0 ? min(dkCells, dkPer) : dkCells - dkPer) * dkCw) / 2 + (dkFrom - dkR0 * dkPer) * dkCw + dkX
  let dkTR = dkRows == 1 ? 0 : clamp(dkR0 - round(dkY / dkPitch), 0, 1)
  let dkTo = dkId == "" ? dkFrom : clamp(dkTR * dkPer + clamp(round((dkLeft - (dkW - (dkTR == 0 ? min(dkCells, dkPer) : dkCells - dkPer) * dkCw) / 2) / dkCw), 0, dkPer - 1), 0, dkN - 1)
  let dkDrag = dkId == "" ? null : dkShown.find(s => s.id == dkId)
  // The picker's apps: every app on the phone that isn't in the dock yet, and the links among the fourteen that have
  // no app, by name; what's typed narrows them, best match first.
  let dkTaken = dkAll.filter(s => s.app != null).map(s => s.app.key)
  let dkIds = dkEnts.map(e => e.id)
  let dkFree = dkPick == -2 ? [] : flatten([A.filter(a => !contains(dkTaken, a.key)).map(a => {key: a.key, name: a.profile == null ? a.name : "${a.name} · ${a.profile}", icon: a.icon, package: a.package, slot: null}), slots.filter(s => s.app == null && s.alt != "" && !contains(dkIds, s.id)).map(s => {key: "slot:" + s.id, name: s.label, icon: null, package: "", slot: s.id})]).sortBy(a => lower(a.name))
  let dkApps = trim(dkQ) == "" ? dkFree : rank(dkFree, dkQ)

  // The shared file changed, or was read for the first time. With nothing of its own to save, this page takes the
  // file's order. With an order the file hasn't got yet, it writes it (a few times at most, should another page keep
  // writing its own), and once the file says the same, it's saved.
  on dkFile first {
    if !dkEdit && value != null {
      let kJ = value == "" ? null : parseJson(value)
      if !dkDirty {
        if kJ != null && kJ.dock != null { dock = kJ.dock }
      } else if kJ != null && toJson(kJ.dock) == toJson(dkEnts) {
        dkDirty = false
        dkTries = 0
      } else if dkTries < 3 {
        dkTries = dkTries + 1
        run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson({dock: dkEnts}))} > ~/.local/share/tide/dock.json.tmp && mv ~/.local/share/tide/dock.json.tmp ~/.local/share/tide/dock.json")
      } else if kJ != null && kJ.dock != null {
        dock = kJ.dock
        dkDirty = false
        dkTries = 0
      }
    }
  }
  // Arranging ends by itself a few minutes after the last touch, and saves what changed for the other pages.
  at dkEnds {
    if dkEdit {
      dkEdit = false
      dkId = ""
      dkPick = -2
      dkSure = false
      if dkDirty {
        dkTries = 0
        run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson({dock: dkEnts}))} > ~/.local/share/tide/dock.json.tmp && mv ~/.local/share/tide/dock.json.tmp ~/.local/share/tide/dock.json")
      }
    }
    dkEnds = 0
  }

  // ── parts ─────────────────────────────────────────────────────────────────────────────────────────────────────
  component T(s, sz = 14, w = 450, col = foreground, lines = 1, al = "start") {
    Text { text: s; font: inter; fontSize: sz; fontWeight: w; color: col; maxLines: lines; align: al }
  }

  // An app's key: a pane of glass tinted in a theme colour, its icon, its name. `small` for the Calendar page's dock,
  // seven to a row.
  component KeyFace(s, small = false) {
    Column {
      align: center
      gap: 4
      Box {
        size: small ? 44 : 50
        radius: (small ? 14 : 16) * (corners ?? 1)
        background: mix(glass, alpha(s.tint, 0.55), 0.35)
        frost: fz
        border: 1
        borderColor: alpha(s.tint, 0.35)
        align: center
        if s.app != null {
          Image { src: s.app.icon; size: small ? 25 : 28; label: s.label }
        } else {
          T { s: sub(s.label, 0, 1); sz: small ? 18 : 20; w: 600; al: "center" }
        }
      }
      T { s: s.label; sz: small ? 10 : 10.5; w: 500; col: soft; al: "center" }
    }
  }

  // A key in the dock: it sinks under the finger and opens its app. Held, the dock starts to jiggle, to be arranged.
  component AppKey(s, small = false) {
    Column {
      width: dkCw
      align: center
      scale: held == s.id ? 0.88 : 1
      animate scale: spring(0.55, 600)
      onPress: held = s.id
      onRelease: held = ""
      onTap: {
        haptic("light")
        if s.app != null { androidApp(s.app.key) } else if s.alt == "calendar" { calendar("open") } else if s.alt != "" { url(s.alt) }
      }
      onLongPress: { held = ""; dkSure = false; dkEdit = true; dkEnds = now + 180 }
      KeyFace { s: s; small: small }
    }
  }

  // A key while the dock is arranged: it jiggles, and dragged it follows the finger while the others make room (the
  // key itself goes unseen then, and a copy drawn over the others is what shows). Its minus takes it out, and a tap
  // picks another app for its place. It's placed by hand, at px and py, so it can slide to a new place.
  component EditKey(s, px, py, small = false) {
    Box {
      width: dkCw
      offset: [px, py]
      animate offset: spring(0.8, 420)
      opacity: dkId == s.id ? 0 : 1
      ripple: false
      onPress: held = s.id
      onRelease: held = ""
      onTap: { haptic("light"); dkSure = false; dkQ = ""; dkPick = s.i; dkEnds = now + 180 }
      onDrag: {
        if dkId == "" { dkId = s.id; dkFrom = s.i; dkX = 0; dkY = 0 }
        if dkId == s.id { dkX = dkX + dx; dkY = dkY + dy }
      }
      onDragEnd: {
        if dkId == s.id {
          if dkTo != dkFrom {
            let kIt = dkEnts[dkFrom]
            let kRest = remove(dkEnts, dkFrom)
            dock = flatten([kRest.take(dkTo), [kIt], drop(kRest, dkTo)])
            dkDirty = true
            haptic("light")
          }
          dkId = ""
          dkX = 0
          dkY = 0
        }
        dkSure = false
        dkEnds = now + 180
      }
      Box {
        fill: width
        rotation: sin(time * 19 + hash(s.id) * 6.28) * 1.8
        scale: held == s.id || dkId == s.id ? 1.12 : 1
        animate scale: spring(0.6, 500)
        Column { fill: width; align: center; KeyFace { s: s; small: small } }
        Box {
          size: 30
          offset: [(dkCw - (small ? 44 : 50)) / 2 - 8, -6]
          padding: [3, 2, 0, 0]
          ripple: false
          onTap: { haptic("light"); dkSure = false; dock = remove(dkEnts, s.i); dkDirty = true; dkEnds = now + 180 }
          Box {
            size: 18
            radius: 9
            align: center
            background: alpha(foreground, 0.94)
            border: 1
            borderColor: alpha(background, 0.5)
            Image { src: dk_remove; size: 14; tint: background }
          }
        }
      }
    }
  }

  // The free place while arranging: tapped, it opens the picker to add an app there.
  component AddKey(px, py, small = false) {
    Box {
      width: dkCw
      offset: [px, py]
      animate offset: spring(0.8, 420)
      ripple: false
      onPress: held = "dk-add"
      onRelease: held = ""
      onTap: { haptic("light"); dkSure = false; dkQ = ""; dkPick = -1; dkEnds = now + 180 }
      Column {
        fill: width
        align: center
        gap: 4
        scale: held == "dk-add" ? 0.88 : 1
        animate scale: spring(0.55, 600)
        Box {
          size: small ? 44 : 50
          radius: (small ? 14 : 16) * (corners ?? 1)
          background: alpha(accent, 0.14)
          border: 1.5
          borderColor: alpha(accent, 0.6)
          align: center
          Image { src: dk_add; size: small ? 22 : 24; tint: accent }
        }
        T { s: "Add"; sz: small ? 10 : 10.5; w: 600; col: accent; al: "center" }
      }
    }
  }
  // The four pages as a segmented bar, the one showing lit in the accent: swipe to the others.
  component Tabs(cur) {
    Row {
      gap: 4
      padding: 4
      background: glass
      frost: fz
      radius: R
      border: 1
      borderColor: hair
      for t in tabs {
        Box {
          weight: 1
          height: 34
          align: center
          radius: R - 4
          background: t.id == cur ? accent : alpha(accent, 0)
          animate background: tween(220ms, "ease")
          T { s: t.name; sz: 13; w: 650; col: t.id == cur ? background : soft; al: "center" }
        }
      }
    }
  }

  // The bottom of every page, in the same place on each: the dock (on the Calendar page all its apps, in two rows of
  // seven), then the four pages. Swiping between pages, the pages' bar stays put.
  // Hold an app, or the dock's glass, and the dock is arranged as on an iPhone: the apps jiggle, each can be dragged
  // to a new place, taken out by its minus or swapped for another by a tap, and a free place adds one. The bar below
  // then holds Reset and Done.
  component Bottom(cur) {
    Column {
      gap: 10
      Box {
        fill: width
        padding: [6, 10]
        background: glass
        frost: fz
        radius: R + 4
        border: 1
        borderColor: dkEdit ? alpha(accent, 0.55) : hair
        ripple: false
        onLongPress: { dkSure = false; dkEdit = true; dkEnds = now + 180 }
        if dkEdit {
          Box {
            fill: width
            align: bottomStart
            // Unseen and as tall as the rows, it gives the dock its height: the keys are placed over it, from its
            // bottom left corner.
            Column {
              fill: width
              gap: 10
              opacity: 0
              for k in range(dkRows) {
                Column { gap: 4; Spacer { height: dkWide ? 44 : 50 }; T { s: "Ag"; sz: dkWide ? 10 : 10.5; w: 500 } }
              }
            }
            // Each app at its place, or one along while the carried app is over a place before or after it.
            for s in dkShown key s.id {
              let kMe = dkId == s.id
              let kVi = dkId == "" || kMe ? s.i : dkFrom < dkTo && s.i > dkFrom && s.i <= dkTo ? s.i - 1 : dkTo < dkFrom && s.i >= dkTo && s.i < dkFrom ? s.i + 1 : s.i
              let kR = floor(kVi / dkPer)
              EditKey {
                s: s
                small: dkWide
                px: (dkW - (kR == 0 ? min(dkCells, dkPer) : dkCells - dkPer) * dkCw) / 2 + (kVi - kR * dkPer) * dkCw + (kMe ? dkX : 0)
                py: (kMe ? dkY : 0) - kR * dkPitch
              }
            }
            if dkAdd {
              AddKey { small: dkWide; px: dkAddX; py: 0 - dkAddR * dkPitch }
            }
            // The carried app, over the others and a little larger, right under the finger.
            if dkDrag != null {
              Box {
                width: dkCw
                offset: [dkLeft, dkY - dkR0 * dkPitch]
                Column { fill: width; align: center; scale: 1.12; KeyFace { s: dkDrag; small: dkWide } }
              }
            }
          }
        } else if dkN == 0 {
          Row {
            fill: width
            justify: center
            padding: [0, 14]
            T { s: "Touch and hold here to add apps"; sz: 13; w: 550; col: soft }
          }
        } else {
          Column {
            fill: width
            gap: 10
            if dkN > dkPer {
              Row {
                fill: width
                gap: 0
                justify: center
                for s in drop(dkShown, dkPer) key s.id { AppKey { s: s; small: dkWide } }
              }
            }
            Row {
              fill: width
              gap: 0
              justify: center
              for s in dkShown.take(dkPer) key s.id { AppKey { s: s; small: dkWide } }
            }
          }
        }
      }
      if dkEdit {
        Row {
          gap: 6
          padding: 4
          align: center
          background: glass
          frost: fz
          radius: R
          border: 1
          borderColor: hair
          Row {
            height: 34
            padding: [14, 0]
            align: center
            radius: R - 4
            onTap: {
              haptic("light")
              if dkSure { dock = dkDef; dkDirty = true; dkSure = false } else { dkSure = true }
              dkEnds = now + 180
            }
            T { s: dkSure ? "Reset all?" : "Reset"; sz: 13; w: 650; col: dkSure ? red : soft }
          }
          T { s: "Drag to move · tap to change"; sz: 11; w: 500; col: faint; al: "center"; weight: 1 }
          Row {
            height: 34
            padding: [20, 0]
            align: center
            radius: R - 4
            background: accent
            onTap: {
              haptic("light")
              dkEdit = false
              dkId = ""
              dkPick = -2
              dkSure = false
              dkEnds = 0
              if dkDirty {
                dkTries = 0
                run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson({dock: dkEnts}))} > ~/.local/share/tide/dock.json.tmp && mv ~/.local/share/tide/dock.json.tmp ~/.local/share/tide/dock.json")
              }
            }
            T { s: "Done"; sz: 13; w: 700; col: background }
          }
        }
      } else {
        Tabs { cur: cur }
      }
    }
  }

  // A soft edge for a scrolling list, so rows melt into the page instead of meeting a hard line. It's layers of
  // what's behind the list (the wallpaper as frosted glass shows it, under the same tint), all starting at the edge
  // and reaching further in as they get fainter (1, 1/2, 1/3…), so together they fade evenly from solid to clear.
  // It takes no taps, so the list under it still scrolls.
  component Fade(up, tint, fr) {
    Box {
      fill: width
      height: 20
      align: up ? "top" : "bottom"
      for k in range(1, 11) {
        Box { fill: width; height: k * 2; frost: fr; background: tint; opacity: 1 / k }
      }
    }
  }
  // A task: tap it to tick it off (or back on), here and in the file.
  component AnyTask(t) {
    Row {
      gap: 8
      align: center
      onTap: {
        haptic("light")
        let next = tasks.map(x => x.id == t.id ? merge(x, {done: !x.done}) : x)
        pend = next
        run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson(next))} > ~/.local/share/tide/tasks.json")
      }
      Box {
        size: 34
        align: center
        Box {
          size: 22
          radius: 11
          border: 2
          borderColor: t.done == true ? green : faint
          background: t.done == true ? green : alpha(foreground, 0)
          align: center
          if t.done == true { Image { src: i_check; size: 16; tint: background } }
        }
      }
      T { s: t.t; sz: 14; w: 520; col: t.done == true ? faint : foreground; lines: 2; weight: 1 }
    }
  }

  // A reading at a glance: a ring with an icon in it, a number and what it is.
  component Chip(id, ring, tint, glyph, big, small) {
    Row {
      gap: 10
      align: center
      padding: [10, 10, 8, 10]
      background: glass
      frost: fz
      radius: R
      border: 1
      borderColor: hair
      scale: held == id ? 0.95 : 1
      animate scale: spring(0.55, 600)
      onPress: held = id
      onRelease: held = ""
      onTap: {
        haptic("light")
        if id == "bat" { settings("battery") } else if id == "claude" { url("https://claude.ai/settings/usage") } else if clockApp != null { androidApp(clockApp.key) }
      }
      Box {
        size: 40
        align: center
        Ring { value: ring; max: 1; size: 40; thickness: 4; color: tint; track: alpha(foreground, 0.12) }
        Image { src: glyph; size: 18; tint: tint }
      }
      Column {
        gap: 0
        weight: 1
        T { s: big; sz: 17; w: 650 }
        T { s: small; sz: 11; w: 500; col: soft }
      }
    }
  }

  // The page's tint over the wallpaper: darker under the clock and the dock, even through the middle, where the list
  // scrolls and its fades match it.
  on inset first { if value <= 120 { navInset = value } }
  // The keyboard put away: the add box lets go, so it stays away.
  on kb { if !value { inputGen = inputGen + 1 } }

  background: linear(0, 0, 0, 1, [alpha(background, 0.55), alpha(background, 0.22), alpha(background, 0.22), alpha(background, 0.22), alpha(background, 0.5)])

  // The page, and over it the dock's app picker.
  Box {
    fill: true
  Column {
    fill: true
    gap: 12
    padding: [16, (screenTop ?? 24) + 4, 16, 0]

    // ── the time and the weather ──
    Column {
      gap: 0
      padding: [4, 6, 4, 0]
      onTap: { haptic("light"); if clockApp != null { androidApp(clockApp.key) } }
      T { s: "${greeting} · ${fmtTime(now, "EEEE, MMMM d")}"; sz: 14; w: 550; col: soft }
      Row {
        align: center
        Text {
          spans: [fmtTime(now, "h:mm"), {text: " " + lower(fmtTime(now, "a")), fontSize: 20, fontWeight: 500, letterSpacing: 0, color: soft}]
          font: inter
          fontSize: 76
          fontWeight: 200
          letterSpacing: -3
          maxLines: 1
          weight: 1
        }
        if cur != null {
          Column {
            gap: 0
            align: end
            onTap: { haptic("light"); unitF = !unitF }
            Row {
              gap: 4
              align: center
              Text { text: weatherIcon(cur.weatherCode, night); font: icon; fontSize: 30; color: skyTint }
              T { s: "${temp}°"; sz: 30; w: 300 }
            }
            T { s: cur.weatherDesc[0].value; sz: 12; w: 500; col: soft; al: "end" }
            T { s: "H ${hi}°  L ${lo}°"; sz: 12; w: 500; col: faint; al: "end" }
          }
        }
      }
    }

    // ── at a glance ──
    Row {
      gap: 8
      Chip {
        id: "bat"; ring: (bat.level ?? 0) / 100; tint: bat.level <= 15 && !bat.charging ? red : bat.charging ? green : foreground
        glyph: bat.charging ? i_bolt : i_battery_full; big: "${bat.level ?? "…"}%"; small: bat.charging ? "Charging" : "Battery"
        weight: 1
      }
      Chip {
        id: "claude"; ring: (week ?? 0) / 100; tint: usageTint; glyph: i_bolt
        big: week == null ? "—" : "${round(week)}%"; small: five != null ? "5h ${round(five)}%" : "Claude · wk"
        weight: 1
      }
      Chip {
        id: "alarm"; ring: alarm.set ? 1 : 0; tint: alarm.set ? accent : faint; glyph: i_alarm
        big: alarm.set ? fmtTime(alarm.time, "h:mm") : "Off"; small: alarm.set ? fmtTime(alarm.time, "EEE a") : "Alarm"
        weight: 1
      }
    }

    // ── tasks: a box to add one, staying put while the list below scrolls ──
      Column {
        gap: 12
        padding: [16, 14]
        background: glass
        frost: fz
        radius: R
        border: 1
        borderColor: hair
        Row {
          align: center
          T { s: openCount > 0 ? "TASKS · ${openCount}" : "TASKS"; sz: 11; w: 700; col: faint; weight: 1 }
          if len(done) > 0 {
            Row {
              padding: [8, 2, 0, 2]
              onTap: {
                haptic("medium")
                pend = todo
                run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson(todo))} > ~/.local/share/tide/tasks.json")
              }
              T { s: "Clear ${len(done)} done"; sz: 12; w: 600; col: accent }
            }
          }
        }
        Row {
          gap: 10
          align: center
          padding: [12, 4, 6, 4]
          radius: r2
          background: alpha(foreground, 0.06)
          border: 1
          borderColor: hair
          Image { src: i_add; size: 20; tint: accent }
          // Built anew (under a new key) once the keyboard goes away, so it lets go of the focus and Android doesn't
          // bring the keyboard back; what's typed is kept in draft meanwhile.
          for g in [inputGen] key g {
            Input {
              text: draft
              placeholder: "Add a task…"
              underline: false
              clear: true
              fontSize: 15
              weight: 1
              onChange: draft = value
              onSubmit: {
                if trim(value) != "" {
                  haptic("light")
                  let next = flatten([[{id: now * 1000 + random(100000), t: trim(value), done: false}], tasks])
                  pend = next
                  draft = ""
                  run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson(next))} > ~/.local/share/tide/tasks.json")
                }
              }
            }
          }
        }
        if len(rows) == 0 {
          T { s: "Nothing to do. Add the first thing above."; sz: 13; w: 500; col: faint }
        }
      }


    // ── the tasks: only the list scrolls, built as rows come into view and fading out at its edges. Pulled down at
    // the top, it reads the tasks again. Built anew (under a new key) when the back-to-top key is tapped, so it
    // starts again at its top ──
    Box {
      weight: 1
      for g in [topGen] key g {
        Column {
          fill: true
          lazy: true
          gap: 8
          onPull: refresh()
          Spacer { height: 12 }

      // ── every task, each on its own tile. A touch on a row, even the one that starts a scroll, notes how far down
      // the list it is, for the back-to-top key ──
      for r, i in rows key r.id {
        if r.head != null {
          Row {
            padding: [0, 8, 0, 0]
            onPress: seen = i
            Row {
              padding: [12, 5]
              radius: 99
              background: glass
              frost: fz
              border: 1
              borderColor: hair
              T { s: r.head; sz: 10.5; w: 700; col: soft }
            }
          }
        } else {
          Row {
            gap: 2
            align: center
            padding: [4, 6, 6, 6]
            background: glass
            frost: fz
            radius: r2
            border: 1
            borderColor: hair
            onPress: seen = i
            AnyTask { t: r; weight: 1 }
            if true {
              Box {
                size: 32
                align: center
                onTap: {
                  haptic("light")
                  let next = tasks.filter(x => x.id != r.id)
                  pend = next
                  run("mkdir -p ~/.local/share/tide && printf '%s' ${sh(toJson(next))} > ~/.local/share/tide/tasks.json")
                }
                Image { src: i_close; size: 18; tint: faint }
              }
            }
          }
        }
      }
      // The end of the list: the way back up.
      if len(rows) > 12 {
        Row {
          gap: 8
          padding: [0, 6, 0, 0]
          Spacer { weight: 1 }
          if len(rows) > 12 {
            Row {
              gap: 4
              align: center
              padding: [14, 8]
              radius: 99
              background: glass
              frost: fz
              border: 1
              borderColor: hair
              onTap: { haptic("light"); seen = 0; topGen = topGen + 1 }
              Image { src: i_arrow_upward; size: 16; tint: foreground }
              T { s: "Top"; sz: 12; w: 650 }
            }
          }
        }
      }
          Spacer { height: 16 }
        }
      }
      Column {
        fill: true
        gap: 0
        Fade { up: true; tint: alpha(background, 0.22); fr: 1 }
        Spacer { weight: 1 }
        if showTop {
          Row {
            fill: width
            justify: end
            padding: [0, 0, 8, 6]
            Row {
              gap: 6
              align: center
              padding: [14, 9]
              radius: 99
              background: accent
              scale: held == "top" ? 0.9 : 1
              animate scale: spring(0.55, 600)
              onPress: held = "top"
              onRelease: held = ""
              onTap: { haptic("light"); seen = 0; topGen = topGen + 1 }
              Image { src: i_arrow_upward; size: 18; tint: background }
              T { s: "Top"; sz: 13; w: 700; col: background }
            }
          }
        }
        Fade { up: false; tint: alpha(background, 0.22); fr: 1 }
      }
    }

    // ── the dock and the pages, in the same place on every page ──
    Bottom { cur: "now" }
    Spacer { height: max(navInset, 10) }
  }

    // ── the app picker, over the page while the dock is arranged: every app on the phone that isn't in the dock, to
    // search and to tap. A tap beside it, or its cross, shuts it ──
    if dkPick > -2 {
      Box {
        fill: true
        align: bottom
        padding: [10, (screenTop ?? 24) + 8, 10, max(screenInset ?? 0, 10)]
        background: alpha(background, 0.55)
        ripple: false
        onTap: { dkPick = -2; dkQ = "" }
        Column {
          fill: width
          height: min(500, (tileHeight ?? 900) - (screenTop ?? 24) - 18 - max(screenInset ?? 0, 10))
          gap: 10
          padding: [14, 14, 14, 10]
          background: alpha(background, 0.97)
          frost: fz
          radius: R + 4
          border: 1
          borderColor: hair
          ripple: false
          onTap: dkEnds = now + 180
          Row {
            align: center
            gap: 10
            Column {
              gap: 0
              weight: 1
              T { s: dkPick >= 0 ? "Change ${dkShown[dkPick].label}" : "Add to the dock"; sz: 18; w: 650 }
              T { s: trim(dkQ) == "" ? "${len(dkApps)} apps to choose from" : len(dkApps) == 1 ? "1 match" : "${len(dkApps)} matches"; sz: 12; w: 500; col: soft }
            }
            Box {
              size: 38
              radius: 19
              align: center
              background: alpha(foreground, 0.1)
              onTap: { haptic("light"); dkPick = -2; dkQ = "" }
              Image { src: dk_close; size: 20; tint: foreground }
            }
          }
          Row {
            gap: 8
            align: center
            padding: [12, 2, 8, 2]
            radius: r2
            background: alpha(foreground, 0.06)
            border: 1
            borderColor: hair
            Image { src: dk_search; size: 18; tint: faint }
            Input { placeholder: "Search apps"; underline: false; fontSize: 15; weight: 1; onChange: dkQ = value }
          }
          if len(dkApps) == 0 {
            T { s: trim(dkQ) == "" ? "Every app is in the dock already." : "No app by that name."; sz: 14; w: 500; col: faint }
            Spacer { weight: 1 }
          } else {
            Grid {
              lazy: true
              weight: 1
              columns: 4
              gap: 4
              for a in dkApps key a.key {
                Column {
                  align: center
                  gap: 5
                  padding: [4, 8]
                  radius: r2
                  onTap: {
                    haptic("light")
                    let kB = a.slot == null ? slots.find(s => s.app != null && s.app.key == a.key) : null
                    let kE = a.slot != null ? {id: a.slot} : kB != null ? {id: kB.id} : {id: "k:" + a.key, key: a.key, pkg: a.package, name: a.name}
                    dock = dkPick >= 0 ? set(dkEnts, dkPick, kE) : flatten([dkEnts, [kE]])
                    dkDirty = true
                    dkPick = -2
                    dkQ = ""
                    dkEnds = now + 180
                  }
                  if a.icon != null {
                    Image { src: a.icon; size: 46; label: a.name }
                  } else {
                    Box {
                      size: 46
                      radius: 14 * (corners ?? 1)
                      align: center
                      background: alpha(accent, 0.18)
                      border: 1
                      borderColor: alpha(accent, 0.4)
                      T { s: sub(a.name, 0, 1); sz: 18; w: 600; al: "center" }
                    }
                  }
                  Text { text: a.name; font: inter; fontSize: 10.5; fontWeight: 500; color: soft; align: center; maxLines: 2; minLines: 2 }
                }
              }
            }
          }
        }
      }
    }
  }
}
