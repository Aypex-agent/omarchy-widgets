face "the guide" {
  // The Guide, page one of four (see page-2.owl for the look): WHERE to go, the Guide's index, as its menu looks in
  // the film: a mustard page, a stack of menu bars running in from the left edge over a plum strip, and the
  // breadcrumb at the foot. Tap a bar and it opens: a bar runs out from under its knob to the right and its entries
  // rise in a stack above the end, as the film's INTRODUCTION opens WHO, WHAT, WHY. The entries open apps and agents,
  // Android's panels and the launcher's screens, and switch Do Not Disturb and the torch. Above the menu, the phone's
  // entry: Earth turning with a moon going round it, and its vitals.
  // The other pages: page-2.owl (WHEN: time, sky, weather and events), page-3.owl (WHO: Claude Code and Codex) and
  // page-4.owl (WHAT: music and notifications). Inspired by the Guide's screen in The Hitchhiker's Guide to the Galaxy
  // (2005); the pictograms are drawn here.

  meta {
    owl: 19
    description: "The Guide's screen from the 2005 Hitchhiker's film, alive, in four pages: the film's index menu; time, sky and events; Claude Code and Codex; music and notifications"
    version: "1.1"
    license: "MIT"
    category: "fun"
  }

  source now = clock every 5s
  source bat = android.battery
  source pw = android.power every 5s
  source sys = android.system every 30s
  source net = android.network every 3s
  source dev = android.device
  source modes = android.modes
  source apps = android.apps
  source drawer = android.drawer

  statusBar: false
  edge: true
  padding: 0
  fps: 20

  state tick = 0
  every 1s { tick = tick + 1 }

  // ---- the Guide's look, the same on all four pages ----
  // Cabin, a humanist sans after Gill and Johnston, like the Guide's lettering.
  let cabin = "https://raw.githubusercontent.com/google/fonts/main/ofl/cabin/Cabin%5Bwdth,wght%5D.ttf"
  // The colours, picked from frames of the film.
  let band = #C29632
  let mustard = #C9A640
  let rasp = #8B3756
  let teal = #1F8768
  let navy = #0C1834
  let cream = #F0E3C4
  let label = #EDCB57
  let gold = #F2BF3A
  let crumbBlue = #3A8FC4
  let crumbPlum = #7B2D5A
  let violet = #5B47B5
  let aqua = #33BE95
  let leaf = #4FAE30
  let amber = #C77A18
  let crimson = #A42F4C
  let plum = #6E1A5E
  let cobalt = #2F7DB8
  let indigo = #43409C
  let ink = #000000
  // The tabs in the pages' order on home, each with how much darker its knob is: aqua's more, so on the teal page
  // its knob isn't the page's own colour.
  let tabs = [{t: "WHERE", c: amber, k: 0.3}, {t: "WHEN", c: violet, k: 0.3}, {t: "WHO", c: aqua, k: 0.5}, {t: "WHAT", c: leaf, k: 0.3}]
  let barColors = [violet, aqua, leaf, amber, crimson, plum, cobalt, indigo]

  let W = tileWidth ?? 420
  let H = tileHeight ?? 933
  let wide = W > H
  let beat = floor(tick / 2)
  // Temperatures in Fahrenheit where the phone's region uses them (the United States and a few others), else Celsius.
  let region = upper(match(sys.locale ?? "", "[_-]([A-Za-z]{2})")[0] ?? "")
  let useF = contains(["US", "LR", "MM", "BS", "BZ", "KY", "PW", "FM", "MH"], region)
  // Menu bars' height, and the room the knob takes.
  let bh = 30
  // The tabs' height: the menus that open stand on them.
  let tabsH = 44

  // The field: one flat colour, with paper blotches and film grain that changes twelve times a second, and stars
  // where `stars` says so.
  component Paper(base, stars = 0) {
    Shader {
      fill: true
      fallback: base
      uniforms: { base: base, star: cream, grain: 0.05, stars: stars }
      code: """
        uniform half4 base;
        uniform half4 star;
        uniform float grain;
        uniform float stars;
        float h21(float2 q) {
          float3 p3 = fract(float3(q.xyx) * 0.1031);
          p3 += dot(p3, p3.yzx + 33.33);
          return fract((p3.x + p3.y) * p3.z);
        }
        float vn(float2 q) {
          float2 i = floor(q);
          float2 f = fract(q);
          float2 u = f * f * (3.0 - 2.0 * f);
          return mix(mix(h21(i), h21(i + float2(1.0, 0.0)), u.x), mix(h21(i + float2(0.0, 1.0)), h21(i + float2(1.0, 1.0)), u.x), u.y);
        }
        half4 main(float2 p) {
          float t = floor(time * 12.0);
          float paper = vn(p / 140.0) * 0.6 + vn(p / 31.0) * 0.4;
          float g = h21(floor(p / 2.0) + float2(t * 17.0, t * 5.0));
          float3 c = float3(base.rgb) * (0.95 + paper * 0.09) + (g - 0.5) * grain;
          if (stars > 0.0) {
            // A star in about one cell in six; each twinkles at its own pace, mostly dim with sharp bright flashes,
            // and the brightest few flare into a four-point sparkle as they peak. Some burn warm.
            float2 cell = floor(p / 48.0);
            float r = h21(cell + 3.1);
            if (r > 0.84) {
              float2 sp = (cell + float2(0.2 + 0.6 * h21(cell + 7.7), 0.2 + 0.6 * h21(cell + 9.3))) * 48.0;
              float2 dv = p - sp;
              float d = length(dv);
              float tw = 0.5 + 0.5 * sin(time * (0.9 + r * 3.0) + r * 61.0);
              tw = tw * tw * tw;
              float big = step(0.985, r);
              float core = smoothstep(3.2 + 1.6 * tw + big * (3.0 + 3.0 * tw), 0.6, d);
              float len = 6.0 + 26.0 * tw;
              float flare = big * tw * (smoothstep(1.8, 0.0, abs(dv.x)) * smoothstep(len, 0.0, abs(dv.y)) + smoothstep(1.8, 0.0, abs(dv.y)) * smoothstep(len, 0.0, abs(dv.x)));
              float warm = step(0.82, h21(cell + 5.5));
              float3 sc = mix(float3(star.rgb), float3(1.0, 0.8, 0.42), warm * 0.65);
              c = mix(c, sc, clamp((0.3 + 0.7 * tw) * core + flare, 0.0, 1.0) * stars);
            }
          }
          return half4(half3(c), 1.0);
        }
      """
    }
  }

  // The mustard band at the top: the breadcrumb, THE GUIDE over this page's question, and the battery and the time.
  component Band(q) {
    Column {
      fill: width
      gap: 0
      background: band
      Spacer { height: screenTop + 8 }
      Row {
        fill: width
        height: 28
        gap: 0
        align: center
        Box {
          width: 184 + len(q) * 8.6
          height: 28
          align: topStart
          // The page's pill runs out from under THE GUIDE.
          Box {
            width: 48 + len(q) * 8.6
            height: 28
            radius: 14
            offset: [136, 0]
            background: crumbPlum
            align: end
            padding: [0, 0, 13, 0]
            Text { text: q; font: cabin; fontSize: 15; fontWeight: 500; letterSpacing: 1; color: label; maxLines: 1; align: end }
          }
          Box {
            width: 168
            height: 28
            radius: 14
            offset: [-16, 0]
            background: crumbBlue
            align: start
            padding: [32, 0, 0, 0]
            Text { text: "THE GUIDE"; font: cabin; fontSize: 15.5; fontWeight: 700; letterSpacing: 1; color: label; maxLines: 1 }
          }
        }
        Spacer { weight: 1 }
        Text {
          text: (bat.level == null ? "" : "${bat.level}%" + (bat.charging ? " +" : "") + "   ") + fmtTime(now, "HH:mm")
          font: cabin; fontSize: 13.5; fontWeight: 600; letterSpacing: 1
          color: bat.level != null && bat.level < 20 && !bat.charging ? crimson : mix(band, ink, 0.55)
          maxLines: 1
          padding: [0, 0, 16 + screenRight, 0]
        }
      }
      Spacer { height: 10 }
    }
  }

  // The four pages as menu bars along the foot, this one long and lit with its knob beating: swipe to the others.
  component Tabs(here) {
    Row {
      fill: width
      height: tabsH
      gap: 5
      align: center
      padding: [8 + screenLeft, 6, 8 + screenRight, 8]
      for tb, i in tabs {
        Box {
          weight: i == here ? 1.45 : 1
          height: 30
          radius: 15
          background: tb.c
          align: end
          Row {
            gap: 4
            align: center
            Text { text: tb.t; font: cabin; fontSize: 13; fontWeight: i == here ? 700 : 500; letterSpacing: 0.5; color: i == here ? cream : label; maxLines: 1 }
            // This page's knob beats, slowly.
            Box { size: 28; radius: 14; background: mix(tb.c, ink, tb.k); scale: i == here && tick % 2 == 0 ? 0.78 : 1; animate scale: tween(900ms, "ease") }
          }
        }
      }
    }
  }

  // A menu bar running in from the left edge: a note at its start, its label at its end by the knob. `wob` shifts it a
  // few dp, so a stack of them seems to breathe.
  component Bar(text, tint, w, note = "", wob = 0) {
    Box {
      width: w + 18
      height: bh
      offset: [-18 + wob, 0]
      animate offset: tween(1900ms, "ease")
      background: tint
      radius: bh / 2
      Row {
        fill: true
        gap: 8
        align: center
        padding: [30, 0, 0, 0]
        if note != "" {
          Text { text: note; font: cabin; fontSize: 13; fontWeight: 700; letterSpacing: 0.5; color: cream; maxLines: 1 }
        }
        Text { text: text; font: cabin; fontSize: 15; fontWeight: 500; letterSpacing: 1; color: label; maxLines: 1; align: end; weight: 1 }
        Box { size: bh; radius: bh / 2; background: mix(tint, ink, 0.3) }
      }
    }
  }

  // A heading: small capitals in cream, spaced out, like the Guide's captions.
  component Caption(t, note = "") {
    Row {
      fill: width
      gap: 8
      Text { text: t; font: cabin; fontSize: 12.5; fontWeight: 600; letterSpacing: 2.5; color: alpha(cream, 0.85); maxLines: 1; weight: 1 }
      Text { text: note; font: cabin; fontSize: 12.5; fontWeight: 500; letterSpacing: 1.5; color: alpha(cream, 0.6); maxLines: 1 }
    }
  }

  // ---- this page ----
  // Which bar of the index is open (-1: none), and the last one opened, which its entries fold back into.
  state sel = -1
  state last = 0
  // The network's speed, from the change in its byte counters between two polls.
  state down = null
  state up = null
  on net { if old != null && value.rx >= old.rx && value.uptime > old.uptime { down = (value.rx - old.rx) / (value.uptime - old.uptime); up = (value.tx - old.tx) / (value.uptime - old.uptime) } }

  // Text on the mustard page is dark, as the film's labels are only ever on the bars.
  let dark = #4A1838
  let dim = mix(mustard, ink, 0.5)
  let strip = #8E4A66

  let herdrApp = (drawer.apps ?? []).find(a => contains(lower(a.name ?? ""), "herdr"))
  let installed = (apps ?? []).map(a => a.package)
  let spotify = (apps ?? []).find(a => a.package == "com.spotify.music")
  let top = (apps ?? []).filter(a => !a.system || a.score > 0).sortBy(a => -a.score).take(6)

  // The index: each bar's entries, an app to open or a thing to do. Apps that aren't installed are left out.
  let cats = [
    {t: "AGENTS", c: violet, h: "WHO DOES IT", items: [
      {t: "CLAUDE", k: "android", a: "com.anthropic.claude"},
      {t: "CODEX", k: "android", a: "com.openai.chatgpt"},
      herdrApp == null ? null : {t: "HERDR", k: "open", a: herdrApp.key},
      {t: "TERMINAL", k: "shell", a: ""},
      {t: "AGENT SETTINGS", k: "launcher", a: "agents"}
    ].filter(x => x != null && (x.k != "android" || contains(installed, x.a)))},
    {t: "COMMS", c: aqua, h: "WHO TO TELL", items: [
      {t: "MESSAGES", k: "android", a: "com.google.android.apps.messaging"},
      {t: "PHONE", k: "android", a: "com.google.android.dialer"},
      {t: "GMAIL", k: "android", a: "com.google.android.gm"},
      {t: "CHROME", k: "android", a: "com.android.chrome"},
      spotify == null ? {t: "MUSIC", k: "media", a: ""} : {t: "SPOTIFY", k: "android", a: "com.spotify.music"}
    ].filter(x => x.k != "android" || contains(installed, x.a))},
    {t: "MOST USED", c: leaf, h: "WHERE YOU GO", items: top.map(a => {t: upper(a.name), k: "app", a: a.key})},
    {t: "SYSTEMS", c: amber, h: "HOW IT RUNS", items: [
      {t: "WI-FI · " + (modes.wifi == true ? "ON" : "OFF"), k: "settings", a: "wifi"},
      {t: "BLUETOOTH · " + (modes.bluetooth == true ? "ON" : "OFF"), k: "settings", a: "bluetooth"},
      {t: "INTERNET", k: "settings", a: "internet"},
      {t: "LOCATION · " + (modes.location == true ? "ON" : "OFF"), k: "settings", a: "location"},
      {t: "BATTERY", k: "settings", a: "battery"},
      {t: "DISPLAY", k: "settings", a: "display"}
    ]},
    {t: "LAUNCHER", c: crimson, h: "HOW IT LOOKS", items: [
      {t: "STYLE", k: "launcher", a: "style"},
      {t: "THEMES", k: "launcher", a: "themes"},
      {t: "STORE", k: "launcher", a: "store"},
      {t: "FILES", k: "files", a: ""},
      {t: "SETTINGS", k: "launcher", a: "settings"},
      {t: "ALL APPS", k: "launcher", a: "drawer"}
    ]},
    {t: "DON'T PANIC", c: plum, h: "WHAT TO DO", items: [
      {t: "QUIET · " + (modes.dnd == true ? "ON" : "OFF"), k: "dnd", a: ""},
      {t: "TORCH · " + (modes.torch == true ? "ON" : "OFF"), k: "torch", a: ""},
      {t: "SNOOZE ALL 1H", k: "snooze", a: ""},
      {t: "CLEAR ALL", k: "clear", a: ""},
      {t: "MAKE A CALL", k: "android", a: "com.google.android.dialer"}
    ].filter(x => x.k != "android" || contains(installed, x.a))}
  ]
  let lastItems = cats[last].items
  // The menu's geometry: rows of bars, the stack of categories at the foot and room above it for the tallest stack
  // of entries.
  let p = bh + 4
  let catW = min(W * 0.44, 200)
  let connEnd = W - 20 - screenRight
  // The entries stand clear of the category bars' knobs, as in the film.
  let subW = min(connEnd - catW - 22, 230)
  let head = 6 * p
  let menuH = head + len(cats) * p

  let level = num(bat.level, 0)
  let memF = sys.memory == null || !sys.memory.total ? null : sys.memory.used / sys.memory.total
  let watts = pw.watts
  // The land on the globe: the continents and the bigger islands as outlines of latitude and longitude, coarse but
  // recognisable, ice in white; turned into points on a sphere once, here.
  let continents = [
    {ice: false, p: [[71,-156],[70,-141],[69,-133],[70,-128],[68,-115],[68,-108],[68,-98],[64,-88],[59,-94],[55,-83],[52,-79],[56,-77],[61,-78],[62,-73],[58,-68],[60,-64],[55,-60],[52,-56],[47,-53],[46,-60],[44,-66],[42,-70],[41,-72],[39,-74],[35,-76],[32,-81],[27,-80],[25,-81],[30,-84],[30,-89],[29,-94],[26,-97],[22,-98],[19,-96],[18,-92],[21,-90],[21,-87],[16,-88],[15,-84],[11,-84],[9,-79],[7,-78],[8,-82],[13,-88],[16,-95],[19,-105],[23,-110],[28,-112],[31,-114],[29,-116],[33,-118],[35,-121],[40,-124],[46,-124],[49,-123],[54,-130],[57,-134],[59,-139],[60,-146],[59,-152],[57,-157],[55,-162],[59,-162],[61,-165],[64,-165],[66,-163],[68,-166]]},
    {ice: false, p: [[12,-72],[11,-64],[8,-60],[6,-57],[4,-52],[1,-50],[-2,-44],[-5,-36],[-8,-35],[-13,-38],[-18,-39],[-23,-42],[-25,-48],[-29,-49],[-33,-52],[-35,-57],[-39,-58],[-41,-63],[-46,-67],[-51,-69],[-54,-67],[-55,-70],[-53,-74],[-47,-75],[-42,-73],[-37,-73],[-30,-71],[-23,-70],[-18,-70],[-15,-75],[-9,-79],[-5,-81],[-1,-80],[2,-79],[7,-77],[9,-76],[11,-74]]},
    {ice: true, p: [[83,-32],[82,-20],[77,-18],[72,-22],[68,-30],[65,-40],[60,-43],[61,-48],[66,-53],[70,-54],[74,-58],[77,-68],[79,-72],[82,-60]]},
    {ice: false, p: [[36,-9],[43,-9],[44,-1],[47,-2],[48,-5],[49,0],[51,2],[53,5],[54,9],[57,8],[58,6],[59,10],[56,12],[55,14],[54,18],[57,21],[59,23],[60,30],[61,22],[64,21],[66,25],[65,21],[63,18],[59,17],[56,16],[58,12],[62,5],[66,13],[69,17],[71,25],[70,32],[68,41],[66,40],[66,44],[68,46],[68,55],[70,60],[69,67],[73,70],[72,80],[74,87],[76,98],[77,105],[74,112],[73,120],[72,130],[71,140],[71,150],[69,161],[69,170],[66,178],[64,178],[62,173],[60,170],[58,162],[52,157],[56,155],[59,155],[61,160],[59,143],[54,141],[50,140],[46,138],[42,133],[39,128],[35,129],[35,126],[38,125],[40,122],[39,118],[37,122],[35,120],[31,122],[27,120],[23,117],[22,113],[21,110],[19,106],[17,107],[12,109],[9,106],[10,104],[13,100],[8,100],[3,101],[1,104],[5,103],[10,99],[14,98],[16,95],[20,93],[22,90],[21,87],[16,82],[13,80],[9,79],[8,77],[12,75],[17,73],[21,72],[23,68],[25,66],[25,61],[26,57],[24,57],[22,60],[18,57],[16,52],[13,45],[15,42],[21,39],[27,35],[29,33],[31,32],[33,35],[36,36],[37,36],[36,30],[37,27],[40,26],[41,29],[41,32],[42,41],[44,39],[46,37],[46,31],[45,29],[44,28],[42,28],[41,24],[40,23],[38,24],[37,22],[39,20],[40,20],[42,19],[45,14],[45,12],[42,14],[40,18],[38,16],[40,15],[41,13],[43,10],[44,9],[44,7],[43,4],[42,3],[40,0],[38,0],[37,-2],[36,-5]]},
    {ice: false, p: [[37,10],[37,-1],[35,-6],[33,-9],[28,-13],[21,-17],[15,-17],[12,-16],[9,-13],[5,-8],[4,-2],[6,2],[4,8],[2,10],[-1,9],[-5,12],[-9,13],[-12,14],[-17,12],[-22,14],[-28,16],[-33,18],[-35,20],[-34,26],[-31,30],[-27,33],[-24,35],[-19,35],[-15,40],[-10,40],[-5,39],[-2,41],[2,45],[5,48],[10,51],[11,49],[12,44],[15,40],[18,38],[22,36],[27,34],[30,32],[31,30],[32,25],[30,19],[32,15],[33,11],[35,11]]},
    {ice: false, p: [[-11,131],[-12,136],[-15,135],[-17,140],[-12,142],[-15,145],[-19,147],[-23,150],[-28,153],[-33,152],[-37,150],[-39,146],[-38,141],[-36,137],[-33,136],[-35,135],[-32,132],[-32,127],[-34,123],[-35,117],[-32,115],[-27,113],[-22,114],[-20,119],[-17,122],[-14,126],[-14,129]]},
    {ice: false, p: [[50,-5],[51,1],[53,0],[55,-2],[58,-3],[58,-5],[57,-6],[55,-5],[54,-3],[53,-4],[52,-5]]},
    {ice: false, p: [[52,-10],[55,-8],[54,-6],[52,-6]]},
    {ice: false, p: [[31,131],[34,131],[35,136],[35,140],[38,141],[41,141],[45,142],[44,145],[42,143],[41,140],[38,139],[36,136],[34,133],[33,130]]},
    {ice: false, p: [[-12,49],[-16,50],[-25,47],[-25,44],[-20,44],[-16,45],[-13,48]]},
    {ice: false, p: [[7,117],[4,118],[1,119],[-4,116],[-3,111],[1,109],[2,111],[4,114]]},
    {ice: false, p: [[6,95],[2,98],[-2,101],[-6,106],[-5,103],[-2,100],[2,97]]},
    {ice: false, p: [[-1,131],[-3,138],[-6,147],[-10,150],[-8,143],[-9,141],[-4,134]]},
    {ice: false, p: [[-35,173],[-37,175],[-41,176],[-46,170],[-44,168],[-41,172],[-39,174]]},
    {ice: false, p: [[66,-23],[66,-15],[64,-14],[63,-20],[64,-22]]},
    {ice: true, p: [[-64,-58],[-70,-30],[-70,0],[-68,30],[-67,60],[-66,90],[-66,120],[-67,145],[-71,170],[-78,190],[-76,215],[-74,240],[-73,265],[-68,290],[-64,300],[-90,300],[-90,-60]]}
  ]
  let landV = continents.map(k => {ice: k.ice, v: k.p.map(q => [cos(rad(q[0])) * sin(rad(q[1])), sin(rad(q[0])), cos(rad(q[0])) * cos(rad(q[1]))])})

  // Earth, turning, its seas crossed by cream meridians, and the moon going round it: behind it, then in front.
  component Globe() {
    Canvas {
      size: wide ? 132 : 168
      let cx = width / 2
      let cy = height / 2
      let R = width / 2 - 18
      let rot = time * 9
      let ma = time * 22
      let mx = cx + (R + 12) * cos(rad(ma))
      let my = cy + (R + 12) * 0.3 * sin(rad(ma)) - 7 * cos(rad(ma))
      let behind = sin(rad(ma)) < 0
      if behind { circle(mx, my, 6.5, fill: cream) }
      circle(cx, cy, R, fill: cobalt)
      // Each outline turned with the Earth (east to the right); a point turned away lies on the rim where it went over,
      // so the land never leaves the disc.
      let cr = cos(rad(rot))
      let sr = sin(rad(rot))
      for k in landV {
        let u = k.v.map(v => [v[0] * cr + v[2] * sr, v[1], v[2] * cr - v[0] * sr])
        if u.any(w => w[2] > 0) {
          path(u.map(w => w[2] >= 0 ? [cx + R * w[0], cy - R * w[1]] : [cx + R * w[0] / max(0.001, sqrt(w[0] * w[0] + w[1] * w[1])), cy - R * w[1] / max(0.001, sqrt(w[0] * w[0] + w[1] * w[1]))]), closed: true, fill: k.ice ? mix(cream, cobalt, 0.12) : leaf)
        }
      }
      for k in range(6) {
        let lam = rad((k * 30 + rot) % 180 - 90)
        path(range(13).map(i => [cx + R * cos(rad(i * 15 - 90)) * sin(lam), cy - R * sin(rad(i * 15 - 90))]), stroke: alpha(cream, 0.45), width: 1.2)
      }
      for f in [-60, -30, 0, 30, 60] {
        line(cx - R * cos(rad(f)), cy - R * sin(rad(f)), cx + R * cos(rad(f)), cy - R * sin(rad(f)), stroke: alpha(cream, 0.45), width: 1.2)
      }
      circle(cx, cy, R, stroke: cream, width: 3)
      if !behind { circle(mx, my, 6.5, fill: cream) }
    }
  }

  // A vital: its value, and what it is under it.
  component Vital(v, k, tint = dark) {
    Column {
      gap: 0
      Text { text: v; font: cabin; fontSize: 24; fontWeight: 600; color: tint; maxLines: 1 }
      Text { text: k; font: cabin; fontSize: 10.5; fontWeight: 700; letterSpacing: 1.5; color: dim; maxLines: 1 }
    }
  }

  // The phone's entry: its name, the globe and its vitals; a tap on a vital opens its panel.
  component Entry() {
    Column {
      fill: width
      gap: 4
      padding: [22 + screenLeft, 0, 22 + screenRight, 0]
      Row {
        fill: width
        gap: 8
        align: bottom
        Text { text: dev == null ? "THE PHONE" : upper("${dev.maker} ${dev.model}"); font: cabin; fontSize: 20; fontWeight: 700; letterSpacing: 1; color: dark; maxLines: 1; weight: 1 }
        Text { text: fmtTime(now, "HH:mm"); font: cabin; fontSize: 20; fontWeight: 600; color: dark; maxLines: 1 }
      }
      Text {
        text: "MOSTLY HARMLESS" + (sys.uptime == null ? "" : " · UP ${upper(fmtDuration(sys.uptime))}")
        font: cabin; fontSize: 11.5; fontWeight: 700; letterSpacing: 2; color: crimson; maxLines: 1
      }
      Row {
        fill: width
        gap: 10
        align: center
        padding: [0, 8, 0, 0]
        Globe { }
        Column {
          weight: 1
          gap: 12
          Row {
            fill: width
            gap: 8
            Box { weight: 1; onTap: { haptic(); settings("battery") }; Vital { v: bat.level == null ? "…" : "${level}%"; k: bat.charging ? "CHARGING" : "BATTERY"; tint: level < 20 && !bat.charging ? crimson : dark } }
            Box { weight: 1; onTap: { haptic(); settings("battery") }; Vital { v: bat.temp == null ? "…" : useF ? "${round(bat.temp * 9 / 5 + 32)}°F" : "${round(bat.temp)}°C"; k: "BATTERY TEMP"; tint: num(bat.temp, 0) >= 40 ? crimson : dark } }
          }
          Row {
            fill: width
            gap: 8
            Box { weight: 1; onTap: { haptic(); settings("battery") }; Vital { v: watts == null ? "…" : "${fixed(abs(watts), 1)}W"; k: watts != null && watts > 0 ? "GOING IN" : "DRAWN" } }
            Box { weight: 1; onTap: { haptic(); launcher("settings") }; Vital { v: memF == null ? "…" : "${round(memF * 100)}%"; k: "MEMORY" } }
          }
          Row {
            fill: width
            gap: 8
            Box { weight: 1; onTap: { haptic(); launcher("settings") }; Vital { v: sys.storage == null ? "…" : fmtBytes(sys.storage.free); k: "STORAGE FREE" } }
            Box { weight: 1; onTap: { haptic(); settings("internet") }; Vital { v: down == null ? "…" : fmtBytes(down); k: "DOWN ↑${up == null ? "…" : fmtBytes(up)}" } }
          }
        }
      }
    }
  }

  // The index: the categories run in from the left edge; the open one's bar runs on to the right and its entries
  // stand in a stack above the end of it.
  component Menu() {
    Box {
      fill: width
      height: menuH
      align: topStart
      ripple: false
      // A tap on the page around the bars closes the open one.
      onTap: if sel >= 0 { sel = -1 }
      // The bar that runs out from under the open category's knob, its heading at the end.
      Box {
        width: connEnd + 18
        height: bh
        radius: bh / 2
        offset: [sel >= 0 ? -18 : -(connEnd + 80), head + last * p]
        animate offset: tween(380ms, "out")
        opacity: sel >= 0 ? 1 : 0
        animate opacity: tween(240ms, "ease")
        background: barColors[(last + 2) % 8]
        animate background: tween(300ms, "ease")
        align: end
        Row {
          gap: 8
          align: center
          Text { text: cats[last].h; font: cabin; fontSize: 14; fontWeight: 600; letterSpacing: 1; color: label; maxLines: 1 }
          Box { size: bh; radius: bh / 2; background: mix(barColors[(last + 2) % 8], ink, 0.3) }
        }
      }
      // The open category's entries, rising out of that bar one after another; they fold back into it as it closes.
      for j in range(6) {
        Box {
          width: subW
          height: bh
          radius: bh / 2
          offset: [connEnd - subW, sel >= 0 && j < len(lastItems) ? head + last * p - (j + 1) * p : head + last * p]
          animate offset: spring(0.72, 520 - j * 60)
          opacity: sel >= 0 && j < len(lastItems) ? 1 : 0
          animate opacity: tween(260ms, "ease")
          background: barColors[(j + last + 3) % 8]
          align: end
          ripple: sel >= 0 && j < len(lastItems)
          onTap: if sel >= 0 && j < len(lastItems) {
            haptic()
            let it = lastItems[j]
            if it.k == "android" { androidApp(it.a); sel = -1 }
            else if it.k == "app" { androidApp(it.a); sel = -1 }
            else if it.k == "open" { open(it.a); sel = -1 }
            else if it.k == "launcher" { launcher(it.a); sel = -1 }
            else if it.k == "settings" { settings(it.a) }
            else if it.k == "files" { run("omarchy-files"); sel = -1 }
            else if it.k == "shell" { terminal("bash -l", "shell"); sel = -1 }
            else if it.k == "media" { media("open"); sel = -1 }
            else if it.k == "dnd" { dnd("toggle") }
            else if it.k == "torch" { torch("toggle") }
            else if it.k == "snooze" { notification("snoozeAll", 3600) }
            else if it.k == "clear" { notification("clear") }
          }
          Row {
            fill: true
            gap: 8
            align: center
            padding: [14, 0, 0, 0]
            Text { text: lastItems[j].t ?? ""; font: cabin; fontSize: 14; fontWeight: 600; letterSpacing: 1; color: label; maxLines: 1; weight: 1; align: end }
            Box { size: bh; radius: bh / 2; background: mix(barColors[(j + last + 3) % 8], ink, 0.3) }
          }
        }
      }
      // The categories, over the bar they open.
      for c, i in cats {
        Box {
          width: catW + 18
          height: bh
          radius: bh / 2
          offset: [-18 + 3 * sin(beat * 1.3 + i * 2.1) + (i == sel ? 14 : 0), head + i * p]
          animate offset: tween(700ms, "ease")
          background: c.c
          onTap: { haptic(); if sel == i { sel = -1 } else { sel = i; last = i } }
          Row {
            fill: true
            gap: 8
            align: center
            padding: [30, 0, 0, 0]
            Text { text: c.t; font: cabin; fontSize: 15; fontWeight: i == sel ? 700 : 500; letterSpacing: 1; color: i == sel ? cream : label; maxLines: 1; align: end; weight: 1 }
            Box { size: bh; radius: bh / 2; background: mix(c.c, ink, 0.3); scale: i == sel && tick % 2 == 0 ? 0.78 : 1; animate scale: tween(900ms, "ease") }
          }
        }
      }
    }
  }

  // The breadcrumb at the foot, as on the film's index page: THE GUIDE closes what's open.
  component Crumb() {
    Row {
      fill: width
      height: 28
      gap: 0
      align: center
      Box {
        width: 184 + 10 * 8.6
        height: 28
        align: topStart
        Box {
          width: 48 + 10 * 8.6
          height: 28
          radius: 14
          offset: [136, 0]
          background: crumbPlum
          align: end
          padding: [0, 0, 13, 0]
          Text { text: "WHERE TO ?"; font: cabin; fontSize: 15; fontWeight: 500; letterSpacing: 1; color: label; maxLines: 1; align: end }
        }
        Box {
          width: 168
          height: 28
          radius: 14
          offset: [-16, 0]
          background: crumbBlue
          align: start
          padding: [32, 0, 0, 0]
          onTap: { haptic(); sel = -1 }
          Text { text: "THE GUIDE"; font: cabin; fontSize: 15.5; fontWeight: 700; letterSpacing: 1; color: label; maxLines: 1 }
        }
      }
      Spacer { weight: 1 }
    }
  }

  Box {
    fill: true
    // Not clipped: the bars that run off the screen's edge reach onto the page beside, so the pages join up as they
    // slide. What's parked off the side while a menu is closed is see-through instead, so it never shows there.
    Paper { base: mustard }
    Column {
      fill: true
      gap: 0
      Spacer { height: screenTop + 18 }
      Entry { }
      Spacer { weight: 1 }
      Menu { }
      Spacer { height: 14 }
      Crumb { }
      Spacer { height: 12 }
      Column {
        fill: width
        gap: 0
        background: strip
        Tabs { here: 0 }
        Spacer { height: screenInset }
      }
    }
  }
}
