widget "vacuum" {
  meta { description: "Your Xiaomi robot vacuum over your own wi-fi: battery, state, start, stop, dock, modes, a drive pad, and its floor plan drawn on the phone with rooms you tap to clean. A Mi login fetches the map."; version: "1.2.1"; license: "MIT"; category: "home"; owl: 9 }
  size: 6x4
  minSize: 2x2

  requires { pacman: ["python", "openssl", "ca-certificates"] }

  // The client is embedded at the end of this command and written to
  // ~/.cache/omarchy-vacuum/vacuum.py the first time it runs (and again whenever
  // this widget's copy changes). It talks to the robot straight over the LAN:
  // UDP 54321, miIO framing, AES-128-CBC with openssl. No cloud, no account.
  //
  // The config is created here on first run, at the path the store's own widgets
  // use; a file an earlier build wrote elsewhere is kept if it is the only one.
  // "ip = auto" means: sweep the network for the robot and remember the answer,
  // so the only thing to paste in is the token (the robot ignores broadcast
  // discovery, so this unicast sweep is the one way to find it).
  source v = cmd("""
f=~/.config/omarchy-proot/vacuum
if [ ! -f "$f" ] && [ -f ~/.config/omalauncher/vacuum ]; then
  f=~/.config/omalauncher/vacuum
fi
mkdir -p "$(dirname "$f")"
if [ ! -f "$f" ]; then
  printf 'ip = auto\ntoken = PASTE-THE-32-HEX-TOKEN-HERE\ndid = auto\n' > "$f"
  chmod 600 "$f"
fi
d=~/.cache/omarchy-vacuum
mkdir -p "$d"
if [ "$(cat "$d/tag" 2>/dev/null)" != "57f4643fcadd" ]; then
  cat > "$d/vacuum.py" <<'OMARCHY_VACUUM_PY'
#!/usr/bin/env python3
# vacuum.py - dependency-free LAN client for Xiaomi "ijai" robot vacuums.
#
# Written for a phone: it needs only python3 and the openssl command, both of
# which are in a base Arch install. Nothing is installed with pip, nothing is
# fetched from the internet, and no Xiaomi SDK is involved.
#
# It speaks the miIO protocol (UDP 54321) directly:
#
#     request = header(16) | md5(header + token + data)(16) | AES-128-CBC(json + NUL)
#     key     = md5(token)
#     iv      = md5(key + token)
#
# The same two payload rules the desktop harness needed apply here and are
# already applied below: the request carries the real device id, and action
# parameters are {piid, value} objects, never bare values.
#
# Config: ~/.config/omarchy-proot/vacuum, either "key = value" lines
#
#     ip = <robot-ip>            # or "auto": sweep the LAN and remember the answer
#     token = <32 hex characters>
#     did = 123456789
#
# or three bare lines in that order (ip, token, did). The token is the one the
# Xiaomi app uses for the robot; it is per device and does not change.
#
# That is where the store's own widgets keep their config. A config an earlier
# build wrote to ~/.config/omalauncher/vacuum is still read, as long as it is
# the only one, so nothing already set up breaks.
#
# Usage:
#     vacuum.py status                 one JSON object, for a widget
#     vacuum.py status --all           every property
#     vacuum.py action start|stop|dock|sweep-only|sweep-mop|mop
#     vacuum.py action locate          beep
#     vacuum.py prop 7 5 2             write suction = Medium
#     vacuum.py prop 2 1               read one property
#     vacuum.py raw get_map_list
#     vacuum.py discover               unicast-sweep the LAN for the robot
#     vacuum.py mapdata                the floor plan as geometry, for the widget
#     vacuum.py mapdata --file blob    decode an encrypted map blob already on disk
#     vacuum.py mapdata --refresh      fetch the live blob with the account session
#     vacuum.py mapdata --refit        recrop an existing cache, and redraw its picture
#     vacuum.py mapdata --png          redraw the picture from the cached blob
#     vacuum.py live --save            cache the newest 10/5 path chunk for the map
#     vacuum.py login --user you@x     sign in to the Mi account (password on stdin)
#     vacuum.py login --code 123456    finish an emailed-code or captcha gate
#     vacuum.py login --resend         ask for another code (Xiaomi may rate-limit)
#     vacuum.py rooms 10,11            set-room-clean (7/3, piids 24/25/26)
#     vacuum.py set --ip auto --token 0123...    write the config (setup screen)
#
# `set` is what the widget's setup screen calls. It writes the file, then says
# whether the robot answered, because a mistyped token looks exactly like a
# robot that is switched off.
#
# Every command prints a JSON object, so a widget can just use json.
#
# There is no `token` command on purpose: the token cannot be read locally. The
# handshake reply only carries md5(token + stamp), and the Mi Home app's private
# storage is not readable from here. It comes from the Xiaomi cloud once, on a
# computer, with any Xiaomi token extractor.

from __future__ import annotations

import argparse
import base64
import hashlib
import http.cookiejar
import json
import math
import os
import random
import re
import socket
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib
try:
    import fcntl                     # POSIX; the widget only runs on Linux
except ImportError:                  # pragma: no cover - Windows
    fcntl = None
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

MAGIC = 0x2131
PORT = 54321
# The robot answers the *first* request from an unknown source port with ~4 s of
# "-9999 user ack timeout", then every request from that same port is instant.
# Each widget tap is a new process, so without this it paid that penalty on every
# tap; a stable local port makes the second command onwards fast. If another
# command is still holding the port, the bind fails and any port is used.
LOCAL_PORT = 54322
HELLO = bytes.fromhex("21310020" + "ff" * 28)   # the standard discovery hello

# Where the config lives. The store's own widgets keep theirs under
# ~/.config/omarchy-proot/<name>, so that is the primary path, and the command
# the widget embeds creates it there. A config written by an earlier build to
# ~/.config/omalauncher/vacuum is still used when it is the only one, so an
# existing setup keeps working instead of being silently replaced.
CONFIG = Path(os.path.expanduser("~/.config/omarchy-proot/vacuum"))
LEGACY_CONFIG = Path(os.path.expanduser("~/.config/omalauncher/vacuum"))

# Where the widget looks for the rendered floor plan. The picture is made on a
# computer (see `cmd_map`) and the widget only carries the finished PNG across
# the LAN from `map_url`, so this file is a cache, never a source.
MAP_CACHE = Path(os.path.expanduser("~/.cache/omarchy-vacuum/map.png"))
# The device clock from the last reply. Every command the widget runs is a new
# process, and a new process used to start with a handshake; keeping the clock
# for a while means a tap can send straight away. A stale clock is not fatal:
# the robot ignores it and `send` handshakes on the retry.
HELLO_CACHE = Path(os.path.expanduser("~/.cache/omarchy-vacuum/hello.json"))
# One command at a time: the robot's ack path does not overlap requests, and two
# processes would otherwise collide on the request id.
LOCK_FILE = HELLO_CACHE.with_name("robot.lock")

# what a fresh config holds before the setup screen is filled in
PLACEHOLDER_TOKEN = "PASTE-THE-32-HEX-TOKEN-HERE"

# --------------------------------------------------------------------------- #
# properties
# --------------------------------------------------------------------------- #

# name -> (siid, piid) for everything worth showing
PROPS: dict[str, tuple[int, int]] = {
    "manufacturer": (1, 1), "model": (1, 2), "serial": (1, 3), "firmware": (1, 4),
    "status": (2, 1), "fault": (2, 2), "mode": (2, 4), "sweep_type": (2, 8),
    "switch": (2, 9), "battery": (3, 1),
    "repeat": (7, 1), "door": (7, 3), "cloth": (7, 4), "suction": (7, 5),
    "water": (7, 6), "mop_route": (7, 7),
    "side_brush_life": (7, 8), "main_brush_life": (7, 10),
    "filter_life": (7, 12), "mop_life": (7, 14),
    "cleaning_time": (7, 22), "cleaning_area": (7, 23),
    "tank_shake": (7, 48), "shake_shift": (7, 50),
    "remember_state": (10, 1), "cur_map_id": (10, 2), "map_num": (10, 3),
    "has_new_map": (10, 19), "dnd": (12, 1),
}

# the compact set the widget reads: one round trip, comfortably under the
# robot's ~25-property batch limit
WIDGET_PROPS = ["status", "fault", "battery", "mode", "sweep_type", "suction",
                "water", "mop_route", "cleaning_time", "cleaning_area",
                "side_brush_life", "main_brush_life", "filter_life", "mop_life"]

STATUS_TEXT = {0: "Sleeping", 1: "Idle", 2: "Paused", 3: "Going to charge",
               4: "Charging", 5: "Sweeping", 6: "Sweeping and mopping",
               7: "Mopping", 8: "Upgrading"}
MODE_TEXT = {0: "Sweep", 1: "Sweep + mop", 2: "Mop"}
SWEEP_TEXT = {0: "Global", 1: "Mop", 2: "Edge", 3: "Area", 4: "Point",
              5: "Remote", 6: "Explore", 7: "Room", 8: "Floor"}
SUCTION_TEXT = {0: "Silent", 1: "Standard", 2: "Medium", 3: "Turbo"}
WATER_TEXT = {0: "Low", 1: "Mid", 2: "High"}
MOP_TEXT = {0: "S", 1: "Y"}

# The robot reports a "fault" all the time, and most of the 2100 range is just
# what it is doing on the dock. 2103 sits there for the whole charge (measured:
# reported constantly across hours of normal charging), 2105 is "fully charged".
# Only anything else is worth showing.
BENIGN_FAULTS = {0, 2103, 2105}
DOCK_FAULT_TEXT = {2103: "docked", 2105: "charged"}

# name -> (siid, aiid); all LAN-only miotspec actions
ACTIONS: dict[str, tuple[int, int]] = {
    "start": (2, 1), "stop": (2, 2), "sweep-only": (2, 3),
    "sweep-mop": (2, 5), "mop": (2, 6), "dock": (3, 1),
    "reset-map": (10, 10), "get-map-list": (10, 1),
}
# commands that are really a property write
SETS: dict[str, tuple[int, int, int]] = {"locate": (4, 1, 1)}

# states where the robot is doing something
BUSY = {3, 5, 6, 7}


# --------------------------------------------------------------------------- #
# crypto: the only external tool is openssl, for AES
# --------------------------------------------------------------------------- #

def md5(data: bytes) -> bytes:
    return hashlib.md5(data).digest()  # noqa: S324 - the protocol requires md5


def aes(data: bytes, token: bytes, encrypt: bool = True) -> bytes:
    '''AES-128-CBC with PKCS7 padding, via the openssl binary.'''
    key = md5(token)
    iv = md5(key + token)
    cmd = ["openssl", "enc", "-aes-128-cbc", "-K", key.hex(), "-iv", iv.hex()]
    if not encrypt:
        cmd.insert(2, "-d")
    try:
        res = subprocess.run(cmd, input=data, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise SystemExit("openssl is required (pacman -S openssl)")
    if res.returncode != 0:
        raise RuntimeError("openssl failed: " + res.stderr.decode(errors="replace").strip())
    return res.stdout


# --------------------------------------------------------------------------- #
# protocol
# --------------------------------------------------------------------------- #

class Vacuum:
    def __init__(self, ip: str, token_hex: str, did: int | None = None,
                 timeout: float = 6.0, retries: int = 3):
        self.ip = ip
        raw = token_hex.strip()
        try:
            self.token = bytes.fromhex(raw)
        except ValueError:
            raise ValueError(
                f"the token in the config is not hex ({raw[:14]!r}) - paste the 32 "
                "hex characters the Xiaomi cloud gives you, nothing else")
        if len(self.token) != 16:
            raise ValueError(
                f"the token must be 32 hex characters, this one is {len(self.token) * 2}")
        self.did = int(did) if did else None
        self.timeout = timeout
        # How many times a whole request is tried when the robot stays silent.
        # A dashboard poll wants one try; a setup command can afford three.
        self.retries = retries
        # Reading a dozen properties falls back to single reads when the batch
        # is refused. A status poll should not turn one lost packet into twelve
        # round trips, so it can switch the fallback off.
        self.fallback = True
        # The robot ignores requests until it has seen a handshake, and the
        # handshake has to be refreshed now and then.
        self._last_hello: float | None = None
        # miIO does not use Unix time: every request must carry the *device's*
        # clock (from the handshake reply) plus one second, so we track it.
        self.device_ts = 0
        self._device_ts_at = 0.0
        # The robot caches replies by request id and treats a reused id as a
        # retransmission: it waits ~4 s for an "original" that never comes, then
        # answers -9999. Every widget tap is a new process that used to start at
        # id 1 again, so the id has to carry over (or start somewhere random).
        self._id = 0
        # The last stamp actually put on a packet. The robot treats a repeated
        # stamp as a replay and answers -9999 after ~4 s, and the *reply* stamp
        # is the device clock, which can be behind what we sent - so a new
        # process must never derive a stamp from the reply alone.
        self._last_stamp = 0
        self._warm_start()
        if not self._id:
            self._id = random.randint(1, 9000)

    def _warm_start(self) -> None:
        '''Pick up the clock another process learned, when it is still fresh.'''
        try:
            got = json.loads(HELLO_CACHE.read_text())
        except Exception:                                     # noqa: BLE001
            return
        if str(got.get("ip")) != self.ip:
            return
        try:
            age = time.time() - float(got.get("at") or 0)
            ts = int(got.get("ts") or 0)
            last = int(got.get("last") or 0)
        except Exception:                                     # noqa: BLE001
            return
        if not ts and not last or age < 0 or age > 900:
            return
        # `ts` is the device clock; `last` is the stamp we put on the last
        # packet (device clock + 1). Keeping the larger of the two is right for
        # a few seconds of drift, but a stamp hundreds of seconds ahead makes
        # the robot ignore every request until the clock catches up. That is
        # what produced the intermittent "no reply" after a long clean: a bad
        # handshake wrote ts=224, the old stamp stayed at 8793455, and every
        # later packet carried a future stamp. Clamp the carry-over.
        if ts and last > ts + 30:
            last = ts
        self.device_ts = ts or last
        self._last_stamp = last
        nxt = int(got.get("next") or 0)
        self._id = nxt if 1 <= nxt <= 9998 else 0
        self._device_ts_at = time.monotonic() - age
        self.did = self.did or got.get("did")
        if self.did:
            self._last_hello = time.monotonic()       # skip the handshake

    def remember(self) -> None:
        '''Save the clock for the next process; never worth failing a command.'''
        try:
            _write_json(HELLO_CACHE, {"ip": self.ip, "did": self.did,
                                      "ts": self.device_ts,
                                      "last": self._last_stamp,
                                      "next": self._id,
                                      "at": time.time()})
        except Exception:                                     # noqa: BLE001
            pass

    def _device_ts_now(self) -> int:
        '''The device's clock, as best as we can tell right now.'''
        if not self.device_ts:
            return 0
        return self.device_ts + int(time.monotonic() - self._device_ts_at)

    # -- low level ------------------------------------------------------- #

    def _udp(self) -> socket.socket:
        '''A socket on the stable local port, so the robot does not re-learn us.'''
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            sock.bind(("", LOCAL_PORT))
        except OSError:
            pass                     # another command is talking; any port will do
        sock.settimeout(self.timeout)
        return sock

    def _recv_matching(self, sock: socket.socket) -> bytes | None:
        '''Read datagrams until one is a real reply (not a hello).'''
        while True:
            try:
                resp, _ = sock.recvfrom(4096)
            except socket.timeout:
                return None
            if len(resp) < 32:
                continue
            r_len = struct.unpack(">H", resp[2:4])[0]
            r_dev = struct.unpack(">I", resp[8:12])[0]
            if r_len == 32:
                continue                      # a hello, not our answer
            if self.did and r_dev not in (self.did & 0xFFFFFFFF,):
                continue                      # someone else's device
            self.device_ts = struct.unpack(">I", resp[12:16])[0]
            self._device_ts_at = time.monotonic()
            self.remember()
            return resp

    def hello(self) -> int:
        '''Handshake: learn (or confirm) the device id and its clock.'''
        sock = self._udp()
        try:
            for _ in range(3):
                sock.sendto(HELLO, (self.ip, PORT))
                try:
                    resp, _ = sock.recvfrom(2048)
                except socket.timeout:
                    continue
                if len(resp) >= 32 and struct.unpack(">H", resp[2:4])[0] == 32:
                    dev = struct.unpack(">I", resp[8:12])[0]
                    # A stray 32-byte packet from another device used to be
                    # accepted here; it wrote a nonsense clock (ts=224) into the
                    # cache, and the next packets carried stamps the robot
                    # ignored. Only take a hello from the robot we mean.
                    if self.did and dev != (self.did & 0xFFFFFFFF):
                        continue
                    self.did = self.did or dev
                    self.device_ts = struct.unpack(">I", resp[12:16])[0]
                    self._device_ts_at = time.monotonic()
                    self._last_hello = time.monotonic()
                    # If the carried stamp ran away from the robot's clock (a
                    # lost reply, a long gap, a bad cache), come back to the
                    # clock we just read. A stamp only a second or two ahead is
                    # kept, so a retry never repeats the previous stamp.
                    if self._last_stamp > self.device_ts + 5:
                        self._last_stamp = self.device_ts
                    self.remember()
                    return dev
            raise TimeoutError(f"no reply from {self.ip}:{PORT}")
        finally:
            sock.close()

    def send(self, method: str, params=None, retries: int | None = None) -> dict:
        '''One encrypted miIO request, serialised with every other command.

        Two commands at once (a status poll and a tap, say) used to collide on
        the request id and on the robot's one-at-a-time ack path, and both paid
        seconds for it. A lock file makes the second wait its turn instead.
        '''
        retries = self.retries if retries is None else retries
        if fcntl is None:
            return self._send(method, params, retries)
        LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(LOCK_FILE, "a+") as lock:
            deadline = time.monotonic() + 6
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise RuntimeError(
                            "another command is still talking to the robot - "
                            "try again in a moment")
                    time.sleep(0.05)
            try:
                self._claim_id()
                return self._send(method, params, retries)
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)

    def _claim_id(self) -> None:
        '''Take the next request id now that we hold the lock, not at startup.

        Four commands started together all read the same id before any of them
        had written one back; the lock then serialised them but they still sent
        the same id and each waited out a -9999. Re-reading inside the lock
        makes the queue hand the id on.
        '''
        try:
            got = json.loads(HELLO_CACHE.read_text())
        except Exception:                                     # noqa: BLE001
            return
        if str(got.get("ip")) != self.ip:
            return
        try:
            nxt = int(got.get("next") or 0)
            last = int(got.get("last") or 0)
        except Exception:                                     # noqa: BLE001
            return
        if 1 <= nxt <= 9998:
            self._id = max(self._id, nxt)
        # The stamp has to carry over too. Two processes can take turns under
        # the lock; if the second one starts from the stamp it remembered at
        # startup, it sends an older stamp than the first just used and the
        # robot treats that as a replay.
        if last:
            self._last_stamp = max(self._last_stamp, last)

    def _send(self, method: str, params=None, retries: int = 3) -> dict:
        last: Exception | None = None
        for attempt in range(retries):
            if self.did is None or self._last_hello is None \
                    or time.monotonic() - self._last_hello > 20:
                self.hello()
            try:
                res = self._send_once(method, params)
            except TimeoutError as exc:
                last = exc
                self._last_hello = None          # force a fresh handshake
                continue
            err = res.get("error") if isinstance(res, dict) else None
            if err and err.get("code") == -9999 and attempt < retries - 1:
                last = RuntimeError(str(err.get("message") or "device ack timeout"))
                self._last_hello = None
                continue
            if err and err.get("code") == -9999:
                raise RuntimeError(
                    f"the robot kept answering -9999 (user ack timeout) for {method}; "
                    "it is busy - try again in a moment")
            return res
        raise last if last else RuntimeError(f"{method} failed")

    def _send_once(self, method: str, params=None) -> dict:
        request_id = self._id
        self._id = 1 if self._id >= 9999 else self._id + 1
        payload = json.dumps({"id": request_id, "method": method,
                              "params": params if params is not None else []})
        data = aes(payload.encode() + b"\x00", self.token, True)
        stamp = max(self._device_ts_now(), self._last_stamp) + 1
        self._last_stamp = stamp
        # Persist before the packet leaves: a lost reply used to leave the cache
        # behind, so the next process reused an id and a stamp the robot had
        # already seen. The lock is held here, so this write is the hand-off.
        self.remember()
        header = (struct.pack(">HHI", MAGIC, 32 + len(data), 0)
                  + struct.pack(">I", self.did) + struct.pack(">I", stamp))
        packet = header + md5(header + self.token + data) + data

        sock = self._udp()
        try:
            for _ in range(3):
                sock.sendto(packet, (self.ip, PORT))
                resp = self._recv_matching(sock)
                if resp is not None:
                    break
            else:
                raise TimeoutError(f"no reply from {self.ip} for {method}")
        finally:
            sock.close()

        plain = aes(resp[32:], self.token, False).rstrip(b"\x00")
        return json.loads(plain)

    # -- helpers --------------------------------------------------------- #

    def _read(self, names: list[str]) -> dict:
        '''One get_properties request for the named properties.'''
        params = [{"did": f"{PROPS[n][0]}-{PROPS[n][1]}", "siid": PROPS[n][0],
                   "piid": PROPS[n][1]} for n in names]
        res = self.send("get_properties", params)
        got = {f"{r.get('siid')}/{r.get('piid')}": r.get("value")
               for r in (res.get("result") or []) if r.get("code") == 0}
        return {n: got.get(f"{PROPS[n][0]}/{PROPS[n][1]}") for n in names}

    def get(self, names: list[str], chunk: int = 12) -> dict:
        '''Read several properties, going one at a time if the robot is flaky.

        A big request is a bigger reply, and the robot answers those with
        ``-9999`` more often, so keep the batches small and fall back to single
        reads for whichever batch it refuses.
        '''
        out: dict[str, object] = {}
        for i in range(0, len(names), chunk):
            part = names[i:i + chunk]
            try:
                out.update(self._read(part))
            except Exception:                              # noqa: BLE001
                if not self.fallback:
                    raise
                for name in part:
                    try:
                        out.update(self._read([name]))
                    except Exception:                      # noqa: BLE001
                        out[name] = None
        return out

    def action(self, name: str) -> dict:
        if name in SETS:
            s, p, v = SETS[name]
            return self.set_prop(s, p, v)
        siid, aiid = ACTIONS[name]
        # rule 1: a dict carrying the real device id
        return self.send("action", {"did": self.did, "siid": siid, "aiid": aiid, "in": []})

    def set_prop(self, siid: int, piid: int, value, retries: int = 3) -> dict:
        return self.send("set_properties", [{"did": f"{siid}-{piid}", "siid": siid,
                                             "piid": piid, "value": value}],
                         retries=retries)

    def call(self, siid: int, aiid: int, params: list) -> dict:
        # rule 2: parameters are {piid, value} objects, never bare values
        return self.send("action", {"did": self.did, "siid": siid, "aiid": aiid,
                                    "in": params})


# --------------------------------------------------------------------------- #
# the map: the blob, and the geometry a widget can draw
# --------------------------------------------------------------------------- #
#
# The robot uploads its floor plan to Xiaomi's object storage as an encrypted
# blob, and that blob is the only place the map exists - the robot serves no
# local endpoint for it. Nothing about it is secret from *us*, though: the key
# is derived from the robot itself (serial, owner, device id, model, mac),
# which is exactly what the phone app does. So the phone can fetch, decrypt and
# read the map by itself, given the account session the setup screen logs in
# with.
#
# The app's own chain, in order:
#
#   base64 -> AES-128-ECB(key) -> pkcs7 unpad -> ascii hex -> zlib -> protobuf
#
#   key = md5( base64( AES-128-ECB( "sn+owner+did", key = mac + model-suffix ) ) )
#
# openssl does the AES (it is already a dependency for miIO) and hashlib the
# MD5; the model suffix is the last dotted word of the model, left-padded to
# four characters ("ijai.vacuum.v15" -> "0v15").
#
# The protobuf is RobotMap; only a few of its messages are read here - the
# header (grid size and bounds), the grid itself (one byte per cell: walls,
# floor, and a room number per room pixel), the room table (number and name),
# the coverage path, and the two poses. The full schema is in the project notes.
#
# What comes out is "geometry": every coordinate scaled to 0..1 of the grid and
# y flipped, so that (0,0) is the top-left of a picture and a widget can draw
# it at whatever size it has. That is what the map tab draws, and it is also
# where the room numbers for a room clean come from - the robot's own room list
# (10/13) reports one stale room, while the blob holds all of them.

MAP_JSON = Path(os.path.expanduser("~/.cache/omarchy-vacuum/map.json"))
MAP_BLOB = Path(os.path.expanduser("~/.cache/omarchy-vacuum/map.raw"))
LIVE_JSON = Path(os.path.expanduser("~/.cache/omarchy-vacuum/live.json"))

# The app gives each room its own colour. Keep the same idea locally, but with
# clearly different pastels rather than nearly identical blues. The colours are
# data, so every decoded map uses the same palette.
ROOM_COLORS = {
    10: "#6e9bf7",   # room1 - blue
    11: "#f2c14e",   # room2 - yellow
    12: "#e07be0",   # room3 - magenta
    13: "#f28c5b",   # room4 - orange
    14: "#6fd08c",   # room 14 - green
    15: "#58d6d0",   # room 15 - cyan
    16: "#b9a7ff",   # room7 - lavender (maps with more than six rooms)
    17: "#f7a8c4",   # room8 - pink
    18: "#9ed36a",   # room9 - lime
    19: "#f0d36a",   # room10 - gold
    20: "#8fc7ff",   # room11 - sky
}
FALLBACK_COLORS = ["#6e9bf7", "#f2c14e", "#e07be0", "#f28c5b", "#6fd08c",
                   "#58d6d0", "#b9a7ff", "#f7a8c4", "#9ed36a", "#f0d36a",
                   "#8fc7ff"]


def room_color(rid: int) -> str:
    return ROOM_COLORS.get(int(rid), FALLBACK_COLORS[int(rid) % len(FALLBACK_COLORS)])

# grid cell values, as the app's own IjaiImageParser reads them
CELL_WALL = 0xFF
ROOM_MIN, ROOM_MAX = 10, 59        # the cell is the room number
CLEAN_MIN, CLEAN_MAX = 60, 109     # the cell is 50 + the room number: already cleaned


def _openssl_ecb(data: bytes, key: bytes, decrypt: bool = False,
                 pad: bool = True) -> bytes:
    '''AES-128-ECB through the openssl command, the only crypto tool here.'''
    args = ["enc", "-aes-128-ecb", "-nosalt", "-K", key.hex()]
    if decrypt:
        args.append("-d")
    if not pad:
        args.append("-nopad")
    proc = subprocess.run(["openssl", *args], input=data,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode:
        raise RuntimeError("openssl: " + proc.stderr.decode()[:200].strip())
    return proc.stdout


def map_key(sn: str, owner: str, did: str, model: str, mac: str) -> str:
    '''md5key(sn+owner+did, model, mac): the robot's own map key, in hex.'''
    pj = "".join(mac.lower().split(":"))
    # the v-series robots use the whole md5 digest; older ones only its middle.
    # That test is on the model's own last word ("v15"), *before* it is padded.
    series = model.split(".")[-1].lower()
    suffix = series
    if len(suffix) == 2:
        suffix = "00" + suffix
    elif len(suffix) == 3:
        suffix = "0" + suffix
    elif len(suffix) > 4:
        suffix = suffix[-4:]
    # AES over the ascii key string (openssl pads it), then MD5 of its base64
    blob = base64.b64encode(_openssl_ecb("+".join([sn, owner, did]).encode(),
                                         (pj + suffix).encode()))
    md5 = hashlib.md5(blob).hexdigest()
    if series in ("v1", "v2", "v3", "v13", "v15", "v17", "v18", "v19", "sz02",
                  "c101", "c103", "c104", "c101eu", "b106eu", "b106tr"):
        return md5
    return md5[8:-8].upper()


def map_decrypt(raw: bytes, sn: str, owner: str, did: str, model: str,
                mac: str) -> bytes:
    '''The encrypted blob -> the RobotMap protobuf.'''
    try:
        data = base64.b64decode(raw, validate=True)
    except Exception:                                          # noqa: BLE001
        data = raw
    try:
        plain = _openssl_ecb(data, bytes.fromhex(map_key(sn, owner, did, model, mac)),
                             decrypt=True, pad=False)
    except Exception as exc:                                  # noqa: BLE001
        raise ValueError(friendly_decrypt_error(exc)) from exc
    if not plain or not 1 <= plain[-1] <= 16:
        raise ValueError(friendly_decrypt_error(None))
    body = plain[:-plain[-1]]
    if plain[-plain[-1]:] != bytes([plain[-1]]) * plain[-1]:
        raise ValueError(friendly_decrypt_error(None))
    # the plaintext is itself an ascii hex string holding a zlib stream
    try:
        return zlib.decompress(bytes.fromhex(body.decode("ascii")))
    except Exception as exc:                                  # noqa: BLE001
        raise ValueError(friendly_decrypt_error(exc)) from exc


def friendly_decrypt_error(exc: Exception | None) -> str:
    '''One sentence a person can act on, instead of a cipher's own wording.

    Two things produce this: the ~21 KB blob the robot uploads while a clean is
    in progress (only a completed clean replaces it with the real ~110 KB one),
    and a key that is wrong because the token or the serial is stale.
    '''
    where = "" if exc is None else f" ({type(exc).__name__}: {exc})"
    return ("the map blob did not decrypt: the robot's temporary map from an "
            "unfinished clean, or a token/serial that does not match. let it "
            "finish one full clean (it must dock and report finished), or save "
            f"the token again on the setup tab, then fetch again{where}")


# --------------------------------------------------------------------------- #
# protobuf: just enough of proto3 to walk RobotMap
# --------------------------------------------------------------------------- #

def _pb_varint(buf: bytes, i: int) -> tuple[int, int]:
    out = 0
    shift = 0
    while True:
        b = buf[i]
        i += 1
        out |= (b & 0x7F) << shift
        if not b & 0x80:
            return out, i
        shift += 7


def _pb_group(buf: bytes) -> dict[int, list]:
    '''One message as {field number: [values]}; ints for varints, bytes for the rest.'''
    out: dict[int, list] = {}
    i, n = 0, len(buf)
    while i < n:
        key, i = _pb_varint(buf, i)
        fn, wt = key >> 3, key & 7
        if wt == 0:
            v, i = _pb_varint(buf, i)
        elif wt == 2:
            ln, i = _pb_varint(buf, i)
            v, i = buf[i:i + ln], i + ln
        elif wt == 5:
            v, i = buf[i:i + 4], i + 4
        elif wt == 1:
            v, i = buf[i:i + 8], i + 8
        else:
            raise ValueError(f"unexpected protobuf wire type {wt}")
        out.setdefault(fn, []).append(v)
    return out


def _pb_one(d: dict, fn: int, default=None):
    v = d.get(fn)
    return v[0] if v else default


def _pb_f32(b) -> float:
    return struct.unpack("<f", b)[0] if isinstance(b, (bytes, bytearray)) and len(b) == 4 else 0.0


def _pb_str(b) -> str:
    return b.decode("utf-8", "replace") if isinstance(b, (bytes, bytearray)) else ""


def parse_map(proto: bytes) -> dict:
    '''Walk RobotMap into plain python (see RobotMap.proto for the numbers).'''
    top = _pb_group(proto)

    head = _pb_group(_pb_one(top, 3, b"") or b"")
    size_x = _pb_one(head, 2, 0)
    size_y = _pb_one(head, 3, 0)

    data = _pb_group(_pb_one(top, 4, b"") or b"")
    grid = _pb_one(data, 1, b"") or b""

    rooms = []
    for raw in top.get(12, []):
        r = _pb_group(raw)
        pos = _pb_group(_pb_one(r, 8, b"") or b"")
        prefs = _pb_group(_pb_one(r, 9, b"") or b"")
        rooms.append({"roomId": _pb_one(r, 1, 0), "name": _pb_str(_pb_one(r, 2, b"")),
                      "type": _pb_one(r, 3, 0),
                      "cleanState": _pb_one(r, 5, 0), "roomClean": _pb_one(r, 6, 0),
                      "colorId": _pb_one(r, 10, 0),
                      "cleanMode": _pb_one(prefs, 1, 0),
                      "nameX": _pb_f32(_pb_one(pos, 1)), "nameY": _pb_f32(_pb_one(pos, 2))})

    hist = _pb_group(_pb_one(top, 6, b"") or b"")
    path = [(_pb_f32(_pb_one(_pb_group(p), 2)), _pb_f32(_pb_one(_pb_group(p), 3)))
            for p in hist.get(2, [])]

    station = _pb_group(_pb_one(top, 7, b"") or b"")
    current = _pb_group(_pb_one(top, 8, b"") or b"")

    # The obstacle/furniture layer is not in the grid at all. These are the
    # RobotMap fields the phone app draws as furniture outlines, no-go zones
    # and the little detected-object dots:
    #   9  virtualWalls     DeviceAreaDataInfo
    #   10 areasInfo        DeviceAreaDataInfo (restricted / no-go)
    #   11 navigationPoints DeviceNavigationPointDataInfo
    #   15 objects          ObjectDataInfo (objectTypeId + x/y + name)
    #   16 furnitureInfo    FurnitureDataInfo (typeId + outline points)
    walls = [{"status": _pb_one(a, 1, 0), "type": _pb_one(a, 2, 0),
              "index": _pb_one(a, 3, 0),
              "points": [(_pb_f32(_pb_one(p, 1)), _pb_f32(_pb_one(p, 2)))
                         for p in (_pb_group(q) for q in a.get(4, []))]}
             for a in (_pb_group(q) for q in top.get(9, []))]
    areas = [{"status": _pb_one(a, 1, 0), "type": _pb_one(a, 2, 0),
              "index": _pb_one(a, 3, 0),
              "points": [(_pb_f32(_pb_one(p, 1)), _pb_f32(_pb_one(p, 2)))
                         for p in (_pb_group(q) for q in a.get(4, []))]}
             for a in (_pb_group(q) for q in top.get(10, []))]
    nav = [{"id": _pb_one(p, 1, 0), "status": _pb_one(p, 2, 0),
            "type": _pb_one(p, 3, 0),
            "x": _pb_f32(_pb_one(p, 4)), "y": _pb_f32(_pb_one(p, 5)),
            "phi": _pb_f32(_pb_one(p, 6))}
           for p in (_pb_group(q) for q in top.get(11, []))]
    objects = [{"id": _pb_one(o, 1, 0), "type": _pb_one(o, 2, 0),
                "name": _pb_str(_pb_one(o, 3, b"")),
                "confirm": _pb_one(o, 4, 0),
                "x": _pb_f32(_pb_one(o, 5)), "y": _pb_f32(_pb_one(o, 6)),
                "url": _pb_str(_pb_one(o, 7, b"")),
                "notShow": _pb_one(o, 8, 0)}
               for o in (_pb_group(q) for q in top.get(15, []))]
    furniture = [{"id": _pb_one(f, 1, 0), "type": _pb_one(f, 2, 0),
                  "points": [(_pb_f32(_pb_one(p, 1)), _pb_f32(_pb_one(p, 2)))
                             for p in (_pb_group(q) for q in f.get(3, []))],
                  "url": _pb_str(_pb_one(f, 4, b"")),
                  "status": _pb_one(f, 5, 0)}
                 for f in (_pb_group(q) for q in top.get(16, []))]

    return {
        "sizeX": size_x, "sizeY": size_y,
        "minX": _pb_f32(_pb_one(head, 4)), "minY": _pb_f32(_pb_one(head, 5)),
        "maxX": _pb_f32(_pb_one(head, 6)), "maxY": _pb_f32(_pb_one(head, 7)),
        "resolution": _pb_f32(_pb_one(head, 8)),
        "grid": grid, "rooms": rooms, "path": path,
        # DevicePoseDataInfo is x=1, y=2, phi=3 (the charger); DeviceCurrentPoseInfo
        # puts the robot at x=3, y=4, phi=5 and counts at 1 and 2.
        "charger": (_pb_f32(_pb_one(station, 1)), _pb_f32(_pb_one(station, 2))),
        "vacuum": (_pb_f32(_pb_one(current, 3)), _pb_f32(_pb_one(current, 4))),
        "virtualWalls": walls, "areas": areas, "navigation": nav,
        "objects": objects, "furniture": furniture,
    }


def _rect_cover(grid: bytes, sx: int, sy: int,
                max_rects: int) -> dict[int, list[list[int]]]:
    '''Every room's cells as a short list of rectangles (x, y, w, h in cells).

    One pass over the grid, one row at a time, letting a room's rectangle grow
    downwards only while the next run's left and right edges stay within a few
    cells of the rectangle's *first* run and the union still holds only this
    room. The first-run anchor stops a slow drift from walking a rectangle
    across its neighbour; the grid check stops a small tolerance from covering
    a doorway or the gap in an L-, T- or U-shaped room. Anything else starts a
    new rectangle.

    The earlier version continued a rectangle whenever a lower run overlapped
    it, and grew it to the union. A hallway that wraps around the living room
    has a full-width top row, so both lower arms overlapped it and the whole
    hallway became one box around the living room; a tap in a corner then chose
    the hallway. With the edge and grid checks the arms stay separate and a
    tap can only select the room actually under it.

    These rectangles are the fallback drawing and the map's hit test; the
    picture itself is rendered from the grid (see `render_plan_png`).
    '''
    edge_tol = 2                         # map cells, not screen pixels
    rects: dict[int, list[list[int]]] = {}
    # Each entry keeps the rectangle's first run, which is the anchor its later
    # rows are compared with.
    last: dict[int, list[tuple[list[int], int, int]]] = {}

    def same_room(rid: int, x0: int, x1: int, y0: int, y1: int) -> bool:
        '''True when every cell in this half-open box is still this room.'''
        for yy in range(y0, y1):
            base = yy * sx
            for xx in range(x0, x1):
                cell = grid[base + xx]
                if ROOM_MIN <= cell <= ROOM_MAX:
                    got = cell
                elif CLEAN_MIN <= cell <= CLEAN_MAX:
                    got = cell - CLEAN_MIN + ROOM_MIN
                else:
                    got = -1
                if got != rid:
                    return False
        return True

    for y in range(sy):
        row = y * sx
        runs: list[tuple[int, int, int]] = []
        prev, start = -1, 0
        for x in range(sx):
            cell = grid[row + x]
            if ROOM_MIN <= cell <= ROOM_MAX:
                rid = cell
            elif CLEAN_MIN <= cell <= CLEAN_MAX:
                rid = cell - CLEAN_MIN + ROOM_MIN
            else:
                rid = -1
            if rid != prev:
                if prev >= 0:
                    runs.append((prev, start, x))
                prev, start = rid, x
        if prev >= 0:
            runs.append((prev, start, sx))

        cur: dict[int, list[tuple[list[int], int, int]]] = {}
        for rid, x0, x1 in runs:
            items = last.get(rid, [])
            best: tuple[int, int, list[int], int, int] | None = None
            for i, (rect, ax0, ax1) in enumerate(items):
                if abs(x0 - ax0) > edge_tol or abs(x1 - ax1) > edge_tol:
                    continue
                over = min(x1, rect[0] + rect[2]) - max(x0, rect[0])
                if over <= 0:
                    continue
                # Only the strips the old rectangle did not already prove are
                # this room need checking: new columns above, and old columns
                # outside the current run.
                left, right = min(x0, rect[0]), max(x1, rect[0] + rect[2])
                if not (same_room(rid, left, rect[0], rect[1], y)
                        and same_room(rid, rect[0] + rect[2], right, rect[1], y)
                        and same_room(rid, left, x0, y, y + 1)
                        and same_room(rid, x1, right, y, y + 1)):
                    continue
                if best is None or over > best[0]:
                    best = (over, i, rect, ax0, ax1)
            if best is not None:                         # continue that rectangle
                _, i, rect, ax0, ax1 = best
                items.pop(i)                 # one run may feed only one rect
                left, right = min(x0, rect[0]), max(x1, rect[0] + rect[2])
                rect[0], rect[2], rect[3] = left, right - left, y + 1 - rect[1]
                cur.setdefault(rid, []).append((rect, ax0, ax1))
            elif len(rects.get(rid, [])) < max_rects:
                rect = [x0, y, x1 - x0, 1]
                rects.setdefault(rid, []).append(rect)
                cur.setdefault(rid, []).append((rect, x0, x1))
            # else: this room already has enough rectangles to hit-test with
        last = cur
    return rects


# Bumped when the view window changes shape. A cache written by an older build
# (a square window) is refitted once, which is what `mapdata --refit` does.
FIT = 2


def _fit_geometry(geo: dict, pad: float = 0.03) -> dict:
    '''Crop a decoded map to the part the robot actually uses.

    The blob's header bounds cover the whole 800x800 grid, including empty
    margins, so a map drawn 0..1 is a postage stamp in the middle. The app
    crops to the rooms. This does the same, but keeps x and y at their real
    ratio: the window is as wide as the plan and as tall as the plan, not a
    square. A portrait floor plan in a square frame wasted a third of the width,
    which is why the rooms looked small and squeezed to one side. `view` records
    the window's metres so the widget can give the picture the same shape.

    `bounds` is rewritten to the same raw-metre window because the live 10/5
    pose is placed with those raw metres, not with the normalised coordinates.
    '''
    if geo.get("fit") == FIT:
        return geo
    b = geo.get("bounds")
    if not b or len(b) < 4:
        return geo
    minx, maxx, miny, maxy = (float(v) for v in b[:4])
    span_x = (maxx - minx) or 1.0
    span_y = (maxy - miny) or 1.0
    xs: list[float] = []
    ys: list[float] = []

    def point(p) -> None:
        if isinstance(p, (list, tuple)) and len(p) >= 2:
            xs.append(minx + float(p[0]) * span_x)
            ys.append(maxy - float(p[1]) * span_y)

    def box(q) -> None:
        if isinstance(q, (list, tuple)) and len(q) >= 4:
            x, y, w, h = (float(v) for v in q[:4])
            point([x, y])
            point([x + w, y + h])

    for r in geo.get("rooms", []):
        for p in r.get("parts", []):
            box(p)
        point(r.get("label") or [])
    for p in geo.get("path", []):
        point(p)
    for key in ("charger", "vacuum"):
        point(geo.get(key) or [])
    for o in geo.get("objects", []):
        point(o.get("at") or [])
    for key in ("furniture", "areas", "virtual_walls"):
        for f in geo.get(key, []):
            for p in f.get("points", []):
                point(p)
    for n in geo.get("navigation", []):
        point(n.get("at") or [])

    if not xs or not ys:
        return geo
    x0, x1 = min(xs), max(xs)
    y0, y1 = min(ys), max(ys)
    if x1 - x0 < 1e-6 or y1 - y0 < 1e-6:
        return geo
    win_w = (x1 - x0) * (1 + 2 * pad)
    win_h = (y1 - y0) * (1 + 2 * pad)
    cx, cy = (x0 + x1) / 2, (y0 + y1) / 2

    def nx(x: float) -> float:
        return 0.5 + (float(x) - cx) / win_w

    def ny(y: float) -> float:
        return 0.5 - (float(y) - cy) / win_h

    def tpoint(p) -> list[float]:
        return [round(nx(minx + float(p[0]) * span_x), 4),
                round(ny(maxy - float(p[1]) * span_y), 4)]

    def tbox(q) -> list[float]:
        x, y, w, h = (float(v) for v in q[:4])
        return [round(nx(minx + x * span_x), 4),
                round(ny(maxy - y * span_y), 4),
                round(w * span_x / win_w, 4),
                round(h * span_y / win_h, 4)]

    for r in geo.get("rooms", []):
        r["parts"] = [tbox(p) for p in r.get("parts", [])]
        if r.get("box"):
            r["box"] = tbox(r["box"])
        if r.get("label"):
            r["label"] = tpoint(r["label"])
    geo["path"] = [tpoint(p) for p in geo.get("path", [])]
    for key in ("charger", "vacuum"):
        if geo.get(key):
            geo[key] = tpoint(geo[key])
    for o in geo.get("objects", []):
        if o.get("at"):
            o["at"] = tpoint(o["at"])
    for key in ("furniture", "areas", "virtual_walls"):
        for f in geo.get(key, []):
            f["points"] = [tpoint(p) for p in f.get("points", [])]
    for n in geo.get("navigation", []):
        if n.get("at"):
            n["at"] = tpoint(n["at"])
    geo["bounds"] = [round(cx - win_w / 2, 4), round(cx + win_w / 2, 4),
                     round(cy - win_h / 2, 4), round(cy + win_h / 2, 4)]
    geo["view"] = [round(win_w, 3), round(win_h, 3)]
    geo["hits"] = sorted([{"id": r["id"], "box": p}
                          for r in geo.get("rooms", []) for p in r.get("parts", [])],
                         key=lambda h: h["box"][2] * h["box"][3])
    geo["fit"] = FIT
    geo["fitted"] = True
    return geo


def _hex_rgb(name: str) -> tuple[int, int, int]:
    s = str(name).lstrip("#")
    try:
        return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))
    except (ValueError, IndexError):
        return (128, 128, 128)


def _write_png(path: Path, w: int, h: int, rows: list[bytes],
               palette: list[tuple[int, int, int, int]]) -> None:
    '''A palette PNG from index rows, with no imaging library at all.'''
    def chunk(tag: bytes, data: bytes) -> bytes:
        body = tag + data
        return (struct.pack(">I", len(data)) + body
                + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF))

    raw = b"".join(b"\x00" + row for row in rows)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 3, 0, 0, 0))
           + chunk(b"PLTE", b"".join(bytes(c[:3]) for c in palette))
           + chunk(b"tRNS", bytes(c[3] for c in palette))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".part")
    tmp.write_bytes(png)
    tmp.replace(path)


def render_plan_png(m: dict, geo: dict) -> Path | None:
    '''The blob's own grid as a picture, in the widget's colours.

    This is what the map tab shows: one pixel block per map cell, so walls,
    doorways and the real room shapes are there instead of a handful of
    rectangles. Every coordinate in `geo` already lives in the window
    `geo["bounds"]` describes, so the same window is used for the cells; the
    Canvas over it then lines up with the picture exactly.

    The file name carries a stamp and the previous picture is removed, so the
    launcher never keeps showing a cached image with the same path.
    '''
    b = geo.get("bounds")
    sx, sy = m.get("sizeX") or 0, m.get("sizeY") or 0
    grid = m.get("grid") or b""
    if not b or len(b) < 4 or sx <= 0 or sy <= 0 or len(grid) < sx * sy:
        return None
    minx, maxx, miny, maxy = (float(v) for v in b[:4])
    cell_w = (m["maxX"] - m["minX"]) / sx or 1.0
    cell_h = (m["maxY"] - m["minY"]) / sy or 1.0
    # The grid's own rows run from minY up (row 0 is minY, the bottom of the
    # drawing), which is why a higher row is higher on the picture.
    gx0 = max(0, int(math.floor((minx - m["minX"]) / cell_w)))
    gx1 = min(sx, int(math.ceil((maxx - m["minX"]) / cell_w)))
    gy0 = max(0, int(math.floor((miny - m["minY"]) / cell_h)))
    gy1 = min(sy, int(math.ceil((maxy - m["minY"]) / cell_h)))
    if gx1 <= gx0 or gy1 <= gy0:
        return None
    cw, ch = gx1 - gx0, gy1 - gy0
    scale = max(1, min(6, round(1000 / max(cw, ch))))

    palette: list[tuple[int, int, int, int]] = []
    index: dict[tuple[int, int, int, int], int] = {}

    def colour(v: int) -> int:
        if v in (127, 128) or v == CELL_WALL:
            rgba = (126, 132, 145, 255)
        elif ROOM_MIN <= v <= ROOM_MAX:
            rgba = (*_hex_rgb(room_color(v)), 205)
        elif CLEAN_MIN <= v <= CLEAN_MAX:                 # already cleaned
            rgb = _hex_rgb(room_color(v - CLEAN_MIN + ROOM_MIN))
            rgba = (*[min(255, c + 40) for c in rgb], 230)
        elif v == 0:                                      # outside the flat
            rgba = (0, 0, 0, 0)
        else:                                             # obstacles, oddities
            rgba = (105, 111, 124, 255)
        got = index.get(rgba)
        if got is None:
            got = index[rgba] = len(palette)
            palette.append(rgba)
        return got

    rows: list[bytes] = []
    for gy in range(gy1 - 1, gy0 - 1, -1):          # top of the picture first
        base = gy * sx
        line = bytes(colour(grid[base + gx]) for gx in range(gx0, gx1))
        if scale > 1:
            line = b"".join(bytes((v,)) * scale for v in line)
        rows.extend([line] * scale)

    path = MAP_CACHE.with_name(f"plan-{int(time.time())}.png")
    _write_png(path, cw * scale, ch * scale, rows, palette)
    for old in MAP_CACHE.parent.glob("plan-*.png"):
        if old != path:
            try:
                old.unlink()
            except OSError:
                pass
    return path


def map_geometry(proto: bytes, max_rects: int = 64,
                 max_path: int = 400) -> dict:
    '''The protobuf as geometry the widget can draw: rooms, path, poses, 0..1.'''
    m = parse_map(proto)
    sx, sy = m["sizeX"], m["sizeY"]
    if sx <= 0 or sy <= 0 or len(m["grid"]) < sx * sy:
        raise ValueError("the map blob has no usable grid")
    span_x = (m["maxX"] - m["minX"]) or 1.0
    span_y = (m["maxY"] - m["minY"]) or 1.0

    def nx(x: float) -> float:          # map x -> 0..1 across
        return min(1.0, max(0.0, (x - m["minX"]) / span_x))

    def ny(y: float) -> float:          # map y -> 0..1 down, flipped for the screen
        return min(1.0, max(0.0, 1.0 - (y - m["minY"]) / span_y))

    covers = _rect_cover(m["grid"], sx, sy, max_rects)
    cleaned = sorted({v - CLEAN_MIN + ROOM_MIN
                      for v in set(m["grid"]) if CLEAN_MIN <= v <= CLEAN_MAX})
    # Cell counts give the real cleanable area of an L-shaped room; width and
    # height below are the bounding box, which is what the app labels with.
    cells: dict[int, int] = {}
    for v in m["grid"]:
        if ROOM_MIN <= v <= ROOM_MAX:
            cells[v] = cells.get(v, 0) + 1
        elif CLEAN_MIN <= v <= CLEAN_MAX:
            rid = v - CLEAN_MIN + ROOM_MIN
            cells[rid] = cells.get(rid, 0) + 1
    cell_x, cell_y = span_x / sx, span_y / sy
    rooms = []
    for r in m["rooms"] + [{"roomId": i, "name": "", "nameX": 0.0, "nameY": 0.0}
                           for i in sorted(covers) if i not in {q["roomId"] for q in m["rooms"]}]:
        parts = covers.get(r["roomId"])
        if not parts:
            continue
        boxes = [[round(x / sx, 4), round(1 - (y + h) / sy, 4),
                  round(w / sx, 4), round(h / sy, 4)] for x, y, w, h in parts]
        x0 = min(b[0] for b in boxes)
        y0 = min(b[1] for b in boxes)
        x1 = max(b[0] + b[2] for b in boxes)
        y1 = max(b[1] + b[3] for b in boxes)
        label = [round((x0 + x1) / 2, 4), round((y0 + y1) / 2, 4)]
        if r["nameX"] or r["nameY"]:      # the robot's own label position, if it has one
            lx, ly = nx(r["nameX"]), ny(r["nameY"])
            if x0 <= lx <= x1 and y0 <= ly <= y1:
                label = [round(lx, 4), round(ly, 4)]
        rooms.append({"id": r["roomId"], "name": r["name"] or f"room{r['roomId']}",
                      "parts": boxes, "label": label, "color": room_color(r["roomId"]),
                      "box": [round(x0, 4), round(y0, 4), round(x1 - x0, 4), round(y1 - y0, 4)],
                      "dims": {"w": round((x1 - x0) * span_x, 2),
                               "h": round((y1 - y0) * span_y, 2),
                               "area": round(cells.get(r["roomId"], 0) * cell_x * cell_y, 1),
                               "bbox_area": round((x1 - x0) * span_x * (y1 - y0) * span_y, 1),
                               "actual": None, "estimated": False},
                      "cleaned": r["roomId"] in cleaned})

    stride = max(1, len(m["path"]) // max_path)
    path = [[round(nx(x), 4), round(ny(y), 4)]
            for x, y in m["path"][::stride]]

    if not rooms:
        # The app's own library has a "beautify" pass for this: a grid that holds
        # only 0/127/128 has no room pixels, and the rooms have to be inferred
        # from the room chain instead. That pass is not ported here yet - say so
        # rather than drawing an empty floor.
        raise ValueError("this map has no room pixels (the robot's 'unpainted' "
                         "map); this build cannot draw it yet")

    def at(x: float, y: float) -> list[float]:
        return [round(nx(x), 4), round(ny(y), 4)]

    def inside(x: float, y: float) -> bool:
        return (m["minX"] - 1 <= x <= m["maxX"] + 1 and
                m["minY"] - 1 <= y <= m["maxY"] + 1)

    objects = [{"id": o["id"], "type": o["type"], "name": o["name"],
                "confirm": o["confirm"], "notShow": o["notShow"],
                "url": o["url"][:300], "at": at(o["x"], o["y"])}
               for o in m["objects"] if inside(o["x"], o["y"])]
    furniture = [{"id": f["id"], "type": f["type"], "status": f["status"],
                  "url": f["url"][:300],
                  "points": [at(x, y) for x, y in f["points"] if inside(x, y)]}
                 for f in m["furniture"] if f["points"]]
    virtual_walls = [{"status": a["status"], "type": a["type"], "index": a["index"],
                      "points": [at(x, y) for x, y in a["points"]]}
                     for a in m["virtualWalls"]]
    areas = [{"status": a["status"], "type": a["type"], "index": a["index"],
              "points": [at(x, y) for x, y in a["points"]]}
             for a in m["areas"]]
    navigation = [{"id": p["id"], "status": p["status"], "type": p["type"],
                   "phi": round(p["phi"], 3), "at": at(p["x"], p["y"])}
                  for p in m["navigation"] if inside(p["x"], p["y"])]

    geo = {
        "ok": True,
        "size": [sx, sy],
        # The live path (10/5) uses raw map metres. Keeping the blob's bounds
        # lets the widget place that pose on the same drawing without re-reading
        # the blob.
        "bounds": [m["minX"], m["maxX"], m["minY"], m["maxY"]],
        "rooms": rooms,
        "path": path,
        "charger": [round(nx(m["charger"][0]), 4), round(ny(m["charger"][1]), 4)],
        "vacuum": [round(nx(m["vacuum"][0]), 4), round(ny(m["vacuum"][1]), 4)],
        "cleaned": cleaned,
        # The obstacle layer, straight from RobotMap fields 9/10/11/15/16.
        # Coordinates are 0..1 in the same space as rooms/path.
        "objects": objects, "furniture": furniture,
        "virtual_walls": virtual_walls, "areas": areas, "navigation": navigation,
        "hits": sorted([{"id": r["id"], "box": p}
                        for r in rooms for p in r["parts"]],
                       key=lambda h: h["box"][2] * h["box"][3]),
        "total_area": round(sum(r["dims"]["area"] for r in rooms), 1),
        "counts": {"rooms": len(rooms), "path": len(m["path"]), "cells": len(m["grid"]),
                   "objects": len(objects), "furniture": len(furniture),
                   "virtual_walls": len(virtual_walls), "areas": len(areas)},
    }
    geo = _fit_geometry(geo)
    # The picture the map tab shows. Rendering it here keeps it next to the
    # geometry it is made from: a fetch, a decode or a refit all leave a fresh
    # one behind, and a failure (a read-only cache, say) only costs the picture.
    try:
        plan = render_plan_png(m, geo)
        if plan is not None:
            geo["plan"] = str(plan)
    except Exception:                                      # noqa: BLE001
        pass
    return geo


def cmd_mapdata(cfg: dict, source: str | None, refresh: bool,
                cfg_path: Path | None = None) -> int:
    '''Read a blob (a file, a url, or the cache) and print the geometry.'''
    if source:
        if source.startswith(("http://", "https://")):
            with urllib.request.urlopen(source, timeout=60) as res:
                raw = res.read()
        else:
            raw = Path(os.path.expanduser(source)).read_bytes()
        need = ("sn", "user_id", "did", "model", "mac")
        missing = [k for k in need if not cfg.get(k)]
        if missing:
            print(json.dumps({"ok": False, "error":
                              "reading a map blob needs the robot's own ids: "
                              + ", ".join(missing) + " are not in the config"}))
            return 1
        geo = map_geometry(map_decrypt(raw, *[cfg[k] for k in need]))
        MAP_BLOB.parent.mkdir(parents=True, exist_ok=True)
        MAP_BLOB.write_bytes(raw)
        _write_json(MAP_JSON, geo)
        print(json.dumps(geo))
        return 0

    if refresh:
        return cmd_map_refresh(cfg, cfg_path or config_path(None))
    if not MAP_JSON.is_file():
        print(json.dumps({"ok": False, "error":
                          "no map on the phone yet: log in from the setup tab, "
                          "then tap fetch on the map tab"}))
        return 1
    print(MAP_JSON.read_text())
    return 0


def cmd_map_refit(cfg: dict) -> int:
    '''Re-decode the cached blob into the current view, and draw its picture.

    A widget update can change the view without changing the map: the window
    used to be square, which wasted the empty side margins and drew a portrait
    floor plan small, the room rectangles need their edge checks rebuilt, and
    older caches carry no picture of their own. The blob is still on disk, so
    the whole geometry is decoded again from it - nothing goes to the network -
    and `fit` makes it a one-shot migration.
    '''
    if not MAP_JSON.is_file():
        print(json.dumps({"ok": False, "error": "no map cache to refit"}))
        return 1
    try:
        geo = json.loads(MAP_JSON.read_text())
    except Exception as exc:                                  # noqa: BLE001
        print(json.dumps({"ok": False, "error": f"map cache is not json: {exc}"}))
        return 1
    if not isinstance(geo, dict):
        print(json.dumps({"ok": False, "error": "map cache is not an object"}))
        return 1
    need = ("sn", "user_id", "did", "model", "mac")
    done = False
    if MAP_BLOB.is_file() and all(cfg.get(k) for k in need):
        try:
            geo = map_geometry(map_decrypt(MAP_BLOB.read_bytes(),
                                           *[cfg[k] for k in need]))
            done = True
        except Exception:                                  # noqa: BLE001
            pass
    if not done and geo.get("fit") != FIT:
        geo = _fit_geometry(geo)              # no blob: recrop what is cached
    _write_json(MAP_JSON, geo)
    print(json.dumps(geo))
    return 0


def cmd_map_png(cfg: dict) -> int:
    '''Draw the picture for a cached map, from the cached blob.'''
    if not MAP_JSON.is_file():
        return _out({"ok": False, "error": "no map cache: tap fetch first"})
    try:
        geo = json.loads(MAP_JSON.read_text())
    except Exception as exc:                                  # noqa: BLE001
        return _out({"ok": False, "error": f"map cache is not json: {exc}"})
    if geo.get("fit") != FIT:
        geo = _fit_geometry(geo)
    need = ("sn", "user_id", "did", "model", "mac")
    missing = [k for k in need if not cfg.get(k)]
    if missing:
        return _out({"ok": False, "error": "the config has no " + ", ".join(missing)})
    if not MAP_BLOB.is_file():
        return _out({"ok": False, "error": "the map blob is not on the phone: tap fetch"})
    try:
        m = parse_map(map_decrypt(MAP_BLOB.read_bytes(), *[cfg[k] for k in need]))
        plan = render_plan_png(m, geo)
    except Exception as exc:                                  # noqa: BLE001
        return _out({"ok": False, "error": str(exc)})
    if plan is None:
        return _out({"ok": False, "error": "this map has no drawable grid"})
    geo["plan"] = str(plan)
    _write_json(MAP_JSON, geo)
    return _out({"ok": True, "plan": str(plan), "view": geo.get("view")})


def cmd_live(v: Vacuum, save: bool = False) -> int:
    '''Read 10/5 and return the current 15-point path chunk.

    The points are raw map metres, exactly like the blob's `bounds`, so the
    widget can place them on the same drawing. `head` is a screen-space unit
    vector for the last point (the map y axis is flipped for drawing).
    '''
    res = v.send("get_properties",
                 [{"did": "10-5", "siid": 10, "piid": 5}], retries=2)
    row = (res.get("result") or [{}])[0]
    raw = row.get("value")
    if not isinstance(raw, str):
        return _out({"ok": False, "error": "10/5 did not answer with a string"})
    try:
        arr = json.loads(raw)
    except ValueError:
        return _out({"ok": False, "error": f"10/5 is not json: {raw[:120]}"})
    if not isinstance(arr, list) or not arr:
        return _out({"ok": False, "error": f"10/5 is empty: {raw[:120]}"})
    if len(arr) < 6:
        out = {"ok": True, "idle": True, "chunk": None, "ts": arr[-1],
               "points": [], "head": None}
    else:
        chunk, ts = arr[0], arr[-1]
        body = arr[1:-1]
        points = [body[i:i + 4] for i in range(0, len(body) - 3, 4)]
        head = None
        if points and len(points[-1]) >= 4:
            h = float(points[-1][2])
            head = [round(math.cos(h), 3), round(-math.sin(h), 3)]
        out = {"ok": True, "idle": False, "chunk": chunk, "ts": ts,
               "points": points, "head": head}
    if save:
        _write_json(LIVE_JSON, out)
        _note("live", {"ok": True, "idle": out.get("idle"),
                       "text": ("robot is idle - no live path" if out.get("idle")
                                else f"live: {len(out.get('points') or [])} points")})
    return _out(out)


# --------------------------------------------------------------------------- #
# the Mi account: login, and the signed requests that need it
# --------------------------------------------------------------------------- #
#
# The robot's token is enough for everything on the LAN -- including decoding
# the map *blob*. Getting a blob is the one thing it cannot do: the map lives in
# Xiaomi's storage and the address for it is signed on demand, which needs an
# account session. That session is account-wide (every device on the account),
# so it is a bigger secret than the token and lives in its own 0600 file. It is
# never printed, never put in the config, and never on a command line.
#
# The flow is the one the Xiaomi app uses: serviceLogin -> serviceLoginAuth2,
# then whichever gate the account throws (an emailed code, or a captcha), then
# the STS cookie. Everything is stdlib: urllib for HTTP, a small RC4 for the
# cloud payload (that is Xiaomi's scheme, not a choice of ours), hashlib for the
# signatures.

ACCOUNT = "https://account.xiaomi.com"
SESSION_FILE = CONFIG.with_name("vacuum-session.json")
LOGIN_STATE = CONFIG.with_name("vacuum-login.json")
CAPTCHA_FILE = MAP_CACHE.with_name("captcha.png")
AGENT = "android-app-8.1.15-f3a6c8d0e1 APP/com.xiaomi.mihome APPV/10.5.201"
VACUUM_PREFIXES = ("ijai.", "xiaomi.", "dreame.", "roborock.", "rockrobo.", "viomi.")


def _out(obj: dict) -> int:
    '''Print the one JSON object a widget reads, and return success.'''
    print(json.dumps(obj))
    return 0 if obj.get("ok") else 1


# `run(...)` in a widget is an action: it starts a command in the background and
# returns *nothing*, so a widget cannot read a command's stdout that way. Every
# long command therefore leaves its answer here as well, and the widget polls
# this one small file. It is also how a two-step login survives the gap between
# the two taps: the first process writes "code sent", the second reads the state
# the first left behind.
LAST = Path(os.path.expanduser("~/.cache/omarchy-vacuum/last.json"))


def _write_json(path: Path, obj) -> None:
    '''Write JSON the widget may be reading *right now*.

    The map tab `cat`s the cached geometry every 20 seconds, so a plain write
    could be caught half-done and parse as nothing at all - a file that vanishes
    for a moment while a fetch is in flight.
    '''
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".part")
    tmp.write_text(json.dumps(obj))
    tmp.replace(path)


def _note(kind: str, obj: dict) -> dict:
    '''Record an answer for the widget, atomically, and return it.'''
    note = {"kind": kind, "at": int(time.time()), **obj}
    try:
        LAST.parent.mkdir(parents=True, exist_ok=True)
        tmp = LAST.with_name(LAST.name + ".part")
        tmp.write_text(json.dumps(note))
        tmp.replace(LAST)
    except OSError:
        pass
    return note


def _as_json(text: str) -> dict:
    '''Xiaomi's login endpoints prefix their JSON with &&&START&&&.'''
    return json.loads(text.replace("&&&START&&&", ""))


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):        # noqa: D401 - urllib hook
        return None


def _opener(jar: http.cookiejar.CookieJar, follow: bool = True):
    handlers = [urllib.request.HTTPCookieProcessor(jar)]
    if not follow:
        handlers.append(_NoRedirect())
    return urllib.request.build_opener(*handlers)


def _call(opener, url: str, form: dict | None = None, headers: dict | None = None,
          timeout: float = 30.0):
    '''GET (form=None) or POST; a 3xx is returned, not followed, when the opener
    was built with follow=False.'''
    head = {"User-Agent": AGENT}
    if form is not None:
        head["Content-Type"] = "application/x-www-form-urlencoded"
    head.update(headers or {})
    body = urllib.parse.urlencode(form).encode() if form is not None else None
    req = urllib.request.Request(url, data=body, headers=head)
    try:
        with opener.open(req, timeout=timeout) as res:
            return res.status, res.headers, res.read()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.headers, exc.read()


def _jar_dump(jar: http.cookiejar.CookieJar) -> list[dict]:
    return [{"name": c.name, "value": c.value, "domain": c.domain, "path": c.path}
            for c in jar]


def _jar_load(items: list[dict] | None) -> http.cookiejar.CookieJar:
    jar = http.cookiejar.CookieJar()
    for d in items or []:
        domain = d.get("domain") or ""
        jar.set_cookie(http.cookiejar.Cookie(
            0, d.get("name", ""), d.get("value", ""), None, False, domain,
            bool(domain), domain.startswith("."), d.get("path") or "/", True,
            False, None, False, None, None, {}))
    return jar


def _cookie(jar: http.cookiejar.CookieJar, name: str) -> str:
    return next((c.value for c in jar if c.name == name), "")


def load_session() -> dict | None:
    if not SESSION_FILE.is_file():
        return None
    try:
        sess = json.loads(SESSION_FILE.read_text())
    except (OSError, ValueError):
        return None
    if not sess.get("service_token") or not sess.get("ssecurity"):
        return None
    return sess


def _save_session(sess: dict) -> None:
    SESSION_FILE.parent.mkdir(parents=True, exist_ok=True)
    SESSION_FILE.write_text(json.dumps(sess, indent=2))
    SESSION_FILE.chmod(0o600)


def _save_login_state(**state) -> None:
    LOGIN_STATE.parent.mkdir(parents=True, exist_ok=True)
    LOGIN_STATE.write_text(json.dumps(state, indent=2))
    LOGIN_STATE.chmod(0o600)


def _load_login_state() -> dict:
    if not LOGIN_STATE.is_file():
        return {}
    try:
        return json.loads(LOGIN_STATE.read_text())
    except (OSError, ValueError):
        return {}


def _clear_login_state() -> None:
    try:
        LOGIN_STATE.unlink()
    except OSError:
        pass


# --- RC4, Xiaomi's payload cipher (ARC4 with a 1024-byte discard) -------------

def _rc4(key: bytes, data: bytes) -> bytes:
    s = list(range(256))
    j = 0
    for i in range(256):
        j = (j + s[i] + key[i % len(key)]) & 255
        s[i], s[j] = s[j], s[i]
    out = bytearray()
    i = j = 0
    for byte in data:
        i = (i + 1) & 255
        j = (j + s[i]) & 255
        s[i], s[j] = s[j], s[i]
        out.append(byte ^ s[(s[i] + s[j]) & 255])
    return bytes(out)


def _rc4_enc(key_b64: str, text: str) -> str:
    stream = _rc4(base64.b64decode(key_b64), bytes(1024) + text.encode())
    return base64.b64encode(stream[1024:]).decode()


def _rc4_dec(key_b64: str, payload: str) -> bytes:
    stream = _rc4(base64.b64decode(key_b64), bytes(1024) + base64.b64decode(payload))
    return stream[1024:]


# --- the signed cloud API -----------------------------------------------------

def _api_base(country: str | None) -> str:
    c = (country or "cn").strip().lower()
    return "https://" + ("" if c == "cn" else c + ".") + "api.io.mi.com/app"


def _nonce() -> str:
    millis = int(round(time.time() * 1000))
    raw = (random.getrandbits(64) - 2 ** 63).to_bytes(8, "big", signed=True)
    part = int(millis / 60000)
    raw += part.to_bytes(((part.bit_length() + 7) // 8), "big")
    return base64.b64encode(raw).decode()


def _signed_nonce(ssecurity: str, nonce: str) -> str:
    digest = hashlib.sha256(base64.b64decode(ssecurity)
                            + base64.b64decode(nonce)).digest()
    return base64.b64encode(digest).decode()


def _enc_signature(url: str, method: str, signed: str, params: dict) -> str:
    parts = [method.upper(), url.split("com")[1].replace("/app/", "/")]
    parts += [f"{k}={v}" for k, v in params.items()]
    parts.append(signed)
    return base64.b64encode(
        hashlib.sha1("&".join(parts).encode()).digest()).decode()


def cloud_request(sess: dict, path: str, data: dict) -> dict:
    '''One signed request to the Mi cloud, for the session's country.'''
    if not sess.get("service_token") or not sess.get("ssecurity"):
        raise RuntimeError("no Mi account session: log in first")
    url = _api_base(sess.get("country")) + path
    nonce = _nonce()
    signed = _signed_nonce(sess["ssecurity"], nonce)

    params = {"data": json.dumps(data)}
    params["rc4_hash__"] = _enc_signature(url, "POST", signed, params)
    params = {k: _rc4_enc(signed, v) for k, v in params.items()}
    params["signature"] = _enc_signature(url, "POST", signed, params)
    params["ssecurity"] = sess["ssecurity"]
    params["_nonce"] = nonce

    token = sess["service_token"]
    req = urllib.request.Request(url, data=urllib.parse.urlencode(params).encode(), headers={
        "User-Agent": AGENT,
        "Content-Type": "application/x-www-form-urlencoded",
        "x-xiaomi-protocal-flag-cli": "PROTOCAL-HTTP2",
        "MIOT-ENCRYPT-ALGORITHM": "ENCRYPT-RC4",
        "Cookie": (f"userId={sess['user_id']}; serviceToken={token}; "
                   f"yetAnotherServiceToken={token}; locale=en_GB; "
                   "timezone=GMT+05:30; is_daylight=0; dst_offset=0; "
                   "channel=MI_APP_STORE"),
    })
    try:
        with urllib.request.urlopen(req, timeout=45) as res:
            text = res.read().decode()
    except urllib.error.HTTPError as exc:
        text = exc.read().decode()
    if not text:
        raise RuntimeError("the Mi cloud answered nothing")
    plain = _rc4_dec(_signed_nonce(sess["ssecurity"], nonce), text)
    return json.loads(plain.decode())


# --- the login itself --------------------------------------------------------

def _step2(op, user: str, sign: str, pw_hash: str, captcha: str | None = None) -> dict:
    fields = {
        "sid": "xiaomiio", "hash": pw_hash,
        "callback": "https://sts.api.io.mi.com/sts",
        "qs": "%3Fsid%3Dxiaomiio%26_json%3Dtrue",
        "user": user, "_sign": sign or "", "_json": "true",
    }
    if captcha:
        fields["captCode"] = captcha
    _, _, body = _call(op, ACCOUNT + "/pass/serviceLoginAuth2", form=fields)
    try:
        return _as_json(body.decode())
    except ValueError:
        return {"result": "error", "raw": body.decode(errors="replace")[:300]}


def _send_email_ticket(op, jar, context: str, retry: int = 0) -> dict:
    '''Ask Xiaomi for an emailed code and return its actual answer.

    The answer used to be thrown away, which made a refusal look exactly like a
    sent code. Xiaomi returns code 70022 with "Sent too many codes. Try again
    tomorrow." after a few requests, and no mail is sent at all.
    '''
    _, _, body = _call(
        op, ACCOUNT + "/identity/auth/sendEmailTicket?" + urllib.parse.urlencode(
            {"_dc": str(int(time.time() * 1000)), "sid": "xiaomiio",
             "context": context, "mask": "0", "_locale": "en_US"}),
        form={"retry": str(retry), "icode": "", "_json": "true",
              "ick": _cookie(jar, "ick")})
    try:
        return _as_json(body.decode())
    except ValueError:
        return {"code": -1, "desc": "unreadable answer",
                "raw": body.decode(errors="replace")[:300]}


def _ticket_result(ticket: dict) -> dict:
    '''Turn sendEmailTicket's answer into something a person can act on.'''
    try:
        code = int(ticket.get("code"))
    except (TypeError, ValueError):
        code = -1
    tip = (ticket.get("tips") or ticket.get("desc") or
           ticket.get("message") or "").strip().rstrip(".")
    if code == 0:
        return {"ok": True,
                "message": "Xiaomi accepted the request; a code is on its way "
                           "to the email on the account. Check the spam folder "
                           "too. If it does not arrive, wait a few minutes "
                           "before asking again."}
    if code == 70022:
        return {"ok": False, "rate_limited": True,
                "error": "Xiaomi refused to send a code: "
                         + (tip or "too many codes") +
                         ". Nothing was emailed; repeated taps will not help."}
    return {"ok": False,
            "error": "Xiaomi did not send a code: "
                     + (tip or "unknown error") + f" (code {code}). "
                     "Nothing was emailed."}


def _begin_2fa(op, jar, notification_url: str) -> tuple[str, dict]:
    context = (urllib.parse.parse_qs(
        urllib.parse.urlparse(notification_url).query).get("context") or [""])[0]
    if not context:
        raise RuntimeError("Xiaomi sent a verification link without a context")
    _call(op, notification_url)
    _, _, list_body = _call(op, ACCOUNT + "/identity/list?" + urllib.parse.urlencode(
        {"sid": "xiaomiio", "context": context, "_locale": "en_US"}))
    try:
        identities = _as_json(list_body.decode())
    except ValueError:
        identities = {}
    ticket = _send_email_ticket(op, jar, context, 0)
    return context, {"identities": identities, "ticket": ticket}


def _finish_2fa(op, jar, context: str, code: str) -> dict:
    _, hdr, body = _call(
        op, ACCOUNT + "/identity/auth/verifyEmail?" + urllib.parse.urlencode(
            {"_flag": "8", "_json": "true", "sid": "xiaomiio", "context": context,
             "mask": "0", "_locale": "en_US"}),
        form={"_flag": "8", "ticket": code, "trust": "false", "_json": "true",
              "ick": _cookie(jar, "ick")})
    text = body.decode(errors="replace")
    loc = None
    try:
        loc = _as_json(text).get("location")
    except ValueError:
        pass
    loc = loc or hdr.get("Location")
    if not loc:
        found = re.search(r"https://account\.xiaomi\.com/identity/result/check\?[^\"']+", text)
        loc = found.group(0) if found else None
    if not loc:
        _, hdr2, _ = _call(op, ACCOUNT + "/identity/result/check?" + urllib.parse.urlencode(
            {"sid": "xiaomiio", "context": context, "_locale": "en_US"}))
        loc = hdr2.get("Location")
    if not loc:
        raise RuntimeError("the emailed code was accepted, but Xiaomi sent no next step")

    if "identity/result/check" in loc:
        _, hdr, _ = _call(op, loc)
        end_url = hdr.get("Location")
    else:
        end_url = loc
    if not end_url:
        raise RuntimeError("the verification chain ended without a sign-in url")

    _, hdr, body = _call(op, end_url)
    if hdr.get("extension-pragma") is None and b"Xiaomi Account - Tips" in body:
        _, hdr, body = _call(op, end_url)
    ssecurity = None
    if hdr.get("extension-pragma"):
        try:
            ssecurity = json.loads(hdr["extension-pragma"]).get("ssecurity")
        except ValueError:
            pass
    if not ssecurity:
        raise RuntimeError("the verification chain carried no ssecurity")

    sts_url = hdr.get("Location")
    if not sts_url:
        idx = body.decode(errors="replace").find("https://sts.api.io.mi.com/sts")
        if idx != -1:
            tail = body.decode(errors="replace")[idx:]
            end = tail.find('"')
            sts_url = tail[:end if end != -1 else 300]
    if not sts_url:
        raise RuntimeError("no service ticket url after verification")

    _call(_opener(jar), sts_url)             # this response sets serviceToken
    token = _cookie(jar, "serviceToken")
    if not token:
        raise RuntimeError("the sign-in chain returned no serviceToken")
    return {"user_id": _cookie(jar, "userId"), "service_token": token,
            "ssecurity": ssecurity}


def _password(given: str | None = None) -> str:
    '''The password, from the first place that has one.

    `--password` is what the widget uses: a pipe needs a shell, and a command
    runner that does not give it one leaves python reading a stdin nobody ever
    writes to - which is a silent hang, not an error. An argument cannot hang.

    Both routes put the password on the command line, which is the one exposure
    this design accepts (`/proc/<pid>/cmdline` for the second or two the login
    runs); nothing is written to disk either way.
    '''
    if given:
        return given
    env = os.environ.get("XIAOMI_PASSWORD")
    if env:
        return env
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass("Xiaomi password: ")
    return sys.stdin.readline().rstrip("\r\n")


def looks_like_sn(value) -> bool:
    '''The map key's serial: 18 uppercase alphanumeric characters.

    This is the shape the robot's own serial has on this model, and it is what
    keeps a packed reply (7/45 is a comma list of everything) from being mistaken
    for the key.
    '''
    return (isinstance(value, str) and len(value) == 18
            and value.isalnum() and value == value.upper())


def _sn_from(value, user_id: str = "") -> str:
    '''A serial out of whatever that property answered: a bare string, a
    "MAINSN/12345" pair, or the packed list 7/45 returns.'''
    if looks_like_sn(value):
        return str(value)
    if isinstance(value, str):
        for part in (value.split("/")[-1], value.split("/")[0]):
            if looks_like_sn(part):
                return part
        if "," in value:                 # 7/45: [.., "4179...", ..]
            for chunk in value.split(","):
                cand = chunk.replace('"', "").strip()
                if user_id and str(user_id) in cand:
                    cand = cand.split(";")[0]
                if looks_like_sn(cand):
                    return cand
    if isinstance(value, list):          # already parsed JSON
        for item in value:
            got = _sn_from(item, user_id)
            if got:
                return got
    return ""


def probe_serial(addr: str, token: str, did, user_id: str = "",
                 attempts: int = 2, timeout: float = 2.5) -> str:
    '''The robot's serial number, read on the LAN.

    The map's key is built from it, the Xiaomi device list never carries it, and
    it is the one id a login can miss for no reason at all - the robot was simply
    asleep at that moment. So it is read here, late and fast, instead of being
    required early.

    Which property answers it is a model question, not a spec one: on this robot
    1/1-1/3 (manufacturer, model, device-id) reply *without a value at all*, the
    serial is at **1/5**, and 7/45 packs the same serial inside a list of
    everything else. A property that answers is therefore not a serial, and the
    next one is tried; only a robot that answers nothing at all stops this early.

    Returns "" rather than raising: whoever called this can decide what to say.
    '''
    if did is not None and not str(did).isdigit():
        did = None
    for attempt in range(attempts):
        try:
            v = Vacuum(addr, token, did, timeout)
        except Exception:                                     # noqa: BLE001
            return ""
        for siid, piid in ((1, 5), (1, 3), (7, 45)):
            try:
                res = v.send("get_properties",
                             [{"did": f"{siid}-{piid}", "siid": siid, "piid": piid}],
                             retries=3)
            except TimeoutError:
                return ""      # no reply at all: out of reach, not the wrong piid
            except Exception:                                 # noqa: BLE001
                continue       # the robot's own -9999 flakiness: try the next one
            for r in (res.get("result") or []):
                if r.get("code") == 0:
                    sn = _sn_from(r.get("value"), user_id)
                    if sn:
                        return sn
        if attempt + 1 < attempts:
            time.sleep(0.5)
    return ""


def _finish_login(sess: dict, cfg_path: Path, country: str, want_did: str | None) -> dict:
    sess["country"] = country
    _save_session(sess)
    _note("login", {"ok": True, "busy": True,
                    "message": "signed in; reading your device list..."})
    try:
        reply = cloud_request(sess, "/home/device_list", {
            "getVirtualModel": True, "getHuamiDevices": 1,
            "get_split_device": False, "support_smart_home": True})
    except Exception as exc:                                  # noqa: BLE001
        return {"ok": True, "logged_in": True,
                "message": f"logged in, but the device list did not load: {exc}"}

    devices = ((reply.get("result") or {}).get("list") or [])
    vacuums = [d for d in devices if str(d.get("model", "")).startswith(VACUUM_PREFIXES)]
    chosen = None
    if want_did:
        chosen = next((d for d in vacuums if str(d.get("did")) == str(want_did)), None)
    if chosen is None and len(vacuums) == 1:
        chosen = vacuums[0]
    if chosen is None:
        return {"ok": True, "logged_in": True,
                "message": "logged in, but this account has no single vacuum to "
                           "write into the config",
                "devices": [{"name": d.get("name"), "model": d.get("model"),
                             "did": str(d.get("did"))} for d in devices]}

    cfg = load_config(cfg_path)
    for key in ("token", "did", "mac", "model", "name"):
        if chosen.get(key) not in (None, ""):
            cfg[key] = str(chosen[key])
    cfg["user_id"] = str(sess.get("user_id") or "")
    cfg["country"] = country
    if chosen.get("localip") and (not cfg.get("ip") or cfg["ip"].lower() == "auto"):
        cfg["ip"] = str(chosen["localip"])
    cfg.setdefault("ip", "auto")
    cfg.setdefault("did", "auto")
    # an "auto" address is swept now, because the serial below is what the map
    # key needs and only the robot can answer for it
    if cfg["ip"].lower() == "auto" and cfg.get("token"):
        try:
            cfg["ip"] = resolve_auto(cfg_path, cfg)
        except Exception:                                     # noqa: BLE001
            pass

    # The serial is not in the device list, and reading it costs a couple of
    # seconds against a robot that may not be listening: login no longer waits
    # for it. `mapdata --refresh` reads it when the map is wanted (probe_serial),
    # which is what needs it - the login only has to land the token and the ids.

    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text("".join(f"{k} = {v}\n" for k, v in cfg.items()))
    cfg_path.chmod(0o600)
    return {"ok": True, "logged_in": True,
            "message": f"logged in; wrote {chosen.get('name') or chosen.get('model')} "
                       f"into the config",
            "device": {"name": chosen.get("name"), "model": chosen.get("model"),
                       "did": str(chosen.get("did"))}}


# The account name the widget is typing travels with every step's answer, so a
# later visit can prefill it from last.json instead of asking again. It is not a
# secret (it is in the config file too) - the password never travels like this.
_LOGIN_USER = ""


def _login_out(obj: dict) -> int:
    '''A login step's answer: printed, and left where the widget polls for it.'''
    if _LOGIN_USER and not obj.get("user"):
        obj["user"] = _LOGIN_USER
    return _out(_note("login", obj))


def cmd_login(args) -> int:
    '''`login --user NAME` (password on stdin), then `login --code N` if asked.'''
    global _LOGIN_USER
    country = (getattr(args, "country", None) or "i2").strip().lower()
    cfg_path = config_path(args.config)
    user = (getattr(args, "user", None) or "").strip()
    _LOGIN_USER = user

    try:
        if getattr(args, "resend", False):
            state = _load_login_state()
            if not state or state.get("mode") != "2fa" or not state.get("context"):
                return _login_out({"ok": False, "error":
                             "no emailed code is pending - start again with "
                             "your Mi account name and password"})
            _LOGIN_USER = user or str(state.get("user") or "")
            now = time.time()
            retry_after = float(state.get("retry_after") or 0)
            if retry_after > now:
                mins = int((retry_after - now) / 60) + 1
                wait = (f"about {mins // 60}h {mins % 60}m" if mins >= 60
                        else f"{mins} minute{'s' if mins != 1 else ''}")
                return _login_out({
                    "ok": False, "need": "code", "retry_after": int(retry_after),
                    "error": f"Xiaomi is still limiting codes; try again in {wait}. "
                             "Nothing was emailed."})
            sent_at = float(state.get("sent_at") or 0)
            if now - sent_at < 60:
                wait = int(60 - (now - sent_at)) + 1
                return _login_out({
                    "ok": False, "need": "code", "retry_after": int(sent_at + 60),
                    "error": f"wait {wait}s before asking for another code"})
            _note("login", {"ok": True, "busy": True,
                            "message": "asking Xiaomi for another code..."})
            jar = _jar_load(state.get("cookies"))
            op = _opener(jar, follow=False)
            ticket = _send_email_ticket(op, jar, state["context"], retry=1)
            result = _ticket_result(ticket)
            sent_at = int(time.time())
            state.update(cookies=_jar_dump(jar), sent_at=sent_at,
                         ticket_code=ticket.get("code"),
                         ticket_message=result.get("error") or result.get("message"))
            if result.get("rate_limited"):
                state["retry_after"] = sent_at + 24 * 60 * 60
            else:
                state.pop("retry_after", None)
            _save_login_state(**state)
            out = {"ok": result.get("ok") is True, "need": "code",
                   "user": state.get("user"), "sent_at": sent_at}
            if result.get("ok"):
                out["message"] = result.get("message")
            else:
                out["error"] = result.get("error")
            if state.get("retry_after"):
                out["retry_after"] = state["retry_after"]
            return _login_out(out)

        if args.code is not None and not str(args.code).strip():
            # the verify button was tapped with an empty field; say so instead of
            # falling through to the password path
            return _login_out({"ok": False, "need": "code", "error": "type the code first"})
        if args.code:
            state = _load_login_state()
            if not state:
                return _login_out({"ok": False, "error":
                             "no login is waiting for a code - start again with "
                             "your Mi account name and password"})
            _LOGIN_USER = user or str(state.get("user") or "")
            _note("login", {"ok": True, "busy": True, "message": "checking the code..."})
            jar = _jar_load(state.get("cookies"))
            op = _opener(jar, follow=False)
            if state.get("mode") == "captcha":
                j2 = _step2(op, state["user"], state["sign"], state["pw_hash"], args.code)
                return _after_step2(j2, op, jar, state["user"], state.get("sign", ""),
                                    state["pw_hash"], country, cfg_path)
            sess = _finish_2fa(op, jar, state["context"], args.code)
            if not sess.get("user_id"):
                sess["user_id"] = str(state.get("user_id") or "")
            _clear_login_state()
            return _login_out(_finish_login(sess, cfg_path, country,
                                      load_config(cfg_path).get("did")))
        if not user:
            return _login_out({"ok": False, "error": "the Mi account name (email or phone) is empty"})

        # Xiaomi rate-limits emailed codes hard (70022: "try again tomorrow").
        # Do not start another login dance against the same account while its
        # last answer is still in force; that only extends the wait.
        state = _load_login_state()
        now = time.time()
        if (state and state.get("mode") == "2fa"
                and str(state.get("user") or "") == user):
            retry_after = float(state.get("retry_after") or 0)
            if retry_after > now:
                mins = int((retry_after - now) / 60) + 1
                wait = (f"about {mins // 60}h {mins % 60}m" if mins >= 60
                        else f"{mins} minute{'s' if mins != 1 else ''}")
                return _login_out({
                    "ok": False, "need": "code", "retry_after": int(retry_after),
                    "error": f"Xiaomi is still limiting codes; try again in {wait}. "
                             "Nothing was emailed."})
            sent_at = float(state.get("sent_at") or 0)
            if now - sent_at < 60:
                wait = int(60 - (now - sent_at)) + 1
                return _login_out({
                    "ok": False, "need": "code", "retry_after": int(sent_at + 60),
                    "error": f"wait {wait}s before asking for another code"})

        # Say something *before* reading the password. A run() that never hands
        # the process its stdin used to sit in readline() and look like a dead
        # button: no note, no message, no mail.
        _note("login", {"ok": True, "busy": True, "message": "signing in..."})
        password = _password(getattr(args, "password", None))
        if not password:
            return _login_out({"ok": False, "error": "the Mi account password is empty"})

        _note("login", {"ok": True, "busy": True, "message": "contacting xiaomi..."})
        jar = http.cookiejar.CookieJar()
        op = _opener(jar)
        _, _, body = _call(op, ACCOUNT + "/pass/serviceLogin?sid=xiaomiio&_json=true",
                           headers={"Cookie": f"userId={urllib.parse.quote(user)}"})
        j1 = _as_json(body.decode())
        j2 = _step2(op, user, j1.get("_sign", ""),
                    hashlib.md5(password.encode()).hexdigest().upper())
        return _after_step2(j2, op, jar, user, j1.get("_sign", ""),
                            hashlib.md5(password.encode()).hexdigest().upper(),
                            country, cfg_path)
    except Exception as exc:                                  # noqa: BLE001
        if args.code:
            # keep the code field up: a typo should not cost a fresh email
            return _login_out({"ok": False, "need": "code", "detail": str(exc),
                               "error": "that code was not accepted - check it, or "
                                        "tap log in again for a new one"})
        return _login_out({"ok": False, "error": f"{type(exc).__name__}: {exc}"})


def _after_step2(j2: dict, op, jar, user: str, sign: str, pw_hash: str,
                 country: str, cfg_path: Path) -> int:
    '''Shared tail of both gates: success, captcha, or the emailed code.'''
    if j2.get("ssecurity") and j2.get("location"):
        _call(_opener(jar), j2["location"])
        token = _cookie(jar, "serviceToken")
        if not token:
            return _login_out({"ok": False, "error": "logged in, but no session ticket arrived"})
        _clear_login_state()
        sess = {"user_id": str(j2.get("userId") or _cookie(jar, "userId")),
                "service_token": token, "ssecurity": j2["ssecurity"]}
        return _login_out(_finish_login(sess, cfg_path, country,
                                  load_config(cfg_path).get("did")))

    common = {"user": user, "sign": j2.get("_sign") or sign,
              "pw_hash": pw_hash, "country": country,
              "user_id": str(j2.get("userId") or "")}

    if j2.get("captchaUrl"):
        url = j2["captchaUrl"]
        url = url if url.startswith("http") else ACCOUNT + url
        _, _, image = _call(op, url)
        CAPTCHA_FILE.parent.mkdir(parents=True, exist_ok=True)
        CAPTCHA_FILE.write_bytes(image)
        _save_login_state(mode="captcha", cookies=_jar_dump(jar), **common)
        return _login_out({"ok": True, "need": "captcha", "image": str(CAPTCHA_FILE),
                     "message": "type the characters in the picture"})

    if j2.get("notificationUrl"):
        context, info = _begin_2fa(op, jar, j2["notificationUrl"])
        ticket = info.get("ticket") or {}
        result = _ticket_result(ticket)
        sent_at = int(time.time())
        state = {"mode": "2fa", "context": context, "cookies": _jar_dump(jar),
                 "sent_at": sent_at, "ticket_code": ticket.get("code"),
                 "ticket_message": result.get("error") or result.get("message"),
                 **common}
        if result.get("rate_limited"):
            state["retry_after"] = sent_at + 24 * 60 * 60
        # the jar is saved *after* begin_2fa: sendEmailTicket sets the `ick`
        # cookie, and verifyEmail rejects the code without it.
        _save_login_state(**state)
        out = {"ok": result.get("ok") is True, "need": "code", "user": user,
               "sent_at": sent_at}
        if result.get("ok"):
            out["message"] = result.get("message")
        else:
            out["error"] = result.get("error")
        if state.get("retry_after"):
            out["retry_after"] = state["retry_after"]
        return _login_out(out)

    code = j2.get("code")
    return _login_out({"ok": False, "error": f"the Mi account refused the login (code {code})",
                 "detail": str(j2)[:400]})


# --- the things only the account can do --------------------------------------

def cmd_map_refresh(cfg: dict, cfg_path: Path) -> int:
    '''Fetch the live map blob with the account session, then decode it.

    Anything the robot itself has to say (the serial) is fetched here rather
    than refused: the login's probe can fail simply because the robot was out of
    reach at that moment, and refusing afterwards would leave a logged-in widget
    with an empty map and no way to fix it but a second login.
    '''
    sess = load_session()
    if not sess:
        return _out(_note("map", {"ok": False, "error":
                     "log in from the setup tab first: the map blob is behind a "
                     "signed url, and that needs the account session"}))
    uid = str(sess.get("user_id") or cfg.get("user_id") or "")
    if not uid:
        return _out(_note("map", {"ok": False, "error":
                     "the session carries no account id: tap log in again"}))
    for key in ("did", "model", "mac"):
        if not cfg.get(key):
            return _out(_note("map", {"ok": False, "error":
                         f"the config has no {key}: log in again (it writes the "
                         f"robot's ids), or fill it in by hand"}))
    if not str(cfg["did"]).isdigit():
        return _out(_note("map", {"ok": False, "error":
                     "the config's did is not the robot's id yet: log in again, "
                     "or put the numeric device id in the config"}))

    # One address for both the serial and the upload trigger. "auto" is swept
    # once here, so a config that only carries a token still works - the upload
    # trigger used to be skipped in that case and the tab showed a stale map.
    addr = str(cfg.get("ip") or "auto")
    if addr.lower() == "auto" and cfg.get("token"):
        try:
            addr = resolve_auto(cfg_path, cfg)
        except Exception:                                     # noqa: BLE001
            addr = "auto"

    if not cfg.get("sn"):
        # The map's key is built from the serial, and only the robot can give it
        # (it is not in the Xiaomi device list). Ask now, on the LAN, a few times.
        if addr.lower() != "auto" and cfg.get("token"):
            snap = probe_serial(addr, cfg["token"], cfg.get("did"), uid)
            if snap:
                cfg["sn"] = cfg["serial"] = snap
                cfg_path.parent.mkdir(parents=True, exist_ok=True)
                cfg_path.write_text(
                    "".join(f"{k} = {val}\n" for k, val in cfg.items()))
                cfg_path.chmod(0o600)
    if not cfg.get("sn"):
        return _out(_note("map", {"ok": False, "error":
                     "the robot's serial number has not been read yet, and the "
                     "map's key needs it. it only answers on the wi-fi: check the "
                     "address and token on the setup tab (save them), make sure "
                     "the robot is powered and awake, then tap fetch again."}))

    # Ask the robot to upload its current map. This is local, and it only
    # publishes a file -- it does not move the robot.
    if addr.lower() != "auto" and cfg.get("token"):
        try:
            did = cfg.get("did")
            if did and not str(did).isdigit():
                did = None
            Vacuum(addr, cfg["token"], did, 6.0).send("set_uploadmap", [1])
            time.sleep(3)
        except Exception:                                     # noqa: BLE001
            pass                               # a stale upload may still be there

    model = cfg.get("model", "")
    paths = (["/v2/home/get_interim_file_url", "/v2/home/get_interim_file_url_pro"]
             if model == "ijai.vacuum.v3" else
             ["/v2/home/get_interim_file_url_pro", "/v2/home/get_interim_file_url"])
    last = "no map object answered"
    # The robot writes the object while it finishes the upload, so the first URL
    # can still point at the previous - or a half-written, undecryptable - blob.
    # Re-ask a few times instead of declaring the map missing on the first try.
    for attempt in range(6):
        for name in ("0", "1"):
            for path in paths:
                try:
                    reply = cloud_request(sess, path, {"obj_name": f"{uid}/{cfg['did']}/{name}"})
                    url = ((reply.get("result") or {}).get("url"))
                    if not url:
                        last = (f"{reply.get('code')}: {reply.get('message')}").strip(": ")
                        continue
                    with urllib.request.urlopen(url, timeout=60) as res:
                        blob = res.read()
                    try:
                        geo = map_geometry(map_decrypt(blob, cfg["sn"], uid, cfg["did"],
                                                       model, cfg["mac"]))
                    except Exception as exc:                  # noqa: BLE001
                        last = str(exc)
                        continue
                    MAP_BLOB.parent.mkdir(parents=True, exist_ok=True)
                    MAP_BLOB.write_bytes(blob)
                    _write_json(MAP_JSON, geo)
                    return _out(_note("map", {**geo, "text": "map updated"}))
                except Exception as exc:                      # noqa: BLE001
                    last = f"{type(exc).__name__}: {exc}"
        if attempt < 5:
            time.sleep(3)
    return _out(_note("map", {"ok": False, "error":
                 f"no usable map object on the account ({last}). The robot writes a "
                 "readable one when a full clean completes; start one, let it "
                 "finish, then tap fetch again."}))


# --------------------------------------------------------------------------- #
# config
# --------------------------------------------------------------------------- #

class ConfigError(Exception):
    '''A config that isn't there or isn't usable yet, worded for the tile.

    Its message goes to the widget as-is, without a class name in front, because
    this is the one error a user can fix themselves.
    '''


def config_path(explicit: str | None = None) -> Path:
    '''The config in use: an explicit one, else the first that exists, else the
    default. Keeps an older build's file working instead of writing a second one.'''
    if explicit:
        return Path(explicit)
    for p in (CONFIG, LEGACY_CONFIG):
        if p.is_file():
            return p
    return CONFIG


def load_config(path: Path) -> dict:
    '''Read ip / token / did out of the config file (key=value or bare lines).'''
    if not path.is_file():
        return {}
    cfg: dict[str, str] = {}
    bare: list[str] = []
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            k, _, v = line.partition("=")
            cfg[k.strip().lower()] = v.strip()
        else:
            bare.append(line)
    for key, val in zip(("ip", "token", "did"), bare):
        cfg.setdefault(key, val)
    return cfg


def resolve_auto(path: Path, cfg: dict) -> str:
    '''`ip = auto`: sweep the network once, then remember the answer.

    The robot ignores broadcast, so it cannot be discovered the usual way, but it
    does answer a unicast hello. This is the only working discovery on this model,
    and it exists so the phone only has to be told the token, not the address.
    '''
    found = discover(local_prefix(), 0.4, 64)
    for _ in range(2):                      # one hello can be dropped; sweep again
        if found:
            break
        found = discover(local_prefix(), 0.4, 64)
    if not found:
        raise RuntimeError(
            "ip = auto, but nothing answered a unicast handshake on this network - "
            "is the robot powered on and on the same Wi-Fi?")
    if len(found) > 1:
        raise RuntimeError(
            "ip = auto found more than one device: "
            + ", ".join(f"{d['ip']} (id {d['did']})" for d in found)
            + " - write the one you want as the ip")
    dev = found[0]
    cfg["ip"] = dev["ip"]
    if cfg.get("did") in (None, "", "auto"):
        cfg["did"] = str(dev["did"])
    if path.is_file():
        path.write_text("".join(f"{k} = {v}\n" for k, v in cfg.items()))
    return dev["ip"]


def open_vacuum(args) -> Vacuum:
    path = config_path(args.config)
    cfg = load_config(path)
    ip = args.ip or cfg.get("ip")
    token = args.token or cfg.get("token")
    did = args.did or cfg.get("did")
    if did and not str(did).isdigit():
        did = None                      # "auto", or a leftover placeholder
    if not ip or not token:
        raise ConfigError(
            f"no config at {path}: tap the tile, then setup, and paste the token")
    if token == PLACEHOLDER_TOKEN:
        raise ConfigError(
            "the token is still the placeholder: tap the tile, then setup, and "
            "paste the 32 hex characters the Xiaomi app uses for this robot")
    if ip.lower() == "auto":
        # The status poll never sweeps the LAN: a robot that's off, a phone away
        # from home or a second Xiaomi device would mean a sweep every 30s.
        # Setup's save, the login and discover find it.
        if args.command == "status":
            raise ConfigError(
                "the robot's address isn't known yet: tap the tile, then setup, "
                "and save (that finds it on this wi-fi)")
        ip = resolve_auto(path, cfg)
        did = did or cfg.get("did")
    # The drive pad wants the robot to move *now*: one try with a short wait
    # beats a confirmed delivery half a minute later.
    timeout = min(args.timeout, 1.5) if getattr(args, "fast", False) else args.timeout
    return Vacuum(ip, token, did, timeout,
                  retries=1 if getattr(args, "fast", False) else 3)


# --------------------------------------------------------------------------- #
# discovery
# --------------------------------------------------------------------------- #

def local_prefix() -> str:
    '''Our own /24, without needing netlink or `ip`.'''
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return ".".join(s.getsockname()[0].split(".")[:3])
    finally:
        s.close()


def probe_host(ip: str, timeout: float) -> dict | None:
    '''Unicast miIO hello. The robot answers these even though it ignores broadcast.

    It also drops one now and then, the way it drops an occasional request, so send
    a few and wait once - the same thing python-miio does when it discovers.
    '''
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        for _ in range(3):
            s.sendto(HELLO, (ip, PORT))
        try:
            resp, _ = s.recvfrom(2048)
        except socket.timeout:
            return None
        if len(resp) >= 32 and struct.unpack(">H", resp[2:4])[0] == 32:
            return {"ip": ip, "did": struct.unpack(">I", resp[8:12])[0]}
    except OSError:
        return None
    finally:
        s.close()
    return None


def discover(prefix: str, timeout: float, workers: int) -> list[dict]:
    hosts = [f"{prefix}.{i}" for i in range(1, 255)]
    found = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for res in pool.map(lambda h: probe_host(h, timeout), hosts):
            if res:
                found.append(res)
    return found


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #

def cmd_set(path: Path, ip: str | None, token: str | None, did: str | None,
            map_url: str | None = None) -> tuple[int, str]:
    '''Write the config from the widget's setup screen, or by hand.

    A field left empty keeps what is already there, so the screen can save the
    address without the token and the other way round - the token is never read
    back out of the file into the UI, where it would sit in a text field.

    The token is an AES key, so a typo in it is indistinguishable from a robot
    that is off: it is checked for shape here, and then the robot is asked. A
    right-looking token that is wrong still gets saved, because the file is
    otherwise in a state the user cannot fix - but the reply says so plainly.

    Returns (exit code, the lines the setup screen shows). Exit 0 if the file
    was written, 2 if it wasn't.
    '''
    out: list[str] = []
    cfg = load_config(path)

    if ip is not None and ip.strip():
        cfg["ip"] = ip.strip()
    if did is not None and did.strip():
        cfg["did"] = did.strip()
    if token is not None and token.strip():
        t = token.strip().lower().replace(" ", "").replace("-", "")
        if len(t) != 32 or any(c not in "0123456789abcdef" for c in t):
            out.append(f"not saved: the token is the robot's 32 hex characters, and "
                       f"'{token.strip()}' is {len(t)} of something else")
            return 2, "\n".join(out)
        cfg["token"] = t
    if map_url is not None and map_url.strip():
        # Where the computer serves the rendered map; the widget fetches it from
        # here. Not validated - a wrong one shows up as "no map yet", not a crash.
        cfg["map_url"] = map_url.strip()

    cfg.setdefault("ip", "auto")
    cfg.setdefault("did", "auto")
    if not cfg.get("token") or cfg["token"] == PLACEHOLDER_TOKEN:
        out.append("not saved: no token yet - paste the 32 hex characters the Xiaomi "
                   "app uses for this robot (the README lists three ways to get them)")
        return 2, "\n".join(out)

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{k} = {v}\n" for k, v in cfg.items()))
    path.chmod(0o600)
    out.append(f"saved: {str(path).replace(str(Path.home()), '~')}")

    # then ask the robot, which is the only thing that catches a wrong token
    try:
        addr = cfg["ip"]
        if addr.lower() == "auto":
            addr = resolve_auto(path, cfg)
        did = cfg.get("did")
        if did and not str(did).isdigit():
            did = None              # a leftover "auto": the robot's id is what
                                    # the probe below finds anyway
        v = Vacuum(addr, cfg["token"], did, 6.0)
        st = v.get(["status"]).get("status")
        out.append(f"the robot answered at {v.ip}: {STATUS_TEXT.get(st, 'status ' + str(st))}")
    except Exception as exc:                                    # noqa: BLE001
        out.append(f"but nothing answered: {exc}")
    return 0, "\n".join(out)


def cmd_status(v: Vacuum, all_props: bool, cfg: dict | None = None) -> dict:
    names = list(PROPS) if all_props else WIDGET_PROPS
    props = v.get(names)
    if all_props:
        return {"ok": True, "ip": v.ip, "did": v.did, "props": props}

    st = props.get("status")
    mode = props.get("mode")
    sweep = props.get("sweep_type")
    suction = props.get("suction")
    water = props.get("water")
    mop = props.get("mop_route")
    secs = props.get("cleaning_time") or 0
    fault = props.get("fault") or 0
    return {
        "ok": True,
        "ip": v.ip,
        "did": v.did,
        "status": st,
        "status_text": STATUS_TEXT.get(st, f"?{st}"),
        "busy": st in BUSY,
        "fault": fault,
        "fault_warn": fault not in BENIGN_FAULTS,
        "fault_text": f"fault {fault}" if fault not in BENIGN_FAULTS
                      else DOCK_FAULT_TEXT.get(fault, ""),
        "battery": props.get("battery"),
        "mode": mode,
        "mode_text": MODE_TEXT.get(mode, "?"),
        "sweep_type": sweep,
        "sweep_text": SWEEP_TEXT.get(sweep, "?"),
        "suction": suction,
        "suction_text": SUCTION_TEXT.get(suction, "?"),
        "water": water,
        "water_text": WATER_TEXT.get(water, "?"),
        "mop_route": mop,
        "mop_text": MOP_TEXT.get(mop, "?"),
        "minutes": round(secs / 60) if secs else 0,
        "area": props.get("cleaning_area") or 0,
        "map_url": (cfg or {}).get("map_url", ""),
        "consumables": {
            "side_brush": props.get("side_brush_life"),
            "main_brush": props.get("main_brush_life"),
            "filter": props.get("filter_life"),
            "mop": props.get("mop_life"),
        },
    }


def cmd_map(cfg: dict, url: str | None, timeout: float) -> int:
    '''Fetch a picture the computer rendered, so the map tab can show it.

    This is the *old* route: the blob lives in Xiaomi's object storage and the
    only URL for it is signed with the Mi account. `mapdata --refresh` does that
    on the phone now (the login on the setup tab); this remains for anyone who
    would rather keep the account on the computer. It only carries a finished
    PNG across the LAN.

    Prints JSON like every other command, so the tab shows a sentence rather
    than a blank when there is no map yet.
    '''
    url = (url or cfg.get("map_url", "")).strip()
    if not url:
        print(json.dumps({
            "ok": False,
            "error": "no map_url set: render the map on the computer, then put its "
                     "address in setup (the README has the one command)"}))
        return 1
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            data = resp.read()
    except (urllib.error.URLError, OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": f"no map from {url}: {exc}"}))
        return 1
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        print(json.dumps({
            "ok": False,
            "error": f"{url} answered {len(data)} bytes that are not a PNG "
                     f"(is the computer serving the file itself, not a page about it?)"}))
        return 1
    # Written under a temporary name first: the launcher re-reads this file on a
    # stat after every command, and must never catch it half-written.
    MAP_CACHE.parent.mkdir(parents=True, exist_ok=True)
    tmp = MAP_CACHE.with_name(MAP_CACHE.name + ".part")
    tmp.write_bytes(data)
    tmp.replace(MAP_CACHE)
    print(json.dumps({"ok": True, "img": str(MAP_CACHE), "bytes": len(data),
                      "at": int(time.time())}))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="LAN client for Xiaomi ijai vacuums.")
    ap.add_argument("command", nargs="?", default="status",
                    choices=["status", "action", "prop", "raw", "discover", "call",
                             "set", "map", "mapdata", "live", "login", "rooms", "last"])
    ap.add_argument("rest", nargs="*", help="arguments for the command")
    ap.add_argument("--config", help=f"config file (default {CONFIG})")
    ap.add_argument("--ip")
    ap.add_argument("--token", help="32 hex characters")
    ap.add_argument("--did")
    ap.add_argument("--map-url", help="where the computer serves the rendered map")
    ap.add_argument("--file", help="mapdata: read an encrypted map blob from a file")
    ap.add_argument("--url", help="mapdata: download an encrypted map blob")
    ap.add_argument("--refresh", action="store_true",
                    help="mapdata: fetch the live blob from the cloud again")
    ap.add_argument("--refit", action="store_true",
                    help="mapdata: recrop an existing cache to its content")
    ap.add_argument("--png", action="store_true",
                    help="mapdata: redraw the floor-plan picture from the cached blob")
    ap.add_argument("--save", action="store_true",
                    help="live: also cache the chunk for the map tab")
    ap.add_argument("--user", help="login: the Mi account name (email or phone)")
    ap.add_argument("--password",
                    help="login: the Mi account password (stdin also works)")
    ap.add_argument("--code", help="login: the emailed code, or the captcha text")
    ap.add_argument("--resend", action="store_true",
                    help="login: ask for another emailed code (rate-limited by Xiaomi)")
    ap.add_argument("--country", default="i2",
                    help="login: the account's Mi cloud region (default i2)")
    ap.add_argument("--timeout", type=float, default=6.0)
    ap.add_argument("--fast", action="store_true",
                    help="control: one try, short timeout (the drive pad)")
    ap.add_argument("--all", action="store_true", help="status: every property")
    ap.add_argument("--prefix", help="discover: subnet to sweep (the first three octets of your LAN)")
    ap.add_argument("--workers", type=int, default=64)
    args = ap.parse_args(argv)

    try:
        if args.command == "discover":
            prefix = args.prefix or local_prefix()
            found = discover(prefix, 0.4, args.workers)
            print(json.dumps({"ok": True, "prefix": prefix, "found": found,
                              "note": "the device id is discoverable; the token is not "
                                      "- it comes from the Xiaomi cloud once"}))
            return 0

        if args.command == "set":
            rc, text = cmd_set(config_path(args.config), args.ip, args.token,
                               args.did, args.map_url)
            _note("set", {"ok": rc == 0, "text": text})
            print(text)
            return rc

        if args.command == "last":
            # What the last long command answered, for the widget to poll.
            print(LAST.read_text() if LAST.is_file() else "{}")
            return 0

        if args.command == "map":
            # No device needed: this only carries a file the computer rendered,
            # so it still answers (with its own message) while the robot is off.
            return cmd_map(load_config(config_path(args.config)), args.map_url,
                           args.timeout)

        if args.command == "mapdata":
            # Also no device needed: the blob comes from the cloud or a file.
            if args.refit:
                return cmd_map_refit(load_config(config_path(args.config)))
            if args.png:
                return cmd_map_png(load_config(config_path(args.config)))
            return cmd_mapdata(load_config(config_path(args.config)),
                               args.file or args.url, args.refresh,
                               config_path(args.config))

        if args.command == "login":
            # No device needed either: this talks to the Mi account and then
            # writes what it learns into the config for the LAN client to use.
            return cmd_login(args)

        if args.command == "live":
            return cmd_live(open_vacuum(args), args.save)

        v = open_vacuum(args)

        if args.command == "status":
            print(json.dumps(cmd_status(v, args.all,
                                        load_config(config_path(args.config)))))
        elif args.command == "action":
            name = args.rest[0] if args.rest else ""
            if name not in ACTIONS and name not in SETS:
                print(json.dumps({"ok": False,
                                  "error": f"unknown action {name!r}",
                                  "known": sorted(list(ACTIONS) + list(SETS))}))
                return 2
            res = v.action(name)
            _note("action", {"ok": True, "action": name,
                             "text": f"{name} sent to {v.ip}"})
            print(json.dumps({"ok": True, "action": name, "result": res}))
        elif args.command == "prop":
            siid, piid = int(args.rest[0]), int(args.rest[1])
            if len(args.rest) > 2:
                res = v.set_prop(siid, piid, json.loads(args.rest[2]),
                                 retries=1 if getattr(args, "fast", False) else 3)
                print(json.dumps({"ok": True, "set": f"{siid}/{piid}",
                                  "value": json.loads(args.rest[2]), "result": res}))
            else:
                res = v.send("get_properties", [{"did": f"{siid}-{piid}",
                                                 "siid": siid, "piid": piid}])
                print(json.dumps({"ok": True, "result": res}))
        elif args.command == "call":
            siid, aiid = int(args.rest[0]), int(args.rest[1])
            params = json.loads(args.rest[2]) if len(args.rest) > 2 else []
            print(json.dumps({"ok": True, "result": v.call(siid, aiid, params)}))
        elif args.command == "rooms":
            # set-room-clean (7/3): room-ids (a comma string), mode, oper.
            # The spec route; the 2/7 one acks and never starts on this model.
            raw = (args.rest[0] if args.rest else "").replace(" ", "")
            ids = [int(x) for x in raw.split(",") if x.isdigit()]
            if not ids:
                print(json.dumps({"ok": False,
                                  "error": "rooms needs a room id, or ids like 10,11"}))
                return 2
            # set-room-clean (7/3): the action's inputs are the *property* piids
            # from the spec - 24 clean-room-ids, 25 clean-room-mode, 26
            # clean-room-oper - not 1/2/3. With 1/2/3 the robot acks and never
            # starts, which is why room cleaning looked dead.
            res = v.call(7, 3, [{"piid": 24, "value": ",".join(str(i) for i in ids)},
                                {"piid": 25, "value": 0},
                                {"piid": 26, "value": 1}])
            _note("clean", {"ok": True, "rooms": ids,
                            "text": "sent: rooms " + ", ".join(str(i) for i in ids)})
            print(json.dumps({"ok": True, "rooms": ids, "result": res}))
        elif args.command == "raw":
            method = args.rest[0] if args.rest else ""
            params = json.loads(args.rest[1]) if len(args.rest) > 1 else []
            if not method:
                print(json.dumps({"ok": False, "error": "raw needs a method name"}))
                return 2
            print(json.dumps({"ok": True, "method": method, "result": v.send(method, params)}))
        return 0
    except Exception as exc:                                    # noqa: BLE001
        # always valid JSON, so a widget never shows a bare crash
        name = "" if isinstance(exc, ConfigError) else f"{type(exc).__name__}: "
        print(json.dumps({"ok": False, "error": f"{name}{exc}"}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
OMARCHY_VACUUM_PY
  printf '%s' '57f4643fcadd' > "$d/tag"
fi
python3 "$d/vacuum.py" status
  """) every 30s json timeout 60s

  // the floor plan, rendered on a computer (see the map tab). It answers with a
  // sentence when nothing is configured, so the tab can say why it is empty.
  source mp = cmd("python3 $HOME/.cache/omarchy-vacuum/vacuum.py map") every 5m json timeout 60s

  // The same floor plan as geometry: rooms, their rectangles, the path and the
  // two poses, normalised to 0..1. Decoded on the phone (AES + zlib + protobuf,
  // all stdlib) from the blob `mapdata --refresh` fetched -- this read never
  // touches the network, it just re-reads the cache that wrote.
  source md = cmd("""
d=~/.cache/omarchy-vacuum
f=$d/map.json
# A widget update can change the view without changing the map. Refit an old
# cache once (the helper marks it `fit`) so a correctly fetched phone map is
# not replaced just to fix its scale.
if [ -f "$f" ] && [ -f "$d/vacuum.py" ] && [ -f "$d/tag" ] && [ "$f" -ot "$d/tag" ]; then
  python3 "$d/vacuum.py" mapdata --refit >/dev/null 2>&1 || true
fi
# An older cache has no picture of its own; draw it once from the blob that
# was already downloaded. The marker stops a map the phone cannot decrypt from
# spawning python every ten seconds.
if [ -f "$f" ] && ! ls "$d"/plan-*.png >/dev/null 2>&1 && [ ! -f "$d/plan.tried" ]; then
  : > "$d/plan.tried"
  python3 "$d/vacuum.py" mapdata --png >/dev/null 2>&1 || true
fi
if [ ! -f "$f" ]; then
  echo '{"ok":false,"error":"no floor plan on the phone yet - tap fetch"}'
  exit 0
fi
cat "$f"
  """) every 10s json

  // The last 10/5 chunk, cached by the live button. It is raw map metres, so
  // the map tab can put it on the same drawing as the room boxes. Reading a
  // file is cheap and does not poll the robot.
  source lv = cmd("cat ~/.cache/omarchy-vacuum/live.json 2>/dev/null || echo '{}'") every 10s json

  // `run(...)` is an *action*: it starts a command in the background and hands
  // nothing back, so a long command leaves its answer in last.json instead and
  // this polls it. That is what makes a two-tap login work at all: the first
  // process says "code sent", the second one finishes the job.
  source last = cmd("cat ~/.cache/omarchy-vacuum/last.json 2>/dev/null || echo '{}'") every 10s json

  // Is there a session to use? The login is a one-time task, so setup shows the
  // form only while there is nothing to skip - and the map tab can tell that it
  // has what it needs to go and fetch the floor plan.
  source sid = cmd("""
for f in ~/.config/omarchy-proot/vacuum-session.json ~/.config/omalauncher/vacuum-session.json; do
  if [ -f "$f" ] && grep -q service_token "$f"; then
    echo yes
    exit 0
  fi
done
echo no
  """) every 20s

  // Only the pending-timeout reads this. An interval of one second keeps a tap
  // honest without making anything redraw: sources wait until the widget is on
  // screen, and no node reads `tick`.
  source tick = clock every 1s

  // which half of the screen shows, and what setup is editing
  state tab = "status"
  state tokenText = ""
  state ipText = ""
  state mapText = ""

  // The Mi account. The password is deliberately *not* persisted: it lives in
  // this state (memory) only, is handed to the client as an argument when log
  // in is tapped, and is cleared the moment a login succeeds. No file ever
  // holds it - the session file holds only the token/ssecurity the login
  // returned. The argument is visible in /proc while the login runs; that is
  // the price of not storing it anywhere.
  state userText = ""
  state passText = ""
  state codeText = ""
  state showPw = false
  let lg = last != null && last.kind == "login" ? last : null
  // `at` is written by the client; a stale "working..." must not stick forever
  // if its process was killed.
  let fresh = last != null && last.at != null && tick - last.at < 180
  let lgBusy = lg != null && lg.busy == true && fresh
  // a code is only worth offering for half an hour; after that the state file
  // on disk has almost certainly expired too
  let lgOpen = lg != null && lg.at != null && tick - lg.at < 1800
  let lgNeed = lg != null && lgOpen ? (lg.need ?? "") : ""
  let lgUser = lg != null ? (lg.user ?? "") : ""
  // `relogin` keeps the form open after a successful login once the user asks
  // for it again; `sentCode` stops one typed code from being posted twice;
  // `fetched` stops either fetch rule below from running more than once.
  state relogin = false
  state sentCode = ""
  state fetched = false
  // When the log in button was tapped, so the strip below can say "nothing came
  // back" instead of looking dead when the command never answers at all.
  state loginAt = 0
  let signedIn = sid == "yes" && !relogin
  let loginWait = loginAt > 0 && (lg == null || (lg.at ?? 0) < loginAt)
  let loginStale = loginWait && tick >= loginAt + 15
  let lgRed = loginStale || (lg != null && lgOpen && lg.ok != true)
  let lgGreen = !lgRed && lg != null && lgOpen && lg.ok == true
  // One line for whatever the login last said, drawn on every tab: a tap that
  // changes nothing used to be indistinguishable from a widget that never ran
  // the command, and that is exactly the question this answers.
  let lgLine = loginWait ? (loginStale ? "the login command never answered - check that the phone is online, then tap log in again" : "signing in...") : (lg != null && lgOpen ? (lg.ok == true ? (lg.message ?? "ok") : (lg.error ?? "the login failed")) : "")

  // The last *other* long command (save, map refresh, clean) - shown for a few
  // minutes, because `run` cannot return its text to the widget.
  let act = fresh && last.kind != "login" ? last : null

  // the rooms picked on the map; selection is by room id, so it survives re-reads
  // of the cache. `nsel` is just the count, read in several places.
  state sel = []
  let mdok = md != null && md.ok == true
  let nsel = len(sel)
  // `live` is the cached 10/5 chunk. Its points are raw map metres; the Canvas
  // maps them through md.bounds, so the green dot and the path line up with the
  // room boxes without re-reading the blob.
  let lvp = lv != null && lv.ok == true && lv.points != null ? lv.points : []
  let lvclean = lvp.filter(q => q[3] == 1)
  let lvtravel = lvp.filter(q => q[3] != 1)
  let lvlast = len(lvp) > 0 ? lvp[len(lvp) - 1] : null

  // A write in flight: which property, at which value, and since when. The robot
  // takes a second or two to confirm one, so the tapped choice lights up at once
  // and keeps the spinner until the robot's own report agrees with it. `askAt`
  // is there for the one case the report cannot cover: a write that is refused,
  // where nothing changes, so the row settles back on the truth by itself
  // rather than claiming a value the robot never took.
  state askProp = ""
  state askVal = -1
  state askAt = 0

  // 7/16 is write-only on this robot (the read answers code -4001), so the pad
  // is the only record of which way it was last sent. It is not persisted: a
  // restart forgets it, which is why stop and exit are the wide buttons there.
  state dir = -1

  let offline = v == null || v.ok != true
  let busy = !offline && v.busy == true
  let low = !offline && v.battery <= 20
  let remote = !offline && v.sweep_type == 5
  let hasmap = mp != null && mp.ok == true

  // 2/8 takes a moment to report back, and a refused write would leave the pad
  // up for nothing: entering remote mode shows the pad at once (the arrows are
  // harmless if the robot is not really listening) and the robot's own report
  // takes over as soon as it arrives. Leaving hides it just as promptly.
  let enterAsk = askProp == "2-8" && askVal == 5
  let leaveAsk = askProp == "7-16" && askVal == 10
  let driveOn = (remote || enterAsk) && !leaveAsk
  let w = cols ?? 6
  let h = rows ?? 4
  let mini = w <= 3 && h <= 2
  let compact = !mini && (w <= 3 || h <= 2)

  when askProp != "" && tick >= askAt + 10 { askProp = ""; askVal = -1 }

  // A successful login does not need the password any more; forget it and put
  // the field back behind dots.
  when lg != null && lg.logged_in == true && (passText != "" || showPw) {
    passText = ""
    showPw = false
    relogin = false
  }

  // The account name is not a secret (it is in the config file too), so keep it
  // for the next visit instead of asking again.
  when lg != null && lg.user != null && userText == "" { userText = lg.user }

  // An emailed code is six digits; typing the last one is enough.
  when lgNeed == "code" && len(codeText) == 6 && codeText != sentCode {
    sentCode = codeText
    loginAt = tick
    run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py login --code ${sh(codeText)}")
  }

  // Logging in is only step one of what the user wants: the floor plan is the
  // reason the account was needed, so fetch it as soon as there is a session
  // and nothing cached. `fetched` keeps this to one call per visit.
  when lg != null && lg.logged_in == true && fresh && !fetched {
    fetched = true
    run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py mapdata --refresh")
  }
  when tab == "map" && sid == "yes" && md != null && (!mdok || md.proof == true) && !fetched {
    fetched = true
    run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py mapdata --refresh")
  }

  // a tap opens the full-screen view - and, with nothing usable in the config,
  // the half of it that fixes that
  onTap: { tab = offline ? "setup" : "status"; screen() }

  // a consumable's remaining life, as a small labelled bar
  component Consumable(name, value) {
    Column {
      gap: 2
      weight: 1
      Text { text: name; style: label; maxLines: 1 }
      Progress { value: value ?? 0; max: 100; color: (value ?? 0) < 20 ? red : accent }
      Text { text: "${value ?? 0}%"; fontSize: 10; color: muted; maxLines: 1 }
    }
  }

  // a label over a value
  component Info(name, value) {
    Column {
      gap: 0
      weight: 1
      Text { text: name; style: label; maxLines: 1 }
      Text { text: value; style: body; maxLines: 1 }
    }
  }

  // a thin separator between groups of controls
  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  // One row of mutually exclusive buttons. Each writes the property `siid/piid`
  // with its own index. The one the robot reports is lit; while a write is in
  // flight the tapped one is lit instead, dimmed, with a spinner by the heading.
  component Choice(head, siid, piid, current, labels) {
    let mine = "${int(siid)}-${int(piid)}"
    let waiting = askProp == mine && current != askVal
    let shown = askProp == mine ? askVal : current
    Column {
      gap: 6
      fill: width
      Row {
        gap: 6
        fill: width
        Text { text: head; style: label; color: accent; weight: 1; maxLines: 1 }
        if waiting {
          Canvas {
            width: 12
            height: 12
            let r = min(width, height) / 2 - 1.5
            circle(width / 2, height / 2, r, stroke: muted, width: 2)
            arc(width / 2, height / 2, r, (time * 300) % 360, 90, stroke: accent, width: 2, cap: round)
          }
          Text { text: "saving"; style: label; color: muted; width: 50; align: end; maxLines: 1 }
        }
      }
      Row {
        gap: 6
        fill: width
        for l, i in labels {
          Button {
            text: l
            weight: 1
            color: shown == i ? accent : muted
            opacity: waiting ? 0.6 : 1
            onTap: { askProp = mine; askVal = i; askAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py prop ${int(siid)} ${int(piid)} ${sh(i)}") }
          }
        }
      }
    }
  }

  // one arrow of the drive pad: the spec's direction values are 0/1/2/3 for
  // forward/left/right/back and 4 is stop (5 is exit). -1 is "nothing sent".
  component Drive(glyph, value, tint) {
    Button {
      text: glyph
      weight: 1
      color: dir == value ? accent : tint
      onTap: { dir = value; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py --fast prop 7 16 ${int(value)}") }
    }
  }

  Column {
    gap: 6

    // 2x2, 3x2: a glance. is it working, and how much battery.
    if mini {
      Box {
        align: center
        Ring { value: v.battery ?? 0; max: 100; color: low ? red : accent; thickness: 5 }
        Text { text: offline ? "?" : "${v.battery}%"; fontSize: 16; bold: true; align: center }
      }
      Text { text: offline ? "offline" : v.status_text; style: small; color: offline ? red : muted; align: center; maxLines: 1 }
    }

    // half-width, or short: the state, and the two buttons that matter
    if compact {
      Row {
        gap: 8
        Text { text: "${v.battery ?? 0}%"; style: title; width: 70; color: low ? red : foreground }
        Text { text: offline ? "unreachable" : v.status_text; fontSize: 12; color: offline ? red : muted; weight: 1; align: end; maxLines: 1 }
      }
      Spacer { weight: 1 }
      Row {
        gap: 6
        Button { text: "start"; weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action start; sleep 2") }
        Button { text: "dock"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action dock; sleep 2") }
      }
    }

    // the size it is meant to be
    if !mini && !compact {
      Row {
        Text { text: "vacuum"; style: muted; weight: 1 }
        Text { text: offline ? "unreachable" : remote ? "remote" : v.status_text; fontSize: 12; bold: busy || remote; color: offline ? red : busy || remote ? accent : muted; width: 104; align: end; maxLines: 1 }
      }

      if offline {
        Text { text: "can't reach the vacuum"; style: small; color: red; maxLines: 1 }
        Text { text: v.error ?? "tap to set the address and token"; style: small; color: muted; maxLines: 3 }
        Spacer { weight: 1 }
        Text { text: "tap for setup"; style: label; color: accent }
      } else {
        Row {
          gap: 10
          Text { text: "${v.battery}%"; style: title; width: 56; color: low ? red : foreground }
          Column {
            gap: 0
            weight: 1
            Text { text: "${v.mode_text} · ${v.suction_text}"; style: small; color: foreground; maxLines: 1 }
            Text { text: v.minutes > 0 ? "${v.minutes} min · ${v.area} m2" : "idle"; style: small; color: muted; maxLines: 1 }
          }
          if v.fault_warn {
            Text { text: v.fault_text; fontSize: 11; color: red; width: 62; align: end; maxLines: 1 }
          }
        }

        Row {
          gap: 6
          Button { text: "start"; weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action start; sleep 2") }
          Button { text: "stop"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action stop; sleep 2") }
          Button { text: "dock"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action dock; sleep 2") }
        }

        Spacer { weight: 1 }
        Row {
          gap: 8
          Consumable { name: "side"; value: v.consumables.side_brush }
          Consumable { name: "main"; value: v.consumables.main_brush }
          Consumable { name: "filter"; value: v.consumables.filter }
          Consumable { name: "mop"; value: v.consumables.mop }
        }
      }
    }
  }

  // Everything that doesn't fit on a tile. A widget gets one screen, so the four
  // views share it, switched by `tab`: what it is doing and how to set it up, the
  // drive pad, the map, and the two values it needs before it can talk at all.
  // The frame draws the title and the x, so this only lays content out.
  screen {
    title: "vacuum"

    Row {
      gap: 6
      fill: width
      Button { text: "status"; weight: 1; color: tab == "status" ? accent : muted; onTap: tab = "status" }
      Button { text: "drive"; weight: 1; color: tab == "drive" ? accent : muted; onTap: tab = "drive" }
      Button { text: "map"; weight: 1; color: tab == "map" ? accent : muted; onTap: tab = "map" }
      Button { text: "setup"; weight: 1; color: tab == "setup" ? accent : muted; onTap: tab = "setup" }
    }

    // The login's own line, on every tab - see `lgLine`. It stays empty until
    // there is something to say.
    if lgLine != "" {
      Text { text: lgLine; style: small; color: lgRed ? red : lgGreen ? green : muted; maxLines: 3 }
    }

    if tab == "setup" {
      Column {
        gap: 12
        weight: 1
        scroll: true
        padding: [0, 2]

        Text { text: "the widget keeps the robot's address, token and map address in ~/.config/omarchy-proot/vacuum, and writes that file for you. leave a field empty to keep what is already there."; style: small; color: muted; maxLines: 6 }

        Column {
          gap: 6
          Text { text: "your mi account"; style: label; color: accent }
          if signedIn {
            Text { text: "signed in" + (lgUser != "" ? " as " + lgUser : "") + " - the map tab has what it needs to fetch your floor plan."; style: small; color: green; maxLines: 3 }
            if lg != null && lgOpen && lg.message != null {
              Text { text: lg.message; style: small; color: muted; maxLines: 4 }
            }
            if lg != null && lgOpen && lg.devices != null {
              Text { text: "this account has no single vacuum to write into the config (" + len(lg.devices) + " devices on it) - set the token by hand below, then fetch the map."; style: small; color: red; maxLines: 4 }
            }
            Button { text: "sign in again"; color: muted; onTap: relogin = true }
          }

          if !signedIn {
          Text { text: "log in once: it writes the robot's token and ids into the config, and lets the map tab fetch the floor plan. xiaomi may email a code or ask for a captcha - type it below and verify. xiaomi limits emailed codes hard: if the answer says 'try again tomorrow', nothing was sent and waiting is the only fix. the password is used once, never written to any file, and forgotten as soon as the login succeeds."; style: small; color: muted; maxLines: 12 }
          Input { text: userText; placeholder: "email or phone"; fontSize: 15; onChange: userText = value }

          Row {
            gap: 6
            fill: width
            Box {
              // A masked field must not be an invisible Input under a Text: if
              // that Text takes the tap, the field never gets focus and the
              // login runs with an empty password ("no code was sent"). So the
              // masked state is a display - tapping the dots reveals the real
              // Input, and the eye does the same.
              weight: 1
              height: 42
              align: start
              if showPw {
                Input {
                  text: passText
                  placeholder: "password"
                  fontSize: 15
                  fill: width
                  onChange: passText = value
                }
              } else {
                Text { text: len(passText) == 0 ? "tap here (or the eye) to type your password" : join(range(len(passText)).map(i => "•"), ""); fontSize: 15; color: len(passText) == 0 ? muted : foreground; fill: width; padding: [12, 0]; maxLines: 1; onTap: showPw = true }
              }
            }
            Button { text: showPw ? "hide" : "👁"; color: showPw ? accent : muted; width: 58; onTap: showPw = !showPw }
          }

          // The password travels as an argument, not on stdin: a pipe needs the
          // command runner to use a shell, and one that doesn't leaves python
          // waiting on a stdin nobody writes - a silent hang with no mail sent.
          Button { text: lgBusy ? "working..." : "log in"; color: lgBusy ? muted : accent; onTap: { loginAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py login --user ${sh(userText)} --password ${sh(passText)}") } }

          if lg != null && lgOpen {
            Text { text: lg.ok == true ? (lg.message ?? "ok") : (lg.error ?? "the login failed"); style: small; color: lg.ok == true ? green : red; maxLines: 8 }
          }
          if lgNeed == "captcha" {
            Image { src: lg.image; height: 80; fit: contain }
          }
          if lgNeed == "code" || lgNeed == "captcha" {
            Input { text: codeText; placeholder: lgNeed == "captcha" ? "the characters in the picture" : "the code from the email"; fontSize: 15; onChange: codeText = value }
            if lgNeed == "captcha" {
              Button { text: "verify captcha"; color: accent; onTap: { loginAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py login --code ${sh(codeText)}") } }
            } else {
              Row {
                gap: 6
                fill: width
                Text { text: "the sixth digit verifies itself"; style: small; color: muted; weight: 1; maxLines: 2 }
                Button { text: "resend"; color: muted; onTap: { loginAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py login --resend") } }
              }
            }
          }
          }  // !signedIn
        }

        Rule { }

        Column {
          gap: 6
          Text { text: "token"; style: label; color: accent }
          Input { text: tokenText; placeholder: "the 32 hex characters"; fontSize: 15; onChange: tokenText = value }
        }

        Column {
          gap: 6
          Text { text: "address"; style: label; color: accent }
          Input { text: ipText; placeholder: "auto (find it on this wi-fi), or the robot's address"; fontSize: 15; onChange: ipText = value }
        }

        Column {
          gap: 6
          Text { text: "map address"; style: label; color: accent }
          Input { text: mapText; placeholder: "optional map picture URL"; fontSize: 15; onChange: mapText = value }
        }

        Row {
          gap: 6
          fill: width
          Button { text: "save"; weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py set --ip ${sh(ipText)} --token ${sh(tokenText)} --map-url ${sh(mapText)}") }
          Button { text: "edit the file"; weight: 1; color: muted; onTap: terminal('$EDITOR ~/.config/omarchy-proot/vacuum', "vacuum config") }
        }

        if act != null && act.kind == "set" {
          Text { text: act.text ?? "saved"; style: small; color: contains(act.text ?? "", "the robot answered") ? green : red; maxLines: 4 }
        }

        if v != null && !offline {
          Text { text: "talking to ${v.ip} (device ${v.did})"; style: label; color: muted; maxLines: 2 }
        }
        if v != null && v.map_url != "" {
          Text { text: "map address: ${v.map_url}"; style: label; color: muted; maxLines: 2 }
        }

        Text { text: "the token is per robot and never changes. it cannot be read off the robot - the README has three ways to get it from your xiaomi account, and it is used here and nowhere else."; style: small; color: muted; maxLines: 8 }
      }
    }

    if tab == "drive" {
      Column {
        gap: 14
        weight: 1
        scroll: true
        padding: [0, 2]

        Column {
          gap: 6
          fill: width
          Text { text: "manual drive"; style: label; color: accent }
          Text { text: "remote mode steers the robot by hand. it does not watch its own bumpers while it is on, so keep it in sight and press stop when you look away. the robot does not report the direction back, so the pad shows what it last sent."; style: small; color: muted; maxLines: 6 }
        }

        Row {
          gap: 6
          fill: width
          if driveOn {
            Button { text: "stop"; weight: 1; color: red; onTap: { dir = -1; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py --fast prop 7 16 4") } }
            Button { text: "leave remote mode"; weight: 1; color: accent; onTap: { dir = -1; askProp = "7-16"; askVal = 10; askAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py --fast prop 7 16 10") } }
          } else {
            Button { text: "enter remote mode"; weight: 1; color: enterAsk ? muted : accent; onTap: { dir = -1; askProp = "2-8"; askVal = 5; askAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py --fast prop 2 8 5") } }
          }
        }

        if driveOn {
          Column {
            gap: 6
            fill: width
            Row {
              gap: 6
              fill: width
              Spacer { weight: 1 }
              Drive { glyph: "▲"; value: 0; tint: muted }
              Spacer { weight: 1 }
            }
            Row {
              gap: 6
              fill: width
              Drive { glyph: "◀"; value: 1; tint: muted }
              Drive { glyph: "■"; value: 4; tint: red }
              Drive { glyph: "▶"; value: 2; tint: muted }
            }
            Row {
              gap: 6
              fill: width
              Spacer { weight: 1 }
              Drive { glyph: "▼"; value: 3; tint: muted }
              Spacer { weight: 1 }
            }
          }
          Text { text: "it keeps moving in the last direction until you press stop, so the pad is the only thing that knows what it is doing - it forgets if the launcher restarts."; style: small; color: muted; maxLines: 4 }
        } else {
          Text { text: "the robot is not in remote mode, so the pad is hidden. it stays stopped while this is off, and it is off whenever the robot starts a normal clean."; style: small; color: muted; maxLines: 4 }
        }
      }
    }

    if tab == "map" {
      Column {
        gap: 12
        weight: 1
        scroll: true
        padding: [0, 2]

        Row {
          gap: 6
          fill: width
          Text { text: "the map"; style: label; color: accent; weight: 1; maxLines: 1 }
          Button { text: "fetch"; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py mapdata --refresh") }
          Button { text: "live"; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py live --save") }
        }

        // The app's three numbers, in the app's order: what was cleaned, how
        // long it took, and the battery. They come from the normal status poll.
        if v != null && v.ok == true {
          Row {
            gap: 6
            fill: width
            padding: [8, 7]
            radius: 8
            background: alpha(muted, 0.12)
            Text { text: "area " + (v.area ?? 0) + " m2"; style: small; color: foreground; weight: 1; align: center; maxLines: 1 }
            Text { text: "duration " + (v.minutes ?? 0) + " min"; style: small; color: foreground; weight: 1; align: center; maxLines: 1 }
            Text { text: "battery " + (v.battery ?? 0) + "%"; style: small; color: foreground; weight: 1; align: center; maxLines: 1 }
          }
        }

        // An empty map always says which of the three states it is in: a fetch
        // in flight, a fetch that answered no, or nothing ever tried.
        if mdok == false && fetched && (act == null || act.kind == "login" || (act.kind == "map" && act.ok == true)) {
          Text { text: "fetching your floor plan from the Mi cloud..."; style: small; color: muted; maxLines: 3 }
        }
        if mdok == false && act != null && act.kind == "map" && act.ok != true {
          Text { text: act.error ?? "no map"; style: small; color: red; maxLines: 10 }
        }
        if mdok == false && !fetched && md != null && (act == null || act.kind != "map") {
          Text { text: md.error ?? "no floor plan"; style: small; color: red; maxLines: 8 }
        }
        if mdok && md.proof == true && act != null && act.kind == "map" && act.ok != true {
          Text { text: act.error ?? "the cloud map did not load"; style: small; color: red; maxLines: 6 }
        }

        if mdok {
          // The floor plan is a picture now: `mapdata` renders the blob's own
          // grid to a PNG on the phone, so walls, doorways and the real room
          // shapes are there instead of a handful of rectangles. The box takes
          // the plan's own shape from `view`, so a portrait flat is not squeezed
          // into a square, and the Canvas over the picture draws only what
          // changes: picked rooms, the live path, the poses and the labels.
          // `onTap` gives dp coordinates inside the Canvas, which is exactly the
          // picture's box; `md.hits` is every room part, smallest first, so an
          // L-shaped room and a neighbour under the finger resolve to the room
          // really there.
          Box {
            width: 300
            height: md.view != null ? 300 * md.view[1] / md.view[0] : 300
            radius: 10
            clip: true
            background: alpha(muted, 0.08)

            Image { src: md.plan ?? "~/.cache/omarchy-vacuum/plan.png"; fill: true; fit: contain }

            Canvas {
              onTap: {
                let ph = md.view != null ? 300 * md.view[1] / md.view[0] : 300
                let hit = find(md.hits ?? md.rooms, h => x >= h.box[0] * 300 && x <= (h.box[0] + h.box[2]) * 300 && y >= h.box[1] * ph && y <= (h.box[1] + h.box[3]) * ph)
                if hit != null {
                  sel = contains(sel, hit.id) ? sel.filter(i => i != hit.id) : sel + [hit.id]
                }
              }
              // Until the picture is there (an older cache, or a fetch in
              // flight) the rectangles still say what the rooms are.
              if md.plan == null {
                for r in md.rooms.sortBy(r => -(r.dims != null ? r.dims.bbox_area : 0)) {
                  for p in r.parts {
                    rect(p[0] * width, p[1] * height, p[2] * width, p[3] * height, radius: 2, fill: alpha(r.color ?? accent, 0.68), stroke: alpha(foreground, 0.22), width: 1)
                  }
                }
              }
              // A picked room is tinted over the picture, so a tap shows at once.
              for r in md.rooms {
                if contains(sel, r.id) {
                  for p in r.parts {
                    rect(p[0] * width, p[1] * height, p[2] * width, p[3] * height, radius: 2, fill: alpha(r.color ?? accent, 0.35), stroke: r.color ?? accent, width: 2)
                  }
                }
              }
              // The blob's own path goes over the room fills, or a selected room
              // would hide the cleaned line.
              if len(md.path) > 1 {
                path(md.path.map(q => [q[0] * width, q[1] * height]), stroke: alpha(accent, 0.4), width: 1)
              }
              // The obstacle layer from RobotMap fields 9/10/11/15/16: furniture
              // outlines, no-go/virtual-wall polygons, detected-object dots and
              // waypoints. A map without those layers has empty lists here.
              for f in (md.furniture ?? []) {
                if len(f.points) > 1 {
                  path(f.points.map(q => [q[0] * width, q[1] * height]), stroke: alpha(foreground, 0.45), width: 1)
                }
              }
              for z in (md.virtual_walls ?? []) {
                if len(z.points) > 1 {
                  path((z.points + [z.points[0]]).map(q => [q[0] * width, q[1] * height]), stroke: alpha(red, 0.8), width: 1)
                }
              }
              for z in (md.areas ?? []) {
                if len(z.points) > 1 {
                  path((z.points + [z.points[0]]).map(q => [q[0] * width, q[1] * height]), stroke: alpha(red, 0.8), width: 1)
                }
              }
              for o in (md.objects ?? []) {
                if o.notShow != 1 {
                  circle(o.at[0] * width, o.at[1] * height, 3, fill: alpha(foreground, 0.8))
                }
              }
              for p in (md.navigation ?? []) {
                path([[p.at[0] * width - 3, p.at[1] * height], [p.at[0] * width + 3, p.at[1] * height]], stroke: accent, width: 1)
                path([[p.at[0] * width, p.at[1] * height - 3], [p.at[0] * width, p.at[1] * height + 3]], stroke: accent, width: 1)
              }
              // The newest 10/5 chunk, if the live button cached one. Travel (flag
              // 0) is dim; cleaned (flag 1) is bright; the green dot is the pose.
              if md.bounds != null && len(lvtravel) > 1 {
                path(lvtravel.map(q => [(q[0] - md.bounds[0]) / (md.bounds[1] - md.bounds[0]) * width, (1 - (q[1] - md.bounds[2]) / (md.bounds[3] - md.bounds[2])) * height]), stroke: alpha(muted, 0.35), width: 1)
              }
              if md.bounds != null && len(lvclean) > 1 {
                path(lvclean.map(q => [(q[0] - md.bounds[0]) / (md.bounds[1] - md.bounds[0]) * width, (1 - (q[1] - md.bounds[2]) / (md.bounds[3] - md.bounds[2])) * height]), stroke: alpha(foreground, 0.85), width: 2)
              }
              if md.bounds != null && lvlast != null {
                if lv.head != null {
                  path([[(lvlast[0] - md.bounds[0]) / (md.bounds[1] - md.bounds[0]) * width, (1 - (lvlast[1] - md.bounds[2]) / (md.bounds[3] - md.bounds[2])) * height], [(lvlast[0] + lv.head[0] * 0.4 - md.bounds[0]) / (md.bounds[1] - md.bounds[0]) * width, (1 - (lvlast[1] + lv.head[1] * 0.4 - md.bounds[2]) / (md.bounds[3] - md.bounds[2])) * height]], stroke: green, width: 2)
                }
                circle((lvlast[0] - md.bounds[0]) / (md.bounds[1] - md.bounds[0]) * width, (1 - (lvlast[1] - md.bounds[2]) / (md.bounds[3] - md.bounds[2])) * height, 4, fill: green)
              }
              circle(md.charger[0] * width, md.charger[1] * height, 4, fill: green)
              if lvlast == null {
                circle(md.vacuum[0] * width, md.vacuum[1] * height, 5, fill: accent)
              }
              for r in md.rooms {
                if r.dims != null {
                  text(r.name, r.label[0] * width, r.label[1] * height - 4, size: 9, align: center, color: foreground)
                  if r.box[2] * width > 48 && r.box[3] * height > 30 {
                    text((r.dims.estimated == true ? "~" : "") + (r.dims.actual ?? r.dims.area) + "m2", r.label[0] * width, r.label[1] * height + 8, size: 7, align: center, color: alpha(foreground, 0.8))
                  }
                } else {
                  text(r.name, r.label[0] * width, r.label[1] * height, size: 9, align: center, color: foreground)
                }
              }
            }
          }

          if md.proof == true {
            Text { text: "this floor plan came from an older fallback cache. exact outlines, cell-count areas and the obstacle layer need the signed cloud map."; style: small; color: muted; maxLines: 4 }
          } else {
            Text { text: "the robot's own map file, drawn on the phone - no picture came from a server. obstacle layer: " + (md.counts.objects ?? 0) + " objects, " + (md.counts.furniture ?? 0) + " furniture, " + ((md.counts.virtual_walls ?? 0) + (md.counts.areas ?? 0)) + " no-go zones."; style: small; color: muted; maxLines: 4 }
          }
          if lv != null && lv.ok == true {
            Text { text: lv.idle == true ? "live pose: robot idle (10/5 is just a timestamp)" : "live pose: " + len(lvp) + " points from 10/5"; style: small; color: muted; maxLines: 2 }
          }
          Text { text: "tap a room to add it to the clean, tap it again to leave it out. the table below keeps the bounding-box W x H; a room marked * has been cleaned before."; style: small; color: muted; maxLines: 4 }

          Flow {
            gap: 6
            fill: width
            for r in md.rooms {
              Button { text: r.name + (r.cleaned == true ? " *" : ""); color: contains(sel, r.id) ? (r.color ?? accent) : alpha(r.color ?? muted, 0.8); onTap: sel = contains(sel, r.id) ? sel.filter(i => i != r.id) : sel + [r.id] }
            }
          }

          Row {
            gap: 6
            fill: width
            Text { text: nsel == 0 ? "no rooms picked - clean all" : nsel + " picked"; style: small; color: muted; weight: 1; maxLines: 1 }
            Button { text: "all"; color: muted; onTap: sel = md.rooms.map(r => r.id) }
            Button { text: "none"; color: muted; onTap: sel = [] }
          }

          Row {
            gap: 6
            fill: width
            if nsel == 0 {
              Button { text: "clean everything"; weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action start") }
            } else {
              Button { text: "clean " + nsel + (nsel == 1 ? " room" : " rooms"); weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py rooms ${sh(sel.join(","))}") }
            }
            Button { text: "stop"; color: red; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action stop") }
          }

          if act != null && act.ok == true && (act.kind == "clean" || act.kind == "action" || act.kind == "map" || act.kind == "live") {
            Text { text: act.text ?? "sent"; style: small; color: muted; maxLines: 2 }
          }
          Text { text: "whole-floor cleaning is the robot's own start. a room clean is the spec's set-room-clean (7/3 with piids 24/25/26); if the robot refuses it, the reply above says so and nothing moves."; style: small; color: muted; maxLines: 4 }

          Rule { }
          Column {
            gap: 2
            fill: width
            Text { text: "room dimensions"; style: label; color: accent }
            Row {
              gap: 6
              fill: width
              Text { text: "room"; fontSize: 9; color: muted; weight: 1; maxLines: 1 }
              Text { text: "bbox W x H"; fontSize: 9; color: muted; width: 86; align: end; maxLines: 1 }
              Text { text: "area"; fontSize: 9; color: muted; width: 58; align: end; maxLines: 1 }
            }
            for r in md.rooms {
              if r.dims != null {
                Row {
                  gap: 6
                  fill: width
                  Text { text: r.name; fontSize: 10; color: foreground; weight: 1; maxLines: 1 }
                  Text { text: r.dims.w + " x " + r.dims.h + " m"; fontSize: 10; color: muted; width: 86; align: end; maxLines: 1 }
                  Text { text: (r.dims.estimated == true ? "~" : "") + (r.dims.actual ?? r.dims.area) + " m2"; fontSize: 10; color: muted; width: 58; align: end; maxLines: 1 }
                }
              }
            }
            Row {
              gap: 6
              fill: width
              Text { text: "all"; fontSize: 10; color: foreground; weight: 1; maxLines: 1 }
              Text { text: (md.proof == true ? "~" : "") + (md.total_area ?? 0) + " m2"; fontSize: 10; color: accent; width: 86; align: end; maxLines: 1 }
              Spacer { width: 58 }
            }
            Text { text: md.proof == true ? "W x H and area come from the fallback boxes; fetch the cloud map for exact outlines and cell-count areas." : "W x H is the bounding box; area is counted from the map's own cells."; style: small; color: muted; maxLines: 4 }
          }
        } else {
          if md == null {
            Text { text: "no map on the phone yet."; style: small; color: muted; maxLines: 2 }
          } else {
            Text { text: md.error ?? "no map on the phone yet"; style: small; color: red; maxLines: 6 }
          }
          Text { text: "the floor plan is not something the robot's token can fetch: it lives in xiaomi's storage behind a signed url, and that signature needs an account session. log in on the setup tab (it also fills in the token), come back here, and tap fetch."; style: small; color: muted; maxLines: 10 }
          Text { text: "the older route still works: render the map on a computer, put its address in setup, and the tab below carries the picture across your wi-fi."; style: small; color: muted; maxLines: 6 }
        }

        if hasmap {
          Rule { }
          Text { text: "carried picture (the computer render)"; style: label; color: muted }
          Image { src: mp.img; fill: width; height: 240; fit: contain }
        }
      }
    }

    if tab == "status" {
      Column {
        gap: 14
        weight: 1
        scroll: true
        padding: [0, 2]

        Row {
          gap: 14
          align: center
          fill: width
          Box {
            width: 76
            height: 76
            align: center
            Ring { fill: true; thickness: 6; value: v.battery ?? 0; max: 100; color: low ? red : accent }
            Text { text: "${v.battery ?? 0}%"; style: title; align: center; maxLines: 1 }
          }
          Column {
            gap: 2
            weight: 1
            Text { text: offline ? "can't reach the vacuum" : remote ? "remote mode" : v.status_text; style: title; color: offline ? red : remote ? accent : foreground; maxLines: 2 }
            Text { text: offline ? "it answers on your wi-fi, never through xiaomi" : "${v.mode_text} · ${v.suction_text}"; style: small; color: muted; maxLines: 2 }
            if v != null && v.fault_warn {
              Text { text: v.fault_text; style: small; color: red; maxLines: 2 }
            }
          }
        }

        if offline {
          Column {
            gap: 8
            Text { text: v.error ?? "no config yet"; style: small; color: muted; maxLines: 6 }
            Button { text: "set the address and token"; color: accent; onTap: tab = "setup" }
          }
        } else {
          Row {
            gap: 6
            fill: width
            Button { text: "start"; weight: 1; color: accent; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action start; sleep 2") }
            Button { text: "pause"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action stop; sleep 2") }
            Button { text: "dock"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action dock; sleep 2") }
            Button { text: "beep"; weight: 1; color: muted; onTap: run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py action locate") }
          }

          Rule { }

          Choice { head: "cleaning mode"; siid: 2; piid: 4; current: v.mode; labels: ["sweep", "sweep + mop", "mop"] }
          Choice { head: "water"; siid: 7; piid: 6; current: v.water; labels: ["low", "mid", "high"] }
          Choice { head: "mop route"; siid: 7; piid: 7; current: v.mop_route; labels: ["S", "Y"] }

          Column {
            gap: 6
            fill: width
            Row {
              gap: 6
              fill: width
              Text { text: "suction"; style: label; color: accent; weight: 1; maxLines: 1 }
              if askProp == "7-5" && v.suction != askVal {
                Canvas {
                  width: 12
                  height: 12
                  let r = min(width, height) / 2 - 1.5
                  circle(width / 2, height / 2, r, stroke: muted, width: 2)
                  arc(width / 2, height / 2, r, (time * 300) % 360, 90, stroke: accent, width: 2, cap: round)
                }
                Text { text: "saving"; style: label; color: muted; width: 50; align: end; maxLines: 1 }
              }
            }
            Slider {
              value: askProp == "7-5" ? askVal : (v.suction ?? 1)
              min: 0
              max: 3
              step: 1
              color: accent
              fill: width
              onChange: { askProp = "7-5"; askVal = value; askAt = tick; run("python3 $HOME/.cache/omarchy-vacuum/vacuum.py prop 7 5 ${int(value)}") }
            }
            Row {
              gap: 4
              fill: width
              Text { text: "silent"; style: label; weight: 1 }
              Text { text: "standard"; style: label; weight: 1; align: center }
              Text { text: "medium"; style: label; weight: 1; align: center }
              Text { text: "turbo"; style: label; weight: 1; align: end }
            }
          }

          Rule { }

          Column {
            gap: 6
            fill: width
            Text { text: "this clean"; style: label; color: accent }
            Row {
              gap: 10
              fill: width
              Info { name: "time"; value: v.minutes > 0 ? "${v.minutes} min" : "not yet" }
              Info { name: "area"; value: "${v.area} m2" }
              Info { name: "pattern"; value: v.sweep_text }
            }
          }

          Column {
            gap: 6
            fill: width
            Text { text: "consumables"; style: label; color: accent }
            Row {
              gap: 8
              fill: width
              Consumable { name: "side"; value: v.consumables.side_brush }
              Consumable { name: "main"; value: v.consumables.main_brush }
              Consumable { name: "filter"; value: v.consumables.filter }
              Consumable { name: "mop"; value: v.consumables.mop }
            }
          }
        }
      }
    }
  }
}
