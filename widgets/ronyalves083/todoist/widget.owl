      languageHelp: "La lingua segue Omalauncher; in mancanza di una traduzione viene usato l'inglese.",
      menu: "Menu azioni",
      filterLanguageHelp: "Scrivi i nuovi filtri in italiano, ad esempio oggi | scadute.",
      filterDocumentation: "Guida ai filtri ↗",
      priority: "Priorità",
      shortcutNameHint: "Nome scorciatoia (opzionale)",
      saveShortcut: "Salva scorciatoia",
      shortcutRemoved: "Scorciatoia rimossa.",
