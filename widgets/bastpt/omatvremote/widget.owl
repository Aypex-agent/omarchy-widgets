cat > "$H/androidtvremote2/voice_stream.py" <<'OMATV_LIB_11'
'''High-level voice streaming session wrapper.'''

from __future__ import annotations

from typing import TYPE_CHECKING

from androidtvremote2.const import LOGGER

if TYPE_CHECKING:
    from types import TracebackType

    from androidtvremote2.remote import RemoteProtocol


class VoiceStream:
    '''High-level voice streaming session wrapper.

    Obtained from AndroidTVRemote.start_voice().
    '''

    def __init__(self, proto: RemoteProtocol, session_id: int) -> None:
        '''Initialize.

        param proto: RemoteProtocol instance.
        param session_id: voice session id.
        '''
        self._proto = proto
        self.session_id = session_id
        self._closed = False

    def send_chunk(self, chunk: bytes) -> bool:
        '''Send a chunk of audio data.

        - The audio data must be 16-bit PCM, mono, 8000 Hz.
        - The chunk size should be at least 8 KB. Smaller chunks will be padded with zeros.
        - Chunk sizes larger than 20 KB will be split into multiple chunks.

        :param chunk: The PCM audio data chunk to be sent. Should be a multiple of 8 KB.
        :return: False if a voice session is closed.
        :raises ConnectionClosed: If the connection is lost.
        '''
        if self._closed:
            LOGGER.debug("VoiceStream already closed")
            return False
        self._proto.send_voice_chunk(chunk, self.session_id)
        return True

    def end(self) -> None:
        '''End the voice stream.'''
        if not self._closed:
            self._proto.end_voice(self.session_id)
            self._closed = True

    async def __aenter__(self) -> VoiceStream:
        '''Enter async context manager.'''
        return self

    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None:
        '''End the asynchronous context manager session.

        This method implements the asynchronous exit for a context manager. It is called
        when execution leaves the `async with` block that the instance of the class
        is managing.

        :param exc_type: The exception type raised within the context block if an exception occurred.
        :param exc: The exception object raised within the context block if an exception was raised.
        :param tb: The traceback object associated with the raised exception, if any.
        '''
        self.end()
OMATV_LIB_11
python3 - "$H/tick.wav" <<'OMATV_TICK_PY'
import math
import struct
import sys
import wave

rate = 22050
count = int(rate * 0.028)
frames = bytearray()
for i in range(count):
    t = i / rate
    env = min(1.0, i / (rate * 0.002)) * math.exp(-t * 190)
    value = int(24000 * env * math.sin(2 * math.pi * 1760 * t))
    frames += struct.pack("<h", max(-32768, min(32767, value)))
with wave.open(sys.argv[1], "wb") as out:
    out.setnchannels(1)
    out.setsampwidth(2)
    out.setframerate(rate)
    out.writeframes(bytes(frames))
OMATV_TICK_PY
printf f52ca6c94368 > "$H/tag"
python3 "$H/tvremote.py" stop >/dev/null 2>&1
    """)
  }

  // The last line the daemon logged. Its first word says which kind it is: sent and failed are a
  // key that went out or one that didn't, and anything else is the daemon's own business — it
  // letting go of the TV, say — worth seeing but not dressed up as a key press. A typed text is
  // named but never repeated, since it can be a password typed into a box on the TV.
  source lg = cmd("""
    L=$HOME/.local/share/omatvremote/log
    [ -f "$L" ] || exit
    l=$(tail -n 200 "$L" | grep -v '^[[:space:]]*$' | tail -1)
    v=${l#* }  # the time the daemon writes first is not part of the message
    case "$v" in
      "sent "*)   m=ok;;
      "failed "*) m=err;;
      *)          m=note;;
    esac
    case "$v" in *"text '"*) v=${v%%"text '"*}"text (hidden)";; esac
    printf '%s|%s' "$m" "$(printf %s "$v" | tr '|' '/')"
  """) every 4s optional

  // A new app or a wake-up says whatever was playing before has stopped, and the play key goes
  // back to pointing at play.
  on st { play = false }

  let stat = trim(st) ?? ""
  let mode = split(stat, "|")[0]
  let app = split(stat, "|")[1] ?? ""
  let pairing = mode == "code"
  let paired = mode == "on" || mode == "off" || mode == "asleep" || mode == "waiting"
  // Whether the TV is there to be driven. Asleep and out of reach answer no key at all, so the
  // remote says so and lets the keys go quiet rather than light up over a TV that isn't listening.
  let live = mode == "on" || mode == "off"
  let parts = split(app, ".")
  let last = count(parts) > 0 ? parts[count(parts) - 1] : app
  let short = app == "com.google.android.leanbacklauncher" || app == "com.google.android.tvlauncher" || app == "com.google.android.apps.tv.launcherx" ? "the google launcher" : app == "com.spocky.projengmenu" ? "projectivy" : app == "com.google.android.youtube.tv" ? "youtube" : app == "com.netflix.ninja" ? "netflix" : app == "com.amazon.amazonvideo.livingroom" ? "prime video" : app == "com.disney.disneyplus" ? "disney+" : app == "tv.plex.provider.android" ? "plex" : app == "org.xbmc.kodi" ? "kodi" : last

  // One key size for the whole remote, from the view it is drawn on: the widest row is 5.3 keys
  // across in either layout, and the tallest is the full layout's 8.2 rows of them. Whichever
  // binds first sets the key, and the blocks of keys then share whatever height is left over in
  // proportion to their own, so the remote fills the screen instead of leaving a band of it blank
  // at the bottom. Simple needs far less, so its key can be larger.
  let u = clamp(min(((screenWidth ?? 360) - 54) / 5.3, ((screenHeight ?? 640) - 190) / (layout == "simple" ? 6.4 : 8.2)), 42, 86)

  // The tile's own key size, from the tile: five keys and their gaps across its width, and what
  // its height leaves once the line of state above them has taken its share.
  let t = clamp(min(((tileWidth ?? 340) - 24) / 5.64, (tileHeight ?? 170) - 46), 26, 72)

  // The last thing the daemon logged, split into "ok"/"err" and the words after it.
  let lmode = split(lg, "|")[0]
  let lsay = split(lg, "|")[1] ?? ""

  // What the TV is doing, in the few words that fit beside the title.
  let say = pairing ? "send the code above" : mode == "need" ? "setting up" : mode == "unreachable" ? "no answer — pair again" : !paired ? "pair to start" : mode == "on" ? "● " + (short == "" ? "on" : short) : mode == "off" ? "○ awake" : "○ " + mode

  // One key: press is the TV's key name, g says what to draw, obeys is false for the keys a TV
  // only answers when the screen in front asks for them, size is the key's edge in dp, ring
  // outlines a key that has no other reason to be outlined, flip turns the play key's own symbol
  // over with the tap that asks the TV to change what it plays, and hold sends the same key held
  // down when it is pressed long, which is how a TV opens the menu an app keeps off the tap.
  component Key(press, g = "", big = false, hot = false, obeys = true, size = u, ring = 0, flip = false, hold = false) {
    // The key that wakes a TV stays live even while nothing else answers, or a remote that thinks
    // the TV is asleep would be the very reason it stays asleep.
    let awake = live || press == "POWER"
    Box {
      size: big ? size * 1.28 : size
      radius: size * 0.3 * corners
      background: hot ? accent : surface
      border: obeys ? ring : 1
      borderColor: muted
      align: center
      opacity: awake ? 1 : 0.35
      onTap: {
        if awake {
          if feel { haptic() }
          if click { sound("~/.local/share/omatvremote/tick.wav") }
          if flip { play = !play }
          run("sh ~/.local/share/omatvremote/tvkey.sh " + sh("key " + press))
        }
      }
      onLongPress: {
        if hold && awake {
          if feel { haptic() }
          run("sh ~/.local/share/omatvremote/tvkey.sh " + sh("long " + press))
        }
      }
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        let ink = hot ? background : foreground
        if g == "left" || g == "right" || g == "up" || g == "down" {
          // tip one way from the centre, base back the other, the two corners square to it
          let ux = g == "left" ? -1 : g == "right" ? 1 : 0
          let uy = g == "up" ? -1 : g == "down" ? 1 : 0
          path([[cx + ux * d * 0.22, cy + uy * d * 0.22], [cx - ux * d * 0.14 - uy * d * 0.2, cy - uy * d * 0.14 + ux * d * 0.2], [cx - ux * d * 0.14 + uy * d * 0.2, cy - uy * d * 0.14 - ux * d * 0.2]], closed: true, fill: ink)
        } else if g == "ok" {
          circle(cx, cy, d * 0.15, fill: ink)
        } else if g == "play" {
          path([[cx - d * 0.13, cy - d * 0.2], [cx + d * 0.2, cy], [cx - d * 0.13, cy + d * 0.2]], closed: true, fill: ink)
        } else if g == "pause" {
          rect(cx - d * 0.17, cy - d * 0.2, d * 0.11, d * 0.4, radius: d * 0.03, fill: ink)
          rect(cx + d * 0.06, cy - d * 0.2, d * 0.11, d * 0.4, radius: d * 0.03, fill: ink)
        } else if g == "prev" || g == "next" {
          let dir = g == "next" ? 1 : -1
          path([[cx - d * 0.16 * dir, cy - d * 0.17], [cx + d * 0.1 * dir, cy], [cx - d * 0.16 * dir, cy + d * 0.17]], closed: true, fill: ink)
          rect(dir > 0 ? cx + d * 0.14 : cx - d * 0.22, cy - d * 0.17, d * 0.08, d * 0.34, radius: d * 0.03, fill: ink)
        } else if g == "power" {
          // The ring drawn from its own points rather than arc(): arc's sweep reads opposite on the
          // phone to how it renders here, and a ring whose ends are named in coordinates cannot be
          // read either way. Angles are clockwise from 12 o'clock, and the gap is the 100 degrees
          // around it, wide enough that the stem never comes near the stroke.
          let r = d * 0.19
          let pts = map(range(27), i => [cx + r * sin(rad(50 + i * 10)), cy - r * cos(rad(50 + i * 10))])
          path(pts, stroke: ink, width: d * 0.07, cap: round)
          rect(cx - d * 0.038, cy - d * 0.3, d * 0.076, d * 0.2, radius: d * 0.038, fill: ink)
        } else {
          text(g, cx, cy, size: size * (big ? 0.29 : 0.24), align: center, color: ink, bold: hot)
        }
      }
    }
  }

  // The groups the full layout arranges about the transport: volume, and channels with recents.
  component Vol() {
    Column {
      gap: u * 0.09
      align: center
      Key { press: "VOLUME_UP"; g: "vol +" }
      Key { press: "VOLUME_DOWN"; g: "vol −" }
      Key { press: "MUTE"; g: "mute" }
    }
  }

  component Media(grow = false) {
    Column {
      gap: u * 0.11
      weight: grow ? 1 : 0
      align: center
      Row {
        gap: u * 0.14
        Key { press: "MEDIA_PREVIOUS"; g: "prev" }
        Key { press: "MEDIA_PLAY_PAUSE"; g: play ? "pause" : "play"; big: true; flip: true }
        Key { press: "MEDIA_NEXT"; g: "next" }
      }
      Row {
        gap: u * 0.14
        Key { press: "MEDIA_REWIND"; g: "rew" }
        Key { press: "MEDIA_FAST_FORWARD"; g: "ff" }
        Key { press: "INFO"; g: "info"; obeys: false }
      }
    }
  }

  component Chan() {
    Column {
      gap: u * 0.09
      align: center
      Key { press: "CHANNEL_UP"; g: "ch +" }
      Key { press: "CHANNEL_DOWN"; g: "ch −" }
      Key { press: "APP_SWITCH"; g: "apps"; obeys: false }
    }
  }

  // The two strips under the pad in simple: the transport over the volume keys. Mute sits with
  // back and home above, so it isn't repeated here.
  component Strip() {
    Column {
      fill: width
      gap: u * 0.12
      align: center
      Row {
        gap: u * 0.14
        align: center
        justify: center
        Key { press: "MEDIA_REWIND"; g: "rew" }
        Key { press: "MEDIA_PLAY_PAUSE"; g: play ? "pause" : "play"; big: true; flip: true }
        Key { press: "MEDIA_FAST_FORWARD"; g: "ff" }
      }
      Row {
        gap: u * 0.14
        align: center
        justify: center
        Key { press: "VOLUME_UP"; g: "vol +" }
        Key { press: "VOLUME_DOWN"; g: "vol −" }
      }
    }
  }

  // Back, home and mute in one horizontal row under the pad — simple keeps them there.
  component Nav() {
    Row {
      fill: width
      gap: u * 0.14
      align: center
      justify: center
      Key { press: "BACK"; g: "back" }
      Key { press: "HOME"; g: "home" }
      Key { press: "MUTE"; g: "mute" }
    }
  }

  // The tile: what the TV is doing and the five keys worth a tap without opening the rest.
  Column {
    gap: 6
    align: center
    padding: [10, 8]
    Row {
      fill: width
      gap: 6
      align: center
      Text { text: "omatv"; style: muted; maxLines: 1 }
      Spacer { weight: 1 }
      Text { text: say; style: small; color: mode == "on" ? green : muted; maxLines: 1 }
    }
    Row {
      fill: width
      gap: t * 0.16
      align: center
      justify: center
      weight: 1
      Key { press: "POWER"; g: "power"; hot: true; size: t; ring: 1 }
      Key { press: "VOLUME_UP"; g: "vol +"; size: t; ring: 1 }
      Key { press: "VOLUME_DOWN"; g: "vol −"; size: t; ring: 1 }
      Key { press: "MEDIA_PLAY_PAUSE"; g: play ? "pause" : "play"; size: t; ring: 1; flip: true }
      Key { press: "MUTE"; g: "mute"; size: t; ring: 1 }
    }
  }

  screen {
    title: "omatv remote"
    Column {
      fill: true
      gap: 6
      padding: [12, 10]
      scroll: true

      // What the TV is doing and power, on one line, so the pad starts near the top; the frame
      // already carries the name.
      Row {
        fill: width
        gap: 10
        align: center
        Text { text: say; style: small; color: mode == "on" ? green : muted; weight: 1; maxLines: 1 }
        Key { press: "POWER"; g: "power"; big: true; hot: true }
      }

      // Proof that a tap left the phone, and the TV's answer when it did not. A tap on it reads the log.
      if lg != "" {
        Row {
          fill: width
          align: center
          Text { text: lsay; style: small; color: lmode == "ok" ? green : lmode == "err" ? red : muted; weight: 1; maxLines: 1; onTap: terminal("tail -12 ~/.local/share/omatvremote/log", "omatv log") }
        }
      }

      Row {
        fill: width
        gap: 8
        align: center
        if pairing {
          Input { placeholder: "the code on the TV"; clear: true; weight: 1; onSubmit: run("python3 ~/.local/share/omatvremote/tvremote.py code " + sh(value)) }
        } else {
          Input { placeholder: "the TV's address"; text: tv; clear: false; weight: 1; onSubmit: tv = trim(value) }
          Text { text: "[ pair ]"; color: accent; onTap: { if tv != "" { run("sh ~/.local/share/omatvremote/tvpair.sh " + sh(tv)) } } }
        }
      }

      // The hint is only worth its lines while there is something left to do.
      if !paired {
        Text { text: pairing ? "the TV shows a code — send it above" : "the TV's address (Settings › Remote in the store remote app), then pair: it shows a code on screen, and this asks for it"; style: small; color: muted; maxLines: 2 }
      }

      Row {
        fill: width
        gap: 12
        align: center
        for k in ["simple", "full"] {
          Text { text: k; style: small; color: layout == k ? accent : muted; bold: layout == k; maxLines: 1; onTap: { layout = k; haptic() } }
        }
        if layout == "full" {
          for k in ["vol left", "vol right"] {
            Text { text: k == "vol left" ? "vol L" : "vol R"; style: small; color: grip == k ? accent : muted; bold: grip == k; maxLines: 1; onTap: { grip = k; haptic() } }
          }
        }
        Spacer { weight: 1 }
        Text { text: feel ? "● buzz" : "○ buzz"; style: small; color: feel ? accent : muted; maxLines: 1; onTap: { feel = !feel; haptic() } }
        Text { text: click ? "● click" : "○ click"; style: small; color: click ? accent : muted; maxLines: 1; onTap: { click = !click; sound("~/.local/share/omatvremote/tick.wav") } }
      }

      if layout != "full" {
        // Simple centres the pad, with back, home and mute in a row under it and its two strips of
        // keys below those; the whole block sits together in the middle of what the screen leaves.
        Column {
          fill: width
          gap: u * 0.12
          weight: 1
          align: center
          justify: center
          Column {
            gap: u * 0.09
            align: center
            Key { press: "DPAD_UP"; g: "up" }
            Row {
              gap: u * 0.09
              align: center
              Key { press: "DPAD_LEFT"; g: "left" }
              Key { press: "DPAD_CENTER"; g: "ok"; big: true; hot: true; hold: true }
              Key { press: "DPAD_RIGHT"; g: "right" }
            }
            Key { press: "DPAD_DOWN"; g: "down" }
          }
          Nav { }
          Strip { }
        }
      } else {
        // The pad, with back, home, menu and search beside it rather than below it. The two blocks
        // of keys take what the screen leaves over, so the spare height sits around them, not in the
        // thin rows of text above.
        Row {
          fill: width
          gap: 10
          weight: 3.5
          align: center
          Spacer { weight: 1 }
          Column {
            gap: u * 0.09
            align: center
            Key { press: "DPAD_UP"; g: "up" }
            Row {
              gap: u * 0.09
              align: center
              Key { press: "DPAD_LEFT"; g: "left" }
              Key { press: "DPAD_CENTER"; g: "ok"; big: true; hot: true; hold: true }
              Key { press: "DPAD_RIGHT"; g: "right" }
            }
            Key { press: "DPAD_DOWN"; g: "down" }
          }
          Column {
            gap: u * 0.09
            Key { press: "BACK"; g: "back" }
            Key { press: "HOME"; g: "home" }
          }
          Column {
            gap: u * 0.09
            Key { press: "MENU"; g: "menu"; obeys: false }
            Key { press: "SEARCH"; g: "search"; obeys: false }
          }
          Spacer { weight: 1 }
        }

        if grip == "vol right" {
          Row {
            fill: width
            gap: u * 0.14
            weight: 5.5
            align: center
            Chan { }
            Media { grow: true }
            Vol { }
          }
        } else {
          Row {
            fill: width
            gap: u * 0.14
            weight: 3.2
            align: center
            Vol { }
            Media { grow: true }
            Chan { }
          }
        }
      }

      // Text lands in whichever box on the TV has the cursor — a search field, a password. With no
      // such box open the TV takes the message and shows nothing at all, so say so on the row.
      Row {
        fill: width
        gap: 8
        align: center
        opacity: live ? 1 : 0.35
        Text { text: "text"; color: muted; width: 40 }
        Input { placeholder: "needs a box open on the TV"; text: typed; onChange: typed = value; weight: 1; onSubmit: { if live { run("sh ~/.local/share/omatvremote/tvkey.sh " + sh("text " + value)); typed = "" } } }
        Text { text: "[ send ]"; color: accent; onTap: { if live && trim(typed) != "" { run("sh ~/.local/share/omatvremote/tvkey.sh " + sh("text " + typed)); typed = "" } } }
      }

      Row {
        fill: width
        gap: 10
        align: center
        Text { text: live ? "hold ok = menu" : ""; style: small; color: muted; weight: 0; maxLines: 1 }
        Text { text: live ? (short == "" ? "outlined keys depend on the app" : short + " ignores outlined") : mode == "asleep" ? "asleep — only power answers" : mode == "waiting" ? "asking the TV…" : paired ? "out of reach — the keys are off" : "the keys wake once a TV is paired"; style: small; color: muted; weight: 1; maxLines: 1 }
        Text { text: feel ? "" : "buzz needs the phone's own touch feedback on"; style: small; color: muted; weight: 0; maxLines: 1 }
      }
    }
  }
}
