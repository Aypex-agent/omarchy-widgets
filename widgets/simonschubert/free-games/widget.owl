widget "free games" {
  meta { description: "Games free to keep on the Epic Games Store right now and the ones coming next"; version: "1.4"; license: "MIT"; category: "games"; owl: 16 }

  // What it says, in the phone's language where it has a set. Game titles come as Epic names them.
  strings {
    en { title: "free games · epic"; nothing: "nothing free right now"; freeFor: d => "free for ${d}"; next: "next" }
    id { title: "game gratis · epic"; nothing: "belum ada yang gratis"; freeFor: d => "gratis selama ${d}"; next: "berikutnya" }
    es { title: "juegos gratis · epic"; nothing: "nada gratis por ahora"; freeFor: d => "gratis por ${d}"; next: "próximos" }
    pt { title: "jogos grátis · epic"; nothing: "nada grátis agora"; freeFor: d => "grátis por ${d}"; next: "próximos" }
    de { title: "gratis-spiele · epic"; nothing: "gerade nichts gratis"; freeFor: d => "noch ${d} gratis"; next: "demnächst" }
    zh { title: "免费游戏 · epic"; nothing: "现在没有免费游戏"; freeFor: d => "还剩 ${d} 免费"; next: "即将免费" }
  }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // A free giveaway is a promotion with a 0% price.
  source games = cmd("""
    curl -fsm 12 'https://store-site-backend-static.ak.epicgames.com/freeGamesPromotions?locale=en-US&country=US' | jq -c '
      def free(o; state): [(o // [])[].promotionalOffers[] | select(.discountSetting.discountPercentage == 0)
        | {state: state, from: (.startDate | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601), until: (.endDate | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)}];
      [.data.Catalog.searchStore.elements[] | . as $g
        | (free(.promotions.promotionalOffers; "now") + free(.promotions.upcomingPromotionalOffers; "next"))[]
        | . + {title: $g.title, url: "https://store.epicgames.com/p/\(($g.catalogNs.mappings // [])[0].pageSlug // $g.productSlug // $g.urlSlug)"}
      ] | sort_by(.state != "now", .until)'
  """) every 1h json timeout 20s
  source now = clock every 60s
  let live = games.filter(g => g.state == "now" && g.until > now)
  let soon = games.filter(g => g.state == "next" && g.from > now)

  onTap: url("https://store.epicgames.com/free-games")

  Column {
    gap: 4
    Text { text: str.title; style: muted }
    Column {
      scroll: true
      weight: 1
      gap: 6
      if live != null && len(live) == 0 { Text { text: str.nothing; style: small } }
      for g in live key g.url {
        Column {
          gap: 0
          onTap: url(g.url)
          Text { text: g.title; fontSize: 14; bold: true; color: green; maxLines: 1 }
          Text { text: str.freeFor(fmtDuration(g.until - now)); fontSize: 11; color: muted }
        }
      }
      if len(soon) > 0 {
        Text { text: str.next; style: label }
        for g in soon key g.url {
          Row {
            onTap: url(g.url)
            Text { text: g.title; fontSize: 12; maxLines: 1; weight: 1 }
            Text { text: fmtTime(g.from, "EEE d MMM"); fontSize: 11; color: muted; width: 80; align: end }
          }
        }
      }
    }
  }
}
