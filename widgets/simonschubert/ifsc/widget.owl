widget "ifsc" {
  meta {
    owl: 17
    description: "IFSC Climbing World Cup: the next event with a countdown, the latest podiums, live results and the cup standings for boulder, lead and speed. Tap for everything"
    version: "1.4"
    license: "MIT"
    category: "sport"
  }
  // What it says, in the phone's language where it has a set. Events, climbers, disciplines (boulder, lead,
  // speed), categories and round names come as ifsc.results.info writes them. dotLive sits in 60dp, the
  // countdown in 64dp.
  strings {
    en {
      live: "live"; dotLive: "● live"; next: n => "next · ${n}"; nowAt: n => "now · ${n}"; lastAt: n => "last · ${n}"; seasonOver: "season over"
      cupLeaders: "cup leaders"; loading: "loading…"; noResults: "no results yet"; noStandings: "no standings yet"; results: "results"
      standings: "standings"; calendar: "calendar"; final: "final"; fullResults: "full results on ifsc.results.info"; close: "close"
      pts: p => "${p} pts"; now: "now"; inDays: n => "in ${n}d"; inTime: d => "in ${d}"
    }
    id {
      live: "live"; dotLive: "● live"; next: n => "berikutnya · ${n}"; nowAt: n => "kini · ${n}"; lastAt: n => "terakhir · ${n}"; seasonOver: "musim sudah selesai"
      cupLeaders: "pemimpin piala"; loading: "memuat…"; noResults: "belum ada hasil"; noStandings: "belum ada klasemen"; results: "hasil"
      standings: "klasemen"; calendar: "kalender"; final: "selesai"; fullResults: "hasil lengkap di ifsc.results.info"; close: "tutup"
      pts: p => "${p} poin"; now: "kini"; inDays: n => "${n}h lagi"; inTime: d => "${d} lagi"
    }
    es {
      live: "en vivo"; dotLive: "● en vivo"; next: n => "próximo · ${n}"; nowAt: n => "ahora · ${n}"; lastAt: n => "último · ${n}"; seasonOver: "temporada terminada"
      cupLeaders: "líderes de la copa"; loading: "cargando…"; noResults: "aún no hay resultados"; noStandings: "aún no hay clasificación"; results: "resultados"
      standings: "clasificación"; calendar: "calendario"; final: "finalizado"; fullResults: "resultados completos en ifsc.results.info"; close: "cerrar"
      pts: p => "${p} pts"; now: "ahora"; inDays: n => "en ${n} d"; inTime: d => "en ${d}"
    }
    pt {
      live: "ao vivo"; dotLive: "● ao vivo"; next: n => "próxima · ${n}"; nowAt: n => "agora · ${n}"; lastAt: n => "última · ${n}"; seasonOver: "temporada encerrada"
      cupLeaders: "líderes da copa"; loading: "carregando…"; noResults: "ainda sem resultados"; noStandings: "ainda sem classificação"; results: "resultados"
      standings: "classificação"; calendar: "calendário"; final: "encerrado"; fullResults: "resultados completos em ifsc.results.info"; close: "fechar"
      pts: p => "${p} pts"; now: "agora"; inDays: n => "em ${n} d"; inTime: d => "em ${d}"
    }
    de {
      live: "live"; dotLive: "● live"; next: n => "nächstes · ${n}"; nowAt: n => "jetzt · ${n}"; lastAt: n => "zuletzt · ${n}"; seasonOver: "saison vorbei"
      cupLeaders: "weltcup-spitze"; loading: "lädt…"; noResults: "noch keine ergebnisse"; noStandings: "noch keine wertung"; results: "ergebnisse"
      standings: "wertung"; calendar: "kalender"; final: "beendet"; fullResults: "alle ergebnisse auf ifsc.results.info"; close: "schließen"
      pts: p => "${p} pkt"; now: "jetzt"; inDays: n => "in ${n} tg"; inTime: d => "in ${d}"
    }
    zh {
      live: "直播中"; dotLive: "● 直播中"; next: n => "下一站 · ${n}"; nowAt: n => "进行中 · ${n}"; lastAt: n => "上一站 · ${n}"; seasonOver: "赛季已结束"
      cupLeaders: "积分领先"; loading: "正在加载…"; noResults: "暂无成绩"; noStandings: "暂无排名"; results: "成绩"
      standings: "排名"; calendar: "赛历"; final: "已结束"; fullResults: "在 ifsc.results.info 查看完整成绩"; close: "关闭"
      pts: p => "${p} 分"; now: "现在"; inDays: n => "${n} 天后"; inTime: d => "${d} 后"
    }
    ru {
      live: "в эфире"; dotLive: "● идёт"; next: n => "далее · ${n}"; nowAt: n => "сейчас · ${n}"; lastAt: n => "последний · ${n}"; seasonOver: "сезон окончен"
      cupLeaders: "лидеры кубка"; loading: "загрузка…"; noResults: "результатов пока нет"; noStandings: "зачёта пока нет"; results: "результаты"
      standings: "зачёт"; calendar: "календарь"; final: "итог"; fullResults: "все результаты на ifsc.results.info"; close: "закрыть"
      pts: p => "${p} очк."; now: "сейчас"; inDays: n => "через ${n} д"; inTime: d => "через ${d}"
    }
    ja {
      live: "ライブ"; dotLive: "● ライブ"; next: n => "次 · ${n}"; nowAt: n => "開催中 · ${n}"; lastAt: n => "前回 · ${n}"; seasonOver: "シーズン終了"
      cupLeaders: "ランキング上位"; loading: "読み込み中…"; noResults: "まだ結果がありません"; noStandings: "まだランキングがありません"; results: "結果"
      standings: "ランキング"; calendar: "日程"; final: "確定"; fullResults: "ifsc.results.info で全結果を見る"; close: "閉じる"
      pts: p => "${p} pt"; now: "今"; inDays: n => "${n} 日後"; inTime: d => "${d} 後"
    }
    uk {
      live: "наживо"; dotLive: "● наживо"; next: n => "далі · ${n}"; nowAt: n => "зараз · ${n}"; lastAt: n => "останній · ${n}"; seasonOver: "сезон завершено"
      cupLeaders: "лідери кубка"; loading: "завантаження…"; noResults: "результатів поки немає"; noStandings: "заліку поки немає"; results: "результати"
      standings: "залік"; calendar: "календар"; final: "підсумок"; fullResults: "усі результати на ifsc.results.info"; close: "закрити"
      pts: p => "${p} бал."; now: "зараз"; inDays: n => "через ${n} д"; inTime: d => "через ${d}"
    }
    fr {
      live: "en direct"; dotLive: "● direct"; next: n => "prochaine · ${n}"; nowAt: n => "en cours · ${n}"; lastAt: n => "dernière · ${n}"; seasonOver: "saison terminée"
      cupLeaders: "en tête de la coupe"; loading: "chargement…"; noResults: "pas encore de résultats"; noStandings: "pas encore de classement"; results: "résultats"
      standings: "classement"; calendar: "calendrier"; final: "terminé"; fullResults: "tous les résultats sur ifsc.results.info"; close: "fermer"
      pts: p => "${p} pts"; now: "maint."; inDays: n => "dans ${n} j"; inTime: d => "dans ${d}"
    }
    tr {
      live: "canlı"; dotLive: "● canlı"; next: n => "sıradaki · ${n}"; nowAt: n => "şimdi · ${n}"; lastAt: n => "son · ${n}"; seasonOver: "sezon bitti"
      cupLeaders: "kupa liderleri"; loading: "yükleniyor…"; noResults: "henüz sonuç yok"; noStandings: "henüz sıralama yok"; results: "sonuçlar"
      standings: "sıralama"; calendar: "takvim"; final: "bitti"; fullResults: "tüm sonuçlar: ifsc.results.info"; close: "kapat"
      pts: p => "${p} puan"; now: "şimdi"; inDays: n => "${n} g sonra"; inTime: d => "${d} sonra"
    }
    it {
      live: "live"; dotLive: "● live"; next: n => "prossima · ${n}"; nowAt: n => "in corso · ${n}"; lastAt: n => "ultima · ${n}"; seasonOver: "stagione finita"
      cupLeaders: "in testa alla coppa"; loading: "caricamento…"; noResults: "ancora nessun risultato"; noStandings: "ancora nessuna classifica"; results: "risultati"
      standings: "classifica"; calendar: "calendario"; final: "concluso"; fullResults: "tutti i risultati su ifsc.results.info"; close: "chiudi"
      pts: p => "${p} pt"; now: "ora"; inDays: n => "tra ${n} g"; inTime: d => "tra ${d}"
    }
  }
  size: 6x4
  minSize: 3x3

  source now = clock every 1m

  // ifsc.results.info, straight from Android (it only wants a Referer). The API's root names the
  // current season, the season lists every event (the World Cups are league 1), the latest event
  // that has started lists its categories, and each category's results come on their own. Its
  // season-league endpoint now wants a login, so the calendar comes from the season itself.
  let api = "https://ifsc.results.info/api/v1"
  let hdr = {Referer: "https://ifsc.results.info/"}
  source root = http("https://ifsc.results.info/api/v1/", hdr) every 12h json timeout 15s
  source sea = http(root == null ? null : "${api}/seasons/${enc(root.current.id)}", hdr) every 10m json timeout 20s

  let season = root.current.season
  let league = last(split(root.current.leagues.find(l => l.league_id == 1).url ?? "", "/"))
  let wc = (sea.events ?? []).filter(e => str(e.league_season_id) == league)
  let events = wc.map(e => {
    id: e.event_id,
    name: match(e.event, "^(?:World Climbing Series |IFSC Climbing World Cup |IFSC World Cup |IFSC )?(.*?)(?: [0-9]{4})?$")[0] ?? e.event,
    full: e.event,
    start: parseTime(replace(replace(e.starts_at ?? "", " UTC", "Z"), " ", "T")),
    end: parseTime(replace(replace(e.ends_at ?? "", " UTC", "Z"), " ", "T")),
    dates: e.local_start_date == e.local_end_date ? fmtTime(parseTime(e.local_start_date), "d MMM")
      : "${fmtTime(parseTime(e.local_start_date), "d MMM")} – ${fmtTime(parseTime(e.local_end_date), "d MMM")}",
    kinds: unique((e.disciplines ?? []).map(d => d.kind).filter(k => !contains(k, "relay")))
  }).map(e => merge(e, {state: now >= e.end ? "done" : now >= e.start ? "live" : "next"})).sortBy(e => e.start)

  // The latest event that has started, its categories (relays left out), and the top 8 of each,
  // with each climber's score from the last round they climbed.
  let lat = last(events.filter(e => e.state != "next"))
  source ev = http(lat == null ? null : "${api}/events/${enc(lat.id)}", hdr) every 10m json timeout 20s
  let cats = ev.id == lat.id ? (ev.d_cats ?? []).filter(c => !contains(c.dcat_name ?? "", "RELAY")) : []
  source r0 = http(cats[0] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[0].dcat_id)}", hdr) every 10m json timeout 20s
  source r1 = http(cats[1] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[1].dcat_id)}", hdr) every 10m json timeout 20s
  source r2 = http(cats[2] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[2].dcat_id)}", hdr) every 10m json timeout 20s
  source r3 = http(cats[3] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[3].dcat_id)}", hdr) every 10m json timeout 20s
  source r4 = http(cats[4] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[4].dcat_id)}", hdr) every 10m json timeout 20s
  source r5 = http(cats[5] == null ? null : "${api}/events/${enc(lat.id)}/result/${enc(cats[5].dcat_id)}", hdr) every 10m json timeout 20s
  // A slot whose category went away keeps its last value, so only this event's categories count.
  let results = [r0, r1, r2, r3, r4, r5].filter(r => r != null && r.event == lat.full && any(cats, c => c.dcat_name == r.dcat)).map(r => {
    name: r.dcat, short: "${lower(split(r.dcat, " ")[0])} ${sub(split(r.dcat, " ")[1] ?? "", 0, 1)}",
    kind: lower(split(r.dcat, " ")[0]), status: r.status,
    round: last((r.category_rounds ?? []).filter(x => x.status != null && x.status != "pending")).name,
    top: take(r.ranking ?? [], 8).map(a => {
      rank: a.rank, name: "${a.firstname} ${a.lastname}", country: a.country,
      score: split(str(last((a.rounds ?? []).filter(x => x.score != null && x.score != "")).score ?? ""), " (")[0]
    })
  }).filter(c => count(c.top) > 0)
  let finished = count(cats) > 0 && all(cats, c => c.status == "finished")
  let latest = lat == null ? null : merge(lat, {results: results, state: finished ? "done" : lat.state})

  // Cup standings, top 10 of each Olympic discipline.
  let cupId = first(wc.filter(e => e.cup_id != null)).cup_id
  source cupInfo = http(cupId == null ? null : "${api}/cups/${enc(cupId)}", hdr) every 12h json timeout 20s
  let cupCats = (cupInfo.d_cats ?? []).filter(c => match(c.name ?? "", "^(BOULDER|LEAD|SPEED) (Men|Women)$") != null)
  source c0 = http(cupCats[0] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[0].id)}", hdr) every 1h json timeout 20s
  source c1 = http(cupCats[1] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[1].id)}", hdr) every 1h json timeout 20s
  source c2 = http(cupCats[2] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[2].id)}", hdr) every 1h json timeout 20s
  source c3 = http(cupCats[3] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[3].id)}", hdr) every 1h json timeout 20s
  source c4 = http(cupCats[4] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[4].id)}", hdr) every 1h json timeout 20s
  source c5 = http(cupCats[5] == null ? null : "${api}/cups/${enc(cupId)}/dcat/${enc(cupCats[5].id)}", hdr) every 1h json timeout 20s
  let standings = [c0, c1, c2, c3, c4, c5].filter(c => c != null && count(c.ranking ?? []) > 0).map(c => {
    name: c.dcat_name, short: "${lower(split(c.dcat_name, " ")[0])} ${sub(split(c.dcat_name, " ")[1] ?? "", 0, 1)}",
    kind: lower(split(c.dcat_name, " ")[0]),
    top: take(c.ranking, 10).map(a => {
      rank: a.rank, name: "${a.firstname} ${a.lastname}", country: a.country,
      score: num(a.score, null) != null && num(a.score, 0) == floor(num(a.score, 0)) ? str(floor(num(a.score, 0))) : a.score
    })
  }).sortBy(s => "${s.kind} ${contains(s.name, "Women") ? 1 : 0}")

  state tab = "results"
  state pick = 0

  let live = latest.state == "live"
  let upcoming = events.filter(e => e.state == "next")
  let next = first(upcoming)
  let wide = (tileWidth ?? 0) >= 300
  // Lines below the divider: the latest winners first, then cup leaders if 2+ fit.
  let slots = max(2, (rows ?? 4) * 2 - 1)
  let shown = results.take(slots)
  let spare = slots - count(shown) - 1
  let leaders = spare >= 2 ? standings.take(spare) : []


  component Until(t, tint = foreground, fs = 12) {
    Text {
      text: t - now > 86400 ? str.inDays(ceil((t - now) / 86400)) : t > now ? str.inTime(fmtDuration(t - now)) : str.now
      fontSize: fs; width: 64; align: end; color: tint; maxLines: 1
    }
  }

  component Flag(code, px = 14) {
    if code {
      Image { src: "https://d1n1qj9geboqnb.cloudfront.net/flags/${enc(code)}.png"; width: px * 1.5; height: px; fit: contain }
    } else {
      Box { width: px * 1.5; height: px }
    }
  }

  component Kinds(list) {
    Row {
      gap: 4
      for k in list ?? [] {
        Text { text: k; style: label; width: len(k) * 7 + 14; align: center; color: (k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent); padding: [5, 1]; border: 1; borderColor: alpha((k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent), 0.5) }
      }
    }
  }

  component Athlete(a, showScore = true) {
    Row {
      gap: 6
      align: center
      Text { text: a.rank; width: 18; style: small; align: end; bold: a.rank <= 3; color: a.rank == 1 ? yellow : a.rank == 2 ? foreground : a.rank == 3 ? orange : muted }
      Flag { code: a.country }
      Text { text: a.name; style: small; weight: 1; maxLines: 1 }
      if showScore {
        Text { text: a.score ?? ""; style: small; width: 64; align: end; color: muted; maxLines: 1 }
      }
    }
  }

  // One category's winner on the tile.
  component Winner(c) {
    let w = c.top[0]
    Row {
      gap: 6
      align: center
      Text { text: c.short; style: small; width: wide ? 72 : 60; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); maxLines: 1 }
      Flag { code: w.country }
      Text { text: w.name; style: small; weight: 1; maxLines: 1 }
      if wide {
        Text {
          text: c.status == null ? str.pts(w.score) : c.status == "finished" ? (w.score ?? "") : (c.round ?? str.live)
          style: small; width: 72; align: end; color: c.status == null || c.status == "finished" ? muted : accent; maxLines: 1
        }
      }
    }
  }

  component EventRow(e) {
    Row {
      gap: 8
      align: center
      Box { width: 3; height: 30; radius: 1.5; background: e.state == "live" ? accent : e.state == "next" ? alpha(foreground, 0.6) : alpha(muted, 0.4) }
      Column {
        gap: 0
        weight: 1
        Text { text: e.name; style: body; maxLines: 1; color: e.state == "done" ? muted : foreground }
        Text { text: e.dates; style: small; color: muted; maxLines: 1 }
      }
      Kinds { list: e.kinds }
      if e.state == "next" {
        Until { t: e.start }
      } else {
        Text { text: e.state == "live" ? str.live : "✓"; style: small; width: 64; align: end; color: e.state == "live" ? accent : muted }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "IFSC World Cup"; style: title; weight: 1; maxLines: 1 }
      Text { text: live ? str.dotLive : season ?? ""; style: small; width: 60; align: end; color: live ? accent : muted; bold: live }
    }

    // The next event (or the live one) up top.
    if live {
      Row {
        gap: 8; align: center
        Text { text: latest.name; style: body; weight: 1; maxLines: 1; color: accent }
        Kinds { list: latest.kinds }
      }
    } else if next != null {
      Row {
        gap: 8; align: center
        Column {
          gap: 0; weight: 1
          Text { text: str.next(next.name); style: body; maxLines: 1 }
          Text { text: next.dates; style: small; color: muted; maxLines: 1 }
        }
        if wide { Kinds { list: next.kinds } }
        Until { t: next.start; tint: accent; fs: 15 }
      }
    } else if sea != null {
      Text { text: str.seasonOver; style: small; color: muted }
    }

    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }

    if latest != null {
      Text { text: live ? str.nowAt(latest.name) : str.lastAt(latest.name); style: label; color: muted; maxLines: 1 }
      Column {
        gap: 3
        for c in shown { Winner { c: c } }
      }
      if count(leaders) > 0 {
        Spacer { height: 4 }
        Text { text: str.cupLeaders; style: label; color: muted; maxLines: 1 }
        Column {
          gap: 3
          for c in leaders { Winner { c: c } }
        }
      }
    } else {
      Text { text: sea == null ? str.loading : str.noResults; style: small; color: muted }
    }
  }

  screen {
    title: "IFSC World Cup ${season ?? ''}"
    Column {
      gap: 10
      Row {
        gap: 6
        Button { text: live ? str.live : str.results; weight: 1; color: tab == "results" ? accent : muted; onTap: tab = "results" }
        Button { text: str.standings; weight: 1; color: tab == "cup" ? accent : muted; onTap: { tab = "cup"; pick = 0 } }
        Button { text: str.calendar; weight: 1; color: tab == "calendar" ? accent : muted; onTap: tab = "calendar" }
      }

      Column {
        weight: 1
        scroll: true
        onPull: refresh()
        gap: 6

        if tab == "results" {
          if latest == null {
            Text { text: str.noResults; style: small; color: muted }
          } else {
            Text { text: latest.full; style: title; maxLines: 2 }
            Row {
              gap: 8; align: center
              Text { text: latest.dates; style: small; color: muted; weight: 1 }
              if live { Text { text: str.dotLive; style: small; color: accent; bold: true; width: 60; align: end } }
            }
            for c in results {
              Spacer { height: 6 }
              Row {
                align: center
                Text { text: lower(c.name); style: label; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); weight: 1 }
                Text { text: c.status == "finished" ? str.final : (c.round ?? c.status); style: small; color: c.status == "finished" ? muted : accent; width: 110; align: end; maxLines: 1 }
              }
              for a in c.top key a.name { Athlete { a: a } }
            }
            Spacer { height: 6 }
            Button { text: str.fullResults; onTap: url("https://ifsc.results.info/event/${latest.id}") }
          }
        } else if tab == "cup" {
          Flow {
            gap: 6
            for s, i in standings {
              Button { text: s.short; color: pick == i ? (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) : muted; onTap: pick = i }
            }
          }
          let s = standings[pick]
          if s == null {
            Text { text: cupInfo == null ? str.loading : str.noStandings; style: small; color: muted }
          } else {
            Text { text: lower(s.name); style: title; color: (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) }
            for a in s.top key a.name { Athlete { a: a } }
          }
        } else {
          for e in events key e.id { EventRow { e: e } }
        }
      }

      Button { text: str.close; onTap: close() }
    }
  }
}
