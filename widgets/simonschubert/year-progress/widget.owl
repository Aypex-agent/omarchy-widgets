widget "year progress" {
  meta { description: "How much of today, this week, this month and this year has passed"; version: "1.4"; license: "MIT"; category: "time"; owl: 16 }

  // What the bars are called, in the phone's language where it has a set.
  strings {
    en { day: "day"; week: "week"; month: "month"; year: "year" }
    id { day: "hari"; week: "minggu"; month: "bulan"; year: "tahun" }
    es { day: "día"; week: "semana"; month: "mes"; year: "año" }
    pt { day: "dia"; week: "semana"; month: "mês"; year: "ano" }
    de { day: "tag"; week: "woche"; month: "monat"; year: "jahr" }
    zh { day: "今天"; week: "本周"; month: "本月"; year: "今年" }
  }
  size: 3x3
  minSize: 3x2

  // No shell: everything comes from the clock. Local time is Unix time plus the zone offset.
  source now = clock every 60s
  let tz = fmtTime(now, "xx")
  let local = now + (startsWith(tz, "-") ? -1 : 1) * (num(sub(tz, 1, 3)) * 3600 + num(sub(tz, 3, 5)) * 60)
  let dayP = local % 86400 / 86400
  // 1 January 1970 was a Thursday; 0 is Monday.
  let weekday = floor(local / 86400 + 3) % 7
  let d = num(fmtTime(now, "d"))
  let monthDays = 32 - num(fmtTime(now - (d - 1) * 86400 + 31 * 86400, "d"))
  let y = num(fmtTime(now, "yyyy"))
  let yearDays = y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) ? 366 : 365
  let bars = [
    {id: "day", label: str.day, p: dayP},
    {id: "week", label: str.week, p: (weekday + dayP) / 7},
    {id: "month", label: str.month, p: (d - 1 + dayP) / monthDays},
    {id: "year", label: str.year, p: (num(fmtTime(now, "D")) - 1 + dayP) / yearDays},
  ]

  Column {
    gap: 6
    fill: true
    justify: spaceBetween
    Row {
      align: bottom
      Text { text: "${y}"; style: title; weight: 1 }
      Text { text: "${fixed(bars[3].p * 100, 1)}%"; fontSize: 14; color: accent; width: 64; align: end }
    }
    for b in bars key b.id {
      Column {
        gap: 2
        Row {
          Text { text: b.label; fontSize: 11; color: muted; weight: 1 }
          Text { text: "${floor(b.p * 100)}%"; fontSize: 11; width: 40; align: end }
        }
        Progress { value: b.p * 100; color: b.id == "year" ? accent : foreground; animate value: spring() }
      }
    }
  }
}
