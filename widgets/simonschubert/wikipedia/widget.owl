widget "wikipedia" {
  meta { description: "Wikipedia's featured article of the day, what everyone is reading, and on this day in history"; version: "1.4"; license: "MIT"; category: "news"; owl: 16 }

  // What it says, and which Wikipedia it reads, in the phone's language where it has a set. The feed has no
  // featured article for the other languages' Wikipedias, nor on this day for Indonesian's; those parts stay away.
  strings {
    en { wiki: "en"; featured: "featured article"; mostRead: "most read"; onThisDay: "on this day" }
    id { wiki: "id"; featured: "artikel pilihan"; mostRead: "paling banyak dibaca"; onThisDay: "hari ini dalam sejarah" }
    es { wiki: "es"; featured: "artículo destacado"; mostRead: "lo más leído"; onThisDay: "un día como hoy" }
    pt { wiki: "pt"; featured: "artigo destacado"; mostRead: "mais lidos"; onThisDay: "neste dia" }
    de { wiki: "de"; featured: "artikel des tages"; mostRead: "meistgelesen"; onThisDay: "an diesem tag" }
    zh { wiki: "zh"; featured: "特色条目"; mostRead: "最多阅读"; onThisDay: "历史上的今天" }
  }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  // Wikimedia's daily feed for that language's Wikipedia; only the parts drawn are kept. Chinese comes from
  // zh.wikipedia's own feed, which writes it in Simplified script when asked, titles in their display form: Wikimedia's
  // mixes Simplified and Traditional and drops the linked names from on this day.
  source wp = cmd("set -- ${sh(str.wiki)}; " + """
    feed="https://api.wikimedia.org/feed/v1/wikipedia/$1/featured"
    [ "$1" = zh ] && feed="https://zh.wikipedia.org/api/rest_v1/feed/featured"
    curl -fsm 12 -H 'Accept-Language: zh-hans' "$feed/$(date -u +%Y/%m/%d)" | jq -c --arg wiki "$1" '
    def title: if $wiki == "zh" then (.titles.display // .titles.normalized | gsub("<[^>]*>"; "")) else .titles.normalized end;
    {
      tfa: (.tfa // null | if . then {title: title, text: .extract, url: .content_urls.mobile.page} else null end),
      read: [(.mostread.articles // [])[] | select(.namespace.id == 0) | {title: title, views, url: .content_urls.mobile.page}][:5],
      onthisday: [(.onthisday // [])[:3][] | {year, text}]
    }'
  """) every 1h json timeout 20s

  onTap: url("https://${str.wiki}.m.wikipedia.org")

  component Heading(text) { Text { text: text; style: label; color: accent } }

  Column {
    gap: 4
    Text { text: "wikipedia"; style: muted }
    Column {
      scroll: true
      weight: 1
      gap: 6
      if wp.tfa != null {
        Column {
          gap: 2
          onTap: url(wp.tfa.url)
          Heading { text: str.featured }
          Text { text: wp.tfa.title; style: body; bold: true; maxLines: 2 }
          Text { text: wp.tfa.text; fontSize: 12; color: muted; maxLines: 4 }
        }
      }
      if len(wp.read) > 0 {
        Heading { text: str.mostRead }
        for a in wp.read key a.url {
          Row {
            onTap: url(a.url)
            Text { text: a.title; fontSize: 12; maxLines: 1; weight: 1 }
            Text { text: a.views >= 1000000 ? "${fixed(a.views / 1000000, 1)}M" : "${round(a.views / 1000)}k"; fontSize: 11; color: muted; width: 48; align: end }
          }
        }
      }
      if len(wp.onthisday) > 0 {
        Heading { text: str.onThisDay }
        for e, i in wp.onthisday key i {
          Row {
            align: top
            Text { text: "${e.year}"; fontSize: 12; color: accent; width: 40 }
            Text { text: e.text; fontSize: 12; maxLines: 3; weight: 1 }
          }
        }
      }
    }
  }
}
