widget "countdown" {
  meta { description: "Days until the dates listed in ~/.config/omarchy-proot/countdown, soonest first"; version: "1.2"; license: "MIT"; category: "productivity"; owl: 16 }
  size: 3x3
  minSize: 3x2

  // The days sit in a 64dp column at up to 22sp: a few letters at most.
  strings {
    en { title: "countdown"; today: "today"; days: n => "${n}d" }
    id { title: "hitung mundur"; today: "hari ini"; days: n => "${n}h" }
    es { title: "cuenta regresiva"; today: "hoy"; days: n => "${n}d" }
    pt { title: "contagem regressiva"; today: "hoje"; days: n => "${n}d" }
    de { title: "countdown"; today: "heute"; days: n => "${n}t" }
    zh { title: "倒计时"; today: "今天"; days: n => "${n}天" }
    ru { title: "обратный отсчёт"; today: "сегодня"; days: n => "${n}д" }
    ja { title: "カウントダウン"; today: "今日"; days: n => "${n}日" }
    uk { title: "зворотний відлік"; today: "сьогодні"; days: n => "${n}д" }
    fr { title: "compte à rebours"; today: "auj."; days: n => "${n}j" }
  }

  // "2026-12-24 christmas" per line; the file starts with the next new year.
  // Prints "epoch label" per line and lets the clock do the counting.
  source dates = cmd("""
    f=~/.config/omarchy-proot/countdown
    mkdir -p "${f%/*}"
    [ -f "$f" ] || echo "$(( $(date +%Y) + 1 ))-01-01 new year" > "$f"
    grep -v '^#' "$f" | while read -r day label; do
      t=$(date -d "$day" +%s 2>/dev/null) && echo "$t ${label:-$day}"
    done
  """) every 1h
  source now = clock every 60s
  let events = lines(dates).filter(l => l != "").map(l => { at: num(words(l)[0]), label: sub(l, len(words(l)[0]) + 1) }).filter(e => e.at > now - 86400).sortBy(e => e.at)

  onTap: terminal('$EDITOR ~/.config/omarchy-proot/countdown', "countdown")

  Column {
    gap: 6
    Text { text: str.title; style: muted }
    for e, i in events.take(4) key e.label {
      let days = ceil((e.at - now) / 86400)
      Row {
        align: bottom
        Text { text: days <= 0 ? str.today : str.days(days); fontSize: i == 0 ? 22 : 14; color: i == 0 ? accent : foreground; width: 64 }
        Text { text: e.label; fontSize: 12; maxLines: 1; weight: 1 }
      }
    }
  }
}
