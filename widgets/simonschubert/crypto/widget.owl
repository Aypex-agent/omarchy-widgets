widget "bitcoin" {
  meta { description: "Bitcoin from CoinGecko: price, change over 1 hour, 24 hours and 7 days, the day's range and a 7-day chart. Tap it for market cap, volume, supply and the all-time high"; version: "2.2"; license: "MIT"; category: "finance"; owl: 16 }

  // What it says, in the phone's language where it has a set. Prices stay in US dollars, written the US way.
  strings {
    en {
      busy: "coingecko is busy, retrying"; offline: "coingecko offline"; h1: "1h"; h24: "24h"; d7: "7d"
      hour: "1 hour"; day: "24 hours"; week: "7 days"; last7: "last 7 days"; now: "now"; daysAgo: d => "${d}d"
      market: "market"; cap: "market cap"; today: p => "${p}% today"; volume: "24h volume"; ofCap: p => "${p}% of the cap"
      ath: "all-time high"; rank: "rank"; byCap: "by market cap"; supply: "supply"
      mined: m => "${m}M mined"; of: m => "of ${m}M"; toGo: (p, k) => "${p}% mined, ${k}k btc to go"
      open: "open on coingecko"; updated: t => "data: coingecko · updated ${t} utc"
    }
    id {
      busy: "coingecko sedang sibuk, mencoba lagi"; offline: "coingecko offline"; h1: "1j"; h24: "24j"; d7: "7h"
      hour: "1 jam"; day: "24 jam"; week: "7 hari"; last7: "7 hari terakhir"; now: "kini"; daysAgo: d => "${d}h"
      market: "pasar"; cap: "kapitalisasi pasar"; today: p => "${p}% hari ini"; volume: "volume 24 jam"; ofCap: p => "${p}% dari kapitalisasi"
      ath: "tertinggi sepanjang masa"; rank: "peringkat"; byCap: "menurut kapitalisasi"; supply: "pasokan"
      mined: m => "${m} jt ditambang"; of: m => "dari ${m} jt"; toGo: (p, k) => "${p}% ditambang, ${k} rb btc lagi"
      open: "buka di coingecko"; updated: t => "data: coingecko · diperbarui ${t} utc"
    }
    es {
      busy: "coingecko está ocupado, reintentando"; offline: "coingecko sin conexión"; h1: "1h"; h24: "24h"; d7: "7d"
      hour: "1 hora"; day: "24 horas"; week: "7 días"; last7: "últimos 7 días"; now: "ahora"; daysAgo: d => "${d}d"
      market: "mercado"; cap: "capitalización"; today: p => "${p}% hoy"; volume: "volumen 24h"; ofCap: p => "${p}% de la capitalización"
      ath: "máximo histórico"; rank: "ranking"; byCap: "por capitalización"; supply: "oferta"
      mined: m => "${m}M minados"; of: m => "de ${m}M"; toGo: (p, k) => "${p}% minado, faltan ${k}k btc"
      open: "abrir en coingecko"; updated: t => "datos: coingecko · actualizado ${t} utc"
    }
    pt {
      busy: "coingecko ocupado, tentando de novo"; offline: "coingecko offline"; h1: "1h"; h24: "24h"; d7: "7d"
      hour: "1 hora"; day: "24 horas"; week: "7 dias"; last7: "últimos 7 dias"; now: "agora"; daysAgo: d => "${d}d"
      market: "mercado"; cap: "capitalização"; today: p => "${p}% hoje"; volume: "volume 24h"; ofCap: p => "${p}% da capitalização"
      ath: "máxima histórica"; rank: "ranking"; byCap: "por capitalização"; supply: "oferta"
      mined: m => "${m}M minerados"; of: m => "de ${m}M"; toGo: (p, k) => "${p}% minerado, faltam ${k} mil btc"
      open: "abrir no coingecko"; updated: t => "dados: coingecko · atualizado ${t} utc"
    }
    de {
      busy: "coingecko ist überlastet, gleich nochmal"; offline: "coingecko offline"; h1: "1h"; h24: "24h"; d7: "7d"
      hour: "1 stunde"; day: "24 stunden"; week: "7 tage"; last7: "letzte 7 tage"; now: "jetzt"; daysAgo: d => "${d}d"
      market: "markt"; cap: "marktkap."; today: p => "${p}% heute"; volume: "volumen 24h"; ofCap: p => "${p}% der marktkap."
      ath: "allzeithoch"; rank: "rang"; byCap: "nach marktkap."; supply: "angebot"
      mined: m => "${m}M geschürft"; of: m => "von ${m}M"; toGo: (p, k) => "${p}% geschürft, noch ${k}k btc"
      open: "auf coingecko öffnen"; updated: t => "daten: coingecko · stand ${t} utc"
    }
  }
  size: 3x3
  minSize: 3x2

  source market = http("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin&sparkline=true&price_change_percentage=1h,24h,7d") every 5m timeout 15s json status

  let b = market.ok ? market.out[0] : null
  let week = b.sparkline_in_7d.price ?? []
  let hour = b.price_change_percentage_1h_in_currency
  let day = b.price_change_percentage_24h_in_currency
  let days7 = b.price_change_percentage_7d_in_currency
  // CoinGecko updates the day's low and high less often than the price, so the price can be outside them.
  let low = min(b.low_24h, b.current_price)
  let high = max(b.high_24h, b.current_price)
  let problem = market == null ? "…" : market.code == 429 ? str.busy : b == null ? str.offline : null

  // Whole dollars with thousands separators: $82,612.
  let usd = [b.current_price, low, high, min(week), max(week), b.ath].map(n => n == null ? "…" : [round(n)].map(r =>
    r >= 1000000 ? "$${floor(r / 1000000)},${pad(floor(r / 1000) % 1000, 3, "0")},${pad(r % 1000, 3, "0")}" :
    r >= 1000 ? "$${floor(r / 1000)},${pad(r % 1000, 3, "0")}" : "$${r}")[0])
  let price = usd[0]
  // Trillions and billions: $1.66T, $33.5B.
  let cap = [b.market_cap, b.total_volume].map(n => n == null ? "…" : n >= 1000000000000 ? "$${fixed(n / 1000000000000, 2)}T" : "$${fixed(n / 1000000000, 1)}B")
  let at = high > low ? (b.current_price - low) / (high - low) : 0.5

  onTap: screen()

  component Pct(p, size = 12, right = false) {
    Text { text: p == null ? "…" : "${p >= 0 ? "+" : ""}${fixed(p, 1)}%"; fontSize: size; bold: true; color: p == null ? muted : p >= 0 ? green : red; align: right ? "end" : "start"; maxLines: 1 }
  }

  component Change(label, p, size = 12) {
    Column {
      gap: 0
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Pct { p: p; size: size }
    }
  }

  // Where the price sits between the day's low and high.
  component Range(size = 10) {
    Column {
      gap: 2
      Canvas {
        height: 8
        fill: width
        rect(0, 2.5, width, 3, radius: 1.5, fill: alpha(muted, 0.3))
        rect(0, 2.5, width * at, 3, radius: 1.5, fill: alpha(accent, 0.6))
        circle(width * at, 4, 4, fill: accent)
      }
      Row {
        Text { text: usd[1]; fontSize: size; color: muted; weight: 1; maxLines: 1 }
        Text { text: str.h24; fontSize: size; color: muted; width: 32; align: center; maxLines: 1 }
        Text { text: usd[2]; fontSize: size; color: muted; weight: 1; align: end; maxLines: 1 }
      }
    }
  }

  component Stat(label, value, note, noteColor = muted) {
    Column {
      gap: 0
      padding: [10, 8]
      border: 1
      borderColor: alpha(muted, 0.3)
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Text { text: value; style: body; bold: true; maxLines: 1 }
      Text { text: note; fontSize: 11; color: noteColor; maxLines: 1 }
    }
  }

  Column {
    gap: 4
    Row {
      align: center
      Text { text: "bitcoin"; style: muted; weight: 1; maxLines: 1 }
      Pct { p: day; right: true; width: 64 }
    }
    if problem != null {
      Text { text: problem; style: small; color: muted }
    } else {
      Text { text: price; style: title; maxLines: 1 }
      Sparkline { values: week; min: min(week); max: max(week); color: days7 >= 0 ? green : red; area: true; fill: width; weight: 1 }
      if rows >= 3 {
        Range { }
        Row {
          gap: 8
          Change { label: str.h1; p: hour; weight: 1 }
          Change { label: str.h24; p: day; weight: 1 }
          Change { label: str.d7; p: days7; weight: 1 }
        }
      } else {
        Row {
          gap: 4
          Text { text: str.d7; fontSize: 11; color: muted; width: 16 }
          Pct { p: days7; size: 11; weight: 1 }
        }
      }
    }
  }

  screen {
    title: "bitcoin"
    if problem != null {
      Text { text: problem; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 14
        Column {
          gap: 6
          Text { text: price; fontSize: 40; bold: true }
          Row {
            gap: 24
            Change { label: str.hour; p: hour; size: 16; weight: 1 }
            Change { label: str.day; p: day; size: 16; weight: 1 }
            Change { label: str.week; p: days7; size: 16; weight: 1 }
          }
        }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.last7; style: label; color: accent }
        Canvas {
          height: 184
          fill: width
          let lo = min(week)
          let hi = max(week)
          let n = max(len(week) - 1, 1)
          let top = 16
          let h = 128
          let c = days7 >= 0 ? green : red
          let pts = week.map((v, i) => [i / n * width, top + (hi - v) / max(hi - lo, 1) * h])
          path(pts + [[width, top + h], [0, top + h]], closed: true, fill: linear(0, top, 0, top + h, [alpha(c, 0.35), alpha(c, 0)]))
          path(pts, stroke: c, width: 2, cap: round)
          text(usd[4], 0, 6, size: 10, color: muted)
          text(usd[3], 0, top + h + 8, size: 10, color: muted)
          for d in range(8) {
            text(d == 7 ? str.now : str.daysAgo(7 - d), 12 + d / 7 * (width - 24), 176, size: 10, align: center, color: muted)
          }
        }

        Range { size: 12 }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.market; style: label; color: accent }
        Grid {
          columns: 2
          gap: 8
          Stat { label: str.cap; value: cap[0]; note: str.today("${b.market_cap_change_percentage_24h >= 0 ? "+" : ""}${fixed(b.market_cap_change_percentage_24h, 1)}"); noteColor: b.market_cap_change_percentage_24h >= 0 ? green : red }
          Stat { label: str.volume; value: cap[1]; note: str.ofCap(fixed(b.total_volume / b.market_cap * 100, 1)) }
          Stat { label: str.ath; value: usd[5]; note: "${fixed(b.ath_change_percentage, 1)}% · ${sub(b.ath_date, 0, 10)}"; noteColor: b.ath_change_percentage >= 0 ? green : red }
          Stat { label: str.rank; value: "#${b.market_cap_rank}"; note: str.byCap }
        }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.supply; style: label; color: accent }
        Column {
          gap: 4
          Row {
            Text { text: str.mined(fixed(b.circulating_supply / 1000000, 2)); style: body; weight: 1 }
            Text { text: str.of(round(b.max_supply / 1000000)); style: body; color: muted; width: 96; align: end }
          }
          Progress { value: b.circulating_supply; max: b.max_supply; color: accent }
          Text { text: str.toGo(fixed(b.circulating_supply / b.max_supply * 100, 2), round((b.max_supply - b.circulating_supply) / 1000)); style: small; color: muted }
        }

        Button { text: str.open; onTap: url("https://www.coingecko.com/en/coins/bitcoin") }
        Text { text: str.updated(sub(b.last_updated, 11, 16)); style: label; color: muted }
      }
    }
  }
}
