widget "github trending" {
  meta { description: "The most-starred GitHub repositories created in the last week; tap one to open it"; version: "1.2"; license: "MIT"; category: "dev"; owl: 16 }

  // What it says, in the phone's language where it has a set.
  strings {
    en { title: "github trending · this week" }
    id { title: "github trending · minggu ini" }
    es { title: "tendencias de github · esta semana" }
    pt { title: "em alta no github · esta semana" }
  }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  // GitHub has no trending API; new repos sorted by stars come closest. No token needed.
  source repos = cmd("""
    since=$(date -d '7 days ago' +%F)
    curl -fsm 10 "https://api.github.com/search/repositories?q=created:>$since&sort=stars&order=desc&per_page=15" | jq -c '[.items[] | {
      name: .full_name, url: .html_url, stars: .stargazers_count, lang: (.language // ""), desc: (.description // "")
    }]'
  """) every 1h json timeout 15s

  onTap: url("https://github.com/trending")

  Column {
    gap: 4
    Text { text: str.title; style: muted }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for r in repos key r.url {
        Column {
          gap: 0
          onTap: url(r.url)
          Row {
            Text { text: r.name; fontSize: 13; bold: true; maxLines: 1; weight: 1 }
            Text { text: r.stars >= 1000 ? "★ ${fixed(r.stars / 1000, 1)}k" : "★ ${r.stars}"; fontSize: 11; color: yellow; width: 64; align: end }
          }
          if r.desc != "" { Text { text: r.desc; fontSize: 11; color: muted; maxLines: 2 } }
          if r.lang != "" { Text { text: r.lang; fontSize: 10; color: accent } }
        }
      }
    }
  }
}
