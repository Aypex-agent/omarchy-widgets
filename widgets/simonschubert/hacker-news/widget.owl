widget "hacker news" {
  meta { description: "The Hacker News front page with points and comments; tap a story to read it"; version: "1.4"; license: "MIT"; category: "news"; owl: 16 }
  size: 6x4
  minSize: 4x3

  // What it says, in the phone's language where it has a set. Stories, sites and tags come as Hacker News has them.
  strings {
    en { pts: n => "${n} pts"; comments: n => "${n} comments" }
    id { pts: n => "${n} poin"; comments: n => "${n} komentar" }
    es { pts: n => "${n} pts"; comments: n => "${n} coment." }
    pt { pts: n => "${n} pts"; comments: n => "${n} coment." }
    de { pts: n => "${n} pkt"; comments: n => "${n} kommentare" }
    zh { pts: n => "${n} 分"; comments: n => "${n} 条评论" }
    ru { pts: n => "${n} очк."; comments: n => "${n} комм." }
    ja { pts: n => "${n} pt"; comments: n => "コメント ${n}" }
    uk { pts: n => "${n} бал."; comments: n => "${n} комент." }
    fr { pts: n => "${n} pts"; comments: n => "${n} comm." }
    tr { pts: n => "${n} puan"; comments: n => "${n} yorum" }
    it { pts: n => "${n} pt"; comments: n => n == 1 ? "1 commento" : "${n} commenti" }
  }

  source feed = http("https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=15") every 15m json timeout 15s
  let hn = (feed.hits ?? []).map(h => {
    id: h.objectID, title: h.title, points: h.points, comments: h.num_comments ?? 0,
    url: h.url ?? "https://news.ycombinator.com/item?id=${h.objectID}",
    site: split(match(h.url ?? "", "^https?://(?:www[.])?([^/]*)")[0] ?? "", "/")[0]
  })

  onTap: url("https://news.ycombinator.com")

  Column {
    gap: 4
    Text { text: "hacker news"; style: muted; color: orange }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for s in hn key s.id {
        Column {
          gap: 0
          onTap: url(s.url)
          Text { text: s.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text { text: str.pts(s.points); fontSize: 10; color: muted; width: 56 }
            Text { text: str.comments(s.comments); fontSize: 10; color: muted; width: 96; onTap: url("https://news.ycombinator.com/item?id=${s.id}") }
            Text { text: s.site; fontSize: 10; color: muted; maxLines: 1; weight: 1; align: end }
          }
        }
      }
    }
  }
}
