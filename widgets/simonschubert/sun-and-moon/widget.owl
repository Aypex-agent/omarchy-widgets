widget "sun and moon" {
  meta { description: "Sunrise, sunset, daylight left and tonight's moon phase, located by IP or a city you type, via wttr.in"; version: "1.5"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set; wttr names the moon's phase in English.
  strings {
    en {
      title: "sun and moon"; short: "sun & moon"; city: "city · empty = auto"
      sunriseIn: d => "sunrise in ${d}"; daylightLeft: d => "${d} of daylight left"
      phase: p => lower(p)
    }
    id {
      title: "matahari dan bulan"; short: "langit"; city: "kota · kosong = otomatis"
      sunriseIn: d => "terbit dalam ${d}"; daylightLeft: d => "terbenam dalam ${d}"
      phase: p => get({
        "New Moon": "bulan baru", "Waxing Crescent": "sabit awal", "First Quarter": "kuartir pertama",
        "Waxing Gibbous": "cembung awal", "Full Moon": "purnama", "Waning Gibbous": "cembung akhir",
        "Last Quarter": "kuartir akhir", "Waning Crescent": "sabit akhir"
      }, p, lower(p))
    }
    es {
      title: "sol y luna"; short: "sol y luna"; city: "ciudad · vacío = auto"
      sunriseIn: d => "amanece en ${d}"; daylightLeft: d => "quedan ${d} de luz"
      phase: p => get({
        "New Moon": "luna nueva", "Waxing Crescent": "creciente", "First Quarter": "cuarto creciente",
        "Waxing Gibbous": "gibosa creciente", "Full Moon": "luna llena", "Waning Gibbous": "gibosa menguante",
        "Last Quarter": "cuarto menguante", "Waning Crescent": "menguante"
      }, p, lower(p))
    }
    pt {
      title: "sol e lua"; short: "sol e lua"; city: "cidade · vazio = auto"
      sunriseIn: d => "o sol nasce em ${d}"; daylightLeft: d => "restam ${d} de luz"
      phase: p => get({
        "New Moon": "lua nova", "Waxing Crescent": "crescente", "First Quarter": "quarto crescente",
        "Waxing Gibbous": "crescente gibosa", "Full Moon": "lua cheia", "Waning Gibbous": "minguante gibosa",
        "Last Quarter": "quarto minguante", "Waning Crescent": "minguante"
      }, p, lower(p))
    }
    de {
      title: "sonne und mond"; short: "sonne & mond"; city: "stadt · leer = auto"
      sunriseIn: d => "aufgang in ${d}"; daylightLeft: d => "noch ${d} tageslicht"
      phase: p => get({
        "New Moon": "neumond", "Waxing Crescent": "zunehmende sichel", "First Quarter": "erstes viertel",
        "Waxing Gibbous": "zunehmender mond", "Full Moon": "vollmond", "Waning Gibbous": "abnehmender mond",
        "Last Quarter": "letztes viertel", "Waning Crescent": "abnehmende sichel"
      }, p, lower(p))
    }
    zh {
      title: "日月"; short: "日月"; city: "城市 · 留空 = 自动"
      sunriseIn: d => "${d} 后日出"; daylightLeft: d => "白天还剩 ${d}"
      phase: p => get({
        "New Moon": "新月", "Waxing Crescent": "蛾眉月", "First Quarter": "上弦月",
        "Waxing Gibbous": "盈凸月", "Full Moon": "满月", "Waning Gibbous": "亏凸月",
        "Last Quarter": "下弦月", "Waning Crescent": "残月"
      }, p, lower(p))
    }
  }
  size: 3x3
  minSize: 3x3

  requires { pacman: ["curl", "jq"] }

  state city = "" persist
  // The city, percent-encoded so it can't break the URL or the shell's single quotes. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // wttr.in gives local clock times ("07:14 AM"); date turns them into Unix time for today and tomorrow.
  // The city comes in as $1: a """ command is taken as written, so ${q} in it would be bash's own, empty, variable.
  source sky = cmd("set -- ${sh(q)}; " + """
    IFS=$'\t' read -r place rise set next phase illum < <(curl -fsm 12 "https://wttr.in/$1?format=j1" | jq -r '[
      .nearest_area[0].areaName[0].value, (.weather[0].astronomy[0] | .sunrise, .sunset),
      .weather[1].astronomy[0].sunrise, (.weather[0].astronomy[0] | .moon_phase, .moon_illumination)
    ] | @tsv') || exit
    jq -nc --arg place "$place" --arg phase "$phase" \
      --argjson rise "$(date -d "today $rise" +%s)" --argjson set "$(date -d "today $set" +%s)" \
      --argjson next "$(date -d "tomorrow $next" +%s)" --argjson illum "$illum" \
      '{place: $place, rise: $rise, set: $set, next: $next, phase: $phase, illum: $illum}'
  """) every 1h json timeout 20s
  source now = clock every 60s
  let day = now >= sky.rise && now < sky.set
  let p = clamp((now - sky.rise) / (sky.set - sky.rise), 0, 1)
  let waxing = contains(sky.phase, "Waxing") || contains(sky.phase, "First")

  onTap: screen()

  Column {
    gap: 4
    Row {
      Text { text: str.short; style: muted; weight: 1; maxLines: 1 }
      Text { text: sky.place; fontSize: 10; color: muted; maxLines: 1; width: 72; align: end }
    }
    // The day as an arc from sunrise (left) to sunset (right).
    Canvas {
      weight: 1
      fill: width
      let cx = width / 2
      let cy = height - 4
      let r = min(width / 2 - 8, height - 12)
      let a = rad(-90 + 180 * p)
      line(4, cy, width - 4, cy, stroke: border, width: 1)
      arc(cx, cy, r, -90, 180, stroke: border, width: 2, cap: round)
      if day { arc(cx, cy, r, -90, 180 * p, stroke: yellow, width: 3, cap: round) }
      circle(cx + r * sin(a), cy - r * cos(a), day ? 7 : 5, fill: day ? yellow : muted)
    }
    Row {
      Text { text: "↑ ${fmtTime(now < sky.set ? sky.rise : sky.next, "HH:mm")}"; fontSize: 12; weight: 1 }
      Text { text: "↓ ${fmtTime(sky.set, "HH:mm")}"; fontSize: 12; width: 56; align: end }
    }
    Text {
      text: now < sky.rise ? str.sunriseIn(fmtDuration(sky.rise - now)) : day ? str.daylightLeft(fmtDuration(sky.set - now)) : str.sunriseIn(fmtDuration(sky.next - now))
      style: small; color: muted; maxLines: 1
    }
    Row {
      align: center
      // Lit part of the moon: the limb on one side, the terminator (an ellipse) on the other.
      Canvas {
        size: 22
        let r = 10
        let c = 11
        let s = waxing ? 1 : -1
        let f = num(sky.illum, 0) / 100
        let ys = range(21).map(i => -r + 2 * r * i / 20)
        circle(c, c, r, fill: surface, stroke: border, width: 1)
        path(ys.map(y => [c + s * sqrt(max(r * r - y * y, 0)), c + y]) + reverse(ys).map(y => [c + s * sqrt(max(r * r - y * y, 0)) * (1 - 2 * f), c + y]), closed: true, fill: foreground)
      }
      Text { text: "${str.phase(sky.phase)} · ${sky.illum}%"; fontSize: 11; maxLines: 2; weight: 1 }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    Text { text: sky == null ? "…" : lower(sky.place); style: small; color: muted }
  }
}
