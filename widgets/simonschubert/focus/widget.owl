widget "focus" {
  meta { description: "A pomodoro focus timer: start, stop and adjust in 5 minute steps"; version: "1.4"; license: "MIT"; category: "productivity"; owl: 16 }
  size: 3x3
  minSize: 3x2

  strings {
    en { start: "start"; stop: "stop"; mins: n => "${n} min" }
    id { start: "mulai"; stop: "berhenti"; mins: n => "${n} mnt" }
    es { start: "empezar"; stop: "parar"; mins: n => "${n} min" }
    pt { start: "iniciar"; stop: "parar"; mins: n => "${n} min" }
    de { start: "start"; stop: "stopp"; mins: n => "${n} min" }
    zh { start: "开始"; stop: "停止"; mins: n => "${n} 分钟" }
    ru { start: "старт"; stop: "стоп"; mins: n => "${n} мин" }
    ja { start: "開始"; stop: "停止"; mins: n => "${n} 分" }
    uk { start: "старт"; stop: "стоп"; mins: n => "${n} хв" }
    fr { start: "démarrer"; stop: "arrêter"; mins: n => "${n} min" }
    tr { start: "başlat"; stop: "durdur"; mins: n => "${n} dk" }
    it { start: "avvia"; stop: "ferma"; mins: n => "${n} min" }
  }

  // No shell at all: state, a clock and buttons make a pomodoro timer.
  source now = clock every 1s
  state endsAt = 0
  state length = 25 * 60
  let left = endsAt > now ? endsAt - now : 0
  let running = left > 0

  Column {
    gap: 8
    align: center
    Box {
      weight: 1
      fill: width
      align: center
      Ring {
        fill: true; thickness: 8
        value: running ? left / length : 1
        color: running ? accent : muted
        animate value: tween(900ms, "linear")
      }
      Text {
        text: running ? "${pad(floor(left / 60), 2, "0")}:${pad(left % 60, 2, "0")}" : str.mins(length / 60)
        style: title; align: center
      }
    }
    Row {
      gap: 6
      justify: center
      Button { text: running ? str.stop : str.start; onTap: endsAt = running ? 0 : now + length }
      Button { text: "-5"; color: muted; onTap: length = max(length - 300, 300) }
      Button { text: "+5"; color: muted; onTap: length = min(length + 300, 3600) }
    }
  }
}
