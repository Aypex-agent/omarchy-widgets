widget "what's new" {
  size: 3x2
  minSize: 2x2
  meta { description: "What's new in the launcher, from its changelog on GitHub. Tap it for every release"; version: "1.3"; license: "MIT"; category: "news"; owl: 16 }

  // What it says, in the phone's language where it has a set. The changelog itself is in English.
  strings {
    en {
      title: "what's new"; update: "update"; offline: "offline"; loading: "loading…"; unreachable: "couldn't reach github"
      next: "coming next"; installed: "installed"; store: "play store ↗"; github: "open on github ↗"
    }
    id {
      title: "yang baru"; update: "perbarui"; offline: "offline"; loading: "memuat…"; unreachable: "tidak bisa menghubungi github"
      next: "segera hadir"; installed: "terinstal"; store: "play store ↗"; github: "buka di github ↗"
    }
    es {
      title: "novedades"; update: "actualizar"; offline: "sin conexión"; loading: "cargando…"; unreachable: "no se pudo conectar con github"
      next: "próximamente"; installed: "instalada"; store: "play store ↗"; github: "abrir en github ↗"
    }
    pt {
      title: "novidades"; update: "atualizar"; offline: "offline"; loading: "carregando…"; unreachable: "não foi possível acessar o github"
      next: "em breve"; installed: "instalada"; store: "play store ↗"; github: "abrir no github ↗"
    }
  }

  source log = http("https://raw.githubusercontent.com/SimonSchubert/omalauncher/main/CHANGELOG.md") every 6h timeout 10s status
  source sys = android.system every 1h

  // Each "## 0.5.0 (versionCode 10) – 2026-10-11" section, with its "- " items.
  // An item's wrapped lines are indented by two spaces, so they're joined first.
  let releases = split(log.ok ? log.out : "", "\n## ").drop(1).map(s => {
    version: lower(words(first(lines(s)))[0]),
    date: match(first(lines(s)), "\\d{4}-\\d{2}-\\d{2}"),
    items: lines(replace(s, "\n  ", " ")).filter(l => startsWith(l, "- ")).map(l => replace(sub(l, 2), "`", ""))
  }).filter(r => len(r.items) > 0)
  // "Unreleased" is what's coming; the tile shows the newest release.
  let latest = releases.find(r => r.date != null)
  let behind = latest != null && sys.launcher != null && latest.version != sys.launcher
  let store = "https://play.google.com/store/apps/details?id=dev.omalauncher"

  onTap: screen()

  Column {
    gap: 2
    Text { text: str.title; style: muted }
    if latest != null {
      // A narrow tile (the landscape home screen) has room for "10-20" beside the version, not the year too.
      Row {
        gap: 6
        align: bottom
        Text { text: latest.version; style: title; color: accent; width: 76; maxLines: 1 }
        Text { text: behind ? str.update : tileWidth < 180 ? sub(latest.date, 5) : latest.date; style: small; color: behind ? yellow : muted; align: end; weight: 1; maxLines: 1 }
      }
      // Every change, cut off with "…" where the tile ends.
      Text { text: join(latest.items.map(i => "• ${i}"), "\n"); style: small; maxLines: 40; weight: 1 }
    } else {
      Text { text: log == null ? "…" : str.offline; style: title; color: muted }
    }
  }

  screen {
    title: str.title
    if len(releases) == 0 {
      Text { text: log == null ? str.loading : str.unreachable; style: body; color: muted }
    } else {
      Column {
        Column {
          scroll: true
          gap: 18
          weight: 1
          for r in releases key r.version {
            let installed = r.version == sys.launcher
            Column {
              gap: 6
              Row {
                gap: 8
                align: bottom
                Text { text: r.date == null ? str.next : r.version; style: title; color: r.date == null ? muted : accent; weight: 1; maxLines: 1 }
                if installed {
                  Text { text: str.installed; style: label; color: green; width: 72; align: end }
                }
                Text { text: r.date ?? ""; style: small; color: muted; width: 88; align: end }
              }
              for item in r.items {
                Row {
                  gap: 8
                  align: top
                  Text { text: "•"; style: body; color: r.date == null ? muted : accent; width: 10 }
                  Text { text: item; style: body; color: r.date == null ? muted : foreground; weight: 1 }
                }
              }
            }
          }
        }
        Row {
          justify: end
          gap: 8
          Button { text: str.store; color: accent; onTap: url(store) }
          Button { text: str.github; color: muted; onTap: url("https://github.com/SimonSchubert/omalauncher/blob/main/CHANGELOG.md") }
        }
      }
    }
  }
}
