widget "omarchy" {
  size: 4x3
  minSize: 3x3
  requires { pacman: [] }
  meta { description: "Latest commits on omacom/omarchy, branch quattro. Tap the tile for the full feed, then a commit to open it."; version: "1.1"; license: "MIT"; category: "dev"; owl: 16 }

  // What it says, in the phone's language where it has a set. Commits and the branch come as GitHub has them.
  strings {
    en {
      someone: "someone"; rateLimited: "rate limited"; offline: "github offline"; loading: "loading…"; refresh: "refresh"
      now: "now"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; commits: n => "${n} commits"
    }
    id {
      someone: "seseorang"; rateLimited: "kena batas github"; offline: "github offline"; loading: "memuat…"; refresh: "muat ulang"
      now: "kini"; minutes: n => "${n}m"; hours: n => "${n}j"; days: n => "${n}h"; commits: n => "${n} commit"
    }
    es {
      someone: "alguien"; rateLimited: "límite de solicitudes"; offline: "github sin conexión"; loading: "cargando…"; refresh: "actualizar"
      now: "ahora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; commits: n => "${n} commits"
    }
    pt {
      someone: "alguém"; rateLimited: "limite de requisições"; offline: "github offline"; loading: "carregando…"; refresh: "atualizar"
      now: "agora"; minutes: n => "${n}m"; hours: n => "${n}h"; days: n => "${n}d"; commits: n => "${n} commits"
    }
  }

  source now = clock every 1m
  // Public commits API. Android fetches it; no shell and no packages. Twenty commits stay well under the 1 MB cap.
  source raw = http("https://api.github.com/repos/omacom/omarchy/commits?sha=quattro&per_page=20", {Accept: "application/vnd.github+json"}) every 10m timeout 15s json status

  let commits = (raw != null && raw.ok ? raw.out ?? [] : []).map(c => {
    sha: c.sha,
    short: sub(c.sha ?? "", 0, 7),
    url: c.html_url,
    iso: c.commit.author.date ?? "",
    subject: first(split(c.commit.message ?? "", "\n")) ?? "",
    author: c.author.login ?? c.commit.author.name ?? str.someone
  })
  let problem = raw == null || raw.ok ? null : raw.code == 403 ? str.rateLimited : str.offline
  let wide = cols != null && cols >= 6
  // A two-line row is ~30dp. Count from the tile height so the list fills it
  // instead of stopping early and leaving the bottom blank.
  let visible = commits.take(tileHeight == null ? 5 : clamp(floor((tileHeight - 28) / 30), 4, 20))

  onTap: screen()

  // iso is UTC, "2026-10-08T18:37:26Z". Days-from-civil, then a short age.
  component Commit(c, now, fresh = false, full = false) {
    Column {
      gap: 0
      let iso = c.iso
      let y = floor(num(sub(iso, 0, 4)))
      let mo = floor(num(sub(iso, 5, 7)))
      let day = floor(num(sub(iso, 8, 10)))
      let hh = floor(num(sub(iso, 11, 13)))
      let mm = floor(num(sub(iso, 14, 16)))
      let ss = floor(num(sub(iso, 17, 19)))
      let yy = y - (mo <= 2 ? 1 : 0)
      let era = floor(yy / 400)
      let yoe = yy - era * 400
      let doy = floor((153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5) + day - 1
      let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
      let at = (era * 146097 + doe - 719468) * 86400 + hh * 3600 + mm * 60 + ss
      let age = now - at
      let ago = iso == "" || now == null ? "…" : age < 45 ? str.now : age < 3600 ? str.minutes(floor(age / 60)) : age < 86400 ? str.hours(floor(age / 3600)) : age < 604800 ? str.days(floor(age / 86400)) : fmtTime(at, "MMM d")
      if full {
        Column {
          gap: 2
          padding: [0, 8]
          onTap: url(c.url)
          Text { text: c.subject; style: body; maxLines: 3 }
          Text { text: "${c.author} · ${ago} · ${c.short}"; style: small; color: muted; maxLines: 1 }
        }
      } else {
        Row {
          gap: 8
          align: top
          Text { text: c.subject; style: small; bold: fresh; maxLines: 2; weight: 1 }
          Column {
            gap: 0
            width: wide ? 84 : 48
            Text { text: ago; style: label; color: fresh ? accent : muted; align: end; maxLines: 1 }
            if wide {
              Text { text: c.author; style: label; color: muted; align: end; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  Column {
    gap: 8
    Row {
      align: center
      Text { text: "omarchy"; style: muted; weight: 1 }
      Text { text: raw == null ? "…" : "quattro"; style: label; color: accent; width: 64; align: end; maxLines: 1 }
    }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    if raw == null {
      Text { text: str.loading; style: small; color: muted }
    } else {
      if problem != null {
        Text { text: problem; style: small; color: muted }
      } else {
        Column {
          gap: 8
          for c, i in visible key c.sha {
            Commit { c: c; now: now; fresh: i == 0 }
          }
        }
      }
    }
  }

  screen {
    title: "omarchy"
    Column {
      scroll: true
      gap: 4
      Row {
        align: center
        Text { text: "quattro"; style: label; color: accent; weight: 1 }
        Text { text: raw == null ? "…" : str.commits(len(commits)); style: label; color: muted; width: 96; align: end; maxLines: 1 }
      }
      Row {
        gap: 8
        justify: end
        Button { text: str.refresh; color: muted; onTap: refresh() }
        Button { text: "github ↗"; color: muted; onTap: url("https://github.com/omacom/omarchy/commits/quattro") }
      }
      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
      if raw == null {
        Text { text: str.loading; style: body; color: muted }
      } else {
        if problem != null {
          Text { text: problem; style: body; color: muted }
        } else {
          for c, i in commits key c.sha {
            if i > 0 {
              Spacer { height: 1; fill: width; background: alpha(muted, 0.2) }
            }
            Commit { c: c; now: now; fresh: i == 0; full: true }
          }
        }
      }
      Spacer { height: 12 }
    }
  }
}
