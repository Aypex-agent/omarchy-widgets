widget "earthquakes" {
  meta { description: "Earthquakes of magnitude 4.5 and up worldwide in the last day, from the USGS"; version: "1.2"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. Places come as the USGS writes them.
  strings {
    en { title: "earthquakes · 24h"; summary: (n, max) => "${n} · max ${max}"; minutes: n => "${n}m"; hours: n => "${n}h" }
    id { title: "gempa · 24 jam"; summary: (n, max) => "${n} · maks ${max}"; minutes: n => "${n}m"; hours: n => "${n}j" }
    es { title: "sismos · 24 h"; summary: (n, max) => "${n} · máx. ${max}"; minutes: n => "${n}m"; hours: n => "${n}h" }
    pt { title: "terremotos · 24 h"; summary: (n, max) => "${n} · máx. ${max}"; minutes: n => "${n}m"; hours: n => "${n}h" }
  }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  source quakes = cmd("""
    curl -fsm 12 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson' | jq -c '[.features[] | .properties | {
      mag, place: (.place // "unknown"), at: (.time / 1000 | floor), url, tsunami: (.tsunami == 1)
    }] | sort_by(-.at)'
  """) every 10m json timeout 20s
  source now = clock every 60s
  let strongest = quakes.sortBy(q => -q.mag).first()

  onTap: url("https://earthquake.usgs.gov/earthquakes/map/")

  Column {
    gap: 4
    Row {
      Text { text: str.title; style: muted; weight: 1 }
      Text { text: quakes == null ? "…" : str.summary(len(quakes), strongest.mag ?? "-"); fontSize: 11; color: muted; width: 96; align: end }
    }
    Column {
      scroll: true
      weight: 1
      gap: 4
      for q in quakes key q.url {
        let age = now - q.at
        Row {
          align: center
          onTap: url(q.url)
          Text { text: fixed(q.mag, 1); fontSize: 13; bold: true; color: q.mag >= 6 ? red : q.mag >= 5 ? orange : yellow; width: 32 }
          Text { text: q.tsunami ? "🌊 ${q.place}" : q.place; fontSize: 12; maxLines: 1; weight: 1 }
          Text { text: age < 3600 ? str.minutes(max(floor(age / 60), 1)) : str.hours(floor(age / 3600)); fontSize: 11; color: muted; width: 32; align: end }
        }
      }
    }
  }
}
