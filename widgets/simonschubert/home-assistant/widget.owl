widget "home assistant" {
  meta { description: "Home Assistant entities with their states; tap a light or switch to toggle it. Set up in ~/.config/omarchy-proot/home-assistant"; version: "1.5"; license: "MIT"; owl: 16; category: "home" }
  // What it says, in the phone's language where it has a set. Entity names and states come as Home Assistant has them.
  strings {
    en { unreachable: "unreachable"; unset: "can't reach it: tap to set the URL, token and entities" }
    id { unreachable: "tak terjangkau"; unset: "tidak bisa terhubung: ketuk untuk mengatur URL, token, dan entitas" }
    es { unreachable: "inaccesible"; unset: "no se puede conectar: toca para configurar la URL, el token y las entidades" }
    pt { unreachable: "inacessível"; unset: "sem conexão: toque para definir a URL, o token e as entidades" }
    de { unreachable: "nicht erreichbar"; unset: "nicht erreichbar: tippe, um URL, token und entitäten einzustellen" }
    zh { unreachable: "无法连接"; unset: "无法连接：点按设置 URL、令牌和实体" }
    ru { unreachable: "недоступно"; unset: "нет связи: нажмите, чтобы указать URL, токен и сущности" }
    ja { unreachable: "接続不可"; unset: "接続できません：タップして URL、トークン、エンティティを設定" }
    uk { unreachable: "недоступно"; unset: "немає зв’язку: натисніть, щоб указати URL, токен і сутності" }
    fr { unreachable: "injoignable"; unset: "injoignable : touche pour régler l’URL, le jeton et les entités" }
    tr { unreachable: "erişilemiyor"; unset: "erişilemiyor: URL, token ve varlıkları ayarlamak için dokun" }
    it { unreachable: "non raggiungibile"; unset: "non raggiungibile: tocca per impostare URL, token ed entità" }
  }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // The config file holds the server URL on line 1, a long-lived access token on line 2
  // (Home Assistant: profile > security) and entity ids on the lines after.
  source ha = cmd("""
    f=~/.config/omarchy-proot/home-assistant
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'http://homeassistant.local:8123\nPASTE-A-LONG-LIVED-TOKEN\nsun.sun\n' > "$f"
    chmod 600 "$f"
    base=$(sed -n 1p "$f"); token=$(sed -n 2p "$f")
    # Once the server can't be reached (away from home), the rest are marked at once instead of
    # each waiting out its own timeout in a shell every widget shares.
    down=
    tail -n +3 "$f" | grep . | while read -r id; do
      if [ -z "$down" ]; then
        curl -fsm 8 --connect-timeout 3 -H "Authorization: Bearer $token" "$base/api/states/$id" && { echo; continue; }
        case $? in 6|7|28) down=1 ;; esac
      fi
      jq -nc --arg id "$id" '{entity_id: $id, state: "unreachable", attributes: {}}'
    done | jq -sc '[.[] | {id: .entity_id, name: (.attributes.friendly_name // .entity_id), state, unit: (.attributes.unit_of_measurement // "")}]'
  """) every 1m json timeout 30s
  let unset = ha != null && len(ha) > 0 && ha.all(e => e.state == "unreachable")

  onTap: terminal('$EDITOR ~/.config/omarchy-proot/home-assistant', "home assistant")

  Column {
    gap: 4
    Text { text: "home assistant"; style: muted }
    if unset { Text { text: str.unset; style: small } }
    Grid {
      columns: 2
      gap: 6
      for e in ha key e.id {
        let domain = split(e.id, ".")[0]
        let toggles = domain == "light" || domain == "switch" || domain == "fan" || domain == "input_boolean"
        Column {
          gap: 0
          padding: 6
          radius: 6
          background: e.state == "on" ? alpha(accent, 0.2) : surface
          onTap: run(!toggles ? "true" : "f=~/.config/omarchy-proot/home-assistant; curl -fsm 8 -X POST -H \"Authorization: Bearer $(sed -n 2p $f)\" -H 'Content-Type: application/json' -d ${sh('{"entity_id": "' + e.id + '"}')} \"$(sed -n 1p $f)/api/services/homeassistant/toggle\"")
          Text { text: e.name; fontSize: 11; color: muted; maxLines: 1 }
          Text { text: e.state == "unreachable" ? str.unreachable : "${e.state} ${e.unit}"; fontSize: 14; color: e.state == "on" ? accent : e.state == "unreachable" ? red : foreground; maxLines: 1 }
        }
      }
    }
  }
}
