widget "world clock" {
  meta { description: "A row of flip clocks with city nameplates. Tap it to add, rename, reorder or remove cities"; version: "1.5"; license: "MIT"; category: "time"; owl: 16 }

  // What it says, in the phone's language where it has a set. Cities and countries come from the tz
  // database, in English, and are searched in English.
  strings {
    en {
      title: "world clock"; local: "local"; noClocks: "no clocks yet, tap to add one"; clocks: "clocks"
      noneYet: "none yet, search for a city below"; nameplate: "nameplate"; add: "add a city"
      search: "search a city or country"; loading: "loading places…"; nothing: "nothing matches"
      days: ["thu", "fri", "sat", "sun", "mon", "tue", "wed"]
    }
    id {
      title: "jam dunia"; local: "lokal"; noClocks: "belum ada jam, ketuk untuk menambah"; clocks: "jam"
      noneYet: "belum ada, cari kota di bawah"; nameplate: "papan nama"; add: "tambah kota"
      search: "cari kota atau negara"; loading: "memuat tempat…"; nothing: "tidak ada yang cocok"
      days: ["kam", "jum", "sab", "min", "sen", "sel", "rab"]
    }
    es {
      title: "reloj mundial"; local: "local"; noClocks: "aún no hay relojes, toca para agregar uno"; clocks: "relojes"
      noneYet: "ninguno aún, busca una ciudad abajo"; nameplate: "nombre"; add: "agregar una ciudad"
      search: "busca una ciudad o un país"; loading: "cargando lugares…"; nothing: "nada coincide"
      days: ["jue", "vie", "sáb", "dom", "lun", "mar", "mié"]
    }
    pt {
      title: "relógio mundial"; local: "local"; noClocks: "nenhum relógio ainda, toque para adicionar"; clocks: "relógios"
      noneYet: "nenhum ainda, procure uma cidade abaixo"; nameplate: "nome"; add: "adicionar uma cidade"
      search: "procure uma cidade ou um país"; loading: "carregando lugares…"; nothing: "nada encontrado"
      days: ["qui", "sex", "sáb", "dom", "seg", "ter", "qua"]
    }
  }
  size: 6x2
  minSize: 3x2
  requires { pacman: ["tzdata"] }

  // Each clock is {label, zone}, kept by the launcher. Version 1.1 kept them in a file; it's read once to carry them over.
  state clocks = null persist
  state query = ""
  source legacy = file("~/.config/omarchy-proot/world-clock")
  let legacyRows = lines(legacy ?? "").filter(l => !startsWith(l, "#")).map(l => words(l)).filter(w => len(w) >= 2)
  when clocks == null && legacy != null {
    clocks = len(legacyRows) > 0
      ? legacyRows.map(w => {label: replace(w[0], "-", " "), zone: w[1]})
      : [{label: "New York", zone: "America/New_York"}, {label: "London", zone: "Europe/London"}, {label: "Tokyo", zone: "Asia/Tokyo"}]
  }

  // Zones only ever come from the tz database's own list, and are checked again before they reach the shell.
  let zones = (clocks ?? []).map(c => c.zone).filter(z => match(z, "^[A-Za-z0-9_+/-]+$") != null).unique()
  // Only UTC offsets come from the shell; the digits run off the clock source.
  source offsets = cmd("echo \"local $(date +%z)\"; for z in $(echo ${sh(join(zones, " "))}); do echo \"$z $(TZ=$z date +%z)\"; done") every 5m
  source now = clock every 5s
  // Every place to pick from: "zone<tab>city<tab>country".
  source places = cmd("""
    z=/usr/share/zoneinfo
    echo "UTC	UTC	Coordinated Universal Time"
    awk -F'\t' 'FNR == NR { if ($0 !~ /^#/) c[$1] = $2; next }
      /^#/ { next }
      { n = split($3, p, "/"); city = p[n]; gsub("_", " ", city); print $3 "\t" city "\t" c[$1] }' $z/iso3166.tab $z/zone.tab | sort -t '	' -k 2
  """) every 24h

  let off = lines(offsets).map(l => words(l)).map(w => {
    zone: w[0],
    secs: (sub(w[1], 0, 1) == "-" ? -1 : 1) * (num(sub(w[1], 1, 3)) * 3600 + num(sub(w[1], 3, 5)) * 60)
  })
  let here = off.find(o => o.zone == "local").secs ?? 0
  let shown = (clocks ?? []).map(c => {label: c.label, zone: c.zone, secs: off.find(o => o.zone == c.zone).secs}).filter(c => c.secs != null)
  // A tile taller than wide (the landscape home screen) stacks the clocks instead of lining them up.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  let days = str.days
  let found = trim(query) == "" ? [] : lines(places).map(l => split(l, "\t"))
    .filter(p => contains(lower("${p[1]} ${p[2]} ${p[0]}"), lower(trim(query)))).take(30)

  onTap: screen()

  // A flip-clock face: hours and minutes on two split cards. Cards where it's night go dark,
  // so day and night read across the row at a glance.
  component FlipClock(t) {
    Canvas {
      let h = floor(t / 3600) % 24
      let m = floor(t / 60) % 60
      let night = h < 6 || h >= 18
      let gap = max(6, width * 0.06)
      let cw = min((width - gap) / 2, height * 1.1)
      let ch = min(height, cw * 1.05)
      let x0 = (width - cw * 2 - gap) / 2
      let y0 = (height - ch) / 2
      let size = min(ch * 0.62, cw * 0.62)
      for v, i in [h, m] {
        let x = x0 + i * (cw + gap)
        rect(x, y0, cw, ch, radius: 4, fill: night ? background : surface)
        rect(x, y0, cw, ch, radius: 4, stroke: border, width: 1)
        text(pad(v, 2, "0"), x + cw / 2, y0 + ch / 2, size: size, bold: true, align: center, color: night ? muted : foreground)
        line(x, y0 + ch / 2, x + cw, y0 + ch / 2, stroke: night ? border : background, width: max(1, ch * 0.025))
      }
      circle(width / 2, y0 + ch * 0.36, max(1.2, size * 0.05), fill: night ? muted : accent)
      circle(width / 2, y0 + ch * 0.64, max(1.2, size * 0.05), fill: night ? muted : accent)
    }
  }

  component Plate(name) {
    Text { text: upper(name); style: label; font: mono; bold: true; align: center; maxLines: 1; fill: width; padding: [6, 2]; background: surface; border: 1; borderColor: border }
  }

  component City(c) {
    let t = now + c.secs
    let diff = (c.secs - here) / 3600
    Column {
      weight: 1
      gap: 4
      align: center
      FlipClock { t: t; weight: 1; fill: width }
      Plate { name: c.label }
      Text { text: "${days[floor(t / 86400) % 7]} ${diff == 0 ? str.local : "${diff > 0 ? "+" : ""}${diff % 1 == 0 ? int(diff) : diff}h"}"; style: small; color: muted; align: center; fill: width; maxLines: 1 }
    }
  }

  if len(shown) == 0 {
    Text { text: clocks == null || len(clocks) > 0 ? "…" : str.noClocks; style: muted; align: center; fill: true }
  } else if tall {
    Column {
      gap: 10
      for c, i in shown key "${i} ${c.zone}" {
        City { c: c }
      }
    }
  } else {
    Row {
      gap: 8
      for c, i in shown key "${i} ${c.zone}" {
        City { c: c }
      }
    }
  }

  screen {
    title: str.title
    Column {
      gap: 8
      fill: true
      scroll: true
      Text { text: str.clocks; style: label }
      if len(clocks ?? []) == 0 {
        Text { text: str.noneYet; style: small; color: muted }
      }
      for c, i in clocks ?? [] key "${i} ${c.zone}" {
        let secs = off.find(o => o.zone == c.zone).secs
        let n = len(clocks)
        Row {
          gap: 6
          align: center
          fill: width
          Button { text: "↑"; color: i == 0 ? border : muted; width: 32; onTap: clocks = i > 0 ? clocks.take(i - 1) + [c, clocks[i - 1]] + clocks.drop(i + 1) : clocks }
          Button { text: "↓"; color: i == n - 1 ? border : muted; width: 32; onTap: clocks = i < n - 1 ? clocks.take(i) + [clocks[i + 1], c] + clocks.drop(i + 2) : clocks }
          Input { text: c.label; placeholder: str.nameplate; weight: 1; onSubmit: clocks = trim(value) == "" ? clocks : clocks.take(i) + [{label: trim(value), zone: c.zone}] + clocks.drop(i + 1) }
          Text { text: secs == null ? "…" : "${pad(floor((now + secs) / 3600) % 24, 2, "0")}:${pad(floor((now + secs) / 60) % 60, 2, "0")}"; font: mono; color: muted; width: 48; align: end }
          Button { text: "×"; color: red; width: 32; onTap: clocks = clocks.take(i) + clocks.drop(i + 1) }
        }
      }
      Spacer { height: 8 }
      Text { text: str.add; style: label }
      Input { text: query; placeholder: str.search; fill: width; onChange: query = value }
      if trim(query) != "" && len(found) == 0 {
        Text { text: places == null ? str.loading : str.nothing; style: small; color: muted }
      }
      for p in found key p[0] {
        Row {
          gap: 8
          align: center
          fill: width
          padding: [4, 6]
          onTap: { clocks = (clocks ?? []) + [{label: p[1], zone: p[0]}]; query = ""; refresh() }
          Text { text: "+"; color: accent; bold: true; width: 14 }
          Text { text: p[1]; weight: 1; maxLines: 1 }
          Text { text: p[2]; style: small; color: muted; width: 140; align: end; maxLines: 1 }
        }
      }
    }
  }
}
