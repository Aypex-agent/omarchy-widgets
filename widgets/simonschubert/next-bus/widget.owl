widget "next bus" {
  size: 6x2
  minSize: 4x2
  requires { pacman: [] }
  meta { description: "Your next bus, tram or train, live, and whether you need to run for it: pick a stop, a line and how long you walk there, anywhere Transitous has open timetables. Tap the tile to change them"; version: "1.2"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. Stops, lines and directions come as Transitous
  // names them. leaveNow and run sit in a 170dp column at 22 and 26sp: about 12 letters at most.
  strings {
    en {
      title: "next bus"; relax: "relax"; leaveInMin: m => "leave in ${m} min"; leaveIn: "leave in"; leaveNow: "leave now"
      brisk: "walk briskly"; run: "run!"; toStop: t => "${t} to the stop"
      pick: "Tap to pick your stop, your line and how long you walk there."; nothing: "nothing leaves soon"
      to: d => "to ${d}"; walkMin: m => "${m} min walk"; fromWalk: (stop, m) => "from ${stop} · ${m} min walk"
      min: "min"; mins: m => "${m} min"; yourStop: "your stop"; timetable: "timetable"; onTime: "on time"; then: "then"
      noneLater: "none later yet"; noLater: "no later ones yet"; tooMany: "too many requests"; offline: "transitous offline"
      search: "search for a stop"; change: "change stop"; searching: "searching…"; noStops: q => "no stops called “${q}”"
      yourLine: "your line"; anyLine: "any line"; whatever: "whatever leaves first"; walkTo: "walk to the stop"
      data: "data: Transitous, from open timetables. Delays show where the operator publishes live times"
    }
    id {
      title: "bus berikutnya"; relax: "santai"; leaveInMin: m => "berangkat ${m} mnt lagi"; leaveIn: "berangkat dalam"; leaveNow: "ayo jalan"
      brisk: "jalan cepat"; run: "lari!"; toStop: t => "${t} ke halte"
      pick: "Ketuk untuk memilih halte, jalur, dan berapa lama kamu berjalan ke sana."; nothing: "belum ada yang berangkat"
      to: d => "ke ${d}"; walkMin: m => "${m} mnt jalan kaki"; fromWalk: (stop, m) => "dari ${stop} · ${m} mnt jalan kaki"
      min: "mnt"; mins: m => "${m} mnt"; yourStop: "haltemu"; timetable: "sesuai jadwal"; onTime: "tepat waktu"; then: "lalu"
      noneLater: "belum ada berikutnya"; noLater: "belum ada berikutnya"; tooMany: "terlalu banyak permintaan"; offline: "transitous offline"
      search: "cari halte"; change: "ganti halte"; searching: "mencari…"; noStops: q => "tidak ada halte bernama “${q}”"
      yourLine: "jalurmu"; anyLine: "jalur apa saja"; whatever: "yang berangkat duluan"; walkTo: "jalan kaki ke halte"
      data: "data: Transitous, dari jadwal terbuka. Keterlambatan muncul jika operator menerbitkan waktu langsung"
    }
    es {
      title: "próximo bus"; relax: "tranquilo"; leaveInMin: m => "sal en ${m} min"; leaveIn: "sal en"; leaveNow: "sal ya"
      brisk: "camina rápido"; run: "¡corre!"; toStop: t => "${t} hasta la parada"
      pick: "Toca para elegir tu parada, tu línea y cuánto caminas hasta allí."; nothing: "nada sale pronto"
      to: d => "hacia ${d}"; walkMin: m => "${m} min a pie"; fromWalk: (stop, m) => "desde ${stop} · ${m} min a pie"
      min: "min"; mins: m => "${m} min"; yourStop: "tu parada"; timetable: "según horario"; onTime: "a tiempo"; then: "luego"
      noneLater: "aún no hay más"; noLater: "aún no hay más"; tooMany: "demasiadas solicitudes"; offline: "transitous sin conexión"
      search: "busca una parada"; change: "cambiar parada"; searching: "buscando…"; noStops: q => "no hay paradas llamadas “${q}”"
      yourLine: "tu línea"; anyLine: "cualquier línea"; whatever: "la que salga primero"; walkTo: "caminata hasta la parada"
      data: "datos: Transitous, de horarios abiertos. Los retrasos aparecen donde el operador publica horarios en tiempo real"
    }
    pt {
      title: "próximo ônibus"; relax: "relaxa"; leaveInMin: m => "saia em ${m} min"; leaveIn: "saia em"; leaveNow: "saia já"
      brisk: "ande rápido"; run: "corre!"; toStop: t => "${t} até a parada"
      pick: "Toque para escolher a parada, a linha e quanto tempo leva a pé até lá."; nothing: "nada sai em breve"
      to: d => "para ${d}"; walkMin: m => "${m} min a pé"; fromWalk: (stop, m) => "de ${stop} · ${m} min a pé"
      min: "min"; mins: m => "${m} min"; yourStop: "sua parada"; timetable: "horário previsto"; onTime: "no horário"; then: "depois"
      noneLater: "nenhum depois ainda"; noLater: "nenhum depois ainda"; tooMany: "pedidos demais"; offline: "transitous offline"
      search: "procure uma parada"; change: "trocar parada"; searching: "procurando…"; noStops: q => "nenhuma parada chamada “${q}”"
      yourLine: "sua linha"; anyLine: "qualquer linha"; whatever: "a que sair primeiro"; walkTo: "caminhada até a parada"
      data: "dados: Transitous, de horários abertos. Atrasos aparecem onde a operadora publica horários em tempo real"
    }
  }

  // The stop, the line and the walk, picked in the full screen and kept across restarts. No location is hard-coded.
  state stopId = "" persist
  state stopName = "" persist
  // The line as route and direction; "" takes whatever leaves first.
  state route = "" persist
  state dir = "" persist
  state walk = 4 persist
  state query = ""

  source now = clock every 1s
  // Transitous (https://transitous.org) asks clients to name themselves.
  let ua = {"User-Agent": "omarchy-widgets/next-bus (+https://github.com/SimonSchubert/omarchy-widgets)"}

  // A null URL makes no request.
  source found = http(len(trim(query)) < 2 ? null : "https://api.transitous.org/api/v1/geocode?type=STOP&text=${enc(trim(query))}", ua) every 1h timeout 15s json status
  source board = http(stopId == "" ? null : "https://api.transitous.org/api/v6/stoptimes?stopId=${enc(stopId)}&n=40", ua) every 30s timeout 15s json status

  let stops = (found != null && found.ok ? found.out ?? [] : []).take(8).map(s => {
    id: s.id,
    name: s.name,
    area: (s.areas ?? []).find(a => a.default == true).name ?? s.country ?? "",
    modes: lower(join((s.modes ?? []).take(3), ", "))
  })
  let deps = (board != null && board.ok ? board.out.stopTimes ?? [] : []).map(s => {
    key: "${s.tripId}${s.place.scheduledDeparture}",
    trip: s.tripId,
    stop: s.place.stopId,
    route: s.routeId ?? "",
    dir: s.directionId ?? "",
    line: s.routeShortName != null && s.routeShortName != "?" ? s.routeShortName : s.displayName ?? lower(s.mode ?? ""),
    color: s.routeColor ?? "",
    text: s.routeTextColor ?? "",
    to: s.headsign ?? s.tripTo.name ?? "",
    at: parseTime(s.place.departure ?? s.place.arrival ?? ""),
    planned: parseTime(s.place.scheduledDeparture ?? s.place.scheduledArrival ?? ""),
    live: s.realTime == true,
    cancelled: s.cancelled == true || s.tripCancelled == true
  })
  // Every line and direction on the board, for the picker.
  let lines = deps.map(r => "${r.route}|${r.dir}").unique().map(k => deps.find(r => "${r.route}|${r.dir}" == k)).sortBy(l => "${l.line} ${l.to}")
  let catchable = deps.filter(r => !r.cancelled && r.at != null && r.at > now && (route == "" || (r.route == route && r.dir == dir)))
  // Some feeds list one departure twice, as planned and as live: once per line, direction and minute.
  let mine = catchable.map(r => "${r.route}|${r.dir}|${r.at}").unique().map(k => catchable.find(r => "${r.route}|${r.dir}|${r.at}" == k))
  let next = mine.first()
  let problem = stopId == "" || board == null || board.ok ? null : board.code == 429 ? str.tooMany : str.offline

  // The stops of the next trip, for the line along the bottom: one before yours, yours, and where it goes.
  source trip = http(next == null ? null : "https://api.transitous.org/api/v5/trip?tripId=${enc(next.trip)}", ua) every 1m timeout 15s json status
  let leg = trip != null && trip.ok ? trip.out.legs[0] : null
  let path = leg == null ? [] : [leg.from] + (leg.intermediateStops ?? []) + [leg.to]
  let here = leg == null || next == null ? null : range(len(path)).find(i => path[i].stopId == next.stop) ?? range(len(path)).find(i => path[i].name == stopName)
  let prev = here == null || here == 0 ? null : path[here - 1]
  let after = here == null ? [] : path.drop(here + 1)
  let dots = here == null ? [] : (prev == null ? [] : [prev]) + [path[here]] + after.take(3) + (len(after) > 3 ? [after.last()] : [])
  let you = prev == null ? 0 : 1
  // How far the bus is from the stop before yours to yours, by the trip's own times; without them, by the countdown.
  let t0 = prev == null ? null : parseTime(prev.departure ?? prev.arrival ?? "")
  let t1 = here == null ? null : parseTime(path[here].arrival ?? path[here].departure ?? "")
  let near = next == null ? 0 : t0 != null && t1 != null && t1 > t0 ? (now < t0 ? -1 : clamp((now - t0) / (t1 - t0), 0, 1)) : clamp(1 - (next.at - now) / 600, 0, 1)

  let left = next == null ? null : next.at - now
  let leaveIn = left - walk * 60
  let mood = leaveIn > 120 ? "relax" : leaveIn > 0 ? "soon" : leaveIn > -60 ? "now" : "run"
  let tint = mood == "relax" ? green : mood == "soon" ? yellow : mood == "now" ? orange : red
  let late = next == null || next.planned == null ? 0 : round((next.at - next.planned) / 60)
  // Three rows or more: the walk, the stop names and the next ones too.
  let roomy = (rows ?? 3) >= 3
  // A tile taller than wide (the landscape home screen) stacks: destination, minutes, then what to do.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  onTap: screen()

  component Badge(r, size = 15) {
    Text {
      text: r.line
      bold: true
      fontSize: size
      color: r.text != "" ? "#${r.text}" : background
      background: r.color != "" ? "#${r.color}" : accent
      padding: [9, 3]
      radius: 6 * corners
      maxLines: 1
    }
  }

  // Whether to relax, leave or run, against the edge given.
  component Mood(side = "start") {
    Column {
      gap: 2
      if mood == "relax" {
        Text { text: str.relax; style: label; color: tint; align: side }
        Text { text: str.leaveInMin(floor(leaveIn / 60)); style: small; color: muted; align: side }
      } else if mood == "soon" {
        Text { text: str.leaveIn; style: label; color: tint; align: side }
        Text { text: fmtTime(leaveIn, "m:ss", "UTC"); fontSize: 26; fontWeight: 500; color: tint; align: side }
      } else if mood == "now" {
        Text { text: str.leaveNow; fontSize: 22; fontWeight: 600; color: tint; align: side }
        Text { text: str.brisk; style: small; color: muted; align: side }
      } else {
        Text { text: str.run; fontSize: 26; fontWeight: 700; color: tint; align: side }
        Text { text: str.toStop("${floor(left / 60)}:${pad(int(left % 60), 2, "0")}"); style: small; color: muted; align: side }
      }
    }
  }

  Column {
    gap: roomy ? 6 : 2
    if stopId == "" {
      Text { text: str.title; style: body }
      Text { text: str.pick; style: small; color: muted }
    } else if next == null {
      Text { text: stopName; style: body; maxLines: 1 }
      Text { text: board == null ? "…" : problem ?? str.nothing; style: small; color: muted }
    } else {
      if tall {
        Row { Badge { r: next } }
        Column {
          gap: 0
          Text { text: str.to(next.to); style: body; maxLines: 2 }
          Text { text: str.walkMin(walk); style: small; color: muted; maxLines: 1 }
        }
      } else {
        Row {
          gap: 10
          align: center
          Badge { r: next }
          Column {
            gap: 0
            weight: 1
            Text { text: str.to(next.to); style: body; maxLines: 1 }
            if roomy {
              Text { text: str.fromWalk(stopName, walk); style: small; color: muted; maxLines: 1 }
            }
          }
          if !roomy {
            Text { text: str.walkMin(walk); style: small; color: muted }
          }
        }
      }
      Row {
        gap: 6
        align: bottom
        Text { text: str(floor(left / 60)); fontSize: roomy ? 58 : 44; fontWeight: 300; letterSpacing: -1 }
        Text { text: str.min; fontSize: roomy ? 20 : 17; color: muted; padding: [0, 0, 0, roomy ? 14 : 10] }
        if !tall {
          Spacer { weight: 1 }
          Mood { side: "end"; width: 170; padding: [0, 0, 0, 10] }
        }
      }
      if tall {
        Mood {}
      }
      Canvas {
        height: roomy ? 34 : 22
        fill: width
        let x0 = 10
        let x1 = width - 10
        let y = 12
        let n = max(len(dots), 6)
        let gapX = (x1 - x0) / (n - 1)
        // Without the trip's stops, your stop is the second of six plain dots.
        let k = len(dots) == 0 ? 1 : you
        let sx = x0 + k * gapX
        let bx = near < 0 ? x0 - 14 : lerp(k == 0 ? x0 - 14 : x0, sx, near)
        line(x0, y, x1, y, stroke: alpha(muted, 0.35), width: 3, cap: round)
        line(x0, y, bx, y, stroke: alpha(accent, 0.8), width: 3, cap: round)
        for i in range(n) {
          circle(x0 + i * gapX, y, i == k ? 6 : 3.5, fill: i == k ? background : alpha(muted, 0.7))
        }
        circle(sx, y, 6, stroke: tint, width: 2.5)
        circle(sx, y, 11 + (now % 2) * 2, stroke: alpha(tint, 0.35), width: 1.5)
        rect(bx - 11, y - 7, 22, 14, radius: 4 * corners, fill: next.color != "" ? "#${next.color}" : accent)
        rect(bx - 7, y - 4, 5, 4, radius: 1, fill: alpha(background, 0.7))
        rect(bx + 1, y - 4, 5, 4, radius: 1, fill: alpha(background, 0.7))
        if roomy {
          // Your stop first on the trip sits at the left edge: its label starts there rather than centring off the tile.
          if k == 0 {
            text(str.yourStop, 0, y + 18, size: 10, align: start, color: tint)
          } else {
            text(str.yourStop, sx, y + 18, size: 10, align: center, color: tint)
          }
          if !tall && len(dots) > k + 2 {
            text(lower(replace(dots.last().name, " (${split(dots.last().name, " (").last()}", "")), x1, y + 18, size: 10, align: end, color: muted)
          }
        }
      }
      if tall {
        Spacer { weight: 1 }
        Row {
          gap: 6
          Text {
            text: !next.live ? str.timetable : late >= 1 ? "+" + str.mins(late) : late <= -1 ? str.mins(late) : str.onTime
            style: small
            color: !next.live ? muted : late >= 5 ? red : late >= 2 ? yellow : green
            weight: 1
          }
          Text { text: len(mine) > 1 ? str.then : str.noneLater; style: small; color: muted }
        }
        for r in mine.drop(1).take(2) key r.key {
          Row {
            gap: 6
            if route == "" {
              Text { text: r.line; style: small; bold: true; maxLines: 1; weight: 1 }
            }
            Text { text: fmtTime(r.at, "HH:mm"); style: small }
          }
        }
      } else if roomy {
        Spacer { weight: 1 }
        Row {
          gap: 6
          Text { text: len(mine) > 1 ? str.then : str.noLater; style: small; color: muted }
          // With any line, each one says which.
          for r, i in mine.drop(1).take(2) key r.key {
            if i > 0 {
              Text { text: "·"; style: small; color: muted }
            }
            if route == "" {
              Text { text: r.line; style: small; bold: true; maxLines: 1 }
            }
            Text { text: fmtTime(r.at, "HH:mm"); style: small }
          }
          Spacer { weight: 1 }
          Text {
            text: !next.live ? str.timetable : late >= 1 ? "+" + str.mins(late) : late <= -1 ? str.mins(late) : str.onTime
            style: small
            color: !next.live ? muted : late >= 5 ? red : late >= 2 ? yellow : green
          }
        }
      }
    }
  }

  screen {
    title: str.title
    Column {
      scroll: true
      gap: 8
      Text { text: stopName == "" ? str.yourStop : stopName; style: label; color: muted }
      Input { placeholder: stopName == "" ? str.search : str.change; clear: true; onSubmit: { query = value; refresh() } }
      if len(trim(query)) >= 2 {
        if found == null {
          Text { text: str.searching; style: small; color: muted }
        } else {
          if len(stops) == 0 {
            Text { text: found.ok ? str.noStops(query) : str.offline; style: small; color: muted }
          }
          for s in stops key s.id {
            Column {
              gap: 0
              padding: [0, 6]
              onTap: { stopId = s.id; stopName = s.name; route = ""; dir = ""; query = ""; refresh() }
              Text { text: s.name; style: body; maxLines: 1 }
              Text { text: [s.area, s.modes].filter(x => x != "").join(" · "); style: small; color: muted; maxLines: 1 }
            }
          }
        }
      }
      if stopId != "" {
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.yourLine; style: label; color: muted }
        if problem != null {
          Text { text: problem; style: small; color: muted }
        } else if board == null {
          Text { text: "…"; style: small; color: muted }
        }
        Row {
          gap: 10
          align: center
          padding: [4, 6]
          background: route == "" ? alpha(accent, 0.2) : null
          radius: 8
          onTap: { route = ""; dir = "" }
          Text { text: str.anyLine; style: body; weight: 1 }
          Text { text: str.whatever; style: small; color: muted }
        }
        for l in lines key "${l.route}|${l.dir}" {
          Row {
            gap: 10
            align: center
            padding: [4, 6]
            background: l.route == route && l.dir == dir ? alpha(accent, 0.2) : null
            radius: 8
            onTap: { route = l.route; dir = l.dir }
            Badge { r: l; size: 13 }
            Text { text: str.to(l.to); style: body; maxLines: 1; weight: 1 }
          }
        }
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.walkTo; style: label; color: muted }
        Row {
          gap: 12
          align: center
          Button { text: "−"; onTap: walk = max(walk - 1, 0) }
          Text { text: str.mins(walk); style: body; width: 70; align: center }
          Button { text: "+"; onTap: walk = min(walk + 1, 60) }
        }
        Text { text: str.data; style: label; color: muted }
      }
      Spacer { height: 12 }
    }
  }
}
