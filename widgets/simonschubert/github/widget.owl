widget "github" {
  meta { description: "Unread GitHub notifications, reviews waiting on you and your open pull requests, via the GitHub CLI"; version: "1.3"; license: "MIT"; category: "dev"; owl: 16 }

  // What it says, in the phone's language where it has a set.
  strings {
    en { notSignedIn: "the GitHub CLI isn't signed in"; signIn: "sign in"; unread: "unread"; reviews: "reviews"; mine: "my prs" }
    id { notSignedIn: "GitHub CLI belum masuk"; signIn: "masuk"; unread: "belum dibaca"; reviews: "review"; mine: "pr saya" }
    es { notSignedIn: "la CLI de GitHub no tiene sesión iniciada"; signIn: "iniciar sesión"; unread: "sin leer"; reviews: "revisiones"; mine: "mis prs" }
    pt { notSignedIn: "o GitHub CLI não está conectado"; signIn: "entrar"; unread: "não lidas"; reviews: "revisões"; mine: "meus prs" }
    de { notSignedIn: "die GitHub CLI ist nicht angemeldet"; signIn: "anmelden"; unread: "ungelesen"; reviews: "reviews"; mine: "meine prs" }
  }
  size: 6x4
  minSize: 3x3

  requires { pacman: ["github-cli", "jq"] }

  source gh = cmd("""
    gh auth status >/dev/null 2>&1 || { echo '{"auth": false}'; exit; }
    jq -nc \
      --argjson unread "$(gh api notifications --jq length)" \
      --argjson reviews "$(gh search prs --review-requested=@me --state=open --json number --jq length)" \
      --argjson mine "$(gh search prs --author=@me --state=open --limit 8 --json title,url,repository,updatedAt)" \
      '{auth: true, unread: $unread, reviews: $reviews, mine: [$mine[] | {title, url, repo: .repository.name}]}'
  """) every 5m json timeout 30s

  component Count(label, n, hot) {
    Column {
      gap: 0
      Text { text: label; style: label }
      Text { text: "${n}"; style: title; color: n > 0 ? hot : muted }
    }
  }

  onTap: url("https://github.com/notifications")

  Column {
    gap: 6
    Text { text: "github"; style: muted }
    if gh.auth == false {
      Text { text: str.notSignedIn; style: small }
      Button { text: str.signIn; onTap: terminal("gh auth login", "github") }
    } else {
      Row {
        Count { label: str.unread; n: gh.unread; hot: accent; weight: 1 }
        Count { label: str.reviews; n: gh.reviews; hot: yellow; weight: 1 }
        Count { label: str.mine; n: len(gh.mine); hot: foreground; weight: 1 }
      }
      Column {
        scroll: true
        weight: 1
        gap: 4
        for p in gh.mine key p.url {
          Row {
            onTap: url(p.url)
            Text { text: p.repo; fontSize: 11; color: muted; width: 80; maxLines: 1 }
            Text { text: p.title; fontSize: 12; maxLines: 1; weight: 1 }
          }
        }
      }
    }
  }
}
