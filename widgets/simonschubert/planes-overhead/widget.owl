widget "planes overhead" {
  meta { description: "Aircraft around you on a live radar, from the OpenSky Network, located by IP or a city you type, via wttr.in. Tap it for every flight's altitude, speed and distance"; version: "1.3"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. Callsigns and OpenSky's country names stay as they come.
  strings {
    en {
      title: "planes overhead"; city: "city · empty = auto"; locating: "locating…"; unknown: "location unknown"
      listening: "listening…"; limit: "opensky's daily limit is used up"; offline: "opensky offline"
      clear: r => "clear skies within ${r}"; away: (call, d) => "${call} · ${d} away"
      flights: (n, r, place) => "${n} ${n == 1 ? "flight" : "flights"} within ${r} of ${place}"
      data: "data: the opensky network"; map: "live map ↗"
    }
    id {
      title: "pesawat di atas"; city: "kota · kosong = otomatis"; locating: "mencari lokasi…"; unknown: "lokasi tidak diketahui"
      listening: "mendengarkan…"; limit: "batas harian opensky sudah habis"; offline: "opensky offline"
      clear: r => "tak ada pesawat dalam ${r}"; away: (call, d) => "${call} · berjarak ${d}"
      flights: (n, r, place) => "${n} penerbangan dalam ${r} dari ${place}"
      data: "data: opensky network"; map: "peta langsung ↗"
    }
    es {
      title: "aviones cerca"; city: "ciudad · vacío = auto"; locating: "ubicando…"; unknown: "ubicación desconocida"
      listening: "escuchando…"; limit: "se agotó el límite diario de opensky"; offline: "opensky sin conexión"
      clear: r => "ningún avión a ${r} a la redonda"; away: (call, d) => "${call} · a ${d}"
      flights: (n, r, place) => "${n} ${n == 1 ? "vuelo" : "vuelos"} a ${r} de ${place}"
      data: "datos: opensky network"; map: "mapa en vivo ↗"
    }
    pt {
      title: "aviões por perto"; city: "cidade · vazio = auto"; locating: "localizando…"; unknown: "local desconhecido"
      listening: "ouvindo…"; limit: "o limite diário do opensky acabou"; offline: "opensky offline"
      clear: r => "nenhum avião num raio de ${r}"; away: (call, d) => "${call} · a ${d}"
      flights: (n, r, place) => "${n} ${n == 1 ? "voo" : "voos"} num raio de ${r} de ${place}"
      data: "dados: opensky network"; map: "mapa ao vivo ↗"
    }
    de {
      title: "flieger über dir"; city: "stadt · leer = auto"; locating: "suche standort…"; unknown: "standort unbekannt"
      listening: "lausche…"; limit: "das tageslimit von opensky ist aufgebraucht"; offline: "opensky offline"
      clear: r => "keine flieger im umkreis von ${r}"; away: (call, d) => "${call} · ${d} entfernt"
      flights: (n, r, place) => "${n} ${n == 1 ? "flug" : "flüge"} im umkreis von ${r} um ${place}"
      data: "daten: opensky network"; map: "live-karte ↗"
    }
  }
  size: 3x3
  minSize: 2x2

  source now = clock every 1s
  state city = "" persist
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // Where you are. The same request as the today widget, so the two share it.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let area = wx.nearest_area[0]
  let lat = num(area.latitude)
  let lon = num(area.longitude)
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value)))
  // 45 km, or 30 miles, in three rings.
  let km = imperial ? 48.28 : 45
  let range = imperial ? "30 mi" : "45 km"
  // A box a little larger than the radar (0.5° is 55 km); longitude degrees shrink toward the poles.
  let dLat = 0.5
  let dLon = 0.5 / max(cos(rad(lat)), 0.2)
  // Anonymous OpenSky allows 400 requests a day; this runs only while its page is on screen.
  source sky = http("https://opensky-network.org/api/states/all?lamin=${fixed(lat - dLat, 3)}&lomin=${fixed(lon - dLon, 3)}&lamax=${fixed(lat + dLat, 3)}&lomax=${fixed(lon + dLon, 3)}") every 2m timeout 15s json status
  // The first request goes out before the location is known; ask again once it is.
  when lat != null { refresh() }
  // And again when a new city moves it.
  on lat { refresh() }

  // OpenSky's state vectors: [icao24, callsign, country, time_position, last_contact, lon, lat,
  // baro_altitude, on_ground, velocity, true_track, vertical_rate, sensors, geo_altitude, ...].
  // Positions are carried forward along each plane's track, so the radar moves between requests.
  let planes = (sky.ok ? sky.out.states ?? [] : [])
    .filter(s => !s[8] && s[5] != null && s[6] != null)
    .map(s => {
      id: s[0],
      call: trim(s[1] ?? "") == "" ? upper(s[0]) : trim(s[1]),
      country: s[2],
      alt: s[7] ?? s[13] ?? 0,
      speed: s[9] ?? 0,
      track: s[10] ?? 0,
      climb: s[11] ?? 0,
      x: (s[5] - lon) * 111.32 * cos(rad(lat)) + sin(rad(s[10] ?? 0)) * (s[9] ?? 0) * clamp(now - s[3], 0, 180) / 1000,
      y: (s[6] - lat) * 110.57 + cos(rad(s[10] ?? 0)) * (s[9] ?? 0) * clamp(now - s[3], 0, 180) / 1000
    })
  let flights = planes.filter(p => p.x * p.x + p.y * p.y <= km * km).sortBy(p => p.x * p.x + p.y * p.y)
  let nearest = first(flights)
  let problem = wx == null ? str.locating : lat == null ? str.unknown : sky == null ? str.listening : sky.code == 429 ? str.limit : !sky.ok ? str.offline : null

  onTap: screen()

  // Low planes are warm, cruising ones cool.
  component Plane(alt, track, s = 6) {
    Canvas {
      size: s * 2 + 4
      let c = s + 2
      rotate(track, c, c) {
        path([[c, c - s], [c + s * 0.7, c + s * 0.7], [c, c + s * 0.3], [c - s * 0.7, c + s * 0.7]], closed: true, fill: alt < 3000 ? orange : alt < 8000 ? yellow : cyan)
      }
    }
  }

  component Radar(list, labels = false) {
    Canvas {
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2 - 2
      let s = r / km
      let p = max(r / 20, 3.5)
      circle(cx, cy, r, fill: alpha(surface, 0.4), stroke: border, width: 1)
      circle(cx, cy, r * 2 / 3, stroke: alpha(muted, 0.3), width: 1)
      circle(cx, cy, r / 3, stroke: alpha(muted, 0.3), width: 1)
      line(cx - r, cy, cx + r, cy, stroke: alpha(muted, 0.2), width: 1)
      line(cx, cy - r, cx, cy + r, stroke: alpha(muted, 0.2), width: 1)
      // The sweep, once every four seconds.
      rotate(time * 90 % 360, cx, cy) {
        arc(cx, cy, r, -45, 45, fill: alpha(accent, 0.12))
        line(cx, cy, cx, cy - r, stroke: alpha(accent, 0.7), width: 1.5)
      }
      if labels {
        text(imperial ? "10 mi" : "15 km", cx + 4, cy - r / 3 - 7, size: 10, color: muted)
        text(imperial ? "20 mi" : "30 km", cx + 4, cy - r * 2 / 3 - 7, size: 10, color: muted)
        text("N", cx, cy - r + 9, size: 10, align: center, color: muted)
      }
      for f in list {
        rotate(f.track, cx + f.x * s, cy - f.y * s) {
          let px = cx + f.x * s
          let py = cy - f.y * s
          path([[px, py - p], [px + p * 0.7, py + p * 0.7], [px, py + p * 0.3], [px - p * 0.7, py + p * 0.7]], closed: true, fill: f.alt < 3000 ? orange : f.alt < 8000 ? yellow : cyan)
        }
        if labels {
          text(f.call, cx + f.x * s + p + 3, cy - f.y * s, size: 10, color: foreground)
        }
      }
      circle(cx, cy, 3, fill: foreground)
    }
  }

  Column {
    gap: 4
    Row {
      Text { text: str.title; style: muted; weight: 1; maxLines: 1 }
      Text { text: problem == null ? len(flights) : ""; style: muted; width: 32; align: end }
    }
    Box {
      weight: 1
      fill: width
      Radar { list: flights; labels: cols >= 4 && rows >= 4; fill: true }
      if problem != null {
        Text { text: problem; style: small; color: muted; align: center }
      }
    }
    if rows >= 3 {
      Text {
        text: problem != null ? "" : nearest == null ? str.clear(range) : str.away(nearest.call, imperial ? "${round(sqrt(nearest.x * nearest.x + nearest.y * nearest.y) / 1.609)} mi" : "${round(sqrt(nearest.x * nearest.x + nearest.y * nearest.y))} km")
        style: small
        maxLines: 1
      }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    Column {
      scroll: true
      gap: 10
      Radar { list: flights; labels: true; height: min(screenWidth - 32, screenHeight * 0.55); fill: width }
      Text {
        text: problem ?? str.flights(len(flights), range, lower(area.areaName[0].value))
        style: small
        color: muted
      }
      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
      for f in flights key f.id {
        Row {
          gap: 10
          align: center
          onTap: url("https://globe.adsbexchange.com/?icao=${f.id}")
          Plane { alt: f.alt; track: f.track; s: 8 }
          Column {
            gap: 0
            weight: 1
            Text { text: f.call; font: mono; bold: true; maxLines: 1 }
            Text { text: lower(f.country); style: small; color: muted; maxLines: 1 }
          }
          Column {
            gap: 0
            width: 96
            Text { text: "${imperial ? "${round(f.alt * 3.281 / 100) * 100} ft" : "${round(f.alt / 10) * 10} m"} ${f.climb > 1 ? "↑" : f.climb < -1 ? "↓" : ""}"; style: small; align: end; maxLines: 1 }
            Text { text: imperial ? "${round(f.speed * 2.237)} mph" : "${round(f.speed * 3.6)} km/h"; style: small; color: muted; align: end; maxLines: 1 }
          }
          Text {
            text: imperial ? "${round(sqrt(f.x * f.x + f.y * f.y) / 1.609)} mi" : "${round(sqrt(f.x * f.x + f.y * f.y))} km"
            style: small
            color: accent
            width: 48
            align: end
          }
        }
      }
      Row {
        gap: 8
        align: center
        Text { text: str.data; style: label; color: muted; weight: 1 }
        Button { text: str.map; color: muted; onTap: url("https://globe.adsbexchange.com/?lat=${lat}&lon=${lon}&zoom=9") }
      }
    }
  }
}
