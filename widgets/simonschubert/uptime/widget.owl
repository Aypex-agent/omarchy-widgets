widget "uptime" {
  meta { description: "Up or down, HTTP status and response time for the sites listed in ~/.config/omarchy-proot/uptime"; version: "1.3"; license: "MIT"; category: "dev"; owl: 16 }

  // What it says, in the phone's language where it has a set. A timeout stays "timeout": its column fits about 9 letters.
  strings {
    en { title: "uptime"; down: n => "${n} down"; allUp: "all up" }
    id { title: "uptime"; down: n => "${n} mati"; allUp: "semua aktif" }
    es { title: "uptime"; down: n => "${n} caídos"; allUp: "todo en línea" }
    pt { title: "uptime"; down: n => "${n} fora do ar"; allUp: "tudo no ar" }
    de { title: "uptime"; down: n => "${n} offline"; allUp: "alle online" }
  }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl"] }

  // One URL per line, checked in parallel. The file starts with two examples.
  source checks = cmd("""
    f=~/.config/omarchy-proot/uptime
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'https://archlinux.org\nhttps://github.com\n' > "$f"
    grep -v '^#' "$f" | grep . | xargs -P 8 -I{} curl -o /dev/null -s -m 8 -w '%{http_code} %{time_total} {}\n' {}
  """) every 1m timeout 20s
  // "200 0.31 https://github.com" -> {code, ms, url}
  let sites = lines(checks).filter(l => l != "").map(l => { code: num(words(l)[0]), ms: round(num(words(l)[1]) * 1000), url: words(l)[2] }).sortBy(s => s.url)
  let down = count(sites, s => s.code == 0 || s.code >= 400)

  onTap: terminal('$EDITOR ~/.config/omarchy-proot/uptime', "uptime")

  Column {
    gap: 4
    Row {
      Text { text: str.title; style: muted; weight: 1 }
      Text { text: down > 0 ? str.down(down) : str.allUp; fontSize: 12; color: down > 0 ? red : green; width: 96; align: end }
    }
    Column {
      scroll: true
      weight: 1
      gap: 4
      for s in sites key s.url {
        let ok = s.code > 0 && s.code < 400
        Row {
          align: center
          onTap: url(s.url)
          Box { size: 8; radius: 4; background: ok ? green : red }
          Text { text: replace(replace(s.url, "https://", ""), "http://", ""); fontSize: 12; maxLines: 1; weight: 1 }
          Text { text: ok ? "${s.ms} ms" : s.code == 0 ? "timeout" : "${s.code}"; fontSize: 12; color: ok ? muted : red; width: 64; align: end }
        }
      }
    }
  }
}
