widget "departures" {
  size: 3x2
  minSize: 2x1
  requires { pacman: [] }
  meta { description: "Live departures from a stop you pick, anywhere Transitous has open timetables: line, direction, platform and minutes to go, with delays. Tap the tile for the full board or to change the stop"; version: "1.6"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. Stops, lines, directions and modes come as Transitous names them.
  strings {
    en {
      title: "departures"; pick: "Tap to pick a stop."; noneSoon: "no departures soon"; now: "now"; min: "min"
      tooMany: "too many requests"; offline: "transitous offline"; search: "search for a stop"; change: "change stop"
      searching: "searching…"; noStops: q => "no stops called “${q}”"; next: "next departures"; refresh: "refresh"
      data: "data: Transitous, from open timetables. Delays show where the operator publishes live times"
    }
    id {
      title: "keberangkatan"; pick: "Ketuk untuk memilih halte."; noneSoon: "belum ada keberangkatan"; now: "kini"; min: "mnt"
      tooMany: "terlalu banyak permintaan"; offline: "transitous offline"; search: "cari halte"; change: "ganti halte"
      searching: "mencari…"; noStops: q => "tidak ada halte bernama “${q}”"; next: "keberangkatan berikutnya"; refresh: "muat ulang"
      data: "data: Transitous, dari jadwal terbuka. Keterlambatan muncul jika operator menerbitkan waktu langsung"
    }
    es {
      title: "salidas"; pick: "Toca para elegir una parada."; noneSoon: "no hay salidas pronto"; now: "ahora"; min: "min"
      tooMany: "demasiadas solicitudes"; offline: "transitous sin conexión"; search: "busca una parada"; change: "cambiar parada"
      searching: "buscando…"; noStops: q => "no hay paradas llamadas “${q}”"; next: "próximas salidas"; refresh: "actualizar"
      data: "datos: Transitous, de horarios abiertos. Los retrasos aparecen donde el operador publica horarios en tiempo real"
    }
    pt {
      title: "partidas"; pick: "Toque para escolher uma parada."; noneSoon: "nenhuma partida em breve"; now: "agora"; min: "min"
      tooMany: "pedidos demais"; offline: "transitous offline"; search: "procure uma parada"; change: "trocar parada"
      searching: "procurando…"; noStops: q => "nenhuma parada chamada “${q}”"; next: "próximas partidas"; refresh: "atualizar"
      data: "dados: Transitous, de horários abertos. Atrasos aparecem onde a operadora publica horários em tempo real"
    }
    de {
      title: "abfahrten"; pick: "Tippe, um eine Haltestelle zu wählen."; noneSoon: "erstmal keine abfahrten"; now: "jetzt"; min: "min"
      tooMany: "zu viele anfragen"; offline: "transitous offline"; search: "haltestelle suchen"; change: "haltestelle ändern"
      searching: "suche…"; noStops: q => "keine haltestelle namens „${q}“"; next: "nächste abfahrten"; refresh: "aktualisieren"
      data: "daten: Transitous, aus offenen fahrplänen. Verspätungen siehst du, wo der Betreiber Live-Zeiten veröffentlicht"
    }
    zh {
      title: "发车"; pick: "点按选择一个站点。"; noneSoon: "近期没有发车"; now: "现在"; min: "分钟"
      tooMany: "请求过多"; offline: "transitous 离线"; search: "搜索站点"; change: "更换站点"
      searching: "正在搜索…"; noStops: q => "没有叫“${q}”的站点"; next: "即将发车"; refresh: "刷新"
      data: "数据：Transitous，来自公开时刻表。运营方公布实时时间的线路会显示延误"
    }
  }

  // The stop, picked in the full screen and kept across restarts. No location is hard-coded.
  state stopId = "" persist
  state stopName = "" persist
  // The last three stops picked, as buttons under the search.
  state recent = [] persist
  state query = ""

  // Some stops come as "Name,  -"; drop the empty tail.
  let displayName = replace(replace(stopName, ",  -", ""), ", -", "")

  source now = clock every 15s
  // Transitous (https://transitous.org) asks clients to name themselves.
  let ua = {"User-Agent": "omarchy-widgets/departures (+https://github.com/SimonSchubert/omarchy-widgets)"}

  // A null URL makes no request.
  source found = http(len(trim(query)) < 2 ? null : "https://api.transitous.org/api/v1/geocode?type=STOP&text=${enc(trim(query))}", ua) every 1h timeout 15s json status
  source board = http(stopId == "" ? null : "https://api.transitous.org/api/v6/stoptimes?stopId=${enc(stopId)}&n=20", ua) every 30s timeout 15s json status

  let stops = (found != null && found.ok ? found.out ?? [] : []).take(8).map(s => {
    id: s.id,
    name: replace(replace(s.name, ",  -", ""), ", -", ""),
    area: (s.areas ?? []).find(a => a.default == true).name ?? s.country ?? "",
    modes: lower(join((s.modes ?? []).take(3), ", "))
  })
  let rows = (board != null && board.ok ? board.out.stopTimes ?? [] : []).map(s => {
    key: "${s.tripId}${s.place.scheduledDeparture}",
    line: s.routeShortName != null && s.routeShortName != "?" ? s.routeShortName : s.displayName ?? s.mode ?? "",
    color: s.routeColor ?? "",
    text: s.routeTextColor ?? "",
    to: s.headsign ?? s.tripTo.name ?? "",
    at: floor(num(sub(s.place.departure ?? s.place.arrival ?? "", 11, 13))) * 60 + floor(num(sub(s.place.departure ?? s.place.arrival ?? "", 14, 16))),
    planned: floor(num(sub(s.place.scheduledDeparture ?? s.place.scheduledArrival ?? "", 11, 13))) * 60 + floor(num(sub(s.place.scheduledDeparture ?? s.place.scheduledArrival ?? "", 14, 16))),
    track: s.place.track ?? s.place.scheduledTrack,
    moved: s.place.track != null && s.place.scheduledTrack != null && s.place.track != s.place.scheduledTrack,
    live: s.realTime == true,
    cancelled: s.cancelled == true || s.tripCancelled == true
  })
  let problem = stopId == "" || board == null || board.ok ? null : board.code == 429 ? str.tooMany : str.offline
  // Times are "2026-10-09T23:32:00Z" and the board only looks ahead, so minutes of the UTC day are enough:
  // a departure is (at - nowMin) mod 1440 minutes away, and one that wraps to ~1439 has just left.
  let nowMin = floor(now % 86400 / 60)
  let upcoming = rows.filter(r => (r.at - nowMin + 1440) % 1440 < 1380)
  // The next departure large (~40dp under the ~16dp stop name), then as many smaller ones (~26dp) as fit.
  let shown = upcoming.take(tileHeight == null ? 2 : clamp(1 + floor((tileHeight - 70) / 26), 1, 15))
  let showName = tileHeight == null || tileHeight >= 64
  let narrow = cols != null && cols <= 2

  onTap: screen()

  component Badge(r, w = 44) {
    Text {
      text: r.line
      style: label
      bold: true
      color: r.text != "" ? "#${r.text}" : foreground
      background: r.color != "" ? "#${r.color}" : alpha(accent, 0.25)
      padding: [4, 1]
      radius: 4
      width: w
      align: center
      maxLines: 1
    }
  }

  // The countdown is what matters: big, and colored only by a live delay.
  component Departure(r, now, nowMin, mode = "tile") {
    Column {
      gap: 0
      let left = (r.at - nowMin + 1440) % 1440
      let at = now - now % 60 + left * 60
      let raw = (r.at - r.planned + 1440) % 1440
      let delay = raw > 720 ? raw - 1440 : raw
      let tint = r.cancelled ? red : !r.live ? foreground : delay >= 5 ? red : delay >= 2 ? yellow : foreground
      let big = r.cancelled ? "×" : left == 0 ? str.now : left < 60 ? "${left}" : fmtTime(at, "HH:mm")
      let unit = r.cancelled || left == 0 || left >= 60 ? "" : str.min
      if mode == "list" {
        Row {
          align: center
          gap: 8
          Badge { r: r; w: 54 }
          Text { text: r.to; style: small; color: r.cancelled ? muted : foreground; maxLines: 1; weight: 1 }
          if r.track != null {
            Text { text: "${r.track}"; style: label; color: r.moved ? orange : muted; maxLines: 1; width: 28; align: end }
          }
          Text { text: fmtTime(at, "HH:mm"); style: label; color: muted; font: mono; width: 40; align: end }
          Text { text: unit == "" ? big : "${big}′"; style: body; bold: true; font: mono; color: tint; width: 52; align: end; maxLines: 1 }
        }
      } else {
        // "14 min  M36  U Haselhorst": the minutes first and largest, then the line, then where it goes.
        let lead = mode == "big"
        // A two-column tile is ~110dp inside: everything a quarter smaller, and the line gives way last.
        let k = narrow ? 0.75 : 1
        Row {
          align: bottom
          gap: narrow ? 3 : 6
          // A Text without a width fills the row, so each gets its own: monospace is ~0.6em a character.
          Text { text: big; fontSize: (lead ? 30 : 18) * k; bold: true; font: mono; color: tint; maxLines: 1; width: len(big) * (lead ? 30 : 18) * k * 0.62 + 2 }
          if unit != "" {
            Text { text: unit; fontSize: (lead ? 14 : 12) * k; color: lead ? foreground : muted; padding: [0, 0, 0, (lead ? 5 : 2) * k]; width: 3 * (lead ? 14 : 12) * k * 0.62 + 2 }
          }
          Text {
            text: r.line
            fontSize: (lead ? 20 : 14) * k
            bold: true
            color: lead ? foreground : muted
            padding: [narrow ? 2 : 4, 0, 0, (lead ? 3 : 1) * k]
            maxLines: 1
            width: narrow ? null : len(r.line) * (lead ? 20 : 14) * 0.62 + 6
            weight: narrow ? 1 : null
          }
          if !narrow {
            Text { text: r.to; style: label; color: muted; maxLines: 1; weight: 1; padding: [0, 0, 0, lead ? 6 : 3] }
          }
        }
      }
    }
  }

  Column {
    gap: 2
    justify: center
    if showName {
      Text { text: displayName == "" ? str.title : displayName; style: label; color: muted; maxLines: 1 }
    }
    if stopId == "" {
      Text { text: str.pick; style: small; color: muted }
    } else {
      if board == null {
        Text { text: "…"; fontSize: 30; bold: true; font: mono; color: muted }
      } else {
        if problem != null {
          Text { text: problem; style: small; color: muted }
        } else {
          if len(upcoming) == 0 {
            Text { text: str.noneSoon; style: small; color: muted }
          }
          for r, i in shown key r.key {
            Departure { r: r; now: now; nowMin: nowMin; mode: i == 0 ? "big" : "small" }
          }
        }
      }
    }
  }

  screen {
    title: displayName == "" ? str.title : displayName
    Column {
      scroll: true
      gap: 8
      Input { placeholder: stopName == "" ? str.search : str.change; clear: true; onSubmit: { query = value; refresh() } }
      if len(recent) > 0 {
        Row {
          fill: width
          gap: 6
          for r in recent key r.id {
            Box {
              weight: 1
              background: r.id == stopId ? alpha(accent, 0.25) : alpha(muted, 0.15)
              radius: 8
              padding: [4, 6]
              align: center
              onTap: { stopId = r.id; stopName = r.name; refresh() }
              Text { text: r.name; style: small; color: r.id == stopId ? foreground : muted; maxLines: 1 }
            }
          }
        }
      }
      if len(trim(query)) >= 2 {
        if found == null {
          Text { text: str.searching; style: small; color: muted }
        } else {
          if len(stops) == 0 {
            Text { text: found.ok ? str.noStops(query) : str.offline; style: small; color: muted }
          }
          for s in stops key s.id {
            Column {
              gap: 0
              padding: [0, 6]
              onTap: {
                recent = ([{id: s.id, name: s.name}] + recent.filter(x => x.id != s.id)).take(3)
                stopId = s.id; stopName = s.name; query = ""; refresh()
              }
              Text { text: s.name; style: body; maxLines: 1 }
              Text { text: [s.area, s.modes].filter(x => x != "").join(" · "); style: small; color: muted; maxLines: 1 }
            }
          }
          Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        }
      }
      if stopId != "" {
        Row {
          align: center
          Text { text: str.next; style: label; color: muted; weight: 1 }
          Button { text: str.refresh; color: muted; onTap: refresh() }
        }
        if problem != null {
          Text { text: problem; style: body; color: muted }
        }
        for r in upcoming key r.key {
          Departure { r: r; now: now; nowMin: nowMin; mode: "list" }
        }
        Text { text: str.data; style: label; color: muted }
      }
      Spacer { height: 12 }
    }
  }
}
