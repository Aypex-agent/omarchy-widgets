widget "calendar" {
  meta { description: "This month's calendar with today highlighted"; version: "1.3"; license: "MIT"; category: "productivity"; owl: 16 }
  size: 3x3

  // The month's title as each language writes it (the phone names the month), and the weekdays' letters from Monday.
  strings {
    en { month: "MMMM yyyy"; days: ["M", "T", "W", "T", "F", "S", "S"] }
    id { month: "MMMM yyyy"; days: ["S", "S", "R", "K", "J", "S", "M"] }
    es { month: "MMMM 'de' yyyy"; days: ["L", "M", "X", "J", "V", "S", "D"] }
    pt { month: "MMMM 'de' yyyy"; days: ["S", "T", "Q", "Q", "S", "S", "D"] }
    de { month: "MMMM yyyy"; days: ["M", "D", "M", "D", "F", "S", "S"] }
    zh { month: "yyyy年M月"; days: ["一", "二", "三", "四", "五", "六", "日"] }
    ru { month: "LLLL yyyy"; days: ["П", "В", "С", "Ч", "П", "С", "В"] }
    ja { month: "yyyy年M月"; days: ["月", "火", "水", "木", "金", "土", "日"] }
    uk { month: "LLLL yyyy"; days: ["П", "В", "С", "Ч", "П", "С", "Н"] }
    fr { month: "MMMM yyyy"; days: ["L", "M", "M", "J", "V", "S", "D"] }
    tr { month: "MMMM yyyy"; days: ["P", "S", "Ç", "P", "C", "C", "P"] }
    it { month: "MMMM yyyy"; days: ["L", "M", "M", "G", "V", "S", "D"] }
  }
  source now = clock every 60s
  // Date math with only fmtTime: first weekday of the month, days in the month.
  let day = num(fmtTime(now, "d"))
  let first = now - (day - 1) * 86400
  let offset = num(fmtTime(first, "e")) - 1
  let days = 32 - num(fmtTime(first + 31 * 86400, "d"))
  Column {
    gap: 4
    Text { text: fmtTime(now, str.month); style: small; color: accent }
    Grid {
      columns: 7
      gap: 2
      for d in str.days { Text { text: d; fontSize: 9; color: muted; align: center } }
      for i in range(offset + days) {
        Text {
          text: i < offset ? "" : str(i - offset + 1)
          fontSize: 10; align: center
          color: i - offset + 1 == day ? background : foreground
          background: i - offset + 1 == day ? accent : transparent
        }
      }
    }
  }
}
