widget "habits" {
  meta { description: "A daily habit tracker: tap a habit to check it off for today, with the last week and your streak. Habits are listed in ~/.config/omarchy-proot/habits"; version: "1.4"; license: "MIT"; category: "productivity"; owl: 16 }
  size: 6x3
  minSize: 4x2

  // edit sits in a 56dp column at 11sp, the streak in 36dp at 12sp: short words.
  strings {
    en { title: "habits"; edit: "edit"; days: n => "${n}d" }
    id { title: "kebiasaan"; edit: "edit"; days: n => "${n}h" }
    es { title: "hábitos"; edit: "editar"; days: n => "${n}d" }
    pt { title: "hábitos"; edit: "editar"; days: n => "${n}d" }
    de { title: "gewohnheiten"; edit: "ändern"; days: n => "${n}t" }
    zh { title: "习惯"; edit: "编辑"; days: n => "${n}天" }
    ru { title: "привычки"; edit: "изменить"; days: n => "${n}д" }
    ja { title: "習慣"; edit: "編集"; days: n => "${n}日" }
    uk { title: "звички"; edit: "змінити"; days: n => "${n}д" }
    fr { title: "habitudes"; edit: "modifier"; days: n => "${n}j" }
    tr { title: "alışkanlıklar"; edit: "düzenle"; days: n => "${n}g" }
    it { title: "abitudini"; edit: "modifica"; days: n => "${n}g" }
  }

  // One habit per line in the file. Check-ins are kept by the launcher as "habit@yyyy-MM-dd".
  source names = cmd("""
    f=~/.config/omarchy-proot/habits
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'exercise\nread\ndrink water\n' > "$f"
    grep -v '^#' "$f" | grep .
  """) every 5m
  source now = clock every 60s
  state done = [] persist
  let habits = lines(names).map(l => trim(l)).filter(l => l != "")
  // Days counted back from noon, so summer time never skips or repeats a date.
  let noon = now - num(fmtTime(now, "H")) * 3600 - num(fmtTime(now, "m")) * 60 + 12 * 3600
  // A tall tile (the landscape home screen) has no room for name, week and streak on one line:
  // the week goes on a second line under the name there.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  let days = range(60).map(i => fmtTime(noon - i * 86400, "yyyy-MM-dd"))

  Column {
    gap: 6
    Row {
      onTap: terminal('$EDITOR ~/.config/omarchy-proot/habits', "habits")
      Text { text: str.title; style: muted; weight: 1 }
      Text { text: str.edit; fontSize: 11; color: muted; width: 56; align: end }
    }
    Column {
      scroll: true
      weight: 1
      gap: 8
      for h in habits key h {
        let hits = days.map(d => contains(done, "${h}@${d}"))
        let key = "${h}@${days[0]}"
        // A streak still counts today until it's over: it runs up to yesterday if today isn't checked yet.
        let run = hits[0] ? hits : drop(hits, 1)
        let streak = indexOf(run, false) < 0 ? len(run) : indexOf(run, false)
        Row {
          align: center
          onTap: done = hits[0] ? done.filter(k => k != key) : drop(done + [key], max(len(done) + 1 - 600, 0))
          Box {
            size: 18; radius: 4; border: 1.5
            borderColor: hits[0] ? accent : muted
            background: hits[0] ? accent : transparent
            animate background: tween(200ms, "ease")
          }
          if tall {
            Column {
              weight: 1
              gap: 4
              Row {
                align: center
                Text { text: h; fontSize: 13; maxLines: 1; weight: 1 }
                Text { text: streak > 0 ? str.days(streak) : ""; fontSize: 12; color: streak >= 7 ? green : muted; width: 36; align: end }
              }
              Row {
                gap: 3
                for i in range(7) { Box { size: 8; radius: 4; background: hits[6 - i] ? accent : alpha(muted, 0.3) } }
              }
            }
          } else {
            Text { text: h; fontSize: 13; maxLines: 1; weight: 1 }
            Row {
              gap: 3
              width: 74
              for i in range(7) { Box { size: 8; radius: 4; background: hits[6 - i] ? accent : alpha(muted, 0.3) } }
            }
            Text { text: streak > 0 ? str.days(streak) : ""; fontSize: 12; color: streak >= 7 ? green : muted; width: 36; align: end }
          }
        }
      }
    }
  }
}
