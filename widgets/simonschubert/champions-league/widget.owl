widget "champions-league" {
  meta {
    owl: 16
    description: "UEFA Champions League results, live scores and kick-offs from ESPN with club crests, and the league phase table with knockout places. Tap for every match"
    version: "1.3"
    license: "MIT"
    category: "sport"
  }
  requires { pacman: ["curl", "jq"] }
  // What it says, in the phone's language where it has a set. Club names and ESPN's match minute
  // (45', HT, FT) come as ESPN writes them.
  strings {
    en { matches: "matches"; table: "table"; loading: "loading…"; none: "no matches this week"; close: "close"; live: n => "${n} live" }
    id { matches: "laga"; table: "klasemen"; loading: "memuat…"; none: "tidak ada laga minggu ini"; close: "tutup"; live: n => "${n} live" }
    es { matches: "partidos"; table: "tabla"; loading: "cargando…"; none: "no hay partidos esta semana"; close: "cerrar"; live: n => "${n} en vivo" }
    pt { matches: "jogos"; table: "tabela"; loading: "carregando…"; none: "nenhum jogo nesta semana"; close: "fechar"; live: n => "${n} ao vivo" }
    de { matches: "spiele"; table: "tabelle"; loading: "lädt…"; none: "diese woche keine spiele"; close: "schließen"; live: n => "${n} live" }
  }
  size: 6x4
  minSize: 3x3

  // ESPN's scoreboard only answers one day at a time, so this asks for the last
  // three days and the next six, and keeps only what the tile shows. Crests are
  // referred to by file name, kept to [a-z0-9].png.
  source games = cmd("""
    u=https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard
    # One curl for all the days, so one process and connection rather than one each, and the dates from bash itself.
    printf -v now '%(%s)T' -1
    urls=(); for i in -3 -2 -1 0 1 2 3 4 5 6; do printf -v d '%(%Y%m%d)T' $((now + i * 86400)); urls+=("$u?dates=$d"); done
    curl -fsm 10 --compressed "${urls[@]}" | jq -sc '[.[].events[] | .competitions[0] as $c | {
      id, at: (.date[0:16] + ":00Z" | fromdateiso8601),
      state: $c.status.type.state, detail: $c.status.type.shortDetail,
      teams: [$c.competitors[] | {
        side: .homeAway, abbr: .team.abbreviation, name: .team.shortDisplayName, score, winner: (.winner // false),
        logo: ((.team.logo // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end)
      }]
    }] | unique_by(.id) | sort_by(.at)'
  """) every 5m json timeout 60s

  // The table, with each club's crest fetched once into ~/.cache/espn-logos and
  // left there, at 96 px. Zones come from ESPN's notes (Champions League, relegation...).
  source table = cmd("""
    d=~/.cache/espn-logos/soccer
    mkdir -p "$d"
    t=$(curl -fsm 20 --compressed https://site.api.espn.com/apis/v2/sports/soccer/uefa.champions/standings | jq -c '[.children[] | {
      name, teams: [.standings.entries[] | (reduce .stats[] as $s ({}; .[$s.name] = ($s.value // 0 | floor))) as $st | {
        id: .team.id, abbr: .team.abbreviation, name: .team.shortDisplayName,
        logo: ((.team.logos[0].href // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end),
        rank: $st.rank, played: $st.gamesPlayed, won: $st.wins, drawn: $st.ties, lost: $st.losses,
        gd: $st.pointDifferential, pts: $st.points,
        zone: ((.note.description // "") | ascii_downcase | if . == "" then null
          elif test("relegat") and test("playoff") then "orange"
          elif test("relegat|eliminat") then "red"
          elif test("champions league$|round of 16") then "green"
          else "blue" end)
      }] | sort_by(.rank)
    }]') || exit 1
    for f in $(printf '%s' "$t" | jq -r '.[].teams[].logo | select(. != "")'); do
      [ -s "$d/$f" ] || curl -fsm 15 -o "$d/$f" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/soccer/500/$f&w=96&h=96" || rm -f "$d/$f"
    done
    printf '%s\n' "$t"
  """) every 30m json timeout 120s
  source now = clock every 1m

  state view = "matches"

  let all = games ?? []
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live, done.take(ceil(cap / 2)), next]).take(cap)
  let groups = table ?? []
  // Full club names need room: the tile decides from its own width (the landscape tile, ~290dp,
  // gets abbreviations), the full screen from the screen's.
  let tileWide = (tileWidth ?? 0) >= 360
  let screenWide = max(max(screenWidth ?? 0, tileWidth ?? 0), 240) >= 280

  component Crest(logo, px = 18) {
    if logo {
      Image { src: "~/.cache/espn-logos/soccer/${logo}"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  component GameRow(g, wide = false) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = wide ? 18 : 14
    let scW = wide ? 24 : 18
    let dotW = wide ? 8 : 6
    let stW = wide ? 72 : 34
    let ctrW = 2 * scW + 2 * dotW + stW

    // Home on the left, as football lists it; the centre keeps one width so the
    // crests and names line up down the list.
    Row {
      gap: wide ? 8 : 4
      Crest { logo: home.logo; px: px }
      Text { text: wide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; color: final && away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, "EEE HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: home.score ?? '–'; style: small; width: scW; align: end; bold: final && home.winner; color: live ? accent : final && away.winner ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: away.score ?? '–'; style: small; width: scW; align: start; bold: final && away.winner; color: live ? accent : final && home.winner ? muted : foreground }
        }
      }
      Text { text: wide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && home.winner ? muted : foreground }
      Crest { logo: away.logo; px: px }
    }
  }

  component TeamRow(t, full = false, wide = false) {
    let zc = t.zone == 'green' ? green : t.zone == 'blue' ? blue : t.zone == 'orange' ? orange : t.zone == 'red' ? red : rgb(0, 0, 0, 0)
    Row {
      gap: 6
      Box { width: 3; height: 14; radius: 1.5; background: zc }
      Text { text: t.rank; width: 20; style: small; color: muted; align: end }
      Crest { logo: t.logo; px: 16 }
      Text { text: wide ? t.name : t.abbr; weight: 1; style: small; maxLines: 1 }
      if full {
        Text { text: "${t.won}-${t.drawn}-${t.lost}"; width: 56; style: small; color: muted; align: end }
      } else if wide {
        Text { text: t.played; width: 24; style: small; color: muted; align: end }
      }
      Text { text: t.gd > 0 ? "+${t.gd}" : t.gd; width: 32; style: small; align: end; color: t.gd > 0 ? green : t.gd < 0 ? red : muted }
      Text { text: t.pts; width: 28; style: small; bold: true; align: end }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "Champions League"; style: title; weight: 1; maxLines: 1 }
      if count(live) > 0 {
        Text { text: str.live(count(live)); style: small; color: accent; width: 72; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 72; align: end }
      }
    }
    Row {
      Button { text: str.matches; weight: 1; color: view == "matches" ? accent : muted; onTap: view = "matches" }
      Button { text: str.table; weight: 1; color: view == "table" ? accent : muted; onTap: view = "table" }
    }
    Column {
      weight: 1
      scroll: true
      if view == "matches" {
        if count(picked) == 0 {
          Text { text: games == null ? str.loading : str.none; style: small; color: muted }
        } else {
          for g in picked key g.id { GameRow { g: g; wide: tileWide } }
        }
      } else {
        for grp in groups {
          for t in grp.teams key t.id { TeamRow { t: t; wide: tileWide } }
        }
      }
    }
  }

  screen {
    title: "Champions League"
    Column {
      scroll: true
      Text { text: str.matches; style: title }
      if count(all) == 0 { Text { text: str.none; style: small; color: muted } }
      for g in all key g.id { GameRow { g: g; wide: screenWide } }
      Text { text: str.table; style: title }
      for grp in groups {
        for t in grp.teams key t.id { TeamRow { t: t; full: true; wide: screenWide } }
      }
      Button { text: str.close; onTap: close() }
    }
  }
}
