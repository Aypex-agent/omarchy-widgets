widget "launches" {
  meta { description: "A live countdown to the next rocket launch and the ones after it, from The Space Devs"; version: "1.5"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. Rockets, providers, places and status (Go, TBD) come as The Space Devs write them.
  strings {
    en { title: "next launch"; liftoff: "liftoff"; days: n => "${n}d " }
    id { title: "peluncuran berikutnya"; liftoff: "lepas landas"; days: n => "${n}h " }
    es { title: "próximo lanzamiento"; liftoff: "despegue"; days: n => "${n}d " }
    pt { title: "próximo lançamento"; liftoff: "decolagem"; days: n => "${n}d " }
    de { title: "nächster start"; liftoff: "gestartet"; days: n => "${n}t " }
    zh { title: "下一次发射"; liftoff: "已升空"; days: n => "${n}天 " }
  }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // The free Launch Library API allows 15 requests an hour, so this checks hourly.
  source launches = cmd("""
    curl -fsm 12 'https://ll.thespacedevs.com/2.2.0/launch/upcoming/?limit=8&mode=list' | jq -c '[.results[] | {
      id, name, provider: .lsp_name, where: .location, status: .status.abbrev,
      at: (.net | fromdateiso8601), url: "https://spacelaunchnow.me/launch/\(.slug)"
    }]'
  """) every 1h json timeout 20s
  source now = clock every 1s
  let upcoming = launches.filter(l => l.at > now - 3600)
  let next = upcoming.first()
  let t = next.at - now
  // A tile taller than wide (the landscape home screen) has room for long names but not for a
  // date column: names get two lines and each later launch puts its date above its name.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  onTap: url(next.url ?? "https://spacelaunchnow.me")

  Column {
    gap: 4
    Row {
      Text { text: str.title; style: muted; weight: 1 }
      Text { text: next.status; fontSize: 11; color: next.status == "Go" ? green : muted; width: 48; align: end }
    }
    Text { text: next.name; style: body; bold: true; maxLines: tall ? 2 : 1 }
    Text {
      text: next == null ? "…" : t <= 0 ? str.liftoff : "T-${t >= 86400 ? str.days(floor(t / 86400)) : ""}${pad(floor(t % 86400 / 3600), 2, "0")}:${pad(floor(t % 3600 / 60), 2, "0")}:${pad(floor(t % 60), 2, "0")}"
      style: title; font: mono; color: accent
    }
    Text { text: "${next.provider} · ${next.where}"; style: small; color: muted; maxLines: tall ? 2 : 1 }
    Column {
      scroll: true
      weight: 1
      gap: tall ? 8 : 2
      for l in upcoming.drop(1) key l.id {
        if tall {
          Column {
            onTap: url(l.url)
            gap: 0
            Text { text: fmtTime(l.at, "EEE d MMM"); fontSize: 11; color: muted }
            Text { text: l.name; fontSize: 11; maxLines: 2 }
          }
        } else {
          Row {
            onTap: url(l.url)
            Text { text: fmtTime(l.at, "EEE d MMM"); fontSize: 11; color: muted; width: 80 }
            Text { text: l.name; fontSize: 11; maxLines: 1; weight: 1 }
          }
        }
      }
    }
  }
}
