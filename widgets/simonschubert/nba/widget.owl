widget "nba" {
  meta {
    owl: 17
    description: "NBA scores from ESPN with team logos: live games first, then last night's finals and today's tip-offs. Tap for every game and both conference standings"
    version: "1.5"
    license: "MIT"
    category: "sport"
  }
  // What it says, in the phone's language where it has a set. Team names and ESPN's game status
  // (Final, 7:00 PM) come as ESPN writes them.
  strings {
    en { scores: "scores"; standings: "standings"; loading: "loading…"; none: "no games today"; close: "close"; live: n => "${n} live"; col: "GB" }
    id { scores: "skor"; standings: "klasemen"; loading: "memuat…"; none: "tidak ada laga hari ini"; close: "tutup"; live: n => "${n} live"; col: "GB" }
    es { scores: "marcadores"; standings: "posiciones"; loading: "cargando…"; none: "no hay partidos hoy"; close: "cerrar"; live: n => "${n} en vivo"; col: "JD" }
    pt { scores: "placares"; standings: "classificação"; loading: "carregando…"; none: "nenhum jogo hoje"; close: "fechar"; live: n => "${n} ao vivo"; col: "GB" }
    de { scores: "ergebnisse"; standings: "tabelle"; loading: "lädt…"; none: "heute keine spiele"; close: "schließen"; live: n => "${n} live"; col: "GB" }
    zh { scores: "比分"; standings: "排名"; loading: "正在加载…"; none: "今天没有比赛"; close: "关闭"; live: n => "${n} 场进行中"; col: "胜差" }
    ru { scores: "результаты"; standings: "таблица"; loading: "загрузка…"; none: "сегодня игр нет"; close: "закрыть"; live: n => "идут: ${n}"; col: "GB" }
    ja { scores: "スコア"; standings: "順位表"; loading: "読み込み中…"; none: "今日は試合がありません"; close: "閉じる"; live: n => "ライブ ${n}"; col: "差" }
    uk { scores: "результати"; standings: "таблиця"; loading: "завантаження…"; none: "сьогодні ігор немає"; close: "закрити"; live: n => "наживо: ${n}"; col: "GB" }
    fr { scores: "scores"; standings: "classement"; loading: "chargement…"; none: "aucun match aujourd’hui"; close: "fermer"; live: n => "${n} live"; col: "GB" }
  }
  size: 6x4
  minSize: 3x3

  source now = clock every 1m

  // ESPN's scoreboard answers one day at a time: yesterday, today and tomorrow, each its own
  // request straight from Android, trimmed to what the tile shows. The URLs move on at midnight.
  let api = "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard?dates="
  source d0 = http("${api}${enc(fmtTime(now - 86400, "yyyyMMdd"))}") every 5m json timeout 15s
  source d1 = http("${api}${enc(fmtTime(now, "yyyyMMdd"))}") every 5m json timeout 15s
  source d2 = http("${api}${enc(fmtTime(now + 86400, "yyyyMMdd"))}") every 5m json timeout 15s

  // Standings by conference, in seed order.
  source table = http("https://site.api.espn.com/apis/v2/sports/basketball/nba/standings") every 30m json timeout 20s

  state view = "scores"

  // A late game can be on two days' lists, so each is kept once.
  let events = flatten([d0, d1, d2].map(d => d.events ?? []))
  let all = values(groupBy(events.map(e => {
    id: e.id, at: parseTime(e.date),
    state: e.competitions[0].status.type.state, detail: e.competitions[0].status.type.shortDetail,
    teams: e.competitions[0].competitors.map(c => {
      side: c.homeAway, abbr: c.team.abbreviation, name: c.team.shortDisplayName, score: c.score,
      winner: c.winner ?? false, logo: last(split(c.team.logo ?? "", "/"))
    })
  }), g => g.id)).map(l => l[0]).sortBy(g => g.at)
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live, done.take(ceil(cap / 2)), next]).take(cap)
  let groups = (table.children ?? []).map(c => {
    name: c.abbreviation,
    teams: (c.standings.entries ?? []).map(e => {
      e: e, st: reduce(e.stats ?? [], (m, s) => set(m, s.name, s), {})
    }).map(x => {
      id: x.e.team.id, abbr: x.e.team.abbreviation, name: x.e.team.shortDisplayName,
      logo: last(split(x.e.team.logos[0].href ?? "", "/")),
      seed: floor(x.st.playoffSeed.value ?? 99), rec: split(x.st.overall.displayValue ?? "", ", ")[0],
      b: x.st.gamesBehind.displayValue
    }).sortBy(t => t.seed)
  })
  // Tile width only: on a phone the screen is always wide, but a landscape tile
  // leaves no room for full names beside the fixed-width score centre.
  let tw = tileWidth ?? screenWidth ?? 240
  let wide = tw >= 360
  // A line under the last playoff seed, and under the play-in.
  let cuts = [6, 10]
  let bLabel = str.col

  // Logos at 96 px from ESPN's resizer; the launcher keeps each one, so they show offline too.
  component Badge(logo, px = 18) {
    if logo {
      Image { src: "https://a.espncdn.com/combiner/i?img=/i/teamlogos/nba/500/${enc(logo)}&w=96&h=96"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  component GameRow(g) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = wide ? 18 : 14
    let scW = wide ? 30 : 24
    let dotW = wide ? 8 : 6
    let stW = wide ? 104 : 40
    let ctrW = 2 * scW + 2 * dotW + stW

    // Away on the left, at home on the right; the centre keeps one width so the
    // logos and names line up down the list.
    Row {
      gap: wide ? 8 : 4
      Badge { logo: away.logo; px: px }
      Text { text: wide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; color: final && !away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, wide ? "EEE HH:mm" : "HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: away.score ?? '–'; style: small; width: scW; align: end; bold: final && away.winner; color: live ? accent : final && !away.winner ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: home.score ?? '–'; style: small; width: scW; align: start; bold: final && home.winner; color: live ? accent : final && !home.winner ? muted : foreground }
        }
      }
      Text { text: wide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && !home.winner ? muted : foreground }
      Badge { logo: home.logo; px: px }
    }
  }

  component TeamRow(t) {
    Row {
      gap: 6
      Text { text: t.seed < 99 ? t.seed : '–'; width: 20; style: small; color: muted; align: end }
      Badge { logo: t.logo; px: 16 }
      Text { text: tw >= 280 ? t.name : t.abbr; weight: 1; style: small; maxLines: 1 }
      Text { text: t.rec; width: 56; style: small; bold: true; align: end }
      Text { text: t.b ?? '–'; width: 36; style: small; color: muted; align: end }
    }
  }

  component Standings() {
    for grp in groups {
      Row {
        Text { text: grp.name; style: label; color: muted; weight: 1 }
        Text { text: bLabel; style: label; color: muted; width: 36; align: end }
      }
      for t, i in grp.teams key t.id {
        if i > 0 && cuts.contains(i) { Box { height: 7; fill: width  Row { width: 32; height: 1; background: border } } }
        TeamRow { t: t }
      }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "NBA"; style: title; weight: 1; maxLines: 1 }
      if count(live) > 0 {
        Text { text: str.live(count(live)); style: small; color: accent; width: 72; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 72; align: end }
      }
    }
    Row {
      Button { text: str.scores; weight: 1; color: view == "scores" ? accent : muted; onTap: view = "scores" }
      Button { text: str.standings; weight: 1; color: view == "standings" ? accent : muted; onTap: view = "standings" }
    }
    Column {
      weight: 1
      scroll: true
      if view == "scores" {
        if count(picked) == 0 {
          Text { text: d1 == null ? str.loading : str.none; style: small; color: muted }
        } else {
          for g in picked key g.id { GameRow { g: g } }
        }
      } else {
        Standings {}
      }
    }
  }

  screen {
    title: "NBA"
    Column {
      scroll: true
      onPull: refresh()
      Text { text: str.scores; style: title }
      if count(all) == 0 { Text { text: str.none; style: small; color: muted } }
      for g in all key g.id { GameRow { g: g } }
      Text { text: str.standings; style: title }
      Standings {}
      Button { text: str.close; onTap: close() }
    }
  }
}
