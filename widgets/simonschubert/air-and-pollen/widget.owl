widget "air and pollen" {
  meta { description: "Air quality and today's pollen where you are, from Open-Meteo (Copernicus), located by IP or a city you type, via wttr.in. Tap it for the next 24 hours, pollutants and every pollen type"; version: "1.4"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. us and eu are the two indexes' levels, good
  // to worst, in each agency's words where it has them; advice goes with them, pollen is none to high.
  strings {
    en {
      title: "air and pollen"; air: "air"; city: "city · empty = auto"; unknown: "location unknown"; offline: "open-meteo offline"
      us: ["good", "moderate", "unhealthy for some", "unhealthy", "very unhealthy", "hazardous"]
      eu: ["good", "fair", "moderate", "poor", "very poor", "extremely poor"]
      advice: ["ideal for being outside", "fine for your usual outdoor plans", "sensitive people may want to take it easy outside", "consider less intense activity outside", "cut down on activity outside", "avoid activity outside"]
      pollen: ["none", "low", "moderate", "high"]
      plant: k => k
      plantLevel: (plant, level) => "${plant} ${level}"; pollenLevel: (plant, level) => "${plant} pollen ${level}"
      noPollen: "no pollen"; uv: v => "uv ${v}"; pollenShort: "pollen · next 24 h"; europeOnly: "no pollen forecast here (europe only)"
      noneInAir: "none in the air"; next24: "next 24 hours"; now: "now"; pollutants: "pollutants now · µg/m³"
      ozone: "ozone"; uvIndex: "uv index"; pollenLong: "pollen · next 24 hours"
      europeOnlyLong: "open-meteo only forecasts pollen in europe."; peak: v => "peak ${v}"
      data: "data: copernicus atmosphere monitoring service via open-meteo"
    }
    id {
      title: "udara dan serbuk sari"; air: "udara"; city: "kota · kosong = otomatis"; unknown: "lokasi tidak diketahui"; offline: "open-meteo offline"
      us: ["baik", "sedang", "tidak sehat bagi kelompok sensitif", "tidak sehat", "sangat tidak sehat", "berbahaya"]
      eu: ["baik", "cukup", "sedang", "buruk", "sangat buruk", "sangat buruk sekali"]
      advice: ["ideal untuk berada di luar", "aman untuk rencana di luar seperti biasa", "orang yang sensitif sebaiknya tidak memaksakan diri di luar", "pertimbangkan aktivitas luar yang lebih ringan", "kurangi aktivitas di luar", "hindari aktivitas di luar"]
      pollen: ["tidak ada", "rendah", "sedang", "tinggi"]
      plant: k => get({"birch": "birch", "alder": "alder", "olive": "zaitun", "grass": "rumput", "mugwort": "mugwort", "ragweed": "ragweed"}, k, k)
      plantLevel: (plant, level) => "${plant} ${level}"; pollenLevel: (plant, level) => "serbuk sari ${plant} ${level}"
      noPollen: "tidak ada serbuk sari"; uv: v => "uv ${v}"; pollenShort: "serbuk sari · 24 jam"; europeOnly: "tidak ada prakiraan serbuk sari di sini (hanya eropa)"
      noneInAir: "tidak ada di udara"; next24: "24 jam ke depan"; now: "kini"; pollutants: "polutan saat ini · µg/m³"
      ozone: "ozon"; uvIndex: "indeks uv"; pollenLong: "serbuk sari · 24 jam ke depan"
      europeOnlyLong: "open-meteo hanya memprakirakan serbuk sari di eropa."; peak: v => "puncak ${v}"
      data: "data: copernicus atmosphere monitoring service lewat open-meteo"
    }
    es {
      title: "aire y polen"; air: "aire"; city: "ciudad · vacío = auto"; unknown: "ubicación desconocida"; offline: "open-meteo sin conexión"
      us: ["buena", "moderada", "dañina para grupos sensibles", "dañina", "muy dañina", "peligrosa"]
      eu: ["buena", "razonable", "regular", "desfavorable", "muy desfavorable", "extremadamente desfavorable"]
      advice: ["ideal para estar al aire libre", "bien para tus planes al aire libre de siempre", "las personas sensibles quizá prefieran tomárselo con calma afuera", "considera una actividad menos intensa afuera", "reduce la actividad al aire libre", "evita la actividad al aire libre"]
      pollen: ["nada", "bajo", "moderado", "alto"]
      plant: k => get({"birch": "abedul", "alder": "aliso", "olive": "olivo", "grass": "gramíneas", "mugwort": "artemisa", "ragweed": "ambrosía"}, k, k)
      plantLevel: (plant, level) => "${plant} ${level}"; pollenLevel: (plant, level) => "polen de ${plant} ${level}"
      noPollen: "sin polen"; uv: v => "uv ${v}"; pollenShort: "polen · próximas 24 h"; europeOnly: "sin pronóstico de polen aquí (solo europa)"
      noneInAir: "nada en el aire"; next24: "próximas 24 horas"; now: "ahora"; pollutants: "contaminantes ahora · µg/m³"
      ozone: "ozono"; uvIndex: "índice uv"; pollenLong: "polen · próximas 24 horas"
      europeOnlyLong: "open-meteo solo pronostica polen en europa."; peak: v => "máx. ${v}"
      data: "datos: copernicus atmosphere monitoring service vía open-meteo"
    }
    pt {
      title: "ar e pólen"; air: "ar"; city: "cidade · vazio = auto"; unknown: "local desconhecido"; offline: "open-meteo offline"
      us: ["boa", "moderada", "ruim para grupos sensíveis", "ruim", "muito ruim", "perigosa"]
      eu: ["boa", "razoável", "moderada", "ruim", "muito ruim", "péssima"]
      advice: ["ideal para ficar ao ar livre", "tudo bem para seus planos ao ar livre de sempre", "pessoas sensíveis podem preferir pegar leve ao ar livre", "considere atividades menos intensas ao ar livre", "diminua as atividades ao ar livre", "evite atividades ao ar livre"]
      pollen: ["nenhum", "baixo", "moderado", "alto"]
      plant: k => get({"birch": "bétula", "alder": "amieiro", "olive": "oliveira", "grass": "gramíneas", "mugwort": "artemísia", "ragweed": "ambrósia"}, k, k)
      plantLevel: (plant, level) => "${plant} ${level}"; pollenLevel: (plant, level) => "pólen de ${plant} ${level}"
      noPollen: "sem pólen"; uv: v => "uv ${v}"; pollenShort: "pólen · próximas 24 h"; europeOnly: "sem previsão de pólen aqui (só europa)"
      noneInAir: "nenhum no ar"; next24: "próximas 24 horas"; now: "agora"; pollutants: "poluentes agora · µg/m³"
      ozone: "ozônio"; uvIndex: "índice uv"; pollenLong: "pólen · próximas 24 horas"
      europeOnlyLong: "o open-meteo só prevê pólen na europa."; peak: v => "pico ${v}"
      data: "dados: copernicus atmosphere monitoring service via open-meteo"
    }
    de {
      title: "luft und pollen"; air: "luft"; city: "stadt · leer = auto"; unknown: "ort unbekannt"; offline: "open-meteo offline"
      us: ["gut", "mäßig", "ungesund für manche", "ungesund", "sehr ungesund", "gefährlich"]
      eu: ["gut", "ausreichend", "mäßig", "schlecht", "sehr schlecht", "extrem schlecht"]
      advice: ["perfekt, um rauszugehen", "passt für alles, was du draußen vorhast", "empfindliche leute sollten es draußen ruhig angehen", "draußen lieber nichts anstrengendes machen", "draußen lieber kürzer treten", "bleib lieber drinnen"]
      pollen: ["keine", "gering", "mittel", "hoch"]
      plant: k => get({"birch": "birke", "alder": "erle", "olive": "olive", "grass": "gräser", "mugwort": "beifuß", "ragweed": "ambrosia"}, k, k)
      plantLevel: (plant, level) => "${plant} ${level}"
      pollenLevel: (plant, level) => get({"birke": "birkenpollen", "erle": "erlenpollen", "olive": "olivenpollen", "gräser": "gräserpollen", "beifuß": "beifußpollen", "ambrosia": "ambrosiapollen"}, plant, "${plant}-pollen") + " ${level}"
      noPollen: "keine pollen"; uv: v => "uv ${v}"; pollenShort: "pollen · nächste 24 h"; europeOnly: "hier keine pollenvorhersage (nur europa)"
      noneInAir: "keine in der luft"; next24: "nächste 24 stunden"; now: "jetzt"; pollutants: "schadstoffe jetzt · µg/m³"
      ozone: "ozon"; uvIndex: "uv-index"; pollenLong: "pollen · nächste 24 stunden"
      europeOnlyLong: "open-meteo hat pollenvorhersagen nur für europa."; peak: v => "max. ${v}"
      data: "daten: copernicus atmosphere monitoring service über open-meteo"
    }
  }
  size: 3x2
  minSize: 3x2

  source now = clock every 1m
  state city = "" persist
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // Where you are. The same request as the today widget, so the two share it.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let area = wx.nearest_area[0]
  let lat = num(area.latitude)
  let lon = num(area.longitude)
  // The US index there, Europe's everywhere else.
  let us = contains(["united states", "united states of america"], lower(trim(area.country[0].value)))
  source air = http("https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=european_aqi,us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,uv_index&hourly=european_aqi,us_aqi,alder_pollen,birch_pollen,grass_pollen,mugwort_pollen,olive_pollen,ragweed_pollen&forecast_days=2&timezone=auto&timeformat=unixtime") every 30m timeout 15s json status
  // The first request goes out before the location is known; ask again once it is.
  when lat != null { refresh() }
  // And again when a new city moves it.
  on lat { refresh() }

  let cur = air.ok ? air.out.current : null
  let hourly = air.ok ? air.out.hourly : null
  let index = us ? "us_aqi" : "european_aqi"
  let aqi = get(cur, index)
  let steps = us ? [50, 100, 150, 200, 300] : [20, 40, 60, 80, 100]
  let names = us ? str.us : str.eu
  let tints = us ? [green, yellow, orange, red, magenta, magenta] : [green, cyan, yellow, orange, red, magenta]
  let advice = str.advice
  let level = aqi == null ? null : count(steps, s => aqi > s)
  let tint = level == null ? muted : tints[level]
  // The next 24 hours, from the current one on.
  let start = max(count(hourly.time ?? [], t => t <= now) - 1, 0)
  let hours = take(drop(hourly.time ?? [], start), 24)
  let aqis = take(drop(get(hourly, index) ?? [], start), 24)
  // Pollen in grains/m³, rated none, low, moderate or high. Europe only: elsewhere it's null.
  let kinds = [
    {key: "birch", t: [1, 15, 90]}, {key: "alder", t: [1, 15, 90]}, {key: "olive", t: [1, 15, 90]},
    {key: "grass", t: [1, 20, 50]}, {key: "mugwort", t: [1, 10, 50]}, {key: "ragweed", t: [1, 5, 20]}
  ]
  let pollen = kinds.map(k => {
    name: k.key,
    values: take(drop(get(hourly, k.key + "_pollen") ?? [], start), 24),
    peak: max(take(drop(get(hourly, k.key + "_pollen") ?? [], start), 24).filter(v => v != null)),
    t: k.t
  }).map(p => {name: p.name, values: p.values, peak: p.peak, level: p.peak == null ? 0 : count(p.t, x => p.peak >= x)})
  let hasPollen = any(pollen, p => p.peak != null)
  let flying = pollen.filter(p => p.level > 0).sortBy(p => -p.peak)
  let pollenWords = str.pollen
  let pollenTints = [muted, green, yellow, red]
  // A narrow tile (the landscape home screen turns 3x2 into 2x3) stacks the gauge above the words.
  let narrow = tileWidth != null && tileWidth < 170
  let problem = wx == null || (lat != null && air == null) ? "…" : lat == null ? str.unknown : !air.ok ? str.offline : null

  onTap: screen()

  component Dots(n, c) {
    Row {
      gap: 2
      for i in range(3) { Box { width: 8; height: 4; radius: 2; background: i < n ? c : alpha(muted, 0.25) } }
    }
  }

  component Gauge(big = false) {
    Box {
      align: center
      Ring { value: aqi ?? 0; max: steps[4]; color: tint; track: alpha(muted, 0.2); thickness: big ? 10 : 6; start: 225; sweep: 270; fill: true; animate value: spring() }
      Column {
        gap: 0
        align: center
        Text { text: aqi == null ? "…" : round(aqi); fontSize: big ? 40 : 20; bold: true; color: tint; align: center }
        Text { text: us ? "us aqi" : "eu aqi"; style: label; color: muted; align: center }
      }
    }
  }

  component PollenRow(p, size = 11) {
    Row {
      gap: 6
      align: center
      Text { text: str.plant(p.name); fontSize: size; weight: 1; maxLines: 1 }
      Dots { n: p.level; c: pollenTints[p.level] }
      Text { text: pollenWords[p.level]; fontSize: size; color: pollenTints[p.level]; width: size * 5.5; align: end; maxLines: 1 }
    }
  }

  Column {
    gap: 4
    Row {
      gap: 6
      Text { text: str.air; style: muted; width: 48; maxLines: 1 }
      Text { text: lower(area.areaName[0].value ?? ""); fontSize: 10; color: muted; maxLines: 1; weight: 1; align: end }
    }
    if problem != null {
      Text { text: problem; style: small; color: muted }
    } else if narrow {
      Column {
        gap: 2
        align: center
        weight: 1
        Gauge { size: 64 }
        Text { text: names[level]; style: body; bold: true; color: tint; maxLines: 1; align: center }
        Text { text: "pm2.5 ${round(cur.pm2_5)} µg/m³"; style: small; color: muted; maxLines: 1; align: center }
        if (tileHeight ?? 0) >= 150 {
          Text { text: !hasPollen ? str.uv(round(cur.uv_index)) : len(flying) == 0 ? str.noPollen : str.plantLevel(str.plant(flying[0].name), pollenWords[flying[0].level]); style: small; color: !hasPollen ? muted : len(flying) == 0 ? green : pollenTints[flying[0].level]; maxLines: 1; align: center }
        }
      }
    } else {
      Row {
        gap: 10
        align: center
        weight: rows >= 3 ? 0 : 1
        Gauge { size: 64 }
        Column {
          gap: 0
          weight: 1
          Text { text: names[level]; style: body; bold: true; color: tint; maxLines: 2 }
          Text { text: "pm2.5 ${round(cur.pm2_5)} µg/m³"; style: small; color: muted; maxLines: 1 }
          if rows >= 3 || !hasPollen {
            Text { text: str.uv(round(cur.uv_index)); style: small; color: muted; maxLines: 1 }
          } else {
            // Too short for the pollen list: the worst one, or none.
            Text { text: len(flying) == 0 ? str.noPollen : str.pollenLevel(str.plant(flying[0].name), pollenWords[flying[0].level]); style: small; color: len(flying) == 0 ? green : pollenTints[flying[0].level]; maxLines: 1 }
          }
        }
      }
      if rows >= 3 {
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.pollenShort; style: label; color: muted }
        Column {
          gap: 3
          weight: 1
          if !hasPollen {
            Text { text: str.europeOnly; style: small; color: muted }
          } else if len(flying) == 0 {
            Text { text: str.noneInAir; style: small; color: green }
          } else {
            for p in take(flying, rows >= 4 ? 5 : 3) key p.name { PollenRow { p: p } }
          }
        }
      }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    if problem != null {
      Text { text: problem; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 14
        Row {
          gap: 16
          align: center
          Gauge { big: true; size: 132 }
          Column {
            gap: 2
            weight: 1
            Text { text: names[level]; style: title; color: tint }
            Text { text: advice[level]; style: small }
            Text { text: "${lower(area.areaName[0].value)}, ${lower(area.country[0].value)}"; style: small; color: muted; maxLines: 1 }
          }
        }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.next24; style: label; color: accent }
        Canvas {
          height: 110
          fill: width
          let n = max(len(aqis), 1)
          let top = max(max(aqis.filter(v => v != null)) ?? 0, steps[2])
          let w = width / n
          // The category lines, faint, so a bar's height reads as good, fair, ...
          for s, i in take(steps, 4) {
            if s < top {
              line(0, 92 - s / top * 84, width, 92 - s / top * 84, stroke: alpha(tints[i + 1], 0.3), width: 1)
            }
          }
          for v, i in aqis {
            if v != null {
              rect(i * w + 1, 92 - v / top * 84, max(w - 2, 1), max(v / top * 84, 1), radius: 2, fill: tints[count(steps, s => v > s)])
            }
            if i % 6 == 0 {
              text(i == 0 ? str.now : fmtTime(hours[i], "HH:mm"), i * w + w / 2, 104, size: 10, align: center, color: muted)
            }
          }
        }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.pollutants; style: label; color: accent }
        Grid {
          columns: 3
          gap: 8
          for p in [["pm2.5", cur.pm2_5, 25], ["pm10", cur.pm10, 50], [str.ozone, cur.ozone, 120], ["no₂", cur.nitrogen_dioxide, 40], [str.uvIndex, cur.uv_index, 6]] {
            Column {
              gap: 0
              padding: [10, 8]
              border: 1
              borderColor: alpha(muted, 0.3)
              Text { text: p[0]; style: label; color: muted }
              Text { text: p[1] == null ? "…" : round(p[1], 1); style: title; color: p[1] > p[2] ? orange : foreground }
            }
          }
        }

        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: str.pollenLong; style: label; color: accent }
        if !hasPollen {
          Text { text: str.europeOnlyLong; style: small; color: muted }
        } else {
          for p in pollen.sortBy(p => -(p.peak ?? 0)) key p.name {
            Column {
              gap: 2
              PollenRow { p: p; size: 14 }
              if p.level > 0 {
                Row {
                  gap: 6
                  align: center
                  Sparkline { values: p.values.map(v => v ?? 0); min: 0; max: max(p.peak ?? 0, 1); color: pollenTints[p.level]; area: true; height: 24; weight: 1 }
                  Text { text: p.peak == null ? "" : str.peak(round(p.peak)); style: label; color: muted; width: 72; align: end }
                }
              }
            }
          }
        }
        Text { text: str.data; style: label; color: muted }
      }
    }
  }
}
