widget "claude-input" {
  size: 6x3
  minSize: 3x2

  meta { owl: 13; description: "Claude Code sessions (cloud or remote control) waiting on you, from the Claude app's notifications: tap one to open its conversation. Logs them to ~/.cache/claude-input.log."; version: "1.0"; license: "MIT"; category: "productivity" }

  requires { pacman: ["coreutils"] }

  source n = android.notifications
  source now = clock every 30s
  state showAll = false persist

  // Everything the Claude app has posted, and the ones that ask for you: a permission
  // prompt, a question, a plan to approve, or a session idle waiting on input.
  let claude = n.items.filter(i => startsWith(i.package, "com.anthropic"))
  let waiting = claude.filter(i => match(lower("${i.title} ${i.text}"), "needs? (your )?(input|permission|approval|attention|response|answer)|waiting (for|on) (you|your)|permission|approv|allow|question|respond|review|plan (is )?ready|confirm|blocked|input") != null)
  let shown = showAll ? claude : waiting

  // Every Claude notification goes to a log, to tune the words above against real ones.
  let claudeKeys = join(claude.map(i => "${i.key}${i.text}"), ",")
  on claudeKeys {
    run("mkdir -p ~/.cache && printf '%s\n' ${sh(toJson(claude.map(i => {time: i.time, title: i.title, text: i.text, actions: i.actions})))} >> ~/.cache/claude-input.log")
  }

  if !n.available {
    Column {
      justify: center
      fill: true
      Text { text: "claude code"; style: muted }
      Text { text: "needs notification access"; style: small }
      Button { text: "allow"; onTap: notification("open", "") }
    }
  } else {
    Column {
      gap: 6
      fill: true
      Row {
        gap: 8
        Text { text: "claude code"; style: muted; weight: 1 }
        Box {
          width: 110
          onTap: showAll = !showAll
          Text { text: showAll ? "all ${len(claude)}" : "waiting ${len(waiting)}"; style: label; color: len(waiting) > 0 ? accent : muted; align: end }
        }
      }
      if len(shown) == 0 {
        Column {
          justify: center
          weight: 1
          fill: width
          Text { text: "nothing waiting on you"; style: small; color: muted; align: center }
        }
      } else {
        Column {
          gap: 10
          weight: 1
          scroll: true
          for item in shown key item.key {
            Column {
              gap: 4
              Row {
                gap: 8
                align: top
                onTap: notification("open", item.key)
                Image { src: item.icon; width: 22; height: 22 }
                Column {
                  gap: 0
                  weight: 1
                  Row {
                    gap: 6
                    Text { text: item.title; bold: true; maxLines: 1; weight: 1 }
                    Text { text: fmtAgo(item.time, now); style: label; color: muted }
                  }
                  if item.text != "" {
                    Text { text: item.text; style: small; maxLines: 3 }
                  }
                }
              }
              if len(item.actions) > 0 {
                Row {
                  gap: 6
                  for a, idx in item.actions {
                    if !a.reply {
                      Button { text: a.title; onTap: notification("action", item.key, idx) }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
