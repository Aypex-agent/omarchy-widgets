widget "Car Maintenance" {
  size: 3x2
  minSize: 3x2
  padding: 8
  meta {
    owl: 11
    version: "1.0"
    category: "productivity"
    license: "MIT"
    description: "Offline vehicle reminders, odometer updates and maintenance history, with a read-only lock."
  }
  requires { pacman: [] }

  // One persistent transaction contains the records, monotonic ID counter and undo.
  // History snapshots its unit. Routine odometer updates never create history.
  state db = {vehicles: [], reminders: [], history: [], seq: 0, days: 30, miles: 1000, km: 1600, undo: null} persist
  state locked = false persist
  state view = "home"
  state vehicleId = 0
  state reminderId = 0
  state historyId = 0
  state filterVehicle = 0
  state page = 0
  state f = {}
  state error = ""
  state confirm = ""
  state returnView = "home"
  state setup = false
  state selectedTemplates = []
  state drafts = []
  state setupIndex = 0
  source now = clock every 1m
  let today = fmtTime(now, "yyyy-MM-dd")
  let dayZero = parseTime("${today}T12:00:00Z")
  let templates = ["MOT/Inspection", "Insurance", "Road Tax", "Breakdown Cover", "Full Service", "Oil Service", "Tyres", "Brakes", "Battery", "Custom maintenance"]
  let vehicles = db.vehicles
  let reminders = db.reminders
  let history = db.history
  let vehicle = vehicles.find(v => v.id == vehicleId)
  let reminder = reminders.find(r => r.id == reminderId)
  let reminderVehicle = vehicles.find(v => v.id == reminder.vehicleId)
  let record = history.find(h => h.id == historyId)
  let recordVehicle = vehicles.find(v => v.id == record.vehicleId)

  // Calendar dates are ISO in storage, DD/MM/YYYY in forms, noon UTC in arithmetic.
  let dateText = trim(f.date ?? "")
  let dateISO = len(dateText) == 10 ? "${sub(dateText,6,10)}-${sub(dateText,3,5)}-${sub(dateText,0,2)}" : ""
  let dateStamp = parseTime("${dateISO}T12:00:00Z")
  let dateValid = match(dateText, "^[0-9]{2}/[0-9]{2}/[0-9]{4}$") != null && sub(dateISO,0,4) >= "1900" && sub(dateISO,0,4) <= "9998" && dateStamp != null && fmtTime(dateStamp,"yyyy-MM-dd","UTC") == dateISO
  let nextText = trim(f.nextDate ?? "")
  let nextISO = len(nextText) == 10 ? "${sub(nextText,6,10)}-${sub(nextText,3,5)}-${sub(nextText,0,2)}" : ""
  let nextStamp = parseTime("${nextISO}T12:00:00Z")
  let nextValid = nextText == "" || (match(nextText,"^[0-9]{2}/[0-9]{2}/[0-9]{4}$") != null && sub(nextISO,0,4) >= "1900" && sub(nextISO,0,4) <= "9998" && nextStamp != null && fmtTime(nextStamp,"yyyy-MM-dd","UTC") == nextISO)
  let mileageText = trim(f.mileage ?? "")
  let mileageValid = mileageText == "" || (match(mileageText,"^[0-9]+$") != null && num(mileageText) <= 999999999)
  let mileageValue = mileageText == "" ? null : num(mileageText)
  let nextMileageText = trim(f.nextMileage ?? "")
  let nextMileageValid = nextMileageText == "" || (match(nextMileageText,"^[0-9]+$") != null && num(nextMileageText) <= 999999999)
  let nextMileageValue = nextMileageText == "" ? null : num(nextMileageText)
  let numericFieldsValid = [f.repeat ?? "", f.distance ?? "", f.warnDays ?? "", f.warnDistance ?? ""].all(x => trim(x) == "" || (match(trim(x),"^[0-9]+$") != null && num(x) <= 999999999))
  let repeatValid = trim(f.repeat ?? "") == "" || (num(f.repeat) >= 1 && num(f.repeat) <= (f.period == "years" ? 100 : f.period == "months" ? 1200 : f.period == "weeks" ? 5200 : 36500))
  let distanceValid = trim(f.distance ?? "") == "" || num(f.distance) >= 1
  let reminderFormValid = trim(f.name ?? "") != "" && (dateText == "" || dateValid) && mileageValid && (dateText != "" || mileageText != "") && numericFieldsValid && repeatValid && distanceValid
  let vehicleFormValid = trim(f.name ?? "") != "" && mileageValid && (trim(f.year ?? "") == "" || (match(trim(f.year),"^[0-9]{4}$") != null && num(f.year) >= 1886 && num(f.year) <= 9998))

  // Enrich in stages; no date prediction is made from mileage.
  let joined = reminders.map(r => merge(r, {v: vehicles.find(v => v.id == r.vehicleId)})).filter(r => r.v != null)
  let measured = joined.map(r => merge(r, {
    daysLeft: r.date == "" ? null : round((parseTime("${r.date}T12:00:00Z") - dayZero) / 86400),
    remaining: r.mileage == null || r.v.odo == null ? null : r.mileage - r.v.odo,
    warningDays: r.warnDays ?? db.days,
    warningDistance: r.warnDistance ?? (r.v.unit == "miles" ? db.miles : db.km)
  }))
  let classified = measured.map(r => merge(r, {rank:
    (r.daysLeft != null && r.daysLeft < 0) || (r.remaining != null && r.remaining < 0) ? 0 :
    r.daysLeft == 0 || r.remaining == 0 ? 1 :
    (r.daysLeft != null && r.daysLeft <= r.warningDays) || (r.remaining != null && r.remaining <= r.warningDistance) ? 2 :
    r.daysLeft == null && r.remaining == null ? 4 : 3
  }))
  let ordered = classified.sortBy(r => r.rank * 1000000 + (r.daysLeft != null ? clamp(r.daysLeft,-99999,99999) : r.remaining != null ? 100000 + clamp(r.remaining / max(1,r.warningDistance),-99999,99999) : 299999))
  let focusedReminder = classified.find(r => r.id == reminderId)
  let overdueCount = classified.filter(r => r.rank == 0).count()
  let soonCount = classified.filter(r => r.rank == 1 || r.rank == 2).count()
  let previewCount = (tileHeight ?? 180) < 185 ? 3 : max(1, floor(((tileHeight ?? 180) - 45) / 31))
  let visibleReminders = ordered.filter(r => view != "vehicle" || r.vehicleId == vehicleId)
  let filteredHistory = history.filter(h => filterVehicle == 0 || h.vehicleId == filterVehicle).sortBy(h => "${h.date}-${pad(h.id,12,"0")}").reverse()
  let unit = vehicle.unit ?? "miles"
  let lowerOdo = vehicle != null && vehicle.odo != null && mileageValue != null && mileageValue < vehicle.odo
  // Clamp the day to the destination month's length (31 Jan + 1 month = 28/29 Feb).
  let repeatMonths = (reminder.repeat ?? 0) * (reminder.period == "years" ? 12 : 1)
  let monthIndex = int(sub(dateISO,0,4)) * 12 + int(sub(dateISO,5,7)) - 1 + repeatMonths
  let targetPrefix = "${floor(monthIndex / 12)}-${pad(monthIndex % 12 + 1,2,"0")}"
  let targetStart = parseTime("${targetPrefix}-01T12:00:00Z")
  let followingPrefix = fmtTime(targetStart + 32 * 86400,"yyyy-MM","UTC")
  let monthLength = round((parseTime("${followingPrefix}-01T12:00:00Z") - targetStart) / 86400)
  let proposedDate = reminder.repeat == null || !dateValid ? "" : reminder.period == "months" || reminder.period == "years" ? "${pad(min(int(sub(dateISO,8,10)),monthLength),2,"0")}/${pad(monthIndex % 12 + 1,2,"0")}/${floor(monthIndex / 12)}" : fmtTime(dateStamp + reminder.repeat * (reminder.period == "weeks" ? 7 : 1) * 86400,"dd/MM/yyyy","UTC")
  let undoAvailable = db.undo != null && vehicles.any(v => v.id == db.undo.original.vehicleId) && history.any(h => h.id == db.undo.historyId)

  component Label(caption) {
    Text { text: caption; color: muted; fontSize: 11; bold: true }
  }
  component Field(key, caption, hint = "") {
    Column {
      gap: 2
      Text { text: caption; color: muted; fontSize: 11 }
      Input { text: get(f,key,""); placeholder: hint; fontSize: 16; onChange: { f = set(f,key,value); error = ""; confirm = "" } }
    }
  }
  component ReminderCard(item, compact = false) {
    Column {
      padding: compact ? [1,0] : 10
      gap: compact ? 1 : 6
      background: surface
      radius: compact ? 0 : 8 * corners
      onTap: { reminderId = item.id; view = compact ? "home" : "reminder"; confirm = ""; screen() }
      Row {
        gap: 4
        Text { text: item.name; fontSize: compact ? 12 : 16; bold: true; weight: 1; maxLines: 1 }
        Text { text: item.rank == 0 ? "OVERDUE" : item.rank == 1 ? (item.daysLeft == 0 ? "TODAY" : "DUE NOW") : item.rank == 2 ? "SOON" : item.rank == 4 ? "UNKNOWN" : item.daysLeft != null ? "IN ${item.daysLeft} DAYS" : item.remaining != null ? "${fmtNum(item.remaining)} ${item.v.unit == "miles" ? "MI" : "KM"} LEFT" : "UPCOMING"; fontSize: compact ? 8 : 10; color: item.rank == 0 ? red : item.rank <= 2 ? yellow : muted; maxLines: 1 }
      }
      Row {
        gap: 4
        Text { text: trim("${item.v.make ?? ""} ${item.v.model ?? ""}") == "" ? item.v.name : trim("${item.v.make ?? ""} ${item.v.model ?? ""}"); fontSize: compact ? 10 : 12; color: muted; weight: 1; maxLines: 1 }
        Text { text: item.date != "" ? fmtTime(parseTime("${item.date}T12:00:00Z"),"dd MMM yyyy","UTC") : item.mileage != null ? "${fmtNum(item.mileage)} ${item.v.unit == "miles" ? "mi" : "km"}" : ""; fontSize: compact ? 10 : 12; color: item.rank == 0 ? red : foreground; maxLines: 1 }
      }
    }
  }

  onTap: { view = "home"; confirm = ""; screen() }
  Column {
    fill: true
    gap: 2
    Row {
      Text { text: "CAR MAINTENANCE"; color: accent; fontSize: 12; bold: true; weight: 1; maxLines: 1 }
      if overdueCount > 0 || soonCount > 0 {
        Text { text: overdueCount > 0 ? "${overdueCount} overdue" : "${soonCount} due soon"; fontSize: 9; color: overdueCount > 0 ? red : yellow }
      }
      if locked { Text { text: "LOCKED"; fontSize: 9; color: muted } }
    }
    if len(ordered) == 0 {
      Spacer { weight: 1 }
      Text { text: len(vehicles) == 0 ? "Tap to add your first vehicle" : "No maintenance scheduled"; bold: true; fontSize: 15; align: center; maxLines: 2 }
      if len(vehicles) > 0 { Text { text: locked ? "Tap to browse" : "Tap to add a reminder"; color: muted; fontSize: 11; align: center; maxLines: 2 } }
      Spacer { weight: 1 }
    } else {
      Column {
        gap: 0
        background: surface
        for r in ordered.take(previewCount) key r.id {
          Column {
            gap: 0
            ReminderCard { item: r; compact: true }
            Box { height: 1; fill: width; background: muted; opacity: 0.18 }
          }
        }
      }
      Spacer { weight: 1 }
    }
    Row {
      if len(vehicles) > 0 { Text { text: len(ordered) > previewCount ? "+${len(ordered) - previewCount} more" : "Tap to open"; color: muted; fontSize: 10; weight: 1; maxLines: 1 } }
      if !locked && len(vehicles) > 0 {
        Box {
          width: 54; padding: [4,2]; background: surface; radius: 4 * corners
          onTap: { view = "mileagePick"; page = 0; error = ""; screen() }
          Text { text: "+ Odo"; color: accent; fontSize: 11; bold: true }
        }
      }
    }
  }

  screen {
    title: "Car Maintenance"
    Column {
      fill: true
      padding: 12
      gap: 10
      Row {
        gap: 8
        Text { text: "YOUR GARAGE"; color: accent; fontSize: 15; bold: true; weight: 1; maxLines: 1 }
        Box {
          width: 36; height: 30; border: 1; borderColor: accent; radius: 4 * corners; align: center
          onTap: { locked = !locked; view = "home"; confirm = ""; error = ""; setup = false; drafts = []; f = {} }
          Text { text: locked ? "Unlock maintenance" : "Lock maintenance"; opacity: 0; width: 1; height: 1 }
          Canvas {
            width: 23; height: 24
            if locked { path([[7,10],[7,7],[9,4],[15,4],[17,7],[17,10]], stroke: accent, width: 2, cap: round) }
            else { path([[7,10],[7,7],[9,4],[15,4],[17,7]], stroke: accent, width: 2, cap: round) }
            rect(5,10,14,11,radius: 2,stroke: accent,width: 2)
            line(12,14,12,18,stroke: accent,width: 2)
          }
        }
      }
      Flow {
        gap: 6
        Button { text: "Reminders"; color: view == "home" ? accent : muted; onTap: { view = "home"; confirm = ""; error = ""; setup = false; page = 0 } }
        Button { text: "Vehicles"; color: view == "vehicles" ? accent : muted; onTap: { view = "vehicles"; confirm = ""; error = ""; setup = false; page = 0 } }
        Button { text: "History"; color: view == "history" ? accent : muted; onTap: { view = "history"; filterVehicle = 0; page = 0; confirm = ""; error = ""; setup = false } }
        Button { text: "Settings"; color: view == "settings" ? accent : muted; onTap: { f = {days: str(db.days), miles: str(db.miles), km: str(db.km)}; view = "settings"; error = ""; confirm = "" } }
      }
      if locked { Text { text: "Read only · Tap the lock to make changes"; fontSize: 11; color: yellow } }
      if error != "" { Text { text: error; color: red; fontSize: 12; maxLines: 4 } }

      if view == "home" || view == "vehicle" {
        if view == "vehicle" && vehicle != null {
          Column {
            gap: 4; padding: 10; background: surface; radius: 8 * corners
            Text { text: vehicle.name; fontSize: 21; bold: true }
            Text { text: "${vehicle.type} · ${vehicle.unit}"; color: muted; fontSize: 12 }
            Text { text: join([vehicle.registration,vehicle.make,vehicle.model,vehicle.year].filter(x => x != "")," · "); fontSize: 13 }
            Text { text: vehicle.odo == null ? "Odometer unknown" : "${fmtNum(vehicle.odo)} ${vehicle.unit}"; color: accent; fontSize: 19; bold: true }
            Text { text: vehicle.updated == null ? "Odometer has not been recorded" : "Updated ${fmtTime(vehicle.updated,"dd MMM yyyy · HH:mm")}"; fontSize: 11; color: muted }
            Flow {
              gap: 6
              Button { text: "Vehicle history"; onTap: { filterVehicle = vehicleId; page = 0; view = "history" } }
              if !locked {
                Button { text: "Update odo"; onTap: { f = {mileage: vehicle.odo == null ? "" : str(vehicle.odo)}; view = "mileage"; returnView = "vehicle"; error = ""; confirm = "" } }
                Button { text: "Edit vehicle"; onTap: { f = {name: vehicle.name,type: vehicle.type,unit: vehicle.unit,mileage: vehicle.odo == null ? "" : str(vehicle.odo),registration: vehicle.registration,make: vehicle.make,model: vehicle.model,year: vehicle.year}; view = "vehicleForm"; error = ""; confirm = "" } }
                Button { text: "Delete vehicle"; color: red; onTap: confirm = "vehicle" }
              }
            }
            if confirm == "vehicle" && !locked {
              Text { text: "Permanently delete ${vehicle.name}, all its reminders and all its history? This cannot be undone."; color: red; fontSize: 13 }
              Flow {
                Button { text: "Cancel"; onTap: confirm = "" }
                Button { text: "Delete permanently"; color: red; onTap: {
                  if !locked {
                    db = merge(db,{vehicles: vehicles.filter(v => v.id != vehicleId),reminders: reminders.filter(r => r.vehicleId != vehicleId),history: history.filter(h => h.vehicleId != vehicleId),undo: null})
                    view = "vehicles"; confirm = ""; vehicleId = 0; page = 0
                  }
                } }
              }
            }
          }
        } else {
          Row {
            Text { text: "${len(vehicles)} vehicle${len(vehicles) == 1 ? "" : "s"} · ${len(reminders)} reminder${len(reminders) == 1 ? "" : "s"}"; fontSize: 13; color: muted; weight: 1 }
            if !locked && len(vehicles) > 0 { Button { text: "+ Odo"; onTap: { view = "mileagePick"; page = 0 } } }
          }
          if overdueCount > 0 || soonCount > 0 { Text { text: "${overdueCount} overdue · ${soonCount} due now / soon"; color: overdueCount > 0 ? red : yellow; fontSize: 13; bold: true } }
        }
        if !locked {
          Flow {
            gap: 6
            if view == "vehicle" && vehicle != null {
              Button { text: "+ Reminder"; onTap: { reminderId = 0; setup = false; returnView = "vehicle"; f = {name: "",date: "",mileage: "",repeat: "",period: "months",distance: "",warnDays: "",warnDistance: "",notes: ""}; view = "reminderForm"; error = ""; confirm = "" } }
              Button { text: "Suggested reminders"; onTap: { selectedTemplates = []; drafts = []; setupIndex = 0; view = "suggestions"; error = "" } }
            } else {
              Button { text: "+ Vehicle"; onTap: { vehicleId = 0; f = {name: "",type: "Car",unit: "miles",mileage: "",registration: "",make: "",model: "",year: ""}; view = "vehicleForm"; error = ""; confirm = "" } }
              if len(vehicles) > 0 { Button { text: "+ Reminder"; onTap: { view = "reminderPick"; page = 0 } } }
            }
          }
        }
        Column {
          weight: 1; scroll: true; lazy: true; gap: 8
          if len(visibleReminders) == 0 { Text { text: len(vehicles) == 0 ? "Add your first vehicle to get started. Everything stays on this phone." : "No active reminders. Add your own or choose optional suggestions in vehicle details."; color: muted; fontSize: 15 } }
          for r in visibleReminders.drop(page * 20).take(20) key r.id { ReminderCard { item: r } }
        }
        if len(visibleReminders) > 20 { Row {
      if page > 0 { Button { text: "Previous"; onTap: page = page - 1 } }
      Text { text: "${page + 1} / ${ceil(len(visibleReminders) / 20)}"; color: muted; weight: 1; align: center; fontSize: 12 }
      if (page + 1) * 20 < len(visibleReminders) { Button { text: "Next"; onTap: page = page + 1 } }
    } }
      } else if view == "vehicles" || view == "mileagePick" || view == "reminderPick" || view == "historyPick" {
        Text { text: view == "mileagePick" ? "Choose a vehicle to update" : view == "reminderPick" ? "Choose a vehicle for the reminder" : view == "historyPick" ? "Choose a vehicle for the past record" : "Your vehicles · ${len(vehicles)}"; fontSize: 18; bold: true }
        if !locked && view == "vehicles" { Button { text: "+ Add vehicle"; onTap: { vehicleId = 0; f = {name: "",type: "Car",unit: "miles",mileage: "",registration: "",make: "",model: "",year: ""}; view = "vehicleForm"; error = ""; confirm = "" } } }
        Column {
          weight: 1; scroll: true; lazy: true; gap: 8
          if len(vehicles) == 0 { Text { text: "No vehicles yet."; color: muted } }
          for v in vehicles.drop(page * 20).take(20) key v.id {
            Column {
              padding: 12; background: surface; radius: 8 * corners; gap: 5
              onTap: {
                vehicleId = v.id; confirm = ""; error = ""
                if view == "mileagePick" && !locked { f = {mileage: v.odo == null ? "" : str(v.odo)}; returnView = "home"; view = "mileage" }
                else if view == "reminderPick" && !locked { reminderId = 0; setup = false; returnView = "vehicle"; f = {name: "",date: "",mileage: "",repeat: "",period: "months",distance: "",warnDays: "",warnDistance: "",notes: ""}; view = "reminderForm"; error = ""; confirm = "" }
                else if view == "historyPick" && !locked { historyId = 0; f = {name: "",date: fmtTime(now,"dd/MM/yyyy"),mileage: "",unit: vehicle.unit,notes: ""}; view = "historyForm"; error = ""; confirm = "" }
                else { view = "vehicle"; page = 0 }
              }
              Text { text: v.name; fontSize: 18; bold: true }
              Text { text: "${v.type} · ${v.odo == null ? "Odometer unknown" : fmtNum(v.odo) + " " + v.unit}"; color: muted; fontSize: 13 }
            }
          }
        }
        if len(vehicles) > 20 { Row {
      if page > 0 { Button { text: "Previous"; onTap: page = page - 1 } }
      Text { text: "${page + 1} / ${ceil(len(vehicles) / 20)}"; color: muted; weight: 1; align: center; fontSize: 12 }
      if (page + 1) * 20 < len(vehicles) { Button { text: "Next"; onTap: page = page + 1 } }
    } }
      } else if view == "vehicleForm" && !locked {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 12
          Text { text: vehicleId == 0 ? "Add vehicle" : "Edit vehicle"; fontSize: 21; bold: true }
          Field { key: "name"; caption: "VEHICLE NAME · required"; hint: "e.g. Family car" }
          Label { caption: "VEHICLE TYPE" }
          Flow { gap: 5
            for t in ["Car","Van","Motorcycle","Other"] { Button { text: t; color: f.type == t ? accent : muted; onTap: f = merge(f,{type: t}) } }
          }
          Label { caption: "DISTANCE UNIT" }
          Row {
            Button { text: "Miles"; color: f.unit == "miles" ? accent : muted; onTap: { f = merge(f,{unit: "miles"}); confirm = "" } }
            Button { text: "Kilometres"; color: f.unit == "km" ? accent : muted; onTap: { f = merge(f,{unit: "km"}); confirm = "" } }
          }
          if vehicle != null && f.unit != vehicle.unit {
            Text { text: "Unit change: existing odometer and active reminder distances will be explicitly converted and rounded to whole ${f.unit}. History keeps its original units. The odometer field below is still in ${vehicle.unit} until saved."; fontSize: 13; color: yellow }
          }
          Field { key: "mileage"; caption: "CURRENT ODOMETER · optional · whole ${vehicle == null ? f.unit : vehicle.unit}"; hint: "Leave blank if unknown" }
          Field { key: "registration"; caption: "REGISTRATION · optional" }
          Field { key: "make"; caption: "MAKE · optional" }
          Field { key: "model"; caption: "MODEL · optional" }
          Field { key: "year"; caption: "YEAR · optional"; hint: "e.g. 2020" }
          if lowerOdo { Text { text: "This reading is lower than the saved odometer. Confirm only if this correction is intentional."; color: yellow; fontSize: 13 } }
          if vehicle != null && vehicle.odo != null && mileageValue == null { Text { text: "Saving a blank odometer will make mileage urgency unknown."; color: yellow; fontSize: 13 } }
          if confirm == "vehicleSave" { Text { text: "Confirm the vehicle changes above, including the odometer / unit change."; color: yellow; fontSize: 13 } }
        }
        Row {
          Button { text: "Cancel"; weight: 1; onTap: { view = vehicleId == 0 ? "vehicles" : "vehicle"; error = ""; confirm = "" } }
          Button { text: confirm == "vehicleSave" ? "Confirm save" : "Save vehicle"; weight: 1; onTap: {
            if !vehicleFormValid { error = "Enter a vehicle name, a whole non-negative odometer (or leave blank), and a valid four-digit year (or leave blank)." }
            else if vehicleId == 0 && len(vehicles) >= 1000 { error = "The installed OWL runtime has reached its 1,000-entry vehicle list capacity. No data was changed." }
            else if vehicle != null && (lowerOdo || f.unit != vehicle.unit || (vehicle.odo != null && mileageValue == null)) && confirm != "vehicleSave" { confirm = "vehicleSave" }
            else if !locked {
              let fresh = vehicleId == 0
              let savedId = fresh ? db.seq + 1 : vehicleId
              let converting = !fresh && f.unit != vehicle.unit
              let factor = !converting ? 1 : f.unit == "km" ? 1.609344 : 1 / 1.609344
              let savedVehicle = {id: savedId,name: trim(f.name),type: f.type,unit: f.unit,odo: mileageValue == null ? null : round(mileageValue * factor),updated: fresh ? (mileageValue == null ? null : now) : mileageValue != vehicle.odo || converting ? now : vehicle.updated,registration: trim(f.registration),make: trim(f.make),model: trim(f.model),year: trim(f.year)}
              db = merge(db,{seq: fresh ? savedId : db.seq,vehicles: fresh ? vehicles + [savedVehicle] : vehicles.map(v => v.id == savedId ? savedVehicle : v),reminders: converting ? reminders.map(r => r.vehicleId == savedId ? merge(r,{mileage: r.mileage == null ? null : round(r.mileage * factor),distance: r.distance == null ? null : max(1,round(r.distance * factor)),warnDistance: r.warnDistance == null ? null : round(r.warnDistance * factor)}) : r) : reminders,undo: null})
              vehicleId = savedId; confirm = ""; error = ""; page = 0
              if fresh { selectedTemplates = []; drafts = []; setupIndex = 0; view = "suggestions" } else { view = "vehicle" }
            }
          } }
        }
      } else if view == "mileage" && !locked && vehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 14
          Text { text: "Update ${vehicle.name}"; fontSize: 21; bold: true }
          Text { text: vehicle.odo == null ? "Current odometer is unknown" : "Saved: ${fmtNum(vehicle.odo)} ${unit}"; color: muted }
          Field { key: "mileage"; caption: "ODOMETER · whole ${unit}"; hint: "e.g. 45200" }
          Text { text: "Mileage reminders recalculate as soon as you save. This does not add a service history entry."; fontSize: 13; color: muted }
          if lowerOdo { Text { text: "Lower reading: ${fmtNum(mileageValue)} instead of ${fmtNum(vehicle.odo)} ${unit}. Check the value before confirming."; color: yellow } }
        }
        Row {
          Button { text: "Cancel"; weight: 1; onTap: { view = returnView; confirm = ""; error = "" } }
          Button { text: confirm == "lowerOdo" ? "Confirm lower" : "Save reading"; weight: 1; onTap: {
            if !mileageValid || mileageValue == null { error = "Enter a whole, non-negative odometer reading (up to 999,999,999)." }
            else if lowerOdo && confirm != "lowerOdo" { confirm = "lowerOdo" }
            else if !locked {
              db = merge(db,{vehicles: vehicles.map(v => v.id == vehicleId ? merge(v,{odo: mileageValue,updated: now}) : v),undo: null})
              view = returnView; error = ""; confirm = ""
            }
          } }
        }
      } else if view == "suggestions" && !locked && vehicle != null {
        Text { text: "Set up ${vehicle.name}"; fontSize: 21; bold: true }
        Text { text: "Optional suggestions. Select several, configure each, then review. No legal requirements or intervals are assumed."; color: muted; fontSize: 13 }
        Column {
          weight: 1; scroll: true; lazy: true; gap: 6
          for t in templates {
            Box {
              padding: 11; background: surface; radius: 6 * corners
              onTap: selectedTemplates = contains(selectedTemplates,t) ? selectedTemplates.filter(x => x != t) : selectedTemplates + [t]
              Text { text: "${contains(selectedTemplates,t) ? "✓" : "+"}  ${t}"; color: contains(selectedTemplates,t) ? accent : foreground; fontSize: 15 }
            }
          }
        }
        Flow {
          Button { text: "Skip setup"; onTap: { view = "vehicle"; setup = false; drafts = [] } }
          if len(selectedTemplates) > 0 {
            Button { text: "Configure ${len(selectedTemplates)}"; onTap: {
              setup = true; setupIndex = 0; drafts = []; f = {name: "",date: "",mileage: "",repeat: "",period: "months",distance: "",warnDays: "",warnDistance: "",notes: ""}
              f = merge(f,{name: selectedTemplates[0] == "Custom maintenance" ? "" : selectedTemplates[0]}); view = "reminderForm"; error = ""
            } }
          }
        }
      } else if view == "reminderForm" && !locked && vehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 12
          Text { text: setup ? "Suggestion ${setupIndex + 1} of ${len(selectedTemplates)}" : reminderId == 0 ? "Add reminder" : "Edit reminder"; fontSize: 21; bold: true }
          Text { text: vehicle.name; color: accent; fontSize: 15 }
          if !setup && reminderId == 0 {
            Label { caption: "OPTIONAL TEMPLATE · tap to use the name" }
            Flow { gap: 4
              for t in templates { Button { text: t; onTap: f = merge(f,{name: t == "Custom maintenance" ? "" : t}) } }
            }
          }
          Field { key: "name"; caption: "MAINTENANCE NAME · required"; hint: "e.g. Oil Service" }
          Field { key: "date"; caption: "DUE DATE · DD/MM/YYYY · optional if mileage set"; hint: "e.g. 01/12/2026" }
          Field { key: "mileage"; caption: "DUE ODOMETER · whole ${unit} · optional if date set" }
          Text { text: "With both conditions, maintenance is due when either is reached. Unknown odometer readings do not produce mileage urgency."; color: muted; fontSize: 12 }
          Label { caption: "REPEAT INTERVAL · optional · no defaults assumed" }
          Field { key: "repeat"; caption: "REPEAT EVERY · positive whole number, or blank" }
          Flow { gap: 5
            for t in ["days","weeks","months","years"] { Button { text: capitalize(t); color: f.period == t ? accent : muted; onTap: f = merge(f,{period: t}) } }
          }
          Field { key: "distance"; caption: "REPEAT DISTANCE · whole ${unit}, or blank" }
          Label { caption: "WARNINGS · blank uses your global defaults" }
          Field { key: "warnDays"; caption: "DAYS BEFORE · default ${db.days}" }
          Field { key: "warnDistance"; caption: "${upper(unit)} BEFORE · default ${unit == "miles" ? db.miles : db.km}" }
          Field { key: "notes"; caption: "NOTES · optional" }
          Text { text: "Repeats only suggest the next reminder when you complete maintenance. Nothing repeats without your confirmation."; fontSize: 12; color: muted }
        }
        Row {
          Button { text: setup ? "Cancel setup" : "Cancel"; weight: 1; onTap: { view = setup ? "suggestions" : returnView; setup = false; drafts = []; error = "" } }
          Button { text: setup ? "Review this suggestion" : "Save reminder"; weight: 1; onTap: {
            if !reminderFormValid { error = "Enter a name and a real DD/MM/YYYY date and/or whole due odometer. Intervals must be positive whole numbers; warnings can be zero or blank. Check the repeat interval range." }
            else if !setup && reminderId == 0 && len(reminders) >= 1000 { error = "The installed OWL runtime has reached its 1,000-entry reminder list capacity. No data was changed." }
            else if !locked {
              let savedReminder = {id: reminderId,vehicleId: vehicleId,name: trim(f.name),date: dateText == "" ? "" : dateISO,mileage: mileageValue,repeat: trim(f.repeat) == "" ? null : num(f.repeat),period: f.period,distance: trim(f.distance) == "" ? null : num(f.distance),warnDays: trim(f.warnDays) == "" ? null : num(f.warnDays),warnDistance: trim(f.warnDistance) == "" ? null : num(f.warnDistance),notes: trim(f.notes)}
              if setup {
                drafts = drafts + [savedReminder]
                view = "setupItemReview"
              } else {
                let savedId = reminderId == 0 ? db.seq + 1 : reminderId
                db = merge(db,{seq: reminderId == 0 ? savedId : db.seq,reminders: reminderId == 0 ? reminders + [merge(savedReminder,{id: savedId})] : reminders.map(r => r.id == reminderId ? savedReminder : r),undo: null})
                reminderId = savedId; view = "reminder"; error = ""; page = 0
              }
            }
          } }
        }
      } else if view == "setupItemReview" && !locked {
        let draft = last(drafts)
        Column {
          weight: 1; scroll: true; lazy: true; gap: 12
          Text { text: "Review suggestion"; fontSize: 21; bold: true }
          Text { text: draft.name; fontSize: 19; bold: true }
          Text { text: "${vehicle.name} · ${draft.date == "" ? "No due date" : fmtTime(parseTime(draft.date + "T12:00:00Z"),"dd/MM/yyyy","UTC")} · ${draft.mileage == null ? "No due mileage" : fmtNum(draft.mileage) + " " + unit}" }
          Text { text: "Repeat: ${draft.repeat == null ? "none by time" : str(draft.repeat) + " " + draft.period} · ${draft.distance == null ? "none by distance" : fmtNum(draft.distance) + " " + unit}"; color: muted }
          Text { text: "Warnings: ${draft.warnDays ?? db.days} days · ${fmtNum(draft.warnDistance ?? (unit == "miles" ? db.miles : db.km))} ${unit}"; color: muted }
          Text { text: draft.notes == "" ? "No notes" : draft.notes }
          Text { text: "This is still a draft. Save all suggestions on the final review."; color: yellow; fontSize: 13 }
        }
        Flow {
          Button { text: "Edit"; onTap: { drafts = drafts.take(len(drafts) - 1); view = "reminderForm" } }
          Button { text: setupIndex + 1 < len(selectedTemplates) ? "Next suggestion" : "Review all"; onTap: {
            setupIndex = setupIndex + 1
            if setupIndex < len(selectedTemplates) { f = {name: "",date: "",mileage: "",repeat: "",period: "months",distance: "",warnDays: "",warnDistance: "",notes: ""}
              f = merge(f,{name: selectedTemplates[setupIndex] == "Custom maintenance" ? "" : selectedTemplates[setupIndex]}); view = "reminderForm"
            } else { view = "setupReview" }
          } }
        }
      } else if view == "setupReview" && !locked && vehicle != null {
        Text { text: "Review ${len(drafts)} reminders"; fontSize: 21; bold: true }
        Text { text: "For ${vehicle.name}. Save only when you are happy with every draft."; color: muted; fontSize: 13 }
        Column {
          weight: 1; scroll: true; lazy: true; gap: 8
          for d in drafts {
            Column { padding: 10; background: surface; radius: 8 * corners
              Text { text: d.name; bold: true; fontSize: 16 }
              Text { text: "${d.date == "" ? "No date" : fmtTime(parseTime(d.date + "T12:00:00Z"),"dd/MM/yyyy","UTC")} · ${d.mileage == null ? "No due mileage" : fmtNum(d.mileage) + " " + unit}"; fontSize: 13 }
              Text { text: "Repeat: ${d.repeat == null ? "none by time" : str(d.repeat) + " " + d.period} · ${d.distance == null ? "none by distance" : fmtNum(d.distance) + " " + unit}"; fontSize: 12; color: muted }
            }
          }
        }
        Row {
          Button { text: "Discard setup"; weight: 1; onTap: { view = "vehicle"; setup = false; drafts = [] } }
          Button { text: "Save all ${len(drafts)}"; weight: 1; onTap: {
            if len(reminders) + len(drafts) > 1000 { error = "These drafts exceed the installed OWL runtime's 1,000-entry reminder list capacity. No data was changed." }
            else if !locked {
              db = merge(db,{seq: db.seq + len(drafts),reminders: reminders + drafts.map((d,i) => merge(d,{id: db.seq + i + 1})),undo: null})
              view = "vehicle"; setup = false; drafts = []; page = 0
            }
          } }
        }
      } else if view == "reminder" && reminder != null && reminderVehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 12
          Text { text: reminder.name; fontSize: 23; bold: true }
          Text { text: reminderVehicle.name; color: accent; fontSize: 17; onTap: { vehicleId = reminder.vehicleId; view = "vehicle"; page = 0; confirm = "" } }
          Text { text: focusedReminder.rank == 0 ? "OVERDUE" : focusedReminder.rank == 1 ? (focusedReminder.daysLeft == 0 ? "DUE TODAY" : "DUE NOW") : focusedReminder.rank == 2 ? "DUE SOON" : focusedReminder.rank == 4 ? "UNKNOWN MILEAGE STATUS" : "UPCOMING"; color: focusedReminder.rank == 0 ? red : focusedReminder.rank <= 2 ? yellow : muted; bold: true }
          if reminder.date != "" { Text { text: "Due date: ${fmtTime(parseTime(reminder.date + "T12:00:00Z"),"dd MMMM yyyy","UTC")} · ${focusedReminder.daysLeft < 0 ? str(abs(focusedReminder.daysLeft)) + " days overdue" : focusedReminder.daysLeft == 0 ? "today" : "in " + str(focusedReminder.daysLeft) + " days"}" } }
          if reminder.mileage != null {
            Text { text: "Due at ${fmtNum(reminder.mileage)} ${reminderVehicle.unit}" }
            Text { text: reminderVehicle.odo == null ? "Mileage status unknown — update the vehicle odometer to calculate urgency." : "Current: ${fmtNum(reminderVehicle.odo)} ${reminderVehicle.unit} · ${focusedReminder.remaining < 0 ? fmtNum(abs(focusedReminder.remaining)) + " overdue" : focusedReminder.remaining == 0 ? "due now" : fmtNum(focusedReminder.remaining) + " remaining"}"; color: reminderVehicle.odo == null ? yellow : muted; fontSize: 14 }
          }
          if reminder.date != "" && reminder.mileage != null { Text { text: "Due when either date or mileage is reached."; color: muted; fontSize: 13 } }
          Text { text: "Time repeat: ${reminder.repeat == null ? "None" : str(reminder.repeat) + " " + reminder.period}" }
          Text { text: "Distance repeat: ${reminder.distance == null ? "None" : fmtNum(reminder.distance) + " " + reminderVehicle.unit}" }
          Text { text: "Warning: ${focusedReminder.warningDays} days / ${fmtNum(focusedReminder.warningDistance)} ${reminderVehicle.unit}"; color: muted; fontSize: 13 }
          Label { caption: "NOTES" }
          Text { text: reminder.notes == "" ? "No notes" : reminder.notes; fontSize: 15 }
          if !locked {
            Flow {
              Button { text: "Complete"; onTap: {
                vehicleId = reminder.vehicleId; f = {date: fmtTime(now,"dd/MM/yyyy"),mileage: reminderVehicle.odo == null ? "" : str(reminderVehicle.odo),notes: "",keepNext: false,nextDate: "",nextMileage: ""}; view = "completeForm"; error = ""; confirm = ""
              } }
              Button { text: "Edit"; onTap: { vehicleId = reminder.vehicleId; setup = false; returnView = "reminder"; f = {name: reminder.name,date: reminder.date == "" ? "" : fmtTime(parseTime(reminder.date + "T12:00:00Z"),"dd/MM/yyyy","UTC"),mileage: reminder.mileage == null ? "" : str(reminder.mileage),repeat: reminder.repeat == null ? "" : str(reminder.repeat),period: reminder.period,distance: reminder.distance == null ? "" : str(reminder.distance),warnDays: reminder.warnDays == null ? "" : str(reminder.warnDays),warnDistance: reminder.warnDistance == null ? "" : str(reminder.warnDistance),notes: reminder.notes}; view = "reminderForm"; error = ""; confirm = "" } }
              Button { text: "Delete"; color: red; onTap: confirm = "reminder" }
            }
            if confirm == "reminder" {
              Text { text: "Permanently delete this active reminder? Existing maintenance history will be kept."; color: yellow; fontSize: 14 }
              Flow {
                Button { text: "Cancel"; onTap: confirm = "" }
                Button { text: "Delete reminder"; color: red; onTap: {
                  if !locked { db = merge(db,{reminders: reminders.filter(r => r.id != reminderId),undo: null}); view = "home"; page = 0; confirm = "" }
                } }
              }
            }
          }
        }
      } else if (view == "completeForm" || view == "historyForm") && !locked && vehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 13
          Text { text: view == "completeForm" ? "Complete maintenance" : historyId == 0 ? "Add past maintenance" : "Edit history record"; fontSize: 21; bold: true }
          Text { text: vehicle.name; color: accent; fontSize: 16 }
          if view == "completeForm" { Text { text: reminder.name; bold: true; fontSize: 18 } }
          else { Field { key: "name"; caption: "MAINTENANCE NAME · required" } }
          Field { key: "date"; caption: "COMPLETION DATE · DD/MM/YYYY" }
          Field { key: "mileage"; caption: "ODOMETER AT COMPLETION · optional · whole ${view == "historyForm" ? f.unit : unit}" }
          Field { key: "notes"; caption: "NOTES · optional" }
          if view == "historyForm" { Text { text: "A past record does not change the current odometer or any active reminders. Recorded unit: ${f.unit}."; color: muted; fontSize: 13 } }
          else { Text { text: "Recording a service odometer does not replace the vehicle's current reading. Use Update odo in vehicle details to change it."; color: muted; fontSize: 13 } }
        }
        Row {
          Button { text: "Cancel"; weight: 1; onTap: { view = view == "completeForm" ? "reminder" : historyId == 0 ? "history" : "record"; error = "" } }
          Button { text: "Review"; weight: 1; onTap: {
            if !dateValid || dateISO > today || !mileageValid || (view == "historyForm" && trim(f.name) == "") { error = "Enter a real completion date on or before today (DD/MM/YYYY), a name, and an optional whole non-negative odometer." }
            else if view == "completeForm" {
              let distanceSuggestion = reminder.distance != null && mileageValue != null ? str(mileageValue + reminder.distance) : ""
              f = merge(f,{nextDate: proposedDate,nextMileage: distanceSuggestion,keepNext: proposedDate != "" || distanceSuggestion != ""})
              view = "completionReview"; error = ""
            } else { view = "historyReview"; error = "" }
          } }
        }
      } else if view == "completionReview" && !locked && reminder != null && vehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 13
          Text { text: "Confirm completion"; fontSize: 21; bold: true }
          Text { text: "${reminder.name} · ${vehicle.name}"; bold: true }
          Text { text: "Completed ${f.date} · ${mileageValue == null ? "No odometer recorded" : fmtNum(mileageValue) + " " + unit}" }
          Text { text: trim(f.notes) == "" ? "No completion notes" : f.notes }
          Text { text: "The current reminder will be replaced by a history record. Review the optional next reminder below."; fontSize: 13; color: muted }
          Button { text: f.keepNext ? "✓ Create next reminder" : "+ Create next reminder"; color: f.keepNext ? accent : muted; onTap: f = merge(f,{keepNext: !f.keepNext}) }
          if f.keepNext {
            Field { key: "nextDate"; caption: "NEXT DUE DATE · DD/MM/YYYY, or blank" }
            Field { key: "nextMileage"; caption: "NEXT DUE ODOMETER · whole ${unit}, or blank" }
            Text { text: "Suggestions use the completion date and recorded odometer. Edit either field, or remove the next reminder using the toggle above."; fontSize: 13; color: muted }
          } else { Text { text: "No next reminder will be saved."; color: yellow; fontSize: 14 } }
          if reminder.distance != null && mileageValue == null { Text { text: "No distance suggestion is possible without a completion odometer. You can enter a next due mileage yourself."; color: yellow; fontSize: 13 } }
          if (f.keepNext && nextMileageValue != null && vehicle.odo != null && nextMileageValue <= vehicle.odo) || (f.keepNext && nextText != "" && nextISO <= today) { Text { text: "The next reminder is already due or overdue. Check the values before confirming."; color: yellow; fontSize: 13 } }
        }
        Row {
          Button { text: "Back"; weight: 1; onTap: { view = "completeForm"; error = "" } }
          Button { text: "Confirm completion"; weight: 1; onTap: {
            if f.keepNext && (!nextValid || !nextMileageValid || (nextText == "" && nextMileageText == "")) { error = "Set a real next date and/or whole next odometer, or turn off Create next reminder." }
            else if len(history) >= 1000 { error = "The installed OWL runtime has reached its 1,000-entry history list capacity. No data was changed." }
            else if !locked {
              let original = reminder
              let historyKey = db.seq + 1
              let nextKey = f.keepNext ? db.seq + 2 : 0
              let serviceRecord = {id: historyKey,vehicleId: vehicleId,name: original.name,date: dateISO,mileage: mileageValue,unit: unit,notes: trim(f.notes)}
              let nextReminder = merge(original,{id: nextKey,date: nextText == "" ? "" : nextISO,mileage: nextMileageValue})
              db = merge(db,{seq: f.keepNext ? nextKey : historyKey,history: history + [serviceRecord],reminders: reminders.filter(r => r.id != original.id) + (f.keepNext ? [nextReminder] : []),undo: {original: original,historyId: historyKey,nextId: nextKey}})
              view = "history"; filterVehicle = 0; page = 0; error = ""
            }
          } }
        }
      } else if view == "history" {
        Row {
          Text { text: filterVehicle == 0 ? "All maintenance history" : "${vehicles.find(v => v.id == filterVehicle).name} · History"; fontSize: 18; bold: true; weight: 1; maxLines: 2 }
          if filterVehicle != 0 { Button { text: "Show all"; onTap: { filterVehicle = 0; page = 0 } } }
        }
        if !locked {
          Flow {
            if len(vehicles) > 0 { Button { text: "+ Past record"; onTap: { view = "historyPick"; page = 0 } } }
            if undoAvailable { Button { text: "Undo last completion"; onTap: confirm = "undo" } }
          }
          if confirm == "undo" && undoAvailable {
            Text { text: "Undo ${db.undo.original.name}? This removes its completion record and confirmed next reminder, and restores the original reminder."; color: yellow; fontSize: 13 }
            Flow {
              Button { text: "Keep completion"; onTap: confirm = "" }
              Button { text: "Confirm undo"; onTap: {
                if !locked && undoAvailable {
                  let undo = db.undo
                  db = merge(db,{history: history.filter(h => h.id != undo.historyId),reminders: reminders.filter(r => r.id != undo.nextId) + [undo.original],undo: null})
                  confirm = ""; page = 0
                }
              } }
            }
          }
        }
        Column {
          weight: 1; scroll: true; lazy: true; gap: 8
          if len(filteredHistory) == 0 { Text { text: "No maintenance history yet."; color: muted } }
          for h in filteredHistory.drop(page * 20).take(20) key h.id {
            let hv = vehicles.find(v => v.id == h.vehicleId)
            Column {
              padding: 10; background: surface; radius: 8 * corners; gap: 4
              onTap: { historyId = h.id; view = "record"; confirm = "" }
              Text { text: h.name; fontSize: 16; bold: true }
              Text { text: "${hv.name ?? "Unknown vehicle"} · ${fmtTime(parseTime(h.date + "T12:00:00Z"),"dd MMM yyyy","UTC")}"; fontSize: 12; color: muted }
              if h.mileage != null { Text { text: "${fmtNum(h.mileage)} ${h.unit}"; fontSize: 13 } }
            }
          }
        }
        if len(filteredHistory) > 20 { Row {
      if page > 0 { Button { text: "Previous"; onTap: page = page - 1 } }
      Text { text: "${page + 1} / ${ceil(len(filteredHistory) / 20)}"; color: muted; weight: 1; align: center; fontSize: 12 }
      if (page + 1) * 20 < len(filteredHistory) { Button { text: "Next"; onTap: page = page + 1 } }
    } }
      } else if view == "record" && record != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 14
          Text { text: record.name; fontSize: 23; bold: true }
          Text { text: recordVehicle.name ?? "Unknown vehicle"; color: accent; fontSize: 17 }
          Text { text: "Completed ${fmtTime(parseTime(record.date + "T12:00:00Z"),"dd MMMM yyyy","UTC")}" }
          Text { text: record.mileage == null ? "No odometer recorded" : "${fmtNum(record.mileage)} ${record.unit}" }
          Text { text: record.notes == "" ? "No notes" : record.notes }
          if !locked {
            Flow {
              Button { text: "Edit record"; onTap: { vehicleId = record.vehicleId; f = {name: record.name,date: fmtTime(parseTime(record.date + "T12:00:00Z"),"dd/MM/yyyy","UTC"),mileage: record.mileage == null ? "" : str(record.mileage),unit: record.unit,notes: record.notes}; view = "historyForm"; error = ""; confirm = "" } }
              Button { text: "Delete record"; color: red; onTap: confirm = "history" }
            }
            if confirm == "history" {
              Text { text: "Permanently delete this history record? Active reminders stay as they are."; color: yellow; fontSize: 14 }
              Flow {
                Button { text: "Cancel"; onTap: confirm = "" }
                Button { text: "Delete permanently"; color: red; onTap: {
                  if !locked { db = merge(db,{history: history.filter(h => h.id != historyId),undo: null}); view = "history"; page = 0; confirm = "" }
                } }
              }
            }
          }
        }
      } else if view == "historyReview" && !locked && vehicle != null {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 14
          Text { text: historyId == 0 ? "Confirm past maintenance" : "Confirm history changes"; fontSize: 21; bold: true }
          Text { text: "${f.name} · ${vehicle.name}"; fontSize: 18; bold: true }
          Text { text: "Completed ${f.date}" }
          Text { text: mileageValue == null ? "No odometer recorded" : "${fmtNum(mileageValue)} ${f.unit}" }
          Text { text: trim(f.notes) == "" ? "No notes" : f.notes }
        }
        Row {
          Button { text: "Back"; weight: 1; onTap: view = "historyForm" }
          Button { text: "Confirm save"; weight: 1; onTap: {
            if historyId == 0 && len(history) >= 1000 { error = "The installed OWL runtime has reached its 1,000-entry history list capacity. No data was changed." }
            else if !locked {
              let recordKey = historyId == 0 ? db.seq + 1 : historyId
              let savedRecord = {id: recordKey,vehicleId: vehicleId,name: trim(f.name),date: dateISO,mileage: mileageValue,unit: f.unit,notes: trim(f.notes)}
              db = merge(db,{seq: historyId == 0 ? recordKey : db.seq,history: historyId == 0 ? history + [savedRecord] : history.map(h => h.id == historyId ? savedRecord : h),undo: null})
              historyId = recordKey; view = "record"; error = ""
            }
          } }
        }
      } else if view == "settings" {
        Column {
          weight: 1; scroll: true; lazy: true; gap: 14
          Text { text: "Default warnings"; fontSize: 21; bold: true }
          Text { text: "Reminders with blank warning fields inherit these settings. A zero warning means alert only when due."; fontSize: 13; color: muted }
          if !locked {
            Field { key: "days"; caption: "DAYS BEFORE A DUE DATE" }
            Field { key: "miles"; caption: "MILES BEFORE DUE ODOMETER" }
            Field { key: "km"; caption: "KILOMETRES BEFORE DUE ODOMETER" }
            Button { text: "Save defaults"; onTap: {
              if ![f.days,f.miles,f.km].all(x => match(trim(x),"^[0-9]+$") != null && num(x) <= 999999999) { error = "Enter whole non-negative numbers for all three warnings." }
              else if !locked { db = merge(db,{days: num(f.days),miles: num(f.miles),km: num(f.km)}); error = ""; view = "home"; page = 0 }
            } }
          } else { Text { text: "${db.days} days · ${fmtNum(db.miles)} miles · ${fmtNum(db.km)} km" } }
          Text { text: "Undo last completion is available in History until another vehicle, reminder, history or odometer change. It survives widget reloads."; color: muted; fontSize: 13 }
          Text { text: "The installed OWL runtime allows up to 1,000 entries per list. Capacity checks prevent a full list from losing existing records."; color: muted; fontSize: 13 }
          Text { text: "Car Maintenance · Version 1.0\nOffline · Local persistent data\nRead-only lock prevents accidental edits."; color: muted; fontSize: 12 }
        }
      } else {
        Text { text: "This item is no longer available. Use the tabs above to continue."; color: muted }
        Spacer { weight: 1 }
      }
      Text { text: "Saved on this phone · Works offline"; fontSize: 10; color: muted }
    }
  }
}
