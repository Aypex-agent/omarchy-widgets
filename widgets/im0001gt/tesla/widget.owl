widget "tesla" {
  size: 3x3
  minSize: 3x3
  meta {
    description: "Read-only Tesla status: battery, range, lock, climate, tires and charge limit. It never wakes the car."
    version: "1.7"
    license: "MIT"
    category: "home"
    owl: 6
  }
  requires { pacman: ["curl", "jq", "openssl"] }

  // The reader installs itself on first run. The selected car is a VIN file,
  // and refresh touches a force file. Nothing here calls wake_up.
  // A missing refresh-token file is "no key", not a network failure. Moving
  // phones or restoring a backup does not bring that file. Reset deletes only
  // the token files on this device.
  state vin = "" persist
  source src = cmd("""
  # Installs ~/.local/bin/tesla-status from this file, then prints one status reading.
  # openssl base64 -d reads the token issuer only, to pick China or global servers.
  # chmod 700 keeps the token directory owner-only. chmod 755 makes the reader runnable.
  set -uo pipefail
  umask 077
  dest="$HOME/.local/bin/tesla-status"
  marker="# tesla-status-widget 1.7"
  if ! grep -qxF "$marker" "$dest" 2>/dev/null; then
    mkdir -p "$HOME/.local/bin"
    cat > "$dest" << 'TESLA_STATUS_END'
  #!/bin/bash
  # tesla-status-widget 1.7
  # Read-only Tesla status for the home-screen widget.
  #
  # Talks to Tesla's owner API. Never calls wake_up. A parked, awake car is
  # read at most once every 15 minutes, so this tile cannot be what keeps it
  # from sleeping. Asleep and offline cars return the last reading.
  #
  # The refresh token is the whole account. It lives only in
  # ~/.config/omarchy-tesla/refresh-token (mode 600), never in the widget file
  # and never on a command line.

  set -uo pipefail
  umask 077

  readonly OWNER_API="https://owner-api.teslamotors.com/api/1"
  readonly OWNER_API_CN="https://owner-api.vn.cloud.tesla.cn/api/1"
  readonly AUTH="https://auth.tesla.com/oauth2/v3"
  readonly AUTH_CN="https://auth.tesla.cn/oauth2/v3"
  readonly CLIENT_ID="ownerapi"
  readonly SCOPE="openid email offline_access"
  # Token calls must be TLS 1.3. Tesla records the handshake in the token and
  # the owner API rejects TLS 1.2 with a message that looks like "use the Fleet
  # API". The token is fine; the handshake was not.
  readonly TLS_PIN="--tlsv1.3"
  readonly APP_UA="Mozilla/5.0 (Linux; Android 10; Pixel 3) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120.0 Mobile Safari/537.36"
  readonly APP_TAG="TeslaApp/4.30.6"

  CONFIG_DIR="${OMARCHY_TESLA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tesla}"
  CACHE_DIR="${OMARCHY_TESLA_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-tesla}"
  readonly API_ERROR_FILE="$CACHE_DIR/.last-error"
  readonly PARK_THROTTLE=900
  readonly DRIVE_THROTTLE=10
  readonly CHARGE_THROTTLE=45

  die() { printf 'tesla-status: %s\n' "$*" >&2; exit 1; }

  fail_json() {
    jq -cn --arg error "${1:-not signed in}" --arg hint "${2-}" \
      '{ready: false, error: $error, hint: (if $hint == "" then null else $hint end)}'
    exit 0
  }

  need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

  need curl
  need jq
  need openssl

  mkdir -p "$CONFIG_DIR" "$CACHE_DIR/cars"
  # Owner-only. The refresh token for the whole account lives in this directory.
  chmod 700 "$CONFIG_DIR" "$CACHE_DIR" "$CACHE_DIR/cars" 2>/dev/null || true

  now() { date +%s; }

  # Only plain digits reach arithmetic. A forged expires_in never becomes shell code.
  number_or() {
    local value="$1" fallback="$2"
    case "$value" in
      ''|*[!0-9]*) printf '%s' "$fallback"; return 0 ;;
    esac
    [ "${#value}" -le 12 ] || { printf '%s' "$fallback"; return 0; }
    printf '%s' "$((10#$value))"
  }

  write_private() {
    local path="$1" tmp
    tmp=$(mktemp "${path}.XXXXXX") || return 1
    cat > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$path"
  }

  read_first_line() {
    [ -r "$1" ] || return 1
    local line
    line=$(head -n 1 "$1" | tr -d '\r\n')
    [ -n "$line" ] || return 1
    printf '%s' "$line"
  }

  jwt_issuer() {
    local token="$1" payload padding
    payload=${token#*.}
    [ "$payload" != "$token" ] || return 1
    payload=${payload%%.*}
    case "$payload" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
    case $((${#payload} % 4)) in
      0) padding="" ;;
      2) padding="==" ;;
      3) padding="=" ;;
      *) return 1 ;;
    esac
    # Issuer claim only: a China account uses Tesla's China servers, and
    # every other account uses the global ones. This is not a downloaded payload.
    printf '%s%s' "$payload" "$padding" | tr '_-' '/+' \
      | openssl base64 -d -A 2>/dev/null \
      | jq -er '.iss | strings | select(length > 0)' 2>/dev/null
  }

  auth_for() {
    case "$(jwt_issuer "$1" || true)" in
      https://auth.tesla.cn/oauth2/v3) printf '%s' "$AUTH_CN" ;;
      *) printf '%s' "$AUTH" ;;
    esac
  }

  owner_api_for() {
    case "$(jwt_issuer "$1" || true)" in
      https://auth.tesla.cn/oauth2/v3) printf '%s' "$OWNER_API_CN" ;;
      *) printf '%s' "$OWNER_API" ;;
    esac
  }

  refresh_token() {
    if [ -n "${TESLA_REFRESH_TOKEN:-}" ]; then printf '%s' "$TESLA_REFRESH_TOKEN"; return 0; fi
    read_first_line "$CONFIG_DIR/refresh-token"
  }

  # Mint an access token. The refresh token is written on stdin, never as an
  # argument, because arguments are world-readable in /proc.
  mint_access_token() {
    local refresh="$1" auth response token expires_in new_refresh
    [ -n "$refresh" ] || return 1
    auth=$(auth_for "$refresh")
    response=$(
      jq -cRn --arg id "$CLIENT_ID" --arg scope "$SCOPE" \
        '{grant_type: "refresh_token", client_id: $id, refresh_token: input, scope: $scope}' \
        <<<"$refresh" |
        curl -sS $TLS_PIN -m 20 -X POST "$auth/token" \
          -H "Content-Type: application/json" \
          -H "User-Agent: $APP_UA" \
          -H "X-Tesla-User-Agent: $APP_TAG" \
          --data-binary @-
    ) || return 1
    token=$(printf '%s' "$response" | jq -r '.access_token // empty' 2>/dev/null) || true
    [ -n "$token" ] || return 1
    expires_in=$(number_or "$(printf '%s' "$response" | jq -r '.expires_in // empty' 2>/dev/null)" 28800)
    new_refresh=$(printf '%s' "$response" | jq -r '.refresh_token // empty' 2>/dev/null) || true
    write_private "$CONFIG_DIR/access-token" <<<"$token"
    write_private "$CONFIG_DIR/access-token-expires" <<<"$(( $(now) + expires_in ))"
    [ -n "$new_refresh" ] && write_private "$CONFIG_DIR/refresh-token" <<<"$new_refresh"
    printf '%s' "$token"
  }

  access_token() {
    if [ -n "${TESLA_ACCESS_TOKEN:-}" ]; then printf '%s' "$TESLA_ACCESS_TOKEN"; return 0; fi
    local token expires
    token=$(read_first_line "$CONFIG_DIR/access-token" 2>/dev/null) || token=""
    expires=$(number_or "$(read_first_line "$CONFIG_DIR/access-token-expires" 2>/dev/null || true)" 0)
    if [ -n "$token" ] && [ "$expires" -gt "$(( $(now) + 60 ))" ]; then
      printf '%s' "$token"
      return 0
    fi
    local refresh
    refresh=$(refresh_token) || return 1
    mint_access_token "$refresh"
  }

  api_error() { cat "$API_ERROR_FILE" 2>/dev/null || true; }

  api_hint() {
    case "$(api_error)" in
      "owner API retired"*) printf '%s' "this account has to use Tesla's Fleet API, which this tile does not speak" ;;
      "not signed in") printf '%s' "paste a refresh token with: tesla-status token" ;;
      *) printf '' ;;
    esac
  }

  # GET only. There is no method argument, so this cannot wake the car.
  api_get() {
    local path="$1" token owner_api body complaint
    : > "$API_ERROR_FILE"
    token=$(access_token) || { printf 'not signed in' > "$API_ERROR_FILE"; return 2; }
    owner_api=$(owner_api_for "$token")
    case "$token" in
      *[\"\\]*|*[[:space:]]*) printf 'malformed token' > "$API_ERROR_FILE"; return 2 ;;
    esac
    case "$path" in
      *[!A-Za-z0-9_./?=%-]*) printf 'bad request' > "$API_ERROR_FILE"; return 2 ;;
    esac
    # The bearer token is a curl config on stdin, not an argument: arguments
    # are world-readable in /proc for as long as the request runs.
    body=$(
      curl -sS -m 12 -X GET --config - \
        -H "User-Agent: $APP_UA" \
        -H "X-Tesla-User-Agent: $APP_TAG" \
        -H "Accept: application/json" \
        "$owner_api/$path" <<EOF
  header = "Authorization: Bearer ${token}"
  EOF
    ) || { printf 'cannot reach Tesla' > "$API_ERROR_FILE"; return 1; }
    complaint=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null) || complaint=""
    case "$complaint" in
      "") ;;
      *fleet-api*|*fleetapi*) printf 'owner API retired for this account' > "$API_ERROR_FILE" ;;
      *) printf '%s' "$complaint" > "$API_ERROR_FILE" ;;
    esac
    printf '%s' "$body"
  }

  cmd_token() {
    local refresh access
    if [ -t 0 ]; then
      printf 'Paste the refresh token and press enter.\n' >&2
    fi
    IFS= read -r refresh || true
    refresh=${refresh//[$' \t\r\n"']/}
    [ -n "$refresh" ] || die "nothing pasted"
    write_private "$CONFIG_DIR/refresh-token" <<<"$refresh"
    rm -f "$CONFIG_DIR/access-token" "$CONFIG_DIR/access-token-expires"
    access=$(mint_access_token "$refresh") || {
      rm -f "$CONFIG_DIR/refresh-token" "$CONFIG_DIR/access-token" "$CONFIG_DIR/access-token-expires"
      die "Tesla refused that token. Paste the refresh token, not the access token."
    }
    [ -n "$access" ] || die "Tesla refused that token"
    printf 'Signed in. Token file: %s\nOpen the tesla tile and tap refresh.\n' "$CONFIG_DIR/refresh-token"
  }

  vehicle_list() {
    local cache="$CACHE_DIR/vehicles.json" age response vehicles
    if [ -r "$cache" ]; then
      age=$(( $(now) - $(number_or "$(stat -c %Y "$cache" 2>/dev/null || echo 0)" 0) ))
      if [ "$age" -lt 86400 ]; then cat "$cache"; return 0; fi
    fi
    response=$(api_get products) || return 2
    [ -z "$(api_error)" ] || return 3
    vehicles=$(printf '%s' "$response" | jq -c '[.response[]? | select(.vin != null and (.vin|type) == "string")]') || return 1
    if [ "$(printf '%s' "$vehicles" | jq -r 'length')" -le 0 ]; then
      printf 'no cars on this account' > "$API_ERROR_FILE"
      return 1
    fi
    write_private "$cache" <<<"$vehicles"
    printf '%s' "$vehicles"
  }

  # Build the widget payload from one vehicle_data response. Location fields
  # are dropped on purpose: this tile has no map, and the cache should not
  # become a log of where the car has been.
  reading_json() {
    jq -c --arg state "$2" --argjson fresh "$3" --arg at "$(now)" --arg fallback "$4" '
      def flag($v): ($v // 0) != 0;
      def press($v; $pc): if $v == null or $v <= 0 then null else ($v * $pc * 10 | round / 10) end;
      . as $r
      | ($r.gui_settings.gui_distance_units // "km/hr") as $units
      | (if ($units | startswith("mi")) then 1 else 1.609344 end) as $k
      | (if ($units | startswith("mi")) then "mi" else "km" end) as $dist
      | (if ($units | startswith("mi")) then "mph" else "km/h" end) as $speed
      | (if ($r.gui_settings.gui_range_display // "Rated") == "Ideal"
         then $r.charge_state.ideal_battery_range else $r.charge_state.battery_range end) as $range
      | (($r.gui_settings.gui_temperature_units // "C") == "F") as $fahrenheit
      | (if $fahrenheit then 1.8 else 1 end) as $tc
      | (if $fahrenheit then 32 else 0 end) as $to
      | (if $fahrenheit then "°F" else "°C" end) as $tunit
      | (($r.gui_settings.gui_tirepressure_units // "Bar") | ascii_downcase == "psi") as $psi
      | (if $psi then 14.5038 else 1 end) as $pc
      | (if $psi then "psi" else "bar" end) as $punit
      | press($r.vehicle_state.tpms_pressure_fl; $pc) as $fl
      | press($r.vehicle_state.tpms_pressure_fr; $pc) as $fr
      | press($r.vehicle_state.tpms_pressure_rl; $pc) as $rl
      | press($r.vehicle_state.tpms_pressure_rr; $pc) as $rr
      | ([$fl, $fr, $rl, $rr] | map(select(. != null))) as $tpms
      | ([(if (flag($r.vehicle_state.df) or flag($r.vehicle_state.dr)
              or flag($r.vehicle_state.pf) or flag($r.vehicle_state.pr)) then "door" else empty end),
          (if flag($r.vehicle_state.ft) then "frunk" else empty end),
          (if flag($r.vehicle_state.rt) then "trunk" else empty end),
          (if (flag($r.vehicle_state.fd_window) or flag($r.vehicle_state.fp_window)
              or flag($r.vehicle_state.rd_window) or flag($r.vehicle_state.rp_window)) then "window" else empty end)]) as $open
      | {
          name: (if ($r.vehicle_state.vehicle_name // "") == "" then
                   (if $fallback == "" then "Tesla" else $fallback end)
                 else $r.vehicle_state.vehicle_name end),
          vin: $r.vin,
          car_type: ({"model3":"model 3","modely":"model y","models":"model s","modelx":"model x",
                      "cybertruck":"cybertruck","semi":"semi"}[$r.vehicle_config.car_type]
                     // $r.vehicle_config.car_type),
          trim: ($r.vehicle_config.trim_badging // null),
          state: $state,
          fresh: $fresh,
          at: ($at|tonumber),
          shift: ($r.drive_state.shift_state // "P"),
          driving: (($r.drive_state.shift_state // "P") != "P" and ($r.drive_state.shift_state // null) != null),
          speed: (if $r.drive_state.speed == null then null else ($r.drive_state.speed * $k | round) end),
          speed_unit: $speed,
          destination: (($r.drive_state.active_route_destination // "") | if . == "" then null else . end),
          eta: (if $r.drive_state.active_route_minutes_to_arrival == null then null
                else (($at|tonumber) + ($r.drive_state.active_route_minutes_to_arrival * 60) | round) end),
          battery: $r.charge_state.battery_level,
          charge_limit: $r.charge_state.charge_limit_soc,
          charging: ($r.charge_state.charging_state // "Unknown"),
          charger_power: (if $r.charge_state.charging_state == "Charging" then $r.charge_state.charger_power else null end),
          energy_added: (if $r.charge_state.charging_state == "Charging" then
                          (if $r.charge_state.charge_energy_added == null then null
                           else ($r.charge_state.charge_energy_added * 10 | round / 10) end) else null end),
          minutes_to_full: (if $r.charge_state.charging_state == "Charging" then $r.charge_state.minutes_to_full_charge else null end),
          range: (if $range == null then null else ($range * $k * 10 | round / 10) end),
          range_unit: $dist,
          odometer: (if $r.vehicle_state.odometer == null then null else ($r.vehicle_state.odometer * $k | round) end),
          locked: $r.vehicle_state.locked,
          sentry: $r.vehicle_state.sentry_mode,
          climate_on: $r.climate_state.is_climate_on,
          inside_temp: (if $r.climate_state.inside_temp == null then null else ($r.climate_state.inside_temp * $tc + $to | round) end),
          outside_temp: (if $r.climate_state.outside_temp == null then null else ($r.climate_state.outside_temp * $tc + $to | round) end),
          temp_unit: $tunit,
          tyres: ($tpms | if length == 0 then null else {min: (min * 10 | round / 10), max: (max * 10 | round / 10)} end),
          tyre_fl: $fl,
          tyre_fr: $fr,
          tyre_rl: $rl,
          tyre_rr: $rr,
          tyre_unit: $punit,
          software: (($r.vehicle_state.car_version // "") | if . == "" then null else split(" ")[0] end),
          # car_version is the firmware. An FSD package version is not part of
          # this reading; keep a string only when one is actually present.
          performance_package: (
            ($r.vehicle_config.performance_package // null) as $p
            | if $p == null or ($p|type) != "string" then null
              elif ($p|ascii_downcase) == "" or ($p|ascii_downcase) == "base" then null
              else $p end),
          fsd: (
            [ $r.vehicle_state.fsd_version, $r.vehicle_state.autopilot_version,
              $r.vehicle_config.fsd_version, $r.vehicle_config.autopilot_version ]
            | map(if type == "string" then gsub("^\\s+|\\s+$";"") else "" end)
            | map(select(. != ""))
            | .[0] // null),
          open: $open
        }' <<<"$1"
  }

  cache_path_for() {
    printf '%s/cars/%s.json' "$CACHE_DIR" "$1"
  }

  emit() {
    local reading="$1" state="$2" fresh="$3" age="$4" note="$5" vehicles="$6" error="$7" hint="$8"
    local json
    json=$(jq -cn \
      --argjson reading "${reading:-null}" \
      --argjson vehicles "$vehicles" \
      --arg state "$state" \
      --argjson fresh "$fresh" \
      --arg atage "$age" \
      --arg note "$note" \
      --arg error "$error" \
      --arg hint "$hint" \
      '{ready: true, state: $state, fresh: $fresh,
        age: (if $atage == "" then null else ($atage|tonumber) end),
        note: (if $note == "" then null else $note end),
        error: (if $error == "" then null else $error end),
        hint: (if $hint == "" then null else $hint end),
        vehicles: $vehicles} + (if $reading == null then {} else $reading end)
      | .state = $state | .fresh = $fresh') || fail_json "bad reading"
    write_private "$CACHE_DIR/last.json" <<<"$json"
    printf '%s\n' "$json"
  }

  cmd_status() {
    local which="${1:-auto}" nonce="${2:-0}"
    if [ "$which" != "auto" ]; then
      case "$which" in
        *[!A-HJ-NPR-Z0-9]*) fail_json "bad vin" ;;
      esac
      [ "${#which}" -eq 17 ] || fail_json "bad vin"
    fi
    case "$nonce" in
      ''|*[!0-9]*) nonce=0 ;;
    esac

    local fixture="$CONFIG_DIR/fixture.json"
    if [ -s "$fixture" ]; then
      jq -c --arg at "$(now)" '
        ($at|tonumber) as $now
        | . + {ready: true, fixture: true, fresh: true, at: $now, age: 0} | del(.ok)' "$fixture"
      return 0
    fi

    exec 9>"$CACHE_DIR/.lock"
    if ! flock -n 9; then
      if [ -s "$CACHE_DIR/last.json" ]; then
        if [ "$which" = "auto" ] || [ "$(jq -r '.vin // empty' "$CACHE_DIR/last.json")" = "$which" ]; then
          cat "$CACHE_DIR/last.json"
          return 0
        fi
      fi
      fail_json "busy" "another reading is still running"
    fi

    local force=0 prev=""
    if [ -f "$CACHE_DIR/nonce" ]; then
      prev=$(read_first_line "$CACHE_DIR/nonce" 2>/dev/null || true)
      if [ "$nonce" != "0" ] && [ "$nonce" != "$prev" ]; then force=1; fi
    fi
    write_private "$CACHE_DIR/nonce" <<<"$nonce"

    if ! refresh_token >/dev/null && ! { [ -n "$(read_first_line "$CONFIG_DIR/access-token" 2>/dev/null || true)" ]; }; then
      # An empty or absent file is a missing key, including after a phone move
      # or a backup that did not bring ~/.config/omarchy-tesla/refresh-token.
      if [ ! -s "$CONFIG_DIR/refresh-token" ]; then
        fail_json "no key" "This device has no refresh token. A move or a backup does not bring it. Reset clears leftover token files here, then paste a new one."
      fi
      fail_json "not signed in" "paste a refresh token with: tesla-status token"
    fi

    local vehicles vehicle
    vehicles=$(vehicle_list) || fail_json "$(api_error)" "$(api_hint)"
    [ -n "$vehicles" ] || fail_json "no cars on this account"
    vehicle=$(printf '%s' "$vehicles" | jq -c --arg vin "$which" '
      if $vin == "auto" then .[0] else (map(select(.vin == $vin)) | .[0]) end // empty') || vehicle=""
    [ -n "$vehicle" ] || fail_json "car not found" "that vin is not on this account"
    local id vin name names
    id=$(printf '%s' "$vehicle" | jq -r '.id_s // (.id|tostring)')
    case "$id" in
      ''|*[!0-9]*) fail_json "bad vehicle id" ;;
    esac
    vin=$(printf '%s' "$vehicle" | jq -r '.vin')
    name=$(printf '%s' "$vehicle" | jq -r 'if (.display_name // "") == "" then "Tesla" else .display_name end')
    names=$(printf '%s' "$vehicles" | jq -c 'map({vin, name: (if (.display_name // "") == "" then "Tesla" else .display_name end)})')

    local summary state
    summary=$(api_get "vehicles/$id") || {
      local cached=""
      [ -r "$(cache_path_for "$vin")" ] && cached=$(cat "$(cache_path_for "$vin")")
      emit "$cached" "unknown" false "" "" "$names" "$(api_error)" "$(api_hint)"
      return 0
    }
    if [ -n "$(api_error)" ]; then
      local cached=""
      [ -r "$(cache_path_for "$vin")" ] && cached=$(cat "$(cache_path_for "$vin")")
      if [ -n "$cached" ]; then
        emit "$cached" "unknown" false "" "" "$names" "$(api_error)" "$(api_hint)"
      else
        fail_json "$(api_error)" "$(api_hint)"
      fi
      return 0
    fi
    state=$(printf '%s' "$summary" | jq -r '.response.state // empty' 2>/dev/null) || state=""
    [ -n "$state" ] || state=$(printf '%s' "$vehicle" | jq -r '.state // "unknown"')

    local cache cached=""
    cache=$(cache_path_for "$vin")
    [ -r "$cache" ] && cached=$(cat "$cache")
    if [ -z "$cached" ]; then
      cached=$(jq -cn --arg name "$name" --arg vin "$vin" '{name: $name, vin: $vin}')
    fi

    local note=""
    if [ "$state" != "online" ]; then
      [ "$force" -eq 1 ] && note="not awake, so this is the last reading"
      local age=""
      if printf '%s' "$cached" | jq -e '.at' >/dev/null 2>&1; then
        age=$(( $(now) - $(number_or "$(printf '%s' "$cached" | jq -r '.at // empty')" 0) ))
      fi
      emit "$cached" "$state" false "$age" "$note" "$names" "" ""
      return 0
    fi

    if [ "$force" -ne 1 ] && [ -n "$cached" ]; then
      local age driving charging throttle
      age=$(( $(now) - $(number_or "$(printf '%s' "$cached" | jq -r '.at // empty')" 0) ))
      driving=$(printf '%s' "$cached" | jq -r '.driving // false')
      charging=$(printf '%s' "$cached" | jq -r '.charging // "Unknown"')
      throttle=$PARK_THROTTLE
      [ "$charging" = "Charging" ] && throttle=$CHARGE_THROTTLE
      [ "$driving" = "true" ] && throttle=$DRIVE_THROTTLE
      if [ "$age" -lt "$throttle" ]; then
        emit "$cached" "$state" false "$age" "" "$names" "" ""
        return 0
      fi
    fi

    local response raw
    response=$(api_get "vehicles/$id/vehicle_data?endpoints=drive_state%3Bcharge_state%3Bgui_settings%3Bvehicle_state%3Bvehicle_config%3Bclimate_state") || {
      emit "$cached" "$state" false "" "" "$names" "$(api_error)" "$(api_hint)"
      return 0
    }
    raw=$(printf '%s' "$response" | jq -c '.response // empty' 2>/dev/null) || raw=""
    if [ -z "$raw" ] || ! printf '%s' "$raw" | jq -e '.charge_state and .drive_state' >/dev/null 2>&1; then
      # 408, or a car that just fell asleep. Do not retry: retrying is how a
      # tile wakes a car that was on its way to sleep.
      [ "$force" -eq 1 ] && note="not awake, so this is the last reading"
      emit "$cached" "asleep" false "" "$note" "$names" "" ""
      return 0
    fi

    local reading
    reading=$(reading_json "$raw" "$state" true "$name") || fail_json "bad reading"
    write_private "$cache" <<<"$reading"
    emit "$reading" "$state" true 0 "" "$names" "" ""
  }

  # Drops the plugin's token files on this device. Does not wake the car
  # and does not remove a key that is still paired on the car.
  cmd_reset() {
    rm -f "$CONFIG_DIR/refresh-token" "$CONFIG_DIR/access-token" "$CONFIG_DIR/access-token-expires"
    fail_json "no key" "Token files on this device were removed. Paste a new refresh token."
  }

  case "${1:-status}" in
    status) shift; cmd_status "$@" ;;
    token) cmd_token ;;
    reset) cmd_reset ;;
    *) fail_json "unknown command" ;;
  esac
  TESLA_STATUS_END
    chmod 755 "$dest"
  fi
  which=auto
  sel="$HOME/.config/omarchy-tesla/which"
  line=""
  if [ -f "$sel" ]; then
    line=$(head -n 1 "$sel" 2>/dev/null | tr -d '\r\n' || true)
  fi
  case "$line" in
    *[!A-HJ-NPR-Z0-9]*) which=auto ;;
    ?????????????????) which=$line ;;
    *) which=auto ;;
  esac
  nonce=0
  force="$HOME/.cache/omarchy-tesla/force"
  if [ -f "$force" ]; then
    rm -f "$force"
    nonce=$(date +%s)
  fi
  exec "$dest" status "$which" "$nonce"
  """) every 60s json timeout 25s status
  // Presence only. The command prints present or missing, never the token.
  source keyState = cmd('d=$HOME/.config/omarchy-tesla; if [ -n "$XDG_CONFIG_HOME" ]; then d=$XDG_CONFIG_HOME/omarchy-tesla; fi; if [ -s "$d/refresh-token" ]; then echo present; else echo missing; fi') every 60s

  // `status` reports whether the command ran. `ready` is the script's own flag,
  // kept off `ok` so a signed-out payload is not treated as a crashed command.
  let body = src != null && src.ok ? src.out : null
  let car = body != null && body.ready ? body : null
  let fault = src == null ? null : !src.ok ? (src.code == 124 ? "timed out" : "offline") : body == null ? "bad reading" : body.ready ? null : (body.error ?? "unavailable")
  let noKey = keyState == "missing" || fault == "no key"
  let hint = body.hint
  let phase = car == null ? null : car.driving ? "driving" : car.charging == "Charging" ? "charging" : car.charging == "Complete" ? "charged" : car.state == "asleep" ? "asleep" : car.state == "offline" ? "offline" : car.state == "online" ? "parked" : (car.state ?? "…")
  let phaseColor = car == null ? muted : car.driving ? green : car.charging == "Charging" ? cyan : muted
  let low = car.battery != null && car.battery <= 15
  let mid = car.battery != null && car.battery <= 30
  let ringColor = car == null ? muted : car.state != "online" ? muted : car.charging == "Charging" ? green : low ? red : mid ? yellow : accent
  let lockWord = car.locked == null ? "" : car.locked ? "locked" : "unlocked"
  let lockText = car.locked == null ? "…" : lockWord
  let lockTint = car.locked == false ? yellow : foreground
  let rangeText = car.range == null ? null : "${round(car.range)} ${car.range_unit}"
  let chargingNow = car.charging == "Charging"
  let heroMid = car == null ? null : car.driving ? "${round(car.speed ?? 0)} ${car.speed_unit ?? ""}" : chargingNow ? "${round(car.charger_power ?? 0)} kW" : (rangeText ?? "…")
  let heroMidColor = car == null ? foreground : car.driving ? green : chargingNow ? cyan : foreground
  let heroFoot = car == null ? null : car.driving ? (car.destination != null ? "${car.destination}${car.eta == null ? "" : " · ${fmtTime(car.eta, "HH:mm")}"}" : (rangeText ?? "")) : chargingNow ? (rangeText == null ? (car.minutes_to_full == null ? "" : "${round(car.minutes_to_full)}m") : car.minutes_to_full == null ? rangeText : "${rangeText} · ${round(car.minutes_to_full)}m") : ""
  let heroFootColor = muted
  let ageN = car.age
  let ago = car == null || car.at == null ? null : ageN == null || ageN < 45 ? "just now" : ageN < 3600 ? "${floor(ageN / 60)}m ago" : ageN < 86400 ? "${floor(ageN / 3600)}h ago" : "${floor(ageN / 86400)}d ago"
  let carName = car.name == null || car.name == "" ? "Tesla" : car.name
  let statusLine = ago == null ? phase : "${phase} · ${ago}"
  let openCount = count(car.open ?? [])
  let opened = openCount > 0 ? join((car.open ?? []).map(part => part == "boot" ? "trunk" : part), ", ") : null
  let cars = car.vehicles ?? []
  let inside = car.inside_temp == null ? "…" : "${car.inside_temp}°"
  let outside = car.outside_temp == null ? "…" : "${car.outside_temp}°"
  let hot = car.inside_temp != null && (car.temp_unit == "°F" ? car.inside_temp >= 84 : car.inside_temp >= 29)
  let cold = car.inside_temp != null && (car.temp_unit == "°F" ? car.inside_temp <= 45 : car.inside_temp <= 7)
  let insideTint = hot ? yellow : cold ? blue : foreground
  let sentryText = car.sentry == null ? "…" : car.sentry ? "on" : "off"
  let climateText = car.climate_on == null ? "…" : car.climate_on ? "on" : "off"
  let tyreShort = car.tyres == null ? "…" : "${round(car.tyres.min)}–${round(car.tyres.max)}"
  let tyreText = car.tyres == null ? "…" : "${car.tyres.min}–${car.tyres.max} ${car.tyre_unit ?? ""}"
  let tyreSpread = car.tyres == null ? 0 : car.tyres.max - car.tyres.min
  let tyreTint = car.tyres != null && (car.tyre_unit == "psi" ? tyreSpread >= 3 : tyreSpread >= 0.2) ? yellow : foreground
  let roomy = rows != null && rows >= 4
  // The tile's inside, less its 12dp padding. The header takes about 46dp and each
  // fact row about 42dp (the first one with its rule 53dp); the ring gets what is left.
  let innerW = (tileWidth ?? 197) - 24
  let innerH = (tileHeight ?? 211) - 24
  let factRows = innerH >= 221 ? 2 : innerH >= 171 ? 1 : 0
  let factBlock = factRows == 2 ? 95 : factRows == 1 ? 53 : 0
  let ringSize = clamp(min(innerW * 0.45, innerH - 46 - factBlock - 4), 56, roomy ? 120 : 104)
  let pctSize = clamp((innerW - ringSize - 14) / 2.5, 22, 32)
  let sideLabel = chargingNow ? "charge" : car.sentry == true ? "sentry" : "climate"
  let sideValue = chargingNow ? "${round(car.charger_power ?? 0)} kW" : car.sentry == true ? "on" : climateText
  let sideTint = chargingNow ? cyan : car.sentry == true ? yellow : car.climate_on == true ? cyan : foreground
  let extraLabel = car.sentry == true && !chargingNow ? "climate" : "sentry"
  let extraValue = car.sentry == true && !chargingNow ? climateText : sentryText
  let extraTint = car.sentry == true && !chargingNow ? (car.climate_on == true ? cyan : foreground) : car.sentry == true ? yellow : foreground
  let attention = opened != null ? "${opened} open" : null
  let attentionColor = opened != null ? red : yellow
  // VIN position 10 is the model year (letters skip I, O, Q, U, Z). The badge
  // "p74d" is Performance + pack code + dual motor, not the name on the car.
  let yearByCode = { A: 2010, B: 2011, C: 2012, D: 2013, E: 2014, F: 2015, G: 2016, H: 2017, J: 2018, K: 2019, L: 2020, M: 2021, N: 2022, P: 2023, R: 2024, S: 2025, T: 2026, V: 2027, W: 2028, X: 2029, Y: 2030 }
  let yearCode = car == null || car.vin == null ? "" : upper(sub(str(car.vin), 9, 10))
  let modelYear = get(yearByCode, yearCode, null)
  let typeRaw = car.car_type ?? ""
  let typeName = typeRaw == "" ? "" : "${upper(sub(typeRaw, 0, 1))}${sub(typeRaw, 1, len(typeRaw))}"
  let badge = lower(car.trim ?? "")
  let pack = car.performance_package ?? ""
  let grade = pack != "" && lower(pack) != "base" ? pack : contains(badge, "plaid") ? "Plaid" : (startsWith(badge, "p") || badge == "performance") ? "Performance" : (endsWith(badge, "d") && match(badge, "[0-9]") != null) ? "Long Range" : ""
  let translated = join([modelYear == null ? "" : str(modelYear), typeName, grade].filter(part => part != ""), " ")
  let trimCode = car.trim ?? ""
  let identity = car == null ? "" : trimCode == "" ? translated : translated == "" ? trimCode : "${translated} - ${trimCode}"
  let softwareLine = car.software == null && (car.fsd == null || car.fsd == "") ? "" : car.fsd == null || car.fsd == "" ? "software ${car.software}" : car.software == null ? "fsd ${car.fsd}" : "software ${car.software} · fsd ${car.fsd}"
  let tyresKnown = car.tyre_fl != null || car.tyre_fr != null || car.tyre_rl != null || car.tyre_rr != null
  let pct = car.battery == null ? "…" : "${round(car.battery)}%"
  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Fact(label, value, tint = foreground) {
    Column {
      gap: 1
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Text { text: value; style: small; color: tint; maxLines: 1 }
    }
  }

  component Card(label, value, tint = foreground) {
    Column {
      gap: 2
      padding: [12, 10]
      border: 1
      borderColor: alpha(muted, 0.3)
      Text { text: label; style: label; color: muted; maxLines: 1 }
      Text { text: value; style: body; color: tint; maxLines: 2 }
    }
  }

  component ChargeLine(big) {
    Column {
      gap: 0
      Text { text: pct; fontSize: big; color: ringColor; maxLines: 1 }
      if car.charge_limit != null {
        Text { text: "- ${round(car.charge_limit)}%"; style: small; color: muted; maxLines: 1 }
      }
    }
  }

  component Corner(label, value, tint = foreground) {
    Column {
      gap: 1
      padding: [8, 8]
      border: 1
      borderColor: alpha(muted, 0.3)
      align: center
      Text { text: label; style: label; color: muted; align: center; maxLines: 1 }
      Text { text: value == null ? "…" : "${value}"; style: body; color: tint; align: center; maxLines: 1 }
    }
  }

  if car == null {
    Column {
      gap: 6
      fill: true
      justify: center
      Text { text: "tesla"; style: label; color: accent }
      Text { text: noKey ? "no key" : (fault ?? "…"); style: title; maxLines: 2 }
      Text { text: noKey ? "tap to set one up" : (fault == null ? "" : "tap for what to do"); style: small; color: muted; maxLines: 1 }
    }
  } else {
    Column {
      gap: 0
      fill: true
      Text { text: carName; maxLines: 1 }
      Text { text: statusLine; style: label; color: phaseColor; maxLines: 1 }
      Spacer { height: 8 }
      Row {
        gap: 14
        align: center
        Ring {
          value: car.battery ?? 0
          max: 100
          size: ringSize
          thickness: 8
          color: ringColor
          track: alpha(muted, 0.25)
          animate value: spring()
        }
        Column {
          gap: 0
          weight: 1
          ChargeLine { big: pctSize }
          Text { text: heroMid; color: heroMidColor; maxLines: 1 }
          if heroFoot != null && heroFoot != "" {
            Text { text: heroFoot; style: small; color: heroFootColor; maxLines: 1 }
          }
        }
      }
      if factRows > 0 {
        if roomy { Spacer { weight: 1 } } else { Spacer { height: 10 } }
        Rule {}
        Spacer { height: 10 }
        Row {
          gap: 8
          Fact { label: "inside"; value: inside; tint: insideTint; weight: 1 }
          Fact { label: "outside"; value: outside; weight: 1 }
          Fact { label: sideLabel; value: sideValue; tint: sideTint; weight: 1 }
        }
      }
      if factRows > 1 {
        Spacer { height: 10 }
        Row {
          gap: 8
          Fact { label: extraLabel; value: extraValue; tint: extraTint; weight: 1 }
          Fact { label: "lock"; value: lockText; tint: lockTint; weight: 1 }
          Fact { label: "tires"; value: tyreShort; tint: tyreTint; weight: 1 }
        }
      }
      if attention != null {
        Spacer { height: 8 }
        Text { text: attention; style: small; color: attentionColor; maxLines: 2 }
      }
    }
  }

  screen {
    title: car == null ? "tesla" : carName
    Column {
      gap: 14
      scroll: true
      if car == null {
        Text { text: noKey ? "no key" : (fault ?? "…"); style: title; maxLines: 2 }
        if noKey || fault == "not signed in" {
          if noKey {
            Text { text: "This phone has no Tesla key for the plugin. Moving devices, or restoring a backup, does not bring ~/.config/omarchy-tesla/refresh-token, so the key from the old device cannot be checked here."; style: small }
            Text { text: "Reset clears leftover token files on this device only. It does not wake the car, and it does not remove a key from the car. Then sign in again. The new token is the whole Tesla account. Copy the refresh token, not the access token."; style: small }
            Button { text: "reset key"; color: accent; onTap: run('d=$HOME/.config/omarchy-tesla; if [ -n "$XDG_CONFIG_HOME" ]; then d=$XDG_CONFIG_HOME/omarchy-tesla; fi; rm -f "$d/refresh-token" "$d/access-token" "$d/access-token-expires"') }
          } else {
            Text { text: "This tile only reads the car, and it will not wake it. It needs a refresh token from Tesla Auth. That token is the whole Tesla account. You type your own password and MFA. Copy the refresh token, not the access token."; style: small }
            Button { text: "reset key"; onTap: run('d=$HOME/.config/omarchy-tesla; if [ -n "$XDG_CONFIG_HOME" ]; then d=$XDG_CONFIG_HOME/omarchy-tesla; fi; rm -f "$d/refresh-token" "$d/access-token" "$d/access-token-expires"') }
          }
          Text { text: "On a computer"; style: label; color: accent }
          Text { text: "Download Tesla Auth for that computer, run it, and sign in on Tesla's own page. On the last window, copy the refresh token. Then paste it here."; style: small }
          Button { text: "Tesla Auth downloads"; onTap: url("https://github.com/adriankumpf/tesla_auth/releases/latest") }
          Text { text: "On this phone"; style: label; color: accent }
          Text { text: "The same login can run here. An optional helper, separate from this tile, is on the project page. After either way, paste the refresh token below. It is saved as ~/.config/omarchy-tesla/refresh-token and nowhere else."; style: small }
          Button { text: "project page"; onTap: url("https://github.com/IM0001GT/omalauncher-tesla") }
          Button { text: "paste token"; color: accent; onTap: terminal("~/.local/bin/tesla-status token", "tesla") }
          Text { text: "If the car is asleep, the first numbers wait until it is already awake."; style: small; color: muted }
        } else {
          Text { text: hint ?? "could not reach Tesla"; style: small; color: muted }
        }
        Button { text: "check again"; onTap: { run('mkdir -p ~/.cache/omarchy-tesla && touch ~/.cache/omarchy-tesla/force'); refresh() } }
      } else {
        Row {
          gap: 16
          align: center
          Ring {
            value: car.battery ?? 0
            max: 100
            size: 104
            thickness: 8
            color: ringColor
            track: alpha(muted, 0.25)
            animate value: spring()
          }
          Column {
            gap: 0
            weight: 1
            ChargeLine { big: 40 }
            Text { text: heroMid; style: title; color: heroMidColor; maxLines: 1 }
            Text { text: "${phase}${ago == null ? "" : " · ${ago}"}"; style: small; color: phaseColor; maxLines: 1 }
            if heroFoot != null && heroFoot != "" {
              Text { text: heroFoot; style: small; color: heroFootColor; maxLines: 2 }
            }
          }
        }
        if identity != "" {
          Text { text: identity; style: small; color: muted; maxLines: 1 }
        }
        if car.note != null {
          Text { text: car.note; style: small; color: muted; maxLines: 2 }
        }
        if car.error != null {
          Text { text: car.error; style: small; color: yellow; maxLines: 2 }
        }
        if opened != null {
          Text { text: "${opened} open"; style: body; color: red; maxLines: 2 }
        }
        Rule {}
        Grid {
          columns: 2
          gap: 8
          Card { label: "inside"; value: inside; tint: insideTint }
          Card { label: "outside"; value: outside }
          Card { label: "lock"; value: car.locked == null ? "…" : lockWord; tint: car.locked == false ? yellow : foreground }
          Card { label: "sentry"; value: sentryText; tint: car.sentry == true ? yellow : foreground }
          Card { label: "climate"; value: climateText; tint: car.climate_on == true ? cyan : foreground }
          if !tyresKnown && car.tyres != null {
            Card { label: "tires"; value: tyreText; tint: tyreTint }
          }
          if car.odometer != null {
            Card { label: "odometer"; value: "${car.odometer} ${car.range_unit ?? ""}" }
          }
        }
        if tyresKnown {
          Text { text: "tires ${car.tyre_unit ?? ""}"; style: label; color: accent }
          Row {
            gap: 8
            Corner { label: "fl"; value: car.tyre_fl; tint: tyreTint == yellow && car.tyre_fl == car.tyres.min ? yellow : foreground; weight: 1 }
            Corner { label: "fr"; value: car.tyre_fr; tint: tyreTint == yellow && car.tyre_fr == car.tyres.min ? yellow : foreground; weight: 1 }
            Corner { label: "rl"; value: car.tyre_rl; tint: tyreTint == yellow && car.tyre_rl == car.tyres.min ? yellow : foreground; weight: 1 }
            Corner { label: "rr"; value: car.tyre_rr; tint: tyreTint == yellow && car.tyre_rr == car.tyres.min ? yellow : foreground; weight: 1 }
          }
        }
        if chargingNow {
          Text { text: "charging"; style: label; color: accent }
          Row {
            gap: 8
            Card { label: "power"; value: "${round(car.charger_power ?? 0)} kW"; tint: cyan; weight: 1 }
            Card { label: "full in"; value: car.minutes_to_full == null ? "…" : "${round(car.minutes_to_full)}m"; weight: 1 }
            Card { label: "added"; value: car.energy_added == null ? "…" : "${car.energy_added} kWh"; weight: 1 }
          }
        }
        if car.driving && car.destination != null {
          Text { text: "route"; style: label; color: accent }
          Row {
            gap: 8
            Card { label: "going"; value: car.destination; weight: 1 }
            Card { label: "arrives"; value: car.eta == null ? "…" : fmtTime(car.eta, "HH:mm"); weight: 1 }
          }
        }
        if softwareLine != "" {
          Text { text: softwareLine; style: small; color: muted; maxLines: 2 }
        }
        if count(cars) > 1 {
          Text { text: "cars"; style: label; color: accent }
          Flow {
            gap: 6
            for v in cars key v.vin {
              Button {
                text: v.name
                color: v.vin == car.vin ? accent : foreground
                onTap: { vin = v.vin; run('mkdir -p ~/.config/omarchy-tesla ~/.cache/omarchy-tesla && umask 077 && printf \'%s\\n\' ' + sh(match(str(v.vin ?? ""), "^([A-HJ-NPR-Z0-9]{17})$")[0] ?? "") + ' > ~/.config/omarchy-tesla/which && touch ~/.cache/omarchy-tesla/force'); refresh() }
              }
            }
          }
        }
        Row {
          gap: 8
          Button { text: "refresh"; color: accent; onTap: { run('mkdir -p ~/.cache/omarchy-tesla && touch ~/.cache/omarchy-tesla/force'); refresh() } }
          Button { text: "open app"; onTap: androidApp("com.teslamotors.tesla") }
        }
        Text { text: "Refresh reads the car only if it is already awake. A parked car is left alone for 15 minutes, and nothing here can wake it."; style: small; color: muted }
      }
    }
  }
}
