widget "duolingo" {
  meta { owl: 8; description: "A pixel Duo that nags you about your Duolingo streak, getting more worried as the day runs out"; version: "1.0"; license: "MIT"; category: "productivity" }
  requires { pacman: [] }
  size: 4x2
  minSize: 2x1

  // The streak comes from Duolingo's public profile API (no login, just a
  // username), fetched from Android, so the widget works without Linux. The
  // streak counts as extended today when its end date is today's date.
  source now = clock every 1m
  state user = "" persist
  state remind = true persist
  state remindHour = 20 persist
  state remindedDay = "" persist

  source duo = http("https://www.duolingo.com/2017-06-30/users?username=${enc(user)}&fields=users%7Bstreak,streakData,username,totalXp,learningLanguage%7D") every 15m json status timeout 20s

  let me = duo.out.users[0]
  let hasUser = user != ""
  let loading = hasUser && duo == null
  let offline = hasUser && duo != null && !duo.ok
  let unknown = hasUser && duo != null && duo.ok && me == null
  let streak = me.streakData.currentStreak.length ?? me.streak ?? 0
  let endDate = me.streakData.currentStreak.endDate
  let today = fmtTime(now, "yyyy-MM-dd")
  let yesterday = fmtTime(now - 86400, "yyyy-MM-dd")
  let hour = num(fmtTime(now, "H"))
  let todayStart = now - hour * 3600 - num(fmtTime(now, "m")) * 60 - num(fmtTime(now, "s"))
  let ready = me != null
  let done = ready && endDate == today
  let lost = ready && !done && (streak == 0 || endDate != yesterday)

  // Duo's mood, worse as midnight nears: like the real widget.
  let mood = !hasUser || !ready ? "idle"
    : done ? "happy"
    : lost ? "sad"
    : hour >= 21 ? "panic"
    : hour >= 17 ? "worried"
    : "idle"

  let msg = !hasUser ? "hi! tap to tell me your username"
    : loading ? "checking your streak…"
    : offline ? "can't reach duolingo. tap to retry"
    : unknown ? "no user \"${user}\". tap to fix"
    : done ? (streak > 1 ? "streak extended! see you tomorrow" : "streak started! see you tomorrow")
    : lost ? "your streak is gone. start a new one today?"
    : hour < 12 ? "time for your daily lesson!"
    : hour < 17 ? "keep your ${streak} day streak going!"
    : hour < 21 ? "your ${streak} day streak is in danger!"
    : "only ${24 - hour}h left to save your streak!!"
  let short = !hasUser ? "set user" : !ready ? "…" : done ? "done!" : lost ? "restart" : hour >= 21 ? "${24 - hour}h left!" : "practice!"
  let moodColor = mood == "happy" ? green : mood == "sad" ? blue : mood == "panic" ? red : mood == "worried" ? yellow : accent

  // A reminder at the chosen hour, once a day, if the streak isn't extended by then.
  let remindAt = remind && ready && !done && remindedDay != today ? todayStart + remindHour * 3600 : 0
  at remindAt {
    notify("duolingo", lost ? "start a new streak today!" : "your ${streak} day streak needs a lesson")
    remindedDay = today
  }

  // A tap opens Duolingo once there's a streak to show; until then (and on the
  // streak counter, always) it opens the settings screen.

  // Duo, 16x16 art pixels. Eyes are drawn on top, per mood.
  let duoArt = [
    "...g........g...",
    "...gg......gg...",
    "..gggggggggggg..",
    ".gggggggggggggg.",
    ".gWWWWggggWWWWg.",
    "gWWWWWWggWWWWWWg",
    "gWWWWWWggWWWWWWg",
    "gWWWWWWggWWWWWWg",
    "ggWWWWyyyyWWWWgg",
    "gggggggyyggggggg",
    "gGLLLLLLLLLLLLGg",
    "GGLLLLLLLLLLLLGG",
    "GGgLLLLLLLLLLgGG",
    ".GggLLLLLLLLggG.",
    "..gggggggggggg..",
    "....yy....yy...."
  ]
  let flameArt = ["...f...", "..ff...", "..fff.f", ".ffffff", ".ffYfff", "fffYYff", "ffYYYff", "ffYYYff", ".fffff."]
  let flameArt2 = ["....f..", "...ff..", "f..fff.", "ffffff.", "fffYff.", "ffYYfff", "ffYYYff", "ffYYYff", ".fffff."]
  let digits = {
    "0": ["ddd", "d.d", "d.d", "d.d", "ddd"], "1": [".d.", "dd.", ".d.", ".d.", "ddd"],
    "2": ["ddd", "..d", "ddd", "d..", "ddd"], "3": ["ddd", "..d", ".dd", "..d", "ddd"],
    "4": ["d.d", "d.d", "ddd", "..d", "..d"], "5": ["ddd", "d..", "ddd", "..d", "ddd"],
    "6": ["ddd", "d..", "ddd", "d.d", "ddd"], "7": ["ddd", "..d", "..d", ".d.", ".d."],
    "8": ["ddd", "d.d", "ddd", "d.d", "ddd"], "9": ["ddd", "d.d", "ddd", "..d", "ddd"]
  }
  let streakText = str(ready ? streak : 0)
  let duoPal = {
    g: green, G: mix(green, background, 0.4), L: mix(green, foreground, 0.5),
    W: mix(foreground, background, 0.05), y: orange
  }

  component Duo() {
    Canvas {
      let p = max(min(width / 19, height / 18), 1)
      let s = p + 0.5
      let dark = background
      // A one-pixel breath, a hop when happy, a shiver in a panic.
      let bob = mood == "happy" ? round(abs(sin(time * 4))) * -p : (floor(time / 0.8) % 2) * p
      let shake = mood == "panic" ? [0, 1, 0, -1][floor(time * 12) % 4] * p * 0.5 : 0
      let bx = floor((width - 16 * p) / 2) + shake
      let by = floor((height - 16 * p) / 2) + p + bob
      sprite(duoArt, bx, by, p, palette: duoPal)

      let blink = time % 3.7 < 0.15
      if mood == "happy" {
        // ^ ^ eyes, sparkles around.
        for e in [1, 9] {
          rect(bx + (e + 1) * p, by + 7 * p, s, s, fill: dark)
          rect(bx + (e + 2) * p, by + 6 * p, s, s, fill: dark)
          rect(bx + (e + 3) * p, by + 6 * p, s, s, fill: dark)
          rect(bx + (e + 4) * p, by + 7 * p, s, s, fill: dark)
        }
        for k in range(4) {
          let a = abs(sin(time * 2 + k * 1.7))
          let sx = bx + [-2, 17, -1, 16][k] * p
          let sy = by + [1, 3, 11, 12][k] * p
          rect(sx, sy, p, p, fill: alpha(yellow, a))
          rect(sx - p, sy, p, p, fill: alpha(yellow, a * 0.5))
          rect(sx + p, sy, p, p, fill: alpha(yellow, a * 0.5))
          rect(sx, sy - p, p, p, fill: alpha(yellow, a * 0.5))
          rect(sx, sy + p, p, p, fill: alpha(yellow, a * 0.5))
        }
      } else if blink {
        for e in [1, 9] { rect(bx + e * p, by + 6 * p, 6 * p, s, fill: dark) }
      } else if mood == "panic" {
        // Tiny pupils, raised brows, open beak, a drop of sweat.
        for e in [4, 11] { rect(bx + e * p, by + 6 * p, s, s, fill: dark) }
        rect(bx + 7 * p, by + 9 * p, 2 * p, s, fill: dark)
        let t = time % 1.2 / 1.2
        rect(bx + 16 * p, by + (2 + t * 4) * p, p, 2 * p, fill: alpha(cyan, 1 - t))
        rect(bx + 15 * p, by + (3 + t * 4) * p, p, p, fill: alpha(cyan, 1 - t))
      } else if mood == "worried" || mood == "sad" {
        let down = mood == "sad" ? 1 : -1
        for e in [3, 11] { rect(bx + e * p, by + (6 + down * 0.5 + 0.5) * p, 2 * p, 2 * p, fill: dark) }
        // Brows that rise toward the middle.
        rect(bx + 1 * p, by + 4 * p, 2 * p, s, fill: dark)
        rect(bx + 3 * p, by + 3 * p, 3 * p, s, fill: dark)
        rect(bx + 10 * p, by + 3 * p, 3 * p, s, fill: dark)
        rect(bx + 13 * p, by + 4 * p, 2 * p, s, fill: dark)
        if mood == "sad" {
          let t = time % 1.6 / 1.6
          rect(bx + 2 * p, by + (9 + t * 5) * p, p, p, fill: alpha(blue, 1 - t))
          rect(bx + 13 * p, by + (9 + ((t + 0.5) % 1) * 5) * p, p, p, fill: alpha(blue, 1 - (t + 0.5) % 1))
        }
      } else {
        // Looking around.
        let lx = [0, 1, 0, -1][floor(time / 2.3) % 4]
        for e in [3, 11] { rect(bx + (e + lx) * p, by + 6 * p, 2 * p, 2 * p, fill: dark) }
      }
    }
  }

  // The flame and the streak in pixel digits; grey until today's lesson is done.
  component Streak() {
    Canvas {
      onTap: screen()
      let n = len(streakText)
      // Digits are 3x5 art pixels drawn 1.6x larger, so they stand as tall as the flame.
      let dz = 1.6
      let artW = 7 + 2 + (n * 4 - 1) * dz
      let p = max(min(width / (artW + 1), height / 10), 1)
      let x0 = floor((width - artW * p) / 2)
      let y0 = floor((height - 9 * p) / 2)
      let lit = done
      let flick = lit && floor(time * 5) % 2 == 0
      sprite(flick ? flameArt2 : flameArt, x0, y0, p, palette: {f: lit ? orange : alpha(muted, 0.6), Y: lit ? yellow : alpha(muted, 0.35)})
      for i in range(n) {
        sprite(get(digits, sub(streakText, i, i + 1)), x0 + (9 + i * 4 * dz) * p, y0 + 0.5 * p, p * dz, fill: lit ? orange : muted)
      }
    }
  }

  component Bubble(big = false) {
    Box {
      border: 2
      borderColor: moodColor
      background: alpha(moodColor, 0.08)
      radius: 0
      padding: [8, 6]
      align: start
      Text {
        text: msg
        font: mono
        fontSize: big ? 15 : 12
        color: foreground
        maxLines: 4
      }
    }
  }

  let wide = tileWidth != null && tileWidth > tileHeight * 1.25

  component Tile() {
  if rows != null && rows < 2 {
    // One row: Duo, the streak, and a word.
    Row {
      gap: 6
      align: center
      Duo { width: tileHeight; fill: height }
      Streak { weight: 1; fill: height }
      if cols >= 4 { Text { text: short; font: mono; color: moodColor; width: 72; align: end } }
    }
  } else if cols != null && cols < 3 {
    // Small: Duo over the streak.
    Column {
      gap: 2
      Duo { weight: 1; fill: width }
      Streak { height: tileHeight * 0.22; fill: width }
    }
  } else if wide {
    Row {
      gap: 8
      Duo { width: min(tileHeight * 0.9, tileWidth * 0.4); fill: height }
      Column {
        weight: 1
        gap: 6
        Bubble { fill: width; big: rows >= 3 }
        Streak { weight: 1; fill: width }
      }
    }
  } else {
    Column {
      gap: 6
      Bubble { fill: width; big: cols >= 4 }
      Duo { weight: 1; fill: width }
      Streak { height: tileHeight * 0.16; fill: width }
    }
  }
  }

  if ready {
    Box { fill: true; onTap: androidApp("com.duolingo"); Tile { fill: true } }
  } else {
    Box { fill: true; onTap: screen(); Tile { fill: true } }
  }

  screen {
    title: "duolingo"
    Column {
      scroll: true
      gap: 12
      padding: 16
      Duo { height: 200; fill: width }
      Bubble { fill: width; big: true }
      Streak { height: 64; fill: width }
      if ready {
        Grid {
          columns: 2
          gap: 6
          Text { text: "learning"; font: mono; color: muted }
          Text { text: upper(me.learningLanguage ?? "?"); font: mono }
          Text { text: "total xp"; font: mono; color: muted }
          Text { text: "${me.totalXp}"; font: mono }
          Text { text: "streak since"; font: mono; color: muted }
          Text { text: me.streakData.currentStreak.startDate ?? "-"; font: mono }
          Text { text: "last lesson"; font: mono; color: muted }
          Text { text: endDate ?? "-"; font: mono }
        }
      }
      Text { text: "username"; font: mono; color: muted }
      Input { text: user; placeholder: "your duolingo username"; onSubmit: user = trim(value) }
      Text { text: "daily reminder"; font: mono; color: muted }
      Row {
        gap: 6
        align: center
        Button { text: remind ? "on" : "off"; color: remind ? green : muted; onTap: remind = !remind }
        Text { text: "at ${pad(remindHour, 2, "0")}:00"; font: mono; weight: 1; align: center }
        Button { text: "-1h"; color: muted; onTap: remindHour = max(remindHour - 1, 6) }
        Button { text: "+1h"; color: muted; onTap: remindHour = min(remindHour + 1, 23) }
      }
      Row {
        gap: 6
        Button { text: "open duolingo"; color: green; onTap: androidApp("com.duolingo") }
        Button { text: "refresh"; color: muted; onTap: refresh() }
      }
    }
  }
}
