widget "hawkwatch" {
  meta {
    description: "Real-time Seattle Seahawks dashboard: live score, live betting odds, ESPN win probability, schedule, NFC West standings, and breaking news"
    version: "1.3"
    license: "MIT"
    category: "sport"
    owl: 19
  }

  size: 6x4
  minSize: 3x3
  padding: [10, 8]

  source now = clock every 1m
  source modes = android.modes
  source scoreboard = http("https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard") every 1m json timeout 20s
  source schedule = http("https://site.api.espn.com/apis/site/v2/sports/football/nfl/teams/sea/schedule") every 10m json timeout 20s
  source standings = http("https://site.api.espn.com/apis/v2/sports/football/nfl/standings") every 30m json timeout 20s
  source rss = http("https://www.seahawks.com/rss/news") every 10m timeout 20s
  source espnNews = http("https://site.api.espn.com/apis/site/v2/sports/football/nfl/news?team=26") every 10m json timeout 20s
  source foxRss = http("https://api.foxsports.com/v2/content/optimized-rss?partnerKey=MB0Wehpmuj2lUhuRhQaafhBjAJqaPU244mlTDK1i&size=15&tags=seattle-seahawks") every 10m timeout 20s status
  source fgRss = http("https://www.fieldgulls.com/rss/current.xml") every 10m timeout 20s

  state tab = "score"
  state screenTab = "game"
  state newsFilter = "all"
  state lastLiveProb = null

  let seaGreen = #69be28
  let winGreen = #4ade80

  let teamInfo = schedule.team ?? {}
  let recordStr = teamInfo.recordSummary ?? "–"
  let standingStr = teamInfo.standingSummary ?? "Seattle Seahawks"

  // Season schedule & history
  let schedEvents = schedule.events ?? []
  let pastGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'post')
  let lastGame = last(pastGames)
  let futureGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'pre')
  let nextSchedGame = first(futureGames)
  let liveSchedGames = schedEvents.filter(e => e.competitions[0].status.type.state == 'in')

  // Live scoreboard
  let sbEvents = scoreboard.events ?? []
  let sbSeaGame = sbEvents.find(e => contains(e.shortName ?? '', 'SEA'))
  let isSbLive = sbSeaGame != null && sbSeaGame.competitions[0].status.type.state == 'in'
  let isSbFinal = sbSeaGame != null && sbSeaGame.competitions[0].status.type.state == 'post'

  let recentFinalCandidate = isSbFinal ? sbSeaGame : lastGame
  let recentFinalTs = parseTime(recentFinalCandidate.date)
  let showRecentFinal = recentFinalCandidate != null && recentFinalTs != null && now >= recentFinalTs && (now - recentFinalTs) < 86400
  let liveGame = isSbLive ? sbSeaGame : (!isSbFinal ? first(liveSchedGames) : null)
  // Featured game: live game first, then a final game within 24h of kickoff (~20h post-game), then next upcoming matchup, fallback to last game
  let featuredGame = liveGame ?? (showRecentFinal ? recentFinalCandidate : null) ?? nextSchedGame ?? lastGame ?? sbSeaGame
  let prevGame = lastGame

  // NFC & AFC Standings for 32 team records lookup
  let nfcEntries = standings.children[1].standings.entries ?? []
  let afcEntries = standings.children[0].standings.entries ?? []
  let allNflEntries = flatten([afcEntries, nfcEntries])
  let nfcWest = nfcEntries.filter(e => e.team.abbreviation == 'SF' || e.team.abbreviation == 'SEA' || e.team.abbreviation == 'LAR' || e.team.abbreviation == 'ARI')

  // Featured game telemetry
  let fgComp = featuredGame.competitions[0]
  let fgAway = fgComp.competitors.filter(t => t.homeAway == 'away')[0] ?? fgComp.competitors[1]
  let fgHome = fgComp.competitors.filter(t => t.homeAway == 'home')[0] ?? fgComp.competitors[0]
  let fgIsHome = (fgHome.team.abbreviation ?? fgHome.team ?? '') == 'SEA'
  let fgSea = fgIsHome ? fgHome : fgAway
  let fgOpp = fgIsHome ? fgAway : fgHome

  let fgOppAbbr = fgOpp.team.abbreviation ?? fgOpp.team ?? ''
  let fgOppName = fgOpp.team.shortDisplayName ?? fgOpp.team.displayName ?? fgOppAbbr
  let fgAwayAbbr = fgAway.team.abbreviation ?? ''
  let fgHomeAbbr = fgHome.team.abbreviation ?? ''
  let fgAwayName = fgAway.team.shortDisplayName ?? fgAway.team.displayName ?? fgAwayAbbr
  let fgHomeName = fgHome.team.shortDisplayName ?? fgHome.team.displayName ?? fgHomeAbbr

  // Opponent record lookup from standings if not in schedule event
  let oppEntry = allNflEntries.find(e => e.team.abbreviation == fgOppAbbr)
  let oppRecStr = (oppEntry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? fgOpp.records[0].summary ?? ''
  let fgAwayRec = fgIsHome ? oppRecStr : recordStr
  let fgHomeRec = fgIsHome ? recordStr : oppRecStr

  let fgAwayScore = fgAway.score.displayValue ?? fgAway.score ?? '–'
  let fgHomeScore = fgHome.score.displayValue ?? fgHome.score ?? '–'

  let fgState = fgComp.status.type.state ?? 'pre'
  let fgIsLive = fgState == 'in'
  let fgIsFinal = fgState == 'post'
  let fgIsPre = fgState == 'pre'

  let fgWeekNum = featuredGame.week.number ?? scoreboard.week.number
  let fgDate = parseTime(featuredGame.date)
  let fgKickDate = fgDate != null ? fmtTime(fgDate, "EEE, M/d") : 'Upcoming'
  let fgKickTime = fgDate != null ? fmtTime(fgDate, "h:mm a") : (fgComp.status.type.shortDetail ?? 'Scheduled')
  let fgStatusText = fgIsLive ? "${fgComp.status.displayClock} Q${fgComp.status.period}" : (fgIsFinal ? (fgComp.status.type.shortDetail ?? "Final") : "${fgKickDate} • ${fgKickTime}")
  let fgVenue = fgComp.venue.fullName ?? 'Lumen Field'

  let fgBcList = fgComp.broadcasts ?? []
  let fgBcNames = fgBcList[0].names ?? []
  let fgBcMedia = fgBcList[0].media.shortName ?? ''
  let fgBroadcast = fgBcNames[0] ?? fgBcMedia ?? ''

  // Live situation (down, distance, red zone)
  let fgSit = fgComp.situation
  let fgDownDist = fgSit != null ? (fgSit.downDistanceText ?? fgSit.shortDownDistanceText ?? '') : ''
  let fgIsRedZone = fgSit != null && fgSit.isRedZone == true

  // Live & pregame betting odds + ESPN win probability
  let fgId = featuredGame.id != null ? str(featuredGame.id) : ""
  let espnCore = "https://sports.core.api.espn.com/v2/sports/football/leagues/nfl"
  source liveOdds = http(fgIsLive && fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/odds" : null) every 30s json timeout 15s status
  source preOdds = http(!fgIsLive && fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/odds" : null) every 15m json timeout 15s status
  source gamePredictor = http(fgId != "" ? "${espnCore}/events/${enc(fgId)}/competitions/${enc(fgId)}/predictor" : null) every 30m json timeout 15s status

  let gameOdds = fgIsLive ? (liveOdds ?? preOdds) : preOdds
  let oddsItems = (gameOdds != null && gameOdds.ok ? gameOdds.out.items : null) ?? []
  let liveOddsItem = oddsItems.find(o => str(o.provider.id ?? "") == "200" || contains(lower(o.provider.name ?? ""), "live"))
  let preOddsItem = oddsItems.find(o => str(o.provider.id ?? "") == "100") ?? oddsItems.find(o => str(o.provider.id ?? "") != "200")
  let fallbackSbOdds = first(fgComp.odds ?? [])
  let hasLiveOdds = !fgIsFinal && liveOddsItem != null
  let activeOdds = hasLiveOdds ? liveOddsItem : (preOddsItem ?? fallbackSbOdds)
  let hasOdds = activeOdds != null

  let oddsProvider = replace(activeOdds.provider.name ?? "DraftKings", " - Live Odds", "")
  let oddsDetails = activeOdds.details ?? ""
  let oddsOuStr = (fgIsFinal ? activeOdds.close.total.american : null) ?? activeOdds.current.total.american ?? (activeOdds.overUnder != null ? "${activeOdds.overUnder}" : "")
  let oddsOverJuice = (fgIsFinal ? activeOdds.close.over.american : null) ?? activeOdds.current.over.american ?? (activeOdds.overOdds != null ? (activeOdds.overOdds > 0 ? "+${int(activeOdds.overOdds)}" : "${int(activeOdds.overOdds)}") : "")
  let oddsUnderJuice = (fgIsFinal ? activeOdds.close.under.american : null) ?? activeOdds.current.under.american ?? (activeOdds.underOdds != null ? (activeOdds.underOdds > 0 ? "+${int(activeOdds.underOdds)}" : "${int(activeOdds.underOdds)}") : "")

  let oddsAwaySpread = (fgIsFinal ? activeOdds.awayTeamOdds.close.pointSpread.american : null) ?? activeOdds.awayTeamOdds.current.pointSpread.american ?? (activeOdds.spread != null ? (activeOdds.spread == 0 ? "PK" : (-activeOdds.spread > 0 ? "+${-activeOdds.spread}" : "${-activeOdds.spread}")) : "")
  let oddsHomeSpread = (fgIsFinal ? activeOdds.homeTeamOdds.close.pointSpread.american : null) ?? activeOdds.homeTeamOdds.current.pointSpread.american ?? (activeOdds.spread != null ? (activeOdds.spread == 0 ? "PK" : (activeOdds.spread > 0 ? "+${activeOdds.spread}" : "${activeOdds.spread}")) : "")
  let oddsAwaySpreadJuice = (fgIsFinal ? activeOdds.awayTeamOdds.close.spread.american : null) ?? activeOdds.awayTeamOdds.current.spread.american ?? (activeOdds.awayTeamOdds.spreadOdds != null ? (activeOdds.awayTeamOdds.spreadOdds > 0 ? "+${int(activeOdds.awayTeamOdds.spreadOdds)}" : "${int(activeOdds.awayTeamOdds.spreadOdds)}") : "")
  let oddsHomeSpreadJuice = (fgIsFinal ? activeOdds.homeTeamOdds.close.spread.american : null) ?? activeOdds.homeTeamOdds.current.spread.american ?? (activeOdds.homeTeamOdds.spreadOdds != null ? (activeOdds.homeTeamOdds.spreadOdds > 0 ? "+${int(activeOdds.homeTeamOdds.spreadOdds)}" : "${int(activeOdds.homeTeamOdds.spreadOdds)}") : "")

  let oddsAwayMl = (fgIsFinal ? activeOdds.awayTeamOdds.close.moneyLine.american : null) ?? activeOdds.awayTeamOdds.current.moneyLine.american ?? (activeOdds.awayTeamOdds.moneyLine != null ? (activeOdds.awayTeamOdds.moneyLine > 0 ? "+${int(activeOdds.awayTeamOdds.moneyLine)}" : "${int(activeOdds.awayTeamOdds.moneyLine)}") : "")
  let oddsHomeMl = (fgIsFinal ? activeOdds.homeTeamOdds.close.moneyLine.american : null) ?? activeOdds.homeTeamOdds.current.moneyLine.american ?? (activeOdds.homeTeamOdds.moneyLine != null ? (activeOdds.homeTeamOdds.moneyLine > 0 ? "+${int(activeOdds.homeTeamOdds.moneyLine)}" : "${int(activeOdds.homeTeamOdds.moneyLine)}") : "")
  let oddsMlCompact = oddsAwayMl != "" && oddsHomeMl != "" ? "${fgAwayAbbr} ${oddsAwayMl} / ${fgHomeAbbr} ${oddsHomeMl}" : (oddsAwayMl != "" ? "${fgAwayAbbr} ${oddsAwayMl}" : (oddsHomeMl != "" ? "${fgHomeAbbr} ${oddsHomeMl}" : ""))

  let oddsSpreadHeadline = oddsDetails != "" ? oddsDetails : (oddsHomeSpread != "" ? "${fgHomeAbbr} ${oddsHomeSpread}" : "")
  let oddsBadgeText = hasLiveOdds ? "● LIVE" : (fgIsFinal || fgIsLive ? "CLOSE" : "ODDS")

  let preCloseDetails = preOddsItem.details ?? ""
  let preCloseOu = preOddsItem.overUnder != null ? "O/U ${preOddsItem.overUnder}" : ""
  let preCloseRef = preCloseDetails != "" && preCloseOu != "" ? "${preCloseDetails} • ${preCloseOu}" : (preCloseDetails != "" ? preCloseDetails : preCloseOu)

  let openAwaySp = activeOdds.awayTeamOdds.open.pointSpread.american ?? ""
  let openHomeSp = activeOdds.homeTeamOdds.open.pointSpread.american ?? ""
  let openSpreadStr = activeOdds.awayTeamOdds.open.favorite == true && openAwaySp != "" ? "${fgAwayAbbr} ${openAwaySp}" : (activeOdds.homeTeamOdds.open.favorite == true && openHomeSp != "" ? "${fgHomeAbbr} ${openHomeSp}" : (openAwaySp != "" ? "${fgAwayAbbr} ${openAwaySp}" : ""))
  let openTotalStr = activeOdds.open.total.american != null ? "O/U ${activeOdds.open.total.american}" : ""
  let openRef = openSpreadStr != "" && openTotalStr != "" ? "${openSpreadStr} • ${openTotalStr}" : (openSpreadStr != "" ? openSpreadStr : openTotalStr)
  let oddsRefLabel = hasLiveOdds && preCloseRef != "" ? "Pregame Close: ${preCloseRef}" : (!hasLiveOdds && openRef != "" ? "Open: ${openRef}" : "")

  let sbLiveAwayProb = fgSit.lastPlay.probability.awayWinPercentage
  let sbLiveHomeProb = fgSit.lastPlay.probability.homeWinPercentage
  let sbLiveProbPair = fgIsLive && fgId != "" && sbLiveAwayProb != null && sbLiveHomeProb != null ? {id: fgId, away: sbLiveAwayProb, home: sbLiveHomeProb} : null
  on sbLiveProbPair first {
    if value != null { lastLiveProb = value }
  }
  let cachedLiveProb = fgIsLive && lastLiveProb != null && lastLiveProb.id == fgId ? lastLiveProb : null
  let liveAwayProbRaw = sbLiveAwayProb ?? cachedLiveProb.away
  let liveHomeProbRaw = sbLiveHomeProb ?? cachedLiveProb.home
  let hasLiveProb = fgIsLive && liveAwayProbRaw != null && liveHomeProbRaw != null

  let predData = gamePredictor != null && gamePredictor.ok ? gamePredictor.out : null
  let predAwayStat = (predData.awayTeam.statistics ?? []).find(s => s.name == "gameProjection")
  let predHomeStat = (predData.homeTeam.statistics ?? []).find(s => s.name == "gameProjection")
  let predAwayPct = predAwayStat.value != null ? num(predAwayStat.value) : null
  let predHomePct = predHomeStat.value != null ? num(predHomeStat.value) : null

  let awayWinPct = hasLiveProb ? liveAwayProbRaw * 100 : predAwayPct
  let homeWinPct = hasLiveProb ? liveHomeProbRaw * 100 : predHomePct
  let hasWinProb = awayWinPct != null && homeWinPct != null
  let awayWinPctStr = hasWinProb ? fixed(awayWinPct, 1) : ""
  let homeWinPctStr = hasWinProb ? fixed(homeWinPct, 1) : ""

  // Previous game details
  let pgComp = prevGame.competitions[0]
  let pgAway = pgComp.competitors.filter(t => t.homeAway == 'away')[0] ?? pgComp.competitors[1]
  let pgHome = pgComp.competitors.filter(t => t.homeAway == 'home')[0] ?? pgComp.competitors[0]
  let pgIsHome = (pgHome.team.abbreviation ?? pgHome.team ?? '') == 'SEA'
  let pgSea = pgIsHome ? pgHome : pgAway
  let pgOpp = pgIsHome ? pgAway : pgHome
  let pgWon = pgSea.winner == true
  let pgSeaScore = pgSea.score.displayValue ?? pgSea.score ?? '0'
  let pgOppScore = pgOpp.score.displayValue ?? pgOpp.score ?? '0'
  let pgOppAbbr = pgOpp.team.abbreviation ?? pgOpp.team ?? ''
  let pgOppName = pgOpp.team.shortDisplayName ?? pgOpp.team.displayName ?? pgOppAbbr
  let pgResult = "${pgWon ? 'W' : 'L'} ${pgSeaScore}-${pgOppScore} ${pgIsHome ? 'vs' : '@'} ${pgOppAbbr}"

  // Next upcoming game summary (shown when featured is a recent final)
  let ngComp = nextSchedGame.competitions[0]
  let ngComps = ngComp.competitors ?? []
  let ngOpp = ngComps.find(t => (t.team.abbreviation ?? '') != 'SEA')
  let ngOppAbbr = ngOpp.team.abbreviation ?? ngOpp.team ?? ''
  let ngDate = parseTime(nextSchedGame.date)
  let ngWhen = ngDate != null ? fmtTime(ngDate, "EEE, M/d h:mma") : (ngComp.status.type.shortDetail ?? 'TBD')

  let seaItems = take(matchAll(rss ?? "", "<item>[\\s\\S]*?<title>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</title>[\\s\\S]*?<description>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</description>[\\s\\S]*?<link>([^<]+)</link>[\\s\\S]*?<pubDate>([^<]+)</pubDate>")
    .map(m => ({
      id: "sea-${trim(m[2])}",
      src: "Seahawks.com",
      title: trim(m[0]),
      desc: trim(m[1]),
      link: trim(m[2]),
      ts: parseTime(trim(m[3]))
    })), 15)

  let espnItems = (espnNews.articles ?? []).map(a => ({
    id: "espn-${a.id}",
    src: "ESPN",
    title: trim(a.headline ?? ""),
    desc: trim(a.description ?? ""),
    link: a.links.web.href ?? "https://www.espn.com/nfl/team/_/name/sea/seattle-seahawks",
    ts: parseTime(a.published)
  }))

  let foxItems = matchAll((foxRss != null && foxRss.ok ? foxRss.out : "") ?? "", "<item>[\\s\\S]*?<title>\\s*(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?\\s*</title>[\\s\\S]*?<link>\\s*([^<]+?)\\s*</link>[\\s\\S]*?<category>([^<]+)</category>[\\s\\S]*?<description>\\s*(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?\\s*</description>[\\s\\S]*?<pubDate>\\s*([^<]+?)\\s*</pubDate>")
    .filter(m => trim(m[2]) == "nfl")
    .map(m => ({
      id: "fox-${trim(m[1])}",
      src: "Fox Sports",
      title: trim(m[0]),
      desc: trim(m[3]),
      link: trim(m[1]),
      ts: parseTime(trim(m[4]))
    }))

  let fgItems = matchAll(fgRss ?? "", "<entry>[\\s\\S]*?<title[^>]*>\\s*(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?\\s*</title>[\\s\\S]*?<link[^>]*href=\"([^\"]+)\"[\\s\\S]*?<published>([^<]+)</published>[\\s\\S]*?<summary[^>]*>\\s*(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?\\s*</summary>")
    .map(m => ({
      id: "fg-${trim(m[1])}",
      src: "Field Gulls",
      title: trim(m[0]),
      desc: trim(m[3]),
      link: trim(m[1]),
      ts: parseTime(trim(m[2]))
    }))

  let allArticles = flatten([seaItems, espnItems, foxItems, fgItems])
    .filter(a => a.title != "" && a.link != "")
    .map(a => ({
      id: a.id,
      src: a.src,
      title: replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(a.title, "&amp;", "&"), "&#038;", "&"), "&#039;", "'"), "&#8217;", "'"), "&#8216;", "'"), "&#8220;", "\""), "&#8221;", "\""), "&quot;", "\""), "&#8211;", "-"), "&#8212;", "-"),
      desc: replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(trim(join(matchAll(a.desc ?? "", "(?:^|>)([^<]+)").map(x => x[0]), "")), "&amp;", "&"), "&#038;", "&"), "&#039;", "'"), "&#8217;", "'"), "&#8216;", "'"), "&#8220;", "\""), "&#8221;", "\""), "&quot;", "\""), "&#8230;", "..."), "&#8211;", "-"), "&#8212;", "-"), "&mdash;", "-"),
      link: a.link,
      ts: a.ts
    }))
    .sortBy(a => -(a.ts ?? 0))

  let newsSources = [
    {id: "all", label: "All", w: 2},
    {id: "Seahawks.com", label: "Seahawks", w: 4},
    {id: "ESPN", label: "ESPN", w: 3},
    {id: "Fox Sports", label: "Fox", w: 2},
    {id: "Field Gulls", label: "Field Gulls", w: 5}
  ]

  let articles = newsFilter == "all" ? allArticles : allArticles.filter(a => a.src == newsFilter)

  // Responsive tile scaling (adapts to tile size and visible content strips)
  let th = tileHeight ?? 282
  let tw = tileWidth ?? 414
  let hasSubStrip = (fgIsPre && prevGame != null) || (fgIsFinal && nextSchedGame != null)
  let hasLiveSit = fgIsLive && fgDownDist != ""
  let scoreBaseH = 173 + (hasSubStrip ? 23 : 0) + (hasLiveSit ? 19 : 0) + (hasOdds ? 21 : 0) + (hasWinProb ? 21 : 0)
  let scoreSpare = th - scoreBaseH
  let isCompactTile = scoreSpare < 26
  let isNarrowTile = tw < 290
  let isTightWidth = tw < 340
  let extraSpace = max(0, scoreSpare - 46)
  let tileGap = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let cardPadY = int(clamp(4 + extraSpace * 0.06, 4, 8))
  let cardPadX = isNarrowTile ? 6 : 8
  let cardGap = int(clamp(2 + extraSpace * 0.05, 2, 5))
  let tabPadY = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let stripPadY = int(clamp(3 + extraSpace * 0.04, 3, 6))
  let barH = scoreSpare >= 64 ? 4 : 3
  let baseLogoPx = isCompactTile ? 24 : int(clamp(scoreSpare * 0.72, 26, 40))
  let winLogoPx = int(clamp(round(baseLogoPx * 1.12), 28, 40))
  let loseLogoPx = int(max(18, round(baseLogoPx * 0.76)))
  let fgHasWinner = fgIsFinal && (fgAway.winner == true || fgHome.winner == true)
  let awayIsWinner = fgHasWinner && fgAway.winner == true
  let homeIsWinner = fgHasWinner && fgHome.winner == true
  let seaWonFeatured = fgHasWinner && fgSea.winner == true
  let awayLogoPx = fgHasWinner ? (awayIsWinner ? winLogoPx : loseLogoPx) : baseLogoPx
  let homeLogoPx = fgHasWinner ? (homeIsWinner ? winLogoPx : loseLogoPx) : baseLogoPx
  let auraW = fgHasWinner ? min(int(tw * 0.26), int(round(winLogoPx * 2.65))) : int(round(baseLogoPx * 1.32))
  let logoSlotH = fgHasWinner ? int(round(winLogoPx * 1.44)) : baseLogoPx
  let screenAwayLogoPx = fgHasWinner ? (awayIsWinner ? 52 : 42) : 50
  let screenHomeLogoPx = fgHasWinner ? (homeIsWinner ? 52 : 42) : 50
  let screenAuraW = fgHasWinner ? 114 : 70
  let screenLogoSlotH = fgHasWinner ? 86 : 54
  let expandBtnSz = int(clamp(min(tw, th) * 0.095, 22, 32))
  let expandIconSz = int(clamp(round(expandBtnSz * 0.56), 13, 18))
  let scoreFontSize = int(clamp(20 + extraSpace * 0.08, 20, 28))
  let centerColW = int(clamp(tw * 0.30, 86, 130))
  let seaStandingsEntry = nfcWest.find(e => e.team.abbreviation == 'SEA')
  let nfcwTop2 = take(nfcWest, 2)
  let seaInTop2 = any(nfcwTop2, e => e.team.abbreviation == 'SEA')
  let nfcwStripTight = seaInTop2 ? take(nfcWest, 3) : (seaStandingsEntry != null ? flatten([nfcwTop2, [seaStandingsEntry]]) : nfcwTop2)
  let nfcwTop1 = take(nfcWest, 1)
  let seaInTop1 = any(nfcwTop1, e => e.team.abbreviation == 'SEA')
  let nfcwStripNarrow = seaInTop1 ? take(nfcWest, 2) : (seaStandingsEntry != null ? flatten([nfcwTop1, [seaStandingsEntry]]) : nfcwTop1)
  let nfcwQuickStrip = isNarrowTile ? nfcwStripNarrow : (isTightWidth ? nfcwStripTight : nfcWest)

  component NewsFilterBar(padY = 3, chipRadius = 6) {
    Row {
      fill: width
      gap: 4
      for f in newsSources key f.id {
        let active = newsFilter == f.id
        Box {
          weight: f.w
          padding: [padY, 4]
          radius: chipRadius * corners
          background: active ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
          border: 1
          borderColor: active ? seaGreen : border
          onTap: { haptic(); newsFilter = f.id }
          Text {
            text: f.label
            style: label
            bold: active
            color: active ? seaGreen : muted
            align: center
            maxLines: 1
          }
        }
      }
    }
  }

  component TeamLogo(abbr, px = 20, plate = false) {
    let a = lower(abbr ?? '')
    let code = a == 't' ? 'ten' : a
    let w = int(round(px * 1.32))
    if a != '' && a != 'opp' {
      if plate {
        let boxW = px <= 20 ? w : w + 4
        let boxH = px <= 20 ? px : px + 4
        let imgW = px <= 20 ? max(14, w - 2) : w
        let imgH = px <= 20 ? max(12, px - 2) : px
        Box {
          width: boxW
          height: boxH
          radius: boxH / 2
          background: alpha(#ffffff, px <= 20 ? 0.11 : 0.06)
          align: center
          Image {
            src: "https://a.espncdn.com/i/teamlogos/nfl/500/${code}.png"
            width: imgW
            height: imgH
            fit: contain
          }
        }
      } else {
        Image {
          src: "https://a.espncdn.com/i/teamlogos/nfl/500/${code}.png"
          width: w
          height: px
          fit: contain
        }
      }
    }
  }

  component WinnerAura(w, h, col) {
    Canvas {
      width: w
      height: h
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2
      let rRing = r * 0.88
      let pulse = 0.94 + 0.06 * sin(time * 2.2)
      let rGlow = r * 0.98 * pulse
      circle(cx, cy, rGlow, fill: radial(cx, cy, rGlow, [alpha(col, 0.34), alpha(col, 0.13), alpha(col, 0.0)]))
      circle(cx, cy, rRing, fill: alpha(col, 0.11), stroke: alpha(col, 0.50), width: 1.3)
      let stars = [
        {dx: -1.24, dy: -0.58, ph: 0.2, s: 1.02},
        {dx: 1.24, dy: -0.54, ph: 1.6, s: 1.10},
        {dx: -1.34, dy: 0.34, ph: 3.1, s: 0.86},
        {dx: 1.32, dy: 0.38, ph: 4.5, s: 0.94},
        {dx: 1.12, dy: -0.84, ph: 2.3, s: 0.72}
      ]
      for st in stars {
        let twk = 0.32 + 0.68 * pow(0.5 + 0.5 * sin(time * 3.0 + st.ph), 2)
        let drift = sin(time * 1.6 + st.ph) * (r * 0.05)
        let sx = clamp(cx + st.dx * rRing, 5, width - 5)
        let sy = clamp(cy + st.dy * rRing + drift, 5, height - 5)
        let sr = max(2.2, r * 0.15 * st.s * (0.65 + 0.55 * twk))
        path([
          [sx, sy - sr], [sx + sr * 0.28, sy - sr * 0.28],
          [sx + sr, sy], [sx + sr * 0.28, sy + sr * 0.28],
          [sx, sy + sr], [sx - sr * 0.28, sy + sr * 0.28],
          [sx - sr, sy], [sx - sr * 0.28, sy - sr * 0.28]
        ], closed: true, fill: alpha(mix(col, foreground, 0.35), 0.40 + 0.60 * twk))
      }
    }
  }

  component BooAura(w, h) {
    Canvas {
      width: w
      height: h
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2
      let rRing = r * 0.88
      let pulse = 0.94 + 0.06 * sin(time * 2.0)
      let rGlow = r * 0.98 * pulse
      circle(cx, cy, rGlow, fill: radial(cx, cy, rGlow, [alpha(red, 0.28), alpha(red, 0.10), alpha(red, 0.0)]))
      circle(cx, cy, rRing, fill: alpha(red, 0.08), stroke: alpha(red, 0.44), width: 1.2)
      let b1 = sin(time * 2.6) * (r * 0.08)
      let b2 = sin(time * 2.6 + 2.2) * (r * 0.08)
      let a1 = 0.55 + 0.45 * (0.5 + 0.5 * sin(time * 3.0))
      let a2 = 0.55 + 0.45 * (0.5 + 0.5 * sin(time * 3.0 + 2.4))
      let tx1 = max(14, cx - rRing * 1.28)
      let ty1 = max(7, cy - rRing * 0.62) + b1
      let tx2 = min(width - 17, cx + rRing * 1.28)
      let ty2 = min(height - 7, cy + rRing * 0.58) + b2
      rotate(-14, tx1, ty1) {
        text("BOO!", tx1, ty1, size: max(7, r * 0.26), color: alpha(red, a1), align: center, bold: true)
      }
      rotate(11, tx2, ty2) {
        text("BOOOO", tx2, ty2, size: max(6.5, r * 0.23), color: alpha(red, a2), align: center, bold: true)
      }
      let d1 = (time * 0.55) % 1
      let d2 = (time * 0.55 + 0.5) % 1
      let vx1 = min(width - 9, cx + rRing * 1.22)
      let vy1 = max(6, cy - rRing * 0.65) + d1 * (r * 0.32)
      let vx2 = max(9, cx - rRing * 1.22)
      let vy2 = max(10, cy + rRing * 0.22) + d2 * (r * 0.32)
      let cr = max(2.2, r * 0.11)
      path([[vx1 - cr, vy1 - cr * 0.5], [vx1, vy1 + cr * 0.5], [vx1 + cr, vy1 - cr * 0.5]], stroke: alpha(red, (1 - d1) * 0.75), width: 1.4, cap: round)
      path([[vx2 - cr, vy2 - cr * 0.5], [vx2, vy2 + cr * 0.5], [vx2 + cr, vy2 - cr * 0.5]], stroke: alpha(red, (1 - d2) * 0.75), width: 1.4, cap: round)
    }
  }

  component ExpandButton(sz, iconSz, col) {
    Box {
      size: sz
      align: center
      radius: 6 * corners
      background: alpha(surface, 0.55)
      border: 1
      borderColor: alpha(border, 0.55)
      onTap: { haptic(); screen() }
      Canvas {
        width: iconSz
        height: iconSz
        let m = iconSz * 0.14
        let h = iconSz * 0.38
        let sw = max(1.6, iconSz * 0.10)
        line(m, iconSz - m, iconSz - m, m, stroke: col, width: sw, cap: round)
        line(iconSz - m - h, m, iconSz - m, m, stroke: col, width: sw, cap: round)
        line(iconSz - m, m, iconSz - m, m + h, stroke: col, width: sw, cap: round)
        line(m, iconSz - m, m + h, iconSz - m, stroke: col, width: sw, cap: round)
        line(m, iconSz - m, m, iconSz - m - h, stroke: col, width: sw, cap: round)
      }
    }
  }

  component ScoreFeaturedCard(expand = false) {
    Column {
      fill: width
      weight: expand ? 1 : 0
      padding: [cardPadX, cardPadY]
      radius: 8 * corners
      background: alpha(surface, 0.6)
      border: 1
      borderColor: fgIsLive ? seaGreen : border
      gap: cardGap

      Row {
        fill: width
        align: center
        gap: 6
        Text {
          text: fgIsLive ? "LIVE GAME" : (fgIsFinal ? (fgVenue != "" ? "FINAL • W${fgWeekNum ?? ''} • ${fgVenue}" : "FINAL • WEEK ${fgWeekNum ?? ''}") : (fgVenue != "" ? "W${fgWeekNum ?? ''} • ${fgVenue}" : "UPCOMING • WEEK ${fgWeekNum ?? ''}"))
          style: small
          bold: true
          color: fgIsLive ? seaGreen : (fgIsFinal ? (fgSea.winner == true ? seaGreen : muted) : seaGreen)
          weight: 1
          maxLines: 1
        }
        if fgIsFinal {
          Text {
            text: fgSea.winner == true ? "WIN" : (fgOpp.winner == true ? "LOSS" : "TIE")
            style: label
            bold: true
            color: fgSea.winner == true ? winGreen : (fgOpp.winner == true ? red : muted)
            padding: [4, 1]
            radius: 3 * corners
            background: fgSea.winner == true ? alpha(winGreen, 0.2) : (fgOpp.winner == true ? alpha(red, 0.2) : alpha(muted, 0.2))
          }
        } else if fgBroadcast != "" {
          Text {
            text: fgBroadcast
            style: label
            bold: true
            color: seaGreen
            padding: [4, 1]
            radius: 3 * corners
            background: alpha(seaGreen, 0.18)
          }
        }
      }

      // Teams and scores/time
      Row {
        fill: width
        weight: expand ? 1 : 0
        align: center
        gap: 4

        // Away Team
        Column {
          weight: 1
          align: center
          gap: 1
          Box {
            width: awayIsWinner ? auraW : int(round(awayLogoPx * 1.32)) + 4
            height: logoSlotH
            align: center
            if awayIsWinner {
              if seaWonFeatured {
                WinnerAura { w: auraW; h: logoSlotH; col: seaGreen }
              } else {
                BooAura { w: auraW; h: logoSlotH }
              }
            }
            Box {
              opacity: fgHasWinner && !awayIsWinner ? 0.82 : 1
              TeamLogo { abbr: fgAway.team.abbreviation; px: awayLogoPx; plate: !awayIsWinner }
            }
          }
          Text {
            text: fgAway.team.abbreviation
            bold: true
            style: small
            color: fgIsFinal && !fgAway.winner ? muted : foreground
            align: center
          }
          if fgAwayRec != "" {
            Text { text: fgAwayRec; style: label; color: muted; align: center }
          }
        }

        // Center Score or Kickoff
        Column {
          align: center
          gap: 1
          width: centerColW
          if fgIsPre {
            Text { text: "AT"; style: label; color: muted; bold: true; align: center }
            Text { text: fgKickDate; style: small; color: foreground; bold: true; align: center }
            Text { text: fgKickTime; style: small; color: seaGreen; align: center; bold: true }
          } else {
            Row {
              gap: 6
              align: center
              Text {
                text: fgAwayScore
                fontSize: scoreFontSize
                bold: true
                color: fgIsFinal && !fgAway.winner ? muted : foreground
              }
              Text { text: "-"; fontSize: scoreFontSize; color: muted }
              Text {
                text: fgHomeScore
                fontSize: scoreFontSize
                bold: true
                color: fgIsFinal && !fgHome.winner ? muted : foreground
              }
            }
            Text {
              text: fgStatusText
              style: small
              color: fgIsLive ? seaGreen : muted
              bold: fgIsLive
              align: center
              maxLines: 1
            }
          }
        }

        // Home Team
        Column {
          weight: 1
          align: center
          gap: 1
          Box {
            width: homeIsWinner ? auraW : int(round(homeLogoPx * 1.32)) + 4
            height: logoSlotH
            align: center
            if homeIsWinner {
              if seaWonFeatured {
                WinnerAura { w: auraW; h: logoSlotH; col: seaGreen }
              } else {
                BooAura { w: auraW; h: logoSlotH }
              }
            }
            Box {
              opacity: fgHasWinner && !homeIsWinner ? 0.82 : 1
              TeamLogo { abbr: fgHome.team.abbreviation; px: homeLogoPx; plate: !homeIsWinner }
            }
          }
          Text {
            text: fgHome.team.abbreviation
            bold: true
            style: small
            color: fgIsFinal && !fgHome.winner ? muted : foreground
            align: center
          }
          if fgHomeRec != "" {
            Text { text: fgHomeRec; style: label; color: muted; align: center }
          }
        }
      }

      // Live down & distance
      if fgIsLive && fgDownDist != "" {
        Row {
          align: center
          gap: 6
          Text { text: "🏈 ${fgDownDist}"; style: small; bold: true; color: seaGreen }
          if fgIsRedZone {
            Text {
              text: "RED ZONE"
              style: label
              bold: true
              color: red
              padding: [4, 1]
              radius: 3
              background: alpha(red, 0.2)
            }
          }
        }
      }

      // Compact Betting Odds Strip
      if hasOdds {
        Box {
          fill: width
          padding: [6, 2]
          radius: 5 * corners
          background: hasLiveOdds ? alpha(red, 0.12) : alpha(background, 0.35)
          border: hasLiveOdds ? 1 : 0
          borderColor: alpha(red, 0.45)

          Row {
            fill: width
            align: center
            gap: 6
            Text {
              text: oddsBadgeText
              style: label
              bold: true
              color: hasLiveOdds ? red : (fgIsPre || fgIsFinal ? seaGreen : muted)
            }
            if oddsSpreadHeadline != "" {
              Text { text: oddsSpreadHeadline; style: label; bold: true; color: foreground; maxLines: 1 }
            }
            if oddsOuStr != "" {
              Text { text: "O/U ${oddsOuStr}"; style: label; color: muted; maxLines: 1 }
            }
            Spacer { weight: 1 }
            if !isNarrowTile && oddsMlCompact != "" {
              Text { text: oddsMlCompact; style: label; color: foreground; align: end; maxLines: 1 }
            }
          }
        }
      }

      // Compact ESPN Percentage Odds Bar
      if hasWinProb {
        Column {
          fill: width
          gap: 1
          Row {
            fill: width
            align: center
            Text {
              text: "${fgAwayAbbr} ${awayWinPctStr}%"
              style: label
              bold: !fgIsHome || awayWinPct >= homeWinPct
              color: !fgIsHome ? seaGreen : (awayWinPct >= homeWinPct ? foreground : muted)
            }
            Spacer { weight: 1 }
            Text {
              text: isNarrowTile ? (hasLiveProb ? "● LIVE" : (fgIsFinal ? "PREGAME" : "WIN PROB")) : (hasLiveProb ? "● ESPN LIVE" : (fgIsFinal ? "PREGAME WIN PROB" : "ESPN WIN PROB"))
              style: label
              bold: hasLiveProb
              color: hasLiveProb ? red : muted
            }
            Spacer { weight: 1 }
            Text {
              text: "${fgHomeAbbr} ${homeWinPctStr}%"
              style: label
              bold: fgIsHome || homeWinPct >= awayWinPct
              color: fgIsHome ? seaGreen : (homeWinPct >= awayWinPct ? foreground : muted)
            }
          }
          Row {
            fill: width
            height: barH
            radius: 2 * corners
            clip: true
            gap: 2
            Box {
              weight: clamp(awayWinPct, 2, 98)
              height: barH
              background: !fgIsHome ? seaGreen : alpha(foreground, 0.32)
            }
            Box {
              weight: clamp(homeWinPct, 2, 98)
              height: barH
              background: fgIsHome ? seaGreen : alpha(foreground, 0.32)
            }
          }
        }
      }
    }
  }

  component ScoreBottomStrips() {
    Column {
      fill: width
      gap: tileGap

      // Previous Game Summary (when featured is upcoming)
      if fgIsPre && prevGame != null {
        Box {
          fill: width
          padding: [6, stripPadY]
          radius: 6 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Row {
            fill: width
            align: center
            gap: 6
            Text { text: "Last:"; style: small; color: muted }
            Text {
              text: pgWon ? "W" : "L"
              style: small
              bold: true
              color: pgWon ? winGreen : red
              padding: [4, 1]
              radius: 3 * corners
              background: pgWon ? alpha(winGreen, 0.2) : alpha(red, 0.2)
            }
            TeamLogo { abbr: pgOppAbbr; px: 16; plate: true }
            Text {
              text: "${pgSeaScore}-${pgOppScore} ${pgIsHome ? 'vs' : '@'} ${pgOppAbbr}"
              style: small
              bold: true
            }
            Spacer { weight: 1 }
            Text { text: "W${prevGame.week.number} Final"; style: label; color: muted; maxLines: 1 }
          }
        }
      }

      // Next Upcoming Game Strip (when featured is a recent final)
      if fgIsFinal && nextSchedGame != null {
        Box {
          fill: width
          padding: [6, stripPadY]
          radius: 6 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Row {
            fill: width
            align: center
            gap: 6
            Text { text: "Next:"; style: small; color: muted }
            TeamLogo { abbr: ngOppAbbr; px: 16; plate: true }
            Text {
              text: "${ngOpp.homeAway == 'home' ? '@' : 'vs'} ${ngOppAbbr}"
              style: small
              bold: true
            }
            Spacer { weight: 1 }
            Text { text: ngWhen; style: label; color: seaGreen; maxLines: 1 }
          }
        }
      }

      // NFC West Quick Strip
      Box {
        fill: width
        padding: [6, stripPadY]
        radius: 6 * corners
        background: alpha(surface, 0.6)
        border: 1
        borderColor: border
        onTap: { haptic(); tab = "standings" }

        Row {
          fill: width
          align: center
          gap: 4

          Text { text: "NFCW"; style: label; bold: true; color: muted; width: 30 }

          for entry, i in nfcwQuickStrip key entry.team.id {
            let isSea = entry.team.abbreviation == 'SEA'
            let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'

            if i > 0 {
              Box {
                width: 1
                height: 9
                background: alpha(border, 0.55)
              }
            }
            Row {
              align: center
              gap: 3
              TeamLogo { abbr: entry.team.abbreviation; px: 14; plate: true }
              Text {
                text: "${entry.team.abbreviation} ${rec}"
                style: label
                bold: isSea
                color: isSea ? seaGreen : muted
              }
              if isSea {
                Box {
                  width: 4
                  height: 4
                  radius: 2 * corners
                  background: seaGreen
                }
              }
            }
          }
          Spacer { weight: 1 }
          Text { text: "›"; style: small; color: muted }
        }
      }
    }
  }

  fps: fgHasWinner ? (modes.saver ? 5 : 15) : 1
  onTap: { haptic(); screen() }

  Column {
    gap: tileGap
    fill: true

    // Header
    Row {
      gap: 6
      fill: width
      align: center
      Image {
        src: "https://a.espncdn.com/i/teamlogos/nfl/500/sea.png"
        width: 34
        height: 26
        fit: contain
      }
      Column {
        gap: 0
        Row {
          gap: 4
          align: center
          Text { text: "HawkWatch"; style: title; bold: true }
          Text {
            text: recordStr
            style: small
            bold: true
            color: seaGreen
            padding: [4, 1]
            radius: 4 * corners
            background: alpha(seaGreen, 0.2)
          }
        }
        Text { text: standingStr; style: label; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      Row {
        gap: 6
        align: center
        if fgIsLive {
          Text {
            text: "● LIVE"
            style: small
            bold: true
            color: red
            padding: [5, 2]
            radius: 4 * corners
            background: alpha(red, 0.2)
          }
        }
        ExpandButton { sz: expandBtnSz; iconSz: expandIconSz; col: mix(foreground, muted, 0.35) }
      }
    }

    // Tabs
    Row {
      fill: width
      gap: 4
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "score" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "score" ? seaGreen : border
        onTap: { haptic(); tab = "score" }
        Text {
          text: "Score"
          style: small
          bold: tab == "score"
          color: tab == "score" ? seaGreen : muted
          align: center
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "standings" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "standings" ? seaGreen : border
        onTap: { haptic(); tab = "standings" }
        Text {
          text: "Division"
          style: small
          bold: tab == "standings"
          color: tab == "standings" ? seaGreen : muted
          align: center
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "news" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "news" ? seaGreen : border
        onTap: { haptic(); tab = "news" }
        Text {
          text: "News"
          style: small
          bold: tab == "news"
          color: tab == "news" ? seaGreen : muted
          align: center
        }
      }
      Box {
        weight: 1
        padding: [0, tabPadY]
        radius: 6 * corners
        background: tab == "schedule" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
        border: 1
        borderColor: tab == "schedule" ? seaGreen : border
        onTap: { haptic(); tab = "schedule" }
        Text {
          text: "Schedule"
          style: small
          bold: tab == "schedule"
          color: tab == "schedule" ? seaGreen : muted
          align: center
        }
      }
    }

    // Tab content
    if tab == "score" && !isCompactTile {
      Column {
        weight: 1
        fill: width
        gap: tileGap
        ScoreFeaturedCard { expand: true }
        ScoreBottomStrips {}
      }
    } else {
      Column {
        weight: 1
        fill: width
        scroll: true
        onPull: refresh()
        gap: tileGap

        if tab == "score" {
          ScoreFeaturedCard { expand: false }
          ScoreBottomStrips {}
        }

      if tab == "standings" {
        Box {
          fill: width
          padding: 8
          radius: 8 * corners
          background: alpha(surface, 0.6)
          border: 1
          borderColor: border

          Column {
            gap: 4
            fill: width

            Row {
              fill: width
              align: center
              gap: 8
              padding: [4, 2]
              Text { text: "#"; style: label; color: muted; width: 14 }
              Text { text: "TEAM"; style: label; color: muted; weight: 1 }
              Text { text: "REC"; style: label; color: muted; width: 44; align: end }
              Text { text: "DIV"; style: label; color: muted; width: 36; align: end }
              Text { text: "STRK"; style: label; color: muted; width: 36; align: end }
              Text { text: "SEED"; style: label; color: muted; width: 42; align: end }
            }

            for entry, i in nfcWest key entry.team.id {
              let isSea = entry.team.abbreviation == 'SEA'
              let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'
              let divRec = (entry.stats.find(s => s.name == 'divisionRecord') ?? {}).displayValue ?? '–'
              let strk = (entry.stats.find(s => s.name == 'streak') ?? {}).displayValue ?? '–'
              let seed = (entry.stats.find(s => s.name == 'playoffSeed') ?? {}).displayValue ?? '–'

              Row {
                fill: width
                align: center
                gap: 8
                padding: [4, 3]
                radius: 4 * corners
                background: isSea ? alpha(seaGreen, 0.15) : rgb(0, 0, 0, 0)

                Text { text: "${i + 1}"; style: small; color: muted; width: 14 }
                TeamLogo { abbr: entry.team.abbreviation; px: 18; plate: true }
                Text {
                  text: entry.team.shortDisplayName ?? entry.team.displayName
                  style: small
                  bold: isSea
                  color: isSea ? seaGreen : foreground
                  weight: 1
                  maxLines: 1
                }
                Text {
                  text: rec
                  style: small
                  bold: true
                  color: isSea ? seaGreen : foreground
                  width: 44
                  align: end
                }
                Text {
                  text: divRec
                  style: small
                  color: muted
                  width: 36
                  align: end
                }
                Text {
                  text: strk
                  style: small
                  color: startsWith(strk, 'W') ? winGreen : (startsWith(strk, 'L') ? red : muted)
                  width: 36
                  align: end
                }
                Text {
                  text: "#${seed}"
                  style: label
                  color: muted
                  width: 42
                  align: end
                }
              }
            }
          }
        }
      }

      if tab == "news" {
        Column {
          gap: 4
          fill: width

          NewsFilterBar { padY: 3; chipRadius: 6 }

          if len(articles) == 0 {
            Text { text: "Loading Seahawks news…"; style: small; color: muted; align: center }
          } else {
            for item in articles.take(6) key item.id {
              Box {
                fill: width
                padding: [6, 4]
                radius: 6 * corners
                onTap: { haptic(); url(item.link) }

                Row {
                  fill: width
                  gap: 6
                  align: top
                  Box {
                    width: 4
                    height: 14
                    radius: 2
                    background: seaGreen
                    offset: [0, 3]
                  }
                  Column {
                    gap: 2
                    weight: 1
                    Text {
                      text: item.title
                      style: small
                      bold: true
                      maxLines: 2
                    }
                    Row {
                      gap: 6
                      if item.ts != null && item.ts > 0 {
                        Text { text: fmtAgo(item.ts, now); style: label; color: seaGreen }
                      }
                      Text { text: item.src; style: label; color: muted }
                    }
                  }
                }
              }
            }
          }
        }
      }

      if tab == "schedule" {
        for g in schedEvents.take(12) key g.id {
          let gc = g.competitions[0]
          let gcomps = gc.competitors ?? []
          let gSea = gcomps.find(t => (t.team.abbreviation ?? '') == 'SEA')
          let gOpp = gcomps.find(t => (t.team.abbreviation ?? '') != 'SEA')
          let gOppAbbr = gOpp.team.abbreviation ?? gOpp.team ?? ''
          let gState = gc.status.type.state ?? 'pre'
          let gWon = gSea.winner == true
          let isDone = gState == 'post'
          let isCurrent = g.id == featuredGame.id
          let scSea = gSea.score.displayValue ?? gSea.score ?? '–'
          let scOpp = gOpp.score.displayValue ?? gOpp.score ?? '–'
          let dt = parseTime(g.date)

          Box {
            fill: width
            padding: [4, 2]
            radius: 4 * corners
            background: isCurrent ? alpha(seaGreen, 0.12) : rgb(0, 0, 0, 0)
            border: isCurrent ? 1 : 0
            borderColor: seaGreen

            Row {
              fill: width
              align: center
              gap: 6

              Text { text: "W${g.week.number}"; style: small; color: isCurrent ? seaGreen : muted; width: 28; bold: isCurrent }
              TeamLogo { abbr: gOppAbbr; px: 18 }
              Text {
                text: "${gOpp.homeAway == 'home' ? '@' : 'vs'} ${gOppAbbr}"
                style: small
                bold: isCurrent || gState == 'in'
                color: gState == 'in' ? seaGreen : foreground
              }
              Spacer { weight: 1 }
              if isDone {
                Text {
                  text: "${gWon ? 'W' : 'L'} ${scSea}-${scOpp}"
                  style: small
                  bold: true
                  color: gWon ? winGreen : red
                  align: end
                }
              } else if gState == 'in' {
                Text { text: "LIVE"; style: small; bold: true; color: seaGreen; align: end }
              } else {
                Text {
                  text: dt != null ? fmtTime(dt, "M/d h:mma") : (gc.status.type.shortDetail ?? 'TBD')
                  style: small
                  color: isCurrent ? accent : muted
                  bold: isCurrent
                  align: end
                }
              }
            }
          }
        }
      }
    }
    }
  }

  // Full-screen Game Center
  screen {
    title: "HawkWatch"

    Column {
      scroll: true
      onPull: refresh()
      gap: 12
      padding: 12

      // Top Hero Banner
      Box {
        fill: width
        padding: [12, 9]
        radius: 10 * corners
        background: alpha(surface, 0.6)
        border: 1
        borderColor: seaGreen

        Row {
          fill: width
          align: center
          gap: 10
          Image {
            src: "https://a.espncdn.com/i/teamlogos/nfl/500/sea.png"
            width: 48
            height: 36
            fit: contain
          }
          Column {
            gap: 1
            weight: 1
            Text { text: "Seattle Seahawks"; style: body; bold: true }
            Text { text: standingStr; style: label; color: muted }
          }
          Column {
            align: end
            width: 72
            gap: 1
            Text { text: recordStr; style: title; bold: true; color: seaGreen; align: end }
            Text { text: "RECORD"; style: label; color: muted; align: end }
          }
        }
      }

      // Screen navigation tabs
      Row {
        fill: width
        gap: 6
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "game" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "game" ? seaGreen : border
          onTap: { haptic(); screenTab = "game" }
          Text {
            text: "Game Center"
            style: small
            bold: screenTab == "game"
            color: screenTab == "game" ? seaGreen : muted
            align: center
          }
        }
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "news" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "news" ? seaGreen : border
          onTap: { haptic(); screenTab = "news" }
          Text {
            text: "Breaking News"
            style: small
            bold: screenTab == "news"
            color: screenTab == "news" ? seaGreen : muted
            align: center
          }
        }
        Box {
          weight: 1
          padding: [0, 8]
          radius: 8 * corners
          background: screenTab == "schedule" ? alpha(seaGreen, 0.25) : alpha(surface, 0.4)
          border: 1
          borderColor: screenTab == "schedule" ? seaGreen : border
          onTap: { haptic(); screenTab = "schedule" }
          Text {
            text: "Full Schedule"
            style: small
            bold: screenTab == "schedule"
            color: screenTab == "schedule" ? seaGreen : muted
            align: center
          }
        }
      }

      // Screen Tab 1: Game Center
      if screenTab == "game" {
        Column {
          gap: 10
          fill: width

          Text { text: fgIsLive ? "LIVE GAME" : (fgIsFinal ? "FINAL RESULT" : "NEXT MATCHUP"); style: label; color: muted }

          Box {
            fill: width
            padding: 14
            radius: 10 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: fgIsLive ? seaGreen : border

            Column {
              gap: 12
              fill: width

              Row {
                fill: width
                align: center
                Text {
                  text: fgIsLive ? "● LIVE IN PROGRESS" : (fgIsFinal ? "FINAL SCORE" : "WEEK ${featuredGame.week.number ?? ''} MATCHUP")
                  style: small
                  bold: true
                  color: seaGreen
                }
                Spacer { weight: 1 }
                if fgIsFinal {
                  Text {
                    text: fgSea.winner == true ? "WIN" : (fgOpp.winner == true ? "LOSS" : "TIE")
                    style: small
                    bold: true
                    color: fgSea.winner == true ? winGreen : (fgOpp.winner == true ? red : muted)
                    padding: [6, 2]
                    radius: 4 * corners
                    background: fgSea.winner == true ? alpha(winGreen, 0.2) : (fgOpp.winner == true ? alpha(red, 0.2) : alpha(muted, 0.2))
                  }
                } else if fgBroadcast != "" {
                  Text {
                    text: "TV: ${fgBroadcast}"
                    style: small
                    color: seaGreen
                    padding: [6, 2]
                    radius: 4 * corners
                    background: alpha(seaGreen, 0.16)
                  }
                }
              }

              // Large Matchup View
              Row {
                fill: width
                align: center

                // Away Team
                Column {
                  weight: 1
                  align: center
                  gap: 4
                  Box {
                    width: awayIsWinner ? screenAuraW : int(round(screenAwayLogoPx * 1.32)) + 4
                    height: screenLogoSlotH
                    align: center
                    if awayIsWinner {
                      if seaWonFeatured {
                        WinnerAura { w: screenAuraW; h: screenLogoSlotH; col: seaGreen }
                      } else {
                        BooAura { w: screenAuraW; h: screenLogoSlotH }
                      }
                    }
                    Box {
                      opacity: fgHasWinner && !awayIsWinner ? 0.82 : 1
                      TeamLogo { abbr: fgAway.team.abbreviation; px: screenAwayLogoPx; plate: !awayIsWinner }
                    }
                  }
                  Text {
                    text: fgAway.team.shortDisplayName ?? fgAway.team.displayName ?? fgAway.team.abbreviation
                    fontSize: 13
                    bold: true
                    color: fgHasWinner && !fgAway.winner ? muted : foreground
                    align: center
                    maxLines: 2
                  }
                  Text {
                    text: fgAwayRec
                    style: small
                    color: muted
                    align: center
                  }
                }

                // Middle Score / Clock
                Column {
                  width: 116
                  align: center
                  gap: 4

                  if fgIsPre {
                    Text { text: "AT"; style: title; color: muted; bold: true; align: center }
                    Text { text: fgKickDate; style: small; color: foreground; align: center; bold: true }
                    Text { text: fgKickTime; style: small; color: seaGreen; align: center; bold: true }
                  } else {
                    Row {
                      gap: 6
                      align: center
                      Text {
                        text: fgAwayScore
                        fontSize: 28
                        bold: true
                        color: fgHasWinner && !fgAway.winner ? muted : foreground
                      }
                      Text { text: "-"; fontSize: 28; color: muted }
                      Text {
                        text: fgHomeScore
                        fontSize: 28
                        bold: true
                        color: fgHasWinner && !fgHome.winner ? muted : foreground
                      }
                    }
                    Text {
                      text: fgStatusText
                      style: small
                      color: fgIsLive ? seaGreen : muted
                      bold: true
                      align: center
                    }
                    if fgDownDist != "" {
                      Row {
                        align: center
                        gap: 4
                        Text { text: "🏈 ${fgDownDist}"; style: small; bold: true; color: seaGreen }
                        if fgIsRedZone {
                          Text { text: "RED ZONE"; style: label; bold: true; color: red }
                        }
                      }
                    }
                  }
                }

                // Home Team
                Column {
                  weight: 1
                  align: center
                  gap: 4
                  Box {
                    width: homeIsWinner ? screenAuraW : int(round(screenHomeLogoPx * 1.32)) + 4
                    height: screenLogoSlotH
                    align: center
                    if homeIsWinner {
                      if seaWonFeatured {
                        WinnerAura { w: screenAuraW; h: screenLogoSlotH; col: seaGreen }
                      } else {
                        BooAura { w: screenAuraW; h: screenLogoSlotH }
                      }
                    }
                    Box {
                      opacity: fgHasWinner && !homeIsWinner ? 0.82 : 1
                      TeamLogo { abbr: fgHome.team.abbreviation; px: screenHomeLogoPx; plate: !homeIsWinner }
                    }
                  }
                  Text {
                    text: fgHome.team.shortDisplayName ?? fgHome.team.displayName ?? fgHome.team.abbreviation
                    fontSize: 13
                    bold: true
                    color: fgHasWinner && !fgHome.winner ? muted : foreground
                    align: center
                    maxLines: 2
                  }
                  Text {
                    text: fgHomeRec
                    style: small
                    color: muted
                    align: center
                  }
                }
              }

              // Venue and Details
              Box {
                fill: width
                padding: [10, 8]
                radius: 6 * corners
                background: alpha(surface, 0.4)

                Column {
                  gap: 4
                  Row {
                    Text { text: "Stadium:"; style: small; color: muted; width: 60 }
                    Text { text: fgVenue; style: small; weight: 1 }
                  }
                  if fgIsFinal && fgBroadcast != "" {
                    Row {
                      Text { text: "Network:"; style: small; color: muted; width: 60 }
                      Text { text: fgBroadcast; style: small; weight: 1 }
                    }
                  }
                  if featuredGame.weather != null {
                    Row {
                      Text { text: "Weather:"; style: small; color: muted; width: 60 }
                      Text {
                        text: "${featuredGame.weather.displayValue ?? ''}, ${featuredGame.weather.temperature ?? ''}°F"
                        style: small
                        weight: 1
                      }
                    }
                  }
                }
              }

              // ESPN Gamecast button
              Box {
                fill: width
                padding: [12, 9]
                radius: 6 * corners
                background: alpha(seaGreen, 0.12)
                border: 1
                borderColor: alpha(seaGreen, 0.6)
                onTap: { haptic(); url("https://www.espn.com/nfl/game/_/gameId/${featuredGame.id}") }
                Text {
                  text: fgIsLive ? "ESPN Live Gamecast ↗" : (fgIsFinal ? "ESPN Box Score & Recap ↗" : "ESPN Matchup Preview ↗")
                  style: small
                  bold: true
                  color: seaGreen
                  align: center
                }
              }
            }
          }

          // Betting Odds & ESPN Win Probability Card
          if hasOdds || hasWinProb {
            Text {
              text: (hasLiveOdds || hasLiveProb) ? "LIVE ODDS & WIN PROBABILITY" : (fgIsFinal ? "PREGAME ODDS & WIN PROBABILITY" : "BETTING ODDS & WIN PROBABILITY")
              style: label
              color: muted
            }
            Box {
              fill: width
              padding: 12
              radius: 10 * corners
              background: alpha(surface, 0.6)
              border: 1
              borderColor: (hasLiveOdds || hasLiveProb) ? seaGreen : border

              Column {
                gap: 10
                fill: width

                if hasWinProb {
                  Column {
                    gap: 6
                    fill: width
                    Row {
                      fill: width
                      align: center
                      gap: 6
                      if hasLiveProb {
                        Text {
                          text: "● LIVE"
                          style: label
                          bold: true
                          color: red
                          padding: [4, 1]
                          radius: 3 * corners
                          background: alpha(red, 0.2)
                        }
                      }
                      Text {
                        text: hasLiveProb ? "ESPN Win Probability" : (fgIsFinal ? "ESPN Pregame Win Probability" : "ESPN Matchup Predictor")
                        style: small
                        bold: true
                        color: hasLiveProb ? red : foreground
                      }
                      Spacer { weight: 1 }
                      Text { text: "ESPN Analytics"; style: label; color: muted }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      TeamLogo { abbr: fgAwayAbbr; px: 18; plate: true }
                      Text {
                        text: "${fgAwayName} ${awayWinPctStr}%"
                        style: small
                        bold: !fgIsHome || awayWinPct >= homeWinPct
                        color: !fgIsHome ? seaGreen : (awayWinPct >= homeWinPct ? foreground : muted)
                      }
                      Spacer { weight: 1 }
                      Text {
                        text: "${homeWinPctStr}% ${fgHomeName}"
                        style: small
                        bold: fgIsHome || homeWinPct >= awayWinPct
                        color: fgIsHome ? seaGreen : (homeWinPct >= awayWinPct ? foreground : muted)
                      }
                      TeamLogo { abbr: fgHomeAbbr; px: 18; plate: true }
                    }

                    Row {
                      fill: width
                      height: 8
                      radius: 4 * corners
                      clip: true
                      gap: 2
                      Box {
                        weight: clamp(awayWinPct, 2, 98)
                        height: 8
                        background: !fgIsHome ? seaGreen : alpha(foreground, 0.32)
                      }
                      Box {
                        weight: clamp(homeWinPct, 2, 98)
                        height: 8
                        background: fgIsHome ? seaGreen : alpha(foreground, 0.32)
                      }
                    }
                  }
                }

                if hasWinProb && hasOdds {
                  Box {
                    fill: width
                    height: 1
                    background: alpha(border, 0.6)
                  }
                }

                if hasOdds {
                  Column {
                    gap: 4
                    fill: width
                    Row {
                      fill: width
                      align: center
                      gap: 6
                      if hasLiveOdds {
                        Text {
                          text: "● LIVE"
                          style: label
                          bold: true
                          color: red
                          padding: [4, 1]
                          radius: 3 * corners
                          background: alpha(red, 0.2)
                        }
                      }
                      Text {
                        text: hasLiveOdds ? "Live Betting Lines" : (fgIsLive ? "Closing Lines (Live Paused)" : (fgIsFinal ? "Closing Pregame Lines" : "Game Lines"))
                        style: small
                        bold: true
                        color: hasLiveOdds ? red : foreground
                      }
                      Spacer { weight: 1 }
                      Text {
                        text: oddsProvider
                        style: label
                        bold: true
                        color: seaGreen
                        padding: [5, 2]
                        radius: 4 * corners
                        background: alpha(seaGreen, 0.16)
                      }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 2]
                      Text { text: "TEAM"; style: label; color: muted; weight: 1 }
                      Text { text: "SPREAD"; style: label; color: muted; width: 78; align: end }
                      Text { text: "ML"; style: label; color: muted; width: 44; align: end }
                      Text { text: "TOTAL"; style: label; color: muted; width: 88; align: end }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 5]
                      radius: 4 * corners
                      background: !fgIsHome ? alpha(seaGreen, 0.15) : rgb(0, 0, 0, 0)
                      TeamLogo { abbr: fgAwayAbbr; px: 18; plate: true }
                      Text {
                        text: fgAwayName
                        style: small
                        bold: !fgIsHome
                        color: !fgIsHome ? seaGreen : foreground
                        weight: 1
                        maxLines: 1
                      }
                      Text {
                        text: oddsAwaySpread != "" ? (oddsAwaySpreadJuice != "" ? "${oddsAwaySpread} (${oddsAwaySpreadJuice})" : oddsAwaySpread) : "–"
                        fontSize: 11
                        bold: true
                        width: 78
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsAwayMl != "" ? oddsAwayMl : "–"
                        fontSize: 11
                        bold: true
                        color: !fgIsHome ? seaGreen : foreground
                        width: 44
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsOuStr != "" ? (oddsOverJuice != "" ? "O${oddsOuStr} (${oddsOverJuice})" : "O${oddsOuStr}") : "–"
                        fontSize: 11
                        color: muted
                        width: 88
                        align: end
                        maxLines: 1
                      }
                    }

                    Row {
                      fill: width
                      align: center
                      gap: 6
                      padding: [6, 5]
                      radius: 4 * corners
                      background: fgIsHome ? alpha(seaGreen, 0.15) : rgb(0, 0, 0, 0)
                      TeamLogo { abbr: fgHomeAbbr; px: 18; plate: true }
                      Text {
                        text: fgHomeName
                        style: small
                        bold: fgIsHome
                        color: fgIsHome ? seaGreen : foreground
                        weight: 1
                        maxLines: 1
                      }
                      Text {
                        text: oddsHomeSpread != "" ? (oddsHomeSpreadJuice != "" ? "${oddsHomeSpread} (${oddsHomeSpreadJuice})" : oddsHomeSpread) : "–"
                        fontSize: 11
                        bold: true
                        width: 78
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsHomeMl != "" ? oddsHomeMl : "–"
                        fontSize: 11
                        bold: true
                        color: fgIsHome ? seaGreen : foreground
                        width: 44
                        align: end
                        maxLines: 1
                      }
                      Text {
                        text: oddsOuStr != "" ? (oddsUnderJuice != "" ? "U${oddsOuStr} (${oddsUnderJuice})" : "U${oddsOuStr}") : "–"
                        fontSize: 11
                        color: muted
                        width: 88
                        align: end
                        maxLines: 1
                      }
                    }

                    if oddsRefLabel != "" {
                      Box {
                        fill: width
                        padding: [8, 4]
                        radius: 4 * corners
                        background: alpha(surface, 0.4)
                        Text { text: oddsRefLabel; style: label; color: muted }
                      }
                    }
                  }
                }
              }
            }
          }

          // NFC West Division Table
          Text { text: "NFC WEST DIVISION RACE"; style: label; color: muted }
          Box {
            fill: width
            padding: 10
            radius: 8 * corners
            background: alpha(surface, 0.6)
            border: 1
            borderColor: border

            Column {
              gap: 4
              fill: width

              Row {
                fill: width
                align: center
                gap: 6
                padding: [6, 2]
                Text { text: "#"; style: label; color: muted; width: 14 }
                Text { text: "TEAM"; style: label; color: muted; weight: 1 }
                Text { text: "W-L"; style: label; color: muted; width: 38; align: end }
                Text { text: "DIV"; style: label; color: muted; width: 34; align: end }
                Text { text: "STRK"; style: label; color: muted; width: 34; align: end }
                Text { text: "SEED"; style: label; color: muted; width: 34; align: end }
              }

              for entry, i in nfcWest key entry.team.id {
                let isSea = entry.team.abbreviation == 'SEA'
                let rec = (entry.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'
                let divRec = (entry.stats.find(s => s.name == 'divisionRecord') ?? {}).displayValue ?? '–'
                let strk = (entry.stats.find(s => s.name == 'streak') ?? {}).displayValue ?? '–'
                let seed = (entry.stats.find(s => s.name == 'playoffSeed') ?? {}).displayValue ?? '–'

                Row {
                  fill: width
                  align: center
                  gap: 6
                  padding: [6, 4]
                  radius: 4 * corners
                  background: isSea ? alpha(seaGreen, 0.15) : rgb(0, 0, 0, 0)

                  Text { text: "${i + 1}"; style: small; color: muted; width: 14 }
                  TeamLogo { abbr: entry.team.abbreviation; px: 18; plate: true }
                  Text {
                    text: entry.team.shortDisplayName ?? entry.team.displayName
                    style: small
                    bold: isSea
                    color: isSea ? seaGreen : foreground
                    weight: 1
                    maxLines: 1
                  }
                  Text {
                    text: rec
                    style: small
                    bold: true
                    color: isSea ? seaGreen : foreground
                    width: 38
                    align: end
                    maxLines: 1
                  }
                  Text {
                    text: divRec
                    style: small
                    color: muted
                    width: 34
                    align: end
                    maxLines: 1
                  }
                  Text {
                    text: strk
                    style: small
                    color: startsWith(strk, 'W') ? winGreen : (startsWith(strk, 'L') ? red : muted)
                    width: 34
                    align: end
                    maxLines: 1
                  }
                  Text {
                    text: "#${seed}"
                    style: label
                    color: muted
                    width: 34
                    align: end
                    maxLines: 1
                  }
                }
              }
            }
          }

          // Previous Result
          if prevGame != null && prevGame.id != featuredGame.id {
            Text { text: "PREVIOUS RESULT"; style: label; color: muted }
            Box {
              fill: width
              padding: 10
              radius: 8 * corners
              background: alpha(surface, 0.6)
              border: 1
              borderColor: border
              onTap: { haptic(); url("https://www.espn.com/nfl/game/_/gameId/${prevGame.id}") }

              Row {
                fill: width
                align: center
                gap: 8
                Text {
                  text: pgWon ? "WIN" : "LOSS"
                  style: small
                  bold: true
                  color: pgWon ? winGreen : red
                  padding: [6, 3]
                  radius: 4 * corners
                  background: pgWon ? alpha(winGreen, 0.2) : alpha(red, 0.2)
                }
                TeamLogo { abbr: pgOppAbbr; px: 28; plate: true }
                Column {
                  gap: 1
                  weight: 1
                  Text {
                    text: "Week ${prevGame.week.number}: ${pgResult}"
                    style: body
                    bold: true
                  }
                  Text { text: "Final Score • Tap for ESPN Recap ↗"; style: small; color: muted }
                }
              }
            }
          }
        }
      }

      // Screen Tab 2: All News
      if screenTab == "news" {
        Column {
          gap: 8
          fill: width

          Text { text: "LATEST SEAHAWKS NEWS"; style: label; color: muted }

          NewsFilterBar { padY: 4; chipRadius: 8 }

          if len(articles) == 0 {
            Text { text: "Fetching Seahawks news…"; style: small; color: muted }
          } else {
            for item in articles.take(20) key item.id {
              Box {
                fill: width
                padding: 10
                radius: 8 * corners
                background: alpha(surface, 0.6)
                border: 1
                borderColor: border
                onTap: { haptic(); url(item.link) }

                Column {
                  gap: 4
                  fill: width

                  Row {
                    gap: 6
                    align: center
                    if item.ts != null && item.ts > 0 {
                      Text { text: fmtAgo(item.ts, now); style: label; color: seaGreen; bold: true }
                      Text { text: "•"; style: label; color: muted }
                    }
                    Text { text: item.src; style: label; color: muted }
                  }

                  Text {
                    text: item.title
                    style: body
                    bold: true
                  }

                  if (item.desc ?? "") != "" {
                    Text {
                      text: item.desc
                      style: small
                      color: muted
                      maxLines: 3
                    }
                  }

                  Row {
                    align: center
                    gap: 4
                    Text { text: "Read story ↗"; style: small; color: accent }
                  }
                }
              }
            }
          }
        }
      }

      // Screen Tab 3: Full Schedule
      if screenTab == "schedule" {
        Column {
          gap: 6
          fill: width

          Text { text: "${schedule.season.year ?? 2026} REGULAR SEASON SCHEDULE"; style: label; color: muted }

          for g in schedEvents key g.id {
            let gc = g.competitions[0]
            let gcomps = gc.competitors ?? []
            let gSea = gcomps.find(t => (t.team.abbreviation ?? '') == 'SEA')
            let gOpp = gcomps.find(t => (t.team.abbreviation ?? '') != 'SEA')
            let gOppAbbr = gOpp.team.abbreviation ?? gOpp.team ?? ''
            let gState = gc.status.type.state ?? 'pre'
            let gWon = gSea.winner == true
            let isDone = gState == 'post'
            let isCurrent = g.id == featuredGame.id
            let scSea = gSea.score.displayValue ?? gSea.score ?? '–'
            let scOpp = gOpp.score.displayValue ?? gOpp.score ?? '–'
            let dt = parseTime(g.date)

            Box {
              fill: width
              padding: [8, 6]
              radius: 6 * corners
              background: isCurrent ? alpha(seaGreen, 0.15) : (gState == 'in' ? alpha(seaGreen, 0.15) : alpha(surface, 0.6))
              border: 1
              borderColor: (isCurrent || gState == 'in') ? seaGreen : border

              Row {
                fill: width
                align: center
                gap: 8

                Text { text: "W${g.week.number}"; style: small; color: isCurrent ? seaGreen : muted; width: 32; bold: isCurrent }
                TeamLogo { abbr: gOppAbbr; px: 22 }
                Column {
                  gap: 1
                  weight: 1
                  Text {
                    text: "${gOpp.homeAway == 'home' ? '@' : 'vs'} ${gOpp.team.displayName ?? gOppAbbr}"
                    style: small
                    bold: true
                    color: (isCurrent || gState == 'in') ? seaGreen : foreground
                  }
                  if dt != null {
                    Text {
                      text: fmtTime(dt, "EEE, MMM d • h:mm a")
                      style: label
                      color: muted
                    }
                  }
                }
                Spacer { weight: 1 }
                if isDone {
                  Text {
                    text: "${gWon ? 'W' : 'L'} ${scSea}-${scOpp}"
                    style: small
                    bold: true
                    color: gWon ? winGreen : red
                    padding: [6, 2]
                    radius: 4
                    background: gWon ? alpha(winGreen, 0.2) : alpha(red, 0.2)
                  }
                } else if gState == 'in' {
                  Text {
                    text: "LIVE"
                    style: small
                    bold: true
                    color: seaGreen
                    padding: [6, 2]
                    radius: 4
                    background: alpha(seaGreen, 0.2)
                  }
                } else {
                  Text {
                    text: gc.status.type.shortDetail ?? 'Scheduled'
                    style: small
                    color: isCurrent ? accent : muted
                    bold: isCurrent
                  }
                }
              }
            }
          }
        }
      }

      // Actions
      Row {
        gap: 8
        fill: width
        Button {
          text: "Official Seahawks.com ↗"
          weight: 1
          onTap: { haptic(); url("https://www.seahawks.com") }
        }
        Button {
          text: "Close"
          width: 80
          onTap: { haptic(); close() }
        }
      }
    }
  }
}
