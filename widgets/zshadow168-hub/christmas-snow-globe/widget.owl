widget "christmas snow globe" {
  meta { owl: 21; description: "A colourful Christmas snow globe: tilt to swirl the snow, shake it, and count the days to Christmas"; version: "1.11"; license: "MIT"; category: "fun" }
  size: 3x2
  minSize: 3x2
  fps: 30

  // It runs no commands and needs no packages; declared so the store can say so.
  requires { pacman: [] }

  source m = android.motion
  source now = clock every 60s

  // ---------- Christmas countdown ----------
  let year = int(fmtTime(now ?? 0, "yyyy"))
  let xmasThis = parseTime("${year}-12-25")
  let xmasNext = parseTime("${year + 1}-12-25")
  let pastXmas = (now ?? 0) >= (xmasThis ?? 0) + 86400
  let target = pastXmas ? xmasNext : xmasThis
  let xmasDay = now != null && xmasThis != null && now >= xmasThis && now < xmasThis + 86400
  let daysLeft = target == null || now == null ? null : max(0, ceil((target - now) / 86400))
  let countdown = xmasDay ? "Merry Christmas!" : (daysLeft == null ? "…" : (daysLeft == 1 ? "1 day to Christmas" : "${daysLeft} days to Christmas"))
  let bigNum = daysLeft == null ? "…" : "${daysLeft}"

  // ---------- orientation ----------
  // screenWidth/screenHeight are the screen's own size, so a rotated phone gives SW > SH.
  // The landscape row is built from these numbers: the globe is as wide as its height
  // needs (no dead space beside the glass) and the words take the rest, so the two
  // always add up to the width whatever the phone or window is.
  let SW = screenWidth ?? 0
  let SH = screenHeight ?? 0
  let land = SW > SH
  let pW = SW > 0 ? SW : 380
  let lw = SW - 50
  let gW = min(SH * 0.86, lw * 0.40)
  let tW = min(lw * 0.60, 460)

  // ---------- festival palette ----------
  let cRed = #ff4d6d
  let cGold = #ffd166
  let cMint = #7ae582
  let cSky = #4cc9f0
  let cMagenta = #f72585
  let bulbColors = [cRed, cGold, cMint, cSky, cMagenta]

  // ---------- the snow (falling system taken from market-face-petrzpav-snow-globe) ----------
  // x and y are in globe radii from the middle, y down, so the physics does not depend
  // on how big the globe is drawn. s marks snow that has settled on the drift, f is the
  // flake's own fall speed and ph its wobble phase; every flake eases towards f in the
  // gravity direction, so the snow can only fall and sway, never run away.
  state flakes = range(70).map(i => {x: random() * 1.6 - 0.8, y: random() * 1.1 - 0.95, vx: 0, vy: 0, s: false, f: 0.2 + random() * 0.22, ph: random() * 6.28})
  state calm = false
  state pm = null
  state pdt = 0
  state shakeE = 0
  state kick = 0
  state gt = 0
  state shake = 0

  let tilted = m.available == true
  let SHAKE = 0.9
  let SHAKE_HINT = 1.6
  let RF = 0.90

  onTap: screen()

  // physics: the snow falls along the phone's real gravity, as in market-face-petrzpav-snow-globe
  every frame {
    gt = gt + dt
    let has = m.available == true
    let mx = has ? m.x : 0
    let my = has ? m.y : 1
    let mz = has ? m.z : 0
    // How far the tilt moved since the last frame; a first reading after the sensor starts,
    // after a pause (dt is capped at 0.1) or after a reload can jump further in one frame
    // than a hand moves it, which is the globe catching up, not a shake
    let delta = pm == null || !has ? 0 : abs(mx - pm[0]) + abs(my - pm[1]) + abs(mz - pm[2])
    let pause = dt >= 0.099 && pdt < 0.099
    let jump = delta > max(0.9, dt * 12) || pause
    pdt = dt
    pm = has ? [mx, my, mz] : null
    shakeE = shakeE * pow(0.03, dt) + (jump ? 0 : delta)
    // gravity across the screen; lying flat there is little of it, so a downward pull is
    // added and the snow still drifts down slowly
    let glen = sqrt(mx * mx + my * my)
    let gX = mx
    let gY = glen < 0.6 ? my + 0.6 - glen : my
    let stir = shakeE > SHAKE ? min((shakeE - SHAKE) * 2, 3) : 0

    // a tap (kick 1.4) lifts the whole globe, shaking the phone itself stirs the snow
    if kick > 0 {
      flakes = flakes.map(f => merge(f, {
        vx: f.vx + (random() - 0.5) * 2 * kick - gX * random() * kick,
        vy: f.vy + (random() - 0.5) * kick - gY * random() * kick * 1.6,
        s: false
      }))
      kick = 0
    }
    if stir > 0 {
      flakes = flakes.map(f => merge(f, {
        vx: f.vx + ((random() - 0.5) * 2 - gX * random()) * stir * 6 * dt,
        vy: f.vy + ((random() - 0.5) * 2 - gY * random() * 1.5) * stir * 6 * dt,
        s: false
      }))
    }
    shake = max(0, shake - dt * 0.55)

    // snow that lies somewhere comes loose once the globe turns away from it, and a settled flake
    // is thrown back up every few seconds, so the snow never stops snowing
    flakes = flakes.map((f, i) => !f.s ? f : (hash(i, 41 + floor(gt / 3)) > 0.55 ? merge(f, {x: (hash(i, 42) - 0.5) * 1.5, y: -0.95, vx: 0, vy: 0, s: false}) : (f.y >= 0.20 + 0.22 * f.x * f.x - 0.02 ? (gY > 0.12 ? f : merge(f, {s: false})) : ((gX * f.x + gY * f.y) / max(sqrt(f.x * f.x + f.y * f.y), 0.01) > 0.55 ? f : merge(f, {s: false})))))

    if any(flakes, f => !f.s) {
      let ease = 1 - pow(0.3, dt)
      flakes = flakes
        .map(f => f.s ? f : merge(f, {vx: lerp(f.vx, gX * f.f + 0.05 * sin(gt * 1.3 + f.ph), ease), vy: lerp(f.vy, gY * f.f + 0.03 * cos(gt * 1.1 + f.ph), ease)}))
        .map(f => f.s ? f : merge(f, {x: f.x + f.vx * dt, y: f.y + f.vy * dt}))
        .map(f => f.s ? f : merge(f, {d: max(sqrt(f.x * f.x + f.y * f.y), 0.001)}))
        // the glass: a flake only keeps the part of its speed that is not pressed into the
        // glass, so it slides along the wall down to the drift instead of stopping on it
        .map(f => f.s || f.d <= RF ? f : merge(f, {
          x: f.x * RF / f.d,
          y: f.y * RF / f.d,
          vx: f.vx - max(0, (f.vx * f.x + f.vy * f.y) / f.d) * f.x / f.d,
          vy: f.vy - max(0, (f.vx * f.x + f.vy * f.y) / f.d) * f.y / f.d,
          s: (gX * f.x + gY * f.y) / f.d > 0.75
        }))
        // the drift: land on it, and lie still while gravity keeps it there
        .map(f => f.s || f.y < 0.20 + 0.22 * f.x * f.x ? f : merge(f, {
          y: 0.20 + 0.22 * f.x * f.x,
          vy: min(f.vy, 0),
          vx: f.vx * 0.5,
          s: gY > 0.2
        }))
    }
    calm = all(flakes, f => f.s)
  }

  // ================= SHARED GLOBE SCENE (portrait and landscape) =================
  component ChristmasGlobe(rf = 0.39) {
    Canvas {
      fill: true
      let cx = width / 2
        let R = min(width * 0.47, height * rf)
        let cy = height / 2 - R * 0.07
        let bT = cy + R * 0.86

      // colourful twinkling stars, outside the glass
      for i in range(26) {
        let sx = hash(i, 31) * width
        let sy = hash(i, 32) * height
        let tw = 0.18 + 0.60 * ((sin(time * (0.7 + hash(i, 34) * 1.5) + i * 1.7) + 1) / 2)
        if sqrt((sx - cx) * (sx - cx) + (sy - cy) * (sy - cy)) > R * 1.04 {
          circle(sx, sy, 0.7 + hash(i, 33) * 1.6, fill: alpha(i % 3 == 0 ? #ffd166 : (i % 3 == 1 ? #7ae582 : #4cc9f0), tw))
        }
      }

      // halo: rose, mint and sky, so the glass glows in colour
      circle(cx, cy, R * 1.22, fill: radial(cx, cy, R * 1.22, [alpha(#ffd166, 0.045), alpha(#f72585, 0.045), alpha(#4cc9f0, 0.018), alpha(#4cc9f0, 0)]))
      // shadow under the base
      scale(1, 0.15, cx, cy + R * 1.24) {
        circle(cx, cy + R * 1.24, R * 0.75, fill: radial(cx, cy + R * 1.24, R * 0.75, [alpha(#000000, 0.24), alpha(#000000, 0)]))
      }

      // ---------- moon in the background: pixel-art moon ----------
      let mX = cx + R * 0.55
      let mY = cy - R * 0.90
      let mR = R * 0.16
      let mC = mR / 7
      let mT = mY - mR
      circle(mX, mY, mR * 1.7, fill: radial(mX, mY, mR * 1.7, [alpha(#b9c6ff, 0.13), alpha(#b9c6ff, 0)]))
      // dark pixel outline, then the body one pixel inside it
      let moonRows = [3, 5, 7, 9, 11, 11, 13, 13, 11, 11, 9, 7, 5, 3]
      let moonBody = [3, 5, 7, 9, 9, 11, 11, 9, 9, 7, 5, 3]
      for w, k in moonRows {
        rect(mX - w * mC / 2, mT + k * mC, w * mC, mC, fill: #2b2f45)
      }
      for w, k in moonBody {
        rect(mX - w * mC / 2, mT + (k + 1) * mC, w * mC, mC, fill: #8b93b8)
      }
      // lit upper-left, blocky craters lower-right
      rect(mX - mC * 4, mT + mC * 3, mC * 3, mC, fill: alpha(#c3c9e0, 0.50))
      rect(mX - mC * 4, mT + mC * 4, mC * 2, mC * 3, fill: alpha(#c3c9e0, 0.35))
      rect(mX - mC * 3, mT + mC * 5, mC * 2, mC * 2, fill: #6f7699)
      rect(mX - mC * 3, mT + mC * 5, mC * 2, mC, fill: #7c83a6)
      rect(mX + mC * 1, mT + mC * 4, mC * 2, mC * 2, fill: #6f7699)
      rect(mX + mC * 1, mT + mC * 4, mC * 2, mC, fill: #7c83a6)
      rect(mX, mT + mC * 8, mC * 2, mC * 2, fill: #767da0)
      rect(mX - mC * 5, mT + mC * 8, mC, mC, fill: #767da0)

      // glass
      circle(cx, cy, R, fill: radial(cx - R * 0.20, cy - R * 0.26, R * 1.45, [alpha(#d9f2ff, 0.20), alpha(#8ecae6, 0.10), alpha(#2a1a4a, 0.34)]))

      clip(cx - R, cy - R, R * 2, R * 2) {
        // inside sky: teal at the top, violet in the middle, rose at the horizon
        circle(cx, cy, R, fill: linear(0, cy - R, 0, cy + R, [alpha(#0f3358, 0.80), alpha(#2a1b52, 0.70), alpha(#6b1f4a, 0.62)]))
        // aurora ribbons
        arc(cx, cy - R * 0.12, R * 0.92, 205, 130, stroke: alpha(#7ae582, 0.09), width: R * 0.11, cap: round)
        arc(cx, cy - R * 0.02, R * 1.00, 225, 90, stroke: alpha(#4cc9f0, 0.08), width: R * 0.09, cap: round)

        // distant pixel mountains, night-tinted, stepped like the reference landscape
        let farRidge = range(38).map(k => [cx + R * (-0.93 + k * 0.049), cy + R * 0.32 - R * 0.055 * floor(max(0, max(0.30 - abs(-0.93 + k * 0.049 + 0.58) * 0.60, max(0.46 - abs(-0.93 + k * 0.049 - 0.04) * 0.70, 0.28 - abs(-0.93 + k * 0.049 - 0.62) * 0.56))) / 0.055)])
        let farPath = [[cx - R * 0.84, cy + R * 0.47]] + farRidge + [[cx + R * 0.84, cy + R * 0.47]]
        path(farPath, closed: true, fill: #cfe0f5)
        translate(0, R * 0.018) { path(farPath, closed: true, fill: #7c97c0) }
        translate(0, R * 0.048) { path(farPath, closed: true, fill: #2c4670) }
        let nearRidge = range(30).map(k => [cx + R * (-0.87 + k * 0.060), cy + R * 0.44 - R * 0.055 * floor(max(0, max(0.24 - abs(-0.87 + k * 0.060 + 0.42) * 0.55, max(0.32 - abs(-0.87 + k * 0.060 - 0.26) * 0.62, 0.20 - abs(-0.87 + k * 0.060 - 0.78) * 0.50))) / 0.055)])
        let nearPath = [[cx - R * 0.82, cy + R * 0.50]] + nearRidge + [[cx + R * 0.82, cy + R * 0.50]]
        path(nearPath, closed: true, fill: #e2edfa)
        translate(0, R * 0.020) { path(nearPath, closed: true, fill: #45618f) }
        translate(0, R * 0.055) { path(nearPath, closed: true, fill: #14224a) }

        // falling snow, behind everything so it never covers the scene. Snow lying on the
        // ground is part of it; draw only what is in the air or on the glass.
        for f in flakes {
          if !(f.s && f.y >= 0.20 + 0.22 * f.x * f.x - 0.02) {
            circle(cx + f.x * R, cy + f.y * R, f.ph < 2.5 ? f.f * 0.08 * R : f.f * 0.13 * R, fill: alpha(#ffffff, 0.90))
          }
        }

        // snow drift, inscribed in the glass
        let arcB = range(13).map(i => [cx + cos(rad(25 + i * 10.8333)) * (R - 1.5), cy + sin(rad(25 + i * 10.8333)) * (R - 1.5)])
        path([[cx - R * 0.906, cy + R * 0.423], [cx - R * 0.55, cy + R * 0.20], [cx - R * 0.12, cy + R * 0.30], [cx + R * 0.32, cy + R * 0.18], [cx + R * 0.906, cy + R * 0.423]] + arcB, closed: true, fill: linear(0, cy + R * 0.15, 0, cy + R, [#f2faff, #cfe6f7, #9dc4dd]))
        // soft blue depth at the bottom of the drift
        scale(1, 0.30, cx, cy + R * 0.80) {
          circle(cx, cy + R * 0.80, R * 0.62, fill: radial(cx, cy + R * 0.80, R * 0.62, [alpha(#8ecae6, 0.16), alpha(#8ecae6, 0)]))
        }

        // ---------- house (pixel art) ----------
        let hL = cx - R * 0.40
        let hW = R * 0.28
        let hB = cy + R * 0.33
        let hH = R * 0.19
        let hC = hW / 12
        let hT = hB - hH
        circle(hL + hW * 0.66, hT + hH * 0.40, R * 0.20, fill: radial(hL + hW * 0.66, hT + hH * 0.40, R * 0.20, [alpha(#ffd166, 0.16), alpha(#ff9f1c, 0.05), alpha(#ff9f1c, 0)]))
        // chimney, drawn first so the roof overlaps its foot
        rect(hL + hW * 0.38, hT - hC * 6.2, hC * 1.8, hC * 2.8, fill: #8a5a3a)
        rect(hL + hW * 0.38, hT - hC * 6.2, hC * 1.8, hC * 0.6, fill: #5d3524)
        // walls with plank lines
        rect(hL, hT, hW, hH, fill: #a86a3f)
        for k in range(3) {
          rect(hL + hW * (0.18 + k * 0.26), hT, hC * 0.4, hH, fill: alpha(#7d4526, 0.35))
        }
        // stepped roof, orange shingles with a shaded right side and snow on the ridge
        for k in range(5) {
          let rw = hW * (0.56 + k * 0.112)
          let ry = hT - hC * (5 - k)
          rect(hL + hW / 2 - rw / 2, ry, rw, hC, fill: k % 2 == 0 ? #c9722a : #b5651d)
          rect(hL + hW / 2 + rw * 0.10, ry, rw * 0.40, hC, fill: alpha(#7a3d10, 0.30))
        }
        rect(hL + hW / 2 - hW * 0.28, hT - hC * 5.6, hW * 0.56, hC * 0.6, fill: alpha(#ffffff, 0.85))
        // lit window with a dark cross frame
        rect(hL + hW * 0.56, hT + hH * 0.16, hW * 0.32, hH * 0.38, fill: #ffe9a8)
        rect(hL + hW * 0.70, hT + hH * 0.16, hC * 0.45, hH * 0.38, fill: #7d4526)
        rect(hL + hW * 0.56, hT + hH * 0.32, hW * 0.32, hC * 0.45, fill: #7d4526)
        // door with a pixel wreath
        rect(hL + hW * 0.10, hT + hH * 0.34, hW * 0.28, hH * 0.66, fill: #4a2618)
        rect(hL + hW * 0.32, hT + hH * 0.62, hC * 0.5, hC * 0.5, fill: #ffd166)
        rect(hL + hW * 0.14, hT + hH * 0.44, hC * 1.3, hC * 1.3, fill: #2aa06a)
        rect(hL + hW * 0.17, hT + hH * 0.50, hC * 0.6, hC * 0.6, fill: cRed)

        // ---------- trees, each with its own sway and its own lights ----------
        // left (pixel-art: stepped rows, dark right shade, big square lights)
        let lA = cx - R * 0.66
        let lB = cy + R * 0.35
        let lW = R * 0.152
        let lH = R * 0.46
        let lS = sin(time * 9.0) * shake * R * 0.050
        let lN = 6
        let lRh = lH / lN
        rect(lA - R * 0.026, lB, R * 0.052, R * 0.058, fill: #5d3524)
        for k in range(lN) {
          let ly = lB - lRh * (k + 1)
          let lsw = lS * (k + 1) / lN
          let lhw = lW * (1 - 0.88 * k / lN)
          rect(lA - lhw + lsw, ly, lhw * 2, lRh, fill: k % 2 == 0 ? #2f9e63 : #268a56)
          rect(lA + lhw * 0.32 + lsw, ly, lhw * 0.68, lRh, fill: alpha(#145c39, 0.55))
          rect(k % 2 == 0 ? lA - lhw - R * 0.018 + lsw : lA + lhw + lsw, ly + lRh * 0.28, R * 0.018, lRh * 0.44, fill: k % 2 == 0 ? #2f9e63 : #268a56)
        }
        let lBulbs = range(5).map(k => [lA + (hash(k, 61) - 0.5) * lW * (1 - 0.88 * (0.22 + 0.56 * hash(k, 62))) * 1.6, lB - lH * (0.22 + 0.56 * hash(k, 62))])
        for b, k in lBulbs {
          circle(b[0], b[1], R * 0.10, fill: alpha(bulbColors[(k * 2) % 5], 0.10))
          rect(b[0] - R * 0.023, b[1] - R * 0.023, R * 0.046, R * 0.046, fill: bulbColors[(k * 2) % 5])
        }

        // middle (tallest, with a star on top)
        let mA = cx + R * 0.15
        let mB = cy + R * 0.32
        let mW = R * 0.135
        let mH = R * 0.41
        let mS = sin(time * 10.5 + 0.8) * shake * R * 0.045
        let mN = 7
        let mRh = mH / mN
        rect(mA - R * 0.024, mB, R * 0.048, R * 0.058, fill: #5d3524)
        for k in range(mN) {
          let my = mB - mRh * (k + 1)
          let msw = mS * (k + 1) / mN
          let mhw = mW * (1 - 0.88 * k / mN)
          rect(mA - mhw + msw, my, mhw * 2, mRh, fill: k % 2 == 0 ? #3aa76c : #2f9e63)
          rect(mA + mhw * 0.32 + msw, my, mhw * 0.68, mRh, fill: alpha(#145c39, 0.50))
          rect(k % 2 == 0 ? mA - mhw - R * 0.016 + msw : mA + mhw + msw, my + mRh * 0.28, R * 0.016, mRh * 0.44, fill: k % 2 == 0 ? #3aa76c : #2f9e63)
        }
        let mBulbs = range(5).map(k => [mA + (hash(k, 63) - 0.5) * mW * (1 - 0.88 * (0.22 + 0.56 * hash(k, 64))) * 1.6, mB - mH * (0.22 + 0.56 * hash(k, 64))])
        for b, k in mBulbs {
          circle(b[0], b[1], R * 0.10, fill: alpha(bulbColors[(k * 2 + 1) % 5], 0.10))
          rect(b[0] - R * 0.021, b[1] - R * 0.021, R * 0.042, R * 0.042, fill: bulbColors[(k * 2 + 1) % 5])
        }
        // star topper
        let starY = mB - mH - R * 0.035
        circle(mA + mS, starY, R * 0.15, fill: radial(mA + mS, starY, R * 0.15, [alpha(#ffd166, 0.26), alpha(#ffb703, 0.05), alpha(#ffb703, 0)]))
        path([[mA + mS, starY - R * 0.080], [mA + mS + R * 0.021, starY - R * 0.021], [mA + mS + R * 0.080, starY], [mA + mS + R * 0.021, starY + R * 0.021], [mA + mS, starY + R * 0.080], [mA + mS - R * 0.021, starY + R * 0.021], [mA + mS - R * 0.080, starY], [mA + mS - R * 0.021, starY - R * 0.021]], closed: true, fill: #ffd166)

        // right
        let rA = cx + R * 0.60
        let rB = cy + R * 0.35
        let rW = R * 0.125
        let rH = R * 0.34
        let rS = sin(time * 11.5 + 1.7) * shake * R * 0.050
        let rN = 5
        let rRh = rH / rN
        rect(rA - R * 0.022, rB, R * 0.044, R * 0.052, fill: #5d3524)
        for k in range(rN) {
          let ry = rB - rRh * (k + 1)
          let rsw = rS * (k + 1) / rN
          let rhw = rW * (1 - 0.88 * k / rN)
          rect(rA - rhw + rsw, ry, rhw * 2, rRh, fill: k % 2 == 0 ? #2f9e63 : #268a56)
          rect(rA + rhw * 0.32 + rsw, ry, rhw * 0.68, rRh, fill: alpha(#145c39, 0.55))
          rect(k % 2 == 0 ? rA - rhw - R * 0.015 + rsw : rA + rhw + rsw, ry + rRh * 0.28, R * 0.015, rRh * 0.44, fill: k % 2 == 0 ? #2f9e63 : #268a56)
        }
        let rBulbs = range(4).map(k => [rA + (hash(k, 65) - 0.5) * rW * (1 - 0.88 * (0.22 + 0.56 * hash(k, 66))) * 1.6, rB - rH * (0.22 + 0.56 * hash(k, 66))])
        for b, k in rBulbs {
          circle(b[0], b[1], R * 0.09, fill: alpha(bulbColors[(k * 2 + 2) % 5], 0.10))
          rect(b[0] - R * 0.019, b[1] - R * 0.019, R * 0.038, R * 0.038, fill: bulbColors[(k * 2 + 2) % 5])
        }

        // ---------- a string of lights across the snow ----------
        for k in range(9) {
          let bx = cx - R * 0.70 + k * R * 0.175
          let by = cy + R * 0.31 + sin(rad(k * 24)) * R * 0.045
          circle(bx, by, R * 0.12, fill: alpha(bulbColors[k % 5], 0.14))
          circle(bx, by, R * 0.020, fill: bulbColors[k % 5])
          scale(1, 0.45, bx, by + R * 0.06) {
            circle(bx, by + R * 0.06, R * 0.12, fill: alpha(bulbColors[k % 5], 0.07))
          }
        }

        // a few tiny near flakes, high above the scene
        for i in range(8) {
          let fx = cx + (hash(i, 51) - 0.5) * R * 1.45
          let fy = cy - R * 0.76 + ((hash(i, 52) + time * 0.05) % 1) * R * 1.05
          if sqrt((fx - cx) * (fx - cx) + (fy - cy) * (fy - cy)) < R - 3 {
            circle(fx, fy, 0.95, fill: alpha(#ffffff, 0.45))
          }
        }

        // ---------- pixel gifts with bows, on the snow in front ----------
        let gY = cy + R * 0.50
        let gW = R * 0.125
        let gH = R * 0.100
        let gC = gW / 8
        let gifts = [[cx - R * 0.215, cRed, cGold], [cx - R * 0.062, cMint, cSky], [cx + R * 0.090, cGold, cRed]]
        for g, k in gifts {
          rect(g[0], gY - gH, gW, gH, fill: #2b1b2f)
          rect(g[0] + gC, gY - gH + gC, gW - gC * 2, gH - gC, fill: g[1])
          rect(g[0] + gC, gY - gH + gC, gW - gC * 2, gC * 0.8, fill: alpha(#000000, 0.16))
          rect(g[0] + gC * 3.2, gY - gH + gC, gC * 1.6, gH - gC, fill: g[2])
          rect(g[0] + gC * 2.1, gY - gH - gC * 0.9, gC * 1.5, gC * 0.9, fill: g[2])
          rect(g[0] + gC * 4.4, gY - gH - gC * 0.9, gC * 1.5, gC * 0.9, fill: g[2])
          rect(g[0] + gC * 3.5, gY - gH - gC * 0.5, gC * 1.0, gC * 0.5, fill: alpha(#ffffff, 0.70))
        }
      }

      // glass rim and highlight
      arc(cx, cy, R * 0.88, 200, 55, stroke: alpha(#ffffff, 0.16), width: R * 0.045, cap: round)
      circle(cx, cy, R, stroke: alpha(#eafcff, 0.55), width: 2.4)

      // ---------- base ----------
      path([[cx - R * 0.72, bT], [cx + R * 0.72, bT], [cx + R * 0.84, bT + R * 0.36], [cx - R * 0.84, bT + R * 0.36]], closed: true, fill: linear(0, bT, 0, bT + R * 0.36, [#c14a3a, #7a241f, #4a100c]))
      rect(cx - R * 0.76, bT - R * 0.03, R * 1.52, R * 0.10, radius: R * 0.05, fill: linear(0, bT - R * 0.03, 0, bT + R * 0.07, [#ffe9a8, #ffd166, #c9982c]))
      rect(cx - R * 0.34, bT + R * 0.10, R * 0.68, R * 0.15, radius: R * 0.03, fill: alpha(#3a0f0b, 0.45))
      for i in range(7) {
        circle(cx - R * 0.58 + i * R * 0.193, bT + R * 0.29, R * 0.012, fill: alpha(bulbColors[i % 5], 0.85))
      }
      }
  }

  // ================= COMPACT TILE =================
  Box {
    fill: true
    radius: 8 * corners
    background: linear(0, 0, 0, 1, [#0d1b3a, #231a46, #3a1530])
    clip: true
    onTap: screen()

    Canvas {
      fill: true
      let W = width
      let H = height
      let R = min(W * 0.30, H * 0.40)
      let cx = W * 0.27
      let cy = H * 0.472

      // colourful halo
      circle(cx, cy, R * 1.50, fill: radial(cx, cy, R * 1.50, [alpha(#ffd166, 0.14), alpha(#f72585, 0.12), alpha(#4cc9f0, 0)]))
      // shadow under the base
      scale(1, 0.20, cx, cy + R * 1.30) {
        circle(cx, cy + R * 1.30, R * 0.88, fill: radial(cx, cy + R * 1.30, R * 0.88, [alpha(#000000, 0.42), alpha(#000000, 0)]))
      }

      // glass
      circle(cx, cy, R, fill: radial(cx - R * 0.18, cy - R * 0.22, R * 1.15, [alpha(#eaf9ff, 0.24), alpha(#8ecae6, 0.12), alpha(#2a1a4a, 0.34)]))

      clip(cx - R, cy - R, R * 2, R * 2) {
        circle(cx, cy, R, fill: linear(0, cy - R, 0, cy + R, [alpha(#0f3358, 0.76), alpha(#2a1b52, 0.64), alpha(#6b1f4a, 0.58)]))

        // distant pixel mountains, matching the full-screen scene
        let tFar = range(20).map(k => [cx + R * (-0.92 + k * 0.098), cy + R * 0.30 - R * 0.06 * floor(max(0, max(0.34 - abs(-0.92 + k * 0.098 + 0.50) * 0.70, max(0.50 - abs(-0.92 + k * 0.098 - 0.10) * 0.80, 0.30 - abs(-0.92 + k * 0.098 - 0.66) * 0.65))) / 0.06)])
        let tFarPath = [[cx - R * 0.80, cy + R * 0.48]] + tFar + [[cx + R * 0.80, cy + R * 0.48]]
        path(tFarPath, closed: true, fill: #cfe0f5)
        translate(0, R * 0.055) { path(tFarPath, closed: true, fill: #7c97c0) }
        translate(0, R * 0.125) { path(tFarPath, closed: true, fill: #2c4670) }

        // falling snow, same flakes as the full-screen globe; snow lying on the ground is
        // part of it, so only what is in the air or on the glass is drawn. In the widget
        // (tile) form the snowballs are smaller than in the fullscreen mode.
        for f in flakes {
          if !(f.s && f.y >= 0.20 + 0.22 * f.x * f.x - 0.02) {
            circle(cx + f.x * R, cy + f.y * R, f.ph < 2.5 ? f.f * 0.1 * 0.55 * R : f.f * 0.16 * 0.55 * R, fill: alpha(#ffffff, 0.90))
          }
        }

        // snow drift, inscribed in the glass
        let arcT = range(9).map(i => [cx + cos(rad(25 + i * 16.25)) * (R - 1), cy + sin(rad(25 + i * 16.25)) * (R - 1)])
        path([[cx - R * 0.906, cy + R * 0.423], [cx - R * 0.30, cy + R * 0.20], [cx + R * 0.30, cy + R * 0.22], [cx + R * 0.906, cy + R * 0.423]] + arcT, closed: true, fill: linear(0, cy + R * 0.18, 0, cy + R, [#f2faff, #cfe6f7, #a9cde3]))

        // pixel-art trees: stepped rows, alternating greens, square lights
        // left
        let t1A = cx - R * 0.41
        let t1B = cy + R * 0.30
        rect(t1A - R * 0.016, t1B, R * 0.032, R * 0.036, fill: #5d3524)
        for k in range(4) {
          let ty = t1B - R * 0.085 * (k + 1)
          let thw = R * 0.150 * (1 - 0.88 * k / 4)
          rect(t1A - thw, ty, thw * 2, R * 0.085, fill: k % 2 == 0 ? #2f9e63 : #268a56)
          rect(t1A + thw * 0.30, ty, thw * 0.70, R * 0.085, fill: alpha(#145c39, 0.42))
        }

        // middle
        let t2B = cy + R * 0.31
        rect(cx - R * 0.018, t2B, R * 0.036, R * 0.040, fill: #5d3524)
        for k in range(5) {
          let ty = t2B - R * 0.088 * (k + 1)
          let thw = R * 0.170 * (1 - 0.88 * k / 5)
          rect(cx - thw, ty, thw * 2, R * 0.088, fill: k % 2 == 0 ? #3aa76c : #2f9e63)
          rect(cx + thw * 0.30, ty, thw * 0.70, R * 0.088, fill: alpha(#145c39, 0.40))
        }

        // right
        let t3A = cx + R * 0.41
        let t3B = cy + R * 0.30
        rect(t3A - R * 0.015, t3B, R * 0.030, R * 0.034, fill: #5d3524)
        for k in range(4) {
          let ty = t3B - R * 0.078 * (k + 1)
          let thw = R * 0.160 * (1 - 0.88 * k / 4)
          rect(t3A - thw, ty, thw * 2, R * 0.078, fill: k % 2 == 0 ? #2f9e63 : #268a56)
          rect(t3A + thw * 0.30, ty, thw * 0.70, R * 0.078, fill: alpha(#145c39, 0.42))
        }

        // star on the middle tree
        let sy = cy - R * 0.17
        circle(cx, sy, R * 0.10, fill: radial(cx, sy, R * 0.10, [alpha(#ffd166, 0.55), alpha(#ffb703, 0)]))
        path([[cx, sy - R * 0.058], [cx + R * 0.016, sy - R * 0.016], [cx + R * 0.058, sy], [cx + R * 0.016, sy + R * 0.016], [cx, sy + R * 0.058], [cx - R * 0.016, sy + R * 0.016], [cx - R * 0.058, sy], [cx - R * 0.016, sy - R * 0.016]], closed: true, fill: #ffd166)

        // warm coloured lights on the trees (square pixels, like the pixel art)
        circle(cx - R * 0.41, cy + R * 0.10, R * 0.070, fill: radial(cx - R * 0.41, cy + R * 0.10, R * 0.070, [alpha(#ff4d6d, 0.30), alpha(#ff4d6d, 0)]))
        rect(cx - R * 0.41 - R * 0.028, cy + R * 0.10 - R * 0.028, R * 0.056, R * 0.056, fill: #ff4d6d)
        circle(cx - R * 0.05, cy + R * 0.13, R * 0.070, fill: radial(cx - R * 0.05, cy + R * 0.13, R * 0.070, [alpha(#7ae582, 0.30), alpha(#7ae582, 0)]))
        rect(cx - R * 0.05 - R * 0.026, cy + R * 0.13 - R * 0.026, R * 0.052, R * 0.052, fill: #7ae582)
        circle(cx + R * 0.36, cy + R * 0.10, R * 0.065, fill: radial(cx + R * 0.36, cy + R * 0.10, R * 0.065, [alpha(#ffd166, 0.30), alpha(#ffd166, 0)]))
        rect(cx + R * 0.36 - R * 0.025, cy + R * 0.10 - R * 0.025, R * 0.050, R * 0.050, fill: #ffd166)
        circle(cx + R * 0.44, cy + R * 0.20, R * 0.060, fill: radial(cx + R * 0.44, cy + R * 0.20, R * 0.060, [alpha(#4cc9f0, 0.30), alpha(#4cc9f0, 0)]))
        rect(cx + R * 0.44 - R * 0.024, cy + R * 0.20 - R * 0.024, R * 0.048, R * 0.048, fill: #4cc9f0)
        rect(cx + R * 0.05 - R * 0.020, cy + R * 0.24 - R * 0.020, R * 0.040, R * 0.040, fill: #f72585)
      }

      // glass rim
      circle(cx, cy, R, stroke: alpha(#eafcff, 0.62), width: 1.6)

      // base
      let bT = cy + R * 0.88
      path([[cx - R * 0.66, bT], [cx + R * 0.66, bT], [cx + R * 0.76, bT + R * 0.26], [cx - R * 0.76, bT + R * 0.26]], closed: true, fill: linear(0, bT, 0, bT + R * 0.26, [#c14a3a, #7a241f, #4e120e]))
      rect(cx - R * 0.70, bT - R * 0.035, R * 1.40, R * 0.085, radius: R * 0.04, fill: linear(0, bT - R * 0.035, 0, bT + R * 0.05, [#ffe9a8, #ffd166, #c9982c]))

      // countdown
      let tx = W * 0.735
      let numSize = (daysLeft ?? 0) >= 100 ? H * 0.235 : H * 0.295
      if xmasDay {
        text("Merry", tx, H * 0.44, size: H * 0.135, align: center, color: #ffe9b0, bold: true)
        text("Christmas!", tx, H * 0.645, size: H * 0.105, align: center, color: #ffe9b0, bold: true)
      } else {
        text(bigNum, tx, H * 0.43, size: numSize, align: center, color: #ffe9b0, bold: true)
        text("days", tx, H * 0.645, size: H * 0.110, align: center, color: #9be7c4)
        text("to christmas", tx, H * 0.795, size: H * 0.082, align: center, color: alpha(#8ecae6, 0.95))
      }

      // expand control (drawn, no font glyph)
      let ex = W - 8
      let ey = 8
      let es = 3.2
      circle(ex, ey, 6, fill: alpha(#000000, 0.32), stroke: alpha(#ffffff, 0.38), width: 1)
      line(ex - es, ey - es + 2, ex - es, ey - es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex - es, ey - es, ex - es + 2, ey - es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex + es, ey - es + 2, ex + es, ey - es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex + es, ey - es, ex + es - 2, ey - es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex - es, ey + es - 2, ex - es, ey + es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex - es, ey + es, ex - es + 2, ey + es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex + es, ey + es - 2, ex + es, ey + es, stroke: #ffffff, width: 1.4, cap: round)
      line(ex + es, ey + es, ex + es - 2, ey + es, stroke: #ffffff, width: 1.4, cap: round)
    }
  }

  // ================= FULL SCREEN =================
  screen {
    title: "christmas snow globe"

    Box {
      fill: true
      background: linear(0, 0, 0, 1, [#0b1d3a, #16264f, #2a1a4a, #120f26])

      if land {
        // ---------- landscape: globe on the left, words on the right ----------
        Row {
          fill: true
          align: center
          justify: center
          padding: [14, 14]
          gap: 22

          Box {
            width: gW
            fill: height
            ChristmasGlobe { rf: 0.40 }
          }

          Column {
            width: tW
            fill: height
            justify: center
            gap: 12

            Column {
              gap: 2
              Text { text: "Christmas Snow Globe"; fontSize: 21; fontWeight: 700; color: #fff4d6; maxLines: 2 }
              Text { text: tilted ? "tilt to swirl the snow" : "no motion sensor — gentle snowfall"; fontSize: 12; color: alpha(#cfe6f5, 0.95); maxLines: 2 }
            }

            Row {
              fill: width
              align: center
              gap: 10
              padding: [12, 10]
              radius: 14 * corners
              background: alpha(#2a1f52, 0.75)
              border: 1
              borderColor: alpha(#ffd166, 0.34)
              Column {
                weight: 1
                gap: 1
                Text { text: "countdown"; style: label; color: alpha(#ffd166, 0.95) }
                Text { text: countdown; fontSize: 17; fontWeight: 700; color: #fff4d6; maxLines: 1 }
              }
              Text { text: target == null ? "…" : fmtTime(target, "d MMM"); style: small; color: alpha(#9be7c4, 0.95) }
            }

            Row {
              fill: width
              gap: 10
              Box {
                weight: 1
                height: 48
                align: center
                radius: 12 * corners
                background: alpha(#ffd166, 0.16)
                border: 1
                borderColor: alpha(#ffd166, 0.55)
                onTap: {
                  shake = 1
                  kick = 1.4
                  haptic()
                }
                Text { text: "shake"; align: center; fontSize: 16; fontWeight: 600; color: #ffe9b0 }
              }
              Box {
                weight: 1
                height: 48
                align: center
                radius: 12 * corners
                background: alpha(#ffffff, 0.08)
                border: 1
                borderColor: alpha(#ffffff, 0.24)
                onTap: close()
                Text { text: "close"; align: center; fontSize: 16; fontWeight: 600; color: #e6f2fb }
              }
            }
          }
        }
      } else {
        // ---------- portrait ----------
        Column {
          fill: true
          justify: center
          padding: [18, 20, 18, 20]
          gap: 16

          Column {
            gap: 3
            Text { text: "Christmas Snow Globe"; fontSize: 23; fontWeight: 700; color: #fff4d6 }
            Text {
              text: tilted ? "tilt your phone to swirl the snow" : "no motion sensor — gentle snowfall instead"
              fontSize: 13
              color: alpha(#cfe6f5, 0.95)
            }
          }

          Box {
            fill: width
            height: min(pW * 1.10, max(SH - 274, 120))
            ChristmasGlobe { rf: 0.39 }
          }

          // countdown card
          Row {
            fill: width
            align: center
            gap: 10
            padding: [16, 12]
            radius: 16 * corners
            background: alpha(#2a1f52, 0.72)
            border: 1
            borderColor: alpha(#ffd166, 0.34)
            Column {
              weight: 1
              gap: 1
              Text { text: "countdown"; style: label; color: alpha(#ffd166, 0.95) }
              Text { text: countdown; fontSize: 18; fontWeight: 700; color: #fff4d6 }
            }
            Text { text: target == null ? "…" : fmtTime(target, "d MMM"); style: small; color: alpha(#9be7c4, 0.95) }
          }

          // controls
          Row {
            fill: width
            gap: 12
            Box {
              weight: 1
              height: 54
              align: center
              radius: 14 * corners
              background: alpha(#ffd166, 0.16)
              border: 1
              borderColor: alpha(#ffd166, 0.55)
              onTap: {
                shake = 1
                kick = 1.4
                haptic()
              }
              Text { text: "shake"; align: center; fontSize: 17; fontWeight: 600; color: #ffe9b0 }
            }
            Box {
              weight: 1
              height: 54
              align: center
              radius: 14 * corners
              background: alpha(#ffffff, 0.08)
              border: 1
              borderColor: alpha(#ffffff, 0.24)
              onTap: close()
              Text { text: "close"; align: center; fontSize: 17; fontWeight: 600; color: #e6f2fb }
            }
          }
        }
      }
    }
  }
}
