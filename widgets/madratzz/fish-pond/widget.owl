widget "fish pond" {
  meta { description: "A clownfish and a goldfish under moving water in a painted pond, with refraction, ripples and weather. Tap the water to feed them"; version: "1.2"; license: "MIT"; category: "fun"; owl: 10 }
  page: 3
  order: 1
  size: 6x3
  minSize: 2x2
  padding: 0
  // No tile background: the water itself is see-through, so the wallpaper shows a little.
  background: alpha(background, 0)

  // Koi in theme colors. A Canvas keeps nothing between frames, so every koi
  // is a function of the pond's clock: the head swims a path, and the body is
  // drawn where the head was a moment ago, as one smooth outline round that
  // spine.
  //
  // Tap the water to feed them. Each tap drops a handful of pellets, and up
  // to three handfuls float at once: a tap with three still uneaten does
  // nothing until the koi finish one. A tap stores each koi's body and speed
  // as they are, and works out a route from there through every handful
  // with food left for it, nearest first, the way a fish would swim it: turn
  // in an arc from where it's facing, swim straight, and slip onto a circle
  // round the food. After a while it leaves along that circle the same way,
  // for the next handful or, with all eaten, its home loop. Another tap
  // starts a new route from wherever it is.
  state fedAt = -100
  state fromK = []
  state plan = []
  // The handfuls in the water, oldest first: where and when each hit, and
  // its pellets. Each pellet floats at [x, y] from `land`, and is eaten at
  // `eat`, worked out at the last tap (null while it waits for a plan).
  state drops = []

  // The pond's own clock, for everything that swims, floats or drifts: the
  // phone's clock, so the koi keep swimming while their page is away and are
  // wherever they've got to when it's back, already there in the first frame,
  // with nothing jumping after.
  //
  // `time`, the tile's frame clock, is smooth, but stands still while the
  // page is off screen and starts again from 0 when it's back. So on screen
  // the pond is `time` plus `off`. Ticks bring the phone's clock (`lastE`)
  // once a second from `wall`, in whole seconds. They keep coming while a page next to this
  // one shows, and stop further away. A tick that finds `time` where the last
  // left it, a while later, means the page is away. Back, from its very first
  // frame, the pond runs from the last tick's clock, and the next tick keeps
  // it there, as `off`: the pond may run a fraction of a second behind the
  // phone, which nobody can see, but never jumps. Only a clock over 2 s out
  // is caught up with: none came while away, as when the screen was off, so
  // the first frames back showed the koi where they were. They catch up by
  // swimming at most about a fifth faster for a while, too little to see (`fix`,
  // eased out from `fixAt` over `fixFor` seconds), on up to 10 s; the rest,
  // `lag`, the pond just runs behind the phone's clock, rather than rush.
  source wall = clock every 1s
  state off = null
  state fix = 0
  state fixAt = 0
  state fixFor = 1.5
  state lag = 0
  state ranFor = 0
  state tickE = 0
  state lastE = 0
  state away = false
  // The water's own clock, for the shaders: it only runs on screen and goes
  // on where it left off, in small numbers, as the GPU wants them. Past
  // about six hours it starts again from 0 while away, where it can't show.
  state sOff = 0
  on wall first {
    let E = value + 0.5
    if off != null && time == ranFor && E - tickE > 0.6 {
      away = true
    } else {
      if off == null || away || time < ranFor {
        let el = time < ranFor ? time : time - ranFor
        off = (lastE > 0 ? lastE : (wall ?? 0) + 0.5) + 0.05 - lag + el - time
        sOff = (sOff + ranFor > 20000 ? 0 : sOff + ranFor) + el - time
        fix = 0
        away = false
      }
      if abs(E - lag - time - off) > 2 {
        let shown = off + fix * (1 - pow(clamp((time - fixAt) / fixFor, 0, 1), 2) * (3 - 2 * clamp((time - fixAt) / fixFor, 0, 1)))
        let keep = clamp(E - lag - time - shown, -10, 10)
        lag = E - time - shown - keep
        off = shown + keep
        fix = -keep
        fixAt = time
        fixFor = max(abs(keep) / 0.15, 1.5)
      }
      if time != ranFor { tickE = E }
      ranFor = time
    }
    lastE = max(lastE, E)
  }
  let back = off == null || away || time < ranFor
  let elapsed = time < ranFor ? time : time - ranFor
  let pondTime = back ? (lastE > 0 ? lastE : (wall ?? 0) + 0.5) + 0.05 - lag + elapsed :
    [clamp((time - fixAt) / fixFor, 0, 1)].map(u => off + time + fix * (1 - u * u * (3 - 2 * u)))[0]
  let waterTime = back ? (sOff + ranFor > 20000 ? 0 : sOff + ranFor) + elapsed : sOff + time

  // The time of day, from the phone's clock, colours the pond: cool blue at
  // night, soft rose and gold in the morning, sunlight shimmering at the
  // afternoon's peak and warm orange dusk in the evening. `hr` is the hour
  // with minutes as a fraction, 0 to 24. `owl-send … set previewHour 14`
  // shows another hour for a look; -1 goes back to the clock.
  source now = clock every 1m
  state previewHour = -1
  let hr = previewHour >= 0 ? previewHour : num(fmtTime(now, "H"), 12) + num(fmtTime(now, "m"), 0) / 60
  // [hour, phase] keyframes, phases 0 night, 1 morning, 2 afternoon, 3
  // evening; between two the look eases from one to the next.
  let keys = [[0, 0], [4.3, 0], [5.7, 1], [11.3, 1], [12.7, 2], [16.3, 2], [17.7, 3], [19.4, 3], [20.6, 0], [24, 0]]
  let seg = clamp(count(keys, k => k[0] <= hr) - 1, 0, len(keys) - 2)
  let ku = [clamp((hr - keys[seg][0]) / (keys[seg + 1][0] - keys[seg][0]), 0, 1)].map(u => u * u * (3 - 2 * u))[0]
  let wts = range(4).map(i => (keys[seg][1] == i ? 1 - ku : 0) + (keys[seg + 1][1] == i ? ku : 0))
  let phase = hr >= 5 && hr < 12 ? "morning" : hr >= 12 && hr < 17 ? "afternoon" : hr >= 17 && hr < 20 ? "evening" : "night"

  // The weather where the phone is, over the time of day. wttr.in finds the
  // place by the phone's IP and says what the sky is doing; Open-Meteo adds
  // the air (smog and dust) and the wind's gusts there. Clouds dull the sun,
  // hide the stars and drift their shadows and reflections over the pond;
  // fog whitens it and haze browns it; rain, sleet, hail and snow fall into
  // it; wind roughens it in gusts and blows leaves across; a storm throws
  // lightning; heat makes it shimmer, frost creeps in from the edges, and a
  // sun shower brings a rainbow. `owl-send … set previewWeather storm` shows
  // clear, partly, cloudy, fog, haze, smog, dust, drizzle, showers, rain,
  // downpour, storm, sleet, hail, snow, blizzard, windy, hot or frost for a
  // look; "" goes back to the forecast.
  // `owl-send … set place "Lahore"` fixes the place (a city, or "lat,lon"),
  // for when the IP is somewhere else, like on a VPN; "" finds it by IP again.
  state place = "" persist
  state previewWeather = ""
  source wx = http("https://wttr.in/${enc(place)}?format=j2") every 30m timeout 10s json
  let cur = wx.current_condition[0]
  let area = wx.nearest_area[0]
  let lat = area.latitude
  let lon = area.longitude
  source air = http(lat == null ? null : "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${enc(lat)}&longitude=${enc(lon)}&current=pm2_5,dust") every 30m timeout 10s json
  source met = http(lat == null ? null : "https://api.open-meteo.com/v1/forecast?latitude=${enc(lat)}&longitude=${enc(lon)}&current=wind_gusts_10m,visibility") every 30m timeout 10s json
  let pv = previewWeather
  let live = pv == ""
  let code = num(cur.weatherCode, 0)
  let desc = lower(cur.weatherDesc[0].value ?? "")
  let sky = !live ? pv : cur == null ? null :
    contains([200, 386, 389, 392, 395], code) ? "storm" :
    contains([350, 374, 377], code) ? "hail" :
    contains([179, 227, 230, 323, 326, 329, 332, 335, 338, 368, 371], code) ? (contains([227, 230], code) ? "blizzard" : "snow") :
    contains([182, 185, 281, 284, 311, 314, 317, 320, 362, 365], code) ? "sleet" :
    contains([305, 308, 359], code) ? "downpour" :
    contains([299, 302, 356], code) ? "rain" :
    contains([176, 263, 266, 293, 296, 353], code) ? (num(cur.cloudcover, 100) < 70 ? "showers" : "drizzle") :
    contains(desc, "dust") || contains(desc, "sand") ? "dust" :
    contains(desc, "smoke") || contains(desc, "haze") ? "haze" :
    contains([143, 248, 260], code) ? "fog" :
    contains([119, 122], code) ? "cloudy" : code == 116 ? "partly" : "clear"
  let s0 = sky ?? ""
  // How much of each, 0 to 1
  let clouds = max(live ? num(cur.cloudcover, 0) / 100 : 0,
    get({partly: 0.4, cloudy: 0.85, fog: 0.7, drizzle: 0.8, showers: 0.45, rain: 0.9, downpour: 1, storm: 1, sleet: 0.9, hail: 0.95, snow: 0.85, blizzard: 1}, s0) ?? 0)
  let rain = get({drizzle: 0.3, showers: 0.35, rain: 0.6, downpour: 0.9, storm: 1, sleet: 0.45, hail: 0.3}, s0) ?? 0
  let snow = get({snow: 0.8, blizzard: 1, sleet: 0.35}, s0) ?? 0
  let hail = get({hail: 1, storm: code == 395 || code == 392 ? 0.4 : 0}, s0) ?? 0
  let fog = get({fog: 1, drizzle: 0.2, downpour: 0.15, blizzard: 0.3}, s0) ?? 0
  let storm = s0 == "storm" ? 1 : 0
  let pm = num(air.current.pm2_5, 0)
  let dustAir = num(air.current.dust, 0)
  let seeKm = num(met.current.visibility, 20000) / 1000
  // Smog, dust or haze, from the air itself and from how far one can see
  let haze = !live ? (get({haze: 0.55, smog: 0.75, dust: 0.75}, s0) ?? 0) :
    max(get({haze: 0.6, dust: 0.7}, s0) ?? 0, clamp((pm - 25) / 90, 0, 1), clamp((dustAir - 40) / 200, 0, 1),
      fog > 0 || rain > 0 || snow > 0 ? 0 : clamp((6 - seeKm) / 6, 0, 0.7))
  let dusty = s0 == "dust" || dustAir > max(pm, 60)
  let gusts = num(met.current.wind_gusts_10m, 0)
  let wind = !live ? (get({storm: 0.9, downpour: 0.6, rain: 0.4, blizzard: 1, windy: 0.85, dust: 0.6, hail: 0.6}, s0) ?? 0.15) :
    clamp(max(num(cur.windspeedKmph, 8) / 40, gusts / 65), 0, 1)
  // Gusts come and go: how gusty, beyond the steady wind
  let gust = clamp(live ? (gusts - num(cur.windspeedKmph, 0)) / 30 : wind - 0.3, 0, 1)
  // Where the wind blows to, as [x, y] on the tile (north up): wttr gives where it comes from
  let windTo = [rad(num(cur.winddirDegree, 250) + 180)].map(b => [sin(b), -cos(b)])[0]
  let tempC = num(cur.temp_C, 20)
  let heat = pv == "hot" ? 1 : live ? clamp((tempC - 33) / 8, 0, 1) : 0
  let frost = pv == "frost" ? 1 : live ? clamp(-tempC / 4 + 0.25, 0, 1) : (snow > 0 ? 0.5 : 0)
  // A rainbow in a sun shower, by day
  let bow = (s0 == "showers" ? 1 : 0) * (1 - wts[0])
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value ?? "")))
  let temp = live ? get(cur, imperial ? "temp_F" : "temp_C") : null
  let skyWord = (sky == "clear" || sky == "partly") && haze > 0.35 ? (dusty ? "dust" : pm > 55 ? "smog" : "haze") :
    sky == "partly" ? "partly cloudy" : sky == "clear" && hr >= 6 && hr < 18 ? "sunny" : sky
  let windWord = wind >= 0.55 && !contains(["storm", "blizzard", "windy"], s0) ? " · windy" : ""
  let label = sky == null ? phase : temp == null ? "${phase} · ${skyWord}${windWord}" : "${phase} · ${temp}° ${skyWord}${windWord}"
  // Lightning: in some six-second windows a flash and a flicker after it,
  // `flashT` seconds since it struck
  let flashK = floor(pondTime / 6)
  let flashOn = storm > 0 && hash(flashK, 77) > 0.4
  let flashT = pondTime - flashK * 6 - hash(flashK, 77) * 4
  let flash = flashOn && flashT > 0 ? pow(2.718, -flashT * 7) * 0.55 + 0.35 * pow(2.718, -abs(flashT - 0.28) * 30) : 0
  // [night, morning, afternoon, evening] → the blend now, of numbers or of
  // [r, g, b] colours.
  let todN = ns => sum(range(4).map(i => ns[i] * wts[i]))
  let todC = cs => rgb(sum(range(4).map(i => cs[i][0] * wts[i])), sum(range(4).map(i => cs[i][1] * wts[i])), sum(range(4).map(i => cs[i][2] * wts[i])))
  // The water's own colour
  let todWater = [[[18, 42, 120], [150, 205, 225], [70, 225, 235], [196, 104, 58]]].map(todC)[0]
  // The light on the floor and the surface: moonlight, peach, sun, amber
  let todLight = [[[140, 175, 255], [255, 214, 196], [255, 250, 214], [255, 158, 70]]].map(todC)[0]
  // The light on the floor, as a tint over the sand and pebbles
  let todFloor = [[[95, 125, 205], [255, 236, 222], [255, 255, 240], [250, 170, 110]]].map(todC)[0]
  // A veil over everything, and how strong it is
  let clearVeil = [[[8, 20, 70], [255, 196, 178], [235, 255, 250], [235, 92, 30]]].map(todC)[0]
  // Clouds grey it (slate by day, near black at night), fog whitens it
  // Clouds grey it (slate by day, near black at night), fog whitens it,
  // haze browns it (ochre for dust), heat warms it
  let hazeCol = dusty ? mix(rgb(205, 160, 95), rgb(60, 45, 30), wts[0]) : mix(rgb(190, 172, 140), rgb(52, 48, 44), wts[0])
  let todVeil = mix(mix(mix(mix(clearVeil, rgb(255, 196, 130), 0.45 * heat), mix(rgb(120, 128, 140), rgb(14, 18, 30), wts[0]), 0.65 * clouds), hazeCol, 0.75 * haze), mix(rgb(222, 228, 234), rgb(70, 80, 100), wts[0]), 0.8 * fog)
  let todVeilA = [[0.38, 0.2, 0.14, 0.2]].map(todN)[0] + 0.12 * clouds + 0.06 * rain + 0.32 * fog + 0.3 * haze + 0.1 * heat
  // The sun's (or moon's) glow: where it is, as fractions of the tile, its
  // colour and strength
  // The moon's reflection crosses the pond through the night, rising from
  // the left at 20:00 and setting on the right at 5:00, as fractions of the tile.
  let moonProg = clamp((hr >= 12 ? hr - 20 : hr + 4) / 9, 0, 1)
  let moonAt = [0.16 + 0.68 * moonProg, 0.66 - 0.3 * sin(moonProg * rad(180))]
  let todGlowAt = [[moonAt, [0.1, 0.05], [0.5, -0.15], [1.0, 0.25]]].map(g => [[g.map(q => q[0])].map(todN)[0], [g.map(q => q[1])].map(todN)[0]])[0]
  // Through haze the sun turns a dim orange
  let todGlow = mix([[[170, 200, 255], [255, 200, 150], [255, 248, 210], [255, 120, 40]]].map(todC)[0], rgb(255, 140, 60), 0.6 * haze)
  let todGlowA = [[0.22, 0.4, 0.5, 0.5]].map(todN)[0] * (1 - 0.8 * clouds) * (1 - 0.35 * haze)
  // Sparkles and glints on the surface, peaking at two in the afternoon
  let todShimmer = ([[0.35, 0.7, 1.3, 0.8]].map(todN)[0] + 0.9 * clamp(1 - abs(hr - 14) / 3, 0, 1)) * (1 - 0.8 * clouds) * (1 - 0.5 * haze) + 0.8 * heat
  // How bright the floor is lit, how clear and bright the water's own colour
  // shows over it, and how much of it there is
  let todLift = [[1.0, 1.3, 1.45, 1.1]].map(todN)[0] * (1 - 0.2 * clouds)
  let todDeep = [[0.55, 0.85, 0.95, 0.65]].map(todN)[0]
  let todDepth = [[0.3, 0.42, 0.45, 0.35]].map(todN)[0]
  // How much the water hides the wallpaper: more at night, so it's deep blue
  let waterOpacity = [[0.72, 0.68, 0.7, 0.6]].map(todN)[0]

  // Paths are in fractions of the tile: x = sin(t), y = cos(ratio * t + ph).
  // `spots` are [segment, side] pairs that get a patch in `spot`.
  // The fish: where each swims (as fractions of the tile, x = sin(t),
  // y = cos(ratio * t + ph)) and how each looks. `n` is how many spine points
  // the body uses, `shape` its half-width at each in units of p, and `bands`
  // the spine stretches a clownfish's white bands cover.
  let koi = [
    {cx: 0.46, cy: 0.50, rx: 0.32, ry: 0.30, ratio: 1, ph: 0.3, speed: 0.22, dir: 1, kind: "clown", n: 12,
     body: mix(orange, red, 0.12), shape: [2.7, 3.4, 3.7, 3.8, 3.7, 3.5, 3.1, 2.6, 2.0, 1.5, 1.1, 0.9], bands: [[1, 2], [5, 6], [9, 10]]},
    {cx: 0.50, cy: 0.48, rx: 0.38, ry: 0.36, ratio: 1, ph: -0.4, speed: 0.18, dir: -1, kind: "gold", n: 13,
     body: mix(yellow, orange, 0.45), shape: [2.5, 3.2, 3.6, 3.7, 3.6, 3.4, 3.0, 2.6, 2.1, 1.6, 1.2, 0.9, 0.7], bands: []}
  ]
  // Body segments, head first; the spine has one point more than this.
  let profile = [2, 3, 3, 3, 3, 3, 3, 2, 2, 2, 1, 1, 1, 1, 0]

  // Seconds since the last tap. A tap that seems to be in the future was
  // really long ago, before the launcher last started, and its food long gone.
  let stale = pondTime < fedAt
  let since = stale ? 1000 : pondTime - fedAt
  // The handfuls with their ages, and how many still have a pellet afloat.
  let water = stale ? [] : drops.map(d => merge(d, {age: pondTime - d.at}))
  let afloat = count(water, d => any(d.pel, q => q.eat == null ? pondTime < q.land + 9 : q.eat > pondTime))

  // The drawing's unit, in dp, from the tile's size. With no padding the
  // Canvas is the whole tile.
  let p = clamp(min(tileWidth ?? 300, tileHeight ?? 200) / 70, 2, 5)
  // The koi are worked out here rather than in the Canvas, because onTap
  // stores how they are at the tap. The Canvas fills the tile.
  let W = tileWidth ?? 300
  let H = tileHeight ?? 200
  // Body segments are this far apart, in dp.
  let ds = 1.5 * p
  let turn = 2 * rad(180)

  // Lambdas in lets can't be called directly, only passed to map and friends,
  // so they take one list of arguments.

  // Each koi's home loop and its circle round the food, in dp. `s2` is which
  // way round the food it swims: 1 turns from x towards y.
  let rig = koi.map((f, i) => [(12 + i * 6) * p].map(fr => {
    i: i, f: f, fr: fr, s2: -f.dir, cx: f.cx * W, cy: f.cy * H, rx: f.rx * W, ry: f.ry * H
  })[0])

  // [rig, angle] → the home loop there as [x, y], and which way it runs, per
  // unit of angle: [dx, dy].
  let homeAt = v => [
    v[0].cx + v[0].rx * sin(v[1]), v[0].cy + v[0].ry * cos(v[0].f.ratio * v[1] + v[0].f.ph),
    v[0].f.dir * v[0].rx * cos(v[1]), -v[0].f.dir * v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * v[1] + v[0].f.ph)
  ]

  // Idle, the body is just the loop: step back along it directly, by the
  // loop's speed halfway back, so the body keeps its length where the loop
  // speeds up or slows down. From [rig, angle offset].
  let loop = v => [v[0].f.ph + v[0].f.dir * pondTime * v[0].f.speed + v[1]]
    .map(th => range(len(profile) + 1).map(k => th - v[0].f.dir * k * ds / 2 / max(sqrt(pow(v[0].rx * cos(th), 2) + pow(v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * th + v[0].f.ph), 2)), 1))
      .map((m, k) => th - v[0].f.dir * k * ds / max(sqrt(pow(v[0].rx * cos(m), 2) + pow(v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * m + v[0].f.ph), 2)), 1))
      .map(t => [[v[0], t]].map(homeAt)[0]))[0]

  // [point, centre, angle] → the point turned about the centre.
  let spin = v => [
    v[1][0] + (v[0][0] - v[1][0]) * cos(v[2]) - (v[0][1] - v[1][1]) * sin(v[2]),
    v[1][1] + (v[0][0] - v[1][0]) * sin(v[2]) + (v[0][1] - v[1][1]) * cos(v[2])
  ]

  // A route: from [point, heading, s1, R, centre, s2, r] turn s1 on a circle of
  // radius R, then swim straight and join the circle of radius r round the
  // centre, going s2 (1 or -1) round it. The straight runs along u, from t1 on
  // the first circle to t2 on the second; phi is the turn before it. `ok` is
  // false when the two circles are too close for one.
  let route = v => [[v[0][0] - v[2] * v[3] * v[1][1], v[0][1] + v[2] * v[3] * v[1][0]]]
    // [first centre, dx, dy, k] between the centres
    .map(c => [c, v[4][0] - c[0], v[4][1] - c[1], v[5] * v[6] - v[2] * v[3]])
    // [.., distance², straight length]
    .map(w => [w[0], w[1], w[2], w[3], max(w[1] * w[1] + w[2] * w[2], 0.001), sqrt(max(w[1] * w[1] + w[2] * w[2] - w[3] * w[3], 0))])
    .map(w => [w, [(w[5] * w[1] + w[3] * w[2]) / w[4], (w[5] * w[2] - w[3] * w[1]) / w[4]]])
    .map(w => [w[0], w[1], v[2] * (atan2(w[1][1], w[1][0]) - atan2(v[1][1], v[1][0]))])
    .map(w => [w[0], w[1], w[2] - turn * floor(w[2] / turn)])
    .map(w => {
      ok: w[0][4] > pow(abs(w[0][3]) + 0.01, 2),
      a: v[0], s1: v[2], R: v[3], c1: w[0][0], phi: w[2], u: w[1], lam: w[0][5],
      t1: [w[0][0][0] + v[2] * v[3] * w[1][1], w[0][0][1] - v[2] * v[3] * w[1][0]],
      c2: v[4], s2: v[5], r2: v[6],
      t2: [v[4][0] + v[5] * v[6] * w[1][1], v[4][1] - v[5] * v[6] * w[1][0]],
      len: v[3] * w[2] + w[0][5]
    })[0]

  // [route, distance along it] → [x, y]. Past the straight it carries on round
  // the second circle.
  let along = v => v[1] < v[0].R * v[0].phi ? [[v[0].a, v[0].c1, v[0].s1 * v[1] / v[0].R]].map(spin)[0] :
    v[1] < v[0].R * v[0].phi + v[0].lam ? [v[0].t1[0] + v[0].u[0] * (v[1] - v[0].R * v[0].phi), v[0].t1[1] + v[0].u[1] * (v[1] - v[0].R * v[0].phi)] :
    [[v[0].t2, v[0].c2, v[0].s2 * (v[1] - v[0].R * v[0].phi - v[0].lam) / v[0].r2]].map(spin)[0]

  // [route, its length, start, speed at the start, speed at the end] → a leg:
  // the route swum from time t0, taking T seconds. The distance swum eases
  // from one speed to the other, so it neither jerks off nor brakes hard.
  let legOf = v => [clamp(v[1] / (20 * p), 0.8, 5)].map(T => {
    c: v[0], S: max(v[1], 0.001), t0: v[2], T: T,
    m0: clamp(v[3] * T / max(v[1], 0.001), 0, 3), m1: clamp(v[4] * T / max(v[1], 0.001), 0, 3)
  })[0]
  // [leg, tau] → how far along it the koi is at time tau.
  let swum = v => [clamp((v[1] - v[0].t0) / v[0].T, 0, 1)]
    .map(g => v[0].S * (3 * g * g - 2 * g * g * g + v[0].m0 * (g * g * g - 2 * g * g + g) + v[0].m1 * (g * g * g - g * g)))[0]

  // Each koi's trip since the last tap: a list of `stops`, one per handful,
  // each swum to along `go`, circled from `arr` and left at `tl`; then
  // `back` home from `last`, and the home loop from `ret`, shifted by `dh`
  // so it joins where it arrives. onTap works these out and keeps them in
  // `plan`, so the frames after a tap don't have to.
  let trips = rig.map(r => [fromK[r.i]].map(k => k == null ? {r: r, stops: [], dh: 0} :
    // Where the head was at the tap, and which way it faced
    [[[k.body[0][0], k.body[0][1]], k.body[0][0] - k.body[1][0], k.body[0][1] - k.body[1][1]]]
      .map(h => [h[0], [h[1] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001), h[2] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001)]])
      // The handfuls with pellets waiting for this koi, their centres kept
      // far enough from the edges to circle
      .map(h => [h, drops.filter(d => any(d.pel, q => q.k == r.i && q.eat == null))
        .map(d => {at: d.at, c: [clamp(d.x, r.fr + 4 * p, W - r.fr - 4 * p), clamp(d.y, r.fr + 4 * p, H - r.fr - 4 * p)]})])
      // One stop at a time, from where the last left off: the nearest
      // handful left, by the shortest route there, turning as tightly as the
      // koi can (7 px) unless the food is so close that it needs a wider
      // turn. With no route (it's already circling there) it just carries on round.
      .map(h => range(len(h[1])).reduce((a, n) =>
        [a.left.sortBy(d => pow(d.c[0] - a.pt[0], 2) + pow(d.c[1] - a.pt[1], 2))]
          .map(o => [o[0], o.drop(1), flatten([7, 12, 20, 30].map(m => [1, -1].map(s1 => [a.pt, a.hd, s1, m * p, o[0].c, r.s2, r.fr]))).map(route)
            .filter(c => c.ok).sortBy(c => c.len + c.R)])
          .map(o => [o[0], o[1], len(o[2]) == 0 ? null : [[o[2][0], o[2][0].len, a.t, a.v, r.fr * r.f.speed]].map(legOf)[0]])
          // [handful, rest, go, arrival, where it joins the circle]
          .map(o => [o[0], o[1], o[2], a.t + (o[2] == null ? 0 : o[2].T), o[2] == null ? a.pt : o[2].c.t2])
          .map(o => [o, {at: o[0].at, fx: o[0].c[0], fy: o[0].c[1], go: o[2], arr: o[3], tl: o[3] + 4 + r.i * 0.6,
            dl: atan2(o[4][0] - o[0].c[0], o[4][1] - o[0].c[1]) - r.f.dir * r.f.speed * o[3]}])
          // Leaving: the angle round the food, and the point and heading there
          .map(w => [w[0], w[1], w[1].dl + r.f.dir * r.f.speed * w[1].tl])
          .map(w => {pt: [w[1].fx + r.fr * sin(w[2]), w[1].fy + r.fr * cos(w[2])], hd: [r.f.dir * cos(w[2]), -r.f.dir * sin(w[2])],
            t: w[1].tl, v: r.fr * r.f.speed, left: w[0][1], stops: a.stops + [w[1]]})[0],
        {pt: h[0][0], hd: h[0][1], t: fedAt, v: k.speed, left: h[1], stops: []}))
      .map(a => len(a.stops) == 0 ? {r: r, stops: [], dh: 0} : [a]
        // Home: the shortest route to any of 24 points on the loop, ending on a
        // turn that lines up with it there. [route, loop angle, speed, length]
        .map(a => [a, flatten(range(24).map(j => [j * turn / 24, [[r, j * turn / 24]].map(homeAt)[0]])
          .map(q => [q[0], q[1], sqrt(q[1][2] * q[1][2] + q[1][3] * q[1][3])])
          .map(q => [q[0], q[1], [q[1][2] / q[2], q[1][3] / q[2]], q[2]])
          .map(q => [1, -1].map(s3 => [1, -1].map(s1 => [a.pt, a.hd, s1, 7 * p, [q[1][0] - s3 * 7 * p * q[2][1], q[1][1] + s3 * 7 * p * q[2][0]], s3, 7 * p])
            .map(route).filter(c => c.ok)
            .map(c => [c, q[0], q[3] * r.f.speed, c.len + 7 * p * [s3 * (atan2(q[2][1], q[2][0]) - atan2(c.u[1], c.u[0]))].map(x => x - turn * floor(x / turn))[0]]))))
          .map(q => flatten(q)).sortBy(q => q[3])[0]])
        .map(w => [w[0], [[w[1][0], w[1][3], w[0].t, w[0].v, w[1][2]]].map(legOf)[0], w[1][1]])
        .map(w => {
          r: r, stops: w[0].stops, last: w[0].t, back: w[1], ret: w[0].t + w[1].T,
          dh: w[2] - r.f.ph - r.f.dir * r.f.speed * (w[0].t + w[1].T)
        })[0])[0])[0])

  // [trip, tau] → the head at time tau, as [x, y]: at the first stop not yet
  // left, swimming there or round it, or with all left, on the way home.
  let headAt = v => len(v[0].stops) == 0 || v[1] >= v[0].ret ? [[v[0].r, v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[1] + v[0].dh]].map(homeAt)[0] :
    [v[0].stops.filter(s => v[1] < s.tl)].map(l => len(l) == 0 ? [[v[0].back, v[1]]].map(swum).map(s => [v[0].back.c, s]).map(along)[0] :
      v[1] < l[0].arr && l[0].go != null ? [[l[0].go, v[1]]].map(swum).map(s => [l[0].go.c, s]).map(along)[0] :
      [l[0].dl + v[0].r.f.dir * v[0].r.f.speed * v[1]].map(th => [l[0].fx + v[0].r.fr * sin(th), l[0].fy + v[0].r.fr * cos(th)])[0])[0]

  // [trip, tau] → how far the head has swum since the tap: each leg there
  // and each circle so far, the way home, and along the home loop its speed
  // summed with Simpson's rule, close enough for the few seconds the body
  // takes to follow it there.
  let odometer = v => sum(v[0].stops.map(s => (s.go == null ? 0 : [[s.go, v[1]]].map(swum)[0]) + v[0].r.fr * v[0].r.f.speed * clamp(v[1] - s.arr, 0, s.tl - s.arr)))
    + [[v[0].back, v[1]]].map(swum)[0]
    + (v[1] < v[0].ret ? 0 : [[v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[0].ret + v[0].dh, v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[1] + v[0].dh]]
      .map(a => [a[0], (a[0] + a[1]) / 2, a[1]].map(th => [[v[0].r, th]].map(homeAt)[0]).map(q => sqrt(q[2] * q[2] + q[3] * q[3])))
      .map(q => v[0].r.f.speed * (v[1] - v[0].ret) / 6 * (q[0] + 4 * q[1] + q[2]))[0])

  // The trips planned at the last tap. Before any, and on the home loop, the
  // loop follows the tile's size now.
  let live = rig.map((r, i) => stale ? {r: r, stops: [], dh: plan[i].dh ?? 0} : plan[i] ?? {r: r, stops: [], dh: 0})

  // Feeding, the body lies along the head's path, a segment's length apart:
  // find when the head was each distance back, between 16 samples of the
  // odometer, and put the segment where the head was then. Further back than
  // the tap it lies along the body as it was at the tap. Once it's all back on
  // the home loop, the idle body takes over.
  let bodies = live.map((t, i) => len(t.stops) == 0 || pondTime > t.ret + 6 ? [[rig[i], t.dh]].map(loop)[0] :
    [range(17).map(j => pondTime - j * min(since, 25) / 16)]
      .map(ts => [ts, ts.map(tau => [t, tau]).map(odometer)])
      .map(w => [w[0], w[1].map(o => w[1][0] - o)])
      .map(w => range(len(profile) + 1).map(k => k * ds >= w[1][16] ?
          [clamp((k * ds - w[1][16]) / ds, 0, len(profile) - 0.001)]
            .map(x => [fromK[i].body[floor(x)], fromK[i].body[floor(x) + 1], x - floor(x)])
            .map(q => [lerp(q[0][0], q[1][0], q[2]), lerp(q[0][1], q[1][1], q[2])])[0] :
          [clamp(count(w[1], o => o <= k * ds) - 1, 0, 15)]
            .map(j => [[t, lerp(w[0][j], w[0][j + 1], clamp((k * ds - w[1][j]) / max(w[1][j + 1] - w[1][j], 0.001), 0, 1))]].map(headAt)[0])[0]))[0])

  // The food: each pellet as stored, with its handful `d` and its koi's trip
  // `t`. It's eaten at the moment planned for it, where the koi's mouth is
  // then: just ahead of the head, along the way it's swimming. One eaten
  // under an earlier plan keeps where that was; one with no plan drifts
  // apart and sinks. Gone ones are left out, and the mouth is only looked
  // for while it matters: from the drift towards it to the end of the gulp.
  let pellets = flatten(water.map(d => d.pel.filter(q => q.eat == null ? pondTime < q.land + 9 : pondTime < q.eat + 1.4).map(q => merge(q, {d: d, t: live[q.k]}))))
    .map(q => merge(q, {to: q.eat == null ? [q.x + (q.x - q.d.x) * 1.5, q.y + (q.y - q.d.y) * 1.5] : q.eat < fedAt ? [q.tox, q.toy] : pondTime < q.eat - 3.1 ? [q.x, q.y] :
      [[[q.t, q.eat], [q.t, q.eat + 0.05]].map(headAt)]
        .map(h => [h[0], h[1][0] - h[0][0], h[1][1] - h[0][1]])
        .map(h => [h[0][0] + h[1] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001) * 2.8 * p, h[0][1] + h[2] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001) * 2.8 * p])[0]}))
  // Each pellet now: where it floats, how big and how solid, and whether
  // it's still there. A fresh one falls in from where the tap hit; afloat it
  // bobs, and in its last three seconds drifts, slowly and then sucked in, to
  // where it's eaten.
  let pelletsNow = pellets.map(q => [[clamp((pondTime - q.from) / max(q.land - q.from, 0.001), 0, 1),
      [max(q.land, (q.eat ?? q.land + 9) - 3)].map(s0 => pow(clamp((pondTime - s0) / max((q.eat ?? q.land + 9) - s0, 0.001), 0, 1), 3))[0]]].map(u => merge(q, {
    x: pondTime < q.land ? lerp(q.sx, q.x, u[0]) : lerp(q.x, q.to[0], u[1]) + (1 - u[1]) * 0.2 * p * sin(pondTime * 2.1 + q.j),
    y: pondTime < q.land ? lerp(q.sy, q.y, u[0]) : lerp(q.y, q.to[1], u[1]) + (1 - u[1]) * 0.2 * p * cos(pondTime * 1.7 + q.j * 2),
    s: q.size * (pondTime < q.land ? 1.8 - 0.8 * u[0] : 1 + 0.06 * sin(pondTime * 3 + q.j)) * (q.eat == null ? 1 : 1 - 0.35 * clamp((pondTime - q.eat + 0.15) / 0.15, 0, 1)),
    o: q.eat == null ? clamp((q.land + 9 - pondTime) / 3, 0, 1) : 1,
    up: pondTime < (q.eat ?? q.land + 9)
  }))[0])
  // How wide each koi's mouth is open: it opens as a pellet comes in, and snaps shut on it.
  let bites = range(2).map(k => pellets.filter(q => q.k == k && q.eat != null)
    .map(q => pondTime - q.eat).map(d => d > -0.35 && d < 0.2 ? sin((d + 0.35) / 0.55 * rad(180)) : 0)
    .reduce((a, b) => max(a, b), 0))
  // How eager each koi is: beating its tail hard on each rush to food,
  // calmer round it, settling down on the way home.
  let excite = live.map(t => len(t.stops) == 0 || pondTime > t.ret ? 0 : clamp(since / 0.4, 0, 1) *
    [t.stops.filter(s => pondTime < s.tl)].map(l => len(l) == 0 ? 0.65 * clamp(1 - (pondTime - t.last) / max(t.ret - t.last, 0.1), 0, 1) :
      1 - 0.35 * clamp((pondTime - l[0].arr + 0.5) / 1, 0, 1))[0])

  // Lily pads, painted: a slightly uneven disc with its notch, in flat
  // light and shade. [x, y, radius] as fractions of the tile, the notch's
  // angle, and whether a lotus flower sits on it.
  let pads = [
    {x: 0.66, y: 0.36, r: 0.13, notch: 39, flower: false},
    {x: 0.88, y: 0.76, r: 0.09, notch: 215, flower: true}
  ]
  let padShapes = pads.map((pd, i) => [pd.r * min(tileWidth ?? 300, tileHeight ?? 200)].map(R => {
    // Kept clear of the tile's edges, whatever its shape
    x: clamp(pd.x * (tileWidth ?? 300), R * 1.3, (tileWidth ?? 300) - R * 1.3), y: clamp(pd.y * (tileHeight ?? 200), R * 1.3, (tileHeight ?? 200) - R * 1.3), R: R, i: i, flower: pd.flower,
    // The outline, relative to the centre: round from just past the notch, wobbling like a brush edge, and back in
    pts: range(49).map(j => rad(pd.notch + 8 + j * 344 / 48)).map(a => [R * (1 + 0.03 * sin(a * 5 + i * 2) + 0.015 * sin(a * 11)), a])
      .map(v => [v[0] * cos(v[1]), v[0] * sin(v[1])]) + [[0, 0]],
    veins: [55, 105, 160, 215, 270, 320].map(d => rad(pd.notch + d))
  })[0])
  let padMid = mix(mix(green, yellow, 0.25), background, 0.12)
  let padDark = mix(padMid, rgb(12, 40, 32), 0.4)
  let padLight = mix(padMid, rgb(255, 250, 210), 0.35)
  let petalPts = range(7).map(u => [sin(u / 6 * rad(180)) * 0.32, -u / 6]) + range(5, 0, -1).map(u => [-sin(u / 6 * rad(180)) * 0.32, -u / 6])
  // Water weed on the floor, seen from above: clumps of ribbons streaming
  // from a root in the current. [x, y] of the root as fractions of the tile,
  // how many ribbons, their length as a fraction of the tile's height, and
  // which way they stream (degrees, 0 is right, turning down).
  let clumps = [[0.08, 0.84, 6, 0.32, -25], [0.93, 0.86, 5, 0.3, 205], [0.36, 0.92, 4, 0.22, -70], [0.94, 0.36, 4, 0.24, 165]]
  // The water's colour over things on the floor, as the floor shader blends it
  let underwater = mix(todWater, rgb(0, 0, 0), 0.45)
  // Each clump's root and ribbons, with all that doesn't move worked out here
  // once rather than every frame: the root in dp, and each ribbon's
  // direction, length, half-width and colour.
  let weeds = clumps.map((cl, ci) => {rx: cl[0] * W, ry: cl[1] * H, ribbons: range(cl[2]).map(j =>
    [rad(cl[4] + (j - (cl[2] - 1) / 2) * 16 + (hash(ci, j) - 0.5) * 10)].map(a => {
      ph: j * 1.7 + ci, dx: cos(a), dy: sin(a),
      len: cl[3] * 1.3 * min(W, H) * (0.65 + 0.35 * hash(j, ci)),
      w: (0.75 + 0.3 * hash(ci, j, 1)) * p,
      col: mix(j % 2 == 0 ? mix(green, background, 0.25) : mix(mix(green, yellow, 0.35), background, 0.2), underwater, 0.35)
    })[0])})
  // How wide a ribbon is at each of its six spine points, root to tip
  let taper = [1, 1, 1, 1, 0.72, 0]
  let shadowCol = alpha(mix(background, rgb(0, 0, 0), 0.6), 0.35)

  // Ripples spread from a tap at this speed (dp/s) for this long; the shader
  // uses the same numbers, so the fish bend exactly where its rings pass.
  let rippleSpeed = 55
  let rippleLife = 6
  // The handfuls whose ring is still spreading, found once a frame rather
  // than in every one of the hundreds of points `wob` moves.
  let ripples = water.filter(d => d.age < rippleLife)
  // [x, y] → where it looks from above, through the water: a slow wobble, and
  // a push outwards where the tap's ring is passing.
  let wob = q => [ripples
    .map(d => [d, sqrt(pow(q[0] - d.x, 2) + pow(q[1] - d.y, 2))])
    .map(v => [v[1] - v[0].age * rippleSpeed].map(x => sin(x * 0.45) * pow(2.718, -x * x / 140) * (1 - v[0].age / rippleLife) * 1.4 * p / max(v[1], 1))
      .map(k => [k * (q[0] - v[0].x), k * (q[1] - v[0].y)])[0])]
    .map(ps => [
      q[0] + 0.45 * p * sin(pondTime * 1.7 + q[1] * 0.07) + sum(ps.map(v => v[0])),
      q[1] + 0.45 * p * cos(pondTime * 1.3 + q[0] * 0.06) + sum(ps.map(v => v[1]))
    ])[0]

  // The water's surface, shared by both shaders: its slope `g` at q (dp),
  // summed from a slow swell, rings from the last five taps, wakes behind both
  // heads and now and then a raindrop.
  let waves = """
    uniform float pt;
    uniform float2 dims;
    uniform float speed;
    uniform float life;
    uniform float3 r0;
    uniform float3 r1;
    uniform float3 r2;
    uniform float3 r3;
    uniform float3 r4;
    uniform float2 h0;
    uniform float2 h1;
    uniform half4 light;
    uniform float shimmer;
    uniform float rain;
    uniform float wind;
    uniform float gust;
    uniform float2 windTo;

    float2 hash2(float2 c) {
      return fract(sin(float2(dot(c, float2(127.1, 311.7)), dot(c, float2(269.5, 183.3)))) * 43758.5453);
    }
    // The slope of a ring ripple of radius r round c
    float2 ring(float2 q, float2 c, float r, float amp) {
      float2 d = q - c;
      float l = length(d) + 0.001;
      float x = l - r;
      return d / l * sin(x * 0.45) * exp(-x * x / 140.0) * amp;
    }
    // The slope of the little waves a swimming head pushes out
    float2 wake(float2 q, float2 h) {
      float2 d = q - h;
      float l = length(d) + 0.001;
      return d / l * sin(l * 0.32 - pt * 7.0) * exp(-l / 20.0) * 1.3;
    }
    float2 slope(float2 q) {
      float t = pt;
      // The swell: six waves from directions a golden angle apart, with
      // unrelated lengths and speeds, so their crests never line up into a
      // grid, over a slow warp that bends them and drifts about
      float2 w = q + 16.0 * float2(sin(q.y * 0.012 + t * 0.13 + sin(q.x * 0.007)), sin(q.x * 0.010 - t * 0.11 + sin(q.y * 0.009)));
      float2 g = float2(0.0);
      for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float2 dir = float2(cos(fi * 2.39996 + 0.4), sin(fi * 2.39996 + 0.4));
        float k = 0.032 * (1.0 + fi * 0.29 + 0.13 * sin(fi * 3.7));
        g += dir * cos(dot(dir, w) * k - t * (0.55 + 0.21 * fi) + fi * 1.9) * 0.26 * (1.0 + 1.6 * wind) / (1.0 + fi * 0.3);
      }
      // The last five taps: [x, y, age]
      if (r0.z < life) { g += ring(q, r0.xy, r0.z * speed, 5.0 * (1.0 - r0.z / life)); }
      if (r1.z < life) { g += ring(q, r1.xy, r1.z * speed, 5.0 * (1.0 - r1.z / life)); }
      if (r2.z < life) { g += ring(q, r2.xy, r2.z * speed, 5.0 * (1.0 - r2.z / life)); }
      if (r3.z < life) { g += ring(q, r3.xy, r3.z * speed, 5.0 * (1.0 - r3.z / life)); }
      if (r4.z < life) { g += ring(q, r4.xy, r4.z * speed, 5.0 * (1.0 - r4.z / life)); }
      g += wake(q, h0) + wake(q, h1);
      // Cat's-paws: patches of fine ripples a gust drags across the pond
      if (gust > 0.0) {
        float2 side = float2(-windTo.y, windTo.x);
        float along = dot(q, windTo) * 0.012 - t * (0.5 + 0.5 * wind);
        float m = smoothstep(0.35, 0.95, sin(along) * sin(dot(q, side) * 0.017 + sin(along * 0.7) * 1.5));
        g += float2(sin(dot(q, windTo) * 0.32 - t * 6.0), cos(dot(q, side) * 0.27 + t * 5.0)) * m * gust * 0.6;
      }
      // Raindrops: a few now and then in fair weather, many in rain, each
      // ring smaller and quicker the harder it falls
      float n = rain > 0.0 ? 4.0 + 20.0 * rain : 3.0;
      float every = 5.0 - 3.4 * rain;
      for (int i = 0; i < 24; i++) {
        float fi = float(i);
        if (fi >= n) { break; }
        float ph = t / every + fi / n;
        float a = fract(ph);
        float2 c = (0.05 + 0.9 * hash2(float2(floor(ph), fi * 7.0))) * dims;
        g += ring(q, c, a * (70.0 - 35.0 * rain), (2.2 - 0.9 * rain) * (1.0 - a));
      }
      return g;
    }
    // Light focused by the waves into a moving net, at floor point f
    float causticAt(float2 f) {
      float2 w = f * 0.035;
      for (int k = 1; k <= 3; k++) {
        float fk = float(k);
        w += float2(sin(w.y * 1.7 + pt * 0.7 * fk), cos(w.x * 1.5 - pt * 0.6 * fk)) * 0.6 / fk;
      }
      return pow(1.0 - abs(sin(w.x * 2.0) + sin(w.y * 2.0)) * 0.5, 6.0);
    }
    // Glints where the surface tilts towards the light
    float glint(float2 g) {
      float3 n = normalize(float3(-g * 0.35, 1.0));
      return pow(max(dot(n, normalize(float3(-0.5, -0.7, 1.0))), 0.0), 60.0) * shimmer;
    }
    // Sun sparkles: points on a jittered grid that flash now and then, each a
    // little cross of light, brighter where the surface tilts to the light
    float sparkle(float2 q, float2 g) {
      float2 c = floor(q / 14.0);
      float2 h = hash2(c);
      float2 d = q - (c + 0.2 + 0.6 * h) * 14.0 + g * 1.5;
      float tw = pow(max(sin(pt * (1.5 + 2.0 * h.x) + h.y * 6.283), 0.0), 24.0);
      float star = exp(-dot(d, d) / 1.2) + 0.6 * exp(-abs(d.x) * 1.4 - d.y * d.y * 2.0) + 0.6 * exp(-abs(d.y) * 1.4 - d.x * d.x * 2.0);
      return star * tw * shimmer;
    }
  """
  // The last five handfuls, newest first, as [x, y, age]
  let rings = range(5).map(i => len(water) > i ? [num(water[len(water) - 1 - i].x, 0), num(water[len(water) - 1 - i].y, 0), min(num(water[len(water) - 1 - i].age, 99), 99)] : [0, 0, 99])
  let waterUniforms = {
    pt: waterTime, dims: [W, H], speed: rippleSpeed, life: rippleLife,
    r0: rings[0], r1: rings[1], r2: rings[2], r3: rings[3], r4: rings[4],
    h0: [num(bodies[0][0][0], -999), num(bodies[0][0][1], -999)], h1: [num(bodies[1][0][0], -999), num(bodies[1][0][1], -999)],
    light: todLight, shimmer: todShimmer, rain: rain + 0.2 * snow + 0.3 * hail, wind: wind, gust: gust, windTo: windTo
  }

  Box {
    fill: true
    clip: true
    radius: 8 * corners

    // Feeding is on the Box, so the surface layer on top doesn't take the tap.
    onTap: {
      // Three handfuls afloat is the most: until one's eaten, a tap does nothing.
      if afloat < 3 {
        // Before anything changes: bodies, speeds and pellets read the plan
        // as it is. Each head's speed in dp/s, over the last tenth of a
        // second, is only needed here, so it's worked out here.
        let speeds = live.map(t => [[t, pondTime], [t, pondTime - 0.1]].map(headAt))
          .map(q => sqrt(pow(q[0][0] - q[1][0], 2) + pow(q[0][1] - q[1][1], 2)) / 0.1)
        fromK = bodies.map((b, i) => {body: b, speed: speeds[i]})
        // What's left in the water: pellets still being gulped keep where
        // they went, uneaten ones stay where they float now (or keep
        // falling) and wait for the new plan. Sunk ones, and handfuls with
        // nothing left and their ripple gone, are dropped.
        let kept = water.map(d => {at: d.at, x: d.x, y: d.y, pel: pelletsNow.filter(q => q.d.at == d.at && (q.eat != null || pondTime < q.land + 9))
          .map(q => [{j: q.j, k: q.k, n: q.n, sx: q.sx, sy: q.sy, x: q.x, y: q.y, from: q.from, land: q.land, ld: q.ld, size: q.size, col: q.col, eat: q.eat, tox: q.to[0], toy: q.to[1]}]
            .map(e => q.eat != null && q.eat <= pondTime ? e : pondTime < q.land ? merge(e, {x: q.d.pel.find(o => o.j == q.j).x, y: q.d.pel.find(o => o.j == q.j).y, eat: null}) :
              merge(e, {sx: q.x, sy: q.y, from: pondTime, land: pondTime, eat: null}))[0])})
          .filter(d => d.at > pondTime - 8 || len(d.pel) > 0)
        // A new handful: pellets scattered from the tap, a different scatter
        // each time, falling in over the first half second.
        let fresh = {at: pondTime, x: x, y: y, pel: range(7).map(j => [[hash(pondTime, j, 1) * turn, (1 + 3.2 * hash(pondTime, j, 2)) * p, pondTime + 0.12 + 0.05 * j + 0.1 * hash(pondTime, j, 3)]]
          .map(v => {j: j, k: j % 2, n: floor(j / 2), sx: x, sy: y, x: x + cos(v[0]) * v[1], y: y + sin(v[0]) * v[1], from: pondTime, land: v[2], ld: v[2],
            size: (0.75 + 0.3 * hash(pondTime, j, 5)) * p, col: mix(mix(mix(orange, red, 0.3), yellow, hash(pondTime, j, 6) * 0.6), rgb(90, 50, 20), 0.15),
            eat: null, tox: 0, toy: 0})[0])}
        drops = kept + [fresh]
        fedAt = pondTime
        plan = trips
        // Each waiting pellet is eaten at a moment spread through its koi's
        // time round its handful.
        drops = drops.map(d => merge(d, {pel: d.pel.map(q => q.eat != null ? q : [plan[q.k].stops.filter(s => s.at == d.at)]
          .map(l => len(l) == 0 ? q : merge(q, {eat: max(q.land + 0.2, l[0].arr + 0.3 + (l[0].tl - l[0].arr - 0.6) * (q.n + 0.4 + 0.2 * hash(d.at, q.j, 4)) / (q.k == 0 ? 4 : 3))}))[0])}))
      }
    }

    // The pond floor, painted: warm sand with rounded pebbles in flat light
    // and shade, dappled sunlight and crisp caustics, all seen through the
    // surface, sampled where the bent ray lands (refraction).
    Shader {
      fill: true
      fallback: alpha(mix(background, cyan, 0.15), waterOpacity)
      uniforms: merge(waterUniforms, {
        sand: mix(mix(yellow, foreground, 0.3), background, 0.45), slate: mix(mix(blue, foreground, 0.2), background, 0.45),
        moss: mix(green, background, 0.4), warm: mix(orange, background, 0.5), water: todWater, tint: todFloor, lift: todLift, deep: todDeep, depth0: todDepth, opacity: waterOpacity
      })
      code: waves + """
        uniform half4 sand;
        uniform half4 slate;
        uniform half4 moss;
        uniform half4 warm;
        uniform half4 water;
        uniform half4 tint;
        uniform float lift;
        uniform float deep;
        uniform float depth0;
        uniform float opacity;

        half4 main(float2 px) {
          float2 q = px / size * dims;
          float2 g = slope(q);
          float2 f = q + g * 5.0;
          float t = pt;

          // Sand, with faint ripples in it
          float3 col = float3(sand.rgb) * (0.93 + 0.07 * sin(f.x * 0.16 + sin(f.y * 0.09) * 2.0));

          // Pebbles: some cells of a jittered grid hold one, a rounded blob in
          // three flat tones (lit from the top left), with a dark rim and a
          // contact shadow on the sand below right.
          float2 cell = floor(f / 26.0);
          float2 fr = f / 26.0 - cell;
          for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
              float2 c = cell + float2(float(x), float(y));
              float2 h = hash2(c);
              if (h.x > 0.42) {
                float r = 0.24 + 0.2 * h.y;
                float2 rel = (fr - float2(float(x), float(y)) - (0.25 + 0.5 * hash2(c + 7.0))) / r;
                rel.y *= 1.0 + 0.35 * (h.x - 0.6);
                float d = length(rel);
                float ds = length(rel - float2(0.18, 0.22));
                if (d >= 1.0 && ds < 1.05) { col *= 0.78; }
                if (d < 1.0) {
                  float pick = fract(h.x * 13.0 + h.y * 7.0);
                  float3 base = pick < 0.4 ? float3(slate.rgb) : pick < 0.75 ? float3(moss.rgb) : float3(warm.rgb);
                  float lit = dot(rel, float2(-0.6, -0.8)) + (1.0 - d) * 0.6;
                  float3 pc = lit > 0.55 ? mix(base, float3(1.0, 0.98, 0.9), 0.28) : lit > -0.25 ? base : base * 0.72;
                  if (d > 0.9) { pc = base * 0.55; }
                  col = pc;
                }
              }
            }
          }

          // Dappled sunlight through leaves overhead, soft-edged but flat
          float dap = sin(q.x * 0.021 + t * 0.12 + sin(q.y * 0.017) * 1.5) * sin(q.y * 0.027 - t * 0.09 + sin(q.x * 0.013) * 1.2);
          col *= 0.9 + 0.22 * shimmer * smoothstep(0.22, 0.32, dap);
          // Lit by the pt of day
          col *= float3(tint.rgb) * lift;

          // Crisp caustic lines
          col += float3(light.rgb) * smoothstep(0.5, 0.62, causticAt(f)) * 0.18;

          // The water's colour over it, deeper towards the edges
          float2 uv = px / size;
          float depth = depth0 + 0.25 * length(uv - 0.5);
          col = mix(col, float3(water.rgb) * deep, depth);
          col += float3(light.rgb) * glint(g) * 0.35;
          // Premultiplied: see-through by `opacity`
          return half4(half3(col) * opacity, opacity);
        }
      """
    }

  Canvas {
    fill: true

    clip(0, 0, width, height) {
      // The floating pellets' shadows on the floor, further off than the koi's
      // as they're up on the surface
      for q in pelletsNow {
        if q.up && pondTime >= q.land {
          circle(q.x + 2.4 * p, q.y + 3.6 * p, q.s * 1.2, fill: alpha(shadowCol, 0.35 * q.o))
        }
      }

      // Water weed: ribbons streaming from each root and waving in the
      // current, tinted by the water like the floor, seen through the surface.
      for cl in weeds {
        let rx = cl.rx
        let ry = cl.ry
        // A soft, dark patch where the clump is rooted
        circle(rx, ry, 5 * p, fill: radial(rx, ry, 5 * p, [alpha(mix(mix(green, background, 0.5), underwater, 0.4), 0.45), alpha(background, 0)]))
        for rb in cl.ribbons {
          let dx = rb.dx
          let dy = rb.dy
          // The spine: out along the ribbon's direction, swinging side to side
          // more towards the tip, as a wave runs down it, seen through the
          // surface. The edges are drawn round the moved spine, so only its
          // six points go through `wob`.
          let spine = range(6).map(t => [t / 5 * rb.len, sin(pondTime * 1.3 + rb.ph - t * 1.08) * t * 0.576 * p])
            .map(v => [rx + dx * v[0] - dy * v[1], ry + dy * v[0] + dx * v[1]]).map(wob)
          let sideA = range(6).map(t => [spine[t][0] - dy * rb.w * taper[t], spine[t][1] + dx * rb.w * taper[t]])
          let sideB = range(6).map(t => [spine[t][0] + dy * rb.w * taper[t], spine[t][1] - dx * rb.w * taper[t]])
          // Fading in from the root, so it grows out of the floor
          path(sideA + reverse(sideB), closed: true, fill: linear(rx, ry, rx + dx * rb.len * 0.3, ry + dy * rb.len * 0.3, [alpha(rb.col, 0), alpha(rb.col, 0.85)]))
          // A lighter vein down the middle, flat like the rest of the painting
          path(range(2, 5).map(t => spine[t]), stroke: alpha(mix(rb.col, rgb(255, 255, 220), 0.3), 0.45), width: 0.25 * p, cap: round)
        }
      }

      for f, i in koi {
        let n = f.n
        let body = bodies[i].take(n)
        let sh = f.shape
        // Tail and fins beat harder and faster when it's eager for food
        let sway = sin(pondTime * 4 + i * 2) + excite[i] * 0.55 * sin(pondTime * 10 + i)
        let ink = rgb(30, 24, 22)
        // Heading at each spine point, from its neighbours, as a unit [x, y]
        let dirs = range(n)
          .map(k => [body[max(k - 1, 0)][0] - body[min(k + 1, n - 1)][0], body[max(k - 1, 0)][1] - body[min(k + 1, n - 1)][1]])
          .map(d => [d, max(sqrt(d[0] * d[0] + d[1] * d[1]), 0.001)])
          .map(q => [q[0][0] / q[1], q[0][1] / q[1]])
        // The two edges, head to tail, a half-width out along the normal
        let left = range(n).map(k => [body[k][0] - dirs[k][1] * sh[k] * p, body[k][1] + dirs[k][0] * sh[k] * p])
        let right = range(n).map(k => [body[k][0] + dirs[k][1] * sh[k] * p, body[k][1] - dirs[k][0] * sh[k] * p])
        // A rounded snout from the left edge, round the front, to the right
        let cap = range(1, 8).map(j => rad(90 - j * 22.5)).map(a => [
          body[0][0] + (dirs[0][0] * cos(a) - dirs[0][1] * sin(a)) * sh[0] * p * (1 + 0.12 * cos(a)),
          body[0][1] + (dirs[0][1] * cos(a) + dirs[0][0] * sin(a)) * sh[0] * p * (1 + 0.12 * cos(a))
        ])
        let outline = (reverse(left) + cap + right).map(wob)
        let tail = body[n - 1]
        let td = dirs[n - 1]
        let tn = [-td[1], td[0]]
        // [back, out] from the tail's root, in units of p → the tile
        let atTail = q => [tail[0] - td[0] * q[0] * p + tn[0] * q[1] * p, tail[1] - td[1] * q[0] * p + tn[1] * q[1] * p]
        let fin = f.kind == "gold" ? alpha(mix(f.body, rgb(255, 245, 210), 0.3), 0.55) : f.body

        // A soft shadow on the pond floor
        path(outline.map(q => [q[0] + 1.6 * p, q[1] + 2.4 * p]), closed: true, fill: shadowCol)

        if f.kind == "clown" {
          // A rounded fan of a tail with a black rim, flicking with the swim
          let fan = [[0, 1]] + range(9).map(j => rad(70 - j * 17.5)).map(a => [1.2 + 3 * cos(a), 3 * sin(a)]) + [[0, -1]]
          let tailShape = fan.map(q => [q[0], q[1] + sway * q[0] * 0.3]).map(atTail).map(wob)
          path(tailShape, closed: true, fill: f.body)
          path(tailShape, closed: true, stroke: ink, width: 0.6 * p)
        } else {
          // A fancy double tail: two long, see-through lobes that ripple as they trail
          let lobes = [[0, 0.9], [2, 2.6], [4.5, 4.4], [7, 5.6], [9.5, 5.4], [8.3, 3.2], [6.8, 1.1], [7.6, 0], [6.8, -1.1], [8.3, -3.2], [9.5, -5.4], [7, -5.6], [4.5, -4.4], [2, -2.6], [0, -0.9]]
          let tailShape = lobes.map(q => [q[0], q[1] + sway * q[0] * 0.4 + sin(pondTime * 2.6 - q[0] * 0.5) * q[0] * 0.12]).map(atTail).map(wob)
          path(tailShape, closed: true, fill: fin)
          path(tailShape, closed: true, stroke: alpha(f.body, 0.7), width: 0.3 * p)
          for r in [-3.6, -1.8, 1.8, 3.6] {
            path(range(6).map(u => [u * 1.6, r * u / 5 + sway * u * 1.6 * 0.4 + sin(pondTime * 2.6 - u * 0.8) * u * 0.19]).map(atTail).map(wob), stroke: alpha(f.body, 0.45), width: 0.3 * p, cap: round)
          }
        }

        // Pectoral fins: rounded petals swept back from the shoulders, paddling
        for side in [-1, 1] {
          let b = body[2]
          let h = dirs[2]
          let nx = -h[1] * side
          let ny = h[0] * side
          let w = sh[2] * p
          let petal = f.kind == "gold" ?
            [[-0.8, -0.3], [-0.2, 1.4], [0.8, 2.8], [2.2, 3.4], [3.4, 3.0], [3.4, 1.6], [2.2, 0.3], [1.6, -0.3]] :
            [[-0.6, -0.3], [-0.1, 1.1], [0.8, 2.0], [1.9, 2.3], [2.6, 1.8], [2.4, 0.8], [1.6, -0.3]]
          let finShape = petal.map(q => [q[0], q[1] * (1 + 0.22 * sway * side)]).map(q => [b[0] + nx * (w + q[1] * p) - h[0] * q[0] * p, b[1] + ny * (w + q[1] * p) - h[1] * q[0] * p]).map(wob)
          path(finShape, closed: true, fill: fin)
          if f.kind == "clown" {
            path(finShape, closed: true, stroke: ink, width: 0.5 * p)
          }
        }

        path(outline, closed: true, fill: f.body)

        // Flat shade on the side away from the light (top left), from the
        // spine out to the edge. As the fish turns through the light it slides
        // across the spine, narrowing and fading, rather than jumping sides:
        // u runs from -1 (right edge) to 1 (left edge).
        let u = clamp((-dirs[3][1] * 0.6 + dirs[3][0] * 0.8) * 2.5, -1, 1)
        let shadeEdge = range(n).map(k => [body[k][0] + (left[k][0] - body[k][0]) * u, body[k][1] + (left[k][1] - body[k][1]) * u])
        let shadeIn = range(n).map(k => [body[k][0] + (shadeEdge[k][0] - body[k][0]) * 0.35, body[k][1] + (shadeEdge[k][1] - body[k][1]) * 0.35])
        path((shadeEdge + reverse(shadeIn)).map(wob), closed: true, fill: alpha(mix(f.body, rgb(60, 10, 20), 0.6), 0.28 * max(u, -u)))

        // The clownfish's white bands, edged in black, curving round the body
        for bd in f.bands {
          let k1 = bd[0]
          let k2 = min(bd[1], n - 1)
          let bulge1 = [body[k1][0] - dirs[k1][0] * 0.9 * p, body[k1][1] - dirs[k1][1] * 0.9 * p]
          let bulge2 = [body[k2][0] - dirs[k2][0] * 0.9 * p, body[k2][1] - dirs[k2][1] * 0.9 * p]
          let edge1 = [left[k1], bulge1, right[k1]]
          let edge2 = [right[k2], bulge2, left[k2]]
          path((edge1 + range(k1 + 1, k2).map(k => right[k]) + edge2 + range(k2 - 1, k1, -1).map(k => left[k])).map(wob), closed: true, fill: rgb(250, 248, 240))
          path(edge1.map(wob), stroke: ink, width: 0.4 * p, cap: round)
          path(edge2.map(wob), stroke: ink, width: 0.4 * p, cap: round)
        }

        // A painted outline, and light along the back
        path(outline, closed: true, stroke: alpha(mix(f.body, ink, 0.6), 0.6), width: 0.35 * p)
        path(range(1, n - 3).map(k => body[k]).map(wob), stroke: alpha(mix(f.body, rgb(255, 255, 240), 0.6), 0.35), width: 1.4 * p, cap: round)

        // A mouth, opening round a pellet as it's sucked in
        if bites[i] > 0.02 {
          let m = [[body[0][0] + dirs[0][0] * sh[0] * p * 0.95, body[0][1] + dirs[0][1] * sh[0] * p * 0.95]].map(wob)[0]
          circle(m[0], m[1], (f.kind == "gold" ? 0.8 : 0.7) * p * bites[i], fill: alpha(mix(f.body, ink, 0.75), 0.9))
        }

        // Eyes, with a catch of light
        for side in [-1, 1] {
          let h = dirs[0]
          let out = f.kind == "gold" ? 1.9 : 1.6
          let e = [[body[0][0] + h[0] * 0.9 * p - h[1] * side * out * p, body[0][1] + h[1] * 0.9 * p + h[0] * side * out * p]].map(wob)[0]
          if f.kind == "gold" {
            circle(e[0], e[1], 0.95 * p, fill: mix(f.body, rgb(255, 250, 230), 0.3))
          }
          circle(e[0], e[1], 0.6 * p, fill: ink)
          circle(e[0] - 0.2 * p, e[1] - 0.2 * p, 0.2 * p, fill: rgb(255, 255, 255))
        }
      }
    }
  }

    // The surface, over the fish: the same caustics and glints, see-through
    // (premultiplied alpha), so the koi swim under the light, not above it.
    Shader {
      fill: true
      fallback: alpha(background, 0)
      uniforms: merge(waterUniforms, {night: wts[0] * (1 - 0.9 * clouds), moonAt: moonAt})
      code: waves + """
        uniform float night;
        uniform float2 moonAt;

        // Stars mirrored in the water: a few cells of a jittered grid hold
        // one, twinkling, with a faint cross on the brightest
        float stars(float2 r) {
          float2 c = floor(r / 24.0);
          float2 h = hash2(c + 31.0);
          if (h.x < 0.55) { return 0.0; }
          float2 d = r - (c + 0.15 + 0.7 * hash2(c + 3.0)) * 24.0;
          float big = h.y > 0.85 ? 1.0 : 0.0;
          float tw = 0.55 + 0.45 * sin(pt * (0.8 + 2.0 * h.y) + h.x * 40.0);
          float s = 1.4 * exp(-dot(d, d) / (0.9 + 2.2 * big)) + big * 0.5 * (exp(-abs(d.x) * 1.2 - d.y * d.y * 3.0) + exp(-abs(d.y) * 1.6 - d.x * d.x * 3.0));
          return s * tw * (0.5 + 0.5 * h.y);
        }
        // The moon's reflection: a disc broken into wavering slivers by the
        // ripples, a soft halo, and a few loose glints round it
        float moon(float2 r) {
          float R = 0.085 * min(dims.x, dims.y);
          float2 d = r - moonAt * dims;
          float l = length(d * float2(1.0, 1.12));
          float disc = smoothstep(R, R * 0.8, l) * (0.72 + 0.28 * sin(r.y * 0.85 + pt * 1.8 + sin(r.x * 0.2)));
          // A shadowed edge, so it reads as a moon rather than a lamp
          disc *= 1.0 - 0.18 * smoothstep(-0.2, 1.0, dot(d / R, float2(0.6, 0.4)));
          float halo = exp(-l * l / (R * R * 7.0)) * 0.35;
          float bits = smoothstep(0.82, 1.0, sin(r.y * 0.55 + sin(r.x * 0.06 + pt * 0.9) * 2.5 - pt * 1.4)) * smoothstep(0.2, 0.9, sin(r.x * 0.11 + sin(r.y * 0.3) - pt * 0.7)) * exp(-l * l / (R * R * 5.0)) * 0.5;
          return disc * 0.9 + halo + bits;
        }

        half4 main(float2 px) {
          float2 q = px / size * dims;
          float2 g = slope(q);
          float a = clamp(causticAt(q + g * 3.0) * 0.08 * shimmer + glint(g) * 0.3 + sparkle(q, g) * 0.8, 0.0, 0.75);
          // At night, the sky above mirrored in the moving surface
          float2 r = q + g * 2.5;
          float m = night > 0.01 ? clamp((stars(r) * 0.85 + moon(r)) * night, 0.0, 0.95) : 0.0;
          float3 moonlight = float3(0.9, 0.93, 1.0);
          float o = m + a * (1.0 - m);
          return half4(half3(moonlight * m + float3(light.rgb) * a * (1.0 - m)), half(o));
        }
      """
    }

    // The lily pads float on the surface, above everything, drifting and turning a little.
    Canvas {
      fill: true
      let glow = mix(todLight, foreground, 0.3)

      // The food, on the surface, so over the koi. Where each handful hit: a
      // ring spreading and a spray of droplets.
      for d in water {
        if d.age < 3 {
          circle(d.x, d.y, d.age * rippleSpeed, stroke: alpha(glow, 0.35 * (1 - d.age / 3)), width: 0.5 * p)
        }
        if d.age < 0.45 {
          let u = d.age / 0.45
          circle(d.x, d.y, (1.5 + 2.5 * u) * p, fill: alpha(rgb(255, 255, 245), 0.35 * (1 - u)))
          for k in range(8) {
            let da = rad(k * 45 + 360 * hash(d.at, k, 7) / 8)
            let dr = (1.5 + (5 + 3 * hash(d.at, k, 8)) * (1 - pow(1 - u, 2))) * p
            circle(d.x + cos(da) * dr, d.y + sin(da) * dr, 0.45 * p * (1 - u * 0.7), fill: alpha(rgb(255, 255, 250), 0.75 * (1 - u)))
          }
        }
      }

      for q in pelletsNow {
        // A little ring where each lands
        if pondTime >= q.ld && pondTime < q.ld + 0.7 {
          let v = (pondTime - q.ld) / 0.7
          circle(q.x, q.y, (0.8 + 3 * v) * p, stroke: alpha(glow, 0.4 * (1 - v)), width: 0.3 * p)
        }
        if q.up {
          // Afloat: the water drawn up round it, a dark rim and a glint
          if pondTime >= q.land {
            circle(q.x, q.y, q.s * 1.8, stroke: alpha(glow, 0.22 * q.o), width: 0.2 * p)
          }
          circle(q.x, q.y, q.s, fill: alpha(q.col, q.o))
          circle(q.x, q.y, q.s, stroke: alpha(mix(q.col, rgb(40, 20, 10), 0.5), 0.6 * q.o), width: 0.2 * p)
          circle(q.x - q.s * 0.3, q.y - q.s * 0.3, q.s * 0.35, fill: alpha(mix(q.col, rgb(255, 250, 230), 0.6), 0.9 * q.o))
        }
        // Eaten: a ring from the gulp, crumbs flicking out and two bubbles
        if q.eat != null && pondTime >= q.eat && pondTime < q.eat + 1.4 {
          let v = clamp((pondTime - q.eat) / 0.7, 0, 1)
          let b = (pondTime - q.eat) / 1.4
          if v < 1 {
            circle(q.to[0], q.to[1], (1 + 3.5 * v) * p, stroke: alpha(glow, 0.45 * (1 - v)), width: 0.35 * p)
            for c in range(3) {
              let ca = hash(q.d.at, q.j, c, 9) * turn
              circle(q.to[0] + cos(ca) * (0.8 + 2.2 * v) * p, q.to[1] + sin(ca) * (0.8 + 2.2 * v) * p, 0.28 * p * (1 - v), fill: q.col)
            }
          }
          for c in range(2) {
            let bx = q.to[0] + (hash(q.d.at, q.j, c, 10) - 0.5) * 3 * p + sin(pondTime * 5 + c) * 0.3 * p
            let by = q.to[1] + (hash(q.d.at, q.j, c, 11) - 0.5) * 3 * p
            let br = (0.35 + 0.45 * b) * p * (c == 0 ? 1 : 0.7)
            circle(bx, by, br, stroke: alpha(rgb(255, 255, 255), 0.6 * (1 - pow(b, 3))), width: 0.18 * p)
            circle(bx - br * 0.35, by - br * 0.35, br * 0.25, fill: alpha(rgb(255, 255, 255), 0.7 * (1 - pow(b, 3))))
          }
        }
      }

      for pd in padShapes {
        let R = pd.R
        // Wandering very slowly round its spot, a lap every ten minutes or so,
        // with the small bob on top, and kept clear of the tile's edges
        let cx = clamp(pd.x + sin(pondTime * 0.011 + pd.i * 2.6) * 0.08 * W + sin(pondTime * 0.07 + pd.i * 2) * 2 * p, R * 1.2, W - R * 1.2)
        let cy = clamp(pd.y + sin(pondTime * 0.0085 + pd.i * 1.3) * 0.08 * H + cos(pondTime * 0.05 + pd.i) * 0.8 * p, R * 1.2, H - R * 1.2)
        // A ring of disturbed water round it
        circle(cx, cy, R * (1.1 + 0.02 * sin(pondTime * 1.5 + pd.i)), stroke: alpha(rgb(255, 255, 240), 0.18), width: 0.5 * p)
        rotate(sin(pondTime * 0.006 + pd.i * 3) * 30 + sin(pondTime * 0.04 + pd.i) * 4, cx, cy) {
          path(pd.pts.map(q => [cx + q[0] + 1.6 * p, cy + q[1] + 2.6 * p]), closed: true, fill: shadowCol)
          // Shade, then the lit face shifted up and left, leaving a crescent of shade below right
          path(pd.pts.map(q => [cx + q[0], cy + q[1]]), closed: true, fill: padDark)
          path(pd.pts.map(q => [cx + q[0] * 0.9 - R * 0.05, cy + q[1] * 0.9 - R * 0.06]), closed: true, fill: padMid)
          // Brush dabs of light
          path(pd.pts.map(q => [cx + q[0] * 0.28 - R * 0.42, cy + q[1] * 0.2 - R * 0.5]), closed: true, fill: alpha(padLight, 0.8))
          path(pd.pts.map(q => [cx + q[0] * 0.12 - R * 0.62, cy + q[1] * 0.1 - R * 0.2]), closed: true, fill: alpha(padLight, 0.6))
          // Veins, curving a little
          for a in pd.veins {
            path([[cx + cos(a) * R * 0.1, cy + sin(a) * R * 0.1], [cx + cos(a + 0.12) * R * 0.5, cy + sin(a + 0.12) * R * 0.5], [cx + cos(a + 0.05) * R * 0.86, cy + sin(a + 0.05) * R * 0.86]], stroke: alpha(padLight, 0.55), width: 0.45 * p, cap: round)
          }
          path(pd.pts.map(q => [cx + q[0], cy + q[1]]), closed: true, stroke: mix(padDark, rgb(0, 0, 0), 0.35), width: 0.45 * p)

          // A lotus: two rings of pointed petals round a golden heart
          if pd.flower {
            let fx = cx + R * 0.1
            let fy = cy - R * 0.05
            let L = R * 0.85
            for k in range(8) {
              rotate(k * 45 + 22, fx, fy) {
                path(petalPts.map(q => [fx + q[0] * L, fy + q[1] * L]), closed: true, fill: mix(mix(magenta, red, 0.2), rgb(255, 245, 245), 0.6))
                path(petalPts.map(q => [fx + q[0] * L, fy + q[1] * L]), closed: true, stroke: alpha(mix(magenta, red, 0.3), 0.6), width: 0.35 * p)
              }
            }
            for k in range(6) {
              rotate(k * 60 + sin(pondTime * 0.3) * 3, fx, fy) {
                path(petalPts.map(q => [fx + q[0] * L * 0.62, fy + q[1] * L * 0.62]), closed: true, fill: mix(mix(magenta, red, 0.2), rgb(255, 240, 245), 0.3))
              }
            }
            circle(fx, fy, R * 0.16, fill: mix(yellow, orange, 0.2))
            circle(fx - R * 0.04, fy - R * 0.04, R * 0.07, fill: mix(yellow, rgb(255, 255, 220), 0.5))
          }
        }
      }
    }

    // What falls into the pond and blows over it: rain streaks slanted by the
    // wind that end where they hit, hail bouncing off the surface, flakes
    // drifting down and melting (sideways in a blizzard), leaves skating
    // across on the wind and, in a storm, a lightning bolt mirrored in the water.
    Canvas {
      fill: true
      if rain > 0 {
        let lean = 0.3 + 0.8 * wind
        let L = (5 + 5 * rain) * p
        for i in range(round(8 + 36 * rain)) {
          let ph = pondTime / (0.45 + 0.25 * hash(i, 21)) + hash(i, 22)
          let u = ph - floor(ph)
          let x = hash(i, floor(ph), 23) * W
          let y = hash(i, floor(ph), 24) * H
          let back = (1 - u) * 2 * L
          line(x - windTo[0] * lean * (back + L), y - back - L, x - windTo[0] * lean * back, y - back, stroke: alpha(mix(todLight, rgb(230, 240, 255), 0.6), 0.25 + 0.2 * u), width: 0.3 * p, cap: round)
        }
      }
      if hail > 0 {
        for i in range(round(6 + 24 * hail)) {
          let ph = pondTime / (0.8 + 0.5 * hash(i, 41)) + hash(i, 42)
          let u = ph - floor(ph)
          let x = hash(i, floor(ph), 43) * W
          let y = hash(i, floor(ph), 44) * H
          // A hop up off the water and back, then a ring and gone
          let hop = u < 0.5 ? sin(u / 0.5 * rad(180)) * 2.5 * p : 0
          if u < 0.7 {
            circle(x + u * windTo[0] * 3 * p, y - hop, (0.55 + 0.35 * hash(i, 45)) * p, fill: alpha(rgb(240, 248, 255), 0.9 * (1 - u / 0.7)))
          }
          circle(x, y, (0.5 + 3 * u) * p, stroke: alpha(rgb(235, 245, 255), 0.35 * (1 - u)), width: 0.25 * p)
        }
      }
      if snow > 0 {
        for i in range(round(10 + 40 * snow)) {
          let per = 3 + 2 * hash(i, 31)
          let ph = pondTime / per + hash(i, 32)
          let u = ph - floor(ph)
          let push = (4 + 40 * wind * wind) * p * u
          let x = hash(i, floor(ph), 33) * W + sin(pondTime * 1.3 + i) * 2 * p + windTo[0] * push
          let y = hash(i, floor(ph), 34) * H + u * 8 * p + windTo[1] * push
          circle(x, y, (0.5 + 0.6 * hash(i, 35)) * p, fill: alpha(rgb(250, 252, 255), 0.85 * sin(u * rad(180))))
        }
      }
      if wind > 0.3 {
        // Leaves blown across the water, spinning as they go
        let span = W + H
        for i in range(round(2 + 8 * (wind - 0.3))) {
          let ph = pondTime * (12 + 50 * wind) * p / span / (0.8 + 0.4 * hash(i, 51)) + hash(i, 52)
          let u = ph - floor(ph)
          let off = (hash(i, floor(ph), 53) - 0.5) * (abs(windTo[0]) * H + abs(windTo[1]) * W) * 0.9
          let x = W / 2 + windTo[0] * (u - 0.5) * span * 1.2 - windTo[1] * off
          let y = H / 2 + windTo[1] * (u - 0.5) * span * 1.2 + windTo[0] * off
          let sz = (2.4 + 1.4 * hash(i, 54)) * p
          let col = [mix(green, yellow, 0.4), mix(orange, red, 0.2), mix(yellow, orange, 0.5)][i % 3]
          rotate(pondTime * (40 + 80 * hash(i, 55)) * (i % 2 == 0 ? 1 : -1) + hash(i, 56) * 360, x, y) {
            path([[x - sz, y + 1.5 * p], [x - sz * 0.3, y - sz * 0.45], [x + sz, y], [x - sz * 0.3, y + sz * 0.45]].map(q => [q[0], q[1] - 1.5 * p]), closed: true, fill: alpha(shadowCol, 0.5))
            path([[x - sz, y], [x - sz * 0.3, y - sz * 0.45], [x + sz, y], [x - sz * 0.3, y + sz * 0.45]], closed: true, fill: col)
            line(x - sz, y, x + sz * 0.8, y, stroke: alpha(mix(col, rgb(60, 40, 20), 0.5), 0.8), width: 0.2 * p)
          }
        }
      }
      if flashOn && flashT > 0 && flashT < 0.45 {
        // The bolt, jagged from the top edge down into the pond, and a fork
        let bx = (0.2 + 0.6 * hash(flashK, 78)) * W
        let pts = range(9).map(k => [bx + (hash(flashK, k, 79) - 0.5) * 0.18 * W * (k > 0 ? 1 : 0) + k * (hash(flashK, 80) - 0.5) * 0.03 * W, k / 8 * H * (0.55 + 0.35 * hash(flashK, 81))])
        let fork = [pts[3]] + range(1, 4).map(k => [pts[3][0] + k * 0.05 * W * (hash(flashK, 82) > 0.5 ? 1 : -1) + (hash(flashK, k, 83) - 0.5) * 0.04 * W, pts[3][1] + k * 0.07 * H])
        let fa = clamp(1 - flashT / 0.45, 0, 1) * (flashT < 0.12 || flashT > 0.24 ? 1 : 0.3)
        path(pts.map(wob), stroke: alpha(rgb(190, 205, 255), 0.35 * fa), width: 2.2 * p, cap: round)
        path(fork.map(wob), stroke: alpha(rgb(190, 205, 255), 0.25 * fa), width: 1.4 * p, cap: round)
        path(pts.map(wob), stroke: alpha(rgb(255, 255, 255), 0.9 * fa), width: 0.5 * p, cap: round)
        path(fork.map(wob), stroke: alpha(rgb(255, 255, 255), 0.7 * fa), width: 0.35 * p, cap: round)
      }
    }

    // The time of day and the weather over everything: cloud shadows and the
    // clouds' own reflection drifting with the wind, a veil in their colour,
    // the glow of the sun or moon from where it is in the sky, banks of mist
    // or haze, frost at the edges, a rainbow and, in a storm, lightning.
    Shader {
      fill: true
      fallback: alpha(todVeil, todVeilA)
      uniforms: {pt: waterTime, veil: todVeil, veilA: todVeilA, glow: todGlow, glowA: todGlowA, glowAt: todGlowAt,
        shade: 4 * clouds * (1 - clouds) * (1 - wts[0]) * 0.35, cloudsA: clouds * (1 - wts[0]) * (1 - 0.6 * fog),
        driftV: [windTo[0] * (0.02 + 0.07 * wind), windTo[1] * (0.02 + 0.07 * wind)],
        mist: max(fog, 0.8 * haze), mistCol: fog >= haze ? mix(rgb(235, 240, 245), rgb(90, 100, 120), wts[0]) : hazeCol,
        frost: frost, bow: bow, flash: flash}
      code: """
        uniform float pt;
        uniform half4 veil;
        uniform float veilA;
        uniform half4 glow;
        uniform float glowA;
        uniform float2 glowAt;
        uniform float shade;
        uniform float cloudsA;
        uniform float2 driftV;
        uniform float mist;
        uniform half4 mistCol;
        uniform float frost;
        uniform float bow;
        uniform float flash;

        float3 hue(float h) {
          return clamp(abs(fract(h + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
        }

        half4 main(float2 px) {
          float2 uv = px / size;
          float asp = size.x / size.y;
          float2 a = uv * float2(asp, 1.0);
          // Soft cloud shadows sliding across with the wind
          float2 cp = a * 1.7 - pt * driftV;
          float cs = sin(cp.x * 2.1 + sin(cp.y * 1.7 + pt * 0.03)) * sin(cp.y * 2.6 + sin(cp.x * 1.3));
          float sa = shade * smoothstep(-0.05, 0.45, cs);
          // The clouds above mirrored in the water: pale soft billows
          float2 rp = a * 1.2 - pt * driftV * 1.3 + 7.0;
          float rc = sin(rp.x * 2.3 + sin(rp.y * 3.1) * 0.8) * sin(rp.y * 2.9 + sin(rp.x * 1.7 + pt * 0.02)) + 0.3 * sin(rp.x * 5.3 - rp.y * 4.1);
          float ca = cloudsA * 0.16 * smoothstep(0.0, 0.7, rc);
          // Mist or haze, thicker in slow drifting banks
          float2 mp = a * 2.3 + float2(pt * 0.03, -pt * 0.017) - pt * driftV;
          float ma = mist * 0.22 * (0.5 + 0.5 * sin(mp.x * 1.9 + sin(mp.y * 2.3)) * sin(mp.y * 1.4 - sin(mp.x * 1.1)));
          // Frost growing in from the edges: a ragged icy band, finely
          // textured, with glittering points in it. Skipped without frost.
          float fa = 0.0;
          if (frost > 0.0) {
            float e = min(min(uv.x * asp, (1.0 - uv.x) * asp), min(uv.y, 1.0 - uv.y));
            float fe = e + 0.025 * sin(a.x * 29.0 + sin(a.y * 17.0) * 2.0) * sin(a.y * 23.0 - a.x * 7.0) + 0.012 * sin(a.x * 83.0 - a.y * 61.0);
            float fz = frost * smoothstep(0.06 + 0.1 * frost, 0.005, fe);
            float tex = 0.75 + 0.25 * sin(a.x * 160.0 + sin(a.y * 110.0) * 2.0) * sin(a.y * 150.0 - sin(a.x * 90.0) * 2.0);
            float2 gc = floor(a * 70.0);
            float gl = step(0.93, fract(sin(dot(gc, float2(12.9898, 78.233))) * 43758.5453)) * (0.5 + 0.5 * sin(pt * 2.0 + gc.x * 3.1 + gc.y * 1.7)) * smoothstep(0.3, 0.05, length(fract(a * 70.0) - 0.5));
            fa = clamp(fz * (0.6 * tex + 0.4 * gl), 0.0, 0.85);
          }
          // A rainbow reflected: an arc rising from the far side of the pond.
          // Skipped without one.
          float band = 0.0;
          float ba = 0.0;
          if (bow > 0.0) {
            float rr = length((uv - float2(0.5, 1.25)) * float2(asp, 1.0)) / max(asp, 1.0);
            band = (rr - 0.78) / 0.09;
            ba = bow * 0.16 * smoothstep(0.0, 0.15, band) * smoothstep(1.0, 0.85, band) * smoothstep(1.0, 0.35, uv.y);
          }
          float2 d = (uv - glowAt) * float2(asp, 1.0);
          float ga = glowA * exp(-dot(d, d) * 2.2);
          // Premultiplied, bottom up: shadow, cloud reflection, veil, mist,
          // rainbow, glow, frost, flash
          half4 o = half4(0.0, 0.0, 0.0, sa);
          o = half4(half3(0.95, 0.96, 1.0) * ca, ca) + o * (1.0 - ca);
          o = half4(veil.rgb * veilA, veilA) + o * (1.0 - veilA);
          o = half4(mistCol.rgb * ma, ma) + o * (1.0 - ma);
          o = half4(half3(hue((1.0 - clamp(band, 0.0, 1.0)) * 0.75)) * ba, ba) + o * (1.0 - ba);
          o = half4(glow.rgb * ga, ga) + o * (1.0 - ga);
          o = half4(half3(0.88, 0.95, 1.0) * fa, fa) + o * (1.0 - fa);
          return half4(half3(0.9, 0.93, 1.0) * flash, flash) + o * (1.0 - flash);
        }
      """
    }

    // Which part of the day it is and the weather, small in a corner
    Canvas {
      fill: true
      text(label, 6 * p + 1, 5 * p + 1, size: 11, align: start, color: alpha(rgb(0, 0, 0), 0.35), letterSpacing: 1.5)
      text(label, 6 * p, 5 * p, size: 11, align: start, color: alpha(mix(foreground, todLight, 0.4), 0.8), letterSpacing: 1.5)
    }
  }
}
