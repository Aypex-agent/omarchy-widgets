widget "fútbol" {
  size: 6x4
  minSize: 4x3
  meta { description: "Live scores, standings, top scorers and news from ESPN for 60 football leagues and cups, plus the NFL, NBA, MLB and NHL. Favourite leagues, a team to follow with its results and next match, filters"; version: "2.1"; license: "MIT"; category: "sport"; owl: 16 }

  strings {
    en {
      matches: "matches"
      standings: "standings"
      table: "table"
      news: "news"
      goals: "goals"
      assists: "assists"
      no_news: "no news"
      unavailable: "not available for this competition"
      follow_hint: "tap a team in the table to follow it"
      next_match: "next match"
      last_results: "latest results"
      unfollow: "✕ unfollow"
      res_w: "W"
      res_d: "D"
      res_l: "L"
      col_w: "W"
      col_d: "D"
      col_l: "L"
      only_live: "● live only"
      only_mine: "★ my team only"
      no_filtered: "no matches with this filter"
      show_all: "show all"
      video: "video"
      day_today: d => "today · ${d}"
      day_tomorrow: d => "tomorrow · ${d}"
      day_yesterday: d => "yesterday · ${d}"
      loading: "loading…"
      no_matches: "no upcoming matches"
      no_standings: "this competition has no standings"
      leagues_title: "leagues"
      tap_mark: "tap to mark ★"
      edit_btn: "★ edit"
      done_btn: "done"
      team: "team"
      gp: "GP"
      gd: "GD"
      pts: "PTS"
      record: "record"
      streak: "streak"
      ht: "HT"
      ft: "FT"
      og: "(og)"
      pen: "(p)"
      grp_top: "Top leagues"
      grp_cups: "Cups"
      grp_national: "National teams"
      grp_more_europe: "More from Europe"
      grp_americas: "Americas"
      grp_rest: "Rest of world"
      grp_women: "Women's"
      grp_us: "United States"
      n_cwc: "Club World Cup"
      n_uefa_super: "UEFA Super Cup"
      n_world: "World Cup"
      n_euro: "Euro"
      n_wcq: "WC Qualifiers"
      n_friendly: "Friendlies"
      n_sco: "Scotland"
      n_gre: "Greece"
      n_sui: "Switzerland"
      n_den: "Denmark"
      n_swe: "Sweden"
      n_nor: "Norway"
      n_wucl: "Women's UCL"
    }
    es {
      matches: "partidos"
      standings: "clasificación"
      table: "tabla"
      news: "noticias"
      goals: "goles"
      assists: "asistencias"
      no_news: "sin noticias"
      unavailable: "no disponible para esta competición"
      follow_hint: "toca un equipo en la tabla para seguirlo"
      next_match: "próximo partido"
      last_results: "últimos resultados"
      unfollow: "✕ no seguir"
      res_w: "G"
      res_d: "E"
      res_l: "P"
      col_w: "G"
      col_d: "E"
      col_l: "P"
      only_live: "● solo en directo"
      only_mine: "★ solo mi equipo"
      no_filtered: "ningún partido con este filtro"
      show_all: "ver todos"
      video: "vídeo"
      day_today: d => "hoy · ${d}"
      day_tomorrow: d => "mañana · ${d}"
      day_yesterday: d => "ayer · ${d}"
      loading: "cargando…"
      no_matches: "no hay partidos próximos"
      no_standings: "esta competición no tiene clasificación"
      leagues_title: "ligas"
      tap_mark: "toca para marcar ★"
      edit_btn: "★ editar"
      done_btn: "listo"
      team: "equipo"
      gp: "PJ"
      gd: "DG"
      pts: "PTS"
      record: "balance"
      streak: "racha"
      ht: "desc."
      ft: "final"
      og: "(pp)"
      pen: "(p)"
      grp_top: "Principales"
      grp_cups: "Copas"
      grp_national: "Selecciones"
      grp_more_europe: "Más de Europa"
      grp_americas: "América"
      grp_rest: "Resto del mundo"
      grp_women: "Femenino"
      grp_us: "EE. UU."
      n_cwc: "Mundial Clubes"
      n_uefa_super: "Supercopa UEFA"
      n_world: "Mundial"
      n_euro: "Eurocopa"
      n_wcq: "Clasif. Mundial"
      n_friendly: "Amistosos"
      n_sco: "Escocia"
      n_gre: "Grecia"
      n_sui: "Suiza"
      n_den: "Dinamarca"
      n_swe: "Suecia"
      n_nor: "Noruega"
      n_wucl: "Champions fem."
    }
  }

  state league = "esp.1" persist
  state view = "partidos" persist
  state favs = ["uefa.champions", "esp.1", "eng.1", "ita.1", "ger.1", "fra.1", "uefa.europa", "esp.copa_del_rey"] persist
  state myTeam = null persist
  state myLeague = null persist
  state onlyLive = false persist
  state onlyMine = false persist
  state tableMode = "table"
  state picking = false
  state editing = false

  source now = clock every 1m
  let api = "https://site.api.espn.com/apis/site/v2/sports"

  let groups = [
    {name: str.grp_top, leagues: [
      {id: "uefa.champions", name: "Champions", logo: "2"},
      {id: "esp.1", name: "LaLiga", logo: "15"},
      {id: "eng.1", name: "Premier", logo: "23"},
      {id: "ita.1", name: "Serie A", logo: "12"},
      {id: "ger.1", name: "Bundesliga", logo: "10"},
      {id: "fra.1", name: "Ligue 1", logo: "9"},
      {id: "uefa.europa", name: "Europa League", logo: "2310"},
      {id: "uefa.europa.conf", name: "Conference", logo: "20296"}
    ]},
    {name: str.grp_cups, leagues: [
      {id: "esp.copa_del_rey", name: "Copa del Rey", logo: "80"},
      {id: "esp.super_cup", name: "Supercopa", logo: "431", light: true},
      {id: "fifa.cwc", name: str.n_cwc, logo: "1932"},
      {id: "uefa.super_cup", name: str.n_uefa_super, logo: "1272"},
      {id: "eng.fa", name: "FA Cup", logo: "40"},
      {id: "eng.league_cup", name: "Carabao Cup", logo: "41"},
      {id: "ita.coppa_italia", name: "Coppa Italia", logo: "2192", light: true},
      {id: "ger.dfb_pokal", name: "DFB-Pokal", logo: "2061"},
      {id: "fra.coupe_de_france", name: "Coupe de France", logo: "182"}
    ]},
    {name: str.grp_national, leagues: [
      {id: "fifa.world", name: str.n_world, logo: "4"},
      {id: "uefa.euro", name: str.n_euro, logo: "74"},
      {id: "fifa.worldq.uefa", name: str.n_wcq, logo: "67"},
      {id: "uefa.nations", name: "Nations League", logo: "2395"},
      {id: "conmebol.america", name: "Copa América", logo: "83"},
      {id: "fifa.friendly", name: str.n_friendly, logo: "53"}
    ]},
    {name: str.grp_more_europe, leagues: [
      {id: "esp.2", name: "Hypermotion", logo: "107"},
      {id: "eng.2", name: "Championship", logo: "24"},
      {id: "por.1", name: "Liga Portugal", logo: "14"},
      {id: "ned.1", name: "Eredivisie", logo: "11"},
      {id: "ita.2", name: "Serie B", logo: "99", light: true},
      {id: "ger.2", name: "2. Bundesliga", logo: "97", light: true},
      {id: "fra.2", name: "Ligue 2", logo: "96"},
      {id: "bel.1", name: "Pro League", logo: "6"},
      {id: "tur.1", name: "Süper Lig", logo: "18"},
      {id: "sco.1", name: str.n_sco, logo: "45"},
      {id: "gre.1", name: str.n_gre, logo: "98", light: true},
      {id: "aut.1", name: "Austria", logo: "5"},
      {id: "sui.1", name: str.n_sui, logo: "17", light: true},
      {id: "den.1", name: str.n_den, logo: null},
      {id: "swe.1", name: str.n_swe, logo: "16", light: true},
      {id: "nor.1", name: str.n_nor, logo: null}
    ]},
    {name: str.grp_americas, leagues: [
      {id: "conmebol.libertadores", name: "Libertadores", logo: "58"},
      {id: "conmebol.sudamericana", name: "Sudamericana", logo: "1208"},
      {id: "bra.1", name: "Brasileirão", logo: "85"},
      {id: "arg.1", name: "Argentina", logo: "1"},
      {id: "mex.1", name: "Liga MX", logo: "22"},
      {id: "usa.1", name: "MLS", logo: "19"},
      {id: "concacaf.champions", name: "Concacaf", logo: "2298"},
      {id: "col.1", name: "Colombia", logo: "1543"},
      {id: "chi.1", name: "Chile", logo: "86"},
      {id: "uru.1", name: "Uruguay", logo: "1592"}
    ]},
    {name: str.grp_rest, leagues: [
      {id: "ksa.1", name: "Saudi Pro", logo: "2488"},
      {id: "jpn.1", name: "J.League", logo: "2199"},
      {id: "aus.1", name: "A-League", logo: "1308"}
    ]},
    {name: str.grp_women, leagues: [
      {id: "uefa.wchampions", name: str.n_wucl, logo: "2408"},
      {id: "esp.w.1", name: "Liga F", logo: null},
      {id: "eng.w.1", name: "WSL", logo: "2314"}
    ]},
    {name: str.grp_us, leagues: [
      {id: "nfl", name: "NFL", sport: "football", us: true},
      {id: "nba", name: "NBA", sport: "basketball", us: true},
      {id: "mlb", name: "MLB", sport: "baseball", us: true},
      {id: "nhl", name: "NHL", sport: "hockey", us: true}
    ]}
  ]
  let leagues = flatten(groups.map(g => g.leagues))
  let pickerRows = flatten(groups.map(g => flatten([[{head: g.name}], chunk(g.leagues, 3).map(c => ({cells: c}))])))
  let favLeagues = leagues.filter(l => favs.any(f => f == l.id)).take(10)
  let current = leagues.find(l => l.id == league) ?? leagues[0]
  let us = current.us == true
  let sport = current.sport ?? "soccer"

  source board = http("${api}/${enc(sport)}/${enc(league)}/scoreboard") every 30s json timeout 10s

  let main = board.leagues[0].slug == league ? board : null
  let calType = main.leagues[0].calendarType
  let mainEvents = main.events ?? []
  let lastDate = mainEvents.map(e => e.date).sort().last() ?? ""

  let nextDay = calType == "day" ? (main.leagues[0].calendar ?? []).find(d => sub(d, 0, 10) > main.day.date) : null
  source after = http(nextDay == null ? null : "${api}/${enc(sport)}/${enc(league)}/scoreboard?dates=${enc(replace(sub(nextDay, 0, 10), "-", ""))}") every 10m json timeout 10s
  let monthStart = parseTime(fmtTime(now, "yyyy-MM-01"))
  source cupNow = http(calType == "list" && !mainEvents.any(e => e.status.type.state != "post") ? "${api}/${enc(sport)}/${enc(league)}/scoreboard?dates=${enc(fmtTime(now, "yyyyMM"))}&limit=30" : null) every 15m json timeout 15s
  let cupNowUpcoming = calType == "list" && cupNow.leagues[0].slug == league ? cupNow.events.filter(e => e.date > lastDate) : []
  source cupNext = http(calType == "list" && cupNow.leagues[0].slug == league && len(cupNowUpcoming) == 0 ? "${api}/${enc(sport)}/${enc(league)}/scoreboard?dates=${enc(fmtTime(monthStart + 32 * 86400, "yyyyMM"))}&limit=30" : null) every 30m json timeout 15s
  let upcoming = calType == "day" ? (after.leagues[0].slug == league ? after.events.filter(e => e.date > lastDate) : []) : len(cupNowUpcoming) > 0 ? cupNowUpcoming : cupNext.leagues[0].slug == league ? cupNext.events.filter(e => e.date > lastDate) : []

  let matches = flatten([mainEvents, upcoming.take(12)]).sortBy(e => parseTime(e.date)).map(e => merge(e, {day: fmtTime(parseTime(e.date), "yyyy-MM-dd")}))
  let shown = matches.filter(e => (!onlyLive || e.status.type.state == "in") && (!onlyMine || myTeam == null || e.competitions[0].competitors.any(c => c.team.id == myTeam)))
  let live = mainEvents.count(e => e.status.type.state == "in")
  let today = fmtTime(now, "yyyy-MM-dd")
  let tomorrow = fmtTime(now + 86400, "yyyy-MM-dd")
  let yesterday = fmtTime(now - 86400, "yyyy-MM-dd")

  source standings = http(view == "tabla" ? "https://site.api.espn.com/apis/v2/sports/${enc(sport)}/${enc(league)}/standings" : null) every 10m json timeout 15s
  let leagueUid = main.leagues[0].uid
  let table = leagueUid != null && (standings.uid == leagueUid || startsWith(standings.uid ?? "", "${leagueUid}~")) ? standings : null
  let tableGroups = (table.children ?? []).filter(c => len(c.standings.entries ?? []) > 0)
  let tableReady = table != null && len(tableGroups) > 0 && (tableGroups[0].standings.entries[0].team.id != null)
  let tableRows = flatten(tableGroups.map(g => flatten([
    len(tableGroups) > 1 ? [{head: g.name}] : [],
    g.standings.entries.map(e => ({
      team: e.team,
      note: e.note,
      rank: num(e.stats.find(s => s.name == "rank").value, 0),
      seed: num(e.stats.find(s => s.name == "playoffSeed").value, 99),
      pct: num(e.stats.find(s => s.name == "winPercent").value, 0),
      played: e.stats.find(s => s.name == "gamesPlayed").displayValue,
      gd: e.stats.find(s => s.name == "pointDifferential").displayValue,
      pts: e.stats.find(s => s.name == "points").displayValue,
      wins: e.stats.find(s => s.name == "wins").displayValue,
      ties: e.stats.find(s => s.name == "ties").displayValue,
      losses: e.stats.find(s => s.name == "losses").displayValue,
      record: e.stats.find(s => s.name == "overall").displayValue,
      streak: e.stats.find(s => s.name == "streak").displayValue
    })).sortBy(r => us ? r.seed * 10 - r.pct : r.rank).map((r, i) => merge(r, {pos: i + 1}))
  ])))

  // The league's top scorers and assists, fetched only while one of those lists shows. Football only.
  source leaders = http(view == "tabla" && tableMode != "table" && !us ? "${api}/${enc(sport)}/${enc(league)}/statistics" : null) every 30m json timeout 25s status
  let leadersFresh = leaders.out.league.slug == league
  let leaderList = leadersFresh ? (((leaders.out.stats ?? []).find(s => s.name == (tableMode == "assists" ? "assistsLeaders" : "goalsLeaders")).leaders ?? []).take(25)) : []

  // The league's headlines, fetched only while the news shows. Its link names the league, where it has that form.
  source news = http(view == "noticias" ? "${api}/${enc(sport)}/${enc(league)}/news?limit=20" : null) every 15m json timeout 15s
  let newsLink = news.link.href ?? ""
  let newsFresh = news != null && (!contains(newsLink, "/name/") || endsWith(newsLink, "/name/${league}"))
  let articles = newsFresh ? (news.articles ?? []).filter(a => a.headline != null && a.id != null) : []

  // The followed team, in the league it was followed in: its place, its next match and its latest results.
  let teamLeague = leagues.find(l => l.id == (myLeague ?? league)) ?? current
  let teamUs = teamLeague.us == true
  let teamSport = teamLeague.sport ?? "soccer"
  source teamInfo = http(view == "equipo" && myTeam != null ? "${api}/${enc(teamSport)}/${enc(teamLeague.id)}/teams/${enc(myTeam)}" : null) every 10m json timeout 15s
  source teamSched = http(view == "equipo" && myTeam != null ? "${api}/${enc(teamSport)}/${enc(teamLeague.id)}/teams/${enc(myTeam)}/schedule" : null) every 15m json timeout 25s
  let club = teamInfo.team.id == myTeam ? teamInfo.team : null
  let nextEvents = (club.nextEvent ?? []).filter(e => e.competitions[0].status.type.state != "post").take(1)
  let results = teamSched.team.id == myTeam ? (teamSched.events ?? []).filter(e => e.competitions[0].status.type.state == "post").sortBy(e => 0 - parseTime(e.date)).take(8) : null
  let teamRows = flatten([
    len(nextEvents) > 0 ? [{head: str.next_match}] : [],
    nextEvents.map(e => ({e: e, played: false})),
    len(results ?? []) > 0 ? [{head: str.last_results}] : [],
    (results ?? []).map(e => ({e: e, played: true}))
  ])

  let wide = (tileWidth ?? 400) >= 360
  let short = (tileHeight ?? 300) < 200

  component LeagueLogo(l, px) {
    Box {
      width: px
      height: px
      align: center
      if l.us == true {
        Image { src: "https://a.espncdn.com/i/teamlogos/leagues/500-dark/${enc(l.id)}.png"; width: px; height: px; fit: contain; label: l.name }
      } else if l.logo != null {
        Image { src: "https://a.espncdn.com/i/leaguelogos/soccer/${l.light == true ? "500" : "500-dark"}/${enc(l.logo)}.png"; width: px; height: px; fit: contain; label: l.name }
      } else {
        Text { text: "⚽"; fontSize: px * 0.6; align: center }
      }
    }
  }

  component TeamLogo(t, px, usL = us, lg = league) {
    if usL {
      Image { src: "https://a.espncdn.com/i/teamlogos/${enc(lg)}/500/scoreboard/${enc(lower(t.abbreviation))}.png"; width: px; height: px; fit: contain }
    } else {
      Image { src: "https://a.espncdn.com/i/teamlogos/soccer/500/${enc(t.id)}.png"; width: px; height: px; fit: contain }
    }
  }

  component DayHeading(day, t) {
    Text {
      text: day == today ? str.day_today(fmtTime(t, "EEEE d MMM")) : day == tomorrow ? str.day_tomorrow(fmtTime(t, "EEEE d MMM")) : day == yesterday ? str.day_yesterday(fmtTime(t, "EEEE d MMM")) : fmtTime(t, "EEEE d MMMM")
      style: label
      color: day == today ? accent : muted
      padding: [0, 4, 0, 0]
    }
  }

  component Team(t, home) {
    Row {
      gap: 6
      align: center
      justify: home ? "end" : "start"
      weight: 1
      if !home && (t.team.logo ?? "") != "" {
        TeamLogo { t: t.team; px: 18 }
      }
      Text { text: t.team.shortDisplayName; maxLines: 1; bold: t.winner == true || t.team.id == myTeam; color: t.team.id == myTeam ? accent : foreground; align: home ? "end" : "start"; weight: 1 }
      if home && (t.team.logo ?? "") != "" {
        TeamLogo { t: t.team; px: 18 }
      }
    }
  }

  // Goals and red cards of one side, as "⚽ Name 17'".
  component Events(e, side, home) {
    let evs = (e.competitions[0].details ?? []).filter(d => d.team.id == side.id && (d.scoringPlay == true || d.redCard == true))
    Text {
      text: join(evs.map(d => "${d.redCard == true ? "🟥" : "⚽"} ${d.athletesInvolved[0].shortName ?? ""} ${d.clock.displayValue ?? ""}${d.ownGoal == true ? " ${str.og}" : d.penaltyKick == true ? " ${str.pen}" : ""}"), "  ")
      style: small
      color: muted
      align: home ? "end" : "start"
      weight: 1
      maxLines: 2
    }
  }

  component Match(e) {
    let st = e.status.type
    let home = e.competitions[0].competitors.find(c => c.homeAway == (us ? "away" : "home"))
    let away = e.competitions[0].competitors.find(c => c.homeAway == (us ? "home" : "away"))
    let mine = myTeam != null && (home.team.id == myTeam || away.team.id == myTeam)
    Column {
      gap: 2
      padding: mine ? [4, 3] : 0
      radius: 4 * corners
      background: mine ? alpha(accent, 0.12) : alpha(surface, 0)
      Row {
        gap: 8
        align: center
        Text {
          text: st.state == "pre" ? (st.name == "STATUS_SCHEDULED" ? fmtTime(parseTime(e.date), "HH:mm") : lower(st.shortDetail)) : st.state == "in" ? (us ? replace(lower(st.shortDetail), " - ", " ") : st.name == "STATUS_HALFTIME" ? str.ht : e.status.displayClock) : st.name == "STATUS_FULL_TIME" ? str.ft : lower(st.shortDetail)
          style: small
          font: mono
          color: st.state == "in" ? green : st.state == "pre" ? foreground : muted
          bold: st.state == "in"
          width: us ? 66 : 54
          maxLines: 1
        }
        Team { t: home; home: true }
        Text {
          text: st.state == "pre" ? (us ? "@" : "–") : "${home.score} - ${away.score}"
          font: mono
          bold: true
          color: st.state == "in" ? green : foreground
          width: us ? 72 : 46
          maxLines: 1
          align: center
        }
        Team { t: away; home: false }
      }
      if !us && st.state != "pre" && (e.competitions[0].details ?? []).any(d => d.scoringPlay == true || d.redCard == true) {
        Row {
          gap: 8
          Spacer { width: 54 }
          Events { e: e; side: home.team; home: true }
          Spacer { width: 46 }
          Events { e: e; side: away.team; home: false }
        }
      }
    }
  }

  component Chip(label, on, pad = 8) {
    Row {
      padding: [pad, 3]
      radius: 4 * corners
      background: on ? alpha(accent, 0.3) : alpha(surface, 0.5)
      Text { text: label; style: small; color: on ? accent : muted; bold: on; maxLines: 1 }
    }
  }

  component Tabs() {
    Row {
      gap: wide ? 4 : 3
      Box { onTap: view = "partidos"; Chip { label: str.matches; on: view == "partidos"; pad: wide ? 8 : 4 } }
      Box { onTap: view = "tabla"; Chip { label: str.table; on: view == "tabla"; pad: wide ? 8 : 4 } }
      Box { onTap: view = "noticias"; Chip { label: str.news; on: view == "noticias"; pad: wide ? 8 : 4 } }
      Box { onTap: view = "equipo"; Chip { label: str.team; on: view == "equipo"; pad: wide ? 8 : 4 } }
    }
  }

  component TableHeader() {
    Row {
      gap: 6
      align: center
      padding: [0, 2]
      Text { text: "#"; style: small; color: muted; width: 22; align: end }
      Spacer { width: 18 }
      Text { text: str.team; style: small; color: muted; weight: 1 }
      if us {
        Text { text: str.record; style: small; color: muted; width: 76; align: end }
        Text { text: str.streak; style: small; color: muted; width: 44; align: end }
      } else {
        Text { text: str.gp; style: small; color: muted; width: 26; align: end }
        if wide {
          Text { text: str.col_w; style: small; color: muted; width: 24; align: end }
          Text { text: str.col_d; style: small; color: muted; width: 24; align: end }
          Text { text: str.col_l; style: small; color: muted; width: 24; align: end }
        }
        Text { text: str.gd; style: small; color: muted; width: 34; align: end }
        Text { text: str.pts; style: small; color: muted; width: 34; align: end }
      }
    }
  }

  component TableRow(r) {
    let mine = r.team.id == myTeam
    Row {
      gap: 6
      align: center
      padding: [0, 2]
      radius: 4 * corners
      background: mine ? alpha(accent, 0.18) : alpha(surface, 0)
      // A team's zone (Champions, relegation...) as ESPN colors it.
      Box {
        width: 22
        align: end
        Text { text: "${r.pos}"; style: small; font: mono; bold: r.note != null; color: r.note != null ? r.note.color : muted }
      }
      TeamLogo { t: r.team; px: 18 }
      Text { text: r.team.shortDisplayName; maxLines: 1; weight: 1; bold: mine; color: mine ? accent : foreground }
      if us {
        Text { text: r.record; style: small; font: mono; width: 76; align: end; maxLines: 1 }
        Text { text: r.streak; style: small; font: mono; width: 44; align: end; color: startsWith(r.streak ?? "", "W") ? green : red }
      } else {
        Text { text: r.played; style: small; font: mono; color: muted; width: 26; align: end }
        if wide {
          Text { text: r.wins; style: small; font: mono; color: muted; width: 24; align: end }
          Text { text: r.ties; style: small; font: mono; color: muted; width: 24; align: end }
          Text { text: r.losses; style: small; font: mono; color: muted; width: 24; align: end }
        }
        Text { text: r.gd; style: small; font: mono; color: muted; width: 34; align: end }
        Text { text: r.pts; font: mono; bold: true; width: 34; align: end }
      }
    }
  }

  component ScorerRow(p, pos) {
    let mine = p.athlete.team.id == myTeam
    Row {
      gap: 6
      align: center
      padding: [0, 2]
      radius: 4 * corners
      background: mine ? alpha(accent, 0.18) : alpha(surface, 0)
      Box {
        width: 22
        align: end
        Text { text: "${pos}"; style: small; font: mono; color: muted }
      }
      TeamLogo { t: p.athlete.team; px: 18; usL: false }
      Text { text: p.athlete.displayName; maxLines: 1; weight: 1; bold: mine; color: mine ? accent : foreground }
      Text { text: p.athlete.team.abbreviation; style: small; font: mono; color: muted; width: 34; align: end; maxLines: 1 }
      Text { text: "${int(p.value)}"; font: mono; bold: true; width: 30; align: end }
    }
  }

  // One match of the followed team: its date, the opponent and, once played, the result.
  component Fixture(e, played) {
    let c = e.competitions[0]
    let me = c.competitors.find(x => x.team.id == myTeam)
    let opp = c.competitors.find(x => x.team.id != myTeam)
    Row {
      gap: 6
      align: center
      Text { text: fmtTime(parseTime(e.date), played ? "d MMM" : "EEE d MMM · HH:mm"); style: small; font: mono; color: played ? muted : foreground; width: played ? 50 : 126; maxLines: 1 }
      if played {
        Text { text: me.winner == true ? str.res_w : opp.winner == true ? str.res_l : str.res_d; style: small; font: mono; bold: true; width: 14; align: center; color: me.winner == true ? green : opp.winner == true ? red : muted }
      }
      Text { text: me.homeAway == "home" ? "vs" : "@"; style: small; color: muted; width: 16; align: center }
      TeamLogo { t: opp.team; px: 18; usL: teamUs; lg: teamLeague.id }
      Text { text: opp.team.shortDisplayName; maxLines: 1; weight: 1 }
      if played {
        Text { text: "${me.score.displayValue}-${opp.score.displayValue}"; font: mono; bold: true; maxLines: 1 }
      }
    }
  }

  onTap: refresh()

  Column {
    gap: 6
    Box {
      Row {
        align: center
        gap: 6
        // The league shown opens the picker.
        Box {
          weight: 1
          onTap: { picking = true; editing = false }
          Row {
            align: center
            gap: 6
            LeagueLogo { l: current; px: 22 }
            Text { text: "${current.name} ▾"; style: label; color: accent; maxLines: 1; weight: 1 }
          }
        }
        if live > 0 {
          Text { text: "● ${live}"; style: small; color: green; bold: true }
        }
        if wide {
          Tabs { }
        }
      }
      // Every league, by group and importance, as a grid of logos. In edit mode a tap stars or unstars one.
      Popup {
        visible: picking
        onDismiss: { picking = false; editing = false }
        // Built only while open, and lazily: the tile shows at most 32 images at once.
        if picking {
          Column {
            gap: 6
            width: 330
            Row {
              align: center
              Text { text: editing ? str.tap_mark : str.leagues_title; style: label; color: editing ? accent : muted; weight: 1 }
              Button { text: editing ? str.done_btn : str.edit_btn; color: editing ? accent : muted; onTap: editing = !editing }
            }
            Row {
              gap: 6
              Box { onTap: onlyLive = !onlyLive; Chip { label: str.only_live; on: onlyLive } }
              Box { onTap: onlyMine = !onlyMine; Chip { label: str.only_mine; on: onlyMine } }
            }
            Column {
              lazy: true
              gap: 4
              height: 330
              for row in pickerRows {
                if row.head != null {
                  Text { text: row.head; style: label; color: muted; padding: [2, 6, 0, 0] }
                } else {
                  Row {
                    gap: 6
                    for l in row.cells {
                      let fav = favs.any(f => f == l.id)
                      Column {
                        weight: 1
                        align: center
                        gap: 4
                        padding: 6
                        radius: 6 * corners
                        background: l.id == league ? alpha(accent, 0.25) : alpha(surface, 0)
                        onTap: {
                          if editing {
                            favs = fav ? favs.filter(f => f != l.id) : flatten([favs, [l.id]])
                          } else {
                            league = l.id
                            picking = false
                          }
                        }
                        Box {
                          align: topEnd
                          LeagueLogo { l: l; px: 34 }
                          if fav || editing {
                            Text { text: fav ? "★" : "☆"; style: small; color: fav ? yellow : muted; offset: [10, -6] }
                          }
                        }
                        Text { text: l.name; style: small; align: center; maxLines: 1; color: l.id == league ? accent : foreground }
                      }
                    }
                    for k in range(3 - len(row.cells)) {
                      Spacer { weight: 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    if !wide {
      Tabs { }
    }
    // The favourites, one tap away, where the tile is tall enough for them.
    if !short {
    Row {
      gap: 4
      for l in favLeagues {
        Box {
          weight: 1
          align: center
          padding: [0, 4]
          radius: 4 * corners
          background: l.id == league ? alpha(accent, 0.3) : alpha(surface, 0.5)
          onTap: league = l.id
          LeagueLogo { l: l; px: 24 }
        }
      }
    }
    }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    if picking {
      Spacer { weight: 1 }
    } else if view == "tabla" {
      if !us {
        Row {
          gap: 4
          Box { onTap: tableMode = "table"; Chip { label: str.standings; on: tableMode == "table"; pad: wide ? 8 : 4 } }
          Box { onTap: tableMode = "goals"; Chip { label: str.goals; on: tableMode == "goals"; pad: wide ? 8 : 4 } }
          Box { onTap: tableMode = "assists"; Chip { label: str.assists; on: tableMode == "assists"; pad: wide ? 8 : 4 } }
        }
      }
      if us || tableMode == "table" {
        if table == null {
          Text { text: str.loading; style: muted }
        } else if !tableReady {
          Text { text: str.no_standings; style: muted }
        } else {
          if !short {
            TableHeader { }
          }
          // Tap a team to follow it: it's highlighted here and in the matches, and the team tab is about it.
          Column {
            lazy: true
            weight: 1
            gap: 5
            for r, i in tableRows {
              if r.head != null {
                Text { text: r.head; style: label; color: muted; padding: [0, 4, 0, 0] }
              } else {
                Box {
                  onTap: {
                    if r.team.id == myTeam {
                      myTeam = null
                    } else {
                      myTeam = r.team.id
                      myLeague = league
                    }
                  }
                  TableRow { r: r }
                }
              }
            }
          }
        }
      } else if leaders == null || (leaders.ok != false && !leadersFresh) {
        Text { text: str.loading; style: muted }
      } else if len(leaderList) == 0 {
        Text { text: str.unavailable; style: muted }
      } else {
        Column {
          lazy: true
          weight: 1
          gap: 5
          for p, i in leaderList {
            ScorerRow { p: p; pos: i + 1 }
          }
        }
      }
    } else if view == "noticias" {
      if news == null || !newsFresh {
        Text { text: str.loading; style: muted }
      } else if len(articles) == 0 {
        Text { text: str.no_news; style: muted }
      } else {
        Column {
          lazy: true
          weight: 1
          gap: 8
          for a in articles key a.id {
            Box {
              onTap: url(a.type == "Media" ? "https://www.espn.com/video/clip/_/id/${enc(a.id)}" : us ? "https://www.espn.com/${enc(league)}/story/_/id/${enc(a.id)}" : "https://www.espn.com/soccer/story/_/id/${enc(a.id)}")
              Column {
                gap: 1
                Text { text: a.headline; maxLines: 2 }
                Text { text: "${fmtAgo(parseTime(a.published), now)}${a.type == "Media" ? " · ▶ ${str.video}" : ""}"; style: small; color: muted }
              }
            }
          }
        }
      }
    } else if view == "equipo" {
      if myTeam == null {
        Text { text: str.follow_hint; style: muted }
      } else if club == null {
        Text { text: str.loading; style: muted }
      } else {
        Row {
          align: center
          gap: 8
          TeamLogo { t: club; px: 30; usL: teamUs; lg: teamLeague.id }
          Column {
            weight: 1
            gap: 0
            Text { text: club.displayName; bold: true; color: accent; maxLines: 1 }
            Text { text: join([club.standingSummary, results == null ? null : teamSched.team.recordSummary].filter(x => x != null && x != ""), " · "); style: small; color: muted; maxLines: 1 }
          }
          Box { onTap: myTeam = null; Chip { label: wide ? str.unfollow : "✕"; on: false } }
        }
        Column {
          lazy: true
          weight: 1
          gap: 5
          for row in teamRows {
            if row.head != null {
              Text { text: row.head; style: label; color: muted; padding: [0, 4, 0, 0] }
            } else {
              Box {
                onTap: url(teamUs ? "https://www.espn.com/${enc(teamLeague.id)}/game/_/gameId/${enc(row.e.id)}" : "https://www.espn.com/soccer/match/_/gameId/${enc(row.e.id)}")
                Fixture { e: row.e; played: row.played }
              }
            }
          }
        }
      }
    } else if main == null {
      Text { text: str.loading; style: muted }
    } else if len(matches) == 0 {
      Text { text: str.no_matches; style: muted }
    } else if len(shown) == 0 {
      Text { text: str.no_filtered; style: muted }
      Row {
        Button { text: str.show_all; onTap: { onlyLive = false; onlyMine = false } }
      }
    } else {
      // lazy: only the rows in view are built, so a cup round of 18 matches stays under the image limit.
      Column {
        lazy: true
        weight: 1
        gap: 7
        for e, i in shown key e.id {
          Column {
            gap: 4
            if i == 0 || shown[i - 1].day != e.day {
              DayHeading { day: e.day; t: parseTime(e.date) }
            }
            Box { onTap: url(us ? "https://www.espn.com/${enc(league)}/game/_/gameId/${enc(e.id)}" : "https://www.espn.com/soccer/match/_/gameId/${enc(e.id)}"); Match { e: e } }
          }
        }
      }
    }
  }
}
