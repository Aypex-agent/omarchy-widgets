// Compact 6×1 SSH server-stats strip: read-only probes; the host needs python3 already.
widget "minimal server stats" {
  size: 6x1
  minSize: 6x1
  padding: 8
  meta {
    owl: 10
    version: "1.0"
    description: "CPU, GPU, RAM, storage, Docker and optional public IP over SSH. Read-only; host needs python3."
    license: "MIT"
    category: "system"
  }
  requires { pacman: ["openssh", "python"] }

  state host = "" persist
  state user = "" persist
  state port = "22" persist
  state identity = "~/.ssh/id_ed25519" persist
  // Off by default: when on, the host curls a public-IP API during each probe.
  state fetchIp = false persist

  let hostText = trim(host)
  let userText = trim(user)
  let portNumber = num(port, 0)
  let idPath = trim(identity) == "" ? "~/.ssh/id_ed25519" : trim(identity)
  let targetOk = match(hostText, "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$") != null
      && match(userText, "^[A-Za-z_][A-Za-z0-9_.-]{0,31}$") != null
      && portNumber >= 1 && portNumber <= 65535

  // Local client pipes a one-shot Python probe to `python3 -` on the host over SSH.
  let sshClient = """
import json, os, re, subprocess, sys, time
from pathlib import Path

REMOTE = r'''
import json, os, subprocess, time

def read(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None

def num(v, lo, hi):
    try:
        if isinstance(v, bool):
            return None
        x = float(v)
        if x != x or x < lo or x > hi:
            return None
        return x
    except (TypeError, ValueError):
        return None

def run(argv, timeout=4):
    try:
        r = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=timeout, check=False, text=True)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None

def cpu_percent():
    try:
        def snap():
            lines = (read("/proc/stat") or "").splitlines()
            if not lines:
                return None
            parts = [int(x) for x in lines[0].split()[1:]]
            if len(parts) < 4:
                return None
            idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
            return idle, sum(parts)
        s1 = snap()
        if s1 is None:
            return None
        time.sleep(0.08)
        s2 = snap()
        if s2 is None:
            return None
        (i1, t1), (i2, t2) = s1, s2
        dt = t2 - t1
        return round(max(0.0, min(100.0, (1 - (i2 - i1) / dt) * 100)), 1) if dt > 0 else None
    except (ValueError, IndexError, TypeError):
        return None

def memory():
    info = {}
    for line in (read("/proc/meminfo") or "").splitlines():
        if ":" not in line:
            continue
        key, rest = line.split(":", 1)
        parts = rest.split()
        if parts and parts[0].isdigit():
            info[key.strip()] = int(parts[0]) * 1024
    total, avail = info.get("MemTotal"), info.get("MemAvailable")
    if not total or avail is None:
        return {"used_percent": None, "used_bytes": None, "total_bytes": None}
    return {
        "used_percent": round((total - avail) / total * 100, 1),
        "used_bytes": total - avail,
        "total_bytes": total,
    }

def keep_mount(target):
    if target == "/":
        return True
    for prefix in ("/mnt/", "/media/", "/home", "/data", "/srv"):
        if target == prefix.rstrip("/") or target.startswith(prefix):
            return True
    return False

def storage():
    disks, seen = [], set()
    rows = []
    out = run(["df", "-B1", "--output=source,target,size,avail,pcent",
               "-x", "tmpfs", "-x", "devtmpfs", "-x", "squashfs", "-x", "efivarfs", "-x", "overlay"]) or ""
    if out.strip():
        for line in out.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 5:
                rows.append(parts[:5])
    else:
        # Non-GNU df: Filesystem 1024-blocks Used Available Capacity Mounted on
        out = run(["df", "-kP"]) or ""
        for line in out.splitlines()[1:]:
            parts = line.split()
            if len(parts) < 6:
                continue
            source, size_k, avail_k, pct_s, target = parts[0], parts[1], parts[3], parts[4], parts[5]
            if source in ("tmpfs", "devtmpfs", "overlay") or target.startswith(("/run", "/sys", "/dev")):
                continue
            try:
                rows.append([source, target, str(int(size_k) * 1024), str(int(avail_k) * 1024), pct_s])
            except ValueError:
                continue
    rows.sort(key=lambda r: (0 if r[1] == "/" else 1, r[1]))
    for source, target, size_s, avail_s, pct_s in rows:
        if source in seen or not keep_mount(target):
            continue
        seen.add(source)
        label = "root" if target == "/" else target.rsplit("/", 1)[-1] or target
        disks.append({
            "label": label[:24], "path": target,
            "used_percent": num(pct_s.rstrip("%"), 0, 100),
            "free_bytes": num(avail_s, 0, 2**63 - 1),
            "total_bytes": num(size_s, 1, 2**63 - 1),
        })
        if len(disks) >= 4:
            break
    return disks

def gpu():
    out = run(["nvidia-smi",
               "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
               "--format=csv,noheader,nounits"], timeout=3)
    if not out:
        return None
    line = out.strip().splitlines()[0]
    parts = [p.strip() for p in line.rsplit(",", 4)]
    if len(parts) < 5:
        return None
    return {
        "name": parts[0][:40],
        "util_percent": num(parts[1], 0, 100),
        "mem_used_mib": num(parts[2], 0, 1_000_000),
        "mem_total_mib": num(parts[3], 1, 1_000_000),
        "temp_c": num(parts[4], -20, 130),
    }

def docker():
    sep = "|"
    out = run(["docker", "ps", "-a", "--format", "{{.Names}}" + sep + "{{.Status}}" + sep + "{{.State}}"], timeout=5)
    if out is None:
        return {"ok": False, "total": 0, "running": 0, "unhealthy": 0, "containers": []}
    containers, running, unhealthy = [], 0, 0
    for line in out.splitlines():
        if not line.strip():
            continue
        bits = line.split(sep)
        if len(bits) < 3:
            continue
        name, status, state = bits[0][:40], bits[1], bits[2].lower()
        # Stopped (exited) containers are normal; only flag sick or crashing ones.
        bad = ("unhealthy" in status.lower()) or state in ("dead", "restarting", "oomkilled")
        if state == "running":
            running += 1
        if bad:
            unhealthy += 1
        containers.append({"name": name, "status": status[:48], "state": state, "bad": bad})
    containers.sort(key=lambda c: (not c["bad"], c["name"]))
    return {"ok": True, "total": len(containers), "running": running, "unhealthy": unhealthy, "containers": containers[:24]}

def public_ip():
    if os.environ.get("FETCH_IP") != "1":
        return None
    def ipv4(text):
        parts = text.split(".")
        if len(parts) != 4:
            return None
        try:
            nums = [int(p) for p in parts]
        except ValueError:
            return None
        if all(0 <= n <= 255 for n in nums):
            return text
        return None
    for url in ("https://ifconfig.me/ip", "https://api.ipify.org", "https://icanhazip.com"):
        out = run(["curl", "-4", "-sf", "--max-time", "3", url], timeout=4)
        if out:
            ip = ipv4(out.strip().split()[0])
            if ip:
                return ip
    return None

uptime = num((read("/proc/uptime") or "0").split()[0], 0, 2**53)
load = num((read("/proc/loadavg") or "0").split()[0], 0, 1_000_000)
print(json.dumps({
    "schema": 1,
    "checked_at": int(time.time()),
    "hostname": (read("/etc/hostname") or "").strip() or None,
    "uptime_seconds": uptime,
    "load_1m": load,
    "cpu_percent": cpu_percent(),
    "memory": memory(),
    "storage": storage(),
    "gpu": gpu(),
    "docker": docker(),
    "public_ip": public_ip(),
}, ensure_ascii=False, separators=(",", ":"), allow_nan=False))
'''

host, user, port_text, identity, fetch_ip = sys.argv[1:6]
if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}", host)
        or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]{0,31}", user)
        or not port_text.isdigit() or not 1 <= int(port_text) <= 65535):
    print('{"schema":0,"error":"invalid_target"}')
    raise SystemExit(0)
key = Path(os.path.expanduser(identity))
if not key.is_file():
    print('{"schema":0,"error":"no_key"}')
    raise SystemExit(0)
flag = "1" if fetch_ip == "1" else "0"
cmd = [
    "ssh", "-T", "-F", "/dev/null", "-i", str(key), "-p", port_text,
    "-o", "BatchMode=yes", "-o", "ConnectTimeout=4",
    "-o", "PreferredAuthentications=publickey", "-o", "PasswordAuthentication=no",
    "-o", "IdentitiesOnly=yes", "-o", "StrictHostKeyChecking=yes",
    "-o", "UserKnownHostsFile=" + str(Path.home() / ".ssh" / "known_hosts"),
    "-o", "GlobalKnownHostsFile=/dev/null", "-o", "UpdateHostKeys=no",
    "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes",
    f"{user}@{host}", "env", "FETCH_IP=" + flag, "python3", "-",
]
try:
    started = time.monotonic()
    result = subprocess.run(cmd, input=REMOTE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=12, check=False, text=True)
except subprocess.TimeoutExpired:
    print('{"schema":0,"error":"timeout"}')
    raise SystemExit(0)
if result.returncode != 0:
    err = (result.stderr or "").lower()
    if "permission denied" in err:
        reason = "auth"
    elif "host key verification failed" in err or "remote host identification has changed" in err:
        reason = "host_key"
    elif "timed out" in err:
        reason = "timeout"
    elif "connection refused" in err:
        reason = "refused"
    elif "python3" in err and ("not found" in err or "no such file" in err):
        reason = "no_python"
    else:
        reason = "unreachable"
    print(json.dumps({"schema": 0, "error": reason}, separators=(",", ":")))
    raise SystemExit(0)
try:
    value = json.loads(result.stdout)
except json.JSONDecodeError:
    print('{"schema":0,"error":"format"}')
    raise SystemExit(0)
if not isinstance(value, dict) or value.get("schema") != 1:
    print('{"schema":0,"error":"format"}')
    raise SystemExit(0)
value["rtt_ms"] = round((time.monotonic() - started) * 1000, 1)
print(json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False))
"""

  source pulse = cmd(targetOk
    ? "printf '%s' ${sh(sshClient)} | python -I - ${sh(hostText)} ${sh(userText)} ${sh(str(int(portNumber)))} ${sh(idPath)} ${sh(fetchIp ? "1" : "0")}"
    : "printf '%s' '{\"schema\":0,\"error\":\"invalid_target\"}'") every 20s timeout 16s json
  source now = clock every 30s

  let ok = pulse != null && pulse.schema == 1
  let cpu = num(pulse.cpu_percent, -1)
  let mem = num(get(pulse.memory, "used_percent", null), -1)
  let gpuUtil = num(get(pulse.gpu, "util_percent", null), -1)
  let gpuMemUsed = num(get(pulse.gpu, "mem_used_mib", null), -1)
  let gpuMemTotal = num(get(pulse.gpu, "mem_total_mib", null), -1)
  let rootDisk = (pulse.storage ?? []).find(d => d.path == "/")
  let diskPct = num(get(rootDisk, "used_percent", null), -1)
  let dockerOk = get(pulse.docker, "ok", false) == true
  let dockerRunning = num(get(pulse.docker, "running", 0), 0)
  let dockerTotal = num(get(pulse.docker, "total", 0), 0)
  let dockerBad = num(get(pulse.docker, "unhealthy", 0), 0)
  let ip = pulse.public_ip ?? "—"
  let age = ok && pulse.checked_at != null ? max(0, now - pulse.checked_at) : null
  let fresh = ok && age != null && age <= 90
  let alert = fresh && (cpu > 90 || mem > 90 || diskPct > 90 || gpuUtil > 95 || dockerBad > 0)
  let statusColor = !ok ? red : alert ? red : fresh ? green : muted
  let err = pulse.error ?? ""
  let errText = err == "" ? "down"
    : err == "invalid_target" ? "set host & user"
    : err == "no_key" ? "key missing"
    : err == "auth" ? "auth failed"
    : err == "host_key" ? "accept host key"
    : err == "timeout" ? "timed out"
    : err == "refused" ? "refused"
    : err == "no_python" ? "needs python3"
    : err == "format" ? "bad reply"
    : err == "unreachable" ? "unreachable"
    : err
  let dockerPct = dockerTotal > 0 ? dockerRunning / dockerTotal * 100 : 0

  component Gauge(label, value, pct, tint = accent, warn = false) {
    let ink = warn ? red : (!fresh || pct < 0 ? muted : tint)
    Column {
      weight: 1
      gap: 2
      align: center
      Text { text: label; font: mono; fontSize: 8; color: muted; align: center; maxLines: 1 }
      Box {
        width: 52
        height: 52
        align: center
        Ring {
          value: max(0, pct)
          max: 100
          size: 52
          thickness: 4
          start: 225
          sweep: 270
          color: ink
          track: alpha(ink, 0.15)
          animate value: tween(500ms, "out")
        }
        Text {
          text: value
          font: mono
          fontSize: len(str(value)) > 4 ? 9 : 11
          color: ink
          align: center
          maxLines: 1
        }
      }
    }
  }

  onTap: screen()

  // One-row strip: host + gauged metrics across the full width.
  Row {
    gap: 6
    align: center
    fill: true
    Column {
      width: 64
      gap: 1
      Text { text: pulse.hostname ?? "HOST"; font: mono; fontSize: 11; color: foreground; maxLines: 1 }
      Text {
        text: !ok ? errText : alert ? "alert" : fresh ? "online" : "stale"
        font: mono
        fontSize: 9
        color: statusColor
        maxLines: 1
      }
    }
    Gauge { label: "CPU"; value: cpu < 0 ? "—" : "${round(cpu)}"; pct: cpu; warn: cpu > 90; tint: accent }
    Gauge { label: "GPU"; value: gpuUtil < 0 ? "—" : "${round(gpuUtil)}"; pct: gpuUtil; warn: gpuUtil > 95; tint: cyan }
    Gauge { label: "RAM"; value: mem < 0 ? "—" : "${round(mem)}"; pct: mem; warn: mem > 90; tint: blue }
    Gauge { label: "DISK"; value: diskPct < 0 ? "—" : "${round(diskPct)}"; pct: diskPct; warn: diskPct > 90; tint: accent }
    Gauge {
      label: "DOCKER"
      value: !ok || !dockerOk ? "—" : dockerBad > 0 ? "${dockerRunning}/${dockerTotal}!" : "${dockerRunning}/${dockerTotal}"
      pct: !ok || !dockerOk ? -1 : dockerPct
      warn: dockerBad > 0
      tint: green
    }
  }

  screen {
    title: pulse.hostname ?? "the host"
    Column {
      gap: 12
      padding: 14
      scroll: true
      fill: true

      Row {
        align: center
        Text {
          text: !ok ? "OFFLINE" : alert ? "ATTENTION" : "ONLINE"
          font: mono
          fontSize: 18
          color: statusColor
          weight: 1
        }
        Button {
          text: "REFRESH"
          onTap: refresh()
        }
      }
      Text {
        text: ok
          ? "RTT ${round(pulse.rtt_ms ?? 0)} ms · checked ${pulse.checked_at == null ? "—" : fmtTime(pulse.checked_at, "HH:mm:ss")} · up ${pulse.uptime_seconds == null ? "—" : fmtDuration(pulse.uptime_seconds)}"
          : "SSH: ${errText} · ${userText}@${hostText}:${port}"
        font: mono
        style: small
        color: muted
        maxLines: 2
      }
      if !ok && err == "host_key" {
        Text {
          text: "SSH to the host once from a terminal so its key is in ~/.ssh/known_hosts, then refresh."
          style: small
          color: muted
          maxLines: 3
        }
      }
      if !ok && err == "no_key" {
        Text {
          text: "Identity file not found. Set IDENTITY FILE below (default ~/.ssh/id_ed25519)."
          style: small
          color: muted
          maxLines: 3
        }
      }
      if !ok && err == "no_python" {
        Text {
          text: "The remote needs python3 on PATH. Install it on the host, then refresh."
          style: small
          color: muted
          maxLines: 3
        }
      }

      Text { text: "RESOURCES"; font: mono; style: label; color: accent }
      Grid {
        columns: 2
        gap: 8
        Column {
          gap: 4
          padding: 10
          background: surface
          radius: 6 * corners
          Text { text: "CPU"; style: small; color: muted }
          Text { text: cpu < 0 ? "—" : "${round(cpu)}%"; font: mono; fontSize: 22; color: cpu > 90 ? red : foreground }
          Text { text: pulse.load_1m == null ? "load —" : "load ${pulse.load_1m}"; style: small; color: muted }
          Progress { value: max(0, cpu); max: 100; height: 3; color: cpu > 90 ? red : accent }
        }
        Column {
          gap: 4
          padding: 10
          background: surface
          radius: 6 * corners
          Text { text: "GPU"; style: small; color: muted }
          Text { text: gpuUtil < 0 ? "—" : "${round(gpuUtil)}%"; font: mono; fontSize: 22; color: gpuUtil > 95 ? red : foreground }
          Text {
            text: pulse.gpu == null ? "no NVIDIA" : "${pulse.gpu.name ?? "GPU"} · ${gpuMemUsed < 0 ? "—" : round(gpuMemUsed)}/${gpuMemTotal < 0 ? "—" : round(gpuMemTotal)} MiB · ${pulse.gpu.temp_c == null ? "—" : pulse.gpu.temp_c + "°C"}"
            style: small
            color: muted
            maxLines: 2
          }
          Progress { value: max(0, gpuUtil); max: 100; height: 3; color: cyan }
        }
        Column {
          gap: 4
          padding: 10
          background: surface
          radius: 6 * corners
          Text { text: "RAM"; style: small; color: muted }
          Text { text: mem < 0 ? "—" : "${round(mem)}%"; font: mono; fontSize: 22; color: mem > 90 ? red : foreground }
          Text {
            text: get(pulse.memory, "total_bytes", null) == null ? "—" : "${fmtBytes(pulse.memory.used_bytes)} / ${fmtBytes(pulse.memory.total_bytes)}"
            style: small
            color: muted
          }
          Progress { value: max(0, mem); max: 100; height: 3; color: blue }
        }
        Column {
          gap: 4
          padding: 10
          background: surface
          radius: 6 * corners
          Text { text: "PUBLIC IP"; style: small; color: muted }
          Text { text: !fetchIp ? "off" : ip; font: mono; fontSize: 18; color: foreground; maxLines: 1 }
          Text {
            text: fetchIp ? "host curls ifconfig.me / ipify / icanhazip" : "enable below to look up from the host"
            style: small
            color: muted
            maxLines: 2
          }
        }
      }

      Text { text: "STORAGE"; font: mono; style: label; color: accent }
      if ok {
        for disk in (pulse.storage ?? []) {
          Column {
            gap: 4
            padding: 10
            background: surface
            radius: 6 * corners
            Row {
              Text { text: disk.label; font: mono; weight: 1; maxLines: 1 }
              Text {
                text: disk.used_percent == null ? "—" : "${round(disk.used_percent)}%"
                font: mono
                color: disk.used_percent > 90 ? red : foreground
              }
            }
            Text {
              text: disk.free_bytes == null ? disk.path : "${fmtBytes(disk.free_bytes)} free · ${disk.path}"
              style: small
              color: muted
              maxLines: 1
            }
            Progress { value: max(0, num(disk.used_percent, 0)); max: 100; height: 3; color: disk.used_percent > 90 ? red : accent }
          }
        }
        if len(pulse.storage ?? []) == 0 {
          Text { text: "no disks reported"; style: small; color: muted }
        }
      } else {
        Text { text: "connect to see disks"; style: small; color: muted }
      }

      Text { text: "DOCKER"; font: mono; style: label; color: accent }
      if !ok {
        Text { text: "connect to see containers"; style: small; color: muted }
      } else if !dockerOk {
        Text { text: "Docker not available for this SSH user"; style: small; color: muted; maxLines: 2 }
      } else {
        Text {
          text: "${dockerRunning} running / ${dockerTotal} total" + (dockerBad > 0 ? " · ${dockerBad} unhealthy or crashing" : "")
          style: small
          color: dockerBad > 0 ? red : muted
          maxLines: 2
        }
        for c in (pulse.docker.containers ?? []) {
          Row {
            padding: [8, 10]
            background: surface
            radius: 4 * corners
            Text { text: c.name; font: mono; weight: 1; maxLines: 1; color: c.bad ? red : foreground }
            Text { text: c.status; style: small; color: c.bad ? red : muted; width: 160; align: end; maxLines: 1 }
          }
        }
      }

      Text { text: "CONNECTION"; font: mono; style: label; color: accent }
      Text {
        text: "Uses your SSH key (BatchMode). Host needs python3; optional curl (public IP), nvidia-smi, docker."
        style: small
        color: muted
        maxLines: 3
      }
      Text { text: "HOST"; style: small; color: muted }
      Input { text: host; onChange: host = value }
      Text { text: "USER"; style: small; color: muted }
      Input { text: user; onChange: user = value }
      Text { text: "PORT"; style: small; color: muted }
      Input { text: port; onChange: port = value }
      Text { text: "IDENTITY FILE"; style: small; color: muted }
      Input { text: identity; onChange: identity = value }
      Row {
        align: center
        gap: 8
        Text { text: "PUBLIC IP LOOKUP"; style: small; color: muted; weight: 1; maxLines: 1 }
        Button {
          text: fetchIp ? "ON" : "OFF"
          color: fetchIp ? accent : muted
          onTap: fetchIp = !fetchIp
        }
      }
      if fetchIp {
        Text {
          text: "When on, each probe asks the host to curl a public-IP API (ifconfig.me, then ipify, then icanhazip)."
          style: small
          color: muted
          maxLines: 3
        }
      }
      Button { text: "CHECK NOW"; onTap: refresh() }
    }
  }
}
