widget "kOMA colors" {
  // The kOMA Colors panel widget from kOMA-desktop-theme, for the launcher: the four palette dots, and a tap opens
  // the picker that sets the current theme's accent and the widgets' borders to that color.
  meta { description: "Set the current theme's accent and widget borders to Tron Aqua, McLaren, Ferrari or Lambo"; version: "1.1"; license: "MIT"; category: "system"; owl: 11 }
  page: 1
  size: 1x1
  minSize: 1x1
  padding: 0

  // The color asked for, "reset" for the theme's own, or ""; the command below applies it, then it goes back to "".
  // A multi-line command with a value in it never runs, so a tap hands it over in a file instead: run() writes it,
  // then refreshes the widget once that's done, which runs the command.
  state want = ""

  // The stock theme stays as it is. The accent goes into a copy of it, <theme>-koma-<rrggbb> in
  // ~/.config/omarchy/themes (its colors.toml with the new accent, copies of the rest: the launcher skips symlinks,
  // and a stock theme's wallpapers are symlinks here, as are hard links in this Linux), and style.toml switches to
  // it: a new name each time, as the launcher reads a theme's colors when the theme changes. Widgets' outlines take the theme's border color, not its accent, so the color
  // goes into style.toml's [widgets] border too. "reset" goes back to the theme and its border; only the copy in
  // use is kept. Prints the state, with what was asked, so each answer differs from the last.
  source st = cmd("""
    want=$(cat ~/.cache/koma-colors.want 2>/dev/null); rm -f ~/.cache/koma-colors.want
    style=~/.config/omalauncher/style/style.toml
    themes=~/.config/omarchy/themes
    cur=$(awk -F'"' '/^theme *=/ {print $2; exit}' "$style")
    [ -n "$cur" ] || { echo "$want: no theme is set in style.toml" >&2; exit 1; }
    base=$(echo "$cur" | sed -E 's/-koma-[0-9a-f]{6}$//')
    dir() { if [ -d "$themes/$1" ]; then echo "$themes/$1"; else echo "$HOME/.local/share/omarchy/themes/$1"; fi; }
    acc() { awk -F'"' '/^accent *=/ {print toupper($2); exit}' "$(dir "$1")/colors.toml" 2>/dev/null; }
    use() { awk -v t="$1" -v q='"' '/^theme *=/ {print "theme = " q t q; next} {print}' "$style" > "$style.koma" && mv "$style.koma" "$style"; cur=$1; }
    outline() {
      awk -v c="$1" -v q='"' '
        /^ *[[]/ { w = ($0 == "[widgets]"); print; if (w && c != "") { print "border = " q c q; done = 1 }; next }
        w && /^ *border *=/ { next }
        { print }
        END { if (c != "" && !done) { print ""; print "[widgets]"; print "border = " q c q } }
      ' "$style" | awk 'NF { for (; blank > 0; blank--) print ""; print; next } { blank++ }' > "$style.koma"
      # An empty [widgets] table left at the end goes too.
      if [ "$(tail -1 "$style.koma")" = "[widgets]" ]; then sed -i '$d' "$style.koma"; sed -i -e :a -e '/^ *$/{$d;N;ba' -e '}' "$style.koma"; fi
      mv "$style.koma" "$style"
    }
    case "$want" in
      "") ;;
      reset) use "$base"; outline "" ;;
      *)
        echo "$want" | grep -Eqx '#[0-9A-Fa-f]{6}' || { echo "$want: not a color" >&2; exit 1; }
        src=$(dir "$base")
        [ -f "$src/colors.toml" ] || { echo "$want: theme $base has no colors.toml" >&2; exit 1; }
        name="$base-koma-$(echo "$want" | tr -d '#' | tr 'A-F' 'a-f')"
        if [ ! -d "$themes/$name" ]; then
          mkdir -p "$themes/$name"
          for f in "$src"/*; do
            [ "$(basename "$f")" = colors.toml ] || cp -rL "$f" "$themes/$name/"
          done
          awk -v a="$want" -v q='"' '/^accent *=/ {print "accent = " q a q; next} {print}' "$src/colors.toml" > "$themes/$name/colors.toml"
        fi
        use "$name"; outline "$(echo "$want" | tr 'a-f' 'A-F')" ;;
    esac
    for d in "$themes/$base"-koma-*; do
      [ -d "$d" ] && [ "$(basename "$d")" != "$cur" ] && rm -rf -- "$d"
    done
    printf '{"theme":"%s","accent":"%s","original":"%s","changed":%s,"asked":"%s"}' "$base" "$(acc "$cur")" "$(acc "$base")" "$([ "$cur" != "$base" ] && echo true || echo false)" "$want"
  """) every 10m json status

  let palettes = [
    {id: "tron", name: "Tron Aqua", color: "#23C8FF"},
    {id: "mclaren", name: "McLaren", color: "#FF8700"},
    {id: "ferrari", name: "Ferrari", color: "#FF3245"},
    {id: "lambo", name: "Lambo", color: "#68DC45"}
  ]
  let now = st.ok ? st.out : null
  let error = st != null && !st.ok ? st.err : ""
  let busy = want != ""
  let dot = floor(min(tileWidth ?? 60, tileHeight ?? 60) * 0.22)

  // The switch is done, or failed: what it printed shows.
  on st { want = "" }

  onTap: { refresh(); screen() }

  component Choice(name, swatch, picked) {
    Row {
      fill: width
      align: center
      gap: 12
      padding: [14, 12]
      radius: 12 * corners
      background: surface
      Box { size: 22; radius: 11; background: swatch }
      Text { text: name; weight: 1 }
      Text { text: picked ? "✓" : ""; color: accent; width: 20 }
    }
  }

  Box {
    fill: true
    align: center
    Column {
      align: center
      gap: floor(dot * 0.45)
      for pair in chunk(palettes, 2) {
        Row {
          align: center
          gap: floor(dot * 0.45)
          for p in pair { Box { size: dot; radius: dot / 2; background: p.color } }
        }
      }
    }
  }

  screen {
    title: "kOMA colors"
    Column {
      scroll: true
      gap: 8
      padding: 16
      Text { text: "the accent of ${now.theme ?? "the theme"}"; color: muted }
      for p in palettes key p.id {
        Box {
          fill: width
          opacity: busy ? 0.5 : 1
          onTap: {
            if !busy {
              want = p.color
              run("mkdir -p ~/.cache && printf %s ${sh(p.color)} > ~/.cache/koma-colors.want")
            }
          }
          Choice { name: p.name; swatch: p.color; picked: now.accent == p.color }
        }
      }
      // The theme's own accent, to switch back.
      Box {
        fill: width
        visible: now != null
        opacity: busy ? 0.5 : 1
        onTap: {
          if !busy {
            want = "reset"
            run("mkdir -p ~/.cache && printf reset > ~/.cache/koma-colors.want")
          }
        }
        Choice { name: "theme default"; swatch: now.original ?? muted; picked: now.changed == false }
      }
      Text { visible: busy; text: "updating…"; color: muted }
      Text { visible: error != ""; text: error; color: red }
    }
  }
}
