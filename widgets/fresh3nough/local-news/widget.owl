widget "local news" {
  size: 6x4
  minSize: 4x3
  meta {
    description: "Local + national headlines — neon cyberpunk tile. ZIP/city or IP; Fox, NBC, CNN, Breitbart, The Hill, NY Post"
    version: "2.2"
    license: "MIT"
    category: "news"
    owl: 8
  }

  requires { pacman: ["python"] }



  // goose cyberpunk neon palette — bright surfaces that pop
  let void = #050510
  let panel = #0a0a18
  let ink = #0a0a0a
  let neon = #00e5ff
  let neonPink = #ff2bd6
  let neonOrange = #ff6b00
  let neonLime = #39ff14
  let neonYellow = #fff200
  let neonRed = #ff2a2a
  let neonPurple = #c084fc
  let neonBlue = #00b8d4
  let textHi = #fff200
  let textMid = #ffe066
  let textDim = #b8ff00
  let upColor = #39ff14
  let downColor = #ff2bd6
  let warnColor = #ff6b00

  background: void

  // ZIP or city/region. Empty = IP geolocation for the local tab.
  state place = "" persist
  state tab = "local" persist
  state seen = [] persist

  // One fetch: Google News for the user's place + national desks. Merged, newest first.
  // sh(place) is concatenated outside the script string so owl interpolates it (store pattern).
  source now = clock every 60s
  source news = cmd("""
python3 -c '
import json, re, sys, time, html, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor, wait
from email.utils import parsedate_to_datetime
UA = {"User-Agent": "omalauncher local-news widget"}
PLACE = sys.argv[1] if len(sys.argv) > 1 else ""
def get(url, timeout=10):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()
def resolve_place(raw):
    raw = (raw or "").strip()
    if re.fullmatch(r"\d{5}(-\d{4})?", raw):
        z = raw[:5]
        try:
            j = json.loads(get("https://api.zippopotam.us/us/" + z, 8).decode())
            p = (j.get("places") or [{}])[0]
            city = p.get("place name") or ""
            state = p.get("state") or ""
            label = ", ".join(x for x in (city, state) if x) or z
            return label, (city + " " + state + " " + z).strip()
        except Exception:
            return z, z
    if raw:
        return raw, raw
    try:
        j = json.loads(get("https://ipwho.is/", 8).decode())
        if j.get("success") is False:
            raise RuntimeError(j.get("message") or "ip")
        city = j.get("city") or ""
        region = j.get("region") or j.get("region_code") or ""
        country = j.get("country_code") or j.get("country") or ""
        label = ", ".join(x for x in (city, region) if x) or country or "near you"
        q = " ".join(x for x in (city, region, country) if x) or "United States"
        return label, q
    except Exception:
        return "near you", "United States"
label, query = resolve_place(PLACE)
q = urllib.parse.quote_plus(query + " -football -basketball -baseball -soccer -hockey -nfl -nba -mlb")
local_url = "https://news.google.com/rss/search?q=%s&hl=en-US&gl=US&ceid=US:en" % q
FEEDS = [
    ("local", 0, "", local_url, 14),
    ("nation", 2, "fox", "https://moxie.foxnews.com/google-publisher/latest.xml", 5),
    ("nation", 3, "nbc", "https://feeds.nbcnews.com/nbcnews/public/news", 5),
    ("nation", 6, "cnn", "http://rss.cnn.com/rss/cnn_topstories.rss", 5),
    ("nation", 1, "breitbart", "https://feeds.feedburner.com/breitbart", 5),
    ("nation", 5, "the hill", "https://thehill.com/homenews/feed/", 5),
    ("nation", 7, "ny post", "https://nypost.com/feed/", 5),
]
def when(s):
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        return 0
def cdata(s):
    s = s.strip()
    if s.startswith("<![CDATA["): s = s[9:]
    if s.endswith("]]>"): s = s[:-3]
    return s
def field(block, *tags):
    for t in tags:
        m = re.search("<" + t + "[^>]*>(.*?)</" + t + ">", block, re.S)
        if m: return cdata(m.group(1))
    return ""
def clean(s):
    return " ".join(html.unescape(re.sub("<[^>]+>", "", s)).split())
def fetch(item):
    tab, c, src_label, url, n = item
    out = []
    try:
        data = get(url).decode("utf-8", "replace")
    except Exception:
        return out
    for block in re.findall("<item[ >].*?</item>", data, re.S):
        title = clean(field(block, "title"))
        link = field(block, "link").strip()
        at = when(field(block, "pubDate", "dateTimeWritten"))
        src = src_label
        if not src:
            m = re.match(r"(.*) - (.+)$", title)
            if m: title, src = m.group(1).strip(), m.group(2).strip()
        if not title or not link.lower().startswith(("http://", "https://")):
            continue
        out.append({"tab": tab, "c": c, "title": title, "url": link, "at": at, "src": src})
        if len(out) >= n: break
    return out
pool = ThreadPoolExecutor(8)
futs = [pool.submit(fetch, f) for f in FEEDS]
wait(futs, timeout=25)
all_items = [p for f in futs if not f.exception() for p in f.result()]
seen, uniq = set(), []
for p in sorted(all_items, key=lambda p: -p["at"]):
    if p["url"] not in seen:
        seen.add(p["url"]); uniq.append(p)
print(json.dumps({
    "at": int(time.time()), "place": label, "query": query,
    "local": [p for p in uniq if p["tab"] == "local"],
    "nation": [p for p in uniq if p["tab"] == "nation"],
}))
'
  """ + " ${sh(place)}") every 15m json timeout 45s
  on place { refresh() }

  let tints = [neon, neonOrange, neonRed, neonBlue, upColor, neonPink, neon, neonYellow]
  let cur = tab == "nation" ? "nation" : "local"
  let items = (cur == "nation" ? news.nation : news.local) ?? []
  let where = news.place ?? (place != "" ? place : "…")
  let slim = (cols ?? 6) < 5

  component Tab(id, label, tint, big = false) {
    Column {
      gap: 2
      weight: 1
      Text {
        text: label; align: center; maxLines: 1
        fontSize: big ? 16 : slim ? 11 : 12
        bold: cur == id
        color: cur == id ? tint : textDim
        onTap: tab = id
      }
      Spacer { height: 2; fill: width; background: cur == id ? tint : alpha(textDim, 0.0) }
    }
  }

  component Post(p, big = false) {
    Column {
      gap: 1
      onTap: { seen = indexOf(seen, p.url) >= 0 ? seen : take(flatten([[p.url], seen]), 150); url(p.url) }
      Text {
        text: p.title
        fontSize: big ? 16 : 13
        maxLines: big ? 3 : 2
        color: indexOf(seen, p.url) >= 0 ? textDim : textHi
      }
      Row {
        gap: 6
        Text { text: p.src; fontSize: big ? 12 : 10; color: tints[p.c]; maxLines: 1; weight: 1 }
        Text {
          text: p.at == 0 ? "" : now - p.at < 3600 ? "${max(floor((now - p.at) / 60), 1)}m" : now - p.at < 86400 ? "${floor((now - p.at) / 3600)}h" : "${floor((now - p.at) / 86400)}d"
          fontSize: big ? 12 : 10; color: textDim; width: big ? 34 : 30; align: end
        }
      }
    }
  }

  component Posts(big = false) {
    Column {
      scroll: true
      gap: big ? 12 : 7
      if news == null {
        Text { text: "loading headlines…"; style: small; color: textDim }
      } else if len(items) == 0 {
        Text { text: "no headlines · tap to retry"; style: small; color: textDim; onTap: refresh() }
      }
      for p in take(items, big ? 40 : 12) key p.url {
        Post { p: p; big: big }
      }
    }
  }

  Box { /* neon-wrap */
    fill: true
    background: void
    border: 2
    borderColor: neon
    radius: 12
    padding: 4

  Column {
    gap: 4
    Row {
      gap: 6
      align: center
      Text { text: "news"; style: label; color: neonPink; width: 40; maxLines: 1 }
      Tab { id: "local"; label: "local"; tint: neon }
      Tab { id: "nation"; label: "nation"; tint: neon }
      Canvas {
        width: 22; height: 16
        onTap: screen()
        rect(7, 3, 10, 10, stroke: textDim, width: 1.5)
      }
    }
    if cur == "local" {
      Text { text: where; style: label; color: textDim; maxLines: 1 }
    }
    Posts { weight: 1 }
  }
  }

  screen {
    title: "local news"
    Box {
      fill: true
      background: void
      border: 1.5
      borderColor: neonPink
      radius: 12
      padding: 10
    Column {
      gap: 10
      Row {
        gap: 24
        align: center
        Tab { id: "local"; label: "local"; tint: neon; big: true }
        Tab { id: "nation"; label: "nation"; tint: neon; big: true }
        Spacer { weight: 1 }
        if news != null {
          Text { text: "updated ${fmtTime(news.at, "HH:mm")}"; style: small; color: textDim }
        }
      }
      Input {
        text: place
        placeholder: "ZIP or city · empty = IP"
        onSubmit: { place = trim(value); refresh() }
      }
      Text {
        text: place != "" ? "local · ${where}" : "local · ${where} (IP)"
        style: label
        color: textDim
      }
      Posts { big: true; weight: 1 }
      Row {
        gap: 8
        Button { text: "refresh"; onTap: refresh() }
        Spacer { weight: 1 }
        Button { text: "close"; color: textDim; onTap: close() }
      }
    }
    }
  }
}
