widget "pelosi trades" {
  size: 6x6
  minSize: 4x4
  padding: 10
  meta {
    description: "Nancy Pelosi House STOCK Act filings (Periodic Transaction Reports) with live quotes on disclosed tickers Denser neon activity summary and sharper trade rows."
    version: "1.4"
    license: "MIT"
    category: "finance"
    owl: 5
  }
  requires { pacman: ["python", "poppler"] }

  // goose cyberpunk neon palette — bright surfaces that pop
  let void = #050510
  let panel = #0a0a18
  let ink = #0a0a0a
  let neon = #00e5ff
  let neonPink = #ff2bd6
  let neonOrange = #ff6b00
  let neonLime = #39ff14
  let neonYellow = #fff200
  let neonRed = #ff2a2a
  let neonPurple = #c084fc
  let neonBlue = #00b8d4
  let textHi = #fff200
  let textMid = #ffe066
  let textDim = #b8ff00
  let upColor = #39ff14
  let downColor = #ff2bd6
  let warnColor = #ff6b00

  background: void



  source data = cmd("""
python3 - <<'PY'
import io, json, os, re, subprocess, time, urllib.request, urllib.error, zipfile
from collections import defaultdict
from datetime import date
from pathlib import Path

CACHE = Path.home() / ".cache" / "omalauncher-pelosi-trades.json"
CACHE.parent.mkdir(parents=True, exist_ok=True)
UA = "Mozilla/5.0 (omalauncher pelosi-trades widget)"
CLERK = "https://disclosures-clerk.house.gov"

# STOCK Act amount ranges → midpoint USD
RANGES = [
    (1, 1000, 500),
    (1001, 15000, 8000),
    (15001, 50000, 32500),
    (50001, 100000, 75000),
    (100001, 250000, 175000),
    (250001, 500000, 375000),
    (500001, 1000000, 750000),
    (1000001, 5000000, 3000000),
    (5000001, 25000000, 15000000),
    (25000001, 50000000, 37500000),
    (50000001, None, 50000001),
]

def get(url, timeout=22, accept="*/*"):
    last = None
    for i in range(3):
        try:
            req = urllib.request.Request(url, headers={
                "User-Agent": UA,
                "Accept": accept,
                "Accept-Language": "en-US,en;q=0.9",
            })
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read()
        except Exception as e:
            last = e
            time.sleep(0.4 + i)
    raise last if last else RuntimeError("fetch failed")

def fnum(s):
    if s is None:
        return None
    try:
        return float(str(s).replace(",", "").replace("%", "").replace("+", "").strip())
    except Exception:
        return None

def load_cache(max_age=None):
    try:
        if not CACHE.exists():
            return None
        age = time.time() - CACHE.stat().st_mtime
        if max_age is not None and age > max_age:
            return None
        d = json.loads(CACHE.read_text())
        if d.get("trades") is not None:
            return d
    except Exception:
        pass
    return None

def save_cache(d):
    try:
        CACHE.write_text(json.dumps(d))
    except Exception:
        pass

def money(n):
    if n is None:
        return None
    a = abs(n)
    if a >= 1e9:
        return round(n / 1e9, 2)
    if a >= 1e6:
        return round(n / 1e6, 2)
    if a >= 1e3:
        return round(n / 1e3, 1)
    return round(n, 0)

def money_u(n):
    if n is None:
        return ""
    a = abs(n)
    if a >= 1e9:
        return "B"
    if a >= 1e6:
        return "M"
    if a >= 1e3:
        return "K"
    return ""

def parse_amount(blob):
    '''Parse '$15,001 - $50,000' or split across lines into midpoint + display range.'''
    s = re.sub(r"\s+", " ", blob or "")
    nums = [int(x.replace(",", "")) for x in re.findall(r"\$?\s*([0-9][0-9,]*)", s)]
    nums = [n for n in nums if n >= 1]
    if not nums:
        return None, ""
    if len(nums) == 1:
        lo = hi = nums[0]
    else:
        lo, hi = nums[0], nums[1]
    mid = None
    for a, b, m in RANGES:
        if lo >= a and (b is None or hi <= b or lo <= (b or lo)):
            # prefer exact band match
            if lo == a and (b is None or hi == b):
                mid = m
                break
    if mid is None:
        mid = (lo + hi) / 2 if hi else lo
    if hi and hi != lo:
        rng = "$" + f"{lo:,}" + "–$" + f"{hi:,}"
    else:
        rng = "$" + f"{lo:,}"
    return float(mid), rng

def iso_date(mmddyyyy):
    m = re.match(r"(\d{1,2})/(\d{1,2})/(\d{4})", (mmddyyyy or "").strip())
    if not m:
        return ""
    mo, d, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return f"{y:04d}-{mo:02d}-{d:02d}"

def ticker_from(asset):
    # Prefer (TICKER) just before an asset-type code [ST]/ OT …]
    s = asset or ""
    m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)\s*\[[A-Z]{2}\]", s)
    if m:
        return m.group(1)
    m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)", s)
    if not m:
        return ""
    tkr = m.group(1)
    # Asset-type codes and junk that appear in PTR text
    if tkr in {"ST", "OP", "OT", "AB", "GS", "PS", "CS", "EF", "MF", "PK", "OL", "SP", "JT", "DC", "SC", "PTR", "LLC", "INC", "THE"}:
        return ""
    return tkr

def side_from(type_tok, desc):
    t = (type_tok or "").strip().upper()
    d = (desc or "").lower()
    if t.startswith("P") and "partial" not in t.lower():
        return "Buy", True, False
    if t.startswith("S"):
        return ("Sale (partial)" if "partial" in t.lower() or "partial" in d else "Sale"), False, True
    if "purchas" in d or "bought" in d or "exercise" in d:
        return "Buy", True, False
    if "sale" in d or "sold" in d or "contribution" in d:
        return "Sale", False, True
    return (type_tok or "—")[:12], False, False

def list_ptrs(years):
    '''Pelosi PTR DocIDs from the clerk's yearly FD zip index.'''
    out = []
    for year in years:
        try:
            raw = get(f"{CLERK}/public_disc/financial-pdfs/{year}FD.zip")
            z = zipfile.ZipFile(io.BytesIO(raw))
            name = next(n for n in z.namelist() if n.lower().endswith(".txt"))
            txt = z.read(name).decode("utf-8", "replace")
            for line in txt.splitlines()[1:]:
                parts = line.split("\t")
                if len(parts) < 9:
                    continue
                last, first, ftype = parts[1].strip(), parts[2].strip(), parts[4].strip()
                y, fdate, doc = parts[6].strip(), parts[7].strip(), parts[8].strip()
                if last.lower() != "pelosi":
                    continue
                if ftype != "P":  # Periodic Transaction Report
                    continue
                try:
                    yi = int(y)
                except Exception:
                    yi = year
                out.append({"year": yi, "filed": fdate, "doc": doc, "iso": iso_date(fdate)})
        except Exception:
            continue
    # newest first
    out.sort(key=lambda p: (p["iso"], p["doc"]), reverse=True)
    # unique doc
    seen, uniq = set(), []
    for p in out:
        if p["doc"] in seen:
            continue
        seen.add(p["doc"])
        uniq.append(p)
    return uniq

def pdf_text(year, doc):
    url = f"{CLERK}/public_disc/ptr-pdfs/{year}/{doc}.pdf"
    pdf = get(url, timeout=30)
    r = subprocess.run(
        ["pdftotext", "-layout", "-", "-"],
        input=pdf,
        capture_output=True,
        timeout=30,
    )
    if r.returncode != 0:
        # fallback via temp not needed; try again with file
        tmp = Path("/tmp") / f"owl-pelosi-{doc}.pdf"
        tmp.write_bytes(pdf)
        r = subprocess.run(["pdftotext", "-layout", str(tmp), "-"], capture_output=True, timeout=30)
    return (r.stdout or b"").decode("utf-8", "replace")

def parse_ptr(text, meta):
    '''Pull trade rows out of a layout-mode PTR text dump.'''
    # Drop certification / header noise
    lines = [re.sub(r"[ \t]+$", "", ln) for ln in text.splitlines()]
    body = "\n".join(lines)
    # Owner token + asset blob ending in [XX], then type letter(s), two dates, amount
    # Amount often wraps to the next line.
    trades = []
    # Find blocks starting with SP/JT/DC etc.
    # Collapse whitespace variants
    chunks = re.split(r"\n(?=\s*(?:SP|JT|DC|SC)\s{2,})", body)
    for ch in chunks:
        if not re.match(r"\s*(?:SP|JT|DC|SC)\s", ch):
            continue
        # stop at cert / footnotes
        if "I CERTIFY" in ch:
            ch = ch.split("I CERTIFY")[0]
        if "* For the complete list" in ch:
            ch = ch.split("* For the complete list")[0]
        flat = re.sub(r"[ \t]*\n[ \t]*", "\n", ch).strip()
        # Asset: from after owner token to ticker/[CODE]
        m = re.search(
            r"(SP|JT|DC|SC)\s+(.*?)\s+(P|S(?:\s*\(partial\))?)\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\$?[\d,].*)$",
            flat.replace("\n", "  "),
            re.S,
        )
        if not m:
            # try looser: asset then type then one date
            m2 = re.search(
                r"(SP|JT|DC|SC)\s+(.+?)\s+(P|S(?:\s*\(partial\))?)\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\d{1,2}/\d{1,2}/\d{4})(.*)$",
                re.sub(r"\s+", " ", flat),
                re.S,
            )
            if not m2:
                continue
            owner, asset, typ, tdate, ndate, rest = m2.groups()
        else:
            owner, asset, typ, tdate, ndate, rest = m.groups()
        asset = re.sub(r"\s+", " ", asset).strip()
        # description lines F/S/D
        desc_m = re.findall(r"\bD\s*:\s*(.+)", flat)
        desc = " ".join(re.sub(r"\s+", " ", d).strip() for d in desc_m)[:160]
        # amount: dollars in rest + following lines of original chunk
        amt_blob = rest + " " + " ".join(
            ln for ln in ch.splitlines() if "$" in ln or re.search(r"\d,\d{3}", ln)
        )
        usd, rng = parse_amount(amt_blob)
        # Ticker often wraps onto the next layout line: "Common Stock (BE) [ST]"
        tkr = ticker_from(asset)
        if not tkr:
            # wrapped layout: ticker often sits on the next line with [ST]/]
            m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)\s*\[[A-Z]{2}\]", flat)
            if m and m.group(1) not in {"ST", "OP", "OT", "AB", "GS", "PS"}:
                tkr = m.group(1)
        side, is_buy, is_sell = side_from(typ, desc)
        # asset type code [ST]/ OT AB]
        at = ""
        am = re.search(r"\[([A-Z]{2})\]\s*$", asset)
        if am:
            at = am.group(1)
            asset = re.sub(r"\s*\[[A-Z]{2}\]\s*$", "", asset).strip()
        name = re.sub(r"\s*\([A-Z][A-Z0-9.\-]{0,9}\)\s*", " ", asset)
        name = re.sub(r"\s+", " ", name).strip()[:36]
        trades.append({
            "t": tkr if tkr else "—",
            "side": side,
            "buy": is_buy,
            "sell": is_sell,
            "filed": iso_date(meta.get("filed") or ndate),
            "date": iso_date(tdate),
            "desc": desc,
            "name": name or tkr or "—",
            "type": at or "",
            "rng": rng,
            "usd": usd,
            "doc": meta.get("doc") or "",
            "year": meta.get("year"),
        })
    return trades

def quotes(syms):
    if not syms:
        return {}
    joined = "|".join(syms[:12])
    url = (
        "https://quote.cnbc.com/quote-html-webservice/restQuote/symbolType/symbol"
        f"?symbols={joined}&requestMethod=itv&noform=1&partnerId=2&fund=1&exthdr=1&output=json"
    )
    raw = get(url, accept="application/json").decode("utf-8", "replace")
    if raw.startswith("//"):
        raw = raw[2:]
    m = re.match(r"^[^(]*\((.*)\)\s*;?\s*$", raw, re.S)
    if m:
        raw = m.group(1)
    data = json.loads(raw)
    qs = data.get("FormattedQuoteResult", {}).get("FormattedQuote", [])
    if isinstance(qs, dict):
        qs = [qs]
    out = {}
    for q in qs:
        sym = q.get("symbol") or ""
        last = fnum(q.get("last"))
        pct = fnum(q.get("change_pct"))
        chg = fnum(q.get("change"))
        if last is None:
            continue
        out[sym] = {
            "px": round(last, 2),
            "pct": round(pct, 2) if pct is not None else None,
            "chg": round(chg, 2) if chg is not None else None,
            "up": (pct is not None and pct >= 0) or (chg is not None and chg >= 0),
        }
    return out

def spark(sym, span="3M"):
    try:
        raw = get(
            f"https://ts-api.cnbc.com/harmony/app/charts/{span}.json?symbol={sym}",
            accept="application/json",
        )
        d = json.loads(raw)
        bars = (d.get("barData") or {}).get("priceBars") or []
        closes = []
        for b in bars:
            c = fnum(b.get("close"))
            if c is not None:
                closes.append(round(c, 2))
        if len(closes) > 42:
            step = max(1, len(closes) // 42)
            closes = closes[::step][:42]
        return closes
    except Exception:
        return []

def build():
    today = date.today()
    years = list(range(today.year, today.year - 4, -1))
    ptrs = list_ptrs(years)
    if not ptrs:
        raise RuntimeError("no Pelosi PTRs in clerk index")

    # Parse the newest ~14 PTRs (enough history without hammering the clerk)
    trades = []
    errors = []
    for meta in ptrs[:14]:
        try:
            text = pdf_text(meta["year"], meta["doc"])
            rows = parse_ptr(text, meta)
            trades.extend(rows)
        except Exception as e:
            errors.append(f"{meta['doc']}:{str(e)[:40]}")
            continue

    # newest first
    trades.sort(key=lambda t: (t.get("date") or "", t.get("filed") or ""), reverse=True)

    # decorate money fields
    for t in trades:
        t["mu"] = money(t["usd"])
        t["mu_u"] = money_u(t["usd"])

    eq = [t for t in trades if t["t"] != "—"]
    vol = sum(t["usd"] or 0 for t in trades)
    buys_n = sum(1 for t in trades if t["buy"])
    sells_n = sum(1 for t in trades if t["sell"])

    # holdings-ish: net disclosed buy notional per ticker (not a true book)
    hold = defaultdict(lambda: {"usd": 0.0, "n": 0, "name": "", "buys": 0, "sells": 0})
    for t in eq:
        h = hold[t["t"]]
        h["name"] = t["name"] or t["t"]
        if t["buy"]:
            h["usd"] += t["usd"] or 0
            h["buys"] += 1
            h["n"] += 1
        elif t["sell"]:
            h["sells"] += 1
            h["n"] += 1
            # don't subtract sale ranges - STOCK Act ranges are too coarse for netting

    holdings = []
    for tkr, h in hold.items():
        if h["buys"] == 0 and h["usd"] == 0:
            continue
        holdings.append({
            "t": tkr,
            "name": (h["name"] or tkr)[:22],
            "usd": h["usd"],
            "n": h["n"],
            "buys": h["buys"],
            "sells": h["sells"],
            "mu": money(h["usd"]),
            "mu_u": money_u(h["usd"]),
        })
    holdings.sort(key=lambda x: -x["usd"])
    top = holdings[:10]

    # live quotes + sparks for top tickers
    qmap = {}
    try:
        qmap = quotes([h["t"] for h in top[:8] if re.match(r"^[A-Z]", h["t"])])
    except Exception:
        qmap = {}

    p_sparks = []
    for h in top[:8]:
        q = qmap.get(h["t"]) or {}
        h["px"] = q.get("px")
        h["dpct"] = q.get("pct")
        h["dup"] = q.get("up", True)
        try:
            sp = spark(h["t"], "3M") if h["t"] in qmap else []
        except Exception:
            sp = []
        h["spark"] = sp
        if len(sp) > 5:
            p_sparks.append(sp)

    pchart = []
    if p_sparks:
        n = min(len(s) for s in p_sparks)
        norms = []
        for s in p_sparks:
            s = s[-n:]
            base = s[0] or 1.0
            norms.append([100.0 * x / base for x in s])
        pchart = [
            round(sum(norms[j][i] for j in range(len(norms))) / len(norms), 2)
            for i in range(n)
        ]

    day_pcts = [h["dpct"] for h in top if h.get("dpct") is not None]
    day = round(sum(day_pcts) / len(day_pcts), 2) if day_pcts else None

    # monthly filing volume path (not return)
    months = defaultdict(float)
    for t in trades:
        if t.get("date") and t.get("usd"):
            months[t["date"][:7]] += t["usd"]
    keys = sorted(months.keys())[-18:]
    chart = [round(months[k] / 1e6, 2) for k in keys]  # $$M

    recent = []
    for t in trades[:12]:
        recent.append({
            "t": t["t"],
            "side": t["side"],
            "buy": t["buy"],
            "date": t["date"],
            "name": t["name"],
            "rng": t["rng"],
            "mu": t["mu"],
            "mu_u": t["mu_u"],
            "desc": t["desc"],
        })

    return {
        "at": int(time.time()),
        "who": "Nancy Pelosi",
        "n": len(trades),
        "ptrs": len(ptrs),
        "buys_n": buys_n,
        "sells_n": sells_n,
        "vol": vol,
        "vol_m": money(vol),
        "vol_u": money_u(vol),
        "day": day,
        "day_up": day is None or day >= 0,
        "chart": chart,
        "pchart": pchart,
        "holdings": top,
        "recent": recent,
        "trades": [
            {
                "t": t["t"],
                "side": t["side"],
                "buy": t["buy"],
                "date": t["date"],
                "filed": t["filed"],
                "name": t["name"],
                "rng": t["rng"],
                "mu": t["mu"],
                "mu_u": t["mu_u"],
                "type": t["type"],
                "desc": t["desc"],
                "doc": t["doc"],
                "year": t.get("year"),
            }
            for t in trades[:60]
        ],
        "src": "house-clerk",
        "err": ("; ".join(errors))[:80] if errors and not trades else "",
    }

# Prefer fresh cache (<25m)
fresh = load_cache(max_age=25 * 60)
if fresh and not os.environ.get("PELOSI_FORCE"):
    fresh = dict(fresh)
    fresh["err"] = fresh.get("err") or ""
    print(json.dumps(fresh))
else:
    try:
        out = build()
        save_cache(out)
    except Exception as e:
        cached = load_cache(max_age=None)
        if cached:
            cached = dict(cached)
            cached["err"] = str(e)[:80] or "cached"
            out = cached
        else:
            out = {
                "at": int(time.time()),
                "who": "Nancy Pelosi",
                "err": str(e)[:100],
                "holdings": [],
                "recent": [],
                "trades": [],
                "chart": [],
                "pchart": [],
                "vol_m": None,
                "n": 0,
                "buys_n": 0,
                "sells_n": 0,
                "day": None,
                "day_up": True,
            }
    print(json.dumps(out))
PY
""") every 15m json timeout 120s

  source now = clock every 60s

  let holdings = data.holdings ?? []
  let recent = data.recent ?? []
  let trades = data.trades ?? []
  let chart = data.pchart ?? []
  let path = data.chart ?? []
  let use_chart = len(chart) > 3 ? chart : path
  let lo = len(use_chart) > 0 ? min(use_chart) : null
  let hi = len(use_chart) > 0 ? max(use_chart) : null
  let age = data == null || data.at == null ? null : now - data.at
  let book_up = data.day_up != false
  state tab = "activity"



  component Gavel() {
    // Sharp neon gavel badge — reads at 28–36px (head + handle + strike plate)
    Canvas {
      width: 32
      height: 32
      // outer badge ring
      circle(16, 16, 15, fill: mix(void, neon, 0.18))
      circle(16, 16, 15, stroke: neon, width: 1.6)
      circle(16, 16, 12.4, stroke: alpha(neonPink, 0.55), width: 0.9)

      // gavel head (horizontal block) — bright yellow, hard edges
      rect(6.5, 9.5, 15, 6.2, radius: 1.2, fill: neonYellow)
      rect(6.5, 9.5, 15, 6.2, radius: 1.2, stroke: mix(neonYellow, neonOrange, 0.4), width: 0.8)
      // head end-caps (mallet faces)
      rect(5.2, 8.6, 3.2, 8, radius: 0.8, fill: neonOrange)
      rect(19.6, 8.6, 3.2, 8, radius: 0.8, fill: neonOrange)
      // center band on head
      rect(12.2, 9.5, 3.6, 6.2, fill: mix(neonYellow, ink, 0.25))

      // handle shaft (angled via stepped rects for clarity at small size)
      rect(14.2, 15.2, 3.4, 10.5, radius: 0.6, fill: textHi)
      rect(14.2, 15.2, 3.4, 10.5, radius: 0.6, stroke: neonYellow, width: 0.6)

      // pommel / grip tip
      rect(13.4, 25.2, 5, 2.4, radius: 1, fill: neonOrange)
      rect(13.4, 25.2, 5, 2.4, radius: 1, stroke: neonYellow, width: 0.5)

      // strike plate / sound block (bottom-left)
      rect(7, 24.5, 7.5, 3.2, radius: 0.8, fill: mix(neon, neonBlue, 0.45))
      rect(7, 24.5, 7.5, 3.2, radius: 0.8, stroke: neon, width: 0.7)

      // tiny highlight spark on head
      circle(10.2, 11.2, 1.1, fill: #ffffff)
    }
  }

  component StatPill(label, value, tint = textHi) {
    Column {
      gap: 1
      align: center
      weight: 1
      background: alpha(panel, 0.9)
      border: 1
      borderColor: alpha(tint, 0.85)
      radius: 7
      padding: [4, 5]
      Text {
        text: label
        style: label
        color: textDim
        align: center
        maxLines: 1
      }
      Text {
        text: value
        style: small
        bold: true
        color: tint
        align: center
        maxLines: 1
        font: mono
      }
    }
  }

  component TradeRow(t) {
    Row {
      gap: 6
      align: center
      height: 30
      background: alpha(panel, 0.92)
      border: 1
      borderColor: alpha(t.buy ? upColor : downColor, 0.35)
      radius: 6
      padding: [0, 6]
      // neon buy/sell chip
      Box {
        width: 42
        height: 18
        radius: 4
        background: alpha(t.buy ? upColor : downColor, 0.22)
        border: 1
        borderColor: t.buy ? upColor : downColor
        align: center
        Text {
          text: t.buy ? "BUY" : "SELL"
          fontSize: 10
          bold: true
          align: center
          color: t.buy ? upColor : downColor
          maxLines: 1
          font: mono
        }
      }
      Text {
        text: t.t ?? "—"
        style: small
        bold: true
        color: neon
        width: 52
        maxLines: 1
        font: mono
      }
      Text {
        text: t.date != "" ? sub(t.date, 5, 10) : "—"
        style: small
        color: textDim
        width: 42
        maxLines: 1
        font: mono
      }
      Text {
        text: t.mu == null ? (t.rng ?? "—") : "$${t.mu}${t.mu_u}"
        style: small
        bold: true
        color: textHi
        weight: 1
        align: end
        maxLines: 1
        font: mono
      }
    }
  }

  component HoldRow(h) {
    Row {
      gap: 6
      align: center
      height: 28
      background: alpha(panel, 0.85)
      border: 1
      borderColor: alpha(neon, 0.28)
      radius: 6
      padding: [0, 6]
      Text {
        text: h.t ?? "—"
        style: small
        bold: true
        color: neon
        width: 48
        maxLines: 1
        font: mono
      }
      Text {
        text: h.name ?? ""
        style: small
        color: textDim
        weight: 1
        maxLines: 1
      }
      if h.spark != null && len(h.spark) > 3 {
        let slo = min(h.spark)
        let shi = max(h.spark)
        Sparkline {
          values: h.spark
          min: slo
          max: shi
          color: h.dup ? upColor : downColor
          area: true
          thickness: 1.2
          width: 44
          height: 16
        }
      }
      Text {
        text: h.dpct == null ? "—" : "${h.dup ? "+" : ""}${fixed(h.dpct, 1)}%"
        style: small
        bold: true
        width: 54
        align: end
        maxLines: 1
        font: mono
        color: h.dpct == null ? textDim : (h.dup ? upColor : downColor)
      }
      Text {
        text: h.mu == null ? "—" : "$${h.mu}${h.mu_u}"
        style: small
        width: 58
        align: end
        font: mono
        maxLines: 1
        color: textHi
      }
    }
  }

let th = tileHeight ?? 0
  let tw = tileWidth ?? 0
  let tiny = th > 0 && th < 160
  let compact = th > 0 && th < 300
  let dense = th > 0 && th < 520
  let gapMain = tiny ? 2 : dense ? 4 : 8
  let padWrap = tiny ? 3 : dense ? 4 : 6
  let sparkH = tiny ? 0 : compact ? 22 : dense ? 28 : 40
  // Pack as many fixed-height rows as the tile can hold (no empty flex void).
  let maxTrades = tiny ? 5 : compact ? 10 : dense ? 16 : 18
  let showHoldStrip = !tiny && !compact && len(holdings) > 0
  let buysN = data.buys_n ?? 0
  let sellsN = data.sells_n ?? 0
  let bsTotal = buysN + sellsN
  let buyPct = bsTotal > 0 ? (100.0 * buysN / bsTotal) : 50
  let latest = len(trades) > 0 ? trades[0] : null
  let latestLine = latest == null ? "awaiting house PTR scrape…"
    : "${latest.buy ? "BUY" : "SELL"} ${latest.t} · ${latest.mu == null ? (latest.rng ?? "—") : "$${latest.mu}${latest.mu_u}"} · ${latest.date != "" ? sub(latest.date, 5, 10) : "—"}"

  onTap: screen()

  Box { /* neon-wrap */
    fill: true
    background: void
    border: 2
    borderColor: neon
    radius: 12
    clip: true
    padding: padWrap
    Column {
      gap: gapMain
      fill: true

      // ── header ──
      Row {
        gap: dense ? 6 : 10
        align: center
        Gavel { }
        Column {
          gap: 0
          weight: 1
          Text { text: "pelosi trades"; style: label; color: neonPink; bold: true; maxLines: 1 }
          Text {
            text: data == null ? "loading house filings…"
              : data.err != "" && data.n == 0 ? data.err
              : "House clerk · ${data.n} PTR · $${data.vol_m}${data.vol_u}"
            style: small; color: textDim; maxLines: 1
          }
        }
        if age != null {
          Text {
            text: age < 120 ? "live" : age < 3600 ? "${floor(age / 60)}m" : "${floor(age / 3600)}h"
            style: small; color: age < 900 ? upColor : textDim; width: 36; align: end
          }
        }
      }

      // ── activity summary: dense neon chips ──
      Row {
        gap: dense ? 3 : 5
        // buys
        Column {
          gap: 0
          align: center
          weight: 1
          background: alpha(upColor, 0.10)
          border: 1
          borderColor: alpha(upColor, 0.55)
          radius: 6
          padding: dense ? [4, 3] : [6, 4]
          Text { text: "BUYS"; style: label; color: alpha(upColor, 0.8); align: center; maxLines: 1; font: mono }
          Text { text: data.buys_n == null ? "…" : "${data.buys_n}"; style: small; bold: true; color: upColor; align: center; maxLines: 1; font: mono }
        }
        // sells
        Column {
          gap: 0
          align: center
          weight: 1
          background: alpha(downColor, 0.10)
          border: 1
          borderColor: alpha(downColor, 0.55)
          radius: 6
          padding: dense ? [4, 3] : [6, 4]
          Text { text: "SELLS"; style: label; color: alpha(downColor, 0.8); align: center; maxLines: 1; font: mono }
          Text { text: data.sells_n == null ? "…" : "${data.sells_n}"; style: small; bold: true; color: downColor; align: center; maxLines: 1; font: mono }
        }
        // tickers
        Column {
          gap: 0
          align: center
          weight: 1
          background: alpha(neon, 0.10)
          border: 1
          borderColor: alpha(neon, 0.55)
          radius: 6
          padding: dense ? [4, 3] : [6, 4]
          Text { text: "TKRS"; style: label; color: alpha(neon, 0.8); align: center; maxLines: 1; font: mono }
          Text { text: "${len(holdings)}"; style: small; bold: true; color: neon; align: center; maxLines: 1; font: mono }
        }
        // volume
        Column {
          gap: 0
          align: center
          weight: 1
          background: alpha(neonYellow, 0.10)
          border: 1
          borderColor: alpha(neonYellow, 0.55)
          radius: 6
          padding: dense ? [4, 3] : [6, 4]
          Text { text: "VOL"; style: label; color: alpha(neonYellow, 0.8); align: center; maxLines: 1; font: mono }
          Text {
            text: data.vol_m == null ? "…" : "$${data.vol_m}${data.vol_u}"
            style: small; bold: true; color: textHi; align: center; maxLines: 1; font: mono
          }
        }
        // day
        Column {
          gap: 0
          align: center
          weight: 1
          background: alpha(book_up ? upColor : downColor, 0.10)
          border: 1
          borderColor: alpha(book_up ? upColor : downColor, 0.55)
          radius: 6
          padding: dense ? [4, 3] : [6, 4]
          Text { text: "DAY"; style: label; color: alpha(book_up ? upColor : downColor, 0.8); align: center; maxLines: 1; font: mono }
          Text {
            text: data.day == null ? "…" : "${book_up ? "+" : ""}${fixed(data.day, 1)}%"
            style: small; bold: true; color: book_up ? upColor : downColor; align: center; maxLines: 1; font: mono
          }
        }
      }

      // ── buy/sell ratio bar + latest activity ──
      if !tiny {
        Column {
          gap: dense ? 2 : 3
          Row {
            gap: 6
            align: center
            Text { text: "B/S"; style: label; color: textDim; maxLines: 1; font: mono; width: 22 }
            Box {
              weight: 1
              height: dense ? 8 : 10
              radius: 4
              background: alpha(downColor, 0.25)
              clip: true
              Row {
                fill: true
                Box {
                  weight: max(buyPct, 1)
                  fill: true
                  background: alpha(upColor, 0.85)
                }
                Box {
                  weight: max(100 - buyPct, 1)
                  fill: true
                  background: alpha(downColor, 0.55)
                }
              }
            }
            Text {
              text: bsTotal == 0 ? "—" : "${fixed(buyPct, 0)}% buy"
              style: small; color: textHi; maxLines: 1; font: mono; width: 58; align: end
            }
          }
          Row {
            gap: 4
            align: center
            Box {
              width: 6; height: 6; radius: 3
              background: latest == null ? textDim : (latest.buy ? upColor : downColor)
            }
            Text {
              text: latestLine
              style: small; color: textMid; maxLines: 1; weight: 1; font: mono
            }
          }
        }
      }

      // ── sparkline (compact height when dense) ──
      if sparkH > 0 && len(use_chart) > 2 {
        Column {
          gap: 1
          Row {
            align: center
            Text {
              text: len(chart) > 3 ? "tickers · 3M pulse" : "monthly vol · $M"
              style: label; color: textDim; maxLines: 1; weight: 1
            }
            Text {
              text: data.day == null ? "" : "${book_up ? "+" : ""}${fixed(data.day, 2)}%"
              style: small; bold: true; color: book_up ? upColor : downColor; maxLines: 1; font: mono; width: 64; align: end
            }
          }
          Sparkline {
            values: use_chart; min: lo; max: hi
            color: book_up ? upColor : downColor
            area: true; thickness: 2; fill: width; height: sparkH
          }
        }
      }

      // ── filings list (packed rows; no weight:1 empty flex band) ──
      Column {
        gap: 2
        fill: width
        Row {
          align: center
          Text { text: "recent filings"; style: label; color: textDim; maxLines: 1; weight: 1 }
          Text {
            text: len(trades) == 0 ? "" : "${min(maxTrades, len(trades))}/${len(trades)}"
            style: label; color: alpha(neon, 0.7); maxLines: 1; font: mono
          }
        }
        if data == null {
          Text { text: "fetching house disclosures…"; style: small; color: textDim }
        } else if len(trades) == 0 {
          Text { text: data.err != "" ? data.err : "no PTR rows yet"; style: small; color: neonOrange }
        } else {
          Column {
            gap: 2
            fill: width
            for t in take(trades, maxTrades) key "${t.t}-${t.date}-${t.side}-${t.rng}-${t.doc}" {
              Row {
                gap: dense ? 4 : 6
                align: center
                height: 20
                Box {
                  width: dense ? 34 : 40; height: dense ? 16 : 18; radius: 4
                  background: alpha(t.buy ? upColor : downColor, 0.18)
                  border: 1
                  borderColor: alpha(t.buy ? upColor : downColor, 0.45)
                  align: center
                  Text {
                    text: t.buy ? "BUY" : "SELL"
                    fontSize: 9; bold: true; align: center
                    color: t.buy ? upColor : downColor; maxLines: 1; font: mono
                  }
                }
                Text { text: t.t; style: small; bold: true; color: neon; width: 48; maxLines: 1; font: mono }
                Text {
                  text: t.date != "" ? sub(t.date, 5, 10) : "—"
                  style: small; color: textDim; width: 36; maxLines: 1; font: mono
                }
                Text {
                  text: t.mu == null ? (t.rng ?? "—") : "$${t.mu}${t.mu_u}"
                  style: small; color: textHi; weight: 1; maxLines: 1; font: mono
                }
              }
            }
          }
        }
      }

      // ── mini holdings strip (top 3 by usd) — fills footer void ──
      if showHoldStrip {
        Column {
          gap: 2
          Text { text: "top holdings"; style: label; color: textDim; maxLines: 1 }
          Row {
            gap: dense ? 3 : 5
            for h in take(holdings, 3) key h.t {
              Column {
                gap: 0
                weight: 1
                background: alpha(panel, 0.75)
                border: 1
                borderColor: alpha(neon, 0.35)
                radius: 6
                padding: dense ? [4, 3] : [5, 4]
                Row {
                  gap: 4
                  align: center
                  Text { text: h.t; style: small; bold: true; color: neon; maxLines: 1; font: mono; weight: 1 }
                  Text {
                    text: h.dpct == null ? "" : "${h.dup ? "+" : ""}${fixed(h.dpct, 1)}%"
                    style: small; bold: true; maxLines: 1; font: mono
                    color: h.dpct == null ? textDim : (h.dup ? upColor : downColor)
                  }
                }
                Text {
                  text: h.mu == null ? "—" : "$${h.mu}${h.mu_u}"
                  style: small; color: textHi; maxLines: 1; font: mono
                }
              }
            }
          }
        }
      }
    }
  }

  screen {
    title: "pelosi trades"
    Box { /* neon-screen */
      fill: true
      background: void
      border: 2
      borderColor: neonPink
      radius: 12
      clip: true
      padding: 6
      Column {
        gap: 8
        padding: 2
        fill: true

        // ── header ──
        Row {
          gap: 10
          align: center
          Gavel { }
          Column {
            gap: 1
            weight: 1
            Text {
              text: data.who ?? "Nancy Pelosi"
              style: title
              color: neonYellow
              maxLines: 1
            }
            Text {
              text: "STOCK Act PTRs · House clerk · not investment advice"
              style: small
              color: textDim
              maxLines: 1
            }
          }
          Button { text: "refresh"; onTap: refresh() }
        }

        // ── activity summary header (volume · buys/sells · day · PTR) ──
        Row {
          gap: 6
          Box {
            weight: 1
            radius: 8
            padding: [6, 7]
            background: alpha(panel, 0.95)
            border: 1
            borderColor: alpha(neon, 0.7)
            Column {
              gap: 1
              Text { text: "VOLUME"; style: label; color: textDim; maxLines: 1 }
              Text {
                text: data.vol_m == null ? "…" : "$${data.vol_m}${data.vol_u}"
                style: small
                bold: true
                color: neon
                maxLines: 1
                font: mono
              }
            }
          }
          Box {
            weight: 1
            radius: 8
            padding: [6, 7]
            background: alpha(panel, 0.95)
            border: 1
            borderColor: alpha(upColor, 0.7)
            Column {
              gap: 1
              Text { text: "BUYS"; style: label; color: textDim; maxLines: 1 }
              Text {
                text: "${data.buys_n ?? 0}"
                style: small
                bold: true
                color: upColor
                maxLines: 1
                font: mono
              }
            }
          }
          Box {
            weight: 1
            radius: 8
            padding: [6, 7]
            background: alpha(panel, 0.95)
            border: 1
            borderColor: alpha(downColor, 0.7)
            Column {
              gap: 1
              Text { text: "SELLS"; style: label; color: textDim; maxLines: 1 }
              Text {
                text: "${data.sells_n ?? 0}"
                style: small
                bold: true
                color: downColor
                maxLines: 1
                font: mono
              }
            }
          }
          Box {
            weight: 1
            radius: 8
            padding: [6, 7]
            background: alpha(panel, 0.95)
            border: 1
            borderColor: alpha(book_up ? upColor : downColor, 0.75)
            Column {
              gap: 1
              Text { text: "DAY"; style: label; color: textDim; maxLines: 1 }
              Text {
                text: data.day == null ? "…" : "${book_up ? "+" : ""}${fixed(data.day, 2)}%"
                style: small
                bold: true
                color: book_up ? upColor : downColor
                maxLines: 1
                font: mono
              }
            }
          }
          Box {
            weight: 1
            radius: 8
            padding: [6, 7]
            background: alpha(panel, 0.95)
            border: 1
            borderColor: alpha(neonYellow, 0.7)
            Column {
              gap: 1
              Text { text: "PTR"; style: label; color: textDim; maxLines: 1 }
              Text {
                text: "${data.n ?? 0}"
                style: small
                bold: true
                color: neonYellow
                maxLines: 1
                font: mono
              }
            }
          }
        }

        // ── pulse chart ──
        if len(use_chart) > 2 {
          Column {
            gap: 3
            fill: width
            padding: [4, 6]
            background: alpha(panel, 0.7)
            border: 1
            borderColor: alpha(neon, 0.35)
            radius: 8
            Row {
              align: center
              Text {
                text: len(chart) > 3 ? "holdings pulse · 3M" : "monthly volume · $M"
                style: label
                color: textDim
                maxLines: 1
                weight: 1
              }
              Text {
                text: data.day == null ? "" : "day ${book_up ? "+" : ""}${fixed(data.day, 2)}%"
                style: small
                bold: true
                color: book_up ? upColor : downColor
                maxLines: 1
                font: mono
              }
            }
            Sparkline {
              values: use_chart
              min: lo
              max: hi
              color: book_up ? upColor : downColor
              area: true
              thickness: 2.2
              fill: width
              height: 64
            }
          }
        }

        // ── tab chrome ──
        Row {
          gap: 0
          height: 30
          background: alpha(panel, 0.9)
          border: 1
          borderColor: alpha(neon, 0.45)
          radius: 8
          clip: true
          Box {
            weight: 1
            height: 30
            align: center
            background: tab == "activity" ? alpha(neon, 0.18) : alpha(void, 0.4)
            border: tab == "activity" ? 1 : 0
            borderColor: neon
            radius: 7
            onTap: tab = "activity"
            Text {
              text: "ACTIVITY"
              bold: true
              align: center
              color: tab == "activity" ? neon : textDim
              maxLines: 1
              font: mono
              fontSize: 11
            }
          }
          Box {
            weight: 1
            height: 30
            align: center
            background: tab == "book" ? alpha(neonPink, 0.18) : alpha(void, 0.4)
            border: tab == "book" ? 1 : 0
            borderColor: neonPink
            radius: 7
            onTap: tab = "book"
            Text {
              text: "BOOK"
              bold: true
              align: center
              color: tab == "book" ? neonPink : textDim
              maxLines: 1
              font: mono
              fontSize: 11
            }
          }
        }

        // ── tab body ──
        Column {
          gap: 4
          weight: 1
          scroll: true

          if tab == "activity" {
            Row {
              align: center
              Text {
                text: "RECENT FILINGS"
                style: label
                color: neonYellow
                maxLines: 1
                weight: 1
              }
              Text {
                text: "${min(len(trades), 40)} shown"
                style: small
                color: textDim
                maxLines: 1
                font: mono
              }
            }
            for t in take(trades, 40) key "${t.t}-${t.date}-${t.side}-${t.rng}-${t.doc}" {
              Column {
                gap: 2
                padding: [5, 6]
                background: alpha(panel, 0.92)
                border: 1
                borderColor: alpha(t.buy ? upColor : downColor, 0.4)
                radius: 6
                Row {
                  gap: 6
                  align: center
                  height: 22
                  Box {
                    width: 42
                    height: 18
                    radius: 4
                    background: alpha(t.buy ? upColor : downColor, 0.2)
                    border: 1
                    borderColor: t.buy ? upColor : downColor
                    align: center
                    Text {
                      text: t.buy ? "BUY" : "SELL"
                      bold: true
                      align: center
                      color: t.buy ? upColor : downColor
                      font: mono
                      fontSize: 10
                      maxLines: 1
                    }
                  }
                  Text {
                    text: t.t ?? "—"
                    bold: true
                    color: neon
                    width: 52
                    font: mono
                    maxLines: 1
                  }
                  Text {
                    text: t.name ?? ""
                    style: small
                    color: textDim
                    weight: 1
                    maxLines: 1
                  }
                  Text {
                    text: t.mu == null ? (t.rng ?? "—") : "$${t.mu}${t.mu_u}"
                    bold: true
                    width: 70
                    align: end
                    font: mono
                    maxLines: 1
                    color: textHi
                  }
                }
                Row {
                  gap: 6
                  align: center
                  height: 20
                  Text {
                    text: t.date != "" ? t.date : "—"
                    style: small
                    color: textDim
                    width: 88
                    font: mono
                    maxLines: 1
                  }
                  Text {
                    text: t.desc != "" ? t.desc : (t.type != "" ? t.type : "—")
                    style: small
                    color: textDim
                    weight: 1
                    maxLines: 1
                  }
                  if t.doc != "" {
                    Button {
                      text: "pdf"
                      color: neon
                      onTap: url("https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/${t.year ?? sub(t.filed, 0, 4)}/${t.doc}.pdf")
                    }
                  }
                }
              }
            }
          }

          if tab == "book" {
            Row {
              align: center
              Text {
                text: "BUY NOTIONAL BY TICKER"
                style: label
                color: neonYellow
                maxLines: 1
                weight: 1
              }
              Text {
                text: "${min(len(holdings), 16)} tickers"
                style: small
                color: textDim
                maxLines: 1
                font: mono
              }
            }
            for h in take(holdings, 16) key h.t {
              Column {
                gap: 3
                padding: [5, 6]
                radius: 6
                background: alpha(panel, 0.92)
                border: 1
                borderColor: alpha(h.dup ? upColor : downColor, 0.35)
                onTap: url("https://www.cnbc.com/quotes/${h.t}")
                Row {
                  gap: 6
                  align: center
                  height: 22
                  Text {
                    text: h.t ?? "—"
                    bold: true
                    color: neon
                    width: 52
                    font: mono
                    maxLines: 1
                  }
                  Text {
                    text: h.name ?? ""
                    style: small
                    color: textDim
                    weight: 1
                    maxLines: 1
                  }
                  Text {
                    text: h.px == null ? "" : "$${fixed(h.px, 2)}"
                    style: small
                    width: 68
                    align: end
                    font: mono
                    maxLines: 1
                    color: textMid
                  }
                  Text {
                    text: h.dpct == null ? "—" : "${h.dup ? "+" : ""}${fixed(h.dpct, 1)}%"
                    style: small
                    bold: true
                    color: h.dpct == null ? textDim : (h.dup ? upColor : downColor)
                    width: 58
                    align: end
                    font: mono
                    maxLines: 1
                  }
                }
                Row {
                  gap: 6
                  align: center
                  height: 18
                  Text {
                    text: "${h.buys ?? 0} buys · ${h.sells ?? 0} sells"
                    style: small
                    color: textDim
                    weight: 1
                    maxLines: 1
                  }
                  Text {
                    text: h.mu == null ? "—" : "≈ $${h.mu}${h.mu_u}"
                    style: small
                    bold: true
                    width: 96
                    align: end
                    font: mono
                    maxLines: 1
                    color: textHi
                  }
                }
                if h.spark != null && len(h.spark) > 3 {
                  let slo = min(h.spark)
                  let shi = max(h.spark)
                  Sparkline {
                    values: h.spark
                    min: slo
                    max: shi
                    color: h.dup ? upColor : downColor
                    area: true
                    thickness: 1.4
                    fill: width
                    height: 22
                  }
                }
              }
            }
            Text {
              text: "Amounts are STOCK Act ranges (midpoints) from House Periodic Transaction Reports. Live quotes via CNBC. Not investment advice."
              style: small
              color: textDim
              maxLines: 3
            }
          }
        }

        // ── footer links ──
        Row {
          gap: 6
          Button {
            text: "house search"
            onTap: url("https://disclosures-clerk.house.gov/FinancialDisclosure")
          }
          Button {
            text: "house clerk"
            onTap: url("https://disclosures-clerk.house.gov/public_disc/financial-pdfs/")
          }
          Spacer { weight: 1 }
          Button { text: "close"; color: textDim; onTap: close() }
        }
      }
    }
  }
}
