widget "pelosi trades" {
  size: 6x6
  minSize: 4x4
  padding: 10
  meta {
    description: "Nancy Pelosi House STOCK Act filings (Periodic Transaction Reports) with live quotes on disclosed tickers"
    version: "1.1"
    license: "MIT"
    category: "finance"
    owl: 5
  }
  requires { pacman: ["python", "poppler"] }

  source data = cmd("""
python3 - <<'PY'
import io, json, os, re, subprocess, time, urllib.request, urllib.error, zipfile
from collections import defaultdict
from datetime import date
from pathlib import Path

CACHE = Path.home() / ".cache" / "omalauncher-pelosi-trades.json"
CACHE.parent.mkdir(parents=True, exist_ok=True)
UA = "Mozilla/5.0 (omalauncher pelosi-trades widget)"
CLERK = "https://disclosures-clerk.house.gov"

# STOCK Act amount ranges → midpoint USD
RANGES = [
    (1, 1000, 500),
    (1001, 15000, 8000),
    (15001, 50000, 32500),
    (50001, 100000, 75000),
    (100001, 250000, 175000),
    (250001, 500000, 375000),
    (500001, 1000000, 750000),
    (1000001, 5000000, 3000000),
    (5000001, 25000000, 15000000),
    (25000001, 50000000, 37500000),
    (50000001, None, 50000001),
]

def get(url, timeout=22, accept="*/*"):
    last = None
    for i in range(3):
        try:
            req = urllib.request.Request(url, headers={
                "User-Agent": UA,
                "Accept": accept,
                "Accept-Language": "en-US,en;q=0.9",
            })
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read()
        except Exception as e:
            last = e
            time.sleep(0.4 + i)
    raise last if last else RuntimeError("fetch failed")

def fnum(s):
    if s is None:
        return None
    try:
        return float(str(s).replace(",", "").replace("%", "").replace("+", "").strip())
    except Exception:
        return None

def load_cache(max_age=None):
    try:
        if not CACHE.exists():
            return None
        age = time.time() - CACHE.stat().st_mtime
        if max_age is not None and age > max_age:
            return None
        d = json.loads(CACHE.read_text())
        if d.get("trades") is not None:
            return d
    except Exception:
        pass
    return None

def save_cache(d):
    try:
        CACHE.write_text(json.dumps(d))
    except Exception:
        pass

def money(n):
    if n is None:
        return None
    a = abs(n)
    if a >= 1e9:
        return round(n / 1e9, 2)
    if a >= 1e6:
        return round(n / 1e6, 2)
    if a >= 1e3:
        return round(n / 1e3, 1)
    return round(n, 0)

def money_u(n):
    if n is None:
        return ""
    a = abs(n)
    if a >= 1e9:
        return "B"
    if a >= 1e6:
        return "M"
    if a >= 1e3:
        return "K"
    return ""

def parse_amount(blob):
    '''Parse '$15,001 - $50,000' or split across lines into midpoint + display range.'''
    s = re.sub(r"\s+", " ", blob or "")
    nums = [int(x.replace(",", "")) for x in re.findall(r"\$?\s*([0-9][0-9,]*)", s)]
    nums = [n for n in nums if n >= 1]
    if not nums:
        return None, ""
    if len(nums) == 1:
        lo = hi = nums[0]
    else:
        lo, hi = nums[0], nums[1]
    mid = None
    for a, b, m in RANGES:
        if lo >= a and (b is None or hi <= b or lo <= (b or lo)):
            # prefer exact band match
            if lo == a and (b is None or hi == b):
                mid = m
                break
    if mid is None:
        mid = (lo + hi) / 2 if hi else lo
    if hi and hi != lo:
        rng = "$" + f"{lo:,}" + "–$" + f"{hi:,}"
    else:
        rng = "$" + f"{lo:,}"
    return float(mid), rng

def iso_date(mmddyyyy):
    m = re.match(r"(\d{1,2})/(\d{1,2})/(\d{4})", (mmddyyyy or "").strip())
    if not m:
        return ""
    mo, d, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return f"{y:04d}-{mo:02d}-{d:02d}"

def ticker_from(asset):
    # Prefer (TICKER) just before an asset-type code [ST]/ OT …]
    s = asset or ""
    m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)\s*\[[A-Z]{2}\]", s)
    if m:
        return m.group(1)
    m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)", s)
    if not m:
        return ""
    tkr = m.group(1)
    # Asset-type codes and junk that appear in PTR text
    if tkr in {"ST", "OP", "OT", "AB", "GS", "PS", "CS", "EF", "MF", "PK", "OL", "SP", "JT", "DC", "SC", "PTR", "LLC", "INC", "THE"}:
        return ""
    return tkr

def side_from(type_tok, desc):
    t = (type_tok or "").strip().upper()
    d = (desc or "").lower()
    if t.startswith("P") and "partial" not in t.lower():
        return "Buy", True, False
    if t.startswith("S"):
        return ("Sale (partial)" if "partial" in t.lower() or "partial" in d else "Sale"), False, True
    if "purchas" in d or "bought" in d or "exercise" in d:
        return "Buy", True, False
    if "sale" in d or "sold" in d or "contribution" in d:
        return "Sale", False, True
    return (type_tok or "—")[:12], False, False

def list_ptrs(years):
    '''Pelosi PTR DocIDs from the clerk's yearly FD zip index.'''
    out = []
    for year in years:
        try:
            raw = get(f"{CLERK}/public_disc/financial-pdfs/{year}FD.zip")
            z = zipfile.ZipFile(io.BytesIO(raw))
            name = next(n for n in z.namelist() if n.lower().endswith(".txt"))
            txt = z.read(name).decode("utf-8", "replace")
            for line in txt.splitlines()[1:]:
                parts = line.split("\t")
                if len(parts) < 9:
                    continue
                last, first, ftype = parts[1].strip(), parts[2].strip(), parts[4].strip()
                y, fdate, doc = parts[6].strip(), parts[7].strip(), parts[8].strip()
                if last.lower() != "pelosi":
                    continue
                if ftype != "P":  # Periodic Transaction Report
                    continue
                try:
                    yi = int(y)
                except Exception:
                    yi = year
                out.append({"year": yi, "filed": fdate, "doc": doc, "iso": iso_date(fdate)})
        except Exception:
            continue
    # newest first
    out.sort(key=lambda p: (p["iso"], p["doc"]), reverse=True)
    # unique doc
    seen, uniq = set(), []
    for p in out:
        if p["doc"] in seen:
            continue
        seen.add(p["doc"])
        uniq.append(p)
    return uniq

def pdf_text(year, doc):
    url = f"{CLERK}/public_disc/ptr-pdfs/{year}/{doc}.pdf"
    pdf = get(url, timeout=30)
    r = subprocess.run(
        ["pdftotext", "-layout", "-", "-"],
        input=pdf,
        capture_output=True,
        timeout=30,
    )
    if r.returncode != 0:
        # fallback via temp not needed; try again with file
        tmp = Path("/tmp") / f"owl-pelosi-{doc}.pdf"
        tmp.write_bytes(pdf)
        r = subprocess.run(["pdftotext", "-layout", str(tmp), "-"], capture_output=True, timeout=30)
    return (r.stdout or b"").decode("utf-8", "replace")

def parse_ptr(text, meta):
    '''Pull trade rows out of a layout-mode PTR text dump.'''
    # Drop certification / header noise
    lines = [re.sub(r"[ \t]+$", "", ln) for ln in text.splitlines()]
    body = "\n".join(lines)
    # Owner token + asset blob ending in [XX], then type letter(s), two dates, amount
    # Amount often wraps to the next line.
    trades = []
    # Find blocks starting with SP/JT/DC etc.
    # Collapse whitespace variants
    chunks = re.split(r"\n(?=\s*(?:SP|JT|DC|SC)\s{2,})", body)
    for ch in chunks:
        if not re.match(r"\s*(?:SP|JT|DC|SC)\s", ch):
            continue
        # stop at cert / footnotes
        if "I CERTIFY" in ch:
            ch = ch.split("I CERTIFY")[0]
        if "* For the complete list" in ch:
            ch = ch.split("* For the complete list")[0]
        flat = re.sub(r"[ \t]*\n[ \t]*", "\n", ch).strip()
        # Asset: from after owner token to ticker/[CODE]
        m = re.search(
            r"(SP|JT|DC|SC)\s+(.*?)\s+(P|S(?:\s*\(partial\))?)\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\$?[\d,].*)$",
            flat.replace("\n", "  "),
            re.S,
        )
        if not m:
            # try looser: asset then type then one date
            m2 = re.search(
                r"(SP|JT|DC|SC)\s+(.+?)\s+(P|S(?:\s*\(partial\))?)\s+(\d{1,2}/\d{1,2}/\d{4})\s+(\d{1,2}/\d{1,2}/\d{4})(.*)$",
                re.sub(r"\s+", " ", flat),
                re.S,
            )
            if not m2:
                continue
            owner, asset, typ, tdate, ndate, rest = m2.groups()
        else:
            owner, asset, typ, tdate, ndate, rest = m.groups()
        asset = re.sub(r"\s+", " ", asset).strip()
        # description lines F/S/D
        desc_m = re.findall(r"\bD\s*:\s*(.+)", flat)
        desc = " ".join(re.sub(r"\s+", " ", d).strip() for d in desc_m)[:160]
        # amount: dollars in rest + following lines of original chunk
        amt_blob = rest + " " + " ".join(
            ln for ln in ch.splitlines() if "$" in ln or re.search(r"\d,\d{3}", ln)
        )
        usd, rng = parse_amount(amt_blob)
        # Ticker often wraps onto the next layout line: "Common Stock (BE) [ST]"
        tkr = ticker_from(asset)
        if not tkr:
            # wrapped layout: ticker often sits on the next line with [ST]/]
            m = re.search(r"\(([A-Z]{1,5}(?:[.-][A-Z0-9]{1,4})?)\)\s*\[[A-Z]{2}\]", flat)
            if m and m.group(1) not in {"ST", "OP", "OT", "AB", "GS", "PS"}:
                tkr = m.group(1)
        side, is_buy, is_sell = side_from(typ, desc)
        # asset type code [ST]/ OT AB]
        at = ""
        am = re.search(r"\[([A-Z]{2})\]\s*$", asset)
        if am:
            at = am.group(1)
            asset = re.sub(r"\s*\[[A-Z]{2}\]\s*$", "", asset).strip()
        name = re.sub(r"\s*\([A-Z][A-Z0-9.\-]{0,9}\)\s*", " ", asset)
        name = re.sub(r"\s+", " ", name).strip()[:36]
        trades.append({
            "t": tkr if tkr else "—",
            "side": side,
            "buy": is_buy,
            "sell": is_sell,
            "filed": iso_date(meta.get("filed") or ndate),
            "date": iso_date(tdate),
            "desc": desc,
            "name": name or tkr or "—",
            "type": at or "",
            "rng": rng,
            "usd": usd,
            "doc": meta.get("doc") or "",
            "year": meta.get("year"),
        })
    return trades

def quotes(syms):
    if not syms:
        return {}
    joined = "|".join(syms[:12])
    url = (
        "https://quote.cnbc.com/quote-html-webservice/restQuote/symbolType/symbol"
        f"?symbols={joined}&requestMethod=itv&noform=1&partnerId=2&fund=1&exthdr=1&output=json"
    )
    raw = get(url, accept="application/json").decode("utf-8", "replace")
    if raw.startswith("//"):
        raw = raw[2:]
    m = re.match(r"^[^(]*\((.*)\)\s*;?\s*$", raw, re.S)
    if m:
        raw = m.group(1)
    data = json.loads(raw)
    qs = data.get("FormattedQuoteResult", {}).get("FormattedQuote", [])
    if isinstance(qs, dict):
        qs = [qs]
    out = {}
    for q in qs:
        sym = q.get("symbol") or ""
        last = fnum(q.get("last"))
        pct = fnum(q.get("change_pct"))
        chg = fnum(q.get("change"))
        if last is None:
            continue
        out[sym] = {
            "px": round(last, 2),
            "pct": round(pct, 2) if pct is not None else None,
            "chg": round(chg, 2) if chg is not None else None,
            "up": (pct is not None and pct >= 0) or (chg is not None and chg >= 0),
        }
    return out

def spark(sym, span="3M"):
    try:
        raw = get(
            f"https://ts-api.cnbc.com/harmony/app/charts/{span}.json?symbol={sym}",
            accept="application/json",
        )
        d = json.loads(raw)
        bars = (d.get("barData") or {}).get("priceBars") or []
        closes = []
        for b in bars:
            c = fnum(b.get("close"))
            if c is not None:
                closes.append(round(c, 2))
        if len(closes) > 42:
            step = max(1, len(closes) // 42)
            closes = closes[::step][:42]
        return closes
    except Exception:
        return []

def build():
    today = date.today()
    years = list(range(today.year, today.year - 4, -1))
    ptrs = list_ptrs(years)
    if not ptrs:
        raise RuntimeError("no Pelosi PTRs in clerk index")

    # Parse the newest ~14 PTRs (enough history without hammering the clerk)
    trades = []
    errors = []
    for meta in ptrs[:14]:
        try:
            text = pdf_text(meta["year"], meta["doc"])
            rows = parse_ptr(text, meta)
            trades.extend(rows)
        except Exception as e:
            errors.append(f"{meta['doc']}:{str(e)[:40]}")
            continue

    # newest first
    trades.sort(key=lambda t: (t.get("date") or "", t.get("filed") or ""), reverse=True)

    # decorate money fields
    for t in trades:
        t["mu"] = money(t["usd"])
        t["mu_u"] = money_u(t["usd"])

    eq = [t for t in trades if t["t"] != "—"]
    vol = sum(t["usd"] or 0 for t in trades)
    buys_n = sum(1 for t in trades if t["buy"])
    sells_n = sum(1 for t in trades if t["sell"])

    # holdings-ish: net disclosed buy notional per ticker (not a true book)
    hold = defaultdict(lambda: {"usd": 0.0, "n": 0, "name": "", "buys": 0, "sells": 0})
    for t in eq:
        h = hold[t["t"]]
        h["name"] = t["name"] or t["t"]
        if t["buy"]:
            h["usd"] += t["usd"] or 0
            h["buys"] += 1
            h["n"] += 1
        elif t["sell"]:
            h["sells"] += 1
            h["n"] += 1
            # don't subtract sale ranges - STOCK Act ranges are too coarse for netting

    holdings = []
    for tkr, h in hold.items():
        if h["buys"] == 0 and h["usd"] == 0:
            continue
        holdings.append({
            "t": tkr,
            "name": (h["name"] or tkr)[:22],
            "usd": h["usd"],
            "n": h["n"],
            "buys": h["buys"],
            "sells": h["sells"],
            "mu": money(h["usd"]),
            "mu_u": money_u(h["usd"]),
        })
    holdings.sort(key=lambda x: -x["usd"])
    top = holdings[:10]

    # live quotes + sparks for top tickers
    qmap = {}
    try:
        qmap = quotes([h["t"] for h in top[:8] if re.match(r"^[A-Z]", h["t"])])
    except Exception:
        qmap = {}

    p_sparks = []
    for h in top[:8]:
        q = qmap.get(h["t"]) or {}
        h["px"] = q.get("px")
        h["dpct"] = q.get("pct")
        h["dup"] = q.get("up", True)
        try:
            sp = spark(h["t"], "3M") if h["t"] in qmap else []
        except Exception:
            sp = []
        h["spark"] = sp
        if len(sp) > 5:
            p_sparks.append(sp)

    pchart = []
    if p_sparks:
        n = min(len(s) for s in p_sparks)
        norms = []
        for s in p_sparks:
            s = s[-n:]
            base = s[0] or 1.0
            norms.append([100.0 * x / base for x in s])
        pchart = [
            round(sum(norms[j][i] for j in range(len(norms))) / len(norms), 2)
            for i in range(n)
        ]

    day_pcts = [h["dpct"] for h in top if h.get("dpct") is not None]
    day = round(sum(day_pcts) / len(day_pcts), 2) if day_pcts else None

    # monthly filing volume path (not return)
    months = defaultdict(float)
    for t in trades:
        if t.get("date") and t.get("usd"):
            months[t["date"][:7]] += t["usd"]
    keys = sorted(months.keys())[-18:]
    chart = [round(months[k] / 1e6, 2) for k in keys]  # $$M

    recent = []
    for t in trades[:12]:
        recent.append({
            "t": t["t"],
            "side": t["side"],
            "buy": t["buy"],
            "date": t["date"],
            "name": t["name"],
            "rng": t["rng"],
            "mu": t["mu"],
            "mu_u": t["mu_u"],
            "desc": t["desc"],
        })

    return {
        "at": int(time.time()),
        "who": "Nancy Pelosi",
        "n": len(trades),
        "ptrs": len(ptrs),
        "buys_n": buys_n,
        "sells_n": sells_n,
        "vol": vol,
        "vol_m": money(vol),
        "vol_u": money_u(vol),
        "day": day,
        "day_up": day is None or day >= 0,
        "chart": chart,
        "pchart": pchart,
        "holdings": top,
        "recent": recent,
        "trades": [
            {
                "t": t["t"],
                "side": t["side"],
                "buy": t["buy"],
                "date": t["date"],
                "filed": t["filed"],
                "name": t["name"],
                "rng": t["rng"],
                "mu": t["mu"],
                "mu_u": t["mu_u"],
                "type": t["type"],
                "desc": t["desc"],
                "doc": t["doc"],
                "year": t.get("year"),
            }
            for t in trades[:60]
        ],
        "src": "house-clerk",
        "err": ("; ".join(errors))[:80] if errors and not trades else "",
    }

# Prefer fresh cache (<25m)
fresh = load_cache(max_age=25 * 60)
if fresh and not os.environ.get("PELOSI_FORCE"):
    fresh = dict(fresh)
    fresh["err"] = fresh.get("err") or ""
    print(json.dumps(fresh))
else:
    try:
        out = build()
        save_cache(out)
    except Exception as e:
        cached = load_cache(max_age=None)
        if cached:
            cached = dict(cached)
            cached["err"] = str(e)[:80] or "cached"
            out = cached
        else:
            out = {
                "at": int(time.time()),
                "who": "Nancy Pelosi",
                "err": str(e)[:100],
                "holdings": [],
                "recent": [],
                "trades": [],
                "chart": [],
                "pchart": [],
                "vol_m": None,
                "n": 0,
                "buys_n": 0,
                "sells_n": 0,
                "day": None,
                "day_up": True,
            }
    print(json.dumps(out))
PY
""") every 15m json timeout 120s

  source now = clock every 60s

  let holdings = data.holdings ?? []
  let recent = data.recent ?? []
  let trades = data.trades ?? []
  let chart = data.pchart ?? []
  let path = data.chart ?? []
  let use_chart = len(chart) > 3 ? chart : path
  let lo = len(use_chart) > 0 ? min(use_chart) : null
  let hi = len(use_chart) > 0 ? max(use_chart) : null
  let age = data == null || data.at == null ? null : now - data.at
  let book_up = data.day_up != false
  state tab = "activity"

  component Gavel() {
    Canvas {
      width: 28
      height: 28
      circle(14, 14, 13, fill: mix(accent, blue, 0.35))
      circle(14, 14, 13, stroke: accent, width: 1.4)
      rect(8, 11, 12, 3.5, radius: 1, fill: foreground)
      rect(12.5, 14, 3, 8, fill: foreground)
      rect(9, 21, 10, 2.2, radius: 1, fill: muted)
    }
  }

  component StatPill(label, value, tint = foreground) {
    Column {
      gap: 0
      align: center
      weight: 1
      background: alpha(surface, 0.65)
      radius: 8
      padding: [6, 6]
      Text { text: label; style: label; color: muted; align: center; maxLines: 1 }
      Text { text: value; style: small; bold: true; color: tint; align: center; maxLines: 1; font: mono }
    }
  }

  component TradeRow(t) {
    Row {
      gap: 6
      align: center
      Box {
        width: 40; height: 18; radius: 4
        background: alpha(t.buy ? green : red, 0.18)
        align: center
        Text {
          text: t.buy ? "Buy" : (t.side ?? "Sale")
          fontSize: 10; bold: true; align: center
          color: t.buy ? green : red; maxLines: 1
        }
      }
      Text { text: t.t; style: small; bold: true; color: accent; width: 52; maxLines: 1; font: mono }
      Text {
        text: t.date != "" ? sub(t.date, 5, 10) : "—"
        style: small; color: muted; width: 40; maxLines: 1; font: mono
      }
      Text {
        text: t.mu == null ? (t.rng ?? "—") : "$${t.mu}${t.mu_u}"
        style: small; color: foreground; weight: 1; maxLines: 1; font: mono
      }
    }
  }

  component HoldRow(h) {
    Row {
      gap: 6
      align: center
      Text { text: h.t; style: small; bold: true; color: accent; width: 52; maxLines: 1; font: mono }
      Text { text: h.name; style: small; color: muted; weight: 1; maxLines: 1 }
      Text {
        text: h.dpct == null ? "—" : "${h.dup ? "+" : ""}${fixed(h.dpct, 1)}%"
        style: small; bold: true; width: 58; align: end; font: mono
        color: h.dpct == null ? muted : (h.dup ? green : red)
      }
      Text {
        text: h.mu == null ? "—" : "$${h.mu}${h.mu_u}"
        style: small; width: 64; align: end; font: mono; maxLines: 1
      }
    }
  }

  onTap: screen()

  Column {
    gap: 8
    fill: true

    Row {
      gap: 10
      align: center
      Gavel { }
      Column {
        gap: 0
        weight: 1
        Text { text: "pelosi trades"; style: label; color: muted; maxLines: 1 }
        Text {
          text: data == null ? "loading house filings…" : data.err != "" && data.n == 0 ? data.err : "House clerk · ${data.n} PTR rows · $${data.vol_m}${data.vol_u} vol"
          style: small; color: muted; maxLines: 1
        }
      }
      if age != null {
        Text {
          text: age < 120 ? "live" : age < 3600 ? "${floor(age / 60)}m" : "${floor(age / 3600)}h"
          style: small; color: age < 900 ? green : muted; width: 36; align: end
        }
      }
    }

    Row {
      gap: 6
      StatPill {
        label: "buys"
        value: data.buys_n == null ? "…" : "${data.buys_n}"
        tint: green
      }
      StatPill {
        label: "sells"
        value: data.sells_n == null ? "…" : "${data.sells_n}"
        tint: red
      }
      StatPill {
        label: "tickers"
        value: "${len(holdings)}"
        tint: accent
      }
      StatPill {
        label: "day"
        value: data.day == null ? "…" : "${book_up ? "+" : ""}${fixed(data.day, 1)}%"
        tint: book_up ? green : red
      }
    }

    if len(use_chart) > 2 {
      Column {
        gap: 2
        Row {
          align: center
          Text {
            text: len(chart) > 3 ? "disclosed tickers · 3M pulse" : "monthly filing volume · $M"
            style: label; color: muted; maxLines: 1; weight: 1
          }
          Text {
            text: data.day == null ? "" : "day ${book_up ? "+" : ""}${fixed(data.day, 2)}%"
            style: small; bold: true; color: book_up ? green : red; maxLines: 1; font: mono; width: 88; align: end
          }
        }
        Sparkline {
          values: use_chart; min: lo; max: hi
          color: book_up ? green : red
          area: true; thickness: 2; fill: width; height: 48
        }
      }
    }

    Column {
      gap: 3
      weight: 1
      Text { text: "recent filings"; style: label; color: muted; maxLines: 1 }
      if data == null {
        Text { text: "fetching house disclosures…"; style: small; color: muted }
      } else if len(trades) == 0 {
        Text { text: data.err != "" ? data.err : "no PTR rows yet"; style: small; color: orange }
      } else {
        for t in take(trades, 8) key "${t.t}-${t.date}-${t.side}-${t.rng}-${t.doc}" {
          TradeRow { t: t }
        }
      }
    }
  }

  screen {
    title: "pelosi trades"
    Column {
      gap: 10
      padding: 4
      fill: true

      Row {
        gap: 10
        align: center
        Gavel { }
        Column {
          gap: 2
          weight: 1
          Text { text: data.who ?? "Nancy Pelosi"; style: title; maxLines: 1 }
          Text {
            text: "STOCK Act PTRs · House clerk · not investment advice"
            style: small; color: muted; maxLines: 1
          }
        }
        Button { text: "refresh"; onTap: refresh() }
      }

      Row {
        gap: 8
        Box {
          weight: 1; radius: 8; padding: 8
          background: alpha(green, 0.1)
          Column {
            gap: 2
            Text { text: "disclosed volume"; style: label; color: muted }
            Text {
              text: data.vol_m == null ? "…" : "$${data.vol_m}${data.vol_u}"
              style: title; color: accent; maxLines: 1; font: mono
            }
            Text {
              text: "${data.buys_n ?? 0} buys · ${data.sells_n ?? 0} sells · ${data.n ?? 0} rows"
              style: small; color: muted; maxLines: 1
            }
          }
        }
        Box {
          weight: 1; radius: 8; padding: 8
          background: alpha(accent, 0.1)
          Column {
            gap: 2
            Text { text: "book today"; style: label; color: muted }
            Text {
              text: data.day == null ? "…" : "${book_up ? "+" : ""}${fixed(data.day, 2)}%"
              style: title; color: book_up ? green : red; maxLines: 1; font: mono
            }
            Text {
              text: "avg day move · top tickers"
              style: small; color: muted; maxLines: 1
            }
          }
        }
      }

      if len(use_chart) > 2 {
        Column {
          gap: 4
          fill: width
          Text {
            text: len(chart) > 3 ? "holdings pulse · 3 months" : "monthly disclosed volume · $M"
            style: label; color: muted; maxLines: 1
          }
          Sparkline {
            values: use_chart; min: lo; max: hi
            color: book_up ? green : red
            area: true; thickness: 2.5; fill: width; height: 88
          }
        }
      }

      Row {
        gap: 8
        Button {
          text: "activity"
          color: tab == "activity" ? accent : muted
          onTap: tab = "activity"
        }
        Button {
          text: "book"
          color: tab == "book" ? accent : muted
          onTap: tab = "book"
        }
        Spacer { weight: 1 }
        Button { text: "refresh"; onTap: refresh() }
      }

      Column {
        gap: 6
        weight: 1
        scroll: true

        if tab == "activity" {
          Text { text: "recent filings"; style: label; color: yellow }
          for t in take(trades, 40) key "${t.t}-${t.date}-${t.side}-${t.rng}-${t.doc}" {
            Column {
              gap: 2
              padding: [0, 6]
              background: alpha(t.buy ? green : red, 0.05)
              radius: 6
              Row {
                gap: 8
                align: center
                Text {
                  text: t.buy ? "BUY" : "SELL"
                  bold: true; width: 44; color: t.buy ? green : red; font: mono
                }
                Text { text: t.t; bold: true; color: accent; width: 56; font: mono }
                Text { text: t.name; style: small; color: muted; weight: 1; maxLines: 1 }
                Text {
                  text: t.mu == null ? (t.rng ?? "—") : "$${t.mu}${t.mu_u}"
                  bold: true; width: 72; align: end; font: mono
                }
              }
              Row {
                gap: 8
                Text { text: t.date; style: small; color: muted; width: 88; font: mono }
                Text { text: t.desc != "" ? t.desc : (t.type != "" ? t.type : ""); style: small; color: muted; weight: 1; maxLines: 2 }
                if t.doc != "" {
                  Button {
                    text: "pdf"
                    color: muted
                    onTap: url("https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/${t.year ?? sub(t.filed, 0, 4)}/${t.doc}.pdf")
                  }
                }
              }
            }
          }
        }

        if tab == "book" {
          Text { text: "disclosed buy notional by ticker"; style: label; color: yellow }
          for h in take(holdings, 12) key h.t {
            Column {
              gap: 4
              padding: [0, 6]
              radius: 6
              background: alpha(surface, 0.5)
              Row {
                gap: 8
                align: center
                Text { text: h.t; bold: true; color: accent; width: 56; font: mono }
                Text { text: h.name; style: small; color: muted; weight: 1; maxLines: 1 }
                Text {
                  text: h.px == null ? "" : "$${fixed(h.px, 2)}"
                  style: small; width: 72; align: end; font: mono
                }
                Text {
                  text: h.dpct == null ? "—" : "${h.dup ? "+" : ""}${fixed(h.dpct, 1)}%"
                  style: small; bold: true; color: h.dpct == null ? muted : (h.dup ? green : red); width: 64; align: end; font: mono
                }
              }
              Row {
                gap: 8
                Text { text: "${h.buys} buys · ${h.sells} sells"; style: small; color: muted; weight: 1 }
                Text {
                  text: h.mu == null ? "—" : "≈ $${h.mu}${h.mu_u} buys"
                  style: small; bold: true; width: 110; align: end; font: mono
                }
              }
              if len(h.spark) > 3 {
                let slo = min(h.spark)
                let shi = max(h.spark)
                Sparkline {
                  values: h.spark; min: slo; max: shi
                  color: h.dup ? green : red
                  area: true; thickness: 1.5; fill: width; height: 28
                }
              }
              onTap: url("https://www.cnbc.com/quotes/${h.t}")
            }
          }
          Text {
            text: "Amounts are STOCK Act ranges (midpoints) from House Periodic Transaction Reports. Live quotes via CNBC. Not investment advice."
            style: small; color: muted; maxLines: 4
          }
        }
      }

      Row {
        gap: 8
        Button { text: "house search"; onTap: url("https://disclosures-clerk.house.gov/FinancialDisclosure") }
        Button { text: "house clerk"; onTap: url("https://disclosures-clerk.house.gov/public_disc/financial-pdfs/") }
        Spacer { weight: 1 }
        Button { text: "close"; color: muted; onTap: close() }
      }
    }
  }
}
