widget "youtube volleyball" {
  size: 3x4
  minSize: 2x3
  padding: 0
  meta {
    description: "YouTube volleyball full matches (NCAA, FIVB, VNL, beach). Cycles thumbnails about once a minute; tap opens the video"
    version: "1.2"
    license: "MIT"
    category: "fun"
    owl: 5
  }
  requires { pacman: ["python"] }



  // goose cyberpunk neon palette — bright surfaces that pop
  let void = #050510
  let panel = #0a0a18
  let ink = #0a0a0a
  let neon = #00e5ff
  let neonPink = #ff2bd6
  let neonOrange = #ff6b00
  let neonLime = #39ff14
  let neonYellow = #fff200
  let neonRed = #ff2a2a
  let neonPurple = #c084fc
  let neonBlue = #00b8d4
  let textHi = #fff200
  let textMid = #ffe066
  let textDim = #b8ff00
  let upColor = #39ff14
  let downColor = #ff2bd6
  let warnColor = #ff6b00

  background: void

  source vb = cmd("""
python3 - <<'PY'
import json, os, re, time, urllib.request
from concurrent.futures import ThreadPoolExecutor, wait
from pathlib import Path

cache = str(Path.home() / ".cache" / "owl-playsight-volleyball")
Path(cache).mkdir(parents=True, exist_ok=True)
lib_path = str(Path(cache) / "lib.json")
show_n = 36
lib_max = 180
max_thumbs = 80
now = int(time.time())

QUERIES = [
    "volleyball full match",
    "volleyball full game",
    "volleyball full replay",
    "NCAA volleyball full match",
    "NCAA women's volleyball full match",
    "college volleyball full match",
]

# known full-match channel UCIDS (browse latest uploads)
CHANNEL_IDS = [
    "UCNMg6XDhRZI2QzL4pWOvP_w",  # Volleyball World
    "UCHQUWveEpeO1KTkwbDn6jNA",  # Beach Volleyball World
]

UA = "Mozilla/5.0 (omalauncher youtube-feed widget)"

def get_bytes(url, timeout=12, retries=2):
    last = None
    for i in range(retries):
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": UA, "Accept": "image/*,*/*;q=0.8"},
            )
            with urllib.request.urlopen(req, timeout=timeout) as r:
                data = r.read()
                if data:
                    return data
        except Exception as e:
            last = e
            time.sleep(0.25 * (i + 1))
    if last:
        raise last
    raise RuntimeError("empty image")

def post(url, body, timeout=18):
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "User-Agent": UA},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)

def client_ctx():
    return {"client": {
        "clientName": "WEB",
        "clientVersion": "2.20241001.00.00",
        "hl": "en", "gl": "US",
    }}

def search(q, params=None):
    body = {"context": client_ctx(), "query": q}
    if params:
        body["params"] = params
    return post("https://www.youtube.com/youtubei/v1/search?prettyPrint=false", body)

def channel_videos(ucid):
    '''Latest uploads tab for a channel.'''
    try:
        body = {
            "context": client_ctx(),
            "browseId": ucid,
            "params": "EgZ2aWRlb3PyBgQKAjoA",  # videos tab
        }
        return post("https://www.youtube.com/youtubei/v1/browse?prettyPrint=false", body)
    except Exception:
        return {}

def walk(o, key, out):
    if isinstance(o, dict):
        if key in o:
            out.append(o[key])
        for v in o.values():
            walk(v, key, out)
    elif isinstance(o, list):
        for v in o:
            walk(v, key, out)

def parse_len(s):
    if not s:
        return 0
    try:
        parts = [int(x) for x in s.strip().split(":")]
    except ValueError:
        return 0
    t = 0
    for p in parts:
        t = t * 60 + p
    return t

def parse_published(s):
    '''Rough age in seconds from '2 days ago' style text; smaller = newer.'''
    if not s:
        return 10**12
    s = s.lower().strip()
    m = re.match(r"(\d+)\s+(second|minute|hour|day|week|month|year)s?\s+ago", s)
    if not m:
        if "live" in s or "stream" in s:
            return 0
        return 10**12
    n = int(m.group(1))
    unit = m.group(2)
    mult = {
        "second": 1, "minute": 60, "hour": 3600, "day": 86400,
        "week": 604800, "month": 2592000, "year": 31536000,
    }[unit]
    return n * mult

def title_of(v):
    runs = (v.get("title") or {}).get("runs") or []
    t = "".join(r.get("text", "") for r in runs).strip()
    if not t:
        t = (v.get("title") or {}).get("simpleText") or ""
    return t.strip()

def channel_of(v):
    for key in ("ownerText", "longBylineText", "shortBylineText"):
        runs = (v.get(key) or {}).get("runs") or []
        if runs:
            return (runs[0].get("text") or "").strip()
    return ""

def is_live(v):
    badges = v.get("badges") or []
    for b in badges:
        label = (((b.get("metadataBadgeRenderer") or {}).get("label") or "")).lower()
        if "live" in label:
            return True
    # live overlay
    for ov in v.get("thumbnailOverlays") or []:
        r = ov.get("thumbnailOverlayTimeStatusRenderer") or {}
        style = (r.get("style") or "").upper()
        text = (((r.get("text") or {}).get("simpleText") or "")
                + "".join(x.get("text", "") for x in ((r.get("text") or {}).get("runs") or []))).lower()
        if style == "LIVE" or "live" in text:
            return True
    return False

# channels that post real full matches (boost + trust live)
TRUSTED = re.compile(
    r"(ncaa|volleyball\s*world|fivb|olympics?|olympic\s*games|team\s*usa|"
    r"usa\s*volleyball|avp|beach\s*volleyball\s*world|"
    r"nations\s*league|cev|plusliga|serie\s*a|"
    r"nebraska|wisconsin|texas\s*volleyball|penn\s*state|stanford|"
    r"louisville|kentucky|gopher|huskers|"
    r"flo\s*volleyball|ballertv|volleyball\s*tv|"
    r"big\s*ten|sec\s*network|pac-?12|acc\s*(digital|network)|"
    r"espn|cbs\s*sports|nbc\s*sports|women'?s\s*sports\s*heat|"
    r"olympic\s*channel|volleyball\s*england|sv\s*league)",
    re.I,
)
# reupload farms / clickbait uploaders
SPAM_CH = re.compile(
    r"(gorur|bazar|vlog|ngày|يوميات|عراق|tân\s*cổ|hoàng|islamer|kafela|"
    r"thanh\s*tú|habib\s*tv|pets?$|highlight\s*hub|sports?\s*rewind|"
    r"full\s*game\s*hd|match\s*replay|soccer|football\s*live|nba\s*full|"
    r"dias\s*de|diario|하루|vlogs?$|gaming|filipina\s*sports)",
    re.I,
)

def looks_spam_channel(ch):
    if not ch:
        return True
    if SPAM_CH.search(ch):
        return True
    # mostly non-latin short names = often reupload farms
    latin = len(re.findall(r"[A-Za-z]", ch))
    if latin < 3 and len(ch) > 0:
        return True
    return False

def accept(title, secs, live, channel=""):
    low = title.lower()
    ch = (channel or "").lower()
    if not re.search(r"volley", low):
        return False
    if looks_spam_channel(channel or ""):
        return False
    if re.search(
        r"\b(react(ion|ing)?|tier\s*list|ranking|podcast|press\s*conference|"
        r"crazy\s*\?|try\s*not\s*to|fails?|funny\s*moments?|compilation)\b",
        low,
    ):
        return False
    trusted = bool(TRUSTED.search(ch) or TRUSTED.search(low))
    fullish = bool(re.search(
        r"\b(full\s*(match|game|replay|set)|complete\s*match|entire\s*match|"
        r"championship\s*(match|final)|gold\s*medal|gold\s*final|final\s*match)\b",
        low,
    ))
    highlighty = bool(re.search(
        r"\b(highlights?|top\s*\d+|best\s*plays?|shorts?|trailer|preview|"
        r"teaser|compilation|skills?|recap)\b",
        low,
    ))
    if highlighty and not fullish:
        return False
    if live:
        return bool(fullish or trusted or re.search(r"\b(live\s*stream|vs\.?|vnl|fivb|ncaa)\b", low))
    if secs:
        if secs < 900 and not (fullish and secs >= 720):
            return False
        if secs < 600:
            return False
        if secs > 6 * 3600:
            return False
    elif not fullish:
        return False
    # untrusted must look like a real full match card
    if not trusted:
        if not fullish:
            return False
        if not re.search(r"\b(vs\.?|versus|final|championship|vnl|fivb|ncaa|olymp|gold)\b", low):
            return False
        # need two team-like tokens around vs
        if not re.search(r"[A-Za-z]{2,}.{0,40}\bvs\.?\b.{0,40}[A-Za-z]{2,}", low):
            return False
    return True

def thumb_url(vid, v=None):
    if v:
        thumbs = (v.get("thumbnail") or {}).get("thumbnails") or []
        if thumbs:
            u = thumbs[-1].get("url") or ""
            u = re.sub(r"\?.*", "", u)
            if u:
                return u
    return f"https://i.ytimg.com/vi/{vid}/hq720.jpg"

def thumb_path(vid):
    return os.path.join(cache, f"yt-{vid}.jpg")

def fetch_thumb(path, url, vid=None):
    if path and os.path.isfile(path) and os.path.getsize(path) > 0:
        return path
    urls = []
    if url:
        urls.append(url)
    if vid:
        urls.append(f"https://i.ytimg.com/vi/{vid}/hq720.jpg")
        urls.append(f"https://i.ytimg.com/vi/{vid}/hqdefault.jpg")
        urls.append(f"https://i.ytimg.com/vi/{vid}/mqdefault.jpg")
    seen = set()
    for u in urls:
        if not u or u in seen:
            continue
        seen.add(u)
        try:
            data = get_bytes(u)
            if not data or data[:3] not in (b"\xff\xd8\xff", b"\x89PN", b"GIF", b"RIFF"):
                # allow jpeg/png/gif/webp(riff); still write unknown if large enough
                if not data or len(data) < 200:
                    continue
            tmp = path + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, path)
            return path
        except Exception:
            continue
    return ""

def attach_thumbs(items):
    # Local disk thumbs: Image src under owl 5 must be a guest path, not https.
    jobs = []
    for it in items:
        vid = it.get("vid") or str(it.get("id") or "").removeprefix("yt-")
        if not vid:
            continue
        path = it.get("thumb") if (it.get("thumb") and not str(it.get("thumb")).startswith("http")) else thumb_path(vid)
        it["thumb"] = path
        url = it.get("thumbUrl") or thumb_url(vid)
        it["thumbUrl"] = url
        if not (os.path.isfile(path) and os.path.getsize(path) > 0):
            jobs.append((it, path, url, vid))
    if jobs:
        with ThreadPoolExecutor(max_workers=8) as pool:
            futs = [pool.submit(fetch_thumb, path, url, vid) for _, path, url, vid in jobs]
            wait(futs, timeout=45)
            for (it, path, _, _), fut in zip(jobs, futs):
                try:
                    got = fut.result(timeout=0)
                except Exception:
                    got = ""
                it["thumb"] = got if got else path
    # prune stale thumb files beyond max_thumbs
    try:
        files = sorted(
            (os.path.getmtime(os.path.join(cache, n)), os.path.join(cache, n))
            for n in os.listdir(cache)
            if n.startswith("yt-") and n.endswith(".jpg")
        )
        while len(files) > max_thumbs:
            _, old = files.pop(0)
            try:
                os.remove(old)
            except Exception:
                pass
    except Exception:
        pass
    return items

def item_from_renderer(v, discovered_at):
    vid = v.get("videoId")
    if not vid:
        return None
    title = title_of(v)
    live = is_live(v)
    length = (v.get("lengthText") or {}).get("simpleText") or ""
    # live often has no length
    if not length:
        for ov in v.get("thumbnailOverlays") or []:
            r = ov.get("thumbnailOverlayTimeStatusRenderer") or {}
            length = (r.get("text") or {}).get("simpleText") or length
            if not length:
                length = "".join(x.get("text", "") for x in ((r.get("text") or {}).get("runs") or []))
    secs = parse_len(length)
    ch = channel_of(v)
    if not accept(title, secs, live, ch):
        return None
    pub = (v.get("publishedTimeText") or {}).get("simpleText") or ""
    age = parse_published(pub)
    trusted = bool(TRUSTED.search(ch or "") or TRUSTED.search(title or ""))
    remote = thumb_url(vid, v)
    path = thumb_path(vid)
    return {
        "id": f"yt-{vid}",
        "vid": vid,
        "live": live,
        "name": (title[:140] or "YouTube volleyball"),
        "court": ch or "YouTube",
        "facility": "YouTube",
        "ts": now - age if age < 10**12 else None,
        "age": age,
        "secs": secs,
        "trusted": trusted,
        "thumb": path,
        "thumbUrl": remote,
        "video": f"https://www.youtube.com/watch?v={vid}",
        "source": "youtube",
        "discovered": discovered_at,
        "published": pub,
    }

# load library
lib = []
if os.path.isfile(lib_path):
    try:
        with open(lib_path) as f:
            lib = json.load(f)
            if not isinstance(lib, list):
                lib = []
    except Exception:
        lib = []

by_id = {it.get("id"): it for it in lib if isinstance(it, dict) and it.get("id")}
new_count = 0

def ingest(v):
    global new_count
    it = item_from_renderer(v, now)
    if not it:
        return
    prev = by_id.get(it["id"])
    if prev:
        # refresh live flag / title; keep earliest discovered
        it["discovered"] = prev.get("discovered", now)
        # keep a good local thumb if the file is still there
        prev_thumb = prev.get("thumb") or ""
        if prev_thumb and not str(prev_thumb).startswith("http") and os.path.isfile(prev_thumb) and os.path.getsize(prev_thumb) > 0:
            it["thumb"] = prev_thumb
        if prev.get("thumbUrl") and not it.get("thumbUrl"):
            it["thumbUrl"] = prev["thumbUrl"]
        by_id[it["id"]] = it
    else:
        by_id[it["id"]] = it
        new_count += 1

# --- search sweeps ---
for q in QUERIES:
    try:
        data = search(q)
    except Exception:
        continue
    vids = []
    walk(data, "videoRenderer", vids)
    walk(data, "playlistVideoRenderer", vids)
    for v in vids:
        ingest(v)

# channel uploads
for ucid in CHANNEL_IDS:
    data = channel_videos(ucid)
    vids = []
    walk(data, "videoRenderer", vids)
    walk(data, "gridVideoRenderer", vids)
    walk(data, "richItemRenderer", vids)
    # richItemRenderer nests videoRenderer — walk already gets those
    for v in vids:
        ingest(v)

# second pass core queries
for q in ("volleyball full match", "NCAA volleyball full match"):
    try:
        data = search(q)
    except Exception:
        continue
    vids = []
    walk(data, "videoRenderer", vids)
    for v in vids:
        ingest(v)

# merge library
items = list(by_id.values())
# re-filter library against current rules (spam drops on upgrade)
items = [it for it in items if accept(it.get("name") or "", it.get("secs") or 0, it.get("live"), it.get("court") or "")]
# prefer: live → trusted → newly discovered → fresher → longer
items.sort(key=lambda x: (
    0 if x.get("live") else 1,
    0 if x.get("trusted") else 1,
    -(x.get("discovered") or 0),
    x.get("age") if x.get("age") is not None else 10**12,
    -(x.get("secs") or 0),
))
items = items[:lib_max]

# persist library (strip heavy transient if needed — keep all fields)
try:
    with open(lib_path, "w") as f:
        json.dump(items, f, separators=(",", ":"))
except Exception:
    pass

# cycle list: live first, then newest discoveries / freshest
cycle = items[:show_n]
# ensure local thumbs exist for what the tile will show
attach_thumbs(cycle)
# drop cycle entries whose thumb never landed (blank Image is worse than skip)
cycle = [it for it in cycle if it.get("thumb") and os.path.isfile(it["thumb"]) and os.path.getsize(it["thumb"]) > 0] or cycle
print(json.dumps({"items": cycle, "new": new_count, "lib": len(items)}))
PY
  """) every 4h json timeout 90s

  source now = clock every 1m

  let items = vb.items ?? []
  let n = len(items)
  let idx = n > 0 ? floor(now / 60) % n : 0
  let cur = n > 0 ? items[idx] : null
  let tag = cur == null ? "" : (cur.live ? "LIVE" : "YT")
  let tagBg = cur != null && cur.live ? #e11d48 : #ff0000

  onTap: url(cur.video)

  if cur != null {
    Box { /* neon-wrap */
      fill: true
      background: void
      border: 2
      borderColor: neonPink
      radius: 12
      padding: 0
      clip: true

    Box {
      fill: true
      Image { src: cur.thumb; fit: cover; fill: true }
      Column {
        fill: true
        padding: 8
        align: start
        Row {
          Text {
            text: tag
            style: label
            bold: true
            color: #ffffff
            padding: [7, 3]
            background: tagBg
            radius: 4
            width: cur.live ? 40 : 36
            align: center
            maxLines: 1
          }
        }
        Spacer { weight: 1 }
        Column {
          gap: 2
          fill: width
          padding: [8, 6]
          background: alpha(#000, 0.72)
          Text { text: cur.name ?? ""; style: small; color: #fff; maxLines: 2 }
          Text { text: cur.court ?? ""; style: label; color: textDim; maxLines: 1 }
        }
      }
    }
    }

  } else {
    Box {
      fill: true
      background: panel
      Text { text: vb == null ? "scraping…" : "no videos yet"; style: small; color: textDim; align: center }
    }
  }
}
