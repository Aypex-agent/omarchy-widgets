float cl01(float v){return clamp(v,0.0,1.0);}
float h2(float x,float y,float s){float d=sin(x*127.1+y*311.7+s*74.7)*43758.5453;return fract(d);}
float n2(float x,float y,float s){
  float x0=floor(x),y0=floor(y);float fx=x-x0,fy=y-y0;
  float sx=fx*fx*(3.0-2.0*fx),sy=fy*fy*(3.0-2.0*fy);
  return mix(mix(h2(x0,y0,s),h2(x0+1.0,y0,s),sx),mix(h2(x0,y0+1.0,s),h2(x0+1.0,y0+1.0,s),sx),sy);
}
float fbm(float x,float y,float s){float v=0.0;float a=0.5;float f=1.0;
  for(int i=0;i<3;i++){v+=a*n2(x*f,y*f,s+float(i));a*=0.5;f*=2.0;}return v;}
float flr(float u){return floor(u+0.5);}
vec2 SKY0=vec2(0.0,0.2);vec2 SKY1=vec2(0.38,0.55);vec2 SKY2=vec2(0.7,0.84);
float3 skyRamp(float t){t=cl01(t);
  if(t<0.2)return mix(float3(0.659,0.353,0.502),float3(0.722,0.369,0.502),t/0.2);
  if(t<0.38)return mix(float3(0.722,0.369,0.502),float3(0.761,0.353,0.478),(t-0.2)/0.18);
  if(t<0.55)return mix(float3(0.761,0.353,0.478),float3(0.878,0.439,0.478),(t-0.38)/0.17);
  if(t<0.7)return mix(float3(0.878,0.439,0.478),float3(0.961,0.533,0.424),(t-0.55)/0.15);
  if(t<0.84)return mix(float3(0.961,0.533,0.424),float3(1.0,0.612,0.392),(t-0.7)/0.14);
  return mix(float3(1.0,0.612,0.392),float3(1.0,0.690,0.376),(t-0.84)/0.16);}
float3 seaRamp(float t){t=cl01(t);
  if(t<0.12)return mix(float3(1.0,0.745,0.478),float3(0.961,0.604,0.424),t/0.12);
  if(t<0.3)return mix(float3(0.961,0.604,0.424),float3(0.878,0.478,0.416),(t-0.12)/0.18);
  if(t<0.55)return mix(float3(0.878,0.478,0.416),float3(0.753,0.376,0.416),(t-0.3)/0.25);
  if(t<0.8)return mix(float3(0.753,0.376,0.416),float3(0.604,0.290,0.392),(t-0.55)/0.25);
  return mix(float3(0.604,0.290,0.392),float3(0.455,0.220,0.353),(t-0.8)/0.2);}
float isle(float x){
  float l=50.0+pow(x/52.0,2.0)*7.0-2.0*fbm(x/9.0,3.0,5.0);
  float r=52.0+pow((192.0-x)/46.0,2.0)*6.0-2.0*fbm(x/8.0,7.0,9.0);
  return min(x<60.0?l:99.0, x>140.0?r:99.0);}
bool gateAt(float x,float y){
  if(y>=22.0&&y<=88.0){if(abs(x-76.0)<=3.0+(y-22.0)/60.0)return true;if(abs(x-116.0)<=3.0+(y-22.0)/60.0)return true;}
  if(y>=33.0&&y<=36.0&&x>=62.0&&x<=130.0)return true;
  if(y>=22.0&&y<=33.0&&x>=94.0&&x<=98.0)return true;
  if(x>=54.0&&x<=138.0){float u=abs(x-96.0)/42.0;float lift=pow(u,3.0)*5.0;
    if(y>=15.0-lift&&y<=19.0-lift*0.8)return true;
    if(u<0.88&&y>=20.0&&y<=23.0)return true;}
  return false;}
bool et(float px,float py,float2 P,float2 Q){
  return ((P.y>py)!=(Q.y>py))&&(px<((Q.x-P.x)*(py-P.y))/(Q.y-P.y)+P.x);}
bool inpoly(float px,float py,float2 a,float2 b,float2 c,float2 d,float2 e,float2 f,float2 g){
  bool cc=false;
  cc=cc!=et(px,py,g,a);cc=cc!=et(px,py,a,b);cc=cc!=et(px,py,b,c);cc=cc!=et(px,py,c,d);
  cc=cc!=et(px,py,d,e);cc=cc!=et(px,py,e,f);cc=cc!=et(px,py,f,g);
  return cc;}
vec2 RL0=vec2(0.0,84.0);vec2 RL1=vec2(10.0,82.0);vec2 RL2=vec2(22.0,88.0);vec2 RL3=vec2(34.0,92.0);vec2 RL4=vec2(46.0,100.0);vec2 RL5=vec2(52.0,108.0);vec2 RL6=vec2(0.0,108.0);
vec2 RR0=vec2(192.0,92.0);vec2 RR1=vec2(182.0,90.0);vec2 RR2=vec2(172.0,96.0);vec2 RR3=vec2(160.0,102.0);vec2 RR4=vec2(154.0,108.0);vec2 RR5=vec2(192.0,108.0);vec2 RR6=vec2(192.0,92.0);
void cloudBand(float x,float y,float cx,float cy,float L,out float3 col){
  float a=cl01(1.0-abs(x-cx)/(L/2.0))*1.6;
  if(a>0.0&&y>=cy&&y<cy+flr(1.0+a)){
    float3 tgt=abs(cx-96.0)<40.0?float3(1.0,0.831,0.533):float3(0.604,0.290,0.416);
    col=mix(col,tgt,cl01(a)*0.6);}}
float3 colorAt(float x,float y,float t,float lay0){

  float3 col;float lay;
  // base
  if(y>=58.0){float k=(y-58.0)/50.0;col=seaRamp(k);float sd=abs(x-96.0)/(6.0+k*26.0);
    if(sd<1.0)col=mix(col,float3(1.0,0.812,0.478),(1.0-sd*sd)*(n2(x/7.0,y*0.9,3.0)>0.4?0.8:0.35)*(1.0-k*0.4));
    lay=2.0;}
  else{col=skyRamp(y/58.0);float d=length(vec2(x-96.0,(y-51.0)*1.6));
    // sun glow (matches (y-51)*1.6 scaled)
    d=length(vec2(x-96.0,(y-51.0)*1.6));
    col=mix(col,float3(1.0,0.769,0.439),cl01(1.0-d/64.0)*0.6);lay=0.0;
    cloudBand(x,y,40.0,30.0,46.0,col);cloudBand(x,y,150.0,24.0,38.0,col);
    cloudBand(x,y,118.0,38.0,30.0,col);cloudBand(x,y,20.0,44.0,34.0,col);cloudBand(x,y,170.0,46.0,26.0,col);}
  float yl=isle(x);
  if(y>=yl&&y<58.0){col=mix(float3(0.518,0.251,0.369),float3(0.353,0.165,0.322),cl01((y-yl)/5.0));lay=1.0;}
  if(gateAt(x,y)){col=n2(x/2.0,y/2.0,4.0)>0.75?float3(0.243,0.071,0.094):float3(0.165,0.047,0.071);lay=3.0;
    if((!gateAt(x-1.0,y)||!gateAt(x+1.0,y))&&length(vec2(x-96.0,y-51.0))<46.0){col=float3(0.478,0.141,0.125);}}
  if(y>88.0){
    float wob=flr(sin(y*1.3)*1.2);
    if(abs((x-wob)-76.0)<=3.0||abs((x-wob)-116.0)<=3.0){col=mix(col,float3(0.141,0.063,0.110),0.65);}}
  if(y>=80.0&&(inpoly(x+0.5,y+0.5,RL0,RL1,RL2,RL3,RL4,RL5,RL6)||inpoly(x+0.5,y+0.5,RR0,RR1,RR2,RR3,RR4,RR5,RR6))){
    col=fbm(x/4.0,y/4.0,11.0)>0.58?float3(0.243,0.071,0.094):float3(0.102,0.039,0.078);lay=4.0;}
  // frame overlays
  float ds=length(vec2(x-96.0,y-51.0));
  if(lay==0.0&&ds<9.0){col=ds<7.0?float3(1.0,0.965,0.847):float3(1.0,0.902,0.627);}
  if(lay==2.0){
    for(int i=0;i<11;i++){
      float ph=float(i)/11.0;float s=float(i)*3.7;float f0=fract(ph+t*0.045);
      float yb=59.0+50.0*pow(f0,1.7);float amp=0.3+f0*2.2;float thick=f0>0.55?2.0:1.0;
      if(n2(x/(4.0+f0*10.0),s,7.0)<0.3)continue;
      float yy=yb+sin(x*(0.16-f0*0.1)+s+t*0.4)*amp;
      float sun=cl01(1.0-abs(x-96.0)/(10.0+f0*30.0));
      float3 lc=mix(float3(1.0,0.784,0.604),float3(1.0,0.902,0.627),sun);
      float ry=flr(y);
      for(int k2=0;k2<2;k2++){if(float(k2)<thick&&flr(yy-float(k2))==ry){col=mix(col,lc,0.55+f0*0.35);}}
      if(flr(yy+1.0)==ry){col=mix(col,float3(0.455,0.220,0.353),0.45+f0*0.3);}
      if(f0>0.6&&flr(yy+2.0)==ry){col=mix(col,float3(0.455,0.220,0.353),0.4);}
    }
    for(int k=0;k<2;k++){float f1=fract(t*0.5+float(k)*0.5);float r=4.0+f1*9.0;
      if(flr(89.0+f1*2.0)==flr(y)&&(abs(x-76.0)<=r||abs(x-116.0)<=r)){col=mix(col,float3(1.0,0.910,0.816),(1.0-f1)*0.8);}}
  }
  if(lay<=2.0&&lay!=4.0){
    // top of rock below -> spray
    float xb=x,yb2=y+1.0;bool isRockBelow=false;
    if(yb2>=80.0&&(inpoly(xb+0.5,yb2+0.5,RL0,RL1,RL2,RL3,RL4,RL5,RL6)||inpoly(xb+0.5,yb2+0.5,RR0,RR1,RR2,RR3,RR4,RR5,RR6))){isRockBelow=true;}
    if(isRockBelow){float surf=0.5+0.5*sin(t*0.9+x*0.05);
      if(surf>0.45){col=mix(col,float3(0.973,0.784,0.690),surf*0.7);}}}
  if(lay==0.0){
    float gt=fract(t+1.0-(floor((t+1.0)/26.0)*26.0))/26.0;
    float gx=mix(212.0,-50.0,gt);float gy=22.0+sin(gt*7.0)*3.0;
    for(int i=0;i<6;i++){
      float di=float(i);float ddx=di*7.0+mod(di,2.0)*3.0;float dy=mod(di,3.0)*3.0-di;float ph=di*1.1;
      float bx=gx+ddx;float by=gy+dy+sin(t*1.5+ph);float f=sin(t*7.0+ph);
      float up=f>0.3?-1.0:(f<-0.3?1.0:0.0);
      float ry=flr(y),rx=flr(x);
      if(flr(bx)==rx&&flr(by)==ry){col=float3(0.141,0.063,0.110);}
      if(flr(bx-1.0)==rx&&flr(by+min(0.0,up))==ry){col=float3(0.141,0.063,0.110);}
      if(flr(bx+1.0)==rx&&flr(by+min(0.0,up))==ry){col=float3(0.141,0.063,0.110);}
      if(flr(bx-2.0)==rx&&flr(by+up)==ry){col=float3(0.141,0.063,0.110);}
      if(flr(bx+2.0)==rx&&flr(by+up)==ry){col=float3(0.141,0.063,0.110);}
    }}
  return col;
}
half4 main(float2 p){
  vec2 cell=size/HEX;
  float2 ci=floor(p/cell);
  float ly=(p.y-ci.y*cell.y)/cell.y;
  float t=(fps>0.5?floor(clkT*24.0+0.01):clkT)*0.35;
  float x0=ci.x*2.0+0.5,y0=ci.y*2.0+0.5;
  // 4-sample average, exactly like the generator's 2x2 downsample
  float3 acc=float3(0.0,0.0,0.0);
  acc+=colorAt(x0-0.5,y0-0.5,t,0.0);
  acc+=colorAt(x0+0.5,y0-0.5,t,0.0);
  acc+=colorAt(x0-0.5,y0+0.5,t,0.0);
  acc+=colorAt(x0+0.5,y0+0.5,t,0.0);
  float3 col=acc*0.25;
 // quantize to palette + block-glyph fill
  int best=0;float bd=1e18;
  for(int i=0;i<49;i++){float3 c=pal(i);
    float d2=(c.r*255.0-col.r*255.0)*(c.r*255.0-col.r*255.0)*0.3+(c.g*255.0-col.g*255.0)*(c.g*255.0-col.g*255.0)*0.59+(c.b*255.0-col.b*255.0)*(c.b*255.0-col.b*255.0)*0.11;
    if(d2<bd){bd=d2;best=i;}}
  float3 pc=pal(best);
  if(abs(hue)>0.01){float3 W=float3(0.2126,0.7152,0.0722);float a=radians(hue);float cs=cos(a),sn=sin(a);pc=pc*cs+cross(W,pc)*sn+W*dot(W,pc)*(1.0-cs);}
  pc=clamp((pc-0.5)*(ctr*0.01)+0.5,0.0,1.0);
  pc=clamp(pc*(brt*0.01)*float3(fr*0.01,fg*0.01,fb*0.01),0.0,1.0);
  if(bkI>0.5){float3 WB=float3(0.2126,0.7152,0.0722);
    float ahb=radians(bkH);float acb=cos(ahb),asb=sin(ahb);float3 redb=float3(0.35,0.0,0.0);
    float3 bh=redb*acb+cross(WB,redb)*asb+redb*dot(WB,redb)*(1.0-acb);
    float lb=dot(pc,WB);
    if(lb<0.10){pc=mix(pc,bh,cl01(1.0-lb/0.10)*(bkI*0.01));}}
  float Y=(0.2126*col.r+0.7152*col.g+0.0722*col.b);
  float lvv=Y>0.86?7.0:clamp(flr(5.0+(Y-lum(best))*12.0),3.0,6.0);
  float fill=(lvv+1.0)/8.0;
  if(ly>1.0-fill){return half4(pc,1.0);}
  float3 bg=float3(0.055,0.031,0.051);
  if(bkI>0.5){float3 WB2=float3(0.2126,0.7152,0.0722);
    float ahb2=radians(bkH);float acb2=cos(ahb2),asb2=sin(ahb2);float3 redb2=float3(0.35,0.0,0.0);
    float3 bh2=redb2*acb2+cross(WB2,redb2)*asb2+redb2*dot(WB2,redb2)*(1.0-acb2);
    bg=mix(bg,bh2,bkI*0.01*0.9);}
  return half4(bg,1.0);
}
"""
      }
      Row {
        padding: [0, 10, 10, 0]
        Button { text: play > 0.5 ? (ja ? "⏸ 停止" : "⏸ Pause") : (ja ? "▶ 再生" : "▶ Play"); onTap: { if (play > 0.5) { tcap = time - t0; play = 0 } else { t0 = time - tcap; play = 1 } } }
      }
      Row {
        padding: [0, 0, 10, 0]
        Text { text: ja ? "24 fps（間引き）" : "24 fps throttle"; weight: 1 }
        Button { text: fps24 ? "on" : "off"; onTap: fps24 = 1 - fps24 }
      }
      Text { text: ja ? "明るさ（100=標準）" : "Brightness (100 = normal)" }
      Slider { value: brt; min: 0; max: 200; step: 1; live: true; onChange: brt = value }
      Text { text: ja ? "コントラスト（100=標準）" : "Contrast (100 = normal)" }
      Slider { value: ctr; min: 0; max: 200; step: 1; live: true; onChange: ctr = value }
      Text { text: ja ? "色味フィルター R（100=変更なし）" : "Tint filter R (100 = unchanged)" }
      Slider { value: fr; min: 0; max: 200; step: 1; live: true; onChange: fr = value }
      Text { text: ja ? "色味フィルター G" : "Tint filter G" }
      Slider { value: fg; min: 0; max: 200; step: 1; live: true; onChange: fg = value }
      Text { text: ja ? "色味フィルター B" : "Tint filter B" }
      Slider { value: fb; min: 0; max: 200; step: 1; live: true; onChange: fb = value }
      Text { text: ja ? "黒部分置換・色相（0=赤,210=青）" : "Black replacement · hue (0=red, 210=blue)" }
      Slider { value: bkH; min: 0; max: 355; step: 5; live: true; onChange: bkH = value }
      Text { text: ja ? "黒部分置換・強さ（0=なし）" : "Black replacement · strength (0 = off)" }
      Slider { value: bkI; min: 0; max: 100; step: 5; live: true; onChange: bkI = value }
      Row {
        padding: [0, 8, 0, 0]
        Button { text: ja ? "黒→青" : "Black→Blue"; onTap: { bkH = 210; bkI = 70 } }
        Button { text: ja ? "黒→緑" : "Black→Green"; onTap: { bkH = 130; bkI = 70 } }
        Button { text: ja ? "黒→赤" : "Black→Red"; onTap: { bkH = 0; bkI = 70 } }
        Button { text: ja ? "黒 切" : "Black off"; onTap: bkI = 0 }
      }
      Text { text: ja ? "色相（hue）" : "Hue" }
      Slider { value: hue; min: -180; max: 180; step: 5; live: true; onChange: hue = value }
      Row {
        padding: [0, 8, 0, 0]
        Button { text: "0"; onTap: hue = 0 }
        Button { text: "+30"; onTap: hue = 30 }
        Button { text: "-60"; onTap: hue = -60 }
        Button { text: "+120"; onTap: hue = 120 }
        Button { text: "+180"; onTap: hue = 180 }
      }
      Row {
        padding: [0, 8, 0, 0]
        Button { text: ja ? "初期値に戻す" : "Reset to defaults"; onTap: { hue = 45; brt = 149; ctr = 105; fr = 145; fg = 35; fb = 51; bkI = 0 } }
      }
    }
  }
}
