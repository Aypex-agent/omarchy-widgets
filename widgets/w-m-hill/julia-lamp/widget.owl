widget "julia lamp" {
  meta { owl: 13; description: "A Julia set lava lamp in your theme's colors. It opens on the Mandelbrot set and melts into drifting Julia sets; tap a point to see its Julia set"; version: "1.0"; license: "MIT"; category: "fun" }
  size: 3x4
  minSize: 2x2
  padding: 0

  // A tap picks c from where it lands on the Mandelbrot set's view, holds it a
  // while, then glides back onto the drifting path. `from` is [cx, cy, m] as the
  // tap found them, so the jump eases instead of snapping.
  state tapAt = -100
  state tapC = [0, 0]
  state from = [0, 0, 0]

  // Seconds since the last tap. `time` starts again from 0 when the tile comes
  // back on screen, so a tap that seems to be in the future was long ago.
  let since = time >= tapAt ? time - tapAt : 1000

  // The Mandelbrot set for 3 s, then it melts into a Julia set over 6 s.
  let i0 = clamp((time - 3) / 6, 0, 1)
  let intro = i0 * i0 * (3 - 2 * i0)

  // c drifts slowly along the main cardioid's edge, a little in and out of it,
  // where the Julia sets change shape the most.
  let ang = time * 0.045 + 2.2
  let rr = 1.0 + 0.04 * sin(time * 0.09)
  let ax = rr * (0.5 * cos(ang) - 0.25 * cos(2 * ang))
  let ay = rr * (0.5 * sin(ang) - 0.25 * sin(2 * ang))

  // Into the tapped c over 0.6 s, kept 8 s, then back onto the path over 5 s.
  let k0 = clamp(since / 0.6, 0, 1)
  let kin = k0 * k0 * (3 - 2 * k0)
  let k1 = clamp((since - 8) / 5, 0, 1)
  let kout = k1 * k1 * (3 - 2 * k1)
  let cx = lerp(lerp(from[0], tapC[0], kin), ax, kout)
  let cy = lerp(lerp(from[1], tapC[1], kin), ay, kout)
  let m = lerp(lerp(from[2], 1, kin), intro, kout)

  // The view the tap reads: the Mandelbrot set's, 3 units across the short side.
  let W = tileWidth ?? 300
  let H = tileHeight ?? 300
  let S = min(W, H)

  Shader {
    fill: true
    fallback: surface
    uniforms: { c: [cx, cy], m: m, wax: accent, p1: cyan, p2: magenta, p3: orange, p4: yellow }

    onTap: {
      from = [cx, cy, m]
      tapC = [-0.5 + (x - W / 2) / S * 3, -(y - H / 2) / S * 3]
      tapAt = time
    }

    // m blends the two: 0 is the Mandelbrot set (z starts at 0, c is the
    // pixel), 1 the Julia set of c (z starts at the pixel). Drawn on a coarse
    // grid of about 110 cells across the short side, which keeps 64 iterations
    // per cell cheap.
    code: """
      uniform float2 c;
      uniform float m;
      uniform half4 wax;
      uniform half4 p1;
      uniform half4 p2;
      uniform half4 p3;
      uniform half4 p4;

      // The color map: escape bands flowing outward, every other one clear and
      // the rest flat globs of the theme's colors in turn, with a darker rim.
      // Far from the set it's all clear, so the globs float on the tile.
      half4 glob(float sn, float t) {
        if (sn < 2.0) return half4(0.0);
        float b = sn * 0.5 - t * 0.15;
        float f = fract(b);
        if (f > 0.5) return half4(0.0);
        int i = int(mod(floor(b), 4.0));
        half4 col = i == 0 ? p1 : i == 1 ? p2 : i == 2 ? p3 : p4;
        if (f < 0.07 || f > 0.43) col.rgb *= 0.7;
        return half4(col.rgb, 1.0);
      }

      half4 main(float2 p) {
        float s = min(size.x, size.y);
        float cell = max(floor(s / 110.0), 1.0);
        p = (floor(p / cell) + 0.5) * cell;
        float2 u = (p - size * 0.5) / s * float2(1.0, -1.0);

        float2 pm = float2(-0.5, 0.0) + u * 3.0;
        float2 pj = u * 3.2;
        float2 z = pj * m;
        float2 k = mix(pm, c, m);

        float n = 0.0;
        bool inside = true;
        for (int i = 0; i < 64; i++) {
          z = float2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + k;
          if (dot(z, z) > 256.0) { inside = false; break; }
          n += 1.0;
        }

        half4 col;
        if (inside) {
          // The wax: the set itself, a solid blob that pulses gently.
          col = half4(wax.rgb * (0.85 + 0.15 * sin(time * 0.7)), 1.0);
        } else {
          // Smooth escape count, so the bands drift outward over time.
          float sn = n + 1.0 - log2(log2(dot(z, z)) * 0.5);
          col = glob(sn, time);
        }
        return half4(col.rgb * col.a, col.a);
      }
    """
  }
}
