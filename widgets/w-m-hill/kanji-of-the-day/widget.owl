widget "kanji of the day" {
  meta { owl: 13; description: "A shodo-style kanji for each day of the year, with its readings and meaning set like a calligraphy. Tap a quarter: top left text, top right color, bottom left font, bottom right layer"; version: "1.0"; license: "MIT"; category: "fun" }
  size: 3x3
  minSize: 1x1
  padding: 0
  // "clear" drops the tile's own glass, so only the ink sits on the wallpaper.
  background: backdrop == "clear" ? alpha(background, 0) : null

  requires { pacman: ["python", "python-pillow", "python-fonttools"] }

  // The tile is one Canvas, laid out from its own size, so it reads from one cell to a whole page.
  // Over it, four quarters are the controls, a tap each: top left cycles what's shown with the kanji,
  // top right the theme color, bottom left the font, bottom right the render layer.

  // What's shown with the kanji: its readings (top right), its meaning (bottom left) or both, set vertically. One of: kanji, reading, meaning, both
  state mode = "kanji" persist
  // The theme color the kanji is inked in. One of: foreground, accent, red, orange, yellow, green, cyan, blue, magenta
  state hue = "foreground" persist
  // The typeface: Yuji Syuku and Yuji Boku are brush, Zen Kurenaido a brush pen, Shippori a mincho, Klee a pencil, Dela a heavy gothic. One of: syuku, boku, kurenaido, mincho, klee, gothic
  state font = "syuku" persist
  // How the kanji is drawn: brush ink, as pixels, halftone dots or Unicode braille. One of: ink, pixel, halftone, braille
  state layer = "ink" persist
  // How fine the pixel, halftone and braille grids are. One of: low, medium, high
  state detail = "medium" persist
  // An ensō, a brush circle, drawn round the kanji under any layer
  state enso = false persist
  // The red hanko seal, stamped with the day of the month
  state seal = true persist
  // The date in kanji numerals, down the top left
  state date = true persist
  // Behind the kanji: a faint wash of its ink on the tile, the tile alone, or nothing at all (clear). One of: wash, plain, clear
  state backdrop = "wash" persist
  // Days away from today, to look at other days' kanji (0 is today)
  state shift = 0 persist

  // What the last tap changed, shown for a moment at the top or bottom edge, by the half tapped.
  state hint = ""
  state hintLow = false
  state hintTicks = 0
  every 1s { if hintTicks > 0 { hintTicks = hintTicks - 1 } }

  source now = clock every 1m

  // The year, one line a day: date|kanji|on'yomi|kun'yomi|meaning|what the day is. Feb 29 has 閏, leap.
  let data = """
    01-01|元|ゲン|もと|origin, beginning|New Year's Day · 元旦
