    11-27|灰|カイ|はい|ash|
    11-28|瀬|ライ|せ|shallows|
    11-29|頂|チョウ|いただき|summit|
    11-30|晩|バン||late, evening|the end of autumn
    12-01|師|シ||teacher|shiwasu, the month teachers run
    12-02|走|ソウ|はしる|run|師走
    12-03|忘|ボウ|わすれる|forget|bōnenkai season
    12-04|銀|ギン||silver|
    12-05|熊|ユウ|くま|bear|
    12-06|眠|ミン|ねむる|sleep|
    12-07|積|セキ|つもる|pile up|大雪 · greater snow
    12-08|悟|ゴ|さとる|enlightenment|Rōhatsu, Bodhi Day
    12-09|剣|ケン|つるぎ|sword|
    12-10|人|ジン|ひと|person|Human Rights Day
    12-11|坂|ハン|さか|slope|
    12-12|漢|カン||Han, kanji|Kanji Day · kanji of the year
    12-13|煤|バイ|すす|soot|susuharai, year-end cleaning
    12-14|義|ギ||righteousness|the 47 rōnin, 1703
    12-15|年|ネン|とし|year|
    12-16|器|キ|うつわ|vessel|
    12-17|羽|ウ|はね|feather|Hagoita-ichi fair
    12-18|霧|ム|きり|fog|
    12-19|闇|アン|やみ|darkness|
    12-20|蔵|ゾウ|くら|storehouse|
    12-21|願|ガン|ねがう|wish|
    12-22|柚|ユウ|ゆず|yuzu|冬至 · winter solstice, yuzu baths
    12-23|南|ナン|みなみ|south|kabocha (南瓜) for the solstice
    12-24|聖|セイ|ひじり|holy|Christmas Eve
    12-25|贈|ゾウ|おくる|gift|Christmas
    12-26|餅|ヘイ|もち|rice cake|mochitsuki
    12-27|掃|ソウ|はく|sweep|ōsōji, the big clean
    12-28|了|リョウ||finish|shigoto-osame, work ends
    12-29|飾|ショク|かざる|decorate|New Year decorations
    12-30|祝|シュク|いわう|celebrate|
    12-31|除|ジョ|のぞく|remove|Ōmisoka · joya no kane, 108 bells
  """
  let db = lines(trim(data)).map(l => split(trim(l), "|"))
  let day = now + shift * 86400
  let today = find(db, r => r[0] == fmtTime(day, "MM-dd")) ?? db[0]
  let kanji = today[1]
  let onyomi = today[2]
  let kunyomi = today[3]
  let meaning = today[4]
  let note = today[5]

  // Kanji numerals for the seal and the date.
  let digits = ["", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
  let dom = int(fmtTime(day, "d"))
  let moy = int(fmtTime(day, "M"))
  let domKanji = ["", "十", "廿", "卅"][floor(dom / 10)] + digits[dom % 10]
  let moyKanji = moy >= 10 ? "十" + digits[moy - 10] : digits[moy]

  let modes = ["kanji", "reading", "meaning", "both"]
  let showReading = mode == "reading" || mode == "both"
  let showMeaning = mode == "meaning" || mode == "both"
  let hues = ["foreground", "accent", "red", "orange", "yellow", "green", "cyan", "blue", "magenta"]
  let inks = {foreground: foreground, accent: accent, red: red, orange: orange, yellow: yellow, green: green, cyan: cyan, blue: blue, magenta: magenta}
  let ink = get(inks, hue, foreground)
  let fontKeys = ["syuku", "boku", "kurenaido", "mincho", "klee", "gothic"]
  let fontNames = {syuku: "Yuji Syuku", boku: "Yuji Boku", kurenaido: "Zen Kurenaido", mincho: "Shippori Mincho", klee: "Klee One", gothic: "Dela Gothic"}
  let layers = ["ink", "pixel", "halftone", "braille"]

  // The fonts and the kanji as grids, for the pixel, halftone and braille layers. The first time a font is
  // used it is downloaded from Google Fonts (OFL), cut down to the characters in data, and kept in
  // ~/.cache/kanji-of-the-day with the grids; the launcher can't load the whole fonts (over 8 MB). Until a
  // font is there the kanji shows in the launcher's own font.
  let inkPy = """
    import json, os, re, sys, urllib.request
    char, key, res, chars = sys.argv[1:5]
    GF = "https://raw.githubusercontent.com/google/fonts/main/ofl/"
    FONTS = {"syuku": "yujisyuku/YujiSyuku-Regular.ttf", "boku": "yujiboku/YujiBoku-Regular.ttf", "kurenaido": "zenkurenaido/ZenKurenaido-Regular.ttf", "mincho": "shipporimincho/ShipporiMincho-Regular.ttf", "klee": "kleeone/KleeOne-Regular.ttf", "gothic": "delagothicone/DelaGothicOne-Regular.ttf"}
    key = key if key in FONTS else "syuku"
    D = os.path.expanduser("~/.cache/kanji-of-the-day")
    os.makedirs(D, exist_ok=True)
    def font(k):
        old = [f for f in os.listdir(D) if re.fullmatch(k + "-[0-9]+[.]ttf", f)]
        if old:
            return D + "/" + old[0]
        from fontTools import subset
        tmp = D + "/" + k + ".full"
        urllib.request.urlretrieve(GF + FONTS[k], tmp)
        o = subset.Options()
        o.layout_features = ["*"]
        o.name_IDs = ["*"]
        f = subset.load_font(tmp, o)
        s = subset.Subsetter(o)
        s.populate(text=chars + "〇一二三四五六七八九十廿卅月日年" + "".join(chr(c) for c in range(32, 127)))
        s.subset(f)
        out = D + "/" + k + "-" + str(os.getpid()) + ".ttf"
        subset.save_font(f, out + ".tmp", o)
        os.replace(out + ".tmp", out)
        os.remove(tmp)
        return out
    def glyph(path, n):
        from PIL import Image, ImageDraw, ImageFont
        big = 512
        img = Image.new("L", (big * 2, big * 2), 0)
        ImageDraw.Draw(img).text((big // 2, big // 2), char, font=ImageFont.truetype(path, big), fill=255)
        box = img.getbbox()
        if not box:
            return [[0] * n for _ in range(n)]
        img = img.crop(box)
        w, h = img.size
        side = int(max(w, h) / 0.9)
        sq = Image.new("L", (side, side), 0)
        sq.paste(img, ((side - w) // 2, (side - h) // 2))
        px = sq.resize((n, n), Image.Resampling.BOX).load()
        return [[px[x, y] / 255 for x in range(n)] for y in range(n)]
    path = font(key)
    seal = font("mincho")
    res = res if res in ("low", "high") else "medium"
    pn, dn, bn = {"low": (16, 12, 24), "medium": (24, 18, 40), "high": (40, 28, 64)}[res]
    cache = D + "/" + format(ord(char[0]), "x") + "-" + key + "-" + res + ".json"
    if os.path.exists(cache):
        grids = json.load(open(cache))
    else:
        g = glyph(path, pn)
        px = ["".join("b" if v > 0.55 else "a" if v > 0.2 else "." for v in row) for row in g]
        g = glyph(path, dn)
        dots = ["".join(str(min(9, round(v * 9))) for v in row) for row in g]
        g = glyph(path, bn)
        bits = [(0, 0, 1), (0, 1, 2), (0, 2, 4), (1, 0, 8), (1, 1, 16), (1, 2, 32), (0, 3, 64), (1, 3, 128)]
        br = ["".join(chr(10240 + sum(b for dx, dy, b in bits if g[y * 4 + dy][x * 2 + dx] > 0.4)) for x in range(bn // 2)) for y in range(bn // 4)]
        grids = {"px": px, "dots": dots, "br": br}
        json.dump(grids, open(cache + ".tmp", "w"))
        os.replace(cache + ".tmp", cache)
    print(json.dumps(dict(grids, char=char, font=key, res=res, face=path, seal=seal), ensure_ascii=False))
  """
  source raster = cmd("python3 -c ${sh(inkPy)} ${sh(kanji)} ${sh(font)} ${sh(detail)} ${sh(data)}") every 1h json timeout 3m
  let face = raster != null && raster.font == font ? raster.face : null
  let sealFace = raster != null ? raster.seal : "serif"

  Box {
    Canvas {
      fill: true
      background: backdrop == "wash" ? radial(0.5, 0.5, 0.75, [alpha(ink, 0.07), alpha(ink, 0.0)]) : null

      let s = min(width, height)
      let m = max(4, s * 0.07)
      // Side text: the readings and the meaning, one column of characters each.
      let ts = clamp(s * 0.075, 6, 26)
      let side = showReading ? min(ts * 2.0, s * 0.15) : showMeaning ? min(ts * 1.6, s * 0.14) : 0
      let big = min(width - 2 * m - 2 * side, height - 2 * m) * 0.9
      let S = enso ? big * 0.72 : big
      let cx = width / 2
      let cy = height / 2
      let raw = raster.char == kanji && raster.font == font && raster.res == detail ? raster : null
      // These fonts' glyphs sit a little low in their line; lift them to the middle, in ems.
      let lift = 0.04
      let grid = layer == "pixel" || layer == "halftone" || layer == "braille"

      // Ensō: one brush stroke round the kanji, thick where it starts, dry where it lifts.
      if enso {
        let r = min(big * 0.5, s / 2 - m)
        let start = 200 + hash(kanji) * 140
        // Opaque steps from ink towards the paper, so where they overlap doesn't show.
        for i in range(40) {
          arc(cx, cy, r, start + i * 7.5, 8.5, stroke: mix(background, ink, 0.8 - i * 0.014), width: max(1, r * (0.15 - i * 0.0032)), cap: i == 0 || i == 39 ? "round" : "butt")
        }
      }

      // The kanji itself.
      if !grid || raw == null {
        // A wet edge: the stroke bled a little into the paper.
        if !grid {
          for d in [[-1, 0], [1, 0], [0, -1], [0, 1]] {
            text(kanji, cx + d[0] * S * 0.008, cy - S * lift + d[1] * S * 0.008, size: S, color: alpha(ink, 0.12), font: face, align: center)
          }
        }
        text(kanji, cx, cy - S * lift, size: S, color: grid ? alpha(ink, 0.3) : ink, font: face, align: center)
      } else if layer == "pixel" {
        let p = S / len(raw.px)
        sprite(raw.px, cx - S / 2, cy - S / 2, p, palette: {a: alpha(ink, 0.45), b: ink})
      } else if layer == "halftone" {
        let n = len(raw.dots)
        let p = S / n
        for row, j in raw.dots {
          for i in range(n) {
            let v = num(sub(row, i, i + 1), 0)
            if v > 0 {
              circle(cx - S / 2 + (i + 0.5) * p, cy - S / 2 + (j + 0.5) * p, p * 0.56 * sqrt(v / 9), fill: ink)
            }
          }
        }
      } else {
        let nw = len(raw.br[0])
        let cw = S / nw
        let chh = S / len(raw.br)
        for row, j in raw.br {
          for i in range(nw) {
            let ch = sub(row, i, i + 1)
            if ch != "⠀" {
              text(ch, cx - S / 2 + (i + 0.5) * cw, cy - S / 2 + (j + 0.5) * chh, size: chh * 0.95, color: ink, align: center)
            }
          }
        }
      }

      // Readings, top right, read top to bottom and right to left: on'yomi in katakana, then kun'yomi.
      if showReading {
        let cols = [onyomi, kunyomi].filter(t => t != "")
        for t, c in cols {
          for i in range(len(t)) {
            text(sub(t, i, i + 1), width - m - ts * 0.5 - c * ts * 1.45, m + ts * (0.55 + i * 1.08), size: ts, color: c == 0 ? ink : alpha(ink, 0.7), font: face, align: center)
          }
        }
      }

      // Meaning, bottom left, turned to run down the page like a line of vertical writing.
      if showMeaning {
        let te = clamp(min(ts * 0.95, (height - 2 * m) * 0.8 / max(1, len(meaning) * 0.52)), 5, 18)
        rotate(90, m + te * 0.5, height - m) {
          text(meaning, m + te * 0.5, height - m, size: te, color: alpha(ink, 0.8), align: end, font: "serif", italic: true)
        }
      }

      // The date, top left, when there's room, like an inscription: month and day in kanji numerals.
      if date && s >= 150 {
        let dt = moyKanji + "月" + domKanji + "日"
        let td = ts * 0.8
        for i in range(len(dt)) {
          text(sub(dt, i, i + 1), m + td * 0.5, m + td * (0.55 + i * 1.1), size: td, color: alpha(foreground, 0.45), font: sealFace, align: center)
        }
      }

      // What the day is, under the kanji, on big tiles.
      if note != "" && s >= 260 {
        text(note, cx, min(height - m - ts, cy + big / 2 + ts * 0.8), size: ts * 0.6, color: muted, align: center, font: "serif", italic: true)
      }

      // Hanko: a red seal with the day of the month, bottom right.
      if seal && s >= 72 {
        let q = clamp(s * 0.12, 11, 40)
        let qx = width - m - q
        let qy = height - m - q
        rect(qx, qy, q, q, radius: q * 0.12 * corners, fill: alpha(red, 0.85))
        rect(qx + q * 0.08, qy + q * 0.08, q * 0.84, q * 0.84, radius: q * 0.08 * corners, stroke: alpha(background, 0.6), width: max(0.6, q * 0.03))
        if len(domKanji) == 1 {
          text(domKanji, qx + q / 2, qy + q / 2, size: q * 0.62, color: background, font: sealFace, align: center, bold: true)
        } else {
          text(sub(domKanji, 0, 1), qx + q / 2, qy + q * 0.3, size: q * 0.42, color: background, font: sealFace, align: center, bold: true)
          text(sub(domKanji, 1, 2), qx + q / 2, qy + q * 0.7, size: q * 0.42, color: background, font: sealFace, align: center, bold: true)
        }
      }

      // What the last tap changed, on a small pill at the middle of the top or bottom edge, clear of
      // the date, the readings, the meaning and the seal in the corners.
      if hintTicks > 0 && hint != "" {
        let hs = clamp(s * 0.06, 7, 13)
        let hw = min(width * 0.6, len(hint) * hs * 0.6 + hs * 1.4)
        let hy = hintLow ? height - m * 0.6 - hs : m * 0.6 + hs
        rect(cx - hw / 2, hy - hs * 0.85, hw, hs * 1.7, radius: hs * 0.85 * corners, fill: alpha(background, 0.85))
        text(hint, cx, hy, size: hs, color: foreground, align: center)
      }
    }

    // The controls: the tile's four quarters, one tap each.
    Column {
      fill: true
      gap: 0
      Row {
        weight: 1
        gap: 0
        Box {
          weight: 1; fill: height
          onTap: { mode = modes[(indexOf(modes, mode) + 1) % len(modes)]; hint = mode == "both" ? "reading + meaning" : mode; hintLow = false; hintTicks = 2; haptic() }
        }
        Box {
          weight: 1; fill: height
          onTap: { hue = hues[(indexOf(hues, hue) + 1) % len(hues)]; hint = hue; hintLow = false; hintTicks = 2; haptic() }
        }
      }
      Row {
        weight: 1
        gap: 0
        Box {
          weight: 1; fill: height
          onTap: { font = fontKeys[(indexOf(fontKeys, font) + 1) % len(fontKeys)]; hint = get(fontNames, font, font); hintLow = true; hintTicks = 2; haptic() }
        }
        Box {
          weight: 1; fill: height
          onTap: { layer = layers[(indexOf(layers, layer) + 1) % len(layers)]; hint = layer; hintLow = true; hintTicks = 2; haptic() }
        }
      }
    }
  }
}
