widget "claude limits" {
  size: 6x3
  minSize: 3x2

  meta { owl: 4; description: "Claude Code usage limits: 5-hour session and weekly limits, with reset times. Uses Claude Code's login on this device"; version: "1.5"; license: "MIT"; category: "dev" }
  requires { pacman: ["jq", "curl", "coreutils", "grep", "sed"] }

  source now = clock every 30s

  // Same numbers as /usage in Claude Code, from Anthropic's usage endpoint with the
  // login Claude Code already keeps in ~/.claude/.credentials.json (Claude Code refreshes it).
  // Every result carries `updated`, the Unix time it was fetched. The last
  // good result is kept in ~/.cache, so a failed fetch shows it with the error instead of nothing.
  // On 429 it waits out the server's retry-after (default 5 min) instead of retrying blindly,
  // since retrying while limited can keep the limit in place.
  source u = cmd("""
    d=$(date +%s)
    mkdir -p ~/.cache
    c=~/.cache/claude-limits.json
    fail() { [ -s "$c" ] && jq -c --arg e "$1" '. + {error: $e}' "$c" || echo "{\"error\":\"$1\",\"updated\":$d}"; }
    b=$(cat ~/.cache/claude-limits.backoff 2>/dev/null || echo 0)
    [ "$d" -lt "$b" ] && { fail "rate limited, retry in $(( (b - d + 59) / 60 ))m"; exit 0; }
    t=$(jq -r '.claudeAiOauth.accessToken // empty' ~/.claude/.credentials.json 2>/dev/null)
    [ -n "$t" ] || { fail "not logged in"; exit 0; }
    r=$(printf 'Authorization: Bearer %s\n' "$t" |
      curl -s -m 15 -D ~/.cache/claude-limits.hdr -w '\n%{http_code}' -H @- -H 'anthropic-beta: oauth-2025-04-20' https://api.anthropic.com/api/oauth/usage)
    ra=$(grep -i '^retry-after:' ~/.cache/claude-limits.hdr 2>/dev/null | tr -dc 0-9)
    # one line per fetch (time, HTTP status, retry-after), last 200 kept, for diagnosing stalls
    l=~/.cache/claude-limits.log
    echo "$d $(printf %s "$r" | tail -n 1) $ra" >> "$l"
    [ "$(wc -l < "$l")" -gt 200 ] && sed -i 1,100d "$l"
    case $(printf %s "$r" | tail -n 1) in
      200) o=$(printf %s "$r" | sed '$d' |
        jq -c --argjson d "$d" '
          def ts: if . then sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601 else null end;
          {updated: $d, limits: ([.limits[] | {
            label: (if .kind == "session" then "5h session" elif .kind == "weekly_all" then "week" else "week \(.scope.model.display_name // "")" end),
            short: (if .kind == "session" then "5h" elif .kind == "weekly_all" then "wk" else (.scope.model.display_name // "wk") end),
            pct: .percent,
            resets: (.resets_at | ts)}])}') &&
        { printf '%s\n' "$o" > "$c"; printf '%s\n' "$o"; } || fail "usage unavailable" ;;
      401) fail "login expired: open Claude Code" ;;
      429) echo $(( d + ${ra:-300} )) > ~/.cache/claude-limits.backoff
        fail "rate limited, retry in $(( (${ra:-300} + 59) / 60 ))m" ;;
      *) fail "usage unavailable" ;;
    esac
  """) every 5m json timeout 30s

  // Once a window's reset time has passed, its usage is 0 until the next fetch says otherwise.
  let limits = (u.limits ?? []).map(l => {label: l.label, short: l.short, pct: l.resets != null && l.resets <= now ? 0 : l.pct, resets: l.resets})
  let age = u.updated != null ? now - u.updated : null
  // Layout by tile size: with fewer rows than the header plus one per limit, the limits go into a
  // 2-column grid of compact cells with thin bars; under 5 columns the reset times go and labels
  // shorten. Before the tile is laid out, use the full layout.
  let tall = (rows ?? 9) > len(limits)
  let wide = (cols ?? 6) >= 5
  // A 2-row tile has room for the compact cells' bars but not their reset lines
  let roomy = (rows ?? 9) >= 3

  component Limit(label, short, pct, resets) {
    let tint = pct >= 90 ? red : pct >= 70 ? yellow : accent
    Column {
      gap: 3
      Row {
        gap: 6
        Text { text: wide ? label : short; style: label; weight: 1; maxLines: 1 }
        if resets != null {
          Text { text: resets > now ? (wide ? "resets in " : "") + fmtDuration(resets - now) : "reset"; fontSize: 11; color: muted; width: wide ? 130 : 64; align: end; maxLines: 1 }
        }
        Text { text: "${pct}%"; fontSize: 14; width: 44; align: end; color: pct >= 90 ? red : pct >= 70 ? yellow : foreground }
      }
      Progress { value: pct; color: tint; animate value: spring() }
    }
  }

  component MiniLimit(short, pct, resets) {
    let tint = pct >= 90 ? red : pct >= 70 ? yellow : accent
    Column {
      gap: 2
      Row {
        gap: 4
        Text { text: short; fontSize: 12; weight: 1; maxLines: 1 }
        Text { text: "${pct}%"; fontSize: 12; width: 36; align: end; color: pct >= 90 ? red : pct >= 70 ? yellow : foreground }
      }
      Canvas {
        height: 3
        fill: width
        rect(0, 0, width, 3, fill: surface)
        rect(0, 0, width * clamp(pct ?? 0, 0, 100) / 100, 3, fill: tint)
      }
      if resets != null && roomy {
        Text { text: resets > now ? (wide ? "resets in " : "in ") + fmtDuration(resets - now) : "reset"; fontSize: 10; color: muted; maxLines: 1 }
      }
    }
  }

  // Weekly pace: weekly use against how much of the 7-day window has passed. Over it, the
  // week's limit runs out before it resets.
  component Pace(used, elapsed) {
    let ahead = used - elapsed
    let tint = ahead > 20 ? red : ahead > 0 ? yellow : green
    Column {
      gap: 2
      Row {
        gap: 4
        Text { text: "pace"; fontSize: 12; weight: 1; maxLines: 1 }
        Text { text: (ahead > 0 ? "+" : "") + "${round(ahead)}%"; fontSize: 12; width: 40; align: end; color: tint; maxLines: 1 }
      }
      // used (colored) over the week so far (muted): the gap between them is the margin
      Canvas {
        height: 3
        fill: width
        rect(0, 0, width, 3, fill: surface)
        rect(0, 0, width * clamp(elapsed ?? 0, 0, 100) / 100, 3, fill: alpha(muted, 0.6))
        rect(0, 0, width * clamp(used ?? 0, 0, 100) / 100, 3, fill: tint)
      }
      if roomy {
        Text { text: ahead > 0 ? "ahead of week" : "under pace"; fontSize: 10; color: muted; maxLines: 1 }
      }
    }
  }

  let week = limits.find(l => l.short == "wk")
  let weekElapsed = week.resets != null ? clamp(100 - (week.resets - now) / (7 * 86400) * 100, 0, 100) : null

  onTap: refresh()

  Column {
    gap: tall ? 8 : 6
    Row {
      if u.error != null && !roomy {
        Text { text: u.error; color: red; fontSize: 11; weight: 1; maxLines: 1 }
      } else {
        Text { text: wide ? "claude code limits" : "claude"; style: muted; weight: 1; maxLines: 1 }
      }
      Text { text: age == null ? "…" : age < 60 ? (wide ? "updated just now" : "now") : wide ? "updated ${fmtDuration(age)} ago" : "${fmtDuration(age)} ago"; fontSize: 11; color: age != null && age > 15 * 60 ? yellow : muted; width: wide ? 150 : 80; align: end; maxLines: 1 }
    }
    if u.error != null && roomy {
      Text { text: u.error; color: red; fontSize: 11; maxLines: 1 }
    }
    if tall {
      for l in limits key l.label {
        Limit { label: l.label; short: l.short; pct: l.pct; resets: l.resets }
      }
    } else {
      Grid {
        columns: 2
        gap: 10
        for l in limits key l.label {
          MiniLimit { short: l.short; pct: l.pct; resets: l.resets }
        }
        if weekElapsed != null && len(limits) % 2 == 1 {
          Pace { used: week.pct; elapsed: weekElapsed }
        }
      }
    }
  }
}
