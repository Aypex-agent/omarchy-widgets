widget "Afterglass" {
  meta {
    owl: 22
    description: "Teahupoʻo in 32 inks: a looping pixel surf painting against the volcanic ridges of Tahiti Iti."
    version: "1.2"
    license: "MIT"
    category: "sport"
  }
  requires { pacman: [] }
  size: 6x4
  minSize: 3x2
  padding: 0
  let celRate = 16
  fps: celRate

  // MIT covers the original widget code. The embedded artwork uses the sources credited below.
  // Wave underpainting: “Teahupoo1” by The Last Minute, CC BY 2.0.
  // https://commons.wikimedia.org/wiki/File:Teahupoo1.jpg • https://creativecommons.org/licenses/by/2.0/
  // Reframed, painted in directional gouache, then reduced to pixel clusters and animated.
  // Terrain underpainting: Tahiti Iti relief from Copernicus DEM.
  // Produced using Copernicus WorldDEM-30 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA; all rights reserved.
  // https://registry.opendata.aws/copernicus-dem/ • projected, shaded and painted for this scene.
  // The ridge is registered across the whole loop. Pitch, spill, and recovery are
  // drawn into separate cels; the board, stance, wake, and windblown drops move too.
  // Row-major sheet: 8 × 8 cels, each 168 × 112 in the same 32-ink palette.
  asset surfCels = base64""

  // Only used to select a renderer. Both paths play the very same cels, offline.
  source handset = android.device
  if (handset.sdk ?? 0) >= 33 {
    Shader {
      fill: true
      fallback: #244052
      uniforms: { sheet: surfCels, rate: celRate }
      code: """
        uniform shader sheet;
        uniform float rate;
        half4 main(float2 p) {
          const float2 celSize = float2(168.0,112.0);
          float scale = max(size.x/celSize.x,size.y/celSize.y);
          float2 cell = floor((p+(scale*celSize-size)*float2(0.47,0.61))/scale);
          cell = clamp(cell,float2(0.0),celSize-1.0);
          float n = floor(mod(time,64.0/rate)*rate);
          float2 cel = float2(mod(n,8.0),floor(n/8.0));
          // Sample texel centres: no blending between two inks or between cels.
          return sheet.eval((cel*celSize+cell+0.5)/(8.0*celSize));
        }
      """
    }
  } else {
    // Android without AGSL still animates: move the sheet behind a tile-sized window.
    Canvas {
      fill: true
      let n = floor((time % (64 / celRate)) * celRate)
      let zoom = max(width / 168, height / 112)
      clip(0, 0, width, height) {
        translate((width - zoom * 168) * 0.47, (height - zoom * 112) * 0.61) {
          scale(zoom, zoom, 0, 0) {
            image(surfCels, -(n % 8) * 168, -floor(n / 8) * 112, 1344, 896)
          }
        }
      }
    }
  }
}
