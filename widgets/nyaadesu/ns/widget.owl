widget "ns" {
  size: 6x5
  minSize: 3x3
  padding: 10
  meta { owl: 12; description: "Dutch railways (NS): whether your off-peak discount is on, and departures from your station with delays, platforms, favourites and disruptions. Needs a free NS API key"; version: "1.1"; license: "MIT"; category: "world" }

  // Port of https://github.com/nyaadesu/NSWidget. The NS API key, the station and the favourites
  // are set in the widget's screen (tap the tile), not in this file: the key encrypted on the phone,
  // the rest kept by the launcher.
  state station = null persist          // {uic, name, lat, lng}: the one shown
  state nsKey = null secret           // the NS key: encrypted on the phone, sent only in the request header
  state apiKey = "" persist           // where versions before 1.1 kept the key in plain text; moved into nsKey at start
  state saved = [] persist              // up to 6 stations to switch between by tapping the name
  state favs = [] persist               // up to 3 of {uic, name, label}
  state showVia = true persist
  state query = ""
  state pick = ""                       // what a search result is for: "station" or "fav"
  state favLabel = ""
  state good = []                       // the last departures NS returned, kept while offline
  state fetchedAt = 0
  state switching = false              // a new station was picked and its departures haven't arrived yet

  // A key kept by an older version moves into the secret, and the plain copy is wiped.
  when apiKey != "" { nsKey = apiKey; apiKey = "" }

  source now = clock every 15s
  let ready = nsKey != null && station != null
  // A null URL makes no request, so unused favourites, and one that is the station shown, cost nothing.
  // It keeps the last answer, so what is read from them below checks the same conditions.
  source deps = http(ready ? "https://gateway.apiportal.ns.nl/reisinformatie-api/api/v2/departures?uicCode=${enc(station.uic)}&maxJourneys=20" : null, {"Ocp-Apim-Subscription-Key": "${nsKey}", Accept: "application/json"}) every 2m timeout 15s json status
  source trip0 = http(ready && len(favs) > 0 && favs[0].uic != station.uic ? "https://gateway.apiportal.ns.nl/reisinformatie-api/api/v3/trips?originUicCode=${enc(station.uic)}&destinationUicCode=${enc(favs[0].uic)}" : null, {"Ocp-Apim-Subscription-Key": "${nsKey}", Accept: "application/json"}) every 5m timeout 15s json status
  source trip1 = http(ready && len(favs) > 1 && favs[1].uic != station.uic ? "https://gateway.apiportal.ns.nl/reisinformatie-api/api/v3/trips?originUicCode=${enc(station.uic)}&destinationUicCode=${enc(favs[1].uic)}" : null, {"Ocp-Apim-Subscription-Key": "${nsKey}", Accept: "application/json"}) every 5m timeout 15s json status
  source trip2 = http(ready && len(favs) > 2 && favs[2].uic != station.uic ? "https://gateway.apiportal.ns.nl/reisinformatie-api/api/v3/trips?originUicCode=${enc(station.uic)}&destinationUicCode=${enc(favs[2].uic)}" : null, {"Ocp-Apim-Subscription-Key": "${nsKey}", Accept: "application/json"}) every 5m timeout 15s json status
  // An empty query makes no request. Station names don't change, so a search open for long re-runs only hourly.
  source found = http(nsKey != null && query != "" ? "https://gateway.apiportal.ns.nl/reisinformatie-api/api/v2/stations?q=${enc(query)}&limit=12" : null, {"Ocp-Apim-Subscription-Key": "${nsKey}", Accept: "application/json"}) every 1h timeout 15s json status

  // A station picked before the saved list existed joins it.
  when station != null && !any(saved, s => s.uic == station.uic) { saved = (saved + [station]).take(6) }
  when deps.ok { good = deps.out.payload.departures ?? []; fetchedAt = now }
  on deps { good = value.ok ? value.out.payload.departures ?? [] : good; fetchedAt = value.ok ? now : fetchedAt; switching = false }

  // ---- Peak hours (PeakRules.kt, Holidays.kt) ----
  // Everything runs on Amsterdam wall-clock time, whatever the phone's time zone: CET, and CEST
  // from 01:00 UTC on the last Sunday of March to the last Sunday of October.
  // Day numbers (days since 1970-01-01) come from [y, m, d] via days-from-civil; d may overflow the month.
  let year = num(fmtTime(now, "yyyy"))
  let dst = [[year, 3, 31], [year, 10, 31]]
    .map(v => {y: v[0] - (v[1] <= 2 ? 1 : 0), m: v[1] + (v[1] > 2 ? -3 : 9), d: v[2]})
    .map(v => 365 * v.y + floor(v.y / 4) - floor(v.y / 100) + floor(v.y / 400) + floor((153 * v.m + 2) / 5) + v.d - 719469)
    .map(d => (d - (d + 4) % 7) * 86400 + 3600)
  let wall = now + (now >= dst[0] && now < dst[1] ? 7200 : 3600)
  let today = floor(wall / 86400)
  // Holidays without peak hours, this year and next: Easter by Meeus/Jones/Butcher.
  let holidays = flatten([year, year + 1]
    .map(y => {y: y, a: y % 19, b: floor(y / 100), c: y % 100})
    .map(v => {y: v.y, a: v.a, b: v.b, d: floor(v.b / 4), e: v.b % 4, g: floor((v.b - floor((v.b + 8) / 25) + 1) / 3), i: floor(v.c / 4), k: v.c % 4})
    .map(v => {y: v.y, a: v.a, e: v.e, i: v.i, k: v.k, h: (19 * v.a + v.b - v.d - v.g + 15) % 30})
    .map(v => {y: v.y, a: v.a, h: v.h, l: (32 + 2 * v.e + 2 * v.i - v.h - v.k) % 7})
    .map(v => {y: v.y, h: v.h, l: v.l, m: floor((v.a + 11 * v.h + 22 * v.l) / 451)})
    .map(v => {y: v.y, mo: floor((v.h + v.l - 7 * v.m + 114) / 31), da: (v.h + v.l - 7 * v.m + 114) % 31 + 1})
    .map(v => [
      [v.y, v.mo, v.da - 2],              // Good Friday
      [v.y, v.mo, v.da + 1],              // Easter Monday
      [v.y, v.mo, v.da + 39],             // Ascension Day
      [v.y, v.mo, v.da + 50],             // Whit Monday
      [v.y, 1, 1],                        // New Year's Day
      [v.y, 4, 27],                       // King's Day (on the 26th it's a Saturday anyway)
      [v.y, 12, 25], [v.y, 12, 26]        // Christmas
    ] + (v.y % 5 == 0 ? [[v.y, 5, 5]] : []))) // Liberation Day, every 5th year
    .map(v => {y: v[0] - (v[1] <= 2 ? 1 : 0), m: v[1] + (v[1] > 2 ? -3 : 9), d: v[2]})
    .map(v => 365 * v.y + floor(v.y / 4) - floor(v.y / 100) + floor(v.y / 400) + floor((153 * v.m + 2) / 5) + v.d - 719469)
  // Peak: Mon-Fri 06:30-09:00 and 16:00-18:30. Every start and end in the next two weeks, from now on.
  let changes = flatten(range(15).map(k => today + k)
    .filter(d => (d + 4) % 7 >= 1 && (d + 4) % 7 <= 5 && !contains(holidays, d))
    .map(d => [390, 540, 960, 1110].map(m => d * 86400 + m * 60)))
    .filter(t => t > wall)
  let change = changes[0]
  let peak = contains([540, 1110], (change % 86400) / 60)   // the next change ends a peak
  let mins = ceil((change - wall) / 60)
  let soon = mins <= 60
  let hhmm = [change, changes[1]].map(t => pad(floor(t % 86400 / 3600), 2, "0") + ":" + pad(floor(t % 3600 / 60), 2, "0"))
  let changeDay = floor(change / 86400)
  let at = changeDay == today ? hhmm[0] : changeDay == today + 1 ? "tomorrow ${hhmm[0]}" : "${["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][(changeDay + 4) % 7]} ${hhmm[0]}"
  let tone = peak ? (soon ? yellow : red) : (soon ? yellow : green)
  let compact = (cols ?? 6) < 4
  let title = peak
    ? (soon ? (compact ? "Wait ${mins} min" : "Wait ${mins} min for discount") : (compact ? "Peak hours" : "Peak hours · no discount"))
    : (soon ? (compact ? "Ends in ${mins} min" : "Discount ends in ${mins} min") : (compact ? "Discount on" : "Off-peak · discount active"))
  let subtitle = peak
    ? (soon ? (compact ? "for discount" : "Off-peak from ${at}") : (compact ? "from ${at}" : "Discount from ${at}"))
    : (soon ? (compact ? "before ${at}" : "Check in before ${at} · peak ends ${hhmm[1]}") : (compact ? "peak ${at}–${hhmm[1]}" : "Peak starts ${at} · ends ${hhmm[1]}"))

  // ---- Departures (NsApi.parseDepartures, Disruptions.kt, MajorCities.kt) ----
  // Station names match when they have as many words and each is a prefix of the other's:
  // "Rotterdam C." = "Rotterdam Centraal", but "Delft" != "Delft Campus".
  let endsRe = "(?i)(?:niet verder dan|\\brijdt\\s+(?:vandaag\\s+)?(?:alleen\\s+)?tot|\\beindigt\\s+(?:vandaag\\s+)?(?:in|op|te)|\\b(?:terminates|ends)\\s+(?:today\\s+)?(?:at|in)|\\b(?:runs|goes|travels)\\s+(?:today\\s+)?only\\s+(?:as far as|to|until)|\\bno further than|\\bnot\\s+(?:run|go|travel|continue)\\s+(?:any\\s+)?(?:further|beyond)(?:\\s+than)?)\\s+(.+)"
  let skipsRe = "(?i)(?:\\bstopt\\s+(?:vandaag\\s+)?niet\\s+(?:in|op|te)|\\b(?:does not|doesn't|will not)\\s+(?:stop|call)\\s+(?:today\\s+)?(?:in|at))\\s+(.+)"
  let cancelRe = "(?i)^((?:let op[,:]?\\s*)?(?:deze trein\\s+)?(?:rijdt\\s+(?:vandaag\\s+)?niet|valt\\s+(?:vandaag\\s+)?uit|(?:train\\s+)?(?:is\\s+)?cancell?ed|(?:this train\\s+)?does not run(?:\\s+today)?)[.!]?)$"
  // A sentence ends at a full stop, except after a one-letter abbreviation ("Rotterdam C.").
  let sentenceRe = "^(.+?)(?:(?<![\\s-]\\p{L})\\.(?:\\s|$)|[;!]|\\s+[-–(]|$)"
  let placeRe = "^(.+?)(?:(?<![\\s-]\\p{L})\\.(?:\\s|$)|[;!]|\\s+[-–(]|,|\\s+(?:en|and|door|due to|because)\\s+|$)"
  let cityRe = "(?i)^(Amsterdam|Schiphol|Haarlem|Alkmaar|Leiden|Den Haag|Delft|Rotterdam|Dordrecht|Gouda|Utrecht|Amersfoort|Almere|Lelystad|Zwolle|Deventer|Apeldoorn|Arnhem|Nijmegen|Eindhoven|Tilburg|Breda|'s-Hertogenbosch|Roosendaal|Venlo|Roermond|Sittard|Heerlen|Maastricht|Enschede|Hengelo|Groningen|Leeuwarden|Brussel|Antwerpen|Köln)(?!\\p{L})"
  let cityNames = {"'s-hertogenbosch": "Den Bosch", brussel: "Brussels", antwerpen: "Antwerp", "köln": "Cologne"}
  let originCity = (match(replace(station.name ?? "", "’", "'"), cityRe) ?? [])[0]

  // Nothing from the previous station while a switch loads.
  let departures = (switching ? [] : deps.ok ? deps.out.payload.departures ?? [] : good)
    .map(o => {o: o, notes: (o.messages ?? []).map(m => m.message ?? "")})
    .map(x => {o: x.o, notes: x.notes, cancelled: x.o.cancelled == true || any(x.notes, s => match(trim(s), cancelRe) != null)})
    .map(x => {
      o: x.o, cancelled: x.cancelled,
      ends: x.cancelled ? null : first(x.notes.map(s => match(s, endsRe)).filter(g => g != null).map(g => trim((match(g[0], placeRe) ?? g)[0]))),
      skipped: flatten(x.notes.map(s => match(s, skipsRe)).filter(g => g != null)
        .map(g => split(replace(replace((match(g[0], sentenceRe) ?? g)[0], " en ", ", "), " and ", ", "), ",").map(t => trim(t)).filter(t => t != "")))
    })
    // Normalised station names: lower case, dots as spaces, as words.
    .map(x => {
      o: x.o, cancelled: x.cancelled, ends: x.ends, skipped: x.skipped,
      route: (x.o.routeStations ?? []).map(r => {uic: r.uicCode, name: r.mediumName ?? "", w: words(lower(replace(r.mediumName ?? "", ".", " ")))}),
      endsW: x.ends == null ? null : words(lower(replace(x.ends, ".", " "))),
      skipW: x.skipped.map(s => words(lower(replace(s, ".", " ")))),
      dirW: words(lower(replace(x.o.direction ?? "", ".", " ")))
    })
    .map(x => {
      o: x.o, cancelled: x.cancelled, ends: x.ends, skipped: x.skipped, skipW: x.skipW,
      // A shortened train: forget the stops after where it now ends.
      cut: x.endsW == null ? -1 : indexOf(x.route.map(r => len(r.w) == len(x.endsW) && all(range(len(r.w)), i => startsWith(r.w[i], x.endsW[i]) || startsWith(x.endsW[i], r.w[i]))), true),
      sameDir: x.endsW != null && len(x.dirW) == len(x.endsW) && all(range(len(x.dirW)), i => startsWith(x.dirW[i], x.endsW[i]) || startsWith(x.endsW[i], x.dirW[i])),
      route: x.route
    })
    .map(x => {
      o: x.o, cancelled: x.cancelled, ends: x.ends, skipped: x.skipped, sameDir: x.sameDir,
      route: (x.cut >= 0 ? take(x.route, x.cut + 1) : x.route)
        .filter(r => !any(x.skipW, s => len(s) == len(r.w) && all(range(len(s)), i => startsWith(s[i], r.w[i]) || startsWith(r.w[i], s[i]))))
    })
    // Times to Unix seconds, from NS's "2026-10-06T10:04:00+0200".
    .map(x => {
      o: x.o, cancelled: x.cancelled, ends: x.ends, skipped: x.skipped, sameDir: x.sameDir, route: x.route,
      t: [x.o.plannedDateTime, x.o.actualDateTime ?? x.o.plannedDateTime]
        .map(s => match(s ?? "", "(\\d+)-(\\d+)-(\\d+)T(\\d+):(\\d+):(\\d+)([+-])(\\d\\d):?(\\d\\d)"))
        .map(g => g == null ? null : [num(g[0]) - (num(g[1]) <= 2 ? 1 : 0), num(g[1]) + (num(g[1]) > 2 ? -3 : 9), num(g[2]),
          num(g[3]) * 3600 + num(g[4]) * 60 + num(g[5]) - (g[6] == "-" ? -1 : 1) * (num(g[7]) * 3600 + num(g[8]) * 60)])
        .map(v => v == null ? null : (365 * v[0] + floor(v[0] / 4) - floor(v[0] / 100) + floor(v[0] / 400) + floor((153 * v[1] + 2) / 5) + v[2] - 719469) * 86400 + v[3])
    })
    .filter(x => x.t[0] != null && x.t[1] >= now - 60)   // trains that left drop off
    .sortBy(x => x.t[1])                                   // by when they actually leave, delays included
    .take(8)
    .map(x => {
      time: sub(x.o.actualDateTime ?? x.o.plannedDateTime, 11, 16),
      delay: x.cancelled ? 0 : floor((x.t[1] - x.t[0]) / 60),
      category: sub(x.o.product.categoryCode ?? x.o.trainCategory ?? x.o.product.shortCategoryName ?? "", 0, 4),
      number: x.o.product.number,
      direction: x.ends != null && !x.sameDir ? x.ends : x.o.direction ?? "",
      plannedDirection: x.ends != null && !x.sameDir ? x.o.direction : null,
      track: x.o.actualTrack ?? x.o.plannedTrack,
      trackChanged: x.o.actualTrack != null && x.o.plannedTrack != null && x.o.actualTrack != x.o.plannedTrack,
      cancelled: x.cancelled,
      shortened: x.ends != null && !x.cancelled,
      skipped: x.skipped,
      stops: x.route.map(r => r.uic),
      // Major cities on the way, leaving out where you are and where the train ends.
      via: unique(x.route.map(r => (match(replace(r.name, "’", "'"), cityRe) ?? [])[0]).filter(c => c != null)
        .map(c => get(cityNames, lower(c), c)))
        .filter(c => c != get(cityNames, lower(originCity ?? ""), originCity) && c != get(cityNames, lower((match(replace(x.o.direction ?? "", "’", "'"), cityRe) ?? [])[0] ?? ""), (match(replace(x.o.direction ?? "", "’", "'"), cityRe) ?? [])[0]))
        .take(3)
    })

  // ---- Favourites (WidgetModels.favouriteTags) ----
  // Per favourite, the journeys NS plans from here: the train you board, when you arrive (as a
  // sortable yyyyMMddHHmm number) and how many changes it takes.
  let tripLive = range(3).map(i => ready && len(favs) > i && favs[i].uic != station.uic)
  let tripRes = [tripLive[0] ? trip0 : null, tripLive[1] ? trip1 : null, tripLive[2] ? trip2 : null]
  let trips = range(len(favs)).map(i => (tripRes[i].ok == true ? tripRes[i].out.trips ?? [] : [])
    .filter(t => t.status != "CANCELLED" && t.status != "NOT_POSSIBLE")
    .map(t => (t.legs ?? []).filter(l => l.product.number != null))
    .filter(rides => len(rides) > 0 && !any(rides, l => l.cancelled == true))
    .map(rides => {
      number: rides[0].product.number,
      arrive: num(replace(replace(replace(sub(last(rides).destination.actualDateTime ?? last(rides).destination.plannedDateTime ?? "", 0, 16), "-", ""), "T", ""), ":", "")),
      transfers: len(rides) - 1
    }))
  // The fastest way to each favourite that leaves from the board: its first train gets the pill.
  let shownNumbers = departures.filter(d => !d.cancelled).map(d => d.number)
  let fastest = trips.map(opts => first(opts.filter(o => contains(shownNumbers, o.number)).sortBy(o => o.arrive)).number)
  let direct = trips.map(opts => opts.filter(o => o.transfers == 0).map(o => o.number))
  let rows = departures.map(d => {
    d: d,
    fastest: !d.cancelled && d.number != null && contains(fastest, d.number),
    stops: !d.cancelled && any(range(len(favs)), i => contains(d.stops, favs[i].uic) || lower(trim(d.direction)) == lower(trim(favs[i].name)) || (d.number != null && contains(direct[i], d.number))),
    notices: d.cancelled ? [] : d.shortened ? (d.plannedDirection != null ? ["not to ${d.plannedDirection}", "ends early"] : ["ends early"])
      : len(d.skipped) > 0 ? ["skips ${join(d.skipped, ", ")}"] + (len(d.skipped) > 1 ? ["skips ${d.skipped[0]} +${len(d.skipped) - 1}"] : []) + ["skips stops"]
      : []
  })

  // ---- Disruptions on the way to a favourite (parseTripDisruptions, disruptionAlert) ----
  let severity = ["CALAMITY", "DISRUPTION", "MAINTENANCE"]
  // flatten goes one level deep: once for the favourites, once for their trips.
  let disruptions = flatten(flatten(range(len(favs)).map(i => (tripRes[i].ok == true ? tripRes[i].out.trips ?? [] : [])
    .map(t => [t.primaryMessage.message] + flatten((t.legs ?? []).map(l => l.messages ?? [])))
    .map(ms => ms.filter(m => m != null && m.id != null && contains(severity, m.type)).map(m => {fav: i, id: m.id, type: m.type, head: m.head ?? m.text})))))
  let worst = first(disruptions.sortBy(d => indexOf(severity, d.type)))
  // The first affected favourite's label goes in the warning sign if it's one symbol (an emoji, a letter).
  let firstLabel = trim(favs[first(disruptions).fav].label ?? "")
  let alertSymbol = firstLabel != "" && len(firstLabel) <= 8 && (len(firstLabel) == 1 || match(firstLabel, "[\\p{L}\\p{N}]{2}") == null) ? firstLabel : "!"
  let alertUrl = worst == null ? null : "https://www.ns.nl/reisinformatie/actuele-situatie-op-het-spoor/${get({DISRUPTION: "disruption", MAINTENANCE: "maintenance", CALAMITY: "calamity"}, worst.type, "")}?id=${enc(worst.id)}"

  // ---- Layout (WidgetModels.rowLayout) ----
  // Secondary text: muted alone is too faint on dark themes for the small sizes used here.
  let dim = alpha(foreground, 0.7)
  // Room for rows: the tile minus its padding, the header, the banner, the gaps and the card's padding.
  let avail = (tileHeight ?? 400) - 20 - 30 - 46 - 12 - 4
  let singleN = clamp(floor(avail / 26), 1, 8)
  let dualN = clamp(floor(avail / 34), 1, 8)
  let dual = any(take(rows, dualN), r => (showVia && len(r.d.via) > 0) || len(r.notices) > 0) && min(dualN, len(rows)) >= min(singleN, len(rows))
  let shown = take(rows, dual ? dualN : singleN)
  // Rows share out the room left over, up to a few dp each, so the board fills the tile.
  let rowH = len(shown) == 0 ? 26 : clamp(floor(avail / len(shown)), dual ? 34 : 26, dual ? 40 : 32)
  // A delay column only when a shown train is late, as wide as its digits.
  let delayW = max(shown.filter(r => r.d.delay > 0 && !r.d.cancelled).map(r => len(str(r.d.delay)))) ?? 0
  let delaySlot = delayW == 0 ? 0 : delayW == 1 ? (compact ? 22 : 26) : (compact ? 30 : 36)
  // Width left for a destination and its caption: the card's inside minus time, delay, type and platform.
  let contentW = (tileWidth ?? 360) - 20 - 8 - 16 - (compact ? 56 : 64) - delaySlot - (compact ? 0 : 34) - 36 - 8
  let message = nsKey == null ? "Add your NS API key: tap here"
    : station == null ? "Pick a station: tap here"
    : deps == null || switching ? "Loading departures…"
    : len(rows) == 0 ? (deps.ok ? "No upcoming departures" : deps.code == 401 || deps.code == 403 ? "NS rejected the API key" : deps.code == 429 ? "NS API rate limit reached" : "No connection to NS")
    : null

  onTap: { query = ""; pick = ""; screen() }   // ✕, Back and Home close it without the close button

  component Icon(kind, tint) {
    Canvas {
      size: compact ? 26 : 30
      let c = width / 2
      circle(c, c, c, fill: alpha(tint, 0.22))
      if kind == "check" {
        path([[c * 0.58, c * 1.02], [c * 0.88, c * 1.32], [c * 1.42, c * 0.72]], stroke: tint, width: 2.5, cap: round)
      } else if kind == "clock" {
        circle(c, c, c * 0.55, stroke: tint, width: 2)
        line(c, c, c, c * 0.65, stroke: tint, width: 2, cap: round)
        line(c, c, c * 1.25, c, stroke: tint, width: 2, cap: round)
      } else {
        circle(c, c, c * 0.55, stroke: tint, width: 2)
        line(c * 0.62, c * 1.38, c * 1.38, c * 0.62, stroke: tint, width: 2)
      }
    }
  }

  component Platform(r) {
    if r.d.track == null && !r.d.cancelled {
      Text { text: "–"; width: 30; align: center; bold: true; color: muted }
    } else {
      Box {
        width: 30
        height: 20
        radius: 3 * corners
        background: r.d.cancelled ? "#d6455d" : r.d.trackChanged ? "#f08a24" : "#ffc917"
        align: center
        Text { text: r.d.cancelled ? "×" : r.d.track; fontSize: 13; bold: true; color: r.d.cancelled ? "#ffffff" : "#14233f"; align: center; maxLines: 1 }
      }
    }
  }

  Column {
    gap: 6
    fill: true
    // Header: map pin, station, when the data is from, refresh.
    Row {
      height: 30
      gap: 8
      align: center
      if station != null {
        Canvas {
          size: 26
          onTap: url("https://www.google.com/maps/search/?api=1&query=${station.lat},${station.lng}")
          circle(13, 13, 13, fill: alpha(yellow, 0.22))
          path([[8, 12], [13, 21], [18, 12]], fill: yellow, closed: true)
          circle(13, 11, 5.5, fill: yellow)
          circle(13, 11, 2.2, fill: background)
        }
      }
      // Tapping the name switches to the next saved station.
      Row {
        weight: 1
        gap: 6
        align: center
        onTap: { station = len(saved) > 1 ? saved[(indexOf(saved.map(s => s.uic), station.uic) + 1) % len(saved)] : station; good = len(saved) > 1 ? [] : good; fetchedAt = len(saved) > 1 ? 0 : fetchedAt; switching = len(saved) > 1; refresh() }
        Text { text: station.name ?? "NS departures"; fontSize: compact ? 14 : 16; bold: true; maxLines: 1; weight: 1 }
        if len(saved) > 1 {
          Text { text: "${indexOf(saved.map(s => s.uic), station.uic) + 1}/${len(saved)}"; fontSize: 13; color: dim; width: 34; maxLines: 1 }
        }
      }
      if !compact && station != null && fetchedAt > 0 {
        Text { text: (deps.ok == false ? "offline " : "") + fmtTime(fetchedAt, "HH:mm"); fontSize: 13; color: deps.ok == false ? red : dim; width: deps.ok == false ? 112 : 54; align: end; maxLines: 1 }
      }
      Canvas {
        size: 26
        onTap: refresh()
        circle(13, 13, 13, fill: alpha(accent, 0.18))
        arc(13, 13, 6, 30, 290, stroke: accent, width: 2, cap: round)
        path([[13, 4], [17, 7], [13, 10]], fill: accent, closed: true)
      }
    }
    // Discount banner, and the warning sign when something disrupts the way to a favourite.
    Row {
      height: 46
      gap: 6
      Row {
        weight: 1
        fill: height
        gap: 10
        align: center
        padding: [compact ? 10 : 12, 4]
        radius: 14 * corners
        background: alpha(tone, 0.18)
        if !compact { Icon { kind: peak ? (soon ? "clock" : "block") : (soon ? "clock" : "check"); tint: tone } }
        Column {
          gap: 0
          weight: 1
          Text { text: title; fontSize: compact ? 13 : 15; bold: true; color: tone; maxLines: 1 }
          Text { text: subtitle; fontSize: compact ? 11 : 12; color: tone; maxLines: 1 }
        }
      }
      if worst != null {
        Canvas {
          width: compact ? 36 : 46
          fill: height
          onTap: url(alertUrl)
          rect(0, 0, width, height, radius: 14 * corners, fill: "#d6455d")
          path([[width / 2, height / 2 - 15], [width / 2 + (compact ? 12 : 16), height / 2 + 13], [width / 2 - (compact ? 12 : 16), height / 2 + 13]], fill: "#ffffff", closed: true)
          text(alertSymbol, width / 2, height / 2 + 5, size: 13, align: center, bold: true, color: "#d6455d")
        }
      }
    }
    // The departure board.
    Column {
      gap: 0
      fill: width
      padding: [4, 2]
      radius: 14 * corners
      background: alpha(muted, 0.12)
      if message != null {
        Text { text: message; fontSize: 13; color: muted; maxLines: 3; padding: 8 }
      } else {
        for r in shown {
          // Trains to a favourite are highlighted by colour alone: the fastest way there gets a
          // filled pill and a bold destination, one that stops there accent-coloured text.
          let ink = r.fastest ? background : r.stops ? accent : r.d.cancelled ? muted : r.d.shortened ? red : foreground
          let quiet = r.fastest ? background : dim
          let warning = len(r.notices) > 0
          let caps = warning ? r.notices : (showVia && !r.d.cancelled ? r.d.via : [])
          // How many characters of caption fit (about 4.6 dp each at 9-10 sp, 7 dp for a destination).
          let room = floor((dual ? contentW : contentW - len(r.d.direction) * (r.fastest ? 7.8 : 7) - 12) / (dual ? 4.4 : 4.6))
          let caption = warning ? first(caps.filter(c => len(c) <= room)) : first(range(len(caps), 0, -1).map(n => join(take(caps, n), ", ")).filter(c => len(c) <= room))
          Box {
            fill: width
            height: rowH
            padding: [0, 1]
            Row {
              fill: true
              gap: 0
              align: center
              padding: [compact ? 5 : 8, 0]
              radius: 8 * corners   // a step inside the card's 14, following the corner style
              background: r.fastest ? accent : alpha(accent, 0)
              opacity: r.d.cancelled ? 0.6 : 1
              Text { text: r.d.time; fontSize: compact ? 13 : 15; bold: true; color: ink; width: compact ? 56 : 64; maxLines: 1 }
              if delaySlot > 0 {
                Text { text: r.d.delay > 0 && !r.d.cancelled ? "+${r.d.delay}" : ""; fontSize: 11; bold: true; color: r.fastest ? background : red; width: delaySlot; maxLines: 1 }
              }
              if !compact {
                Text { text: r.d.category; fontSize: 11; color: quiet; width: 34; maxLines: 1 }
              }
              if dual {
                Column {
                  gap: 0
                  weight: 1
                  Text { text: r.d.direction; fontSize: 13; bold: r.fastest; color: ink; maxLines: 1 }
                  if caption != null {
                    Text { text: caption; fontSize: 9; color: r.fastest ? background : warning ? red : dim; maxLines: 1 }
                  }
                }
              } else {
                Text { text: r.d.direction; fontSize: 14; bold: r.fastest; color: ink; maxLines: 1; weight: 1 }
                if caption != null && !compact {
                  Text { text: caption; fontSize: 9; color: r.fastest ? background : warning ? red : dim; maxLines: 1; width: len(caption) * 4.6 + 4; align: end }
                }
              }
              Spacer { width: 6 }
              Platform { r: r }
            }
          }
        }
      }
    }
  }

  // ---- Settings: the API key, the station and the favourites ----
  screen {
    title: "NS"
    Column {
      scroll: true
      gap: 10
      padding: 16

      Text { text: "NS API key"; style: label; color: accent }
      Text {
        text: nsKey == null ? "Free from apiportal.ns.nl: create an account, subscribe to the Ns-App product and paste its primary key here." : "Key set. Paste a new one to replace it."
        style: small; color: muted
      }
      Input { placeholder: "paste key and press send"; password: true; clear: true; onSubmit: { if trim(value) != "" { nsKey = trim(value) } } }
      Button { text: "open apiportal.ns.nl ↗"; color: muted; onTap: url("https://apiportal.ns.nl") }

      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
      Text { text: "stations"; style: label; color: accent }
      Text { text: "Tap the station name on the tile to switch to the next one. Up to 6."; style: small; color: muted }
      if len(saved) == 0 {
        Text { text: "none yet"; style: body; color: muted }
      }
      for s, i in saved key s.uic {
        Row {
          align: center
          Text {
            text: "${s.uic == station.uic ? "●" : "○"} ${s.name}"
            style: body; weight: 1; maxLines: 1
            color: s.uic == station.uic ? accent : foreground
            onTap: { switching = s.uic != station.uic || switching; station = s; refresh() }
          }
          Button {
            text: "remove"; color: red
            onTap: {
              good = s.uic == station.uic ? [] : good
              switching = s.uic == station.uic ? first(saved.filter(x => x.uic != s.uic)) != null : switching
              station = s.uic == station.uic ? first(saved.filter(x => x.uic != s.uic)) : station
              saved = saved.take(i) + saved.drop(i + 1)
              refresh()
            }
          }
        }
      }
      if len(saved) < 6 {
        Button { text: pick == "station" ? "cancel" : "add station"; onTap: { pick = pick == "station" ? "" : "station"; query = "" } }
      }

      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
      Text { text: "favourites"; style: label; color: accent }
      Text { text: "Trains that stop at a favourite are shown in the accent colour; the fastest way there gets a filled highlight. Up to 3, e.g. 🏠 and 💼."; style: small; color: muted }
      for f, i in favs {
        Row {
          align: center
          Text { text: f.label; style: body; width: 90; maxLines: 1 }
          Text { text: f.name; style: small; color: muted; weight: 1; maxLines: 1 }
          Button { text: "remove"; color: red; onTap: favs = favs.take(i) + favs.drop(i + 1) }
        }
      }
      if len(favs) < 3 {
        Row {
          align: center
          Input { placeholder: "label (🏠, Work…)"; text: favLabel; onChange: favLabel = value; weight: 1 }
          Button { text: pick == "fav" ? "cancel" : "add"; onTap: { pick = pick == "fav" ? "" : "fav"; query = "" } }
        }
      }

      if pick != "" {
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Text { text: pick == "station" ? "find your station" : "find the favourite's station"; style: label; color: accent }
        if nsKey == null {
          Text { text: "Add the API key first."; style: small; color: red }
        } else {
          Input { placeholder: "station name, then send"; onSubmit: { query = trim(value); refresh() } }
          if query != "" && found != null && !found.ok {
            Text {
              text: found.code == -1 ? "searching…" : found.code == 401 || found.code == 403 ? "NS rejected the API key (HTTP ${found.code})" : "Couldn't search: HTTP ${found.code} ${found.out.message ?? found.out.errors[0].message ?? found.err ?? ""}"
              style: small; color: found.code == -1 ? muted : red; maxLines: 4
            }
          }
          // Matched here too (names and synonyms like "Den Bosch"), in case NS answers with every station.
          for s in (query != "" && found.ok == true ? found.out.payload ?? [] : [])
            .filter(s => (s.land ?? "NL") == "NL" && s.heeftVertrektijden != false && s.lat != null)
            .filter(s => any([s.namen.lang, s.namen.middel, s.namen.kort, s.code] + (s.synoniemen ?? []), n => contains(lower(n ?? ""), lower(trim(query)))))
            .take(12) key s.UICCode {
            Text {
              text: s.namen.lang
              style: body
              padding: [0, 6]
              onTap: {
                saved = pick == "station" && !any(saved, x => x.uic == s.UICCode) ? (saved + [{uic: s.UICCode, name: s.namen.lang, lat: s.lat, lng: s.lng}]).take(6) : saved
                good = pick == "station" ? [] : good
                switching = pick == "station" && s.UICCode != station.uic ? true : switching
                station = pick == "station" ? {uic: s.UICCode, name: s.namen.lang, lat: s.lat, lng: s.lng} : station
                favs = pick == "fav" ? favs + [{uic: s.UICCode, name: s.namen.lang, label: trim(favLabel) == "" ? s.namen.lang : sub(trim(favLabel), 0, 10)}] : favs
                favLabel = pick == "fav" ? "" : favLabel
                pick = ""
                query = ""
                refresh()
              }
            }
          }
        }
      }

      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        align: center
        Text { text: "show the cities trains pass through"; style: body; weight: 1 }
        Button { text: showVia ? "on" : "off"; color: showVia ? green : muted; onTap: showVia = !showVia }
      }
      Text { text: "Peak (no discount): Mon–Fri 06:30–09:00 and 16:00–18:30, except public holidays. The discount goes by your check-in time. Departures refresh every 2 minutes and favourites every 5 while the page is on screen."; style: small; color: muted }
      Button { text: "close"; onTap: { query = ""; pick = ""; close() } }
    }
  }
}
