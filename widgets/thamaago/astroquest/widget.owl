widget "AstroQuest" {
  page: 1
  order: 4
  size: 6x3
  minSize: 3x2
  padding: 10
  background: theme_mode == "cosmic" ? #080D20 : #000000

  meta {
    description: "Location-based sky explorer with calculated sky positions, Cosmic/Red modes, time preview, discovery logbook, and astronomy quiz"
    version: "3.6"
    license: "MIT"
    category: "world"
    owl: 13
  }

  // [1. LINUX DEPENDENCIES & SETUP]
  requires {
    pacman: ["python", "python-astropy"]
  }

  // [2. STATE DECLARATIONS (OWL REACTIVITY)]
  // Persistent states
  state streak_days = 0 persist
  state total_found = 0 persist
  state last_found_date = "" persist
  state found_quests = [] persist
  state quest_idx = 0 persist
  state theme_mode = "cosmic" persist
  state bonus_xp = 0 persist
  state quiz_idx = 0 persist
  state quiz_streak = 0 persist

  // 15 Naked-Eye Stargazing Quests with Constellation, Spectral Color, Star-Hopping Guide, and Lore
  let quests = [
    { id: "alnilam",    name: "Orion's Belt", body: "Alnilam",    kind: "star",   con: "Orion",      mag: "1.69", color: #93C5FD, hop: "Look for 3 bright stars in a tight straight line; Alnilam is the middle jewel.", lore: "A blue supergiant ~1,340 light-years away shining 375,000x brighter than the Sun." },
    { id: "sirius",     name: "Sirius",       body: "Sirius",     kind: "star",   con: "Canis Major", mag: "-1.46", color: #E0F2FE, hop: "Follow Orion's Belt downward to the left (southeast) to the brightest star in the sky.", lore: "The Dog Star is just 8.6 light-years away and has a hidden white-dwarf companion, Sirius B." },
    { id: "canopus",    name: "Canopus",      body: "Canopus",    kind: "star",   con: "Carina",     mag: "-0.74", color: #FEF08A, hop: "Look ~36° south of Sirius toward the southern horizon.", lore: "Second-brightest star in the night sky, used by deep-space probes for attitude navigation." },
    { id: "betelgeuse", name: "Betelgeuse",   body: "Betelgeuse", kind: "star",   con: "Orion",      mag: "0.50", color: #FCA5A5, hop: "Spot the unmistakable orange-red shoulder above Orion's Belt.", lore: "A colossal red supergiant so wide that if placed at our Sun, it would engulf Mars!" },
    { id: "rigel",      name: "Rigel",        body: "Rigel",      kind: "star",   con: "Orion",      mag: "0.13", color: #BFDBFE, hop: "Opposite Betelgeuse below Orion's Belt — the bright blue-white knee of Orion.", lore: "A scorching blue-white supergiant system radiating ~120,000 solar luminosities." },
    { id: "aldebaran",  name: "Aldebaran",    body: "Aldebaran",  kind: "star",   con: "Taurus",     mag: "0.86", color: #FDBA74, hop: "Follow Orion's Belt upward to the right (northwest) to a fiery orange eye in a V-shaped cluster.", lore: "The fiery 'Eye of the Bull' sitting in front of the Hyades star cluster, 65 light-years away." },
    { id: "antares",    name: "Antares",      body: "Antares",    kind: "star",   con: "Scorpius",   mag: "1.06", color: #F87171, hop: "Find the J-shaped fishhook of Scorpius; Antares glows ruby-red at its heart.", lore: "Its name means 'Rival of Mars' because its deep red hue rivals the red planet along the ecliptic." },
    { id: "vega",       name: "Vega",         body: "Vega",       kind: "star",   con: "Lyra",       mag: "0.03", color: #BAE6FD, hop: "Brightest icy-blue vertex of the Summer Triangle high in the northern/zenith sky.", lore: "Spins so rapidly it bulges at the equator, and was Earth's North Star 14,000 years ago." },
    { id: "altair",     name: "Altair",       body: "Altair",     kind: "star",   con: "Aquila",     mag: "0.76", color: #E2E8F0, hop: "Southern tip of the Summer Triangle, flanked by two dimmer guardian stars.", lore: "Only 16.7 light-years away, completing a full rotation in under 9 hours!" },
    { id: "arcturus",   name: "Arcturus",     body: "Arcturus",   kind: "star",   con: "Boötes",     mag: "-0.05", color: #FCD34D, hop: "Follow the curve of the Big Dipper's handle: 'Arc to Arcturus'!", lore: "An ancient orange giant passing fast through the Milky Way disk from an old halo stream." },
    { id: "spica",      name: "Spica",        body: "Spica",      kind: "star",   con: "Virgo",      mag: "0.97", color: #93C5FD, hop: "After 'Arc to Arcturus', continue the curve south to 'Speed on to Spica'.", lore: "A tight pair of blue giant stars orbiting so close their gravity stretches them into egg shapes." },
    { id: "regulus",    name: "Regulus",      body: "Regulus",    kind: "star",   con: "Leo",        mag: "1.36", color: #DBEAFE, hop: "Look for the backwards question-mark ('The Sickle') of Leo; Regulus is the dot at the bottom.", lore: "The 'Little King' at the heart of Leo, a quadruple star system 79 light-years from Earth." },
    { id: "jupiter",    name: "Jupiter",      body: "Jupiter",    kind: "planet", con: "Ecliptic",   mag: "-2.4", color: #FDE68A, hop: "Shines with a steady, non-twinkling golden-white glow along the zodiac band.", lore: "King of Planets — even steady 7x binoculars can reveal its four Galilean moons in a line!" },
    { id: "saturn",     name: "Saturn",       body: "Saturn",     kind: "planet", con: "Ecliptic",   mag: "0.6",  color: #FDE047, hop: "Look for a calm, creamy-yellow 'star' that does not twinkle like background stars.", lore: "Famed for its icy rings spanning 282,000 km across yet only ~10 meters thick." },
    { id: "moon",       name: "Moon",         body: "Moon",       kind: "planet", con: "Ecliptic",   mag: "-12.6", color: #F8FAFC, hop: "Follow the terminator line (day/night boundary) where craters cast dramatic shadows.", lore: "Drifting 3.8 cm away from Earth every year; look for dark volcanic plains ('maria') with the naked eye." }
  ]

  // Stargazer trivia questions
  let quiz_bank = [
    { q: "Which star sits right in the middle of Orion's Belt?", opts: ["Alnilam", "Betelgeuse", "Rigel", "Aldebaran"], ans: 0, tip: "Alnilam ('String of Pearls') is the bright blue supergiant in the center of the three belt stars." },
    { q: "How many degrees of sky does one clenched fist at arm's length cover?", opts: ["~2 degrees", "~10 degrees", "~25 degrees", "~45 degrees"], ans: 1, tip: "A clenched fist held at arm's length spans roughly 10° of altitude — the classic stargazer's ruler!" },
    { q: "Following Orion's Belt down and left points directly to which star?", opts: ["Vega", "Antares", "Sirius", "Arcturus"], ans: 2, tip: "Orion's Belt points straight to Sirius, the brightest star in Earth's night sky (-1.46 mag)." },
    { q: "How can you tell a planet (like Jupiter or Saturn) apart from a star with the naked eye?", opts: ["Planets twinkle rapidly", "Planets shine steadily without twinkling", "Planets only appear in the north", "Planets are always green"], ans: 1, tip: "Stars are point sources that twinkle in atmospheric turbulence; planets have tiny disks that shine steadily!" },
    { q: "Why do astronomers use deep red light (#FF3333) at night?", opts: ["It attracts meteors", "It preserves dark-adapted rod cells (rhodopsin)", "It warms the phone screen", "It blocks clouds"], ans: 1, tip: "Red wavelengths barely bleach rhodopsin in your retina's rod cells, saving 30 minutes of dark adaptation." },
    { q: "Complete the classic star-hopping phrase: 'Arc to Arcturus, and...'", opts: ["Leap to Leo", "Speed on to Spica", "Run to Rigel", "Sail to Sirius"], ans: 1, tip: "Follow the Big Dipper's handle curve to orange Arcturus, then continue the arc to blue Spica!" }
  ]

  // Local states
  state screen_tab = "radar"
  state quest_filter = "all"
  state confirm_reset = false
  state reset_ends_at = 0
  state time_offset_hrs = 0
  state celebrate_msg = ""
  state quiz_feedback = ""
  state quiz_picked = -1
  state quiz_solved = [] persist
  state weather_enabled = false persist
  state observing_site = null persist
  state editing_location = false
  state city_draft = ""
  state city_query = ""
  state latitude_draft = ""
  state longitude_draft = ""
  state location_error = ""


  onTap: {
    haptic()
    screen()
  }

  source now = clock every 1s

  let safe_idx = clamp(int(quest_idx), 0, len(quests) - 1)
  let safe_quiz_idx = clamp(int(quiz_idx), 0, len(quiz_bank) - 1)
  let current_quest = quests[safe_idx]

  // Theme palette expressions (Cosmic Mode vs Strict Red Night-Vision Mode)
  let is_cosmic = theme_mode == "cosmic"
  let c_bg = is_cosmic ? #080D20 : #000000
  let c_card = is_cosmic ? #111B32 : #000000
  let c_pri = is_cosmic ? #79D9ED : #FF3333
  let c_sec = is_cosmic ? #E9C58B : #FF3333
  let c_ok = is_cosmic ? #34D399 : #FF3333
  let c_text = is_cosmic ? #E2E8F0 : #FF3333
  let c_muted = is_cosmic ? #94A3B8 : alpha(#FF3333, 0.72)
  let c_border = is_cosmic ? #293C59 : #FF3333
  let c_accent_border = is_cosmic ? #79D9ED : #FF3333

  // Location is chosen by the user; no default city or IP-based guessing.
  // OWL 13 has no GPS-coordinate/permission API. Exact coordinates may be entered.
  let site_lat = num(observing_site.lat)
  let site_lon = num(observing_site.lon)
  let location_ready = site_lat != null && site_lon != null && site_lat >= -90 && site_lat <= 90 && site_lon >= -180 && site_lon <= 180
  let site_label = location_ready ? (observing_site.name ?? "Selected coordinates") : "Choose observing location"
  let location_open = !location_ready || editing_location
  let draft_lat = num(trim(latitude_draft))
  let draft_lon = num(trim(longitude_draft))
  let coordinates_valid = len(trim(latitude_draft)) > 0 && len(trim(longitude_draft)) > 0 && draft_lat != null && draft_lon != null && draft_lat >= -90 && draft_lat <= 90 && draft_lon >= -180 && draft_lon <= 180
  source places = http(location_open && len(trim(city_query)) >= 2 && len(trim(city_query)) <= 80 ? "https://geocoding-api.open-meteo.com/v1/search?name=${enc(city_query)}&count=5&language=en&format=json" : null) every 1h json status timeout 10s

  // Isolated Python; user coordinates are shell-quoted arguments, never code.
  let site_lat_arg = location_ready ? str(site_lat) : ""
  let site_lon_arg = location_ready ? str(site_lon) : ""
  // Use the phone clock and cache the 13-hour grid for each 10-minute bucket.
  let sky_epoch = floor(now / 600) * 600
  source astro_result = cmd("python -I -c 'import json\nimport math\nimport sys\ntry:\n    latitude, longitude = map(float, sys.argv[1:3])\n    timestamp = int(sys.argv[3])\n    if not 946684800 <= timestamp <= 4102444800:\n        raise ValueError(\"Unsupported timestamp\")\n    if not (math.isfinite(latitude) and math.isfinite(longitude) and -90 <= latitude <= 90 and -180 <= longitude <= 180):\n        raise ValueError(\"Coordinates out of range\")\nexcept (ValueError, TypeError, IndexError, OverflowError):\n    print(json.dumps({\"ok\": False, \"error\": \"Choose your observing location\"}))\n    sys.exit(0)\ntry:\n    from astropy import units as u\n    from astropy.coordinates import AltAz, EarthLocation, SkyCoord, get_body, solar_system_ephemeris\n    from astropy.time import Time\n    from astropy.utils import iers\nexcept ImportError:\n    print(json.dumps({\"ok\": False, \"error\": \"Astronomy unavailable: Python astropy is missing\"}))\nelse:\n    try:\n        iers.conf.auto_download = False\n        iers.conf.iers_degraded_accuracy = \"warn\"\n        iers.conf.auto_max_age = None\n        solar_system_ephemeris.set(\"builtin\")\n        site = EarthLocation.from_geodetic(longitude * u.deg, latitude * u.deg)\n        times = Time(timestamp, format=\"unix\") + list(range(13)) * u.hour\n        frame = AltAz(obstime=times, location=site, pressure=0 * u.hPa)\n        sun = get_body(\"sun\", times, site).transform_to(frame)\n        # Fixed J2000 star catalogue: right ascension, declination, visual magnitude.\n        stars = [(84.05338935, -1.20191983, 1.69), (101.28715455, -16.71611569, -1.46),\n                 (95.9879577, -52.69566045, -0.74), (88.7929386, 7.40706274, 0.50),\n                 (78.63446805, -8.20164055, 0.13), (68.980161, 16.50930138, 0.86),\n                 (247.35192045, -26.4320025, 1.06), (279.23473545, 38.78369185, 0.03),\n                 (297.6958296, 8.86832203, 0.76), (213.91530015, 19.18241038, -0.05),\n                 (201.29824695, -11.16132203, 0.97), (152.0929611, 11.96720709, 1.36)]\n        positions = [SkyCoord(ra=ra * u.deg, dec=dec * u.deg, frame=\"icrs\").transform_to(frame)\n                     for ra, dec, magnitude in stars]\n        magnitudes = [[magnitude] * 13 for ra, dec, magnitude in stars]\n        for name, reference_mag in ((\"jupiter\", -9.40), (\"saturn\", -8.88), (\"moon\", -12.717)):\n            body = get_body(name, times, site).transform_to(frame)\n            positions.append(body)\n            separations = body.separation(sun)\n            mags = []\n            for h in range(13):\n                delta = float(body.distance[h].to_value(u.au))\n                earth_sun = float(sun.distance[h].to_value(u.au))\n                elongation = float(separations.rad[h])\n                radius = math.sqrt(max(1e-20, delta**2 + earth_sun**2 - 2 * delta * earth_sun * math.cos(elongation)))\n                phase = math.acos(max(-1, min(1, (radius**2 + delta**2 - earth_sun**2) / (2 * radius * delta))))\n                if name == \"moon\":\n                    magnitude = reference_mag + 1.49 * phase + 0.0431 * phase**4 + 5 * math.log10(delta * 149597870.7 / 384400)\n                else:\n                    # Approximate disk magnitudes; Saturn ring brightness is omitted.\n                    magnitude = reference_mag + 5 * math.log10(radius * delta) + (0.005 if name == \"jupiter\" else 0.044) * math.degrees(phase)\n                mags.append(magnitude)\n            magnitudes.append(mags)\n        sun_separations = [p.separation(sun).deg for p in positions]\n        hours = [[{\"az\": round(float(p.az.deg[h]), 2) % 360,\n                   \"alt\": round(float(p.alt.deg[h]), 2),\n                   \"mag\": round(magnitudes[i][h], 2),\n                   \"sun_sep\": round(float(sun_separations[i][h]), 2)}\n                  for i, p in enumerate(positions)] for h in range(13)]\n        sun_alts = [round(float(alt), 2) for alt in sun.alt.deg]\n        print(json.dumps({\"ok\": True, \"generated_at\": timestamp, \"latitude\": latitude,\n                          \"longitude\": longitude, \"hours\": hours, \"sun_alts\": sun_alts}, allow_nan=False))\n    except Exception:\n        print(json.dumps({\"ok\": False, \"error\": \"Sky calculation failed; refresh or check the astronomy installation\"}))\n' ${sh(site_lat_arg)} ${sh(site_lon_arg)} ${sh(sky_epoch)}") every 10m json status timeout 30s
  let astro_weather = astro_result.ok ? astro_result.out : null
  let sky_error = astro_result == null ? "Loading sky positions…" : !astro_result.ok ? "Sky calculation unavailable · check Linux and refresh" : astro_weather.error ?? "Waiting for fresh sky positions"

  // Send selected coordinates to Open-Meteo only after the user chooses a site.
  source weather = http(location_ready && weather_enabled ? "https://api.open-meteo.com/v1/forecast?latitude=${enc(round(site_lat, 2))}&longitude=${enc(round(site_lon, 2))}&current=cloud_cover&timezone=auto&timeformat=unixtime" : null) every 15m json status timeout 10s
  let weather_matches = location_ready && weather_enabled && weather.ok && weather.out.latitude != null && weather.out.longitude != null && abs(num(weather.out.latitude) - site_lat) < 0.3 && abs((num(weather.out.longitude) - site_lon + 540) % 360 - 180) < 0.3
  let weather_time = num(weather.out.current.time)
  let cloud_cover = weather_matches && weather_time != null && abs(now - weather_time) < 3600 && weather.out.current.cloud_cover != null ? clamp(num(weather.out.current.cloud_cover), 0, 100) : null
  let cloud_label = !weather_enabled ? "off" : cloud_cover == null ? "unavailable" : str(round(cloud_cover)) + "%"
  let site_zone = observing_site.timezone ?? (weather_matches ? weather.out.timezone : null) ?? null

  let safe_hr = clamp(int(time_offset_hrs), 0, 12)
  let sky_ready = location_ready && astro_weather.latitude == site_lat && astro_weather.longitude == site_lon && astro_weather.ok == true && astro_weather.generated_at != null && abs(now - astro_weather.generated_at) <= 630 && len(astro_weather.hours) == 13 && len(astro_weather.sun_alts) == 13 && all(astro_weather.sun_alts, a => num(a) != null && a >= -90 && a <= 90) && all(astro_weather.hours, h => len(h) == len(quests) && all(h, t => num(t.az) != null && t.az >= 0 && t.az < 360 && num(t.alt) != null && t.alt >= -90 && t.alt <= 90 && num(t.mag) != null && num(t.sun_sep) != null && t.sun_sep >= 0 && t.sun_sep <= 180))
  let active_targets = sky_ready ? (astro_weather.hours[safe_hr] ?? []) : []
  let live_q_pos = active_targets[safe_idx]
  let eff_az = num(live_q_pos.az)
  let eff_alt = num(live_q_pos.alt)
  let compass_points = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
  let target_direction = compass_points[int(floor((eff_az + 11.25) / 22.5)) % 16]
  let visible_count = count(active_targets, t => num(t.alt ?? -90) >= 0)
  let sky_time = sky_ready ? fmtTime(astro_weather.generated_at + safe_hr * 3600, "EEE HH:mm:ss", site_zone) + " " + (site_zone ?? "phone time") : "unavailable"

  let sun_alt = sky_ready ? num(astro_weather.sun_alts[safe_hr]) : null
  let is_daylight = sun_alt != null && sun_alt >= 0
  let is_twilight = sun_alt != null && sun_alt < 0 && sun_alt > -18
  let live_targets = sky_ready ? astro_weather.hours[0] : []
  let live_sun_alt = sky_ready ? num(astro_weather.sun_alts[0]) : null
  // Prefer high, bright objects; exclude low targets, faint crescents, and the Sun's vicinity.
  let best_candidates = range(len(quests)).filter(i => num(live_targets[i].alt ?? -90) >= 20 && num(live_targets[i].sun_sep ?? 0) >= 30 && num(live_targets[i].mag ?? 99) <= 2).sortBy(i => num(live_targets[i].mag) - min(70, num(live_targets[i].alt)) / 15)
  let best_idx = live_sun_alt != null && live_sun_alt < 0 ? first(best_candidates) : null
  let best_message = !sky_ready ? "Sky data unavailable · check location and refresh" : live_sun_alt == null ? "Daylight data unavailable · refresh before choosing a target" : live_sun_alt >= 0 ? "Daylight · try Best target now after sunset" : best_idx == null ? "No suitable bright target at least 20° up · try later" : "Selected " + quests[best_idx].name + ": bright and at least 20° above the horizon" + (cloud_cover >= 70 ? " · heavy cloud may hide it" : "")
  let conditions_label = !sky_ready || sun_alt == null ? "Sky conditions unavailable" : (safe_hr > 0 ? "Preview: " : "") + (is_daylight ? "Daylight · stars are difficult to see" : is_twilight ? "Twilight · fainter stars may be hidden" : "Dark sky time") + (safe_hr > 0 ? " · clouds not forecast here" : !weather_enabled ? " · cloud weather off" : cloud_cover == null ? " · cloud data unavailable" : cloud_cover >= 70 ? " · heavy cloud may block the view" : cloud_cover >= 30 ? " · patchy cloud; look for gaps" : " · low cloud cover")
  let direction_names = ["north", "north-northeast", "northeast", "east-northeast", "east", "east-southeast", "southeast", "south-southeast", "south", "south-southwest", "southwest", "west-southwest", "west", "west-northwest", "northwest", "north-northwest"]
  let friendly_direction = direction_names[int(floor((eff_az + 11.25) / 22.5)) % 16]

  at reset_ends_at { confirm_reset = false; reset_ends_at = 0 }
  on observing_site { time_offset_hrs = 0; celebrate_msg = "" }
  on quiz_idx { quiz_picked = -1; quiz_feedback = "" }
  on screen_tab { confirm_reset = false; reset_ends_at = 0 }

  // Stable machine-readable dates, independent of the phone's display language.
  let observing_today = fmtTime(now, "yyyy-MM-dd", site_zone, "en")
  let observing_midnight = parseTime(observing_today, null, site_zone)
  let observing_yesterday = fmtTime(observing_midnight - 43200, "yyyy-MM-dd", site_zone, "en")
  let active_streak = last_found_date == observing_today || last_found_date == observing_yesterday ? max(0, int(streak_days)) : 0

  // [4. GAMIFICATION STATS]
  // ASCII progress bar helper for 15 targets: build_ascii_progress_bar(total_found, 15)
  let clamped_found = count(quests, q => contains(found_quests, q.id))
  let build_ascii_progress_bar = join(range(15).map(i => i < clamped_found ? "#" : "-"), "")

  // XP & Rank progression
  let total_xp = clamped_found * 100 + max(0, int(streak_days)) * 50 + max(0, int(bonus_xp))
  let rank_title = total_xp >= 1800 ? "COSMIC MASTER" : total_xp >= 1200 ? "ASTRONOMER" : total_xp >= 600 ? "NAVIGATOR" : total_xp >= 200 ? "STAR SCOUT" : "CADET"
  let rank_lvl = clamp(int(floor(total_xp / 300)) + 1, 1, 10)

  let target_tint = is_cosmic ? current_quest.color : c_pri
  let target_done = contains(found_quests, current_quest.id)

  // [5. UI TREE LAYOUT (HOME-SCREEN TILE)]
  if location_open {
    Column {
      fill: true
      justify: spaceBetween
      gap: 4
      onTap: screen()
      Text { text: "✦ ASTROQUEST"; color: c_pri; fontSize: 12; bold: true; letterSpacing: 1.5 }
      Text { text: "Where are you observing?"; font: sans; fontSize: 18; bold: true; color: c_text }
      Text { text: "Enter precise coordinates or choose a city"; fontSize: 10; color: c_muted }
      Text { text: "◎ Set observing location"; color: c_bg; background: c_pri; padding: [8, 6]; fontSize: 12; align: center; bold: true; onTap: screen() }
    }
  } else {
  Column {
    fill: true
    gap: 5
    justify: spaceBetween
    Row {
      fill: width
      align: center
      Text { text: "✦ ASTROQUEST"; font: sans; fontSize: 12; letterSpacing: 1.5; bold: true; color: c_pri; weight: 1; onTap: screen() }
      Text { text: "L" + str(rank_lvl) + " · " + str(total_xp) + " XP"; fontSize: 10; color: c_sec; onTap: { screen_tab = "quests"; screen() } }
      Text { text: is_cosmic ? "☾" : "☀"; fontSize: 16; color: c_pri; padding: [6, 0]; onTap: { haptic(); theme_mode = is_cosmic ? "red" : "cosmic" } }
    }
    Row {
      fill: width
      align: center
      gap: 10
      Column {
        weight: 1
        gap: 0
        onTap: { haptic(); quest_idx = (safe_idx + 1) % len(quests) }
        Text { text: current_quest.name; font: sans; fontSize: 22; bold: true; color: target_tint; maxLines: 1 }
        Text { text: !sky_ready ? "SKY DATA UNAVAILABLE" : (eff_alt >= 0 ? "● ABOVE HORIZON" : "○ BELOW HORIZON") + " · " + str(round(eff_alt)) + "°"; fontSize: 9; letterSpacing: 0.5; color: eff_alt >= 0 ? c_ok : c_muted; maxLines: 1 }
      }
      Text { text: "›"; fontSize: 26; color: c_pri; padding: [5, 0]; onTap: { haptic(); quest_idx = (safe_idx + 1) % len(quests) } }
    }
    Row {
      fill: width
      gap: 6
      Text { text: "◎ Observing guide"; fontSize: 11; bold: true; color: c_bg; background: c_pri; align: center; padding: [6, 6]; radius: 10 * corners; weight: 1; onTap: { haptic(); screen_tab = "radar"; screen() } }
      Text {
        text: "✧ Best target now"
        fontSize: 11
        color: c_sec
        background: c_card
        align: center
        padding: [6, 6]
        radius: 10 * corners
        weight: 1
        onTap: { haptic(); let chosen = best_idx; let message = best_message; time_offset_hrs = 0; if chosen != null { quest_idx = chosen }; celebrate_msg = message; screen_tab = "radar"; screen() }
      }
    }
  }

  }

  // [6. FULL-SCREEN OBSERVING GUIDE, QUEST LOGBOOK & STAR QUIZ]
  screen {
    title: "AstroQuest · Observatory"

    Column {
      scroll: true
      gap: 10
      padding: 12
      fill: width
      background: c_bg

      if location_open {
        Column {
          fill: width
          gap: 10
          padding: 12
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners
          Text { text: "Choose your observing location"; font: sans; fontSize: 20; bold: true; color: c_pri }
          Text { text: "Sky positions use this location and the current time. There is no preset city."; fontSize: 12; color: c_text }
          Text { text: "This launcher cannot read GPS coordinates. Enter coordinates from your maps app for a precise site, or choose a city center. Update the site when you move."; fontSize: 11; color: c_muted }
          Text { text: "Sky calculations run locally. City searches go to Open-Meteo. Optional cloud weather shares coordinates rounded to 2 decimals. Your selected site is saved on this phone."; fontSize: 10; color: c_muted }
          Input { text: city_draft; placeholder: "City name (at least 2 letters)"; color: c_text; fontSize: 13; onChange: city_draft = value; onSubmit: { if len(trim(value)) >= 2 && len(trim(value)) <= 80 { city_query = trim(value); location_error = "" } else { location_error = "Enter a city name between 2 and 80 characters" } } }
          Text { text: "Search cities"; color: c_bg; background: c_pri; padding: [10, 8]; align: center; bold: true; onTap: { if len(trim(city_draft)) >= 2 && len(trim(city_draft)) <= 80 { city_query = trim(city_draft); location_error = ""; refresh() } else { location_error = "Enter a city name between 2 and 80 characters" } } }
          if len(city_query) >= 2 {
            Text { text: "Results for " + city_query; fontSize: 11; color: c_sec }
            if places == null { Text { text: "Searching…"; color: c_muted } }
            else if !places.ok { Text { text: "Search unavailable. Retry or enter coordinates below."; color: c_sec } }
            else if len(places.out.results ?? []) == 0 { Text { text: "No matching city. Try another name or exact coordinates."; color: c_sec } }
            for place in (places.ok ? places.out.results ?? [] : []).take(5) key place.id {
              Column {
                fill: width
                padding: [10, 8]
                gap: 3
                background: c_bg
                border: 1
                borderColor: c_border
                radius: 10 * corners
                Text { text: place.name + ", " + (place.admin1 ?? place.country ?? ""); fontSize: 13; bold: true; color: c_text }
                Text { text: (place.country ?? "") + " · " + str(round(num(place.latitude), 4)) + ", " + str(round(num(place.longitude), 4)) + " · city center"; fontSize: 10; color: c_muted }
                onTap: {
                  let chosen_lat = num(place.latitude)
                  let chosen_lon = num(place.longitude)
                  if chosen_lat != null && chosen_lon != null && chosen_lat >= -90 && chosen_lat <= 90 && chosen_lon >= -180 && chosen_lon <= 180 {
                    observing_site = {lat: chosen_lat, lon: chosen_lon, name: place.name + ", " + (place.country ?? ""), timezone: place.timezone, method: "city center", confirmed_at: now}
                    city_query = ""
                    city_draft = ""
                    editing_location = false
                    screen_tab = "radar"
                    location_error = ""
                    haptic()
                  }
                }
              }
            }
          }
          Text { text: "Or use exact coordinates"; fontSize: 14; bold: true; color: c_sec }
          Text { text: "Decimal degrees: latitude −90 to 90, longitude −180 to 180. South and west are negative."; fontSize: 11; color: c_muted }
          Input { text: latitude_draft; placeholder: "Latitude"; color: c_text; onChange: latitude_draft = value }
          Input { text: longitude_draft; placeholder: "Longitude"; color: c_text; onChange: longitude_draft = value }
          Text {
            text: "Use these coordinates"
            color: coordinates_valid ? c_bg : c_muted
            background: coordinates_valid ? c_pri : c_bg
            padding: [10, 8]
            align: center
            bold: true
            onTap: {
              if coordinates_valid {
                let selected_lat = draft_lat
                let selected_lon = draft_lon
                observing_site = {lat: selected_lat, lon: selected_lon, name: "Selected coordinates", method: "coordinates", confirmed_at: now}
                city_query = ""
                city_draft = ""
                editing_location = false
                screen_tab = "radar"
                location_error = ""
                haptic()
              } else { location_error = "Enter valid decimal latitude and longitude within the ranges above" }
            }
          }
          if location_error != "" { Text { text: location_error; fontSize: 11; color: c_sec } }
          if location_ready {
            Text { text: "Keep current location"; align: center; padding: 8; color: c_pri; onTap: editing_location = false }
            Text { text: "Forget saved location"; align: center; padding: 8; color: #FF3333; onTap: { observing_site = null; weather_enabled = false; latitude_draft = ""; longitude_draft = ""; city_draft = ""; city_query = ""; location_error = ""; editing_location = false } }
          }
        }
      } else {
        Column {
          fill: width
          gap: 3
          padding: [10, 8]
          background: c_card
          radius: 10 * corners
          Text { text: "◎ " + site_label + " · Change"; fontSize: 12; bold: true; color: c_pri }
          Text { text: str(round(site_lat, 4)) + ", " + str(round(site_lon, 4)) + " · " + (observing_site.method == "city center" ? "City center · enter coordinates for your exact site" : "Your observing coordinates"); fontSize: 10; color: c_muted }
          onTap: { latitude_draft = str(site_lat); longitude_draft = str(site_lon); location_error = ""; city_query = ""; editing_location = true }
        }
      }
      if !location_open {
      Text { text: weather_enabled ? "Cloud weather: on · tap to disable" : "Cloud weather: off · tap to enable"; fontSize: 11; color: c_pri; padding: [8, 6]; onTap: { weather_enabled = !weather_enabled; refresh() } }
      Text { text: "Optional weather sends your coordinates rounded to 2 decimals to Open-Meteo."; fontSize: 10; color: c_muted }
      // Top Stargazer Status & Theme Toggle Bar
      Row {
        gap: 8
        fill: width
        align: center
        padding: [10, 8]
        background: c_card
        border: 1
        borderColor: c_accent_border
        radius: 16 * corners

        Column {
          gap: 2
          weight: 1

          Text {
            text: "★ LVL " + str(rank_lvl) + " " + rank_title + " · " + str(total_xp) + " XP"
            font: sans
            fontSize: 13
            bold: true
            color: c_sec
          }

          Text {
            text: str(active_streak) + "d streak · " + str(clamped_found) + "/15 found · " + (sky_ready ? str(visible_count) + " above horizon" : "sky unavailable")
            font: sans
            fontSize: 11
            color: c_muted
          }
        }

        Text {
          text: is_cosmic ? "Cosmic" : "Night red"
          font: sans
          fontSize: 11
          bold: true
          color: c_pri
          background: is_cosmic ? alpha(#79D9ED, 0.15) : alpha(#FF3333, 0.18)
          border: 1
          borderColor: c_accent_border
          padding: [8, 6]
          radius: 10 * corners
          onTap: {
            haptic()
            theme_mode = is_cosmic ? "red" : "cosmic"
          }
        }
      }

      // 3-Way Navigation Tabs: Sky Radar | 15 Quests | Star Quiz
      Row {
        gap: 6
        fill: width

        Text {
          text: "◎ Observe"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "radar" ? c_pri : c_text
          align: center
          background: screen_tab == "radar" ? alpha(c_pri, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "radar" ? c_accent_border : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "radar"
          }
        }

        Text {
          text: "✦ Quests"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "quests" ? c_sec : c_text
          align: center
          background: screen_tab == "quests" ? alpha(c_sec, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "quests" ? c_sec : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "quests"
          }
        }

        Text {
          text: "✧ Quiz"
          font: sans
          fontSize: 11
          bold: true
          color: screen_tab == "quiz" ? c_ok : c_text
          align: center
          background: screen_tab == "quiz" ? alpha(c_ok, 0.2) : c_card
          border: 1
          borderColor: screen_tab == "quiz" ? c_ok : c_border
          padding: [6, 8]
          radius: 10 * corners
          maxLines: 1
          weight: 1
          onTap: {
            haptic()
            screen_tab = "quiz"
          }
        }
      }

      if celebrate_msg != "" {
        Row {
          gap: 8
          fill: width
          align: center
          padding: [10, 6]
          background: alpha(c_ok, 0.18)
          border: 1
          borderColor: c_ok
          radius: 10 * corners
          onTap: {
            celebrate_msg = ""
          }

          Text {
            text: celebrate_msg
            font: sans
            fontSize: 12
            bold: true
            color: c_ok
            weight: 1
          }

          Text {
            text: "✕"
            font: sans
            fontSize: 12
            bold: true
            color: c_ok
          }
        }
      }

      if screen_tab == "radar" {
        Column {
          fill: width
          gap: 6
          padding: 10
          background: c_card
          radius: 10 * corners
          Text { text: conditions_label; fontSize: 12; color: c_sec }
          if !sky_ready { Text { text: sky_error + " · Tap to retry"; fontSize: 11; color: c_pri; onTap: refresh() } }
          Text { text: "✧ Best target now"; fontSize: 13; bold: true; color: c_bg; background: c_pri; padding: [10, 8]; align: center; onTap: { haptic(); let chosen = best_idx; let message = best_message; time_offset_hrs = 0; if chosen != null { quest_idx = chosen }; celebrate_msg = message; screen_tab = "radar"; screen() } }
          Text { text: "Choose a target below, or get a bright object at least 20° up after sunset."; fontSize: 10; color: c_muted }
          if sky_ready && eff_alt >= 0 {
            Text { text: (safe_hr > 0 ? "At preview time, face " : "Face ") + friendly_direction + ", then look " + str(round(eff_alt)) + "° up · about " + str(round(eff_alt / 10, 1)) + " fists above the horizon"; fontSize: 14; bold: true; color: c_text }
            Text { text: "Confirm the pattern: " + current_quest.hop; fontSize: 12; color: c_text }
          }
        }

        // Selected target and calculated position
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Row {
            fill: width
            align: center
            gap: 6

            Text {
              text: "‹"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [8, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = (safe_idx + len(quests) - 1) % len(quests)
              }
            }

            Text {
              text: current_quest.name + (contains(found_quests, current_quest.id) ? " ✓" : "")
              font: sans
              fontSize: 14
              bold: true
              color: is_cosmic ? current_quest.color : #FF3333
              align: center
              weight: 1
            }

            Text {
              text: "Random"
              font: sans
              fontSize: 11
              bold: true
              color: c_sec
              border: 1
              borderColor: c_sec
              padding: [6, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = random(len(quests))
              }
            }

            Text {
              text: "›"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [8, 4]
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = (safe_idx + 1) % len(quests)
              }
            }
          }

          Text {
            text: current_quest.con + " · Mag " + str(live_q_pos.mag ?? current_quest.mag) + (safe_hr > 0 ? " · weather: current only" : " · Clouds: " + cloud_label)
            font: sans
            fontSize: 11
            color: c_muted
            align: center
            fill: width
          }

          Text {
            text: !sky_ready ? (sky_error) : target_direction + " · Az " + fixed(eff_az, 2) + "° · Alt " + fixed(eff_alt, 2) + "°"
            font: sans
            fontSize: 12
            bold: true
            color: c_text
            align: center
            fill: width
          }

          Text {
            text: !sky_ready ? "Positions are hidden until fresh data is available" : eff_alt >= 0 ? "Above horizon · elevation " + str(round(eff_alt)) + "°" : "Below horizon · choose another target or explore a later time"
            font: sans
            fontSize: 11
            bold: true
            color: eff_alt >= 0 ? c_ok : c_sec
            align: center
            fill: width
          }
        }

        Text { text: (safe_hr > 0 ? "FUTURE PREVIEW · " : "Calculated for ") + sky_time + (safe_hr > 0 ? " · +" + str(safe_hr) + " hours" : " · updates every 10 minutes"); fontSize: 10; color: c_muted; align: center }
        Text { text: "Azimuth: true north 0°, east 90°, south 180°, west 270°. Altitude: horizon 0°, overhead 90°."; fontSize: 10; color: c_muted; align: center }

        Column {
          fill: width
          gap: 6
          padding: 10
          background: c_card
          border: 1
          borderColor: c_border
          radius: 10 * corners
          Text { text: "WHEN TO LOOK · " + upper(current_quest.name); fontSize: 12; bold: true; color: c_pri }
          Text { text: "Next 3 hours from now · tap a row to preview its position"; fontSize: 10; color: c_muted }
          if sky_ready {
            for h in range(4) {
              let outlook = astro_weather.hours[h][safe_idx]
              let outlook_alt = num(outlook.alt)
              let outlook_sun = num(astro_weather.sun_alts[h])
              let outlook_dir = compass_points[int(floor((num(outlook.az) + 11.25) / 22.5)) % 16]
              Row {
                fill: width
                gap: 6
                padding: [6, 8]
                background: h == safe_hr ? alpha(c_pri, 0.12) : c_bg
                onTap: { haptic(); time_offset_hrs = h }
                Text { text: h == 0 ? "Now" : fmtTime(astro_weather.generated_at + h * 3600, "HH:mm", site_zone); width: 48; fontSize: 12; bold: true; color: c_text }
                Text { text: outlook_alt < 0 ? "Below horizon" : outlook_dir + " · " + str(round(outlook_alt)) + "° up"; weight: 1; fontSize: 12; color: outlook_alt >= 20 ? c_ok : c_muted }
                Text { text: outlook_sun >= 0 ? "Daylight" : outlook_alt < 0 ? "Wait" : outlook_alt < 20 ? "Low" : outlook_sun > -18 ? "Twilight" : "Dark"; fontSize: 11; color: c_sec }
              }
            }
          } else { Text { text: "Choose your observing site and refresh to load the outlook."; fontSize: 11; color: c_muted } }
          Text { text: "Higher targets are usually easier to see over buildings. This outlook shows positions and daylight; it does not forecast clouds or local obstructions."; fontSize: 10; color: c_muted }
        }

        Column {
          fill: width
          gap: 5
          padding: 10
          background: c_card
          radius: 10 * corners
          Text { text: "HOW TO FOLLOW THE DIRECTIONS"; fontSize: 12; bold: true; color: c_pri }
          Text { text: "1. Face the named direction using a compass set to true north.\n2. Look up from the horizon: one fist at arm’s length is roughly 10°.\n3. Match the identification guide before logging the object."; fontSize: 11; color: c_text }
          Text { text: "Directions use your saved coordinates. Update them when you move. Phone rotation is not measured."; fontSize: 10; color: c_muted }
        }

        // Star-Hopping & Cosmic Lore Card
        Column {
          gap: 5
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Text {
            text: "✧ HOW TO SPOT " + upper(current_quest.name) + " (" + current_quest.con + ")"
            font: sans
            fontSize: 11
            bold: true
            color: c_sec
          }

          Text {
            text: "▸ Hop: " + current_quest.hop
            font: sans
            fontSize: 11
            color: c_text
          }

          Text {
            text: "Before logging: match the guide and confirm the object with your own eyes."; fontSize: 11; color: c_sec }
          Text {
            text: "✦ Lore: " + current_quest.lore
            font: sans
            fontSize: 11
            color: c_muted
          }
        }

        // Sky time preview controls
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Row {
            fill: width
            align: center
            gap: 6

            Text {
              text: "Sky time · " + sky_time + (safe_hr == 0 ? "" : " (+" + str(safe_hr) + "h)")
              font: sans
              fontSize: 11
              bold: true
              color: c_sec
              weight: 1
            }

            Text {
              text: "NOW"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                time_offset_hrs = 0
              }
            }

            Text {
              text: "+3h"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              border: 1
              borderColor: c_accent_border
              padding: [6, 3]
              radius: 10 * corners
              onTap: {
                haptic()
                time_offset_hrs = safe_hr >= 12 ? 0 : min(12, safe_hr + 3)
              }
            }
          }

          Slider {
            value: time_offset_hrs
            min: 0
            max: 12
            step: 1
            live: true
            color: c_sec
            track: alpha(c_sec, 0.25)
            onChange: {
              time_offset_hrs = int(round(value))
            }
          }


        }

        // Action Buttons Row
        Row {
          gap: 8
          fill: width

          Text {
            text: safe_hr > 0 ? "Preview only" : !sky_ready || eff_alt < 0 ? "Target unavailable" : target_done ? "✓ I identified it · log observation" : "✦ I identified it · log discovery"
            font: sans
            fontSize: 13
            bold: true
            color: c_ok
            align: center
            background: c_card
            border: 1
            borderColor: c_ok
            padding: [10, 8]
            radius: 10 * corners
            weight: 1
            onTap: {
              haptic()
              if safe_hr == 0 && sky_ready && eff_alt >= 0 {
                let logged_id = current_quest.id
                let logged_name = current_quest.name
                let was_found = contains(found_quests, logged_id)
                let today = fmtTime(now, "yyyy-MM-dd", site_zone, "en")
                let midnight = parseTime(today, null, site_zone)
                let yesterday = fmtTime(midnight - 43200, "yyyy-MM-dd", site_zone, "en")
                if today != null && midnight != null && last_found_date != today {
                  streak_days = last_found_date == yesterday ? max(0, int(streak_days)) + 1 : 1
                  last_found_date = today
                }
                if !was_found {
                  found_quests = unique(flatten([found_quests, [logged_id]]))
                  total_found = count(quests, q => contains(found_quests, q.id))
                  bonus_xp = max(0, int(bonus_xp)) + 25
                }
                celebrate_msg = was_found ? "✓ Observation logged · " + logged_name : "✦ Discovered " + logged_name + " · +100 XP +25 horizon bonus"
                quest_idx = (safe_idx + 1) % len(quests)
              } else {
                celebrate_msg = safe_hr > 0 ? "Return to NOW to log a real observation" : "Choose a target currently above the horizon with fresh sky data"
              }
            }
          }
        }

        // Quick 3-Column Target Grid on Radar Tab
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_border
          radius: 16 * corners

          Text {
            text: "Targets · ● above horizon · ✓ logged · " + sky_time
            font: sans
            fontSize: 11
            bold: true
            color: c_sec
            align: center
            fill: width
          }

          Grid {
            columns: 3
            gap: 6
            fill: width

            for q, i in quests key q.id {
              let is_sel = i == safe_idx
              let is_done = contains(found_quests, q.id)
              let q_pos = active_targets[i]
              let is_up = num(q_pos.alt ?? -10) >= 0
              Text {
                text: (is_done ? "✓ " : is_up ? "● " : "") + q.name
                font: sans
                fontSize: 11
                bold: is_sel
                color: is_sel ? c_pri : is_up ? c_ok : c_text
                align: center
                background: is_sel ? alpha(c_pri, 0.22) : c_bg
                border: 1
                borderColor: is_sel ? c_accent_border : alpha(c_pri, 0.35)
                padding: [4, 6]
                radius: 10 * corners
                maxLines: 1
                onTap: {
                  haptic()
                  quest_idx = i
                }
              }
            }
          }
        }
      }

      if screen_tab == "quests" {
        Text { text: "Visibility at " + sky_time; fontSize: 10; color: c_muted; align: center }
        // Logbook & Badges Summary Card
        Column {
          gap: 6
          padding: 10
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Text {
            text: "Streak: " + str(active_streak) + " Nights  | Found: [" + build_ascii_progress_bar + "] " + str(clamped_found) + "/15"
            font: sans
            fontSize: 12
            bold: true
            color: c_sec
          }

          // Unlockable Badges Row
          Row {
            gap: 6
            fill: width

            Text {
              text: (clamped_found >= 1 ? "✦" : "○") + " First Light"
              font: sans
              fontSize: 10
              bold: clamped_found >= 1
              color: clamped_found >= 1 ? c_ok : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 1 ? c_ok : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }

            Text {
              text: (clamped_found >= 5 ? "✦" : "○") + " Hunter (5)"
              font: sans
              fontSize: 10
              bold: clamped_found >= 5
              color: clamped_found >= 5 ? c_ok : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 5 ? c_ok : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }

            Text {
              text: (clamped_found >= 15 ? "✦" : "○") + " Master (15)"
              font: sans
              fontSize: 10
              bold: clamped_found >= 15
              color: clamped_found >= 15 ? c_sec : c_muted
              align: center
              border: 1
              borderColor: clamped_found >= 15 ? c_sec : c_border
              padding: [4, 4]
              radius: 10 * corners
              weight: 1
            }
          }

          // Filter Chips Row
          Row {
            gap: 6
            fill: width

            Text {
              text: "ALL (15)"
              font: sans
              fontSize: 11
              bold: quest_filter == "all"
              color: quest_filter == "all" ? c_pri : c_muted
              align: center
              background: quest_filter == "all" ? alpha(c_pri, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "all" ? c_accent_border : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "all"
              }
            }

            Text {
              text: "UP (" + str(visible_count) + ")"
              font: sans
              fontSize: 11
              bold: quest_filter == "up"
              color: quest_filter == "up" ? c_ok : c_muted
              align: center
              background: quest_filter == "up" ? alpha(c_ok, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "up" ? c_ok : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "up"
              }
            }

            Text {
              text: "UNFOUND"
              font: sans
              fontSize: 11
              bold: quest_filter == "todo"
              color: quest_filter == "todo" ? c_sec : c_muted
              align: center
              background: quest_filter == "todo" ? alpha(c_sec, 0.18) : c_bg
              border: 1
              borderColor: quest_filter == "todo" ? c_sec : c_border
              padding: [6, 4]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quest_filter = "todo"
              }
            }
          }

          Row {
            gap: 8
            fill: width

            Text {
              text: "[ ↻ REFRESH TELEMETRY ]"
              font: sans
              fontSize: 11
              bold: true
              color: c_pri
              align: center
              border: 1
              borderColor: c_accent_border
              padding: [8, 5]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                refresh()
              }
            }

            Text {
              text: confirm_reset ? "[ ! TAP TO CONFIRM RESET ]" : "[ ✕ RESET LOGBOOK ]"
              font: sans
              fontSize: 11
              bold: true
              color: #FF3333
              align: center
              background: confirm_reset ? alpha(#FF3333, 0.2) : c_bg
              border: 1
              borderColor: #FF3333
              padding: [8, 5]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                if confirm_reset && reset_ends_at > now {
                  found_quests = []
                  total_found = 0
                  streak_days = 0
                  bonus_xp = 0
                  quiz_solved = []
                  quiz_idx = 0
                  quiz_streak = 0
                  quiz_picked = -1
                  quiz_feedback = ""
                  celebrate_msg = ""
                  time_offset_hrs = 0
                  reset_ends_at = 0
                  last_found_date = ""
                  quest_idx = 0
                  confirm_reset = false
                } else {
                  confirm_reset = true
                  reset_ends_at = int(now + 5)
                }
              }
            }
          }
        }

        // Interactive 15-Quest Selector List with Star-Hopping Hints
        for q, i in quests key q.id {
          let is_found = contains(found_quests, q.id)
          let is_selected = i == safe_idx
          let q_coords = active_targets[i]
          let q_az = round(num(q_coords.az), 1)
          let q_alt = round(num(q_coords.alt ?? -90), 1)
          let show_row = quest_filter == "all" || (quest_filter == "up" && q_alt >= 0) || (quest_filter == "todo" && !is_found)

          if show_row {
            Column {
              gap: 4
              fill: width
              padding: [10, 8]
              background: is_selected ? alpha(c_pri, 0.16) : c_card
              border: 1
              borderColor: is_selected ? c_accent_border : c_border
              radius: 10 * corners
              onTap: {
                haptic()
                quest_idx = i
                screen_tab = "radar"
              }

              Row {
                gap: 8
                align: center
                fill: width

                Text {
                  text: (is_found ? "[✓] " : "[ ] ") + pad(str(i + 1), 2, "0") + ". " + q.name + " (" + q.con + ")"
                  font: sans
                  fontSize: 13
                  bold: true
                  color: is_found ? c_ok : (is_cosmic ? q.color : #FF3333)
                  weight: 1
                }

                Text {
                  text: !sky_ready ? "Unavailable" : (q_alt >= 0 ? "● " : "○ ") + "Az " + str(q_az) + "° · Alt " + str(q_alt) + "°"
                  font: sans
                  fontSize: 11
                  color: q_alt >= 0 ? c_ok : c_muted
                }
              }

              Text {
                text: "↳ " + q.hop
                font: sans
                fontSize: 11
                color: c_muted
              }
            }
          }
        }
      }

      if screen_tab == "quiz" {
        let cur_q = quiz_bank[safe_quiz_idx]

        Column {
          gap: 10
          padding: 12
          fill: width
          background: c_card
          border: 1
          borderColor: c_accent_border
          radius: 16 * corners

          Row {
            fill: width
            align: center

            Text {
              text: "✧ STARGAZER ACADEMY QUIZ (" + str(clamp(int(quiz_idx), 0, len(quiz_bank) - 1) + 1) + "/" + str(len(quiz_bank)) + ")"
              font: sans
              fontSize: 12
              bold: true
              color: c_sec
              weight: 1
            }

            Text {
              text: "Streak: " + str(quiz_streak) + " "
              font: sans
              fontSize: 12
              bold: true
              color: c_ok
            }
          }

          Text {
            text: cur_q.q
            font: sans
            fontSize: 14
            bold: true
            color: c_text
          }

          for opt, oi in cur_q.opts {
            let is_correct = oi == cur_q.ans
            let is_picked = quiz_picked == oi
            Text {
              text: (is_picked ? (is_correct ? "[ ✓ ] " : "[ ✕ ] ") : "[ " + str(oi + 1) + " ] ") + opt
              font: sans
              fontSize: 13
              bold: is_picked
              color: is_picked ? (is_correct ? c_ok : #FF3333) : c_text
              background: is_picked ? alpha(is_correct ? c_ok : #FF3333, 0.18) : c_bg
              border: 1
              borderColor: is_picked ? (is_correct ? c_ok : #FF3333) : c_border
              padding: [10, 8]
              radius: 10 * corners
              fill: width
              onTap: {
                haptic()
                if quiz_picked == -1 {
                quiz_picked = oi
                if oi == cur_q.ans {
                  if !contains(quiz_solved, safe_quiz_idx) {
                    bonus_xp = max(0, int(bonus_xp)) + 50
                    quiz_streak = max(0, int(quiz_streak)) + 1
                    quiz_solved = unique(flatten([quiz_solved, [safe_quiz_idx]]))
                    quiz_feedback = "✓ Correct! +50 XP · " + cur_q.tip
                  } else {
                    quiz_feedback = "✓ Correct! Already mastered · " + cur_q.tip
                  }
                } else {
                  quiz_streak = 0
                  quiz_feedback = "✕ Not quite! Hint: " + cur_q.tip
                }
                }
              }
            }
          }

          if quiz_feedback != "" {
            Text {
              text: quiz_feedback
              font: sans
              fontSize: 12
              color: quiz_picked == cur_q.ans ? c_ok : c_sec
              background: alpha(c_pri, 0.12)
              border: 1
              borderColor: c_accent_border
              padding: 8
              radius: 10 * corners
              fill: width
            }
          }

          Row {
            gap: 8
            fill: width

            Text {
              text: "↻ Random"
              font: sans
              fontSize: 12
              bold: true
              color: c_pri
              align: center
              border: 1
              borderColor: c_accent_border
              padding: [10, 8]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quiz_idx = random(len(quiz_bank))
                quiz_picked = -1
                quiz_feedback = ""
              }
            }

            Text {
              text: "Next question ›"
              font: sans
              fontSize: 12
              bold: true
              color: c_sec
              align: center
              border: 1
              borderColor: c_sec
              padding: [10, 8]
              radius: 10 * corners
              weight: 1
              onTap: {
                haptic()
                quiz_idx = (safe_quiz_idx + 1) % len(quiz_bank)
                quiz_picked = -1
                quiz_feedback = ""
              }
            }
          }
        }
      }
      }
    }
  }
}
