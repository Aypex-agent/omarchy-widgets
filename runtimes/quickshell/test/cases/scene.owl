widget "x" {
  meta { owl: 22 }
  state spin = 0
  let box = cube()
  Canvas {
    scene({eye: [0, 2, 6], look: [0, 0, 0]}, light: [1, 2, 3], ambient: 0.2, fog: background) {
      model(box, at: [0, 0, 0], turn: [0, spin, 0], scale: 2, color: accent, smooth: true, twoSided: true)
      for i in range(3) { model(sphere(8), at: [i, 1, 0], image: "ball.png", ambient: 0.5) }
    }
    circle(10, 10, 4)
  }
}
