app "readeck" {
  edge: true

  meta { owl: 9; description: "A Readeck client for a server or an export: lists, labels, search, a reader, notes and bulk changes. Summary and tidy-up use Claude Code, which sends the text to Anthropic"; version: "1.4"; license: "MIT"; category: "news" }

  title: readId != "" ? item.title ?? "reading" : view == "setup" ? "connect" : view == "labels" ? "labels" : view == "search" ? "search" : label == "" ? view : label
  back: readId != "" || view == "labels" || view == "search" || view == "setup" || label != ""
  onBack: {
    if readId != "" {
      if editing { editing = false } else { readId = "" }
    } else if view == "setup" {
      view = "unread"
    } else if label != "" {
      label = ""
    } else {
      view = "unread"
    }
  }
  // Readeck's own mark: the yellow, blue and teal page and arrow, drawn on a square that
  // is transparent around it. The arrow takes the theme's accent, as the store asks.
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
    <g transform="translate(4.6 4.5) scale(0.1813)">
      <path fill="#ffcb5c" d="m191.012 69.77-99.82 46.539V187.8l127.203-59.309Z"/>
      <path fill="#37bed9" d="M91.191 117.809v71.496l105.887 49.367-6.348-38.711 33.73-20.012Z"/>
      <path fill="#187995" d="M26.387 38.969H91.19v191.98H26.387Z"/>
      <path fill="#37bed9" d="M91.191 3.223 26.387 38.969l192.008 89.523V57Z"/>
      <path fill="currentColor" d="M91.191 69.188v47.12l50.536-23.558Z"/>
    </g>
  </svg>"""

  // The library, from the server or from an export of it, as the app's own helper
  // (owl-readeck, installed above) fetches it: one bookmark a line.
  requires { pacman: ["jq", "curl", "unzip", "python"] }

  // The app's helpers: owl-readeck talks to the server and keeps the library on disk,
  // owl-readeck-read turns an article's HTML into the text the reader draws. They are
  // in this file as plaintext, and are written to ~/.local/bin on first run, so the
  // app is one self-contained file. Nothing is downloaded, decoded or installed from
  // anywhere else. The app's own traffic is to the Readeck server the user names; the
  // summary and tidy buttons run Claude Code, which sends the article's text to Anthropic.
  source installer = cmd("""# Installs the app's own helpers from this file into ~/.local/bin, and only when
# their version marker is missing: owl-readeck talks to the Readeck server, and
# owl-readeck-read turns an article's HTML into the text the reader draws. Both are
# plaintext in this file, written by cat with a quoted heredoc, so nothing is decoded
# or fetched; they live beside the app's cache, not on a command line.
# Each helper's second line is its marker, alone on the line, and a helper is written
# again when that exact line isn't there. Bump a helper's marker whenever the helper
# changes, or phones that have it keep the old one.
set -uo pipefail
umask 077
bin="$HOME/.local/bin"
mkdir -p "$bin" || exit 1
if ! grep -qxF '# owl-readeck 1.1' "$bin/owl-readeck" 2>/dev/null; then
  cat > "$bin/owl-readeck" << 'READECK_LIB_END'
#!/bin/bash
# owl-readeck 1.1
# The script side of the Readeck app (readeck.owl).
# Fetches a Readeck server's bookmarks into the export the app reads, imports
# a Readeck export without a server, and saves changes to bookmarks.
set -u
umask 077
cache="$HOME/.cache/omalauncher"
out="$cache/readeck.jsonl"
mode="${1:-}"
mkdir -p "$HOME/.cache/omalauncher" 2>/dev/null || true
: > "$HOME/.cache/omalauncher/readeck-last.err" 2>/dev/null || true

die() {
  echo "$*" > "$HOME/.cache/omalauncher/readeck-last.err" 2>/dev/null || true
  echo "readeck: $*" >&2
  exit 1
}

# One bookmark, as the app reads it: the server's own fields (lower case) under the
# names the app uses, in the shape it expects. Reading time is worked out from the
# word count when the server doesn't say (200 words a minute).
normalise='
  map(select(type == "object" and .id != null))
  | sort_by([ .id, -(tostring | length) ])
  | unique_by(.id)
  | sort_by(-((.published // .created // "0") | tostring | .[0:19] | gsub("[^0-9]"; "") | tonumber? // 0))
  | map({
      id: (.id | tostring),
      title: (.title // ""),
      url: (.url // ""),
      site_name: (.site_name // .site // ""),
      is_marked: (.is_marked == true),
      is_archived: (.is_archived == true),
      is_deleted: (.is_deleted == true),
      read_progress: (.read_progress | tonumber? // null),
      note: (.note // ""),
      labels: ((.labels // []) | if type == "array" then map(tostring) else [tostring] end),
      description: (.description // ""),
      authors: ((.authors // []) | if type == "array" then map(tostring) else [tostring] end),
      lang: (.lang // ""),
      word_count: ((.word_count | tonumber?) // null),
      reading_time: ((.reading_time | tonumber?) // ((.word_count | tonumber? // 0) / 200 | ceil | if . > 0 then . else null end)),
      published: ((.published // .created // null) | if . == null then null else tostring end),
      created: ((.created // null) | if . == null then null else tostring end),
      document_type: (.document_type // .type // ""),
      has_article: (.has_article == true),
      site_icon: (.resources.icon.src // ""),
      image: (.resources.image.src // ""),
      thumbnail: (.resources.thumbnail.src // "")
    })
  | .[]
'
command -v jq >/dev/null || die "jq is missing (pacman -S jq)"

# A Readeck export (the zip its profile's export button makes: data.json and a
# bookmarks/<id>/info.json each), or that zip unzipped into a folder, to the app's
# list: one line per bookmark, only what the app shows. A data.jsonl, one bookmark a
# line, is read too. The zip's data.json is only its index (ids, no titles or links),
# so a data.json on its own has nothing to import.
import_from() {
  [ -e "$1" ] || die "no such file: $1"
  mkdir -p "$cache"
  work=$(mktemp -d "$cache/readeck-import.XXXXXX") || die "couldn't make a temporary folder"
  trap 'rm -rf "$work"' EXIT

  root="$work"
  if [ -d "$1" ]; then
    root="$1"
  else
    case "$1" in
      *.zip) unzip -q -o "$1" -d "$work" || die "couldn't open $1" ;;
      *.jsonl) cp "$1" "$work/data.jsonl" || die "couldn't read $1" ;;
      *.json) die "$(basename "$1") is only the export's index; import the export zip" ;;
      *) die "import the export zip, its unzipped folder, or a .jsonl" ;;
    esac
  fi

  # Every bookmark's info.json (capitalised fields), and a data.jsonl (lower case), as
  # one stream of objects.
  { find "$root" -name info.json -type f -exec cat {} + 2>/dev/null
    [ -f "$root/data.jsonl" ] && cat "$root/data.jsonl"; } > "$work/all.json"
  if [ ! -s "$work/all.json" ]; then
    [ -f "$root/data.json" ] && die "data.json is only the index; import the export zip"
    die "no bookmarks in $1"
  fi
  jq -c -s '
    [ .[] | select(type == "object") ]
    | map(select((.UID // .id) != null))
    | map({
        id: (.UID // .id),
        title: (.Title // .title // ""),
        url: (.URL // .url // ""),
        site_name: (.SiteName // .site_name // .Site // .site // ""),
        is_marked: ((.IsMarked // .is_marked) == true or (.IsMarked // .is_marked) == "true"),
        is_archived: ((.IsArchived // .is_archived) == true or (.IsArchived // .is_archived) == "true"),
        read_progress: (if (.ReadProgress // .read_progress) == null then null else ((.ReadProgress // .read_progress) | tonumber? // null) end),
        note: (.Note // .note // ""),
        labels: (((.Labels // .labels) // []) | if type == "array" then map(tostring) else [tostring] end),
        description: (.Description // .description // ""),
        authors: (((.Authors // .authors) // []) | if type == "array" then map(tostring) else [tostring] end),
        lang: (.Lang // .lang // ""),
        word_count: (((.WordCount // .word_count) | tonumber?) // null),
        published: (.Published // .published // .Date // .created // null),
        created: (.Created // .created // null),
        document_type: (.DocumentType // .document_type // ""),
        has_article: ((.HasArticle // .has_article) == true or (.DocumentType // .document_type // "") == "article")
      })
    | '"$normalise"'
' "$work/all.json" > "$out.tmp" 2>/dev/null || die "couldn't read the bookmarks in $1"
  [ -s "$out.tmp" ] || { rm -f "$out.tmp"; die "no bookmarks in $1"; }
  mv "$out.tmp" "$out"

  # The articles' text and pictures too, so the export reads without the
  # server: each bookmark's container/index.html, and the files its info.json
  # names (img/icon.png, img/thumbnail.jpeg, ...), copied to img/<id>-<name>.
  mkdir -p "$img_dir" || die "couldn't make the pictures' folder"
  : > "$work/paths.tmp"
  for info in "$root"/bookmarks/*/info.json; do
    [ -f "$info" ] || continue
    box=$(dirname "$info")
    id=$(basename "$box")
    [ -f "$box/container/index.html" ] && { extract "$id" "$box/container/index.html" || true; }
    for name in $(jq -r '(.Files // {}) | to_entries[]
                          | select(.key as $k | ["article", "log", "props"] | index($k) | not)
                          | .value.name' "$info" 2>/dev/null); do
      [ -f "$box/container/$name" ] || continue
      copy="$img_dir/$id-$(basename "$name")"
      cp "$box/container/$name" "$copy" 2>/dev/null || continue
      case "$name" in
        img/icon.*) key=site_icon ;;
        img/thumbnail.*) key=thumbnail ;;
        img/image.*) key=image ;;
        *) continue ;;
      esac
      jq -cn --arg id "$id" --arg k "$key" --arg f "$copy" '{id: $id, k: $k, f: $f}' \
        >> "$work/paths.tmp"
    done
  done
  # Point each bookmark's pictures at their copies, in one pass over the list.
  if [ -s "$work/paths.tmp" ]; then
    jq -s -c '.' "$work/paths.tmp" > "$work/paths.json" 2>/dev/null \
      && jq -c -s --slurpfile idx "$work/paths.json" '
        $idx[0] as $ix
        | . as $list
        | map(. as $b | reduce ($ix[] | select(.id == $b.id)) as $e
              ($b; .[$e.k] = $e.f))
        | .[]
      ' "$out" > "$out.img" 2>/dev/null \
      && mv "$out.img" "$out" || true
  fi
}
# The AI harness, Claude Code: a prompt in, text out, with no tools and no session, so
# it only writes an answer. It is not local: Claude Code sends the prompt and the
# article's text to Anthropic, on the user's own Claude account. Found in mise's installs
# first (a mise shim fails when mise has no version set for it), then on the PATH.
ai_bin() {
  if [ -n "${OWL_READECK_AI:-}" ] && [ -x "${OWL_READECK_AI}" ]; then
    echo "$OWL_READECK_AI"
    return 0
  fi
  for dir in "$HOME"/.local/share/mise/installs/claude/*/; do
    [ -x "$dir/claude" ] && { echo "${dir}claude"; return 0; }
  done
  command -v claude
}

# ai "$PROMPT" < input: the harness's answer, or nothing when it isn't there.
ai() {
  bin=$(ai_bin) || { echo "readeck: the AI harness (claude) isn't installed" >&2; return 1; }
  # --tools "" so it can run nothing; --print for one answer; a long timeout for a
  # long article. stderr is dropped: its chatter isn't the answer.
  timeout 300 "$bin" --print --tools "" \
    --system-prompt "You are a text transformation function. You never chat, never ask questions, never offer choices, and never comment on the input. You output only the requested result, nothing else." \
    "$1" <&0
}

# http METHOD URL TOKEN BODY ERROR: send a change to the server and die with the
# server's own words when it refuses, so the app can say why ("401 the token isn't
# accepted", "409 a bookmark with this URL is already there") instead of "failed".
http() {
  method="$1" url="$2" token="$3" body="$4" what="$5"
  if [ -n "$body" ]; then
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Content-Type: application/json' \
      -H 'Accept: application/json' -H "Authorization: Bearer $token" \
      --data-binary "$body" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  else
    resp=$(curl -sS --max-time 25 -X "$method" -H 'Accept: application/json' \
      -H "Authorization: Bearer $token" -w '\n%{http_code}' "$url" 2>&1) \
      || die "$what: couldn't reach the server"
  fi
  code=$(printf '%s' "$resp" | tail -1)
  text=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) return 0 ;;
    401 | 403) die "$what: the token isn't accepted ($code)" ;;
    *) msg=$(printf '%s' "$text" | jq -r '.message // .error // empty' 2>/dev/null | head -1)
       die "$what: ${msg:-$code}" ;;
  esac
}

# The reader: one article as the light text the app draws, in
# $cache/readeck-read/<id>.jsonl (owl-readeck-read does the HTML).
read_dir="$cache/readeck-read"
img_dir="$cache/readeck-images"
ai_dir="$cache/readeck-ai"
extract() {
  # extract ID SOURCE: SOURCE is an HTML file, or - for stdin.
  mkdir -p "$read_dir" || die "couldn't make the reader's folder"
  "$(dirname "$0")/owl-readeck-read" "$2" "$read_dir/$1.jsonl.tmp" || die "couldn't read the article"
  mv "$read_dir/$1.jsonl.tmp" "$read_dir/$1.jsonl"
}

case "$mode" in
add)
  # add BASE TOKEN URL: save a link to read.
  [ $# -eq 4 ] || die "usage: $0 add BASE TOKEN URL"
  http POST "$2/api/bookmarks" "$3" "$(jq -cn --arg u "$4" '{url: $u}')" \
    "couldn't save the link"
  ;;
change)
  # change BASE TOKEN ID JSON: one change to a bookmark.
  [ $# -eq 5 ] || die "usage: $0 change BASE TOKEN ID '{json}'"
  http PATCH "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "$5" \
    "couldn't save the change"
  ;;
bulk)
  # bulk BASE TOKEN JSON 'ID ID ...': the same change to several bookmarks, one after
  # another. The ids come as one word, split on spaces here (Readeck's ids have none).
  # Prints how many worked, and stops keeping the count on the first failure.
  [ $# -eq 5 ] || die "usage: $0 bulk BASE TOKEN JSON 'ID ID ...'"
  base="$2" token="$3" json="$4"
  read -ra ids <<< "$5"
  [ "${#ids[@]}" -gt 0 ] || die "nothing picked"
  ok=0
  for id in "${ids[@]}"; do
    http PATCH "$base/api/bookmarks/$(jq -rn --arg v "$id" '$v|@uri')" "$token" "$json" \
      "couldn't change $id" || exit 1
    ok=$((ok + 1))
  done
  echo "changed $ok"
  ;;
delete)
  # delete BASE TOKEN ID: delete a bookmark for good (the app's "delete" only marks it).
  [ $# -eq 4 ] || die "usage: $0 delete BASE TOKEN ID"
  http DELETE "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" \
    "couldn't delete the bookmark"
  ;;
ai-check)
  # ai-check: "ok" when Claude Code is there to use, "no" when it isn't. It only looks
  # for the program, and starts nothing.
  if ai_bin >/dev/null; then
    echo ok
  else
    echo "no"
  fi
  ;;
find)
  # find WORDS: the ids of the articles whose saved text holds all the words, one a
  # line, for the app's search to look past titles. Local: no server, no network.
  [ $# -ge 2 ] || die "usage: $0 find WORDS"
  shift
  [ -d "$read_dir" ] || exit 0
  # Each word must be in a file; words with a quote or a dash first are left out.
  for f in "$read_dir"/*.jsonl; do
    [ -f "$f" ] || continue
    hit=1
    for w in "$@"; do
      grep -qiF -- "$w" "$f" || { hit=0; break; }
    done
    [ "$hit" = 1 ] && basename "$f" .jsonl
  done
  ;;
labels)
  # labels BASE TOKEN: the server's labels and their counts, one a line.
  [ $# -eq 3 ] || die "usage: $0 labels BASE TOKEN"
  curl -fsS --max-time 20 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/labels" > "$cache/readeck-labels.json" || die "couldn't fetch the labels"
  jq -r 'if type == "array" then .[] | "\(.name)\t\(.count // 0)" else empty end' \
    "$cache/readeck-labels.json" 2>/dev/null || true
  ;;
labelrm)
  # labelrm BASE TOKEN NAME: take a label off every bookmark that has it (the bookmarks
  # stay). Readeck has no empty labels: one comes with the first bookmark given it.
  [ $# -eq 4 ] || die "usage: $0 labelrm BASE TOKEN NAME"
  http DELETE "$2/api/bookmarks/labels?name=$(jq -rn --arg v "$4" '$v|@uri')" "$3" "" "couldn't delete the label"
  ;;
status)
  # status BASE TOKEN: what the server says about the token, for "connect".
  # Prints "ok <count>" or "error <the status and its message>".
  [ $# -eq 3 ] || die "usage: $0 status BASE TOKEN"
  resp=$(curl -sS --max-time 15 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    -w '\n%{http_code}' "$2/api/bookmarks?limit=1" 2>&1) || { echo "error couldn't reach $2"; exit 0; }
  code=$(printf '%s' "$resp" | tail -1)
  body=$(printf '%s' "$resp" | sed '$d')
  case "$code" in
    2*) echo "ok $(printf '%s' "$body" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)" ;;
    401 | 403) echo "error ${code} the token isn't accepted" ;;
    *) echo "error ${code} $(printf '%s' "$body" | jq -r '.message // .error // empty' 2>/dev/null | head -1)" ;;
  esac
  ;;
summary)
  # summary ID: a short summary of the article, from Claude Code (which sends the text
  # to Anthropic), kept in
  # $cache/readeck-ai/<id>.summary so it's made once.
  [ $# -eq 2 ] || die "usage: $0 summary ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.summary"
  [ -s "$out_file" ] && { cat "$out_file"; exit 0; }
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  body=$(jq -r '.t' "$src" 2>/dev/null | head -c 12000) || die "couldn't read the article"
  [ -n "$body" ] || die "the article's text is empty"
  ans=$(printf '%s' "$body" | ai 'You are a summariser. The text given to you is one article. Write a summary of it in at most 3 sentences and no more than 70 words: plain prose, no headings, no bullet points, no commentary about the text, no questions, no preamble. Reply with the summary alone.') \
    || die "the AI harness couldn't summarise it"
  ans=$(printf '%s' "$ans" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  [ -n "$ans" ] || die "the AI harness gave nothing back"
  printf '%s\n' "$ans" > "$out_file.tmp" && mv "$out_file.tmp" "$out_file"
  cat "$out_file"
  ;;
pretty)
  # pretty ID: the article's text tidied by Claude Code (sent to Anthropic) — same words, same
  # paragraphs, cast to well-formed sentences — kept in $ai_dir/<id>.pretty as the
  # same JSON lines the reader draws.
  [ $# -eq 2 ] || die "usage: $0 pretty ID"
  id="$2"
  src="$read_dir/$id.jsonl"
  [ -f "$src" ] || die "the article's text isn't saved yet"
  out_file="$ai_dir/$id.pretty"
  [ -s "$out_file" ] && exit 0
  mkdir -p "$ai_dir" || die "couldn't make the AI folder"
  # Long articles go a batch at a time (about 6000 characters), so the answer fits.
  : > "$out_file.tmp"
  batch=; size=0
  tidy() {
    [ -n "$batch" ] || return 0
    ans=$(printf '%s' "$batch" | ai 'You tidy extracted web article text. The input is JSON lines: {"k": kind, "t": text}, where kind is h (heading), p (paragraph), q (quote), li (list item) or fig (caption).

Rewrite each "t" so it reads cleanly: mend sentences broken by extraction, fix stray spaces, doubled punctuation and hyphenation, and use typographic quotes and dashes. Keep the same words and the same meaning: do not summarise, shorten, add or reorder anything. Keep the same kinds and exactly one output line for each input line.

Reply with those JSON lines only, no code fence, no comment.') || return 1
    printf '%s\n' "$ans" | grep -E '^\s*\{' >> "$out_file.tmp"
    batch=; size=0
  }
  while IFS= read -r line; do
    n=${#line}
    if [ $((size + n)) -gt 6000 ] && [ -n "$batch" ]; then
      tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
    fi
    batch="$batch$line
"
    size=$((size + n))
  done < "$src"
  tidy || { rm -f "$out_file.tmp"; die "the AI harness couldn't tidy the article"; }
  # Only trust a tidy that kept the article's shape; otherwise keep the plain text.
  want=$(wc -l < "$src")
  got=$(wc -l < "$out_file.tmp")
  if [ "$got" -lt $((want * 9 / 10)) ]; then
    rm -f "$out_file.tmp"
    die "the AI harness lost lines while tidying ($got of $want)"
  fi
  mv "$out_file.tmp" "$out_file"
  ;;
import-file)
  # import-file FILE: a Readeck export zip, its unzipped folder or a data.jsonl, no
  # server needed.
  [ $# -eq 2 ] || die "usage: $0 import-file FILE"
  import_from "$2"
  ;;
read)
  # read BASE TOKEN ID: one article's text, from the server.
  [ $# -eq 4 ] || die "usage: $0 read BASE TOKEN ID"
  body=$(curl -fsS --max-time 30 -H 'Accept: text/html' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/$(jq -rn --arg v "$4" '$v|@uri')/article") \
    || die "couldn't fetch the article"
  printf '%s' "$body" | extract "$4" -
  ;;
import)
  # import BASE TOKEN: the server's export, made now, read here.
  [ $# -eq 3 ] || die "usage: $0 import BASE TOKEN"
  mkdir -p "$cache"
  curl -fsS --max-time 600 -X POST -H 'Accept: application/zip' \
    -H "Authorization: Bearer $3" -o "$cache/readeck-export.zip" "$2/profile/export" \
    || die "couldn't download the export"
  import_from "$cache/readeck-export.zip"
  ;;
fetch | reload)
  # fetch BASE TOKEN [PAGES]: the library as the server has it now. Each of the list
  # tabs is asked for 100 bookmarks at a time (the most Readeck gives at once), moving
  # on by offset until a page comes back short or the server's Total-Count is reached,
  # and at most PAGES pages a tab (default 50), so a big library isn't cut off at 100.
  [ $# -ge 3 ] || die "usage: $0 fetch|reload BASE TOKEN [PAGES]"
  pages="${4:-50}"
  case "$pages" in ''|*[!0-9]*) die "PAGES must be a number" ;; esac
  mkdir -p "$cache"
  tmp="$cache/readeck-fetch.jsonl"
  hdr="$cache/readeck-fetch.hdr"
  : > "$tmp"
  # What each tab asks for. "all" is everything not archived (unread and read).
  for q in "is_archived=false&read_status=unread" \
           "is_marked=true&is_archived=false" \
           "is_archived=true" \
           "is_archived=false"; do
    page=0
    offset=0
    while [ "$page" -lt "$pages" ]; do
      body=$(curl -fsS --max-time 30 -D "$hdr" -H 'Accept: application/json' -H "Authorization: Bearer $3" \
        "$2/api/bookmarks?$q&limit=100&offset=$offset&sort=-created") \
        || { rm -f "$tmp" "$hdr"; die "couldn't reach the server"; }
      n=$(printf '%s' "$body" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)
      printf '%s' "$body" | jq -c 'if type == "array" then .[] else empty end' >> "$tmp" 2>/dev/null || true
      total=$(grep -i '^total-count:' "$hdr" 2>/dev/null | tr -dc 0-9)
      page=$((page + 1))
      offset=$((offset + 100))
      [ "$n" -lt 100 ] && break
      [ -n "$total" ] && [ "$offset" -ge "$total" ] && break
    done
  done
  rm -f "$hdr"
  # The server's labels, with their counts: not every label is on a fetched bookmark.
  labels=$(curl -fsS --max-time 20 -H 'Accept: application/json' -H "Authorization: Bearer $3" \
    "$2/api/bookmarks/labels") || labels=""
  printf '%s' "$labels" > "$cache/readeck-labels.json" 2>/dev/null || true

  jq -c -s "$normalise" "$tmp" > "$out.tmp" 2>/dev/null || { rm -f "$tmp"; die "couldn't merge the list"; }
  mv "$out.tmp" "$out"
  rm -f "$tmp"
  ;;
*)
  die "usage: $0 fetch|reload|import BASE TOKEN [PAGES] | read BASE TOKEN ID |
       import-file FILE | add BASE TOKEN URL | change BASE TOKEN ID JSON | delete BASE TOKEN ID |
       labels BASE TOKEN | labelrm BASE TOKEN NAME | status BASE TOKEN | find WORDS |
       bulk BASE TOKEN JSON 'ID ID ...' | summary ID | pretty ID | ai-check"
  ;;
esac
READECK_LIB_END
fi
if ! grep -qxF '# owl-readeck-read 1.1' "$bin/owl-readeck-read" 2>/dev/null; then
  cat > "$bin/owl-readeck-read" << 'READECK_READ_END'
#!/usr/bin/env python3
# owl-readeck-read 1.1
# The reader side of the launcher's Readeck app (readeck.owl).
# Turns a Readeck article's HTML (its export's container/index.html, or the
# server's /article endpoint) into the light text the app draws: one element a
# line, "heading: ", "quote: " and "list: " marking what isn't a paragraph, so
# the app needs no HTML of its own.
#
#   owl-readeck-read HTMLFILE OUT    write OUT (JSON lines: {"k": kind, "t": text})
#   owl-readeck-read - OUT           read the HTML from stdin
#
# Kinds: h (heading), p (paragraph), q (quote), li (list item), pre (code), fig.
import json
import re
import sys
from html.parser import HTMLParser

# Elements that end the block being gathered.
BLOCK = {"p", "h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote", "pre",
         "figure", "figcaption", "dt", "dd", "summary", "tr", "div", "section",
         "article", "header", "footer", "ul", "ol", "dl", "table", "br", "hr"}
# Never show these, or their text.
SKIP = {"script", "style", "nav", "aside", "form", "iframe", "svg", "noscript",
        "button", "select", "textarea", "head", "meta", "link", "title"}


class Reader(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks = []
        self.buf = []
        self.want = "p"     # the kind the text being gathered gets
        self.skip = 0       # inside an element we drop
        self.pre = 0        # inside <pre>

    def flush(self):
        text = "".join(self.buf)
        self.buf = []
        if self.pre:
            text = "\n".join(line.rstrip() for line in text.split("\n")).strip("\n")
        else:
            text = re.sub(r"[ \t\r\f\v]+", " ", text)
            text = re.sub(r" *\n *", " ", text)
            text = text.strip()
        if text:
            self.blocks.append({"k": self.want, "t": text})

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip += 1
            return
        if tag in SKIP:
            self.flush()
            self.skip = 1
            return
        if tag in BLOCK:
            self.flush()
            if tag in ("h1", "h2", "h3", "h4", "h5", "h6"):
                self.want = "h"
            elif tag == "li":
                self.want = "li"
            elif tag == "blockquote":
                self.want = "q"
            elif tag in ("figcaption", "dt", "dd", "summary", "pre"):
                self.want = "fig"
            elif tag in ("p", "td", "th"):
                self.want = "p"
        if tag == "pre":
            self.pre += 1

    def handle_startendtag(self, tag, attrs):
        if tag.lower() in BLOCK and not self.skip:
            self.flush()

    def handle_endtag(self, tag):
        tag = tag.lower()
        if self.skip:
            if tag in SKIP:
                self.skip -= 1
            return
        if tag == "pre":
            self.pre = max(0, self.pre - 1)
        if tag in ("h1", "h2", "h3", "h4", "h5", "h6", "li", "blockquote",
                   "figcaption", "dt", "dd", "summary"):
            self.flush()
            self.want = "p"
        elif tag in BLOCK:
            self.flush()

    def handle_data(self, data):
        if not self.skip:
            self.buf.append(data)

    def close(self):
        super().close()
        self.flush()


def main(argv):
    if len(argv) != 3:
        print("usage: owl-readeck-read HTMLFILE|'' OUT", file=sys.stderr)
        return 2
    src, out = argv[1], argv[2]
    try:
        if src in ("", "-"):
            html = sys.stdin.read()
        else:
            with open(src, encoding="utf-8", errors="replace") as f:
                html = f.read()
    except OSError as e:
        print(f"readeck: couldn't read {src}: {e}", file=sys.stderr)
        return 1

    # The article element when there is one, so a page's chrome is left out.
    m = re.search(r"<article\b.*?</article>", html, re.S | re.I)
    if m:
        html = m.group(0)

    reader = Reader()
    reader.feed(html)
    reader.close()
    with open(out, "w", encoding="utf-8") as f:
        for b in reader.blocks:
            f.write(json.dumps(b, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
READECK_READ_END
fi
chmod 755 "$bin/owl-readeck" "$bin/owl-readeck-read"
echo ready""") every 1h

  // Whether the helpers are in place, so nothing else runs until they are.
  source ready = cmd("""test -x "$HOME/.local/bin/owl-readeck" && test -x "$HOME/.local/bin/owl-readeck-read" && echo yes || echo no""") every 10s
  let helpers = trim(ready ?? "") == "yes"

  // The server and an API token from its settings (made in its profile page). Either
  // "readeck.example.org" or "https://readeck.example.org" will do.
  state base = "" persist
  // The server as it's being typed on the setup page; it becomes base on connect, so the
  // token never goes to a half-typed address.
  state typedBase = null
  state token = "" persist
  // As the server is written: the scheme added when it's missing, a trailing / dropped.
  let raw = base == "" ? "" : (contains(base, "://") ? base : "https://" + base)
  let server = endsWith(raw, "/") ? sub(raw, 0, len(raw) - 1) : raw
  // What's on show: a list tab ("unread", "favorite", "archived", "all"), labels, search, or a bookmark.
  state view = "unread" persist
  state label = "" persist
  state query = ""
  state typed = ""
  state readId = ""
  state editing = false
  // Whether the article's text is on show under its details, and not only the page's link.
  state reading = false persist
  // Whether the reader shows the tidied text and the summary (both made by Claude Code,
  // which sends the text to Anthropic, once each), and whether those are being made now.
  state pretty = true persist
  state aiWant = ""
  state newUrl = ""
  // The bookmark a change was for, so its own answer shows beside it.
  state changedId = ""
  // The file imported, so its list can be read again when it changes.
  state imported = null
  // Bumped by connect and by "fetch", which fetches the list; 0 means no fetch.
  state fetchN = 0 persist
  // A change to send, in pieces the command can quote one by one: what to do, the
  // JSON for it (empty for the label and link ones) and the bookmarks it's for.
  state todoMode = ""
  state todoJson = ""
  state todoIds = []
  // The script's own words when a change failed, so a tap that didn't work says why.
  state lastErr = ""
  // How the list is ordered and grouped: "-created" (newest), "created", "title",
  // "length" (longest read) or "shortest"; and "", "day", "site" or "label".
  state sort = "-created" persist
  state group = "" persist
  // The reader's text size, in points, and where you got to in each article (a map
  // from its id to a paragraph number), kept so an article opens where you left it.
  state textSize = 16 persist
  // [{id, i}] — how far into each article you got, so it opens where you left it.
  state where = [] persist
  // Whether taps pick bookmarks for a bulk change, and which are picked.
  state picking = false
  state picked = []
  // A "delete" waiting for a second tap, by id; a label's × that needs one too.
  state confirmId = ""
  state confirmLabel = ""
  state connectMsg = ""
  // Copied or shared, to say so.
  state said = ""
  // A change to give every picked bookmark; sending it clears the pick.
  state bulkFor = ""
  // Whether "test the token" is asking now, so the command runs once and says its answer.
  state connectCheck = false
  // The time of the last list fetched, and whether it worked.
  state synced = 0 persist

  // The library the helper writes: one bookmark per line.
  source lib = file("~/.cache/omalauncher/readeck.jsonl")
  // For "3d" beside a date.
  source now = clock every 1m

  // Fetches the server's list every 15 minutes, and at once whenever `fetchN` goes up:
  // "connect", "sync now" and a change that worked (it is in the command, and owl runs a
  // command again as soon as what it reads changes). It also runs once when the app
  // opens, so a reconnect needs no tap at all.
  source fetched = cmd(!helpers || server == "" || token == "" ? "echo waiting" : "n=${int(fetchN)}; owl-readeck fetch ${sh(server)} ${sh(token)} 50 >/dev/null 2>&1 && echo done || echo failed") every 15m timeout 120s
  // Saves and changes go through the helper too: a tap sets todoMode, todoJson and
  // todoIds, and the source runs it (an empty todoMode does nothing).
  source ran = cmd(
    !helpers || todoMode == "" ? "echo idle"
    : todoMode == "change" ? "owl-readeck change ${sh(server)} ${sh(token)} ${sh(first(todoIds) ?? "")} ${sh(todoJson)} && echo ok || echo failed"
    : todoMode == "bulk" ? "owl-readeck bulk ${sh(server)} ${sh(token)} ${sh(todoJson)} ${sh(join(todoIds, " "))} && echo ok || echo failed"
    : todoMode == "add" ? "owl-readeck add ${sh(server)} ${sh(token)} ${sh(first(todoIds) ?? "")} && echo ok || echo failed"
    : todoMode == "labelrm" ? "owl-readeck labelrm ${sh(server)} ${sh(token)} ${sh(first(todoIds) ?? "")} && echo ok || echo failed"
    : "echo idle") every 1m timeout 120s
  // "test the token" on the setup page: the script asks the server what it makes of it.
  source checked = cmd(!helpers || !connectCheck ? "echo" : "owl-readeck status ${sh(server)} ${sh(token)} | sed -e 's/^ok .*/ok/' -e 's/^error /error: /'") every 1m
  on checked {
    if value != "" && value != "checking…" {
      connectMsg = value == "ok" ? "the token works" : sub(value, 0, 70)
      connectCheck = false
    }
  }
  // When the list last came in, for the line above it: the first value counts too, so a
  // sync that worked as the app opened is noted.
  on fetched first {
    synced = value == "done" ? now : synced
  }
  on fetched {
    synced = value == "done" ? now : synced
  }

  // The article's text, as the reader draws it (owl-readeck-read, through the script):
  // one element a line, {k, t}. Opening an article fetches it once (from the server, or
  // from an imported export) and keeps it on disk, so it reads offline afterwards.
  source article = file("~/.cache/omalauncher/readeck-read/${readId}.jsonl")
  let plain = lines(article).map(l => parseJson(l)).filter(p => p != null)

  // Claude Code, when it's installed, for a summary and for tidying the text. It is not
  // local: it sends the article's text to Anthropic, on the user's Claude account, and
  // only when a button asks. Both are made once per article and kept, and neither is
  // needed to read. The check only looks for the program.
  source aiCheck = cmd(!helpers ? "echo no" : "owl-readeck ai-check 2>/dev/null || echo no") every 15m
  let aiOk = startsWith(aiCheck ?? "", "ok")
  // The harness's name, for the buttons and the line saying where the text goes.
  let aiName = "Claude Code"
  // What the harness made of this article: a summary, and the tidied text.
  source madeSummary = file("~/.cache/omalauncher/readeck-ai/${readId}.summary")
  source madePretty = file("~/.cache/omalauncher/readeck-ai/${readId}.pretty")
  let summary = trim(madeSummary ?? "")
  let prettied = lines(madePretty).map(l => parseJson(l)).filter(p => p != null)
  let para = pretty && len(prettied) > 0 ? prettied : plain
  let needle = lower(trim(query))
  // The articles whose own text holds the search's words: the script looks through the
  // text it saved (no shell tools beyond grep), and says which ids match.
  source textHits = cmd(!helpers || needle == "" ? "echo" : "owl-readeck find ${sh(needle)}") every 1m
  let hits = lines(textHits).filter(l => l != "")

  // The AI work runs when a button asks for it ("summary ID", "pretty ID"), not on its
  // own: a shell command that only becomes real once the article's text is there.
  // Two values, each its own shell word: "summary" or "pretty", and the article's id.
  let aiMode = first(split(aiWant, " "))
  let aiId = last(split(aiWant, " "))
  source aiRan = cmd(!helpers || trim(aiWant ?? "") == "" ? "echo idle" : "owl-readeck ${sh(aiMode)} ${sh(aiId)} >/dev/null 2>&1 && echo ok || echo failed") every 1m timeout 300s
  // A run cut off by its timeout comes back empty: dropped too, so it isn't sent again every minute.
  on aiRan {
    if value == "ok" || value == "failed" || value == "" { aiWant = "" }
  }

  // Off the server, or from the export (importing one writes its articles' text too).
  source got = cmd(!helpers || readId == "" ? "echo idle" : "owl-readeck read ${sh(server)} ${sh(token)} ${sh(readId)} >/dev/null 2>&1; echo done") every 5m

  // Each bookmark as one text line, so a broken one can't hide the rest: id, title, url,
  // site, favorite, archived, progress (null without it in the export), labels, and what
  // its page shows: description, authors, language, length, date, pictures.
  let all = range(len(lines(lib))).filter(i => parseJson(lines(lib)[i]) != null).map(i => parseJson(lines(lib)[i])).filter(b => b.id != null && b.is_deleted != true).map(b => {id: "${b.id}", title: b.title ?? "", url: b.url ?? "", site: b.site_name ?? "", fav: b.is_marked == true, arch: b.is_archived == true, prog: b.read_progress, labels: join(b.labels ?? [], ", "), note: b.note ?? "", desc: b.description ?? "", authors: join(b.authors ?? [], ", "), lang: b.lang ?? "", mins: b.reading_time, words: b.word_count, when: b.published ?? b.created, added: b.created, icon: b.site_icon ?? "", thumb: b.thumbnail ?? b.image ?? ""})

  let item = all.find(b => b.id == readId) ?? {}
  // The tab's bookmarks, then the label picked, then the words searched for.
  let tabbed = all.filter(b => view == "favorite" ? b.fav : view == "archived" ? b.arch : view == "unread" ? b.prog != 100 && !b.arch : !b.arch)
  let filtered = tabbed.filter(b =>
    (label == "" || contains(lower(", " + b.labels + ","), ", " + lower(label) + ",")) &&
    (needle == "" || contains(lower(b.title + " " + b.site + " " + b.labels + " " + b.url + " " + b.desc + " " + b.authors + " " + (hits.any(id => id == b.id) ? "text" : "")), needle)))
  let seen = (sort == "title" ? filtered.sortBy(b => lower(b.title))
    : sort == "length" ? filtered.sortBy(b => -(b.mins ?? 0))
    : sort == "shortest" ? filtered.sortBy(b => b.mins ?? 9999)
    : sort == "created" ? filtered.sortBy(b => b.added ?? "")
    : filtered.sortBy(b => "" + (b.when ?? "")))
    .reverse()
  // The rows to draw: a header when grouped, then the items under it.
  let rows = seen.map(b => {h: group == "day" ? fmtTime(parseTime(b.when ?? b.added), "d MMM yyyy")
    : group == "site" ? b.site
    : group == "label" ? (first(split(b.labels, ", ")) ?? "no label")
    : "", b: b})
  let counted = {unread: all.count(b => b.prog != 100 && !b.arch), favorite: all.count(b => b.fav && !b.arch), archived: all.count(b => b.arch), all: all.count(b => !b.arch)}
  // How long the queue is to read, in minutes, said as "2h 5m" or "39m".
  let queue = all.filter(b => b.prog != 100 && !b.arch).map(b => b.mins ?? 0)
  let queueMin = sum(queue)
  let queueText = queueMin >= 60 ? "${floor(queueMin / 60)}h ${round(queueMin % 60)}m" : "${round(queueMin)}m"
  // Every label: the bookmarks' own, and the server's list (so unused ones show too).
  source serverLabels = file("~/.cache/omalauncher/readeck-labels.json")
  let labelNames = unique((flatten(all.map(b => split(b.labels, ", "))) + (parseJson(serverLabels) ?? []).map(l => l.name ?? "")).filter(l => l != "")).sortBy(l => lower(l))
  let labels = labelNames.map(l => {name: l, count: all.count(b => contains(lower(", " + b.labels + ","), ", " + lower(l) + ","))})
  let offline = server == "" || token == ""
  // What the last change got back: "ok" from the script or "failed", then why.
  let saved = ran == "ok" ? "saved" : ran == "failed" ? (lastErr == "" ? "couldn't do it" : lastErr) : ""

  // A fetch that worked clears the last message.
  on fetched first {
    if value == "done" { todoMode = "" }
  }
  // A change to give every picked bookmark goes out as one command of its own: a button
  // sets `bulkFor` to the change, and this sends it to each pick, keeping the first error.
  on bulkFor first {
    if value != "" && picked != [] {
      // The picks go into the change before the pick is cleared.
      todoIds = picked
      todoJson = value
      todoMode = "bulk"
      bulkFor = ""
      picked = []
      picking = false
      changedId = ""
    }
  }
  // A change that worked brings the list up to date; one that failed says why, in the
  // script's own words (read back from its error file).
  on ran {
    if value == "ok" {
      lastErr = ""
      said = ""
      todoMode = ""
      fetchN = fetchN + 1
    } else if value == "failed" {
      lastErr = first(lines(fileErr)) ?? "couldn't do it"
      todoMode = ""
    } else if value == "" {
      lastErr = "the server took too long"
      todoMode = ""
      fetchN = fetchN + 1
    }
  }
  source fileErr = file("~/.cache/omalauncher/readeck-last.err")

  component Tab(name, count) {
    Column {
      weight: 1
      gap: 2
      padding: [6, 8]
      radius: 8 * corners
      align: center
      background: view == name && label == "" ? alpha(foreground, 0.10) : null
      onTap: { view = name; label = ""; typed = ""; haptic() }
      Text { text: name; style: small; align: center; maxLines: 1; bold: view == name && label == ""; color: view == name && label == "" ? foreground : muted }
      Text { text: count > 999 ? "${floor(count / 1000)}k" : "${count}"; style: label; align: center; color: muted }
    }
  }

  // An entry in the list: the site's icon and the story's picture, its title, the site
  // and labels, how long a read it is and how old, and a tick when it's picked for a
  // bulk change. Tapping opens it; the button at its end archives or unarchives it,
  // which is the one change worth a single tap from the list (it is reversible).
  component Entry(b) {
    Row {
      gap: 10
      align: top
      padding: [10, 9]
      radius: 8 * corners
      background: picked.any(id => id == b.id) ? alpha(accent, 0.12) : alpha(foreground, 0.04)
      onTap: {
        if picking {
          picked = picked.any(id => id == b.id) ? picked.filter(id => id != b.id) : picked + [b.id]
        } else {
          readId = b.id
          editing = false
          confirmId = ""
          reading = true
          haptic()
          if b.prog != 100 { changedId = b.id; todoMode = "change"; todoJson = "{\"read_progress\":100}"; todoIds = [b.id] }
        }
      }
      Box {
        width: 6
        height: 52
        radius: 3
        background: b.fav ? orange : b.prog == 100 ? alpha(muted, 0.4) : accent
      }
      Column {
        weight: 1
        gap: 4
        Text { text: b.title; maxLines: 3 }
        Row {
          gap: 6
          align: center
          if b.icon != "" {
            Box { width: 14; height: 14; Image { src: b.icon; fill: true; fit: contain } }
          }
          // A width, not a weight: beside a sized Box a weighted Text is squeezed to nothing.
          Text { text: b.site; style: small; color: muted; maxLines: 1; width: 150 }
          Spacer { weight: 1 }
          if b.mins != null {
            Text { text: "${b.mins} min"; style: label; color: muted; maxLines: 1; width: 46; align: end }
          }
          if b.when != null {
            Text { text: fmtAgo(parseTime(b.when), now); style: label; color: muted; maxLines: 1; width: 40; align: end }
          }
        }
        // The authors when they're not just the site's name; else the labels.
        if b.authors != "" && b.authors != b.site {
          Text { text: b.authors; style: label; color: muted; maxLines: 1 }
        } else if b.labels != "" {
          Text { text: b.labels; style: label; color: accent; maxLines: 1 }
        }
      }
      if b.thumb != "" {
        Box { width: 76; height: 52; radius: 6 * corners; clip: true; Image { src: b.thumb; fill: true; fit: cover } }
      } else if b.fav {
        Text { text: "★"; color: orange; width: 20; align: end; maxLines: 1 }
      }
      // Archive, or bring one back: a tap here, not on the row, so it never opens the
      // bookmark. It says what it did beside the row until the list is fetched again.
      // Archive, or bring one back: a box on the row's end, away from its text so a
      // tap here never opens the bookmark. A picture in the row leaves no room for
      // the word, so there it is one glyph; the title keeps the width either way.
      Box {
        width: b.thumb != "" ? 40 : 62
        height: 40
        align: center
        radius: 6 * corners
        background: changedId == b.id && !picking ? alpha(accent, 0.18) : alpha(foreground, 0.06)
        onTap: {
          changedId = b.id
          todoMode = "change"
          todoJson = b.arch ? "{\"is_archived\":false}" : "{\"is_archived\":true}"
          todoIds = [b.id]
          haptic()
        }
        Text {
          text: b.arch ? "↺" : "⌸"
          fontSize: 15
          color: b.arch ? muted : accent
          align: center
          maxLines: 1
        }
      }
      if picked.any(id => id == b.id) {
        Text { text: "✓"; color: accent; width: 20; align: end; maxLines: 1 }
      } else if b.thumb != "" && b.fav {
        Text { text: "★"; color: orange; width: 16; align: end; maxLines: 1 }
      }
    }
  }

  component List(rows, loading) {
    Column {
      scroll: true
      weight: 1
      gap: 6
      padding: [4, 8, 12, 8]
      if loading {
        // The first run, and until something is there: both ways in, whichever fits.
        Column {
          gap: 8
          padding: [8, 4]
          Text { text: offline ? "Nothing to read yet." : "Fetching your bookmarks…"; style: body; color: muted }
          if offline {
            Text { text: "Point the app at your Readeck server, and its API token, to fetch your library. Or import an export of it, to read offline."; style: small; color: muted }
            Button { text: "connect a server"; color: accent; onTap: { view = "setup"; haptic() } }
          } else {
            Text { text: "The app's library is empty. Fetch the list, or import an export of yours."; style: small; color: muted }
            Button { text: "fetch now"; color: muted; onTap: { fetchN = fetchN + 1; haptic() } }
          }
          Text { text: "Import an export: the zip, or the folder it unzips to"; style: label; color: muted }
          Input { placeholder: "/path/to/readeck-export.zip"; onSubmit: { imported = run("owl-readeck import-file ${sh(value)}") } }
        }
      }
      if !loading && len(rows) == 0 {
        Text { text: needle == "" ? "nothing here" : "nothing found"; color: muted; style: small; padding: [8, 4] }
      }
      for r, i in rows key r.b.id {
        if r.h != "" && (i == 0 || rows[i - 1].h != r.h) {
          Text { text: r.h; style: label; color: muted; padding: [10, 4, 2, 4] }
        }
        Entry { b: r.b }
      }
      Spacer { height: screenInset }
    }
  }

  Column {
    fill: true
    gap: 0

    if readId != "" && len(all) > 0 {
      // One bookmark.
      Column {
        scroll: true
        fill: true
        gap: 10
        padding: [12, 8]
        // The story's own picture, full width, when its page has one.
        if item.thumb != "" {
          Box { fill: width; height: 190; radius: 8 * corners; clip: true; Image { src: item.thumb; fill: true; fit: cover } }
        }
        Text { text: item.title; style: title; maxLines: 4 }
        // Who wrote it, where, when, and how long a read: the page's own facts.
        Row {
          gap: 6
          align: center
          if item.icon != "" {
            Box { width: 14; height: 14; Image { src: item.icon; fill: true; fit: contain } }
          }
          Text { text: item.site; style: small; color: muted; maxLines: 1; width: 130 }
          Spacer { weight: 1 }
          if item.when != null {
            Text { text: fmtTime(parseTime(item.when), "d MMM yyyy"); style: label; color: muted; maxLines: 1 }
          }
        }
        Text { text: "${item.authors}${item.authors != "" && item.mins != null ? " · " : ""}${item.mins != null ? "${item.mins} min" : ""}${item.words != null ? " · ${fmtNum(item.words)} words" : ""}${item.lang != "" ? " · ${upper(item.lang)}" : ""}"; style: label; color: muted; maxLines: 2; visible: item.authors != "" || item.mins != null || item.words != null }
        // A summary by Claude Code (the text went to Anthropic): made once, kept beside the article.
        if summary != "" {
          Column {
            gap: 4
            padding: [8, 10]
            radius: 6 * corners
            background: alpha(accent, 0.09)
            Row {
              gap: 6
              align: center
              Text { text: "summary"; style: label; color: accent; width: 80 }
              Text { text: "made by ${aiName} · text sent to Anthropic"; style: label; color: muted; maxLines: 1 }
            }
            Text { text: summary; style: body; fontSize: textSize }
          }
        } else if item.desc != "" {
          // The page's own summary, in italic, like a standfirst.
          Text { text: item.desc; style: body; italic: true; color: muted; padding: [2, 0] }
        }
        // The AI's buttons: a summary if there isn't one, and the text tidied or plain.
        if aiOk && len(plain) > 0 {
          Text { text: "${aiName} sends this article's text to Anthropic."; style: small; color: muted }
          Row {
            gap: 6
            wrap: true
            if summary == "" {
              Button { text: aiWant == "summary " + item.id ? "summarising…" : "summarise (${aiName})"; color: accent; onTap: { aiWant = "summary " + item.id; haptic() } }
            }
            // Tidied (the AI's) or as it came (the page's own words).
            Button {
              text: len(prettied) == 0 ? (aiWant == "pretty " + item.id ? "tidying…" : "tidy the text (${aiName})") : pretty ? "tidied text" : "tidy the text (${aiName})"
              color: pretty && len(prettied) > 0 ? foreground : muted
              onTap: {
                if len(prettied) > 0 {
                  pretty = !pretty
                } else if aiWant == "" {
                  aiWant = "pretty " + item.id
                }
                haptic()
              }
            }
            if len(prettied) > 0 {
              Button { text: "as it came"; color: pretty ? muted : foreground; onTap: { pretty = false; haptic() } }
            }
          }
          if aiWant == "pretty " + item.id {
            Text { text: "tidying the text with ${aiName} (sent to Anthropic)…"; style: small; color: muted }
          }
        }
        Text { text: "${item.url}"; style: small; color: muted; maxLines: 2 }
        Flow {
          gap: 6
          for l in split(item.labels, ", ").filter(l => l != "" ) key l {
            Text { text: l; style: label; color: accent; padding: [4, 6]; width: null; radius: 4 * corners; background: alpha(accent, 0.14) }
          }
        }
        Row {
          gap: 6
          wrap: true
          Button { text: reading ? "hide the text" : "read here"; color: reading ? muted : accent; onTap: { reading = !reading; haptic() } }
          Button { text: "open the article"; onTap: url(item.url) }
        }
        // The reader: the article's text, as the script pulled it out of its page, at the
        // size chosen, opened where you stopped last time.
        if reading {
          Column {
            gap: 8
            padding: [4, 0]
            if len(para) == 0 {
              Text { text: offline ? "This article's text isn't saved. Import an export of your library to read it here." : "Fetching the article…"; style: small; color: muted }
            } else {
              Row {
                gap: 6
                align: center
                Text { text: "${len(para)} parts"; style: label; color: muted; width: 90 }
                Text { text: "A-"; style: small; color: muted; padding: [4, 6]; width: 40; align: end; onTap: { textSize = clamp(textSize - 2, 12, 26); haptic() } }
                Text { text: "${textSize}"; style: label; color: muted; width: 34; align: center }
                Text { text: "A+"; style: body; color: muted; padding: [4, 6]; width: 40; onTap: { textSize = clamp(textSize + 2, 12, 26); haptic() } }
              }
            }
            for p, i in para key i {
              if p.k == "h" {
                // a section heading: larger than the text, but not a page title
                Text { text: p.t; style: body; bold: true; fontSize: textSize + 3; padding: [12, 0, 2, 0] }
              } else if p.k == "q" {
                Text { text: p.t; style: body; fontSize: textSize; italic: true; color: muted; padding: [4, 10]; radius: 4 * corners; background: alpha(foreground, 0.05) }
              } else if p.k == "li" {
                Row {
                  gap: 6
                  Text { text: "•"; style: body; fontSize: textSize; color: muted; width: 10 }
                  Text { text: p.t; style: body; fontSize: textSize; weight: 1 }
                }
              } else if p.k == "fig" {
                Text { text: p.t; style: small; color: muted; padding: [4, 0] }
              } else {
                Text { text: p.t; style: body; fontSize: textSize; padding: [2, 0] }
              }
            }
            // Where you got to: kept per article, so the next open starts here.
            Row {
              gap: 8
              align: center
              let at = find(where, w => w.id == readId) ?? {id: readId, i: 0}
              Text { text: "you're at ${at.i + 1} of ${len(para)}"; style: label; color: muted; width: 150; visible: at.i > 0 }
              Spacer { weight: 1 }
              Button { text: "next part"; color: muted; onTap: { where = where.filter(w => w.id != readId) + [{id: readId, i: min(at.i + 1, len(para) - 1)}]; haptic() } }
            }
            Spacer { height: 8 }
          }
        }
        if editing {
          Text { text: "title"; style: label; color: muted }
          Input { text: item.title; onSubmit: { changedId = item.id; todoMode = "change"; todoJson = "{\"title\":" + toJson(value) + "}"; todoIds = [item.id] } }
          Text { text: "labels, comma separated"; style: label; color: muted }
          Input { text: item.labels; onSubmit: { changedId = item.id; let ls = split(value, ",").map(s => trim(s)).filter(s => s != ""); todoMode = "change"; todoJson = "{\"labels\":" + toJson(ls) + "}"; todoIds = [item.id] } }
          Text { text: "your note"; style: label; color: muted }
          Input { text: item.note; placeholder: "a note about this one…"; onSubmit: { changedId = item.id; todoMode = "change"; todoJson = "{\"note\":" + toJson(value) + "}"; todoIds = [item.id] } }
          // Where you are in it, by hand.
          Text { text: "read ${item.prog ?? 0}%"; style: label; color: muted }
          Slider {
            value: item.prog ?? 0
            max: 100
            step: 5
            color: accent
            onChange: { changedId = item.id; todoMode = "change"; todoJson = "{\"read_progress\":" + "${int(value)}" + "}"; todoIds = [item.id] }
          }
        }
        Row {
          gap: 8
          wrap: true
          Button { text: item.fav ? "★ favorite" : "☆ favorite"; color: item.fav ? orange : muted; onTap: { changedId = item.id; todoMode = "change"; todoJson = "{\"is_marked\":" + toJson(!item.fav) + "}"; todoIds = [item.id] } }
          Button { text: item.arch ? "unarchive" : "archive"; color: muted; onTap: { changedId = item.id; todoMode = "change"; todoJson = "{\"is_archived\":" + toJson(!item.arch) + "}"; todoIds = [item.id] } }
          if item.prog == 100 {
            Button { text: "mark unread"; color: muted; onTap: { changedId = item.id; todoMode = "change"; todoJson = "{\"read_progress\":0}"; todoIds = [item.id] } }
          } else {
            Button { text: "mark read"; color: muted; onTap: { changedId = item.id; todoMode = "change"; todoJson = "{\"read_progress\":100}"; todoIds = [item.id] } }
          }
          Button { text: editing ? "close edit" : "edit"; color: muted; onTap: editing = !editing }
          // Delete asks once more, then goes.
          Button {
            text: confirmId == item.id ? "really delete?" : "delete"
            color: red
            onTap: {
              if confirmId == item.id {
                confirmId = ""
                changedId = item.id
                todoMode = "change"
                todoJson = "{\"is_deleted\":true}"
                todoIds = [item.id]
                if readId == item.id { readId = "" }
              } else {
                confirmId = item.id
                haptic()
              }
            }
          }
        }
        // A link to keep: on the clipboard, or to another app.
        Row {
          gap: 8
          wrap: true
          Button { text: "copy link"; color: muted; onTap: { copy(item.url); said = "link copied"; haptic() } }
          Button { text: "share"; color: muted; onTap: { share(item.title + " " + item.url); haptic() } }
        }
        if said != "" {
          Text { text: said; style: label; color: green }
        }
        if changedId == item.id {
          Text { text: saved == "" ? ran : saved; style: small; color: saved == "saved" ? green : red }
        }
        if item.note != "" {
          Text { text: "note"; style: label; color: muted }
          Text { text: item.note; style: body; padding: [4, 8]; radius: 6 * corners; background: alpha(foreground, 0.04) }
        }
        if item.prog == 100 { Text { text: "read"; style: small; color: muted } }
        if item.arch { Text { text: "archived"; style: small; color: muted } }
      }
    } else {
      // The list: what's copied is a link to save.
      Column {
        fill: true
        gap: 0
        if view == "labels" {
          Column {
            scroll: true
            weight: 1
            padding: [8, 8]
            gap: 2
            Text { text: "${len(labels)} labels"; style: label; color: muted; padding: [0, 4] }
            // Readeck has no empty labels: one comes with the first bookmark given it, in that
            // bookmark's edit. The × takes a label off every bookmark (asks twice).
            Text { text: "A label is added to a bookmark, in its edit."; style: small; color: muted; padding: [0, 4, 6, 4] }
            for l in labels key l.name {
              Row {
                gap: 10
                padding: [12, 8]
                radius: 6 * corners
                background: label == l.name ? alpha(accent, 0.14) : null
                onTap: { label = l.name; typed = ""; query = ""; haptic() }
                Text { text: l.name; maxLines: 1; weight: 1; color: label == l.name ? accent : foreground }
                Text { text: "${l.count}"; style: small; color: muted; width: 44; align: end; maxLines: 1 }
                Text {
                  text: confirmLabel == l.name ? "sure?" : "×"
                  style: small
                  color: red
                  padding: [2, 8]
                  onTap: {
                    if confirmLabel == l.name {
                      confirmLabel = ""
                      todoMode = "labelrm"
                      todoIds = [l.name]
                    } else {
                      confirmLabel = l.name
                      haptic()
                    }
                  }
                }
              }
            }
            Spacer { height: screenInset }
          }
                } else if view == "setup" {
          // The server's address and a token from its Settings → API tokens.
          Column {
            scroll: true
            weight: 1
            padding: [12, 8]
            gap: 8
            Text { text: "Readeck server"; style: label; color: muted }
            Input { text: typedBase ?? base; placeholder: "readeck.example.org"; onChange: typedBase = trim(value); onSubmit: { base = trim(value); typedBase = null } }
            Text { text: "In your Readeck, Settings → API tokens makes one for this app. Paste it here."; style: small; color: muted }
            Input { text: token; placeholder: "API token"; onChange: token = trim(value); onSubmit: token = trim(value) }
            Row {
              gap: 8
              wrap: true
              Button { text: "connect"; onTap: { base = trim(typedBase ?? base); typedBase = null; token = trim(token); view = "unread"; fetchN = fetchN + 1; haptic() } }
              Button { text: "test the token"; color: muted; onTap: { base = trim(typedBase ?? base); typedBase = null; connectMsg = "checking…"; connectCheck = true; haptic() } }
            }
            if connectMsg != "" {
              Text { text: connectMsg; style: small; color: startsWith(connectMsg, "ok") ? green : red }
            }
            Spacer { height: 8 }
            Text { text: "Without a server, an export of your library works on its own: import it from the Readeck web app (Settings → Export), and the app reads it offline."; style: small; color: muted }
            Button { text: "back"; color: muted; onTap: view = "unread" }
          }
        } else if view == "search" {
          Column {
            padding: [8, 8, 6, 8]
            Row {
              gap: 8
              Input { text: typed; placeholder: "title, site, label or words in the text"; focus: true; weight: 1; onChange: typed = value; onSubmit: query = value }
              Button { text: "find"; onTap: { query = typed; haptic() } }
            }
          }
          List { rows: rows; loading: len(all) == 0 }
        } else {
          Row {
            padding: [4, 8]
            for t in ["unread", "favorite", "archived", "all"] key t {
              Tab { name: t; count: counted[t] ?? 0 }
            }
          }
          // How fresh the list is, and what went wrong when something did.
          Row {
            gap: 8
            align: center
            padding: [0, 10, 0, 10]
            Text { text: offline ? "no server: reading an imported export" : synced == 0 ? "not synced yet" : (startsWith(fmtAgo(synced, now), "in ") ? "sync ${fmtAgo(synced, now)}" : fmtAgo(synced, now) == "now" ? "synced just now" : "synced ${fmtAgo(synced, now)} ago"); style: label; color: muted; width: 250; maxLines: 1 }
            if !offline {
              Text { text: "sync now"; style: label; color: accent; padding: [4, 4]; onTap: { fetchN = fetchN + 1; haptic() } }
            }
          }
          if lastErr != "" && changedId == "" {
            Text { text: saved == "" ? lastErr : saved; style: label; color: red; padding: [0, 10]; maxLines: 2 }
          }
          // What the queue amounts to, and how the list is ordered and grouped. The
          // widths add up to less than the screen, so the row fits on one line.
          Row {
            gap: 4
            padding: [0, 8, 4, 8]
            Text { text: queue == [] ? "nothing to read" : "${len(queue)} · ${queueText}"; style: label; color: muted; width: 110; maxLines: 1 }
            Text { text: sort == "-created" ? "newest" : sort == "created" ? "oldest" : sort == "title" ? "title" : sort == "length" ? "longest" : "shortest"; style: label; color: accent; padding: [4, 4]; width: 76; maxLines: 1; onTap: { sort = sort == "-created" ? "created" : sort == "created" ? "title" : sort == "title" ? "length" : sort == "length" ? "shortest" : "-created"; haptic() } }
            Text { text: group == "" ? "no group" : group; style: label; color: group == "" ? muted : accent; padding: [4, 4]; width: 84; maxLines: 1; onTap: { group = group == "" ? "day" : group == "day" ? "site" : group == "site" ? "label" : ""; haptic() } }
            Text { text: picking ? (picked == [] ? "picking" : "${len(picked)} picked") : "select"; style: label; color: picking ? orange : muted; padding: [4, 4]; width: 84; maxLines: 1; onTap: { picking = !picking; picked = []; haptic() } }
          }
          // What's picked, acted on together.
          if picking {
            Row {
              gap: 6
              wrap: true
              padding: [0, 10, 6, 10]
              Button { text: "archive"; color: muted; onTap: bulkFor = "{\"is_archived\":true}" }
              Button { text: "unarchive"; color: muted; onTap: bulkFor = "{\"is_archived\":false}" }
              Button { text: "favorite"; color: orange; onTap: bulkFor = "{\"is_marked\":true}" }
              Button { text: "unread"; color: muted; onTap: bulkFor = "{\"read_progress\":0}" }
              Button { text: "read"; color: muted; onTap: bulkFor = "{\"read_progress\":100}" }
              Button { text: "delete"; color: red; onTap: bulkFor = "{\"is_deleted\":true}" }
              Button { text: "done"; color: muted; onTap: { picking = false; picked = [] } }
            }
          }
          // A link to save; without a server, where to put one.
          if offline {
            Row {
              gap: 8
              padding: [2, 10, 8, 10]
              align: center
              // A tap text, not a Button: a Button makes its whole row tall.
              Text { text: token == "" ? "no token set" : server == "" ? "no server set" : ""; style: small; color: muted; width: 250 }
              Text { text: "connect"; style: label; color: accent; padding: [4, 4]; onTap: { view = "setup"; haptic() } }
            }
          } else {
            Row {
              gap: 8
              padding: [2, 8, 8, 8]
              align: center
              Input { text: newUrl; placeholder: "save a link…"; weight: 1; onSubmit: { todoMode = "add"; todoIds = [newUrl]; newUrl = "" } }
              Button { text: "save"; onTap: { todoMode = "add"; todoIds = [newUrl] } }
            }
          }
          if label != "" {
            Row {
              padding: [0, 10, 6, 10]
              gap: 8
              align: center
              Text { text: "label: ${label}"; style: small; color: accent; maxLines: 1 }
              Text { text: "×"; color: muted; padding: [4, 6]; onTap: label = "" }
            }
          }
          if saved != "" {
            Text { text: saved; style: label; color: saved == "saved" ? green : red; padding: [0, 10, 4, 10] }
          }
          List { rows: rows; loading: len(all) == 0 }
        }
      }
    }
  }
}
