BULLET_SPEED = 620
ENEMY_BULLET_SPEED = 410
ENEMY_REACTION = .32
HIT_RADIUS = 9

def segment_hit(a, b, center, radius=HIT_RADIUS):
    delta = b-a
    t = max(0, min(1, (center-a).dot(delta)/delta.length_squared())) if delta.length_squared() else 0
    return (a+delta*t).distance_squared_to(center) <= radius*radius

def intercept(origin, target, velocity, speed=BULLET_SPEED):
    # Solve |target + velocity*t - origin| = bullet_speed*t.
    d = target-origin
    a = velocity.length_squared()-speed**2
    b = 2*d.dot(velocity)
    c = d.length_squared()
    disc = b*b-4*a*c
    times = [t for t in ((-b+math.sqrt(max(0,disc)))/(2*a),
                         (-b-math.sqrt(max(0,disc)))/(2*a)) if t>0] if abs(a)>1e-8 and disc>=0 else []
    t = min(times) if times else d.length()/speed
    aim = d+velocity*min(t,.5)
    return aim.normalize() if aim.length_squared() else V(0,-1)

def route(a,b,blocked=()):
    '''3-pixel navigation mesh with diagonal corner checks for the small rooms.'''
    def cell(p): return round(p[0]/3),round(p[1]/3)
    graph=navigation(blocked)
    def valid(c): return c in graph
    start,goal=cell(a),cell(b)
    if not valid(start):
        near=[c for c in graph if abs(c[0]-start[0])<=2 and abs(c[1]-start[1])<=2]
        if not near:return []
        start=min(near,key=lambda c:math.dist(c,cell(a)))
    if not valid(goal):
        near=[(goal[0]+x,goal[1]+y) for x in range(-2,3) for y in range(-2,3)]
        near=[c for c in near if valid(c)]
        if not near:return []
        goal=min(near,key=lambda c:(c[0]*3-b[0])**2+(c[1]*3-b[1])**2)
    queue=[(0,start)]; costs={start:0}; prev={}
    while queue:
        _,cur=heapq.heappop(queue)
        if cur==goal:
            path=[]
            while cur!=start:
                path.append(V(cur[0]*3,cur[1]*3));cur=prev[cur]
            return path[::-1]
        for nxt,step_cost in graph.get(cur,[]):
            cost=costs[cur]+step_cost
            if cost < costs.get(nxt,1e10):
                costs[nxt]=cost;prev[nxt]=cur
                heapq.heappush(queue,(cost+math.dist(nxt,goal),nxt))
    return []

class Game:
    def __init__(self):
        self.best=None
        self.auto_fire=True;self.shot_interval=.55
        self.reset()
    def reset(self):
        self.p=V(START);self.aim=V(-1,0);self.dead=False;self.won=False;self.entered=False;self.upper_open=False
        self.elapsed=0;self.cooldown=0;self.reload=0;self.ammo=12;self.flash=0
        self.shots=[];self.bodies=[];self.score=0;self.combo=0;self.combo_time=0
        self.velocity=V();self.trigger_held=False;self.lock_target=None;self.lock_time=0
        self.enemies=[dict(p=V(p),home=V(p),id=i,alive=True,alert=False,seen=None,
                           memory=0,repath=0,path=[],windup=0,cool=0,
                           burst=0,side=1 if i%2 else -1,aim=V(0,1),flash=0)
                      for i,p in enumerate(SPAWNS)]
    @property
    def barriers(self):
        return () if self.upper_open else (UPPER_DOOR,)
    def shoot(self,p,d,owner):
        speed=BULLET_SPEED if owner=='player' else ENEMY_BULLET_SPEED
        self.shots.append(dict(p=p.copy(),v=d.normalize()*speed,owner=owner,life=1.2))
        # Sound conveys a location, never the player's position through walls.
        for e in self.enemies:
            if e['alive'] and e['p'].distance_to(p)<125 and e['memory']<2:
                e['alert']=True;e['seen']=p.copy();e['memory']=3.5
    def start_reload(self):
        if not self.dead and not self.won and self.ammo<12 and self.reload<=0:self.reload=.65
    def hit_enemy(self,e):
        e['alive']=False;self.bodies.append(e['p'].copy());self.combo+=1;self.combo_time=1.8
        self.score+=100*self.combo
    def update(self,dt,movement=V(),manual=None,fire=False,melee=False):
        if self.dead or self.won:return
        trigger=fire and not self.trigger_held
        self.trigger_held=fire
        self.elapsed+=dt;self.cooldown=max(0,self.cooldown-dt);self.flash=max(0,self.flash-dt)
        self.combo_time=max(0,self.combo_time-dt)
        if self.combo_time<=0:self.combo=0
        if self.reload>0:
            self.reload-=dt
            if self.reload<=0:self.ammo=12
        previous=self.p.copy()
        if movement.length_squared()>0:
            move(self.p,movement.normalize()*min(1,movement.length())*SPEED*dt,self.barriers)
        self.velocity=(self.p-previous)/dt if dt else V()
        if self.p.y<301:self.entered=True
        if not self.enemies[3]["alive"] and self.p.distance_to(V(233,225))<30:
            self.upper_open=True
        targets=[e for e in self.enemies if self.entered and e['alive'] and visible(self.p,e['p'],self.barriers)]
        target=min(targets,key=lambda e:e['p'].distance_squared_to(self.p),default=None)
        if manual is not None and manual.length_squared()>.01:self.aim=manual.normalize()
        elif target:self.aim=(target['p']-self.p).normalize() if target['p']!=self.p else V(0,-1)
        target_id=target['id'] if target else None
        self.lock_time=self.lock_time+dt if target_id is not None and target_id==self.lock_target else 0
        self.lock_target=target_id
        # Automatic pistol shots stay spaced apart and need time to acquire aim.
        automatic=self.auto_fire and (fire or (manual is None and target is not None and self.lock_time>=.35 and target['p'].distance_to(self.p)<195))
        attack=trigger or automatic
        if melee and self.entered and self.cooldown<=0:
            self.cooldown=.22;self.flash=.08
            for e in targets:
                if e['p'].distance_to(self.p)<24:self.hit_enemy(e)
        elif attack and self.cooldown<=0 and self.reload<=0:
            if self.ammo:
                self.shoot(self.p,self.aim,'player');self.ammo-=1;self.cooldown=self.shot_interval;self.flash=.10
            else:self.start_reload()
        for e in self.enemies:
            if not e['alive']:continue
            d=self.p-e['p'];distance=d.length()
            sees=self.entered and distance<195 and visible(e['p'],self.p,self.barriers)
            e['cool']=max(0,e['cool']-dt);e['flash']=max(0,e['flash']-dt)
            e['memory']=max(0,e['memory']-dt)
            if sees:
                e['alert']=True;e['seen']=self.p.copy();e['memory']=4
                e['aim']=intercept(e['p'],self.p,self.velocity*.65,ENEMY_BULLET_SPEED)
                e['windup']=min(ENEMY_REACTION,e['windup']+dt)
                if e['cool']<=0 and e['windup']>=ENEMY_REACTION:
                    # Guards also fire distinct pistol shots, never bursts.
                    self.shoot(e['p'],e['aim'],'enemy');e['flash']=.10
                    e['cool']=.60+e['id']*.035
                lateral=V(-d.y,d.x)/max(distance,1)*e['side']
                advance=d/max(distance,1)*(1 if distance>115 else -1 if distance<60 else 0)
                drift=(lateral*.5+advance)*48*dt
                before=e['p'].copy();move(e['p'],drift,self.barriers)
                if e['p'].distance_squared_to(before)<.01:e['side']*=-1
            else:
                e['windup']=0;e['burst']=0
            if not sees:
                if e['memory']>0 and e['seen'] is not None:
                    goal=e['seen']
                else:
                    e['alert']=False
                    # Quiet patrols between nearby reachable points, staggered by guard.
                    phase=int(self.elapsed/2.5+e['id'])%2
                    goal=e['home']+V(22 if phase else -22,12 if phase else -12)
                    if not free(goal,blocked=self.barriers):goal=e['home']
                e['repath']-=dt
                if e['repath']<=0:
                    e['path']=route(e['p'],goal,self.barriers);e['repath']=.45+e['id']*.03
                if e['path']:
                    dest=e['path'][0];delta=dest-e['p']
                    if delta.length()<2:e['path'].pop(0)
                    else:move(e['p'],delta.normalize()*min(delta.length(),(70 if e['alert'] else 28)*dt),self.barriers)
            # Keep guards from stacking up in doorways.
            for other in self.enemies:
                gap=e['p']-other['p']
                if other is not e and other['alive'] and 0<gap.length()<12:
                    move(e['p'],gap.normalize()*24*dt,self.barriers)
        keep=[]
        for shot in self.shots:
            old=shot['p'].copy();shot['p']+=shot['v']*dt;shot['life']-=dt
            if shot['life']<=0 or any(r.clipline(old,shot['p']) for r in VISION + [pg.Rect(b) for b in self.barriers]):continue
            if shot['owner']=='player':
                hit=next((e for e in self.enemies if e['alive'] and segment_hit(old,shot['p'],e['p'])),None)
                if hit:self.hit_enemy(hit);continue
            elif segment_hit(old,shot['p'],self.p,6):self.dead=True;continue
            keep.append(shot)
        self.shots=keep
        if all(not e['alive'] for e in self.enemies) and self.p.distance_to(V(240,330))<13:
            self.won=True
            self.best=self.elapsed if self.best is None else min(self.best,self.elapsed)

class UI:
    def __init__(self,window,art):
        self.window=window;self.art=art;self.game=Game();self.touches={};self.mouse=False
        self.paused=False;self.manual=None;self.fire=False;self.movement=V();self.melee=False
        self.last_setting_press=(None,-1000)
        self.settings_path=ROOT/'.miami-settings.json'
        try:
            settings=json.loads(self.settings_path.read_text())
            self.game.auto_fire=settings.get('auto_fire',True) is not False
            rate=settings.get('shot_interval',.55)
            self.game.shot_interval=rate if rate in (.38,.55,.8) else .55
        except (OSError,ValueError,AttributeError):pass
        self.resize()
    def save_settings(self):
        self.settings_path.write_text(json.dumps(dict(auto_fire=self.game.auto_fire,shot_interval=self.game.shot_interval)))
    def resize(self):
        w,h=self.window.get_size();self.h=max(660,min(900,360*h/w))
        self.canvas=pg.Surface((360,round(self.h)))
        self.scale=min(w/360,h/self.h);self.offset=V((w-360*self.scale)/2,(h-self.h*self.scale)/2)
        self.mapscale=min(344/320,(self.h-285)/430);self.mapoffset=V((360-320*self.mapscale)/2,63)
        self.map_image=pg.transform.scale(self.art,(round(320*self.mapscale),round(430*self.mapscale)))
        self.left=V(76,self.h-83);self.right=V(284,self.h-83)
        self.reloadbox=pg.Rect(145,self.h-119,70,36)
        self.firebox=pg.Rect(137,self.h-73,86,36)
        self.autobox=pg.Rect(12,self.h-220,148,29)
        self.ratebox=pg.Rect(180,self.h-220,168,29)
    def logical(self,p):return (V(p)-self.offset)/self.scale
    def press(self,key,p):
        if pg.Rect(317,4,39,38).collidepoint(p):return 'quit'
        setting='auto' if self.autobox.collidepoint(p) else 'rate' if self.ratebox.collidepoint(p) else None
        if setting:
            # Android can deliver one tap as both finger and mouse events.
            # These buttons do not own a joystick touch, so deduplicate here.
            now=pg.time.get_ticks()
            if self.last_setting_press[0]==setting and now-self.last_setting_press[1]<150:return
            self.last_setting_press=(setting,now)
            if setting=='auto':self.game.auto_fire=not self.game.auto_fire
            else:
                rates=(.38,.55,.8)
                self.game.shot_interval=rates[(rates.index(self.game.shot_interval)+1)%3]
            self.save_settings();return
        if self.game.dead or self.game.won:
            self.game.reset();self.touches.clear();return
        if pg.Rect(224,4,87,38).collidepoint(p):
            self.paused=not self.paused;self.touches.clear();return
        if self.paused:return
        if self.reloadbox.collidepoint(p):self.game.start_reload();return
        if self.firebox.collidepoint(p):self.fire=True;return
        if p.y>self.h-155:
            side='move' if p.x<140 else 'aim'
            if not any(v['side']==side for v in self.touches.values()):
                self.touches[key]=dict(side=side,p=p,origin=self.left if side=='move' else self.right)
        elif key=='mouse':
            self.touches[key]=dict(side='world',p=p,origin=p)
    def release(self,key):self.touches.pop(key,None)
    def inputs(self):
        keys=pg.key.get_pressed()
        movement=V(int(keys[pg.K_d] or keys[pg.K_RIGHT])-int(keys[pg.K_a] or keys[pg.K_LEFT]),int(keys[pg.K_s] or keys[pg.K_DOWN])-int(keys[pg.K_w] or keys[pg.K_UP]))
        manual=None;fire=self.fire or bool(keys[pg.K_f])
        for touch in self.touches.values():
            d=touch['p']-touch['origin']
            if touch['side']=='move':movement=d/35 if d.length()>6 else V()
            elif touch['side']=='aim':
                if d.length()>10:manual=d;fire=True
                else:fire=True
            elif touch['side']=='world':manual=(touch['p']-self.mapoffset)/self.mapscale-self.game.p;fire=True
        return movement,manual,fire,bool(keys[pg.K_SPACE] or self.melee)
    def label(self,s,p,size=12,color=AQUA,center=False):
        img=text_image(s,size,color);r=img.get_rect(center=p) if center else img.get_rect(topleft=p)
        self.canvas.blit(img,r)
    def button(self,r,label,color=AQUA):
        pg.draw.rect(self.canvas,'#242339',r,border_radius=5);pg.draw.rect(self.canvas,color,r,1,border_radius=5)
        self.label(label,r.center,11,color,True)
    def draw(self):
        g=self.game;c=self.canvas;c.fill(BG)
        self.label('MIAMI / NIGHT CALL',(10,10),16,PINK)
        self.button(pg.Rect(227,8,82,27),'SEGUIR' if self.paused else 'PAUSA')
        self.button(pg.Rect(320,8,30,27),'X',PINK)
        alive=sum(e['alive'] for e in g.enemies)
        self.label(f'{g.score:04} PTS   {alive}/5   {g.elapsed:05.1f}s',(10,39),12)
        c.blit(self.map_image,self.mapoffset)
        def pos(p):return self.mapoffset+V(p)*self.mapscale
        def disk(p,r,col):pg.draw.circle(c,col,pos(p),max(1,round(r*self.mapscale)))
        def muzzle(p,aim,player):
            center=pos(p+aim*15)
            forward=aim*self.mapscale
            side=V(-forward.y,forward.x)
            points=[center+forward*10,center+side*4,center-forward*3,center-side*4]
            pg.draw.polygon(c,'#100e23',[center+(point-center)*1.35 for point in points])
            pg.draw.polygon(c,'#ffcf57' if player else '#ff7759',points)
            pg.draw.circle(c,'#fffbe6',center,max(2,round(2*self.mapscale)))
        if g.barriers:
            door=pg.Rect(*pos((220,221)),round(27*self.mapscale),round(8*self.mapscale))
            pg.draw.rect(c,'#351e49',door)
            pg.draw.rect(c,PINK,door,2)
            self.label('CERRADO' if g.enemies[3]['alive'] else 'ACERCATE',pos((233,215)),7,PINK,True)
        for p in g.bodies:
            disk(p,8,'#79344f');pg.draw.line(c,'#ba657e',pos(p-V(5,3)),pos(p+V(6,3)),4)
        if not alive:
            pg.draw.rect(c,AQUA,(*pos((223,316)),round(34*self.mapscale),round(22*self.mapscale)),2)
        def actor(p,aim,player=False,variant=0,moving=False):
            stride=(1 if int(g.elapsed*9)%2 else -1) if moving else 0
            img=actor_sprite(player,variant,stride)
            angle=round(aim.angle_to(V(0,-1))/5)*5
            img=pg.transform.scale(img,(round(30*self.mapscale),round(36*self.mapscale)))
            img=pg.transform.rotate(img,angle)
            c.blit(img,img.get_rect(center=pos(p)))
        for e in g.enemies:
            if not e['alive']:continue
            actor(e['p'],e['aim'],variant=e['id'],moving=bool(e['path']) or e['alert'])
            if e['windup']>0:
                pg.draw.line(c,'#ffd98d',pos(e['p']+e['aim']*11),pos(e['p']+e['aim']*21),1)
            if e['flash']:muzzle(e['p'],e['aim'],False)
        if g.dead:disk(g.p,8,'#79344f')
        else:
            pg.draw.circle(c,AQUA,pos(g.p),round(14*self.mapscale),1)
            actor(g.p,g.aim,player=True,moving=g.velocity.length_squared()>1)
            if g.flash:muzzle(g.p,g.aim,True)
        for shot in g.shots:
            head=pos(shot['p']);tail=pos(shot['p']-shot['v']*.035)
            color='#ffe06b' if shot['owner']=='player' else '#ff705e'
            # Dark outline keeps the tracer visible across every floor color.
            pg.draw.line(c,'#100e23',tail,head,7)
            pg.draw.line(c,color,tail,head,4)
            pg.draw.line(c,'#fffbea',tail.lerp(head,.4),head,2)
            pg.draw.circle(c,color,head,3)
            pg.draw.circle(c,'#fffbea',head,1)
        y=self.h-180
        self.button(self.autobox,'AUTO: SI' if g.auto_fire else 'AUTO: NO','#b7f36b')
        self.button(self.ratebox,f'TIRO: {g.shot_interval:.2f}s','#ffbf69')
        self.label('RECARGANDO' if g.reload>0 else f'PISTOLA  {g.ammo:02}/12',(12,y),13,PINK)
        self.label('CALLE SEGURA / ENTRA POR LA PUERTA' if not g.entered else 'SAL A LA CALLE' if not alive else 'ASESINO / MÁSCARA BLANCA',(12,y+21),11)
        for center,label in ((self.left,'MOVER'),(self.right,'APUNTAR')):
            pg.draw.circle(c,'#242339',center,49);pg.draw.circle(c,AQUA,center,49,1)
            knob=V(center)
            for touch in self.touches.values():
                if touch['origin']==center:
                    d=touch['p']-center
                    knob=center+(d.normalize()*35 if d.length()>35 else d)
            pg.draw.circle(c,'#397781',knob,19)
            self.label(label,(center.x,center.y+59),10,AQUA,True)
        self.button(self.reloadbox,'CARGAR')
        self.button(self.firebox,'DISPARAR','#ffc857')
        self.label('DISPARAR: UN TIRO / DERECHA: APUNTAR',(180,self.h-11),9,'#e6d9ff',True)
        if g.dead or g.won or self.paused:
            shade=pg.Surface(c.get_size(),pg.SRCALPHA);shade.fill((9,7,23,205));c.blit(shade,(0,0))
            self.label('MAPA LIMPIO' if g.won else 'HAS MUERTO' if g.dead else 'PAUSA',(180,self.h/2-30),25,PINK,True)
            self.label('TOCA PARA REINICIAR' if not self.paused else 'TOCA SEGUIR ARRIBA',(180,self.h/2+10),14,AQUA,True)
            if g.won:self.label(f'{g.score} PTS / {g.elapsed:.2f}s',(180,self.h/2+39),14,AQUA,True)
        self.window.fill(BG)
        self.window.blit(pg.transform.scale(c,(round(360*self.scale),round(self.h*self.scale))),self.offset)
        pg.display.flip()


def self_test():
    g=Game()
    assert free(g.p) and all(free(e['p']) for e in g.enemies)
    assert g.barriers and not visible(V(233,265),V(233,183),g.barriers)
    door_test=V(233,240);move(door_test,V(0,-35),g.barriers)
    assert door_test.y>=234, 'Closed upper door allowed passage'
    assert route(g.p,V(128,257),g.barriers), 'First opponent is unreachable'
    first=Game();first.p=V(240,288)
    assert [e['id'] for e in first.enemies if visible(first.p,e['p'],first.barriers)]==[3], 'Crossfire in entry room'
    first.hit_enemy(first.enemies[3]);first.update(STEP,manual=V(1,0))
    assert first.barriers, 'Upper room opened before approaching'
    first.p=V(233,246);first.update(STEP,manual=V(1,0))
    assert not first.barriers and visible(V(233,265),V(233,183),first.barriers)
    assert route(first.p,V(239,183),first.barriers), 'Upper room cannot be reached after opening'
    first.reset();assert first.barriers and not first.upper_open
    # Start behind the exterior wall, isolated from combat until entering.
    assert not g.entered and g.p.y>314
    assert all(not visible(g.p,e['p']) for e in g.enemies)
    for _ in range(1200):g.update(STEP)
    assert not g.dead and not g.shots and not any(e['alert'] for e in g.enemies)
    # Walking from the safe corner through the entrance activates combat.
    for dest in route(g.p,V(240,288)):
        for _ in range(30):
            delta=dest-g.p
            if delta.length()<.5:break
            g.update(STEP,delta/min(1,delta.length()) if delta.length() else V(),manual=V(1,0))
    assert g.entered, 'Entrance never activated combat'
    g.reset()
    for p in SPAWNS:
        path=route(g.p,V(p));assert path, f'Unreachable enemy {p}'
        walk=g.p.copy()
        for dest in path:
            for _ in range(20):
                delta=dest-walk
                if delta.length()<.5:break
                move(walk,delta.normalize()*min(delta.length(),1))
            assert walk.distance_to(dest)<1, (walk,dest)
    p=V(174,60);move(p,V(40,0));assert p.x<179, 'Crossed wall'
    p=V(171,127);move(p,V(35,0));assert p.x>195, 'Door is blocked'
    assert not visible(V(175,60),V(200,60))
    # Equal travel distance at 30, 60 and 120 render fps using the fixed simulation step.
    for fps in (30,60,120):
        p=V(240,288)
        for _ in range(fps//5):
            for _ in range(round(1/fps/STEP)):move(p,V(0,-1)*SPEED*STEP)
        assert abs(p.y-258)<.01, ('Frame rate changed movement speed',p)
    # Bullet impacts, wall shielding, reload, death and exit condition.
    g=Game();g.p=V(240,270)
    for e in g.enemies:e['alive']=False
    e=g.enemies[0];e.update(p=V(240,249),alive=True)
    g.shoot(g.p,V(0,-1),'player')
    for _ in range(10):g.update(STEP)
    assert not e['alive'] and g.score==100
    g=Game();g.p=V(174,60)
    for e in g.enemies:e['alive']=False
    e=g.enemies[0];e.update(p=V(200,60),alive=True)
    g.shoot(g.p,V(1,0),'player')
    for _ in range(20):g.update(STEP)
    assert e['alive'], 'Shot crossed wall'
    g.ammo=0;g.start_reload()
    for _ in range(80):g.update(STEP)
    assert g.ammo==12
    g=Game();g.shoot(g.p+V(0,18),V(0,-1),'enemy')
    for _ in range(15):g.update(STEP)
    assert g.dead
    # Holding the trigger cannot turn the pistol into an automatic weapon.
    pistol=Game();pistol.auto_fire=False;pistol.p=V(240,288)
    for enemy in pistol.enemies:enemy['alive']=False
    for _ in range(120):pistol.update(STEP,manual=V(0,-1),fire=True)
    assert pistol.ammo==11, 'Held trigger fired more than one shot'
    pistol.update(STEP,fire=False)
    pistol.update(STEP,manual=V(0,-1),fire=True)
    assert pistol.ammo==10, 'A fresh press failed to fire'
    pistol.update(STEP,fire=False)
    pistol.update(STEP,fire=True)
    assert pistol.ammo==10, 'Rapid tapping bypassed pistol recovery'
    # A deliberate first shot still rewards the player, without automatic fire.
    aimed=Game();aimed.p=V(170,180)
    for enemy in aimed.enemies:enemy['alive']=False
    enemy=aimed.enemies[0];enemy.update(p=V(170,100),alive=True)
    for step in range(120):
        aimed.update(STEP,fire=step==0)
        if not enemy['alive'] or aimed.dead:break
    assert not aimed.dead and not enemy['alive'], 'Aimed opening shot failed'
    opening=Game();opening.auto_fire=False;opening.p=V(240,288)
    for _ in range(360):
        opening.update(STEP)
        if opening.dead:break
    assert opening.dead and opening.ammo==12, 'Idle player automatically won the opening duel'
    # Count actual shot requests while guards remain present, at each setting.
    counts=[]
    for interval in (.38,.55,.8):
        auto=Game();auto.p=V(110,110);auto.shot_interval=interval
        for enemy in auto.enemies:enemy['alive']=False
        auto.enemies[0].update(p=V(100,58),alive=True)
        fired=[]
        auto.shoot=lambda p,d,owner: fired.append((owner,auto.elapsed))
        for _ in range(480):auto.update(STEP)
        shots=[when for owner,when in fired if owner=='player']
        assert len(shots)>=2, 'Automatic mode did not shoot'
        assert all(b-a>=interval-.00001 for a,b in zip(shots,shots[1:])), 'Automatic pistol exceeded selected cadence'
        counts.append(len(shots))
    assert counts[0]>counts[1]>counts[2], ('Cadence settings have no effect',counts)
    # A short tap on the explicit fire button survives until simulation input.
    window=pg.display.set_mode((432,900))
    controls=UI(window,pg.Surface((320,430)))
    controls.game.auto_fire=False
    controls.press('mouse',V(controls.firebox.center));controls.release('mouse')
    movement,manual,fire,melee=controls.inputs()
    assert fire, 'Quick fire-button tap was lost'
    controls.game.update(STEP,movement,manual,fire,melee)
    assert controls.game.ammo==11, 'Fire button failed to shoot outside the entrance'
    # Android's duplicate finger/mouse tap must toggle settings only once.
    import tempfile
    with tempfile.TemporaryDirectory() as settings_dir:
        controls.settings_path=Path(settings_dir)/'settings.json'
        controls.game.auto_fire=True
        controls.press(123,V(controls.autobox.center))
        controls.press('mouse',V(controls.autobox.center))
        assert not controls.game.auto_fire, 'Duplicate touch toggled AUTO twice'
        assert json.loads(controls.settings_path.read_text())['auto_fire'] is False
        controls.last_setting_press=('auto',-1000)
        controls.paused=True
        controls.press('mouse',V(controls.autobox.center))
        assert controls.game.auto_fire, 'AUTO could not be enabled while paused'
        controls.press(123,V(controls.ratebox.center))
        rate=controls.game.shot_interval
        controls.press('mouse',V(controls.ratebox.center))
        assert controls.game.shot_interval==rate, 'Duplicate touch changed cadence twice'
    # Guards must hit exposed stationary and moving players.
    for movement in (V(),V(1,0),V(-1,0)):
        duel=Game();duel.p=V(110,110)
        for enemy in duel.enemies:enemy['alive']=False
        duel.enemies[0].update(p=V(100,58),alive=True)
        for _ in range(240):
            duel.update(STEP,movement,manual=V(0,1))
            if duel.dead:break
        assert duel.dead, ('Guard failed to hit',movement)
    assert segment_hit(V(0,0),V(30,0),V(15,0)), 'Bullet tunneled through target'
    assert not segment_hit(V(0,0),V(30,0),V(15,12)), 'Bullet hit outside body'
    shield=Game();shield.p=V(174,60)
    for enemy in shield.enemies:enemy['alive']=False
    shield.shoot(V(205,60),V(-1,0),'enemy')
    for _ in range(20):shield.update(STEP,manual=V(0,1))
    assert not shield.dead, 'Enemy bullet crossed wall'
    g.reset()
    for e in g.enemies:e['alive']=False
    g.p=V(240,330);g.update(STEP);assert g.won
    print('PASS: navigation to every room, collision, doorways, fixed speed, shooting, wall shielding, reload, death, restart, win, guard aim at moving targets, swept impacts, isolated safe start, closed upper room, staged entrance, semi-automatic trigger, configurable automatic cadence, fire-button input, lethal opening guard')


def main():
    parser=argparse.ArgumentParser();parser.add_argument('app_id',nargs='?');parser.add_argument('--self-test',action='store_true');parser.add_argument('--preview')
    args=parser.parse_args()
    if args.self_test or args.preview:os.environ['SDL_VIDEODRIVER']='dummy'
    if not args.self_test and not args.preview:
        lock = open(f'/tmp/miami-store-nightcall-{os.getuid()}.lock', 'a+')
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            # A new launcher window needs its own surface. Replace the old game
            # rather than silently exiting and leaving the new window empty.
            lock.seek(0)
            previous = lock.read().strip()
            if not previous.isdigit():
                raise RuntimeError('La instancia anterior no permite reiniciar el juego')
            pid = int(previous)
            try:
                command = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
                if b'miami-night-call' not in command:
                    raise RuntimeError('El bloqueo pertenece a otro proceso')
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            for attempt in range(100):
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    time.sleep(.02)
            else:
                raise RuntimeError('No se pudo cerrar la instancia anterior del juego')
        lock.seek(0);lock.truncate();lock.write(str(os.getpid()));lock.flush()
    pg.display.init();pg.font.init()
    if args.self_test:self_test();return
    # Ignore SDL-generated mouse events for genuine finger events; use mouse emulation otherwise.
    window=pg.display.set_mode((432,900) if args.preview else (0,0),0 if args.preview else pg.FULLSCREEN|pg.RESIZABLE)
    pg.display.set_caption('Miami · Night Call')
    ui=UI(window,render_map())
    navigation((UPPER_DOOR,));navigation()  # Build both door states once before the simulation starts, never during combat.
    if args.preview:ui.draw();pg.image.save(window,args.preview);return
    clock=pg.time.Clock();accumulator=0;running=True
    while running:
        frame=min(clock.tick(60)/1000,.08)
        for event in pg.event.get():
            if event.type==pg.QUIT:running=False
            elif event.type==pg.WINDOWFOCUSLOST:
                ui.paused=True;ui.touches.clear();accumulator=0
            elif event.type==pg.VIDEORESIZE:
                ui.resize()
            elif event.type==pg.KEYDOWN:
                if event.key==pg.K_ESCAPE:running=False
                elif event.key==pg.K_r:
                    if ui.game.dead or ui.game.won:ui.game.reset()
                    else:ui.game.start_reload()
                elif event.key in (pg.K_RETURN,pg.K_p):ui.paused=not ui.paused;ui.touches.clear()
            elif event.type==pg.FINGERDOWN:
                p=ui.logical((event.x*window.get_width(),event.y*window.get_height()))
                if ui.press(event.finger_id,p)=='quit':running=False
            elif event.type==pg.FINGERMOTION and event.finger_id in ui.touches:
                ui.touches[event.finger_id]['p']=ui.logical((event.x*window.get_width(),event.y*window.get_height()))
            elif event.type==pg.FINGERUP:ui.release(event.finger_id)
            elif event.type==pg.MOUSEBUTTONDOWN and (not getattr(event,'touch',False) or not any(isinstance(k,int) for k in ui.touches)):
                if event.button==1 and ui.press('mouse',ui.logical(event.pos))=='quit':running=False
                elif event.button==3:ui.melee=True
            elif event.type==pg.MOUSEMOTION and 'mouse' in ui.touches:
                ui.touches['mouse']['p']=ui.logical(event.pos)
            elif event.type==pg.MOUSEBUTTONUP:ui.release('mouse')
        if not ui.paused:
            movement,manual,fire,melee=ui.inputs();accumulator+=frame
            while accumulator>=STEP:
                ui.game.update(STEP,movement,manual,fire,melee);accumulator-=STEP
                if ui.fire:
                    ui.fire=False;fire=False
            ui.melee=False
        ui.draw()
    pg.quit()

if __name__=='__main__':main()

MIAMI_GAME""") }
        Button { text: neon ? "NEÓN: ON" : "NEÓN: OFF"; color: pink; onTap: neon = !neon }
      }
      Text { text: "Izquierda: mover · Disparo automático configurable · Botón DISPARAR: tiro manual."; color: #c9a0be; fontSize: 11; align: center }
    }
}
