app "corsair" {
  meta {
    owl: 13
    description: "A pirate survivors-like: upgrade your ship, sail five biomes, claim four relics and slay the Sea King."
    version: "1.7.1"
    license: "MIT"
    category: "games"
  }
  title: ""
  statusBar: false
  back: phase == "play" || phase == "shop" || phase == "pause" || phase == "harbor"
  onBack: {
    if phase == "play" { phase = "pause"; confirm = "" } else if phase == "harbor" { phase = "title" } else { phase = "play"; joy = false; jx = 0; jy = 0 }
  }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 31h40l-7 11H11z"/>
    <path d="M24 31V4l9 4-9 4"/>
    <path d="M24 15c9 2 13 8 13 16M24 15c-7 2-11 8-11 16"/>
  </svg>"""

  requires { pacman: ["coreutils"] }

  // The game's clock: a line every ~0.12 s while the app is open. Each tick moves the world one
  // step; nodes tween their offset and rotation over a tick, so motion in between is smooth.
  // Only while sailing: a null command stops the stream, so menus and pauses cost nothing.
  source tick = stream(phase == "play" ? 'while :; do date +%s%3N; sleep 0.11; done' : null)

  state phase = "title"        // title, play, level, shop, pause, over
  state last = 0
  state gt = 0                 // seconds sailed
  state sx = 0
  state sy = 0
  state sh = 0                 // heading, degrees clockwise from north, unbounded so tweens never spin the long way
  state sv = 0
  state hp = 100
  state lv = {cannon: 1, parrot: 0, fire: 0, mortar: 0, ram: 0, sails: 0, hull: 0, nest: 0, swivel: 0, harpoon: 0, lantern: 0, anchor: 0, bell: 0, kegs: 0, crew: 0, figure: 0, cat: 0, boats: 0, heavy: 0, oars: 0, stove: 0, nets: 0, chain: 0, mines: 0, rockets: 0, ward: 0, chart: 0, deck: 0, whirl: 0, board: 0, barnacle: 0, doubloon: 0, pumps: 0, drill: 0, flags: 0, copper: 0, lodestone: 0, grape: 0, dragon: 0, storm: 0, ghost: 0, gold: 0}
  state level = 1
  state xp = 0
  state gold = 0
  state kills = 0
  state foes = []
  state balls = []
  state eballs = []
  state shells = []
  state fires = []
  state coins = []
  state fx = []
  state nid = 1
  state spawnAcc = 0
  state cdCannon = 0
  state cdFire = 0
  state cdMortar = 0
  state parA = 0
  state cdSwivel = 0
  state cdHarp = 0
  state cdLant = 0
  state cdBell = 0
  state cdDragon = 0
  state cdStorm = 0
  state anchA = 0
  state bellT = 0
  state breathT = 0
  state boatsUsed = 0
  state legends = 0
  state cdRocket = 0
  state cdMine = 0
  state cdWhirl = 0
  state cdBoard = 0
  state wardHp = 0
  state wardT = 0
  state wardBroke = false
  state minefield = []
  state whirls = []
  state shipSlow = 0            // a siren's song slows the ship for a while
  state curBiome = "sea"
  state bossN = 0
  state choices = []
  state offers = []
  state bought = 0
  state used = []
  state port = null
  state joy = false
  state jx = 0
  state jy = 0
  state jox = 0
  state joy0 = 0
  state hurt = 0
  state bossAt = 180
  state banner = ""
  state bannerT = 0
  state bestT = 0 persist
  state bestK = 0 persist
  // the goal: a relic from each of the four dangerous biomes, then Treasure Isle and the Sea King
  state relics = []
  state stir = {sea: 0, reef: 0, ice: 0, fog: 0, lava: 0}   // seconds spent in each biome since its boss last woke
  state warned = ""
  state isleX = null
  state isleY = null
  state kingUp = false
  state won = false
  state endless = false
  state esc = 0                 // escalation: one more for every boss beaten
  state swarmAt = 150
  state rerolls = 0
  state lastBank = 0
  state confirm = ""            // the menu's restart and abandon ask for a second tap
  // the harbor: gold banked between voyages, and what it has bought
  state bank = 0 persist
  state perm = {keel: 0, powder: 0, winds: 0, banker: 0, charm: 0, fortune: 0, crewp: 0} persist
  state wins = 0 persist
  state bestRelics = 0 persist

  let VERSION = "1.7.1"          // bump with each change to the game (and meta's version with it); shown in the bottom corner
  let W = screenWidth
  let H = screenHeight
  let nRel = len(relics)
  let maxHp = 100 + 40 * lv.hull + 15 * (perm.keel ?? 0) + 15 * nRel
  let spd0 = (82 + 22 * lv.sails) * (lv.ghost > 0 ? 1.25 : 1) * (1 + 0.08 * lv.oars) * (1 + 0.04 * lv.flags) * (1 + 0.05 * lv.copper) * (1 + 0.04 * (perm.winds ?? 0))
  let rof = 1 - 0.1 * lv.crew          // the shanty crew speeds every reload
  let dmgMul = 1 + 0.15 * lv.figure + 0.06 * lv.flags + 0.06 * (perm.powder ?? 0) + 0.08 * nRel   // the figurehead and the flags add to every hit
  let pickR = 70 + 40 * lv.nest + 45 * lv.lodestone
  let reach = 210 + 40 * lv.nest
  let xpNeed = 5 + level * 4 + floor(level * level / 3)

  // rarity decides how often a level-up offers an upgrade; legendary ones are only sold at outposts
  let RARITY = {
    common: {w: 60, color: #b8c4cf},
    rare: {w: 28, color: #4fa3ff},
    epic: {w: 12, color: #c77dff},
    legendary: {w: 0, color: #ffb02e}
  }
  let RAR = {cannon: "common", parrot: "common", fire: "common", sails: "common", hull: "common", nest: "common", swivel: "common", heavy: "common", oars: "common", stove: "common", nets: "common", mortar: "rare", ram: "rare", harpoon: "rare", lantern: "rare", kegs: "rare", crew: "rare", figure: "rare", cat: "rare", anchor: "rare", chain: "rare", mines: "rare", rockets: "rare", ward: "rare", chart: "rare", barnacle: "common", doubloon: "common", pumps: "common", drill: "common", flags: "common", copper: "common", lodestone: "common", grape: "common", bell: "epic", boats: "epic", deck: "epic", whirl: "epic", board: "epic", dragon: "legendary", storm: "legendary", ghost: "legendary", gold: "legendary", rum: "common", chest: "common"}
  let luckR = (1 + 0.5 * lv.chart) * (1 + 0.15 * (perm.charm ?? 0))     // the treasure map and the lucky charm tilt the odds
  let luckE = (1 + 0.75 * lv.chart) * (1 + 0.2 * (perm.charm ?? 0))
  let dmgS = 1 + gt / 360 + 0.15 * esc   // how much harder foes hit as the voyage goes on

  let UP = {
    cannon: {name: "Broadside cannons", max: 4, info: "Another gun each side. Fires at the nearest foes."},
    parrot: {name: "Parrot squadron", max: 4, info: "A parrot circles the ship, pecking what it passes."},
    fire: {name: "Greek fire", max: 4, info: "A barrel of burning oil, dropped in your wake."},
    mortar: {name: "Deck mortar", max: 3, info: "Lobs shells that burst among foes."},
    ram: {name: "Iron ram", max: 3, info: "Bumps whatever touches the ship back out, hurting it."},
    sails: {name: "More sail", max: 3, info: "Another mast: faster, and turns sharper."},
    hull: {name: "Plated hull", max: 3, info: "Iron plates: more hull, less damage, repairs at sea."},
    nest: {name: "Crow's nest", max: 3, info: "A lookout: longer range, wider loot pull, more XP."},
    swivel: {name: "Swivel guns", max: 3, info: "Little rail guns pepper anything close."},
    harpoon: {name: "Harpoon ballista", max: 3, info: "Spears the toughest foe in reach, and all behind it."},
    lantern: {name: "Ghost lanterns", max: 3, info: "Cursed lanterns zap the nearest foes."},
    anchor: {name: "Anchor flail", max: 3, info: "An anchor on a chain swings wide around the ship."},
    bell: {name: "Storm bell", max: 3, info: "Each toll blasts nearby foes back."},
    kegs: {name: "Powder kegs", max: 3, info: "Cannonballs burst where they hit."},
    crew: {name: "Shanty crew", max: 3, info: "Sailors sing: every weapon reloads faster."},
    figure: {name: "Golden figurehead", max: 3, info: "A lucky prow: every weapon hits harder."},
    cat: {name: "Ship's cat", max: 3, info: "Lucky hits deal double damage."},
    boats: {name: "Lifeboats", max: 2, info: "When the ship sinks, a lifeboat brings her back."},
    heavy: {name: "Heavy shot", max: 3, info: "Bigger cannonballs hit harder."},
    oars: {name: "Galley oars", max: 3, info: "Rowers: faster, quicker to turn and get going."},
    stove: {name: "Galley stove", max: 3, info: "Each sinking feeds the crew and mends the hull."},
    nets: {name: "Fishing nets", max: 3, info: "Trailing nets slow every foe near the ship."},
    chain: {name: "Chain shot", max: 3, info: "Cannonballs chained in pairs slow what they hit."},
    mines: {name: "Sea mines", max: 3, info: "Mines dropped astern burst when foes touch them."},
    rockets: {name: "Congreve rockets", max: 3, info: "Rockets that seek out foes and burst."},
    ward: {name: "Coral ward", max: 3, info: "A bubble that soaks up damage, then regrows."},
    chart: {name: "Treasure map", max: 2, info: "Better odds of rare and epic finds, more gold."},
    deck: {name: "Second gun deck", max: 2, info: "A lower deck of guns: more balls every volley."},
    whirl: {name: "Neptune's trident", max: 3, info: "Calls whirlpools that drag foes in and drown them."},
    board: {name: "Boarding party", max: 2, info: "Boarders grapple a foe and take it outright."},
    barnacle: {name: "Barnacle hull", max: 3, info: "A crusted hull cuts whatever rubs against it."},
    doubloon: {name: "Lucky doubloon", max: 3, info: "A coin nailed to the stern: more XP and gold."},
    pumps: {name: "Bilge pumps", max: 3, info: "When the hull is low, the pumps keep her afloat."},
    drill: {name: "Gunnery drill", max: 3, info: "Practised gunners: cannons and swivels reload faster."},
    flags: {name: "Signal flags", max: 3, info: "Bunting lifts the crew: a little faster, harder hits."},
    copper: {name: "Copper sheathing", max: 3, info: "A copper bottom: faster, and shot glances off."},
    lodestone: {name: "Lodestone", max: 3, info: "A magnet stone draws loot from farther, faster."},
    grape: {name: "Grapeshot", max: 3, info: "Each volley sprays pellets at whatever is close."},
    dragon: {name: "Dragon prow", max: 1, leg: true, info: "A dragon's head on the bow breathes fire ahead."},
    storm: {name: "Storm mast", max: 1, leg: true, info: "A lightning rod that chains bolts through foes."},
    ghost: {name: "Ghost sails", max: 1, leg: true, info: "Sails of the drowned: swift, and hard to sink."},
    gold: {name: "Golden broadside", max: 1, leg: true, info: "Gilded guns: double damage, balls fly through."},
    rum: {name: "Barrel of rum", max: 99, info: "Repairs half the hull."},
    chest: {name: "Buried chest", max: 99, info: "25 gold."}
  }
  // what the next level of each upgrade gives, in numbers (the same formulas as the tick uses)
  let NEXT = {
    cannon: "${lv.cannon + 1} guns · ${round((8 + 3 * (lv.cannon + 1)) * (1 + 0.25 * lv.heavy))} dmg · reload ${fixed((1.15 - 0.1 * (lv.cannon + 1)) * rof, 2)}s",
    parrot: "${lv.parrot + 1} parrot${lv.parrot > 0 ? "s" : ""} · ${20 + 6 * (lv.parrot + 1)} dmg/s each",
    fire: "a fire every ${fixed(1.5 - 0.17 * (lv.fire + 1), 1)}s · ${12 + 8 * (lv.fire + 1)} dmg/s",
    mortar: "${lv.mortar + 1 >= 3 ? 2 : 1} shell${lv.mortar + 1 >= 3 ? "s" : ""} every ${fixed(3.2 - 0.5 * (lv.mortar + 1), 1)}s · ${24 + 14 * (lv.mortar + 1)} dmg",
    ram: "${6 + 8 * (lv.ram + 1)} per bump · −${10 * (lv.ram + 1)}% hull damage",
    sails: "speed ${82 + 22 * lv.sails} → ${82 + 22 * (lv.sails + 1)}",
    hull: "${100 + 40 * (lv.hull + 1)} hull · −${12 * (lv.hull + 1)}% damage · +${fixed(0.6 * (lv.hull + 1), 1)}/s",
    nest: "range ${210 + 40 * (lv.nest + 1)} · pull ${70 + 40 * (lv.nest + 1)} · +${10 * (lv.nest + 1)}% XP",
    swivel: "${lv.swivel + 1} swivel${lv.swivel > 0 ? "s" : ""} · ${5 + 2 * (lv.swivel + 1)} dmg · every ${fixed(0.5 * rof, 2)}s",
    harpoon: "${30 + 15 * (lv.harpoon + 1)} dmg · pierces · every ${fixed((2.4 - 0.3 * (lv.harpoon + 1)) * rof, 1)}s",
    lantern: "zaps ${lv.lantern + 2} · ${12 + 8 * (lv.lantern + 1)} dmg · every ${fixed((2.2 - 0.3 * (lv.lantern + 1)) * rof, 1)}s",
    anchor: "${30 + 15 * (lv.anchor + 1)} dmg/s · ${90 + 15 * (lv.anchor + 1)}°/s",
    bell: "${14 + 10 * (lv.bell + 1)} dmg within ${80 + 20 * (lv.bell + 1)} · every ${fixed((5.5 - 0.9 * (lv.bell + 1)) * rof, 1)}s",
    kegs: "bursts of ${6 + 6 * (lv.kegs + 1)} dmg within ${26 + 8 * (lv.kegs + 1)}",
    crew: "every reload ${10 * (lv.crew + 1)}% faster",
    figure: "+${15 * (lv.figure + 1)}% damage, every weapon",
    cat: "${10 * (lv.cat + 1)}% chance of double damage",
    boats: "${lv.boats + 1} lifeboat${lv.boats > 0 ? "s" : ""} · back at half hull",
    heavy: "+${25 * (lv.heavy + 1)}% cannon damage",
    oars: "+${8 * (lv.oars + 1)}% speed · quicker turns and starts",
    stove: "+${fixed(0.6 * (lv.stove + 1), 1)} hull for each foe sunk",
    nets: "foes within ${70 + 15 * (lv.nets + 1)} slowed ${15 * (lv.nets + 1)}%",
    chain: "hits slow foes by half for ${fixed(1.2 + 0.6 * (lv.chain + 1), 1)}s",
    mines: "up to ${6 + 2 * (lv.mines + 1)} · ${30 + 15 * (lv.mines + 1)} dmg · one every ${fixed((2.4 - 0.4 * (lv.mines + 1)) * rof, 1)}s",
    rockets: "${lv.rockets + 1} rocket${lv.rockets > 0 ? "s" : ""} · ${18 + 10 * (lv.rockets + 1)} dmg + burst · every ${fixed((2.8 - 0.4 * (lv.rockets + 1)) * rof, 1)}s",
    ward: "soaks ${20 + 15 * (lv.ward + 1)} · regrows ${fixed(9 - 1.5 * (lv.ward + 1), 1)}s after breaking",
    chart: "rare odds ×${fixed(1 + 0.5 * (lv.chart + 1), 1)} · epic ×${fixed(1 + 0.75 * (lv.chart + 1), 2)} · +${20 * (lv.chart + 1)}% gold",
    deck: "+${2 * (lv.deck + 1)} cannonballs each volley",
    whirl: "${15 + 10 * (lv.whirl + 1)} dmg/s, pulling foes in · every ${fixed((9 - 1.5 * (lv.whirl + 1)) * rof, 1)}s",
    board: "takes the toughest foe near (not the kraken) · every ${fixed((8 - 2.5 * (lv.board + 1)) * rof, 1)}s",
    barnacle: "${6 + 6 * (lv.barnacle + 1)} dmg/s to foes touching the hull",
    doubloon: "+${12 * (lv.doubloon + 1)}% XP · +${10 * (lv.doubloon + 1)}% gold",
    pumps: "below 40% hull: +${2 + 2 * (lv.pumps + 1)} hull/s",
    drill: "cannons and swivels reload ${8 * (lv.drill + 1)}% faster",
    flags: "+${6 * (lv.flags + 1)}% damage · +${4 * (lv.flags + 1)}% speed",
    copper: "+${5 * (lv.copper + 1)}% speed · −${12 * (lv.copper + 1)}% damage from shot",
    lodestone: "loot pull +${45 * (lv.lodestone + 1)} · loot flies ${30 * (lv.lodestone + 1)}% faster",
    grape: "${3 + lv.grape} pellets a volley · ${4 + 2 * (lv.grape + 1)} dmg each",
    dragon: "70 dmg in a cone ahead · every ${fixed(2.4 * rof, 1)}s",
    storm: "45 dmg through 6 foes · every ${fixed(1.4 * rof, 1)}s",
    ghost: "+25% speed · −30% damage · +2 hull/s",
    gold: "double cannon damage · balls pierce",
    rum: "+${round(maxHp / 2)} hull",
    chest: "+25 gold"
  }
  let KEYS = ["cannon", "parrot", "fire", "mortar", "ram", "sails", "hull", "nest", "swivel", "harpoon", "lantern", "anchor", "bell", "kegs", "crew", "figure", "cat", "boats", "heavy", "oars", "stove", "nets", "chain", "mines", "rockets", "ward", "chart", "deck", "whirl", "board", "barnacle", "doubloon", "pumps", "drill", "flags", "copper", "lodestone", "grape"]
  let LEG = ["dragon", "storm", "ghost", "gold"]      // sold only at outposts
  let LV0 = {cannon: 1, parrot: 0, fire: 0, mortar: 0, ram: 0, sails: 0, hull: 0, nest: 0, swivel: 0, harpoon: 0, lantern: 0, anchor: 0, bell: 0, kegs: 0, crew: 0, figure: 0, cat: 0, boats: 0, heavy: 0, oars: 0, stove: 0, nets: 0, chain: 0, mines: 0, rockets: 0, ward: 0, chart: 0, deck: 0, whirl: 0, board: 0, barnacle: 0, doubloon: 0, pumps: 0, drill: 0, flags: 0, copper: 0, lodestone: 0, grape: 0, dragon: 0, storm: 0, ghost: 0, gold: 0}
  // foes' top speeds, reached after 7 minutes at sea; they start at 60% of it (see pace)
  let KSPD = {shark: 82, sloop: 60, serp: 54, barracuda: 115, jelly: 32, puffer: 62, narwhal: 48, raider: 64, wraith: 60, skiff: 92, crab: 38, drake: 72, siren: 30, kraken: 30, dutchman: 34, leviathan: 56, wyrm: 52, king: 40}
  let KHP = {shark: 10, sloop: 28, serp: 75, barracuda: 7, jelly: 30, puffer: 14, narwhal: 40, raider: 32, wraith: 36, skiff: 6, crab: 70, drake: 24, siren: 40, kraken: 800, dutchman: 900, leviathan: 1000, wyrm: 950, king: 4200}
  let KR = {shark: 12, sloop: 14, serp: 16, barracuda: 10, jelly: 14, puffer: 12, narwhal: 14, raider: 14, wraith: 15, skiff: 10, crab: 16, drake: 13, siren: 14, kraken: 46, dutchman: 52, leviathan: 40, wyrm: 40, king: 64}
  let KDPS = {shark: 10, sloop: 8, serp: 20, barracuda: 8, jelly: 18, puffer: 6, narwhal: 20, raider: 9, wraith: 10, skiff: 7, crab: 22, drake: 8, siren: 4, kraken: 40, dutchman: 40, leviathan: 45, wyrm: 40, king: 55}
  let KXP = {shark: 1, sloop: 3, serp: 5, barracuda: 1, jelly: 3, puffer: 2, narwhal: 4, raider: 3, wraith: 4, skiff: 1, crab: 5, drake: 3, siren: 5, kraken: 0, dutchman: 0, leviathan: 0, wyrm: 0, king: 0}
  let KS = {shark: 48, sloop: 72, serp: 110, barracuda: 48, jelly: 56, puffer: 64, narwhal: 60, raider: 72, wraith: 72, skiff: 44, crab: 64, drake: 64, siren: 60, kraken: 200, dutchman: 240, leviathan: 260, wyrm: 260, king: 330}
  let NOROT = ["kraken", "jelly", "puffer", "siren", "king"]       // drawn upright, never turned
  // those that keep their distance and circle at it
  let KEEP = {sloop: 190, raider: 200, wraith: 210, drake: 170, siren: 240, dutchman: 230}
  // those that shoot: range, reload, how many shots in a fan and how far apart, and what they throw
  let SHOT = {sloop: {r: 300, cd: 2.6, n: 1, sp: 0, k: "ball"}, raider: {r: 260, cd: 2.0, n: 1, sp: 0, k: "spear"}, wraith: {r: 320, cd: 2.4, n: 1, sp: 0, k: "ghost"}, drake: {r: 280, cd: 2.2, n: 1, sp: 0, k: "fire"}, siren: {r: 340, cd: 2.8, n: 1, sp: 0, k: "note"}, kraken: {r: 420, cd: 3.2, n: 10, sp: 36, k: "ink"}, dutchman: {r: 420, cd: 2.6, n: 7, sp: 14, k: "ghost"}, leviathan: {r: 400, cd: 3.0, n: 5, sp: 18, k: "fire"}, wyrm: {r: 400, cd: 3.2, n: 5, sp: 18, k: "frost"}, king: {r: 520, cd: 2.0, n: 12, sp: 30, k: "ghost"}}
  let EBS = {ball: 170, ink: 110, spear: 260, ghost: 150, fire: 190, note: 140, frost: 170}
  let EBD = {ball: 9, ink: 12, spear: 7, ghost: 10, fire: 11, note: 4, frost: 8}
  let BOSSES = ["kraken", "dutchman", "leviathan"]
  let BOSSNAME = {kraken: "The kraken", dutchman: "The Flying Dutchman", leviathan: "The Leviathan", wyrm: "The Frost Wyrm", king: "The Sea King"}
  let RELIC = {reef: {name: "Siren's Pearl", col: #ffd0e0}, ice: {name: "Frost Heart", col: #9fe8ff}, fog: {name: "Drowned Lantern", col: #7fffb0}, lava: {name: "Ember Crown", col: #ffb03a}}
  let RELICKEYS = ["reef", "ice", "fog", "lava"]
  let STIRT = {sea: 150, reef: 70, ice: 70, fog: 70, lava: 70}     // seconds in a biome before its boss wakes
  // a swarm every couple of minutes, of whatever the biome breeds
  let SWARMK = {sea: "shark", reef: "jelly", ice: "narwhal", fog: "skiff", lava: "drake"}
  let SWARMN = {sea: 12, reef: 10, ice: 8, fog: 12, lava: 8}
  let SWARMTXT = {sea: "Shark frenzy!", reef: "The jellies bloom!", ice: "Narwhal stampede!", fog: "A ghost fleet gathers!", lava: "Drakes on the wind!"}
  // the harbor's permanent upgrades: each level costs cost × the level it buys
  let PERMS = [
    {k: "keel", name: "Sturdier keel", max: 5, cost: 60, info: "+15 hull"},
    {k: "powder", name: "Fine powder", max: 5, cost: 80, info: "+6% damage"},
    {k: "winds", name: "Fair winds", max: 3, cost: 70, info: "+4% speed"},
    {k: "banker", name: "Moneylender", max: 3, cost: 70, info: "+10% gold"},
    {k: "charm", name: "Lucky charm", max: 3, cost: 100, info: "better rare and epic odds"},
    {k: "fortune", name: "Fortune teller", max: 3, cost: 120, info: "+1 reroll on level-ups"},
    {k: "crewp", name: "Seasoned crew", max: 2, cost: 160, info: "start with a common upgrade"}
  ]

  // ---- biomes: the sea is cut into 5760 dp regions, each with its own waters, the start always open sea.
  // Each one changes the voyage: spd (yours), fspd and fhp (foes'), xp and gold, hull mended or burned
  // a second, how often its islands hold outposts, and the boss that rises there.
  let BIO = {
    sea: {name: "the Open Sea", col: #1b4f7a, wave: #9fd8ff, spd: 1, fspd: 1, fhp: 1, xp: 1, gold: 1, mend: 0, burn: 0, fire: 1, out: 0.22, boss: "kraken", trait: "steady winds"},
    reef: {name: "the Coral Shallows", col: #16808f, wave: #c8fff4, spd: 0.9, fspd: 1, fhp: 1, xp: 1, gold: 1.3, mend: 1.5, burn: 0, fire: 1, out: 0.35, boss: "kraken", trait: "warm water mends the hull · reefs drag the keel · gold ×1.3"},
    ice: {name: "the Frozen Reach", col: #3f6f8f, wave: #ffffff, spd: 0.88, fspd: 0.78, fhp: 1.1, xp: 1.3, gold: 1.1, mend: 0, burn: 0, fire: 0.8, out: 0.2, boss: "wyrm", trait: "the cold slows everything · XP ×1.3"},
    fog: {name: "the Haunted Fog", col: #2a2440, wave: #8a7ab0, spd: 1, fspd: 1.05, fhp: 1.35, xp: 1.5, gold: 1.5, mend: 0, burn: 0, fire: 1, out: 0.12, boss: "dutchman", trait: "the dead are hardier · XP and gold ×1.5"},
