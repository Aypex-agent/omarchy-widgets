app "number slide" {
  meta {
    owl: 23
    description: "A sliding number puzzle with six campaign levels and custom boards, with offline sounds"
    version: "1.0"
    license: "MIT"
    category: "games"
  }

  // No shell commands or packages: slides, sound and haptics are built into the launcher.
  requires { pacman: [] }

  // Tiny embedded WAV clips (16-bit PCM, 11 kHz) keep sound offline.
  asset slideSound = base64""
  asset winSound = base64""
  // Campaign mode is the six built-in levels; custom mode is one
  // player-defined puzzle. Drafts hold the setup screen's choices.
  state mode = "campaign"
  state view = "game"
  state customN = 4
  state customSteps = 90
  state draftN = 4
  state draftSteps = 90

  title: view == "setup" ? "custom difficulty" : (mode == "custom" ? "custom ${customN}×${customN}" : "number slide")
  back: view == "setup"
  onBack: view = "game"
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <rect x="40" y="40" width="52" height="52" rx="10" fill="#7AA2F7"/>
    <rect x="102" y="40" width="52" height="52" rx="10" fill="#BB9AF7"/>
    <rect x="164" y="40" width="52" height="52" rx="10" fill="#7DCFFF"/>
    <rect x="40" y="102" width="52" height="52" rx="10" fill="#9ECE6A"/>
    <rect x="102" y="102" width="52" height="52" rx="10" fill="#E0AF68"/>
    <rect x="164" y="102" width="52" height="52" rx="10" fill="#F7768E"/>
    <rect x="40" y="164" width="52" height="52" rx="10" fill="#7AA2F7"/>
    <rect x="102" y="164" width="52" height="52" rx="10" fill="#BB9AF7"/>
    <rect x="164" y="164" width="52" height="52" rx="10" fill="none" stroke="#565B78" stroke-width="6" stroke-dasharray="10 8"/>
  </svg>"""

  // Six levels: two 3x3, two 4x4, two 5x5. Later levels get a deeper
  // scramble and a higher par score.
  let maxLevel = 6
  let levelSize = l => l <= 2 ? 3 : l <= 4 ? 4 : 5
  let levelScramble = l => [30, 65, 100, 150, 220, 300][l - 1]
  let levelPar = l => [25, 60, 110, 170, 260, 360][l - 1]

  let GOAL = n => range(1, n * n) + [0]
  let NEIGH = a => range(a.n * a.n).filter(j =>
      (floor(a.i / a.n) == floor(j / a.n) && abs(a.i % a.n - j % a.n) == 1) ||
      (a.i % a.n == j % a.n && abs(floor(a.i / a.n) - floor(j / a.n)) == 1)
    )

  // Random legal slides that never immediately undo the previous one. That
  // makes the deeper scrambles on later levels actually harder, and every
  // board stays solvable.
  let walk = a => [reduce(range(a.steps), (st, step) =>
      [[{n: a.n, i: indexOf(st.b, 0)}].map(NEIGH)[0].filter(j => j != st.prev)].map(cs =>
        [cs[floor(hash(a.s, step) * len(cs))]].map(p => {
          b: set(set(st.b, indexOf(st.b, 0), st.b[p]), p, 0),
          prev: indexOf(st.b, 0)
        })[0]
      )[0],
      {b: [a.n].map(GOAL)[0], prev: -1}
    )].map(st => st.b)[0]

  let scramble = a => [[a].map(walk)[0]].map(b =>
      b == [a.n].map(GOAL)[0] ? [merge(a, {s: a.s + 1})].map(walk)[0] : b
    )[0]

  let begin = a => [{n: [a.lv].map(levelSize)[0], s: a.s, steps: [a.lv].map(levelScramble)[0]}].map(scramble)[0]
  let beginCustom = a => [{n: a.n, s: a.s, steps: a.steps}].map(scramble)[0]

  state level = 1
  state seed = random(1000000)
  state board = [{lv: level, s: seed}].map(begin)[0]
  state moves = 0
  state best = {} persist
  state sound = true

  let n = mode == "custom" ? customN : [level].map(levelSize)[0]
  let par = mode == "custom" ? round(customSteps * 0.25 + customN * customN * 2) : [level].map(levelPar)[0]
  let draftPar = round(draftSteps * 0.25 + draftN * draftN * 2)
  let bestKey = mode == "custom" ? "c${customN}x${customN}-${customSteps}" : level
  let blank = indexOf(board, 0)
  let won = board == [n].map(GOAL)[0]
  let W = screenWidth ?? 412
  let H = screenHeight ?? 820
  let side = max(240, min(W - 32, H - 214))
  let pad = 8
  let gap = n == 5 ? 6 : 8
  let cell = (side - 2 * pad - (n - 1) * gap) / n
  let numSize = cell * (n <= 3 ? 0.42 : n == 4 ? 0.38 : 0.32)

  when won {
    let b = get(best, bestKey, 0)
    if b == 0 || moves < b { best = set(best, bestKey, moves) }
    haptic()
    if sound { sound(winSound) }
  }

  if view == "game" {
  Column {
    padding: [16, 12]
    gap: 14

    Row {
      gap: 8
      align: center
      Column { gap: 2; weight: 1
        Text { text: mode == "custom" ? "CUSTOM · ${n}×${n}" : "LEVEL ${level}/${maxLevel} · ${n}×${n}"; style: title }
        Text { text: "arrange 1–${n * n - 1} in order"; style: small; color: muted }
      }
      Column { gap: 2
        Text { text: "${moves}"; style: title; bold: true; align: end; color: moves > par ? yellow : accent }
        Text { text: "par ${par} · best ${get(best, bestKey, 0) > 0 ? get(best, bestKey, 0) : "–"}"; style: small; color: muted; align: end }
      }
    }

    Box {
      width: side
      height: side
      align: topStart
      background: alpha(surface, 0.75)
      border: 1
      borderColor: alpha(accent, 0.3)
      radius: 18 * corners

      // Bare cells sit underneath; the empty square is just a cell with no tile.
      for i in range(n * n) key "${mode}-${n}-${level}-${i}" {
        Box {
          width: cell
          height: cell
          offset: [pad + (i % n) * (cell + gap), pad + floor(i / n) * (cell + gap)]
          radius: 12 * corners
          background: alpha(background, 0.35)
        }
      }

      // One persistent node per tile, keyed by level and number. Only its
      // offset changes on a move, and that change is tweened into a slide.
      for v in range(1, n * n) key "${mode}-${n}-${level}-${v}" {
        let p = indexOf(board, v)
        let pr = floor(p / n)
        let pc = p % n
        let br = floor(blank / n)
        let bc = blank % n
        let movable = (pr == br && abs(pc - bc) == 1) || (pc == bc && abs(pr - br) == 1)
        Box {
          width: cell
          height: cell
          offset: [pad + pc * (cell + gap), pad + pr * (cell + gap)]
          animate offset: tween(220ms, "out")
          radius: 12 * corners
          background: won ? alpha(green, 0.28) : movable ? alpha(accent, 0.38) : alpha(accent, 0.12)
          border: 1
          borderColor: alpha(accent, movable ? 0.55 : 0.22)
          onTap: {
            if !won && movable {
              let z = blank
              board = set(set(board, z, v), p, 0)
              moves = moves + 1
              haptic("light")
              if sound { sound(slideSound) }
            }
          }
          Column { fill: true; align: center; justify: center
            Text { text: "${v}"; fontSize: numSize; bold: true; color: won ? green : foreground }
          }
        }
      }

      if won {
        Box {
          fill: true
          radius: 18 * corners
          background: alpha(background, 0.96)
          Column { fill: true; align: center; justify: center; gap: 12
            Text { text: mode == "custom" ? "PUZZLE CLEARED" : level < maxLevel ? "LEVEL ${level} CLEARED" : "ALL LEVELS CLEARED"; style: title; bold: true; color: green; align: center }
            Text { text: "${moves} moves · par ${par}"; color: foreground; align: center }
            Button { text: mode == "custom" || level == maxLevel ? "play again" : "next level"; onTap: {
              let s = random(1000000)
              seed = s
              if mode == "custom" {
                board = [{n: customN, steps: customSteps, s: s}].map(beginCustom)[0]
              } else {
                let lv = level < maxLevel ? level + 1 : 1
                level = lv
                board = [{lv: lv, s: s}].map(begin)[0]
              }
              moves = 0
            } }
          }
        }
      }
    }

    Row { gap: 8
      if mode == "campaign" {
        Button { text: "◀"; onTap: {
          let lv = max(1, level - 1)
          let s = random(1000000)
          level = lv
          seed = s
          board = [{lv: lv, s: s}].map(begin)[0]
          moves = 0
        } }
        Button { text: "new game"; weight: 1; onTap: {
          let s = random(1000000)
          seed = s
          board = [{lv: level, s: s}].map(begin)[0]
          moves = 0
        } }
        Button { text: "▶"; onTap: {
          let lv = min(maxLevel, level + 1)
          let s = random(1000000)
          level = lv
          seed = s
          board = [{lv: lv, s: s}].map(begin)[0]
          moves = 0
        } }
      } else {
        Button { text: "new puzzle"; weight: 1; onTap: {
          let s = random(1000000)
          seed = s
          board = [{n: customN, steps: customSteps, s: s}].map(beginCustom)[0]
          moves = 0
        } }
        Button { text: "campaign"; onTap: {
          mode = "campaign"
          level = 1
          let s = random(1000000)
          seed = s
          board = [{lv: level, s: s}].map(begin)[0]
          moves = 0
        } }
      }
      Button { text: "custom"; onTap: {
        draftN = customN
        draftSteps = customSteps
        view = "setup"
      } }
      Button { text: sound ? "♪ on" : "♪ off"; onTap: {
        sound = !sound
        if sound { sound(slideSound) }
      } }
    }
    Text { text: "tap a tile beside the empty square to slide it"; style: small; color: muted; align: center }
  }
  }

  if view == "setup" {
    Column {
      padding: [16, 12]
      gap: 14

      Column { gap: 2
        Text { text: "custom difficulty"; style: title }
        Text { text: "choose a board and how far to scramble it"; style: small; color: muted }
      }

      Text { text: "presets"; style: label; color: accent }
      Row { gap: 8
        Button { text: "easy"; weight: 1; onTap: { draftN = 3; draftSteps = 25 } }
        Button { text: "normal"; weight: 1; onTap: { draftN = 4; draftSteps = 90 } }
        Button { text: "hard"; weight: 1; onTap: { draftN = 5; draftSteps = 180 } }
        Button { text: "expert"; weight: 1; onTap: { draftN = 6; draftSteps = 300 } }
      }

      Column { gap: 4
        Text { text: "board: ${draftN}×${draftN} · ${draftN * draftN - 1} tiles"; style: small }
        Slider { value: draftN; min: 3; max: 6; step: 1; color: accent; track: background; onChange: draftN = round(value) }
      }

      Column { gap: 4
        Text { text: "scramble: ${draftSteps} moves"; style: small }
        Slider { value: draftSteps; min: 10; max: 400; step: 10; color: accent; track: background; onChange: draftSteps = round(value) }
      }

      Text { text: "par ${draftPar} · every board is solvable"; style: small; color: muted }

      Button { text: "start custom game"; onTap: {
        let s = random(1000000)
        mode = "custom"
        customN = draftN
        customSteps = draftSteps
        seed = s
        board = [{n: draftN, steps: draftSteps, s: s}].map(beginCustom)[0]
        moves = 0
        view = "game"
      } }
      Button { text: "cancel"; color: muted; onTap: view = "game" }
    }
  }
}
