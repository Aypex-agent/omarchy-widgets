app "couch" {
  meta { owl: 23; description: "A movie and TV tracker for Trakt: trending, popular and anticipated titles, cast, seasons and episodes, search; sign in for up next, a calendar, your watchlist, history and ratings"; version: "1.4"; license: "MIT"; category: "media" }
  // A port of Couch for Trakt (github.com/SimonSchubert/omarchy-couch). Not affiliated with Trakt.
  // A title's page, search, history and settings are a level of their own; Back returns to the tab.
  title: open != null ? (open.m.title ?? "") : view == "search" ? str.search : view == "history" ? str.history : view == "settings" ? str.settings : get(str.tabs, tab, tab)
  back: open != null || view != ""
  onBack: { view = len(stack) > 0 ? view : ""; stack = stack.drop(1); season = -1; allEps = false; more = false; unconf = false; confirmOut = false }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <path fill="#73DACA" transform="translate(53.33 186.56) scale(0.16267 -0.16267)" d="M480 611Q480 644 504.5 668.5Q529 693 563 693H709Q744 693 768.5 668.5Q793 644 793 611V521Q756 507 732.5 475.0Q709 443 709 404V318H480ZM209 404V318H438V611Q438 644 413.5 668.5Q389 693 355 693H209Q174 693 149.5 668.5Q125 644 125 611V521Q162 507 185.5 475.0Q209 443 209 404ZM820 484Q789 480 769.5 454.5Q750 429 750 396V277H168V402Q168 437 143.5 461.5Q119 486 84.0 486.0Q49 486 24.5 461.5Q0 437 0 402V193Q0 160 24.5 135.5Q49 111 84 111V27H168V111H750V27H834V111Q869 111 893.5 135.5Q918 160 918 193V402Q918 441 888.5 465.5Q859 490 820 484Z"/>
  </svg>"""

  strings {
    en {
      // How wide a letter is against a Latin one: chips, buttons and badges are sized by it.
      cw: 1
      tabs: {discover: "discover", upnext: "up next", calendar: "calendar", watchlist: "watchlist"}
      search: "search"; history: "history"; settings: "settings"
      needApp: "Signing in needs your own Trakt app: create one at trakt.tv/oauth/applications and add its client ID and secret under Trakt app below."
      cantReach: "Can't reach Trakt."
      noCode: c => "Trakt didn't hand out a code (${c})."
      declined: "Sign-in was declined on Trakt."
      expired: "The code expired. Get a new one."
      usedCode: "That code was already used. Get a new one."
      notAccepted: c => "Trakt didn't accept the sign-in (${c})."
      signedIn: "Signed in"
      signedOutByTrakt: "Trakt signed you out. Sign in again to see your lists."
      wlFail: "Couldn't update your watchlist. Try again in a moment."
      hisFail: "Couldn't change your history. Try again in a moment."
      rateFail: "Couldn't save your rating. Try again in a moment."
      markFail: "Couldn't mark it. Try again in a moment."
      watchFail: "Couldn't mark it watched. Try again in a moment."
      // Discover's chips (small, sized to the text) and the line under them.
      sections: {trending: "trending", popular: "popular", anticipated: "anticipated", watched: "this week", boxoffice: "box office"}
      sectionNotes: {trending: "Most watched on Trakt right now", popular: "Best rated by the most people, all time", anticipated: "Most added to lists, not out yet", watched: "Most watched in the last seven days", boxoffice: "Top 10 at the US box office last weekend"}
      myShows: "my shows"; myMovies: "my movies"; premieres: "premieres"; newShows: "new shows"
      // k: 0 created, 1 directed, 2 written; n: the names.
      crew: (k, n) => k == 0 ? "Created by ${n}" : k == 1 ? "Directed by ${n}" : "Written by ${n}"
      statusWords: {"returning series": "Returning", "in production": "In production", "planned": "Planned", "canceled": "Canceled", "ended": "Ended", "released": "Released", "post production": "Post-production", "upcoming": "Upcoming", "pilot": "Pilot", "rumored": "Rumored"}
      perEp: r => "${r} per ep"
      // A day of a month (m is 1 to 12), and with its year.
      md: (m, d) => "${["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m - 1]} ${d}"
      date: (md, y) => "${md}, ${y}"
      // The facts grid on a title's page: three columns, one line in 11 sp.
      premiered: "Premiered"; released: "Released"; runtime: "Runtime"; statusK: "Status"; network: "Network"; airs: "Airs"; country: "Country"; language: "Language"; episodesK: "Episodes"; rated: "Rated"
      slowDown: "Trakt asked to slow down; try again in a minute."
      answered: c => "Trakt answered ${c}."
      movie: "Movie"; show: "Show"
      episodeN: n => "Episode ${n}"
      notScheduled: "Not scheduled"
      signInPitch: "Sign in with your Trakt account to track episodes, keep a watchlist and see your calendar."
      signInTrakt: "Sign in with Trakt"
      // v is already a number as text, like 1.2K.
      votes: v => "${v} votes"
      removedWl: "Removed from your watchlist"; addedWl: "Added to your watchlist"; signInFirst: "Sign in to Trakt first"
      onWatchlist: "On watchlist"; watchlistBtn: "Watchlist"
      markedWatched: "Marked as watched"; removedHistory: "Removed from your history"
      tapUnwatch: "Tap again to unwatch"; watchedN: n => "Watched ${n}×"; watched: "Watched"; markWatched: "Mark watched"
      trailer: "Trailer"
      yourRatingN: n => "Your rating: ${n}/10"; yourRating: "Your rating"
      less: "Less"; more: "More"
      caughtUp: "All caught up"; yourProgress: "Your progress"
      // 140 dp wide, small text.
      epOf: (a, b) => "${a} of ${b} episodes"
      nextEp: ep => "Next: ${ep}"
      episodes: "Episodes"; specials: "Specials"
      loadingEps: "Loading episodes…"; noEps: "No episodes listed yet"
      epCount: n => "${n} episodes"
      unmarkedN: n => "Unmarked ${n} episodes"; markedN: n => "Marked ${n} episodes"
      seasonWatched: "Season watched"; markSeason: "Mark season"
      showAll: n => "Show all ${n} episodes"
      cast: "Cast"; moreLike: "More like this"; dataFrom: "Data and images from Trakt."
      placeholder: "movies and shows"; searchHint: "search movies and shows"
      all: "all"; movies: "movies"; shows: "shows"
      searching: "Searching…"; results: n => "${n} results"
      noMatch: q => "Nothing matches “${q}”"; tryFewer: "Try fewer words, or the original title."
      trendingNow: "Trending now"
      loading: "Loading…"
      everything: "That's everything"; nothingWatched: "Nothing watched yet"; historyHint: "Movies and episodes you mark watched appear here."
      today: "Today"; yesterday: "Yesterday"; tomorrow: "Tomorrow"
      // Page buttons, 90 dp wide.
      newer: "‹ newer"; older: "older ›"; prev: "‹ prev"; next: "next ›"; page: n => "page ${n}"
      statEpisodes: "episodes"; statHours: "hours"
      profile: "Profile on Trakt"; signedOut: "Signed out"; tapSignOut: "Tap again to sign out"; signOut: "Sign out"
      signInWhy: "Your watchlist, up next, calendar, history and ratings, kept in step with every other Trakt app you use."
      gettingCode: "Getting a code…"; tryAgain: "Try again"; signIn: "Sign in"
      goTo: u => "On any phone or computer, go to ${u} and enter this code:"
      openUrl: u => "Open ${u}"; codeCopied: "Code copied"; copyCode: "Copy code"; cancel: "Cancel"
      waiting: t => "Waiting for you to approve  ·  code valid for ${t}"
      spoilers: "Spoilers"; spoilersHint: "Hide the titles and stories of episodes you haven't watched yet."; showBtn: "Show"; hide: "Hide"
      traktApp: "Trakt app"
      traktAppHint: "Needed to sign in. The built-in app can only read Trakt's public lists, since a client secret can't be kept in public source. Create your own app at trakt.tv/oauth/applications with the redirect URI urn:ietf:wg:oauth:2.0:oob and paste its client ID and secret here. Changing this signs you out."
      useOwn: "Use my own app"; clientId: "Client ID"; clientSecret: "Client secret"; fromApp: "from your app's page on trakt.tv"
      badId: "That client ID doesn't look right"; usingBuiltin: "Using the built-in Trakt app"; usingYours: "Using your Trakt app"
      save: "Save"; useBuiltin: "Use the built-in app"
      about: "About"
      aboutText: "Couch for Trakt 1.0. Movie and show data and images from Trakt (trakt.tv). Couch is an independent app and not affiliated with or endorsed by Trakt."
      source: "Source"
      // n is already a number as text, like 1.2K.
      heroLists: n => "${n} lists"; heroWatching: n => "${n} watching"
      upNextPitch: "See what's next in every show you watch"
      allCaughtUp: "You're all caught up"; upNextHint: "Shows you are watching appear here with their next episode."
      ofLeft: (a, b, c) => "${a} of ${b}  ·  ${c} left"
      markedEp: (t, ep) => "Marked ${t} ${ep} watched"
      calSignIn: "Sign in to see when the shows you watch air next."
      calNoShows: "Nothing airing in the next two weeks"; calNoMovies: "No releases for your movies in the next two months"; calNothing: "Nothing scheduled"
      calHint: "Add shows and movies to your watchlist, or watch an episode, and their dates show up here."
      wlPitch: "Keep a watchlist across all your devices"
      sorts: {added: "recently added", released: "newest", rating: "top rated", title: "A–Z"}
      wlEmpty: "Your watchlist is empty"; wlHint: "Tap Watchlist on any movie or show to save it for later."
      nMovies: n => n == 1 ? "1 movie" : "${n} movies"; nShows: n => n == 1 ? "1 show" : "${n} shows"
      // A poster's badge for a movie not out yet.
      out: md => "Out ${md}"
      span: (a, b, n) => "${a}–${b} of ${n}"
    }
    id {
      cw: 1
      tabs: {discover: "jelajahi", upnext: "berikutnya", calendar: "kalender", watchlist: "daftar tonton"}
      search: "cari"; history: "riwayat"; settings: "pengaturan"
      needApp: "Untuk masuk, kamu perlu aplikasi Trakt sendiri: buat di trakt.tv/oauth/applications lalu tambahkan client ID dan secret-nya di Aplikasi Trakt di bawah."
      cantReach: "Tidak bisa menghubungi Trakt."
      noCode: c => "Trakt tidak memberikan kode (${c})."
      declined: "Masuk ditolak di Trakt."
      expired: "Kode kedaluwarsa. Minta kode baru."
      usedCode: "Kode itu sudah dipakai. Minta kode baru."
      notAccepted: c => "Trakt tidak menerima proses masuk (${c})."
      signedIn: "Sudah masuk"
      signedOutByTrakt: "Trakt mengeluarkanmu. Masuk lagi untuk melihat daftarmu."
      wlFail: "Tidak bisa memperbarui daftar tontonmu. Coba lagi sebentar lagi."
      hisFail: "Tidak bisa mengubah riwayatmu. Coba lagi sebentar lagi."
      rateFail: "Tidak bisa menyimpan nilaimu. Coba lagi sebentar lagi."
      markFail: "Tidak bisa menandainya. Coba lagi sebentar lagi."
      watchFail: "Tidak bisa menandainya sudah ditonton. Coba lagi sebentar lagi."
      sections: {trending: "tren", popular: "populer", anticipated: "dinanti", watched: "minggu ini", boxoffice: "box office"}
      sectionNotes: {trending: "Paling banyak ditonton di Trakt saat ini", popular: "Nilai terbaik dari paling banyak orang, sepanjang masa", anticipated: "Paling banyak masuk daftar, belum rilis", watched: "Paling banyak ditonton tujuh hari terakhir", boxoffice: "10 teratas box office AS akhir pekan lalu"}
      myShows: "serialku"; myMovies: "filmku"; premieres: "tayang perdana"; newShows: "serial baru"
      crew: (k, n) => k == 0 ? "Dibuat oleh ${n}" : k == 1 ? "Disutradarai ${n}" : "Ditulis oleh ${n}"
      statusWords: {"returning series": "Berlanjut", "in production": "Dalam produksi", "planned": "Direncanakan", "canceled": "Dibatalkan", "ended": "Tamat", "released": "Dirilis", "post production": "Pascaproduksi", "upcoming": "Segera", "pilot": "Pilot", "rumored": "Rumor"}
      perEp: r => "${r} per episode"
      md: (m, d) => "${d} ${["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"][m - 1]}"
      date: (md, y) => "${md} ${y}"
      premiered: "Tayang"; released: "Rilis"; runtime: "Durasi"; statusK: "Status"; network: "Jaringan"; airs: "Tayang"; country: "Negara"; language: "Bahasa"; episodesK: "Episode"; rated: "Rating"
      slowDown: "Trakt minta pelan-pelan; coba lagi dalam semenit."
      answered: c => "Trakt menjawab ${c}."
      movie: "Film"; show: "Serial"
      episodeN: n => "Episode ${n}"
      notScheduled: "Belum dijadwalkan"
      signInPitch: "Masuk dengan akun Trakt-mu untuk melacak episode, menyimpan daftar tonton, dan melihat kalendermu."
      signInTrakt: "Masuk dengan Trakt"
      votes: v => "${v} suara"
      removedWl: "Dihapus dari daftar tontonmu"; addedWl: "Ditambahkan ke daftar tontonmu"; signInFirst: "Masuk ke Trakt dulu"
      onWatchlist: "Di daftar tonton"; watchlistBtn: "Daftar tonton"
      markedWatched: "Ditandai sudah ditonton"; removedHistory: "Dihapus dari riwayatmu"
      tapUnwatch: "Ketuk lagi untuk membatalkan"; watchedN: n => "Ditonton ${n}×"; watched: "Ditonton"; markWatched: "Tandai ditonton"
