      yourRatingN: n => "Nilaimu: ${n}/10"; yourRating: "Nilaimu"
      less: "Lebih sedikit"; more: "Selengkapnya"
      caughtUp: "Semua sudah ditonton"; yourProgress: "Progresmu"
