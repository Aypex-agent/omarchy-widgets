      nextEp: ep => "Berikutnya: ${ep}"
      episodes: "Episode"; specials: "Spesial"
      loadingEps: "Memuat episode…"; noEps: "Belum ada episode"
      epCount: n => "${n} episode"
      unmarkedN: n => "${n} episode tidak ditandai lagi"; markedN: n => "${n} episode ditandai"
      seasonWatched: "Musim ditonton"; markSeason: "Tandai musim"
