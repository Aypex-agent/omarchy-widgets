      all: "semua"; movies: "film"; shows: "serial"
      searching: "Mencari…"; results: n => "${n} hasil"
      noMatch: q => "Tidak ada yang cocok dengan “${q}”"; tryFewer: "Coba lebih sedikit kata, atau judul aslinya."
      trendingNow: "Sedang tren"
      loading: "Memuat…"
      everything: "Itu semuanya"; nothingWatched: "Belum ada yang ditonton"; historyHint: "Film dan episode yang kamu tandai ditonton muncul di sini."
      today: "Hari ini"; yesterday: "Kemarin"; tomorrow: "Besok"
      newer: "‹ lebih baru"; older: "lebih lama ›"; prev: "‹ sebelum"; next: "berikut ›"; page: n => "halaman ${n}"
      statEpisodes: "episode"; statHours: "jam"
      profile: "Profil di Trakt"; signedOut: "Sudah keluar"; tapSignOut: "Ketuk lagi untuk keluar"; signOut: "Keluar"
      signInWhy: "Daftar tonton, berikutnya, kalender, riwayat, dan nilaimu, selalu sama dengan semua aplikasi Trakt lain yang kamu pakai."
      gettingCode: "Mengambil kode…"; tryAgain: "Coba lagi"; signIn: "Masuk"
      goTo: u => "Di ponsel atau komputer mana pun, buka ${u} dan masukkan kode ini:"
      openUrl: u => "Buka ${u}"; codeCopied: "Kode disalin"; copyCode: "Salin kode"; cancel: "Batal"
      waiting: t => "Menunggu persetujuanmu  ·  kode berlaku ${t}"
      spoilers: "Spoiler"; spoilersHint: "Sembunyikan judul dan cerita episode yang belum kamu tonton."; showBtn: "Tampilkan"; hide: "Sembunyikan"
      traktApp: "Aplikasi Trakt"
      traktAppHint: "Diperlukan untuk masuk. Aplikasi bawaan hanya bisa membaca daftar publik Trakt, karena client secret tidak bisa disimpan di kode publik. Buat aplikasimu sendiri di trakt.tv/oauth/applications dengan redirect URI urn:ietf:wg:oauth:2.0:oob lalu tempel client ID dan secret-nya di sini. Mengubah ini membuatmu keluar."
      useOwn: "Pakai aplikasiku sendiri"; clientId: "Client ID"; clientSecret: "Client secret"; fromApp: "dari halaman aplikasimu di trakt.tv"
      badId: "Client ID itu sepertinya salah"; usingBuiltin: "Memakai aplikasi Trakt bawaan"; usingYours: "Memakai aplikasi Trakt-mu"
      save: "Simpan"; useBuiltin: "Pakai aplikasi bawaan"
      about: "Tentang"
      aboutText: "Couch for Trakt 1.0. Data dan gambar film dan serial dari Trakt (trakt.tv). Couch adalah aplikasi independen dan tidak berafiliasi dengan atau didukung oleh Trakt."
      source: "Kode sumber"
      heroLists: n => "${n} daftar"; heroWatching: n => "${n} menonton"
      upNextPitch: "Lihat apa berikutnya di setiap serial yang kamu tonton"
      allCaughtUp: "Semua sudah kamu tonton"; upNextHint: "Serial yang sedang kamu tonton muncul di sini dengan episode berikutnya."
      ofLeft: (a, b, c) => "${a} dari ${b}  ·  sisa ${c}"
      markedEp: (t, ep) => "${t} ${ep} ditandai ditonton"
      calSignIn: "Masuk untuk melihat kapan serial yang kamu tonton tayang berikutnya."
      calNoShows: "Tidak ada yang tayang dua minggu ke depan"; calNoMovies: "Tidak ada rilis untuk filmmu dua bulan ke depan"; calNothing: "Tidak ada jadwal"
      calHint: "Tambahkan serial dan film ke daftar tontonmu, atau tonton satu episode, dan tanggalnya muncul di sini."
      wlPitch: "Simpan daftar tonton di semua perangkatmu"
      sorts: {added: "baru ditambah", released: "terbaru", rating: "nilai teratas", title: "A–Z"}
      wlEmpty: "Daftar tontonmu kosong"; wlHint: "Ketuk Daftar tonton di film atau serial mana pun untuk menyimpannya."
      nMovies: n => "${n} film"; nShows: n => "${n} serial"
      out: md => "Rilis ${md}"
      span: (a, b, n) => "${a}–${b} dari ${n}"
