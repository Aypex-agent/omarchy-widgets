    es {
      cw: 1
      tabs: {discover: "descubrir", upnext: "a continuación", calendar: "calendario", watchlist: "pendientes"}
      search: "buscar"; history: "historial"; settings: "ajustes"
      needApp: "Para iniciar sesión necesitas tu propia app de Trakt: crea una en trakt.tv/oauth/applications y añade su client ID y secret en App de Trakt, abajo."
