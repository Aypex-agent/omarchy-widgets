      statusWords: {"returning series": "Continúa", "in production": "En producción", "planned": "Planeada", "canceled": "Cancelada", "ended": "Finalizada", "released": "Estrenada", "post production": "Posproducción", "upcoming": "Próximamente", "pilot": "Piloto", "rumored": "Rumoreada"}
      perEp: r => "${r} por ep."
