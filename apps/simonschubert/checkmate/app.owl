app "checkmate" {
  // Mate-in-two and mate-in-three puzzles, the kind that go round as "black to move and mate in two":
  // a few pieces, and a first move that's quiet or a sacrifice, never a plain check or capture.
  //
  //   tap      a piece, then where it goes. The other side answers with its best defence, whatever
  //            you played, and only once your last move is on the board does it say whether that
  //            was mate; when it wasn't, the other side moves once more to show it.
  //   restart  the puzzle from its first position, once you've moved
  //
  // The 60 positions come from the Lichess puzzle database (database.lichess.org, CC0), picked so that
  // no two are much alike (the piece that starts it, the one that mates, the pattern), and each one
  // checked to have a single winning first move and no shorter mate. They're played from the moment
  // the solver is to move, and get harder down the list. Any last move that mates counts.
  // Pieces: Colin M.L. Burnett's set from Wikimedia Commons (BSD).

  meta { owl: 14; description: "Mate in two or three: 60 chess puzzles, each unlike the others, from easy to hard, played out to the end against the best defence"; version: "1.1.1"; license: "MIT"; category: "games" }

  // The header below is the title: no title row.
  title: ""
  // a white king on a patch of board, with the mark for mate
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <g transform="translate(122 190) scale(1.25 0.62) rotate(45)">
      <rect x="-64" y="-64" width="128" height="128" fill="#ECE3D3"/>
      <path d="M-32 -64h32v32h-32zM32 -64h32v32h-32zM-64 -32h32v32h-32zM0 -32h32v32h-32zM-32 0h32v32h-32zM32 0h32v32h-32zM-64 32h32v32h-32zM0 32h32v32h-32z" fill="#A88865"/>
    </g>
    <g transform="translate(25 14) scale(4.3)" fill="none" stroke="#1A1B26" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
      <path stroke="#F5F0E6" stroke-linejoin="miter" stroke-width="2.4" d="M22.5 11.63V5M19.5 8h6"/>
      <path fill="#F5F0E6" stroke-linecap="butt" stroke-linejoin="miter" d="M22.5 25s4.5-7.5 3-10.5c0 0-1-2.5-3-2.5s-3 2.5-3 2.5c-1.5 3 3 10.5 3 10.5"/>
      <path fill="#F5F0E6" d="M12.5 37c5.5 3.5 14.5 3.5 20 0v-7s9-4.5 6-10.5c-4-6.5-13.5-3.5-16 4V27v-3.5c-2.5-7.5-12-10.5-16-4-3 6 6 10.5 6 10.5v7"/>
      <path d="M12.5 30c5.5-3 14.5-3 20 0m-20 3.5c5.5-3 14.5-3 20 0m-20 3.5c5.5-3 14.5-3 20 0"/>
    </g>
    <circle cx="200" cy="58" r="32" fill="#F7768E"/>
    <path d="M189 43l-5 30M206 43l-5 30M180 52h30M177 64h30" stroke="#1A1B26" stroke-width="6.5" stroke-linecap="round"/>
  </svg>"""

  source now = clock every 1s

  state at = 0 persist
  // the puzzles solved at the first go, and how many of those in a row
  state done = [] persist
  state streak = 0 persist
  state best = 0 persist

  // The board is 64 one-letter squares from a8 to h1, "." for an empty one, letters as in a FEN.
  state board = []
  state last = []
  state ep = -1
  state sel = -1
  // the solver's moves so far, run together as the replies' keys, and how many
  state upath = ""
  state uply = 0
  // the answer about to be played, at replyAt
  state pending = ""
  state replyAt = 0
  // "", then mate, miss, mated or stalemate once it's over
  state result = ""
  // restarts of this puzzle; a solve after one doesn't count
  state again = 0
  state note = ""
  // a move to play on the board, coded as in the puzzles below; n makes the same move twice a change
  state mv = {m: "", n: 0}
  state tap = {x: 0, y: 0, n: 0}

  // [id, board, side to move, mate in, solution, en passant square, rating, replies]
  // A square is one letter of AL, a8 first and h1 last, and a move is its two squares, with :q
  // after a promotion (or :r, :b, :n). The replies are the defence's best answer to every legal
  // move, worked out with python-chess: "<moves so far><move>>reply" for one move,
  // "<moves so far>*>reply" for every other one, "F>reply" for any the others leave out, and
  // "<moves so far>=a,b" for the moves that mate when one is left. A reply of # means that move
  // mates, = that it stalemates; ! after a reply means it mates the solver, ~ that it stalemates them.
  let PUZZLES = [
    ["NSBCR", "8/1Q3pk1/2p5/4n3/3R3N/6BP/r3q1PK/8", "b", 2, "ct nt 02", -1, 1308,
      "F>jD *>JC OP*>nt OP02>n2 OPcm>vm OX*>nt OX02>n2 OXcm>vm OV*>nt OV02>n2 OVcm>vm cL*>nW cL02>n2 cW*>ul cW02>n2 cm>3- cm*>u1 cm08>u8 cm07>u8 cmw4>u8 cm02>n2 cm09>-9 ci*>nW ci02>n2 ct>nt ct=02 cr*>nW cr02>n2 0Q*>nt 0Qcm>3_ 0Qw2>3_ 0f*>3_ 0ff7>nW 0fw4>nW 0Z*>nt 0Zcm>3_ 0Zw2>3_ 0m*>3_ 0mm7>nW 0mw4>nW 0mmv>3v 0k*>nt 0kcm>3_ 0kkn>3_ 0kw2>3_ 0kk2>n2 0i*>nt 0icm>3_ 0iw2>3_ 0t*>nW 0tcm>3_ 0ttu>3_ 0tw2>3_ 0tt2>n2 0s*>nt 0scm>3_ 0ssu>3_ 0sw2>3_ 0ss->3- 0r*>nt 0rcm>3_ 0rru>3_ 0rw2>3_ 02>n2 02*>3_ 02w4>vn 01*>nt 01cm>3_ 011u>3_ 0112>n2 011->3- 0z*>nt 0zz2>n2 0zcm>vm 0y*>nt 0yy2>n2 0ycm>vm 0x*>nt 0xx2>n2 0xcm>vm 09*>nt 09w2>n2 0992>n2 09cm>vm 099_>3_ 099->3- 08*>nt 088u>3_ 088_>3_ 08w2>n2 08cm>vm 088->3- 07*>nt 07w2>n2 07cm>vm 077_>3_ 077->3- wA*>nt wA02>n2 wAcm>vm wI*>nt wI02>n2 wIcm>vm wQ*>nt wQ02>n2 wQcm>vm wY*>nt wY02>n2 wYcm>vm wg*>nt wg02>n2 wgcm>vm wo*>nt wo02>n2 wocm>vm wz*>nt wz02>n2 wzcm>vm wy*>nt wy02>n2 wycm>vm wx*>nt wx02>n2 wxcm>vm w4*>nt w402>n2 w4cm>vm w44_>3_ Sa*>nt Sa02>n2 Sacm>vm"],
    ["UMLhc", "6k1/1r3ppp/p1q5/3p4/P1n5/6QP/5PP1/1R4K1", "w", 3, "uB JB 5B SC BC", -1, 1308,
      "F>SE *>GH uB>JB uB*>GH uB5B>SC uB5B=BC uB5B*>PX uB5J*>HG uB5JJB>SE uB5R*>HG uB5RRB>SE uO>GO uO*>OH uO5J*>HG uO5JJB>HO uO5R*>HG uK>GF uK*>FG uKKD>SE uKKD*>FG uKKDDE>FE uKKC>FM uKKC*>MV uKKCCD>MD uKKCCU>MD uKKCCS>MD uKKCCd>MD uKKB>FM uKKB*>MV uKKBBD>MD uKKBBc>MD uKKBBl>MD uKKBBT>ME uKKN>FN uKKN*>NG uKKM*>GH uKKMME>SE uKKMMD>SE uKKMMF>GF uKKL*>GH uKKLLE>SE uKKLLD>SE uKKLLC>SE uKKJ*>GH uKKJJC>SE uKKJJB>SE uKKJJA>SE uKKT*>GH uKKTTD>SE uKKTTB>SE uKKTTF>GF uKKS>FM uKKS*>MF uKKSSE>MV uKKSSC>MV uKKSSa>MV uKKSST>ME uKKR*>PX uKKRRD>SE uKKc*>SE uKKccO>GO uKKl*>GH uKKllB>SE uKKu*>SE uKKuuO>GO uK-3*>GH uK-3KD>SE uK-3KC>SE uK-3KB>SE uK-_*>GH uK-_KD>SE uK-_KC>SE uK-_KB>SE uK-9*>GH uK-9KD>SE uK-9KC>SE uK-9KB>SE uK5J*>SE uK5JKN>GH uK5JKL>GH uK5JKS>GH uK5R*>GH uK5RKD>SE uK5RKC>SE uK5RKB>SE uK5Z*>GH uK5ZKD>SE uK5ZKC>SE uK5ZKB>SE uK5h*>GH uK5hKD>SE uK5hKC>SE uK5hKB>SE uK5p*>GH uK5pKD>SE uK5pKC>SE uK5pKB>SE uK5x*>GH uK5xKD>SE uK5xKC>SE uK5xKB>SE uK59*>GH uK59KD>SE uK59KC>SE uK59KB>SE uK58*>SE uK58KN>GH uK58KL>GH uK58KS>GH uK57*>GH uK57KD>SE uK57KC>SE uK57KB>SE uK56*>GH uK56KD>SE uK56KC>SE uK56KB>SE uK54*>GH uK54KD>SE uK54KC>SE uK54KB>SE uKgY*>GH uKgYKD>SE uKgYKC>SE uKgYKB>SE uKvn*>GH uKvnKD>SE uKvnKC>SE uKvnKB>SE uK2u*>GH uK2uKD>SE uK2uKC>SE uK2uKB>SE uK1t*>GH uK1tKD>SE uK1tKC>SE uK1tKB>SE uK2m*>GH uK2mKD>SE uK2mKC>SE uK2mKB>SE uK1l*>GH uK1lKD>SE uK1lKC>SE uK1lKB>SE uW*>HG uWWP>HP uWWO>HO uWWN>JB uWWN*>SE uWWNNG>HG uWWNNL>HG uWWNNO>HO uWWNNF>BF uWWX*>GH uWWXXP>GP uWWXXO>GO uWWV*>GH uWWVVO>GO uWWVVD>SE uWWU*>GH uWWUUE>SE uWWUUC>SE uWWT*>GH uWWTTD>SE uWWTTB>SE uWWTTF>GF uWWS>JM uWWS*>ME uWWf*>GH uWWffP>GP uWWe*>SE uWWeeO>GO uWWd*>GH uWWddP>GP uWWddC>SE uWWm*>SC uWWmmO>GO uWWk*>SE uWWkkP>GP uWWu*>SE uWWuuO>GO uWWr*>PX uWWrrP>GP uWWy*>GF uW-3*>GH uW-3WP>GP uW-3WO>GO uW-_*>GH uW-_WP>GP uW-_WO>GO uW-9*>GH uW-9WP>GP uW-9WO>GO uW5J*>GH uW5JWP>GP uW5JWO>GO uW5JJB>SE uW5R*>GH uW5RWP>GP uW5RWO>GO uW5Z*>GH uW5ZWP>GP uW5ZWO>GO uW5h*>GH uW5hWP>GP uW5hWO>GO uW5p*>GH uW5pWP>GP uW5pWO>GO uW5x*>GH uW5xWP>GP uW5xWO>GO uW59*>GH uW59WP>GP uW59WO>GO uW58*>GH uW58WP>GP uW58WO>GO uW588E>SE uW57*>GH uW57WP>GP uW57WO>GO uW56*>GH uW56WP>GP uW56WO>GO uW54*>GH uW54WP>GP uW54WO>GO uWgY*>GH uWgYWP>GP uWgYWO>GO uWvn*>GH uWvnWP>GP uWvnWO>GO uW2u*>GH uW2uWP>GP uW2uWO>GO uW1t*>GH uW1tWP>GP uW1tWO>GO uW2m*>GH uW2mWP>GP uW2mWO>GO uW1l*>GH uW1lWP>GP uW1lWO>GO uT>JM uT*>GH uTTD>ME uTTD*>PX uTTDDE>SE uTTB>ME uTTB*>PX uTTBBE>SE uTTM>SC uTTM*>GH uTTMMF>GF uTTMME>CE uTTMMD>CD uTTL*>ME uTTLLM>HG uTTK*>ME uTTKKM>HG uTTX*>ME uTTXXP>HP uTTXXO>HO uTTW*>ME uTTWWP>HP uTTWWO>HO uTTV*>ME uTTVVM>HG uTTVVO>HO uTTU*>ME uTTUUM>HG uTTS*>ME uTTc*>SE uTTccO>HO uTTb*>ME uTTa*>HG uTTa5B>ME uTTu*>ME uTTuuO>HO uT-3*>ME uT-3TM>HG uT-_*>ME uT-_TM>HG uT-9*>ME uT-9TM>HG uT5B>ME uT5B*>EF uT5BBE>SE uT5J*>ME uT5JJM>HG uT5JTM>HG uT5R*>ME uT5RTM>HG uT5Z*>ME uT5ZTM>HG uT5h*>ME uT5hTM>HG uT5p*>ME uT5pTM>HG uT5x*>ME uT5xTM>HG uT59*>ME uT59TM>HG uT58*>HG uT58TD>ME uT58TB>ME uT57*>ME uT57TM>HG uT56*>ME uT56TM>HG uT54*>ME uT54TM>HG uTgY*>ME uTgYTM>HG uTvn*>ME uTvnTM>HG uT2u*>ME uT2uTM>HG uT1t*>ME uT1tTM>HG uT2m*>ME uT2mTM>HG uT1l*>ME uT1lTM>HG ue>GF ue*>FG ueeD>SE ueeD*>FG ueeDDE>FE ueeO>FE ueeO*>EL ueeOON>ED ueeOOm>ED ueeO5J>ED ueeM*>GH ueeMME>SE ueeMMD>SE ueeMMF>GF ueeX*>GH ueeXXP>GP ueeXXO>GO ueeW*>GH ueeWWP>GP ueeWWO>GO ueeV*>GH ueeVVO>GO ueeVVD>SE ueef*>GH ueeffP>GP ueed*>GH ueeddP>GP ueeddC>SE ueec*>SE ueeccO>GO ueeb*>GH ueebbD>SE ueen*>SE ueennP>GP ueem*>SC ueemmO>GO ueel*>GH ueellB>SE ueeu*>SE ueeuuO>GO ue-3*>SE ue-3eO>GO ue-_*>SE ue-_eO>GO ue-9*>SE ue-9eO>GO ue5J*>SE ue5JJL>PX ue5JeO>GO ue5R*>GH ue5ReO>GO ue5ReD>SE ue5Z*>SE ue5ZeO>GO ue5h*>SE ue5heO>GO ue5p*>SE ue5peO>GO ue5x*>SE ue5xeO>GO ue59*>SE ue59eO>GO ue58*>SE ue58eO>GO ue57*>SE ue57eO>GO ue56*>SE ue56eO>GO ue54*>SE ue54eO>GO uegY*>SE uegYeO>GO uevn*>SE uevneO>GO ue2u*>SE ue2ueO>GO ue1t*>SE ue1teO>GO ue2m*>SE ue2meO>GO ue1l*>SE ue1leO>GO uc*>HG uccE>SE uccE*>HG uccB>JB uccO>HO uccM*>GH uccMME>SE uccMMD>SE uccMMF>GF uccK*>GH uccKKD>SE uccKKC>SE uccKKB>S