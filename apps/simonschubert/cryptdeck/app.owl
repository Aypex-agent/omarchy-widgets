  let SHC = range(6).map(j => {x: SHX + (j % 3) * (SCW + 12), y: TOP + 84 + floor(j / 3) * (SCH + 30), w: SCW, h: SCH})
  let SRY = TOP + 84 + 2 * (SCH + 30) + 2
  let SHR = range(2).map(j => {x: 14 + j * ((SW - 38) / 2 + 10), y: SRY, w: (SW - 38) / 2, h: 64})
