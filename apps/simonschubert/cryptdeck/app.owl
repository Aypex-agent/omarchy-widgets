app "cryptdeck" {
  // A deckbuilder roguelite in pixel art. A knight climbs three acts of a crypt, each a branching
  // map of fights, elites, campfires, shops, chests and strange rooms, with a boss at the top. Fights
  // are played with a deck of cards: three energy a turn, five cards drawn, and every enemy shows
  // what it means to do next. Won fights offer a card to add; elites and chests give relics, which
  // change the rules for the rest of the run. Every card taken also joins a collection that outlasts
  // the run, from which the deck a run starts with is built, and a free pack of cards comes each
  // day and with each boss beaten. Taps only, and nothing is timed.
  //
  // There's no game loop: a card or the end of a turn resolves at once, in a handler or a trigger,
  // and leaves timed events (`fx`) for the canvases to play: slashes, hits, blocks and banners.
  // Triggers stand in for functions: `startQ` sets a fight up, `turnQ` starts the knight's turn,
  // `drawQ` draws `drawN` cards, `endQ` plays the enemies' turn, `winQ` hands out the spoils and
  // `gainQ` gives the relic `gainR`.

  meta { owl: 23; description: "A pixel-art deckbuilder roguelite: climb a three-act crypt, pick your path on a branching map, collect relics and beat the bosses, with a card collection that grows every run; taps only"; version: "1.2"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges"><defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath></defs><g clip-path="url(#t)"><rect width="256" height="256" fill="#24202e"/><rect x="0" y="176" width="256" height="80" fill="#2e2a3a"/></g><rect x="40" y="36" width="120" height="168" rx="10" fill="#14121c" transform="rotate(-10 100 120)"/><rect x="48" y="44" width="104" height="152" rx="6" fill="#3a62a8" transform="rotate(-10 100 120)"/><rect x="96" y="40" width="124" height="172" rx="10" fill="#14121c"/><rect x="104" y="48" width="108" height="156" rx="6" fill="#ffd04a"/><rect x="110" y="54" width="96" height="144" rx="4" fill="#a83a3a"/><rect x="118" y="62" width="80" height="62" fill="#6a2026"/><rect x="116" y="134" width="84" height="56" rx="3" fill="#efe4c8"/><rect x="128" y="146" width="60" height="8" fill="#14121c"/><rect x="136" y="164" width="44" height="8" fill="#14121c"/><path fill="#14121c" d="M178 66h12v6h-6v6h-6v6h-6v6h-6v6h-6v6h-6v6h-6v6h6v6h-6v-6h-6v6h-6v-6h6v-6h6v-6h6v-6h6v-6h6v-6h6v-6h6v-6h6z"/><path fill="#eef2fa" d="M178 72h6v6h-6v6h-6v6h-6v6h-6v6h-6v6h-6v-6h6v-6h6v-6h6v-6h6v-6h6z"/><path fill="#c08a30" d="M136 114h6v6h-6zM130 120h6v6h-6z"/><circle cx="110" cy="56" r="18" fill="#14121c"/><circle cx="110" cy="56" r="14" fill="#ffd04a"/><rect x="106" y="48" width="8" height="16" fill="#14121c"/></svg>"""

  strings {
    en {
      // Everything is upper case, in a pixel font. A card's name sits in a 54 px strip and shrinks to fit,
      // so keep names short (15 letters at most); its rules lines shrink to fit 104 px too.
      cards: ["STRIKE", "DEFEND", "BASH", "CLEAVE", "TWIN STRIKE", "IRON WAVE", "POMMEL STRIKE", "SHRUG IT OFF", "ANGER", "CLOTHESLINE", "THUNDERCLAP", "BODY SLAM", "WAR CRY", "HEMOKINESIS", "UPPERCUT", "INFLAME", "METALLICIZE", "SEEING RED", "ENTRENCH", "FLAME BARRIER", "HEAVY BLADE", "SHOCKWAVE", "BATTLE TRANCE", "CARNAGE", "DEMON FORM", "BLUDGEON", "IMPERVIOUS", "OFFERING", "BARRICADE", "LIMIT BREAK", "THORN CAGE", "SLIMED", "SOUL REND", "EXECUTE", "BLOOD OATH", "SPECTRAL BLADES", "CRYPT LANTERN", "MIRROR WARD"]
      // Relics: a name and what it does (one line, at most about 40 letters).
      relicN: ["BURNING BLOOD", "ANCHOR", "BAG OF MARBLES", "LANTERN", "VAJRA", "ORICHALCUM", "BLOOD VIAL", "SHURIKEN", "HAPPY FLOWER", "BRONZE SCALES", "GOLDEN IDOL", "MEAL TICKET", "STRAWBERRY", "ICE CREAM", "HORN CLEAT", "PUZZLE BOX", "PREP BAG", "PILLOW", "HOURGLASS", "PEAR", "ETERNAL FLAME", "OLD TOME", "BLACK BLOOD"]
      relicD: ["HEAL 6 AFTER A FIGHT", "10 BLOCK ON TURN 1", "ENEMIES START VULNERABLE", "+1 ENERGY ON TURN 1", "START FIGHTS WITH 1 STRENGTH", "NO BLOCK AT TURN END: GAIN 6", "HEAL 2 AS A FIGHT STARTS", "EVERY 3RD ATTACK IN A TURN: +1 STR", "+1 ENERGY EVERY 3RD TURN", "ATTACKERS TAKE 3 DAMAGE", "25% MORE GOLD FROM FIGHTS", "HEAL 15 ON ENTERING A SHOP", "+7 MAX HP", "UNUSED ENERGY CARRIES OVER", "14 BLOCK ON TURN 2", "FIRST HP LOST IN A FIGHT: DRAW 3", "DRAW 2 MORE ON TURN 1", "RESTING HEALS 15 MORE", "3 DAMAGE TO ALL EACH TURN", "+10 MAX HP", "+1 ENERGY EVERY TURN", "DRAW 1 MORE EVERY TURN", "HEAL 12 MORE AFTER A FIGHT"]
      foes: ["SLIME", "RAT", "CULTIST", "JAW WORM", "SKELETON", "BAT", "SHROOM", "DARK KNIGHT", "GOLEM", "THE LICH", "THE WYRM", "THE EYE"]
      acts: ["THE CRYPT", "THE CATACOMBS", "THE ABYSS"]
      // The strange rooms: a name, two lines of what's there (about 22 letters each), and the two choices.
      evN: ["SHRINE", "FOUNTAIN", "GAMBLER", "FORGE"]
      evT: [["A STONE SHRINE HUMS", "WITH A FAINT LIGHT."], ["CLEAR WATER BUBBLES", "UP OUT OF THE ROCK."], ["A HOODED FIGURE", "SHUFFLES A DECK."], ["AN ABANDONED ANVIL", "STILL GLOWS RED."]]
      evA: ["PRAY: LOSE 7 HP FOR A RELIC", "DRINK", "PAY 50 GOLD FOR A RARE CARD", "UPGRADE A CARD"]
      evB: ["LEAVE IT BE", "BATHE: REMOVE A CARD", "WALK AWAY", "SEARCH THE ASHES: 35 GOLD"]
