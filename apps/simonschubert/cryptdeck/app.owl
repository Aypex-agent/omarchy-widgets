  let PKC = range(len(pk)).map(j => {x: SW / 2 - (240 * RWS + 20) / 2 + j * (80 * RWS + 10), y: RY + 176})
  // building the deck: every kind of card owned, a row each with − and + at its ends
  let BLC = range(len(CD)).filter(c => OWN[c] > 0).sortBy(c => CD[c].r * 100 + c)
  let BCOL = LS ? 4 : 2
  let BTW = (SW - 24 - (BCOL - 1) * 8) / BCOL
  let BY0 = TOP + 70
  let BRH = clamp(floor((SH - INS - 80 - BY0) / max(1, ceil(len(BLC) / BCOL))) - 6, 20, 40)
  let BLT = range(len(BLC)).map(j => {c: BLC[j], x: 12 + (j % BCOL) * (BTW + 8), y: BY0 + floor(j / BCOL) * (BRH + 6), w: BTW, h: BRH})
