      pickRoom: "SCEGLI LA PROSSIMA STANZA"
      tagline: "UN DUNGEON DI CARTE"
      draw: "PESCA"
      discard: "SCARTI"
      noEnergy: "ENERGIA INSUFFICIENTE"
      tapEnemy: "TOCCA UN NEMICO"
      tapAgain: "TOCCA DI NUOVO LA CARTA PER GIOCARLA"
      victory: "VITTORIA"
      plusGold: n => "+${n} ORO"
      plusPack: "+1 BUSTINA DI CARTE"
      takeCard: "PRENDI UNA CARTA"
      bossRelic: "SCEGLI UNA RELIQUIA DEL BOSS"
      wayDown: "LA VIA VERSO IL BASSO SI APRE"
      campfire: "FALÒ"
      restHere: "RIPOSA QUI, O AFFILA UNA CARTA"
      treasure: "TESORO"
      merchant: "MERCANTE"
      sold: "VENDUTO"
      victoryBang: "VITTORIA!"
      youDied: "SEI MORTO"
      cleared: "LA CRIPTA È LIBERA"
      actFloor: (a, f) => "ATTO ${a}, PIANO ${f}"
      runStats: (cards, relics, gold) => "${cards} CARTE · ${relics} RELIQUIE · ${gold} ORO"
      runsWon: n => "PARTITE VINTE: ${n}"
      best: (a, f) => "RECORD: ATTO ${a}, PIANO ${f}"
      packOf: "UNA BUSTINA DI CARTE"
      joinColl: "ENTRANO NELLA TUA COLLEZIONE"
      newBang: "NUOVA!"
      yourDeck: "IL TUO MAZZO"
      buildHelp1: "CON QUESTO INIZIA OGNI PARTITA. LE CARTE"
      buildHelp2: "DI PARTITE E BUSTINE FINISCONO QUI. TOCCA UN NOME PER VEDERLA"
      removeCard: "TOGLI UNA CARTA"
      drawPile: n => "MAZZO DI PESCA (${n})"
      discPile: n => "SCARTI (${n})"
      deckOf: n => "IL TUO MAZZO (${n})"
      nothingHere: "QUI NON C'È NIENTE"
      upgraded: "MIGLIORATA"
      tapBack: "TOCCA OVUNQUE PER TORNARE"
      dmgBlockN: n => "DANNI = PARATA ${n}"
      dmgBlock: "DANNI = PARATA"
      dmg: (n, times, all) => "DANNI ${n}${times > 1 ? " x${times}" : ""}${all ? " A TUTTI" : ""}"
      strCounts: n => "FOR CONTA x${n}"
      blockN: n => "PARATA ${n}"
      doubleBlock: "RADDOPPIA LA PARATA"
      vulnN: (n, all) => "VULNERABILE ${n}${all ? " A TUTTI" : ""}"
      weakN: (n, all) => "DEBOLE ${n}${all ? " A TUTTI" : ""}"
      strength: n => "+${n} FORZA"
      doubleStr: "RADDOPPIA LA FORZA"
      strEachTurn: n => "+${n} FOR OGNI TURNO"
      blockEachTurn: n => ["${n} PARATA A OGNI", "FINE TURNO"]
      thorns: n => "SPINE ${n}"
      thornsTurn: n => "SPINE ${n} QUESTO TURNO"
      keepBlock: ["LA PARATA NON", "SVANISCE PIÙ"]
      loseHp: n => "PERDI ${n} PV"
      drawN: n => "PESCA ${n}"
      copyLine: ["UNA COPIA VA", "NEI TUOI SCARTI"]
      exeLine: ["DOPPIO SUI NEMICI", "SOTTO METÀ PV"]
      drainLine: ["CURA I DANNI", "CHE PASSANO"]
      clogs: "INTASA LA MANO"
      exhaust: "ESAURISCI"
    }
  }

  // "title", "map", "fight", "reward", "rest", "shop", "chest", "event", "end", "build" (the deck
  // a run starts with) or "pack" (one being opened)
  state mode = "title" persist
  // where Continue on the title goes back to
  state rmode = "" persist
  // the run: the act (0 to 2), health, gold, the deck, the relics
  state act = 0 persist
  state hp = 80 persist
  state mhp = 80 persist
  state gold = 99 persist
  state deck = [] persist
  state relics = [] persist
  // the act's map comes from `seed`; `pos` is the room the knight is in (-1 before the first)
  state seed = 0 persist
  state pos = -1 persist
  state seen = [] persist
  // runs won, and the furthest floor reached (13 a act)
  state wins = 0 persist
  state best = 0 persist
  // the fight: its kind (0 a fight, 1 an elite, 2 the boss), who's in it, the enemies, the knight's
  // block, strength, debuffs, powers and energy, and the piles
  state fk = 0 persist
  state grp = [] persist
  state en = [] persist
  state pl = {} persist
  state drw = [] persist
  state hand = [] persist
  state disc = [] persist
  state exh = [] persist
  state sel = -1
  // the spoils: cards to pick from, the gold and relic won, and the boss relics to choose between
  state offer = [] persist
  state rwG = 0 persist
  state rwR = -1 persist
  state bossR = [] persist
  // the shop's stock, what taking a card out costs, and whether it's been done this visit
  state shop = [] persist
  state rmc = 75 persist
  state rmDone = false persist
  state rested = false persist
  // the event, and what came of it
  state evt = 0 persist
  state evr = "" persist
  // the cards owned for good, a count of each kind, and how many of each a new run starts with;
  // empty is a new player's (see OWN and SD)
  state coll = [] persist
  state sdeck = [] persist
  // a free pack a day (`packDay` is the day the last one was opened) and one for each boss beaten;
  // `pk` is the pack being opened, and `bv` a card looked at while building the deck
  state packDay = "" persist
  state packs = 0 persist
  state pk = [] persist
  state bv = -1
  source wall = clock every 1m
  // the deck shown over everything: "deck", "draw", "disc", "up" (pick one to upgrade) or "rm" (to remove)
  state dv = ""
  state dvs = -1
  // the relic whose name shows
  state tip = -1
  // what the canvases play, in seconds from `fxAt`; `fxAt` is -1 until the next frame sets it
  state fx = []
  state fxAt = -100
  state fxTap = 0
  state fxDur = 0
  // where the timeline has got to, for a trigger adding to it
  state fxT = 0
  // true while the enemies' turn or a fight's end plays; taps wait
  state busy = false
  // "p" the knight's turn, "e" the enemies'
  state phase = "p"
  state downAt = [-1, -1]
  // triggers, bumped to run
  state startQ = 0
  state turnQ = 0
  state drawQ = 0
  state drawN = 0
  state endQ = 0
  state winQ = 0
  state gainQ = 0
  state gainR = -1

  // a frame after a tap: a tap's own `time` can be off the frame clock
  when fxAt == -1 && time != fxTap { fxAt = time }
  when busy && fxAt >= 0 && (time > fxAt + fxDur || time < fxAt - 1) {
    busy = false
    phase = "p"
  }

  // ---- the screen, in dp ------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  // held sideways, the fight's controls go beside the hand and the map runs left to right
  let LS = SW > SH
  let TOP = max(screenTop ?? 0, 10) + 4
  let INS = max(screenInset ?? 0, 12)
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"

  // ---- the cards --------------------------------------------------------------------------------
  // e cost; t 0 attack, 1 skill, 2 power, 3 status; r 0 starter, 1 common, 2 uncommon, 3 rare;
  // i its picture. d damage (x times, to all), b block, dr draw, en energy, v vulnerable, w weak,
  // s strength, hp health lost, ex exhausts; ps strength each turn, pb block at the turn's end,
  // pt thorns, ft thorns this turn; sp: slam (damage = block), copy, dbl (double block), keep
  // (block stays), x2 (double strength), exe (double on a foe below half health), drain (heals the
  // damage that gets through); sm strength counts that many times. u: what an upgrade changes.
  let CD = [
    {n: str.cards[0], e: 1, t: 0, r: 0, i: 0, d: 6, u: {d: 9}},
    {n: str.cards[1], e: 1, t: 1, r: 0, i: 1, b: 5, u: {b: 8}},
    {n: str.cards[2], e: 2, t: 0, r: 0, i: 2, d: 8, v: 2, u: {d: 10, v: 3}},
    {n: str.cards[3], e: 1, t: 0, r: 1, i: 3, d: 8, all: true, u: {d: 11}},
    {n: str.cards[4], e: 1, t: 0, r: 1, i: 4, d: 5, x: 2, u: {d: 7}},
    {n: str.cards[5], e: 1, t: 0, r: 1, i: 5, d: 5, b: 5, u: {d: 7, b: 7}},
    {n: str.cards[6], e: 1, t: 0, r: 1, i: 0, d: 9, dr: 1, u: {d: 10, dr: 2}},
    {n: str.cards[7], e: 1, t: 1, r: 1, i: 1, b: 8, dr: 1, u: {b: 11}},
    {n: str.cards[8], e: 0, t: 0, r: 1, i: 6, d: 6, sp: "copy", u: {d: 8}},
    {n: str.cards[9], e: 2, t: 0, r: 1, i: 2, d: 12, w: 2, u: {d: 14, w: 3}},
    {n: str.cards[10], e: 1, t: 0, r: 1, i: 7, d: 4, all: true, v: 1, u: {d: 7}},
    {n: str.cards[11], e: 1, t: 0, r: 1, i: 5, d: 0, sp: "slam", u: {e: 0}},
    {n: str.cards[12], e: 0, t: 1, r: 1, i: 8, dr: 1, ex: true, u: {dr: 2}},
    {n: str.cards[13], e: 1, t: 0, r: 2, i: 9, hp: 2, d: 15, u: {d: 20}},
    {n: str.cards[14], e: 2, t: 0, r: 2, i: 2, d: 13, w: 1, v: 1, u: {w: 2, v: 2}},
    {n: str.cards[15], e: 1, t: 2, r: 2, i: 10, s: 2, u: {s: 3}},
    {n: str.cards[16], e: 1, t: 2, r: 2, i: 11, pb: 3, u: {pb: 4}},
    {n: str.cards[17], e: 1, t: 1, r: 2, i: 12, en: 2, ex: true, u: {e: 0}},
    {n: str.cards[18], e: 2, t: 1, r: 2, i: 11, sp: "dbl", u: {e: 1}},
    {n: str.cards[19], e: 2, t: 1, r: 2, i: 6, b: 12, ft: 4, u: {b: 16, ft: 6}},
    {n: str.cards[20], e: 2, t: 0, r: 2, i: 3, d: 14, sm: 3, u: {sm: 5}},
    {n: str.cards[21], e: 2, t: 1, r: 2, i: 7, all: true, w: 3, v: 3, ex: true, u: {w: 5, v: 5}},
    {n: str.cards[22], e: 0, t: 1, r: 2, i: 8, dr: 3, u: {dr: 4}},
    {n: str.cards[23], e: 2, t: 0, r: 2, i: 3, d: 20, u: {d: 28}},
    {n: str.cards[24], e: 3, t: 2, r: 3, i: 13, ps: 2, u: {ps: 3}},
    {n: str.cards[25], e: 3, t: 0, r: 3, i: 2, d: 32, u: {d: 42}},
    {n: str.cards[26], e: 2, t: 1, r: 3, i: 1, b: 30, ex: true, u: {b: 40}},
    {n: str.cards[27], e: 0, t: 1, r: 3, i: 9, hp: 6, en: 2, dr: 3, ex: true, u: {dr: 5}},
    {n: str.cards[28], e: 3, t: 2, r: 3, i: 11, sp: "keep", u: {e: 2}},
    {n: str.cards[29], e: 1, t: 1, r: 3, i: 10, sp: "x2", ex: true, u: {ex: false}},
    {n: str.cards[30], e: 1, t: 2, r: 2, i: 14, pt: 3, u: {pt: 5}},
    {n: str.cards[31], e: 1, t: 3, r: 4, i: 15, ex: true, u: {}},
    {n: str.cards[32], e: 2, t: 0, r: 3, i: 16, d: 9, all: true, sp: "drain", u: {d: 12}},
    {n: str.cards[33], e: 1, t: 0, r: 2, i: 2, d: 8, sp: "exe", u: {d: 11}},
    {n: str.cards[34], e: 0, t: 2, r: 3, i: 9, hp: 4, ps: 1, u: {hp: 2}},
    {n: str.cards[35], e: 1, t: 0, r: 1, i: 4, d: 3, x: 3, u: {d: 4}},
    {n: str.cards[36], e: 0, t: 1, r: 2, i: 17, en: 1, dr: 1, ex: true, u: {dr: 2}},
    {n: str.cards[37], e: 2, t: 1, r: 3, i: 1, b: 10, ft: 10, u: {b: 14, ft: 14}}
  ]
  // the cards a reward or a shop can offer, by rarity
  let POOL = [[], range(len(CD)).filter(c => CD[c].r == 1), range(len(CD)).filter(c => CD[c].r == 2), range(len(CD)).filter(c => CD[c].r == 3)]
  // what a new player owns, and the deck a run starts with until it's changed: strikes, defends, a bash
  let STARTC = [6, 5, 2, 1, 0, 1, 1, 1] + range(len(CD) - 8).map(c => 0)
  let STARTD = [5, 4, 1] + range(len(CD) - 3).map(c => 0)
  let OWN = range(len(CD)).map(c => c < len(coll) ? coll[c] : len(coll) == 0 ? STARTC[c] : 0)
  let SD = range(len(CD)).map(c => min(OWN[c], c < len(sdeck) ? sdeck[c] : len(sdeck) == 0 ? STARTD[c] : 0))
  let SDN = sum(SD)
  let today = wall == null ? "" : fmtTime(wall, "yyyy-MM-dd")
  let packN = packs + (today != "" && packDay != today ? 1 : 0)

  // ---- the relics -------------------------------------------------------------------------------
  let RL = [
    {n: str.relicN[0], d: str.relicD[0]},
    {n: str.relicN[1], d: str.relicD[1]},
    {n: str.relicN[2], d: str.relicD[2]},
    {n: str.relicN[3], d: str.relicD[3]},
    {n: str.relicN[4], d: str.relicD[4]},
    {n: str.relicN[5], d: str.relicD[5]},
    {n: str.relicN[6], d: str.relicD[6]},
    {n: str.relicN[7], d: str.relicD[7]},
    {n: str.relicN[8], d: str.relicD[8]},
    {n: str.relicN[9], d: str.relicD[9]},
    {n: str.relicN[10], d: str.relicD[10]},
    {n: str.relicN[11], d: str.relicD[11]},
    {n: str.relicN[12], d: str.relicD[12]},
    {n: str.relicN[13], d: str.relicD[13]},
    {n: str.relicN[14], d: str.relicD[14]},
    {n: str.relicN[15], d: str.relicD[15]},
    {n: str.relicN[16], d: str.relicD[16]},
    {n: str.relicN[17], d: str.relicD[17]},
    {n: str.relicN[18], d: str.relicD[18]},
    {n: str.relicN[19], d: str.relicD[19]},
    {n: str.relicN[20], d: str.relicD[20]},
    {n: str.relicN[21], d: str.relicD[21]},
    {n: str.relicN[22], d: str.relicD[22]}
  ]
  let R = range(23).map(r => indexOf(relics, r) >= 0)

  // ---- the enemies ------------------------------------------------------------------------------
  // o: 0 the moves in turn, 1 at random, 2 the first and then the others at random. A move: a
  // damage (x times), b block, s strength, rit strength every turn, v vulnerable and w weak on the
  // knight, sl slimed cards into the knight's discard pile.
  let EN = [
    {n: str.foes[0], hp: [12, 16], o: 0, mv: [{a: 5}, {a: 3, sl: 1}]},
    {n: str.foes[1], hp: [11, 14], o: 1, mv: [{a: 6}, {a: 3, x: 2}]},
    {n: str.foes[2], hp: [46, 52], o: 2, mv: [{rit: 3}, {a: 6}]},
    {n: str.foes[3], hp: [40, 44], o: 1, mv: [{a: 11}, {a: 7, b: 5}, {s: 3, b: 6}]},
    {n: str.foes[4], hp: [26, 30], o: 0, mv: [{a: 7}, {a: 3, b: 8}, {a: 4, x: 2}]},
    {n: str.foes[5], hp: [13, 17], o: 1, mv: [{a: 3, x: 2}, {a: 2, w: 1}]},
    {n: str.foes[6], hp: [22, 26], o: 0, mv: [{v: 2, b: 4}, {a: 7}, {a: 9}]},
    {n: str.foes[7], hp: [82, 86], o: 2, mv: [{s: 3, b: 10}, {a: 14}, {a: 6, v: 2}, {a: 8, x: 2}]},
    {n: str.foes[8], hp: [96, 104], o: 0, mv: [{b: 14, s: 2}, {a: 9, x: 2}, {a: 20}]},
    {n: str.foes[9], hp: [200, 200], o: 0, mv: [{s: 3, b: 15}, {a: 20}, {a: 6, x: 3}, {sl: 3, w: 2}, {a: 12, v: 2}]},
    {n: str.foes[10], hp: [250, 250], o: 0, mv: [{a: 10, x: 2}, {b: 20, s: 2}, {a: 30}, {a: 6, w: 2, v: 2}, {a: 5, x: 4}]},
    {n: str.foes[11], hp: [300, 300], o: 0, mv: [{v: 3, w: 3}, {a: 8, x: 3}, {s: 4, b: 25}, {a: 36}, {a: 10, sl: 4}, {a: 6, x: 5}]}
  ]
  let EASY = [[0, 0], [1, 1], [2], [3], [5, 5], [1, 0]]
  let HARD = [[4, 0], [3, 1], [6, 6], [2, 5], [4, 4], [0, 0, 1], [5, 5, 5], [6, 4], [3, 5]]
  let ELITE = [[7], [8]]

  // ---- the map: six paths up five columns, twelve floors and the boss on top ----------------------
  // Each path steps up a floor at a time to the column left, the same one or the right, but never
  // across a step another path took the other way. A room is 5 * floor + column; the boss is 60.
  let MP = seed == 0 ? [] : reduce(range(6), (E, p) => E + [reduce(range(11), (P, f) => P + [[clamp(P[f] + floor(hash(seed, p, f) * 3) - 1, 0, 4)].map(n => any(E, Q => Q[f] == n && Q[f + 1] == P[f]) ? P[f] : n)[0]], [p == 1 ? (E[0][0] + 1 + floor(hash(seed, 1, 99) * 4)) % 5 : floor(hash(seed, p, 99) * 5)])], [])
  let NODE = range(60).map(z => any(MP, P => P[floor(z / 5)] == z % 5))
  let NX = range(60).map(z => floor(z / 5) == 11 ? [60] : range(5).filter(c => any(MP, P => P[floor(z / 5)] == z % 5 && P[floor(z / 5) + 1] == c)).map(c => floor(z / 5) * 5 + 5 + c))
  // 0 a fight, 1 an elite, 2 a campfire, 3 a shop, 4 an event, 5 a chest, 6 the boss
  let TY = range(61).map(z => z == 60 ? 6 : floor(z / 5) == 0 ? 0 : floor(z / 5) == 6 ? 5 : floor(z / 5) == 11 ? 2 : [hash(seed, z, 7)].map(r => floor(z / 5) < 4 ? (r < 0.55 ? 0 : r < 0.82 ? 4 : r < 0.94 ? 3 : 0) : (r < 0.42 ? 0 : r < 0.58 ? 1 : r < 0.7 ? (floor(z / 5) == 10 ? 0 : 2) : r < 0.8 ? 3 : 4))[0])
  let MT = TOP + 74
  let MB = SH - INS - 34
  let RH = (MB - MT) / 12
  let NP = LS ? range(61).map(z => z == 60 ? {x: SW - 56, y: (MT + MB) / 2} : {x: 40 + floor(z / 5) * (SW - 150) / 11 + (hash(seed, z, 4) - 0.5) * (SW - 150) / 11 * 0.3, y: MT + 8 + (z % 5 + 0.5) * (MB - MT - 16) / 5 + (hash(seed, z, 3) - 0.5) * (MB - MT) / 5 * 0.35}) : range(61).map(z => z == 60 ? {x: SW / 2, y: MT - 8} : {x: SW * 0.1 + (z % 5 + 0.5) * SW * 0.16 + (hash(seed, z, 3) - 0.5) * SW * 0.07, y: MB - floor(z / 5) * RH * 0.92 - RH * 0.6 + (hash(seed, z, 4) - 0.5) * RH * 0.3})
  let REACH = mode != "map" ? [] : pos < 0 ? range(5).filter(c => NODE[c]) : pos == 60 ? [] : NX[pos]
  let FLOOR = pos < 0 ? 0 : pos == 60 ? 13 : floor(pos / 5) + 1

  // ---- the fight --------------------------------------------------------------------------------
  let alive = range(len(en)).filter(i => en[i].hp > 0)
  let won = mode == "fight" && len(en) > 0 && len(alive) == 0
  let HV = hand.map(h => h.u ? merge(CD[h.c], CD[h.c].u) : CD[h.c])
  // what each enemy means to do, worked out for the damage the knight would take
  let INT = en.map(e => [EN[e.k].mv[e.m ?? 0]].map(M => merge(M, {dd: M.a == null ? 0 : floor((M.a + floor(M.a * 0.3 * e.ab) + e.st) * (e.w > 0 ? 0.75 : 1) * ((pl.v ?? 0) > 0 ? 1.5 : 1)), bb: M.b == null ? 0 : M.b + floor(M.b * 0.3 * e.ab)}))[0])
  let selV = sel >= 0 && sel < len(HV) ? HV[sel] : null
  // whether the card picked needs an enemy picked too
  let selT = selV != null && !(selV.all ?? false) && (selV.d != null || selV.v != null || selV.w != null)

  // ---- the layout of a fight --------------------------------------------------------------------
  let CW = min(84, floor((SW - 16) / 5))
  let CH = floor(CW * 1.4)
  let HY = SH - INS - CH - 6
  let AY = TOP + 62
  let AB = LS ? HY - 26 : HY - 112
  let FL = AY + floor((AB - AY) * 0.68)
  let q = clamp(floor((AB - AY) / 36), 2, 5)
  let ECOL = [16, 19, 16, 16, 16, 16, 16, 20, 20, 24, 24, 24]
  let EROW = [16, 16, 16, 16, 16, 16, 16, 21, 19, 24, 24, 22]
  let ESW = (SW * 0.66 - 8) / max(1, len(en))
  let qe = len(en) == 0 ? q : min(q, floor(ESW * 0.85 / max(en.map(e => ECOL[e.k]))))
  let ECX = range(len(en)).map(i => SW * 0.34 + ESW * (i + 0.5))
  let PCX = SW * 0.17
  // the hand, fanned out when it's wide
  let HST = len(hand) <= 1 ? 0 : min(CW + 4, ((LS ? SW - 380 : SW - 16) - CW) / (len(hand) - 1))
  let HX0 = SW / 2 - (HST * (len(hand) - 1) + CW) / 2
  let HL = range(len(hand)).map(j => {x: HX0 + j * HST, y: j == sel ? HY - 28 : HY, w: CW, h: CH})
  let showHand = mode == "fight" && !(busy && phase == "e") && !won && hp > 0

  // ---- the deck shown over everything -----------------------------------------------------------
  let DVL = dv == "" ? [] : (dv == "draw" ? drw.sortBy(h => h.c) : dv == "disc" ? disc : deck).map((h, i) => merge(h, {i: i})).filter(h => dv != "up" || (!h.u && CD[h.c].t != 3))
  let DCOLS = len(DVL) > 40 ? 5 : 4
  let DTW = (SW - 24 - (DCOLS - 1) * 6) / DCOLS
  let DTH = clamp(floor((SH - TOP - INS - 150) / max(1, ceil(len(DVL) / DCOLS))) - 6, 18, 34)
  let DTY = TOP + 64
  let dvC = dvs >= 0 && dvs < len(DVL) ? DVL[dvs] : null

  // ---- starting a fight with the enemies `grp` --------------------------------------------------
  on startQ {
    let A0 = act
    en = grp.map(k => [EN[k]].map(E => [floor(random(E.hp[0], E.hp[1]) * (k >= 9 ? 1 : 1 + 0.45 * A0))].map(h => {k: k, hp: h, mh: h, b: 0, st: 0, v: R[2] ? 1 : 0, w: 0, rit: 0, m: E.o == 1 ? random(len(E.mv)) : 0, ab: k >= 9 ? 0 : A0})[0])[0])
    pl = {b: 0, st: R[4] ? 1 : 0, v: 0, w: 0, ps: 0, pb: 0, pt: 0, ft: 0, brr: false, e: 0, pz: false, xd: 0, ac: 0, turn: 0}
    hp = min(mhp, hp + (R[6] ? 2 : 0))
    drw = shuffle(deck)
    hand = []
    disc = []
    exh = []
    sel = -1
    fx = [{k: "ban", s: fk == 2 ? EN[grp[0]].n : fk == 1 ? str.elite : str.battle, s2: fk == 2 ? str.bossOfAct(act + 1) : len(grp) == 1 ? EN[grp[0]].n : str.foesN(len(grp)), t0: 0}]
    fxT = 1.0
    fxDur = 1.1
    fxTap = time
    fxAt = -1
    busy = true
    phase = "e"
    mode = "fight"
    turnQ = turnQ + 1
  }

  // ---- the knight's turn starts: energy, block, strength, and five cards --------------------------
  on turnQ {
    if mode == "fight" && hp > 0 && len(alive) > 0 {
      let T = pl.turn + 1
      let xd = pl.xd
      let en1 = R[18] ? en.map(e => e.hp <= 0 ? e : merge(e, {b: max(0, e.b - 3), hp: e.hp - max(0, 3 - e.b)})) : en
      let hfx = R[18] ? alive.map(i => {k: "hit", i: i, d: en[i].hp - en1[i].hp, bl: en[i].b - en1[i].b, t0: fxT + 0.1}) : []
      let gb = (T == 1 && R[1] ? 10 : 0) + (T == 2 && R[14] ? 14 : 0)
      let ps = pl.ps
      en = en1
      pl = merge(pl, {turn: T, e: 3 + (R[20] ? 1 : 0) + (T == 1 && R[3] ? 1 : 0) + (R[8] && T % 3 == 0 ? 1 : 0) + (R[13] ? pl.e : 0), b: (pl.brr ? pl.b : 0) + gb, st: pl.st + ps, ft: 0, ac: 0, xd: 0})
      drawN = 5 + (R[21] ? 1 : 0) + (T == 1 && R[16] ? 2 : 0) + xd
      drawQ = drawQ + 1
      fx = fx + hfx + (gb > 0 ? [{k: "blk", i: -1, n: gb, t0: fxT}] : []) + (ps > 0 ? [{k: "txt", i: -1, s: str.plusStr(ps), c: "#ff8a5a", t0: fxT + 0.1}] : []) + (T > 1 ? [{k: "ban", s: str.yourTurn, s2: str.turnN(T), t0: fxT}] : [])
      fxDur = max(fxDur, fxT + (T > 1 ? 0.7 : 0.1))
      if len(en1.filter(e => e.hp > 0)) == 0 { winQ = winQ + 1 }
    }
  }

  // ---- drawing `drawN` cards, the discard pile shuffled in when the draw pile runs out ------------
  on drawQ {
    if drawN > 0 {
      let n = min(drawN, 10 - len(hand))
      let rs = len(drw) < n
      let pile = rs ? drw + shuffle(disc) : drw
      hand = hand + pile.take(n)
      drw = pile.drop(n)
      if rs { disc = [] }
      drawN = 0
    }
  }

  // ---- the enemies' turn, played in one go ------------------------------------------------------
  // Each enemy in turn: its block from last turn goes, then it does what it showed: hits (thorns
  // hit back), block, strength, and debuffs or slimed cards for the knight. Then each picks its
  // next move, and the knight's turn starts.
  on endQ {
    if mode == "fight" && hp > 0 && len(alive) > 0 {
      let thn = pl.pt + pl.ft + (R[9] ? 3 : 0)
      let b0 = pl.b + pl.pb
      let b1 = b0 == 0 && R[5] ? 6 : b0
      let RS = reduce(range(len(en)), (A, i) => A.en[i].hp <= 0 || A.hp <= 0 ? A : [A.en[i]].map(e => [EN[e.k].mv[e.m]].map(M => [M.a == null ? 0 : floor((M.a + floor(M.a * 0.3 * e.ab) + e.st) * (e.w > 0 ? 0.75 : 1) * (A.v > 0 ? 1.5 : 1))].map(d => [M.a == null ? 0 : M.x ?? 1].map(nh =>
        [reduce(range(nh), (B, j) => B.hp <= 0 || B.eh <= 0 ? B : {
          b: max(0, B.b - d), hp: B.hp - max(0, d - B.b), eh: B.eh - thn,
          fx: B.fx + [{k: "hit", i: -1, d: max(0, d - B.b), bl: min(B.b, d), t0: A.t + 0.18 + j * 0.24}] + (thn > 0 ? [{k: "hit", i: i, d: min(thn, B.eh), bl: 0, t0: A.t + 0.26 + j * 0.24}] : [])
        }, {b: A.b, hp: A.hp, eh: e.hp, fx: []})].map(H => [M.b == null ? 0 : M.b + floor(M.b * 0.3 * e.ab)].map(bb => {
          b: H.b, hp: H.hp,
          v: A.v + (M.v ?? 0), w: A.w + (M.w ?? 0), va: A.va || M.v != null, wa: A.wa || M.w != null,
          sl: A.sl + (M.sl ?? 0),
          en: set(A.en, i, merge(e, {hp: H.eh, b: bb, st: e.st + (M.s ?? 0), rit: e.rit + (M.rit ?? 0)})),
          fx: A.fx + (nh > 0 ? [{k: "lunge", i: i, t0: A.t}] : [{k: "pulse", i: i, t0: A.t}]) + H.fx + (bb > 0 ? [{k: "blk", i: i, n: bb, t0: A.t + 0.1}] : []) + (M.s != null || M.rit != null ? [{k: "txt", i: i, s: M.s != null ? str.plusStr(M.s) : str.ritual(M.rit), c: "#ff8a5a", t0: A.t + 0.15}] : []) + (M.v != null ? [{k: "txt", i: -1, s: str.vulnerable, c: "#c86aff", t0: A.t + 0.25}] : []) + (M.w != null ? [{k: "txt", i: -1, s: str.weak, c: "#8ad85a", t0: A.t + 0.45}] : []) + (M.sl != null ? [{k: "txt", i: -1, s: str.slimed(M.sl), c: "#5ac85a", t0: A.t + 0.6}] : []),
          t: A.t + 0.55 + nh * 0.24
        })[0])[0])[0])[0])[0])[0], {b: b1, hp: hp, v: pl.v, w: pl.w, va: false, wa: false, sl: 0, en: en.map(e => merge(e, {b: 0})), fx: [{k: "ban", s: str.enemyTurn, s2: "", t0: 0}] + (b1 > pl.b ? [{k: "blk", i: -1, n: b1 - pl.b, t0: 0.1}] : []), t: 0.95})
      // ritual counts from the turn after it's taken; debuffs wear off by a turn
      let en3 = RS.en.map((e, i) => e.hp <= 0 ? e : [len(EN[e.k].mv)].map(L => merge(e, {st: e.st + en[i].rit, v: max(0, e.v - 1), w: max(0, e.w - 1), m: EN[e.k].o == 0 ? (e.m + 1) % L : EN[e.k].o == 1 ? (e.m + 1 + random(L - 1)) % L : 1 + random(L - 1)}))[0])
      let pz = RS.hp < hp && R[15] && !pl.pz
      hp = max(0, RS.hp)
      pl = merge(pl, {b: RS.b, v: RS.va ? RS.v : max(0, RS.v - 1), w: RS.wa ? RS.w : max(0, RS.w - 1), xd: pz ? 3 : 0, pz: pl.pz || pz})
      en = en3
      disc = disc + hand + range(RS.sl).map(z => {c: 31, u: false})
      hand = []
      sel = -1
      fx = RS.fx
      fxT = RS.t
      fxDur = RS.t + 0.3
      fxTap = time
      fxAt = -1
      busy = true
      phase = "e"
      if RS.hp <= 0 {
        mode = "end"
        rmode = ""
        fxDur = RS.t + 1.0
      } else if len(en3.filter(e => e.hp > 0)) == 0 {
        winQ = winQ + 1
      } else {
        turnQ = turnQ + 1
      }
    }
  }

  // ---- a fight won: gold, a card to pick, a relic from an elite, a boss relic to choose ------------
  on winQ {
    let g0 = fk == 2 ? random(70, 90) : fk == 1 ? random(25, 35) : random(10, 20)
    let g = R[10] ? floor(g0 * 1.25) : g0
    let rp = fk == 2 ? 2 : fk == 1 ? 0.12 : 0.04
    let up = fk == 1 ? 0.45 : 0.36
    gold = gold + g
    rwG = g
    if fk == 2 { packs = packs + 1 }
    hp = min(mhp, hp + (R[0] ? 6 : 0) + (R[22] ? 12 : 0))
    offer = reduce([random(), random(), random()].map(z => z < rp ? 3 : z < rp + up ? 2 : 1), (L, r) => L + [shuffle(POOL[r].filter(c => all(L, o => o.c != c)))[0]].map(c => {c: c, u: random() < act * 0.2}), [])
    let fr = shuffle(range(1, 20).filter(r => !R[r]))
    rwR = fk == 1 && len(fr) > 0 ? fr[0] : -1
    if rwR >= 0 {
      gainR = rwR
      gainQ = gainQ + 1
    }
    bossR = fk == 2 && act < 2 ? range(20, 23).filter(r => !R[r]) : []
    sel = -1
    if fk == 2 && act == 2 {
      wins = wins + 1
      best = 39
      mode = "end"
      rmode = ""
    } else {
      mode = "reward"
    }
    busy = true
    fxDur = max(fxDur + 0.4, 1.2)
  }

  // ---- a relic gained -------------------------------------------------------------------------
  on gainQ {
    if gainR >= 0 && indexOf(relics, gainR) < 0 {
      relics = relics + [gainR]
      if gainR == 12 {
        mhp = mhp + 7
        hp = hp + 7
      }
      if gainR == 19 {
        mhp = mhp + 10
        hp = hp + 10
      }
    }
  }

  back: dv != "" || (mode == "fight" && sel >= 0) || mode == "build" || mode == "pack"
  onBack: {
    if dv != "" {
      if dvs >= 0 { dvs = -1 } else { dv = "" }
    } else if mode == "build" {
      if bv >= 0 { bv = -1 } else if SDN >= 10 { mode = "title" }
    } else if mode == "pack" {
      mode = "title"
    } else {
      sel = -1
    }
  }

  // ---- the art ----------------------------------------------------------------------------------
  let INK = "#14121c"
  // the knight, facing the enemies on the right
  let SP_KNIGHT = """
