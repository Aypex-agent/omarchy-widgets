  ]
  let MIP = {o: INK, W: "#fff8e0", Y: "#ffd04a", F: "#ff7a3a", B: "#b8783e"}
  // what a fighter has on them: strength, vulnerable, weak, ritual, thorns, metal, demon form, barricade
  let STI = [
    """
