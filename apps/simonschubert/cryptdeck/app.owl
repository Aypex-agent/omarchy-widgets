  // ---- what's on screen, for drawing and for taps -----------------------------------------------
  // the fight is drawn while it plays out, after it's won or lost
  let scene = mode == "fight" || (busy && (mode == "reward" || mode == "end") && len(en) > 0)
  let TB = mode != "title" && mode != "end" && mode != "build" && mode != "pack" && dv == ""
  let RLT = relics.map((r, j) => {r: r, x: 10 + (j % floor((SW - 20) / 23)) * 23, y: TOP + 34 + floor(j / floor((SW - 20) / 23)) * 23, w: 21, h: 21})
  let canUp = any(deck, h => !h.u && CD[h.c].t != 3)
  let BW1 = min(SW - 48, 300)
  // the top of the fight's controls
