  let RWC = range(len(offer)).map(j => {x: SW / 2 - (240 * RWS + 20) / 2 + j * (80 * RWS + 10), y: RY + 176, w: 80 * RWS, h: 112 * RWS})
  let BRT = range(len(bossR)).map(j => {x: 20, y: RY + 176 + j * 68, w: SW - 40, h: 58})
  // the shop: five cards, two relics, and taking a card out
