  ]
  let RIP = {o: INK, W: "#fff8e0", R: "#e8504a", Y: "#ffd04a", S: "#b8c2d6", B: "#b8783e", b: "#7a4a2a", M: "#5ab4ff", m: "#ff8ad8", G: "#5ac85a", P: "#f4a8cc", C: "#d8a060", F: "#ff7a3a", K: "#4a2a4a", L: "#c8d850"}
  // the map's rooms: a fire, a shop, an event and a chest (a fight and an elite borrow card pictures)
  let MI = [
    """
