app "linux commands" {
  meta { owl: 23; description: "The Linux Command Library: 9,000+ commands with examples and options, cheat sheets and terminal tips"; version: "1.7"; license: "MIT"; category: "dev" }
  title: sel != "" ? sel : basic != "" ? get(str.topics, basic, basic) : str.title
  // Back goes from a page to the one before it (a command's "see also" chain), then to the list.
  back: sel != "" || basic != ""
  onBack: { was = sel == "" || prev == "" || url == "commands/${prev}.md" ? null : page; url = sel == "" || prev == "" ? url : "commands/${prev}.md"; basic = ""; sel = prev; back = drop(back, 1); copied = "" }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#E0AF68"/>
    <path d="M128 36c-30 0-44 24-44 54 0 18-30 46-30 86 0 20 12 34 30 38h88c18-4 30-18 30-38 0-40-30-68-30-86 0-30-14-54-44-54z" fill="#1A1B26"/>
    <path d="M128 104c-24 0-34 26-34 56s12 50 34 50 34-20 34-50-10-56-34-56z" fill="#F4F4F4"/>
    <ellipse cx="112" cy="74" rx="11" ry="14" fill="#F4F4F4"/>
    <ellipse cx="144" cy="74" rx="11" ry="14" fill="#F4F4F4"/>
    <circle cx="114" cy="78" r="5" fill="#1A1B26"/>
    <circle cx="142" cy="78" r="5" fill="#1A1B26"/>
    <path d="M106 94c8-6 36-6 44 0-6 12-14 16-22 16s-16-4-22-16z" fill="#FF9E3B"/>
    <path d="M56 214c4-18 22-30 40-22 8 4 8 16 0 22zM200 214c-4-18-22-30-40-22-8 4-8 16 0 22z" fill="#FF9E3B"/>
  </svg>"""

  let TIPS = "tips.md"

  // The text a person reads. Command names, the pages and their section headings come from the
  // Linux Command Library in English and stay as they are; topics are the basics pages' titles by id.
  strings {
    en {
      // The window's title on the lists; the bottom bar's tabs (small, a third of the width each).
      title: "linux commands"
      basics: "basics"; tips: "tips"; commands: "commands"
      loading: "loading…"; loadingList: "loading the command list…"
      httpError: n => "couldn't load the page (HTTP ${n})"
      offline: "offline: the pages come from GitHub"; tryAgain: "try again"
      search: "search commands"
      // Heads the start page's chips: the installed packages with a page, or popular commands.
      installed: n => "installed (${n})"; popular: "popular"
      noMatch: q => "no command matches “${q}”"
      topics: {aitools: "AI tools", backupimaging: "Backup & Imaging", compressionarchiving: "Compression & Archiving", cryptocurrencies: "Cryptocurrencies", emacstexteditor: "Emacs Text Editor", filesfolders: "Files & Folders", git: "Git", hackingtools: "Hacking tools", input: "Input", json: "JSON", microtexteditor: "Micro Text Editor", nanotexteditor: "Nano Text Editor", network: "Network", oneliners: "One-liners", packagemanager: "Package manager", picotexteditor: "Pico Text Editor", printing: "Printing", regularexpressions: "Regular Expressions", searchfind: "Search & Find", shellscripting: "Shell Scripting", ssh: "SSH", systemcontrol: "System control", systeminformation: "System information", systemrecovery: "System Recovery", terminalgames: "Terminal games", textprocessing: "Text Processing", tmux: "Tmux", usersgroups: "Users & Groups", videoaudio: "Video & Audio", vimtexteditor: "VIM Text Editor"}
    }
    id {
      title: "perintah linux"
      basics: "dasar"; tips: "tips"; commands: "perintah"
      loading: "memuat…"; loadingList: "memuat daftar perintah…"
      httpError: n => "halaman tidak bisa dimuat (HTTP ${n})"
      offline: "offline: halaman diambil dari GitHub"; tryAgain: "coba lagi"
      search: "cari perintah"
      installed: n => "terinstal (${n})"; popular: "populer"
      noMatch: q => "tidak ada perintah yang cocok dengan “${q}”"
      topics: {aitools: "Alat AI", backupimaging: "Cadangan & Image Disk", compressionarchiving: "Kompresi & Arsip", cryptocurrencies: "Mata Uang Kripto", emacstexteditor: "Editor Teks Emacs", filesfolders: "File & Folder", git: "Git", hackingtools: "Alat peretasan", input: "Input", json: "JSON", microtexteditor: "Editor Teks Micro", nanotexteditor: "Editor Teks Nano", network: "Jaringan", oneliners: "Perintah satu baris", packagemanager: "Manajer paket", picotexteditor: "Editor Teks Pico", printing: "Mencetak", regularexpressions: "Ekspresi Reguler", searchfind: "Cari & Temukan", shellscripting: "Skrip Shell", ssh: "SSH", systemcontrol: "Kontrol sistem", systeminformation: "Informasi sistem", systemrecovery: "Pemulihan Sistem", terminalgames: "Game terminal", textprocessing: "Pengolahan Teks", tmux: "Tmux", usersgroups: "Pengguna & Grup", videoaudio: "Video & Audio", vimtexteditor: "Editor Teks VIM"}
    }
    es {
      title: "comandos de linux"
      basics: "básicos"; tips: "consejos"; commands: "comandos"
      loading: "cargando…"; loadingList: "cargando la lista de comandos…"
      httpError: n => "no se pudo cargar la página (HTTP ${n})"
      offline: "sin conexión: las páginas vienen de GitHub"; tryAgain: "reintentar"
      search: "buscar comandos"
      installed: n => "instalados (${n})"; popular: "populares"
      noMatch: q => "ningún comando coincide con “${q}”"
      topics: {aitools: "Herramientas de IA", backupimaging: "Copias de seguridad e imágenes", compressionarchiving: "Compresión y archivado", cryptocurrencies: "Criptomonedas", emacstexteditor: "Editor de texto Emacs", filesfolders: "Archivos y carpetas", git: "Git", hackingtools: "Herramientas de hacking", input: "Entrada", json: "JSON", microtexteditor: "Editor de texto Micro", nanotexteditor: "Editor de texto Nano", network: "Red", oneliners: "Comandos de una línea", packagemanager: "Gestor de paquetes", picotexteditor: "Editor de texto Pico", printing: "Impresión", regularexpressions: "Expresiones regulares", searchfind: "Buscar y encontrar", shellscripting: "Scripts de shell", ssh: "SSH", systemcontrol: "Control del sistema", systeminformation: "Información del sistema", systemrecovery: "Recuperación del sistema", terminalgames: "Juegos de terminal", textprocessing: "Procesamiento de texto", tmux: "Tmux", usersgroups: "Usuarios y grupos", videoaudio: "Vídeo y audio", vimtexteditor: "Editor de texto VIM"}
    }
    pt {
      title: "comandos do linux"
      basics: "básico"; tips: "dicas"; commands: "comandos"
      loading: "carregando…"; loadingList: "carregando a lista de comandos…"
      httpError: n => "não deu para carregar a página (HTTP ${n})"
      offline: "offline: as páginas vêm do GitHub"; tryAgain: "tentar de novo"
      search: "buscar comandos"
      installed: n => "instalados (${n})"; popular: "populares"
      noMatch: q => "nenhum comando corresponde a “${q}”"
      topics: {aitools: "Ferramentas de IA", backupimaging: "Backup e imagens", compressionarchiving: "Compressão e arquivamento", cryptocurrencies: "Criptomoedas", emacstexteditor: "Editor de texto Emacs", filesfolders: "Arquivos e pastas", git: "Git", hackingtools: "Ferramentas de hacking", input: "Entrada", json: "JSON", microtexteditor: "Editor de texto Micro", nanotexteditor: "Editor de texto Nano", network: "Rede", oneliners: "Comandos de uma linha", packagemanager: "Gerenciador de pacotes", picotexteditor: "Editor de texto Pico", printing: "Impressão", regularexpressions: "Expressões regulares", searchfind: "Buscar e encontrar", shellscripting: "Scripts de shell", ssh: "SSH", systemcontrol: "Controle do sistema", systeminformation: "Informações do sistema", systemrecovery: "Recuperação do sistema", terminalgames: "Jogos de terminal", textprocessing: "Processamento de texto", tmux: "Tmux", usersgroups: "Usuários e grupos", videoaudio: "Vídeo e áudio", vimtexteditor: "Editor de texto VIM"}
    }
    de {
      title: "linux-befehle"
      basics: "grundlagen"; tips: "tipps"; commands: "befehle"
      loading: "lädt…"; loadingList: "befehlsliste lädt…"
      httpError: n => "seite konnte nicht geladen werden (HTTP ${n})"
      offline: "offline: die seiten kommen von GitHub"; tryAgain: "nochmal versuchen"
      search: "befehle suchen"
      installed: n => "installiert (${n})"; popular: "beliebt"
      noMatch: q => "kein befehl passt zu „${q}“"
      topics: {aitools: "KI-Tools", backupimaging: "Backup & Images", compressionarchiving: "Komprimieren & Archivieren", cryptocurrencies: "Kryptowährungen", emacstexteditor: "Texteditor Emacs", filesfolders: "Dateien & Ordner", git: "Git", hackingtools: "Hacking-Tools", input: "Eingabe", json: "JSON", microtexteditor: "Texteditor Micro", nanotexteditor: "Texteditor Nano", network: "Netzwerk", oneliners: "Einzeiler", packagemanager: "Paketmanager", picotexteditor: "Texteditor Pico", printing: "Drucken", regularexpressions: "Reguläre Ausdrücke", searchfind: "Suchen & Finden", shellscripting: "Shell-Skripte", ssh: "SSH", systemcontrol: "Systemsteuerung", systeminformation: "Systeminformationen", systemrecovery: "Systemwiederherstellung", terminalgames: "Terminal-Spiele", textprocessing: "Textverarbeitung", tmux: "Tmux", usersgroups: "Benutzer & Gruppen", videoaudio: "Video & Audio", vimtexteditor: "Texteditor VIM"}
    }
    zh {
      title: "linux 命令"
      basics: "基础"; tips: "技巧"; commands: "命令"
      loading: "正在加载…"; loadingList: "正在加载命令列表…"
      httpError: n => "无法加载页面（HTTP ${n}）"
      offline: "离线：页面来自 GitHub"; tryAgain: "重试"
      search: "搜索命令"
      installed: n => "已安装（${n}）"; popular: "常用"
      noMatch: q => "没有与“${q}”匹配的命令"
      topics: {aitools: "AI 工具", backupimaging: "备份与镜像", compressionarchiving: "压缩与归档", cryptocurrencies: "加密货币", emacstexteditor: "Emacs 文本编辑器", filesfolders: "文件与文件夹", git: "Git", hackingtools: "黑客工具", input: "输入", json: "JSON", microtexteditor: "Micro 文本编辑器", nanotexteditor: "Nano 文本编辑器", network: "网络", oneliners: "单行命令", packagemanager: "包管理器", picotexteditor: "Pico 文本编辑器", printing: "打印", regularexpressions: "正则表达式", searchfind: "搜索与查找", shellscripting: "Shell 脚本", ssh: "SSH", systemcontrol: "系统控制", systeminformation: "系统信息", systemrecovery: "系统恢复", terminalgames: "终端游戏", textprocessing: "文本处理", tmux: "Tmux", usersgroups: "用户与组", videoaudio: "视频与音频", vimtexteditor: "VIM 文本编辑器"}
    }
    ru {
      title: "команды linux"
      basics: "основы"; tips: "советы"; commands: "команды"
      loading: "загрузка…"; loadingList: "загрузка списка команд…"
      httpError: n => "не удалось загрузить страницу (HTTP ${n})"
      offline: "нет сети: страницы загружаются с GitHub"; tryAgain: "попробовать снова"
      search: "поиск команд"
      installed: n => "установленные (${n})"; popular: "популярные"
      noMatch: q => "нет команд по запросу «${q}»"
      topics: {aitools: "Инструменты ИИ", backupimaging: "Резервные копии и образы", compressionarchiving: "Сжатие и архивы", cryptocurrencies: "Криптовалюты", emacstexteditor: "Текстовый редактор Emacs", filesfolders: "Файлы и папки", git: "Git", hackingtools: "Инструменты для взлома", input: "Ввод", json: "JSON", microtexteditor: "Текстовый редактор Micro", nanotexteditor: "Текстовый редактор Nano", network: "Сеть", oneliners: "Однострочники", packagemanager: "Менеджер пакетов", picotexteditor: "Текстовый редактор Pico", printing: "Печать", regularexpressions: "Регулярные выражения", searchfind: "Поиск", shellscripting: "Скрипты оболочки", ssh: "SSH", systemcontrol: "Управление системой", systeminformation: "Сведения о системе", systemrecovery: "Восстановление системы", terminalgames: "Игры в терминале", textprocessing: "Обработка текста", tmux: "Tmux", usersgroups: "Пользователи и группы", videoaudio: "Видео и аудио", vimtexteditor: "Текстовый редактор VIM"}
    }
    ja {
      title: "linux コマンド"
      basics: "基本"; tips: "ヒント"; commands: "コマンド"
      loading: "読み込み中…"; loadingList: "コマンド一覧を読み込み中…"
      httpError: n => "ページを読み込めませんでした（HTTP ${n}）"
      offline: "オフラインです：ページは GitHub から取得します"; tryAgain: "再試行"
      search: "コマンドを検索"
      installed: n => "インストール済み（${n}）"; popular: "よく使うもの"
      noMatch: q => "「${q}」に一致するコマンドはありません"
      topics: {aitools: "AI ツール", backupimaging: "バックアップとイメージ", compressionarchiving: "圧縮とアーカイブ", cryptocurrencies: "暗号通貨", emacstexteditor: "Emacs テキストエディタ", filesfolders: "ファイルとフォルダ", git: "Git", hackingtools: "ハッキングツール", input: "入力", json: "JSON", microtexteditor: "Micro テキストエディタ", nanotexteditor: "Nano テキストエディタ", network: "ネットワーク", oneliners: "ワンライナー", packagemanager: "パッケージマネージャ", picotexteditor: "Pico テキストエディタ", printing: "印刷", regularexpressions: "正規表現", searchfind: "検索", shellscripting: "シェルスクリプト", ssh: "SSH", systemcontrol: "システム制御", systeminformation: "システム情報", systemrecovery: "システム復旧", terminalgames: "ターミナルゲーム", textprocessing: "テキスト処理", tmux: "Tmux", usersgroups: "ユーザーとグループ", videoaudio: "動画と音声", vimtexteditor: "VIM テキストエディタ"}
    }
    uk {
      title: "команди linux"
      basics: "основи"; tips: "поради"; commands: "команди"
      loading: "завантаження…"; loadingList: "завантаження списку команд…"
      httpError: n => "не вдалося завантажити сторінку (HTTP ${n})"
      offline: "немає мережі: сторінки завантажуються з GitHub"; tryAgain: "ще раз"
      search: "пошук команд"
      installed: n => "встановлені (${n})"; popular: "популярні"
      noMatch: q => "немає команд за запитом «${q}»"
      topics: {aitools: "Інструменти ШІ", backupimaging: "Резервні копії та образи", compressionarchiving: "Стиснення та архіви", cryptocurrencies: "Криптовалюти", emacstexteditor: "Текстовий редактор Emacs", filesfolders: "Файли та теки", git: "Git", hackingtools: "Інструменти для злому", input: "Введення", json: "JSON", microtexteditor: "Текстовий редактор Micro", nanotexteditor: "Текстовий редактор Nano", network: "Мережа", oneliners: "Однорядкові команди", packagemanager: "Менеджер пакетів", picotexteditor: "Текстовий редактор Pico", printing: "Друк", regularexpressions: "Регулярні вирази", searchfind: "Пошук", shellscripting: "Скрипти оболонки", ssh: "SSH", systemcontrol: "Керування системою", systeminformation: "Відомості про систему", systemrecovery: "Відновлення системи", terminalgames: "Ігри в терміналі", textprocessing: "Обробка тексту", tmux: "Tmux", usersgroups: "Користувачі та групи", videoaudio: "Відео та аудіо", vimtexteditor: "Текстовий редактор VIM"}
    }
    fr {
      title: "commandes linux"
      basics: "bases"; tips: "astuces"; commands: "commandes"
      loading: "chargement…"; loadingList: "chargement de la liste des commandes…"
      httpError: n => "impossible de charger la page (HTTP ${n})"
      offline: "hors ligne : les pages viennent de GitHub"; tryAgain: "réessayer"
      search: "chercher une commande"
      installed: n => "installés (${n})"; popular: "populaires"
      noMatch: q => "aucune commande ne correspond à « ${q} »"
      topics: {aitools: "Outils d’IA", backupimaging: "Sauvegarde et images", compressionarchiving: "Compression et archivage", cryptocurrencies: "Cryptomonnaies", emacstexteditor: "Éditeur de texte Emacs", filesfolders: "Fichiers et dossiers", git: "Git", hackingtools: "Outils de hacking", input: "Saisie", json: "JSON", microtexteditor: "Éditeur de texte Micro", nanotexteditor: "Éditeur de texte Nano", network: "Réseau", oneliners: "Commandes en une ligne", packagemanager: "Gestionnaire de paquets", picotexteditor: "Éditeur de texte Pico", printing: "Impression", regularexpressions: "Expressions régulières", searchfind: "Rechercher et trouver", shellscripting: "Scripts shell", ssh: "SSH", systemcontrol: "Contrôle du système", systeminformation: "Infos système", systemrecovery: "Récupération du système", terminalgames: "Jeux en terminal", textprocessing: "Traitement de texte", tmux: "Tmux", usersgroups: "Utilisateurs et groupes", videoaudio: "Vidéo et audio", vimtexteditor: "Éditeur de texte VIM"}
    }
    tr {
      title: "linux komutları"
      basics: "temeller"; tips: "ipuçları"; commands: "komutlar"
      loading: "yükleniyor…"; loadingList: "komut listesi yükleniyor…"
      httpError: n => "sayfa yüklenemedi (HTTP ${n})"
      offline: "çevrimdışı: sayfalar GitHub’dan gelir"; tryAgain: "tekrar dene"
      search: "komut ara"
      installed: n => "yüklü (${n})"; popular: "popüler"
      noMatch: q => "“${q}” ile eşleşen komut yok"
      topics: {aitools: "Yapay zekâ araçları", backupimaging: "Yedekleme ve imajlar", compressionarchiving: "Sıkıştırma ve arşivleme", cryptocurrencies: "Kripto paralar", emacstexteditor: "Emacs metin düzenleyici", filesfolders: "Dosyalar ve klasörler", git: "Git", hackingtools: "Hacking araçları", input: "Girdi", json: "JSON", microtexteditor: "Micro metin düzenleyici", nanotexteditor: "Nano metin düzenleyici", network: "Ağ", oneliners: "Tek satırlık komutlar", packagemanager: "Paket yöneticisi", picotexteditor: "Pico metin düzenleyici", printing: "Yazdırma", regularexpressions: "Düzenli ifadeler", searchfind: "Arama ve bulma", shellscripting: "Kabuk betikleri", ssh: "SSH", systemcontrol: "Sistem denetimi", systeminformation: "Sistem bilgisi", systemrecovery: "Sistem kurtarma", terminalgames: "Terminal oyunları", textprocessing: "Metin işleme", tmux: "Tmux", usersgroups: "Kullanıcılar ve gruplar", videoaudio: "Video ve ses", vimtexteditor: "VIM metin düzenleyici"}
    }
    it {
      title: "comandi linux"
      basics: "basi"; tips: "consigli"; commands: "comandi"
      loading: "caricamento…"; loadingList: "caricamento dell’elenco dei comandi…"
      httpError: n => "impossibile caricare la pagina (HTTP ${n})"
      offline: "offline: le pagine arrivano da GitHub"; tryAgain: "riprova"
      search: "cerca comandi"
      installed: n => "installati (${n})"; popular: "popolari"
      noMatch: q => "nessun comando corrisponde a “${q}”"
      topics: {aitools: "Strumenti IA", backupimaging: "Backup e immagini", compressionarchiving: "Compressione e archivi", cryptocurrencies: "Criptovalute", emacstexteditor: "Editor di testo Emacs", filesfolders: "File e cartelle", git: "Git", hackingtools: "Strumenti di hacking", input: "Input", json: "JSON", microtexteditor: "Editor di testo Micro", nanotexteditor: "Editor di testo Nano", network: "Rete", oneliners: "Comandi di una riga", packagemanager: "Gestore di pacchetti", picotexteditor: "Editor di testo Pico", printing: "Stampa", regularexpressions: "Espressioni regolari", searchfind: "Cerca e trova", shellscripting: "Script di shell", ssh: "SSH", systemcontrol: "Controllo del sistema", systeminformation: "Informazioni di sistema", systemrecovery: "Ripristino del sistema", terminalgames: "Giochi da terminale", textprocessing: "Elaborazione del testo", tmux: "Tmux", usersgroups: "Utenti e gruppi", videoaudio: "Video e audio", vimtexteditor: "Editor di testo VIM"}
    }
  }

  state tab = "commands" persist
  // The Linux Command Library app's own tab icons.
  asset puzzle = base64""
  asset idea = base64""
  asset search = base64""
  state q = ""
  // The command or basics page shown ("" for the lists), and the commands to go back to.
  state sel = ""
  state basic = ""
  state back = []
  // The page being read, a path in the Linux Command Library's assets; setting it fetches it. Until
  // the new page arrives, `was` holds the one it replaces, so the old page never shows under the new name.
  state url = "tips.md"
  state was = null
  state copied = ""

  source idx = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/commands/index.txt") every 24h timeout 20s
  source bidx = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/basics/index.txt") every 24h timeout 15s
  // Installed packages, when Linux is: libraries and language modules are left out, so the
  // list stays under owl's 1000 items. Packages with a page in the library show on the start page.
  source pkgs = cmd("pacman -Qq | grep -Ev '^(lib|python-|perl-|lua-|ruby-|node-|haskell-|ttf-|otf-|noto-|xorg-|qt[56]-|gst)'") every 10m optional
  // The one URL that changes: a page under the same assets folder as the indexes.
  source page = http("https://raw.githubusercontent.com/SimonSchubert/LinuxCommandLibrary/master/assets/${url}") every 24h timeout 15s status

  let ready = page != null && page != was
  let doc = ready && page.ok ? page.out : ""

  // The index has 9,000+ lines and lists stop at 1000, so it's searched as one text.
  let qq = replace(trim(q), '\E', "")
  let starts = qq == "" || idx == null ? [] : matchAll(idx, '(?im)^\Q' + qq + '\E[^\n]*(?=\.md$)')
  let inside = qq == "" || idx == null ? [] : matchAll(idx, '(?im)^[^\n]+\Q' + qq + '\E[^\n]*(?=\.md$)').filter(n => !startsWith(lower(n), lower(qq)))
  let exact = starts.filter(n => lower(n) == lower(qq))
  let hits = (exact + starts.filter(n => lower(n) != lower(qq)).sort() + inside.sort()).take(80)
  let names = idx == null ? "" : "\n${idx}\n"
  let mine = pkgs == null || idx == null ? [] : lines(pkgs).filter(p => contains(names, "\n${trim(p)}.md\n")).map(p => trim(p))
  let popular = ["tar", "grep", "find", "ssh", "git", "curl", "sed", "awk", "rsync", "systemctl", "pacman", "chmod", "ps", "ffmpeg", "tmux", "journalctl"]

  // A command page: its sections in the order the app shows them.
  let FIRST = ["TLDR", "NAME", "SYNOPSIS", "DESCRIPTION", "PARAMETERS", "OPTIONS", "EXAMPLES", "CONFIGURATION"]
  let LAST = ["INSTALL", "CAVEATS", "HISTORY", "AUTHOR", "SEE ALSO", "RESOURCES"]
  let secs = sel == "" ? [] : split("\n" + doc, "\n# ").drop(1).map(s => match(s, '^([^\n]*)\n?([\s\S]*)$'))
  let tagline = trim((secs.find(s => s[0] == "TAGLINE") ?? ["", ""])[1])
  let shown = secs.filter(s => s[0] != "TAGLINE" && trim(s[1]) != "").sortBy(s => indexOf(FIRST, s[0]) >= 0 ? indexOf(FIRST, s[0]) : indexOf(LAST, s[0]) >= 0 ? 89 + indexOf(LAST, s[0]) : 50)
  let prev = first(back) ?? ""

  let basics = bidx == null ? [] : lines(bidx).map(l => replace(trim(l), ".md", "")).sortBy(b => lower(get(str.topics, b, b)))

  // A tab of the bottom bar, as in the mobile app: an icon in a pill when it's the one open, and its name.
  component Tab(name, label, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { tab = name; sel = ""; basic = ""; back = []; was = name != "tips" || url == TIPS ? null : page; url = name == "tips" ? TIPS : url; haptic("light") }
      Box {
        align: center
        width: 64
        height: 32
        Image { src: icon; size: 24; tint: tab == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: tab == name; color: tab == name ? foreground : muted }
    }
  }

  // A command name that opens its page; from a command page, back returns to it.
  component Chip(name, push = false) {
    Text {
      text: name; font: mono; style: small; align: center; maxLines: 1; width: len(name) * 8 + 22; padding: [0, 6]; radius: 3 * corners
      background: alpha(foreground, 0.06)
      onTap: { back = push ? [sel] + back : []; was = url == "commands/${name}.md" ? null : page; url = "commands/${name}.md"; sel = name; copied = "" }
    }
  }

  // One line of a page, or one ``` block, with the markdown taken out.
  component Block(b, flags = false, install = false) {
    let unlinked = join(matchAll(b, '\[([^\]]*)\]\([^)]*\)|([^\[]+|\[)').map(m => m[0] + m[1]), "")
    let plain = join(matchAll(unlinked, '[^*_`]+|(?<!\*)\*(?!\*)|(?<=[A-Za-z0-9])_(?=[A-Za-z0-9])'), "")
    // A table's |---| line under its header is left out.
    let kind = startsWith(b, "```") ? "code" : startsWith(b, "|") ? (match(b, '^[|:\- ]+$') == null ? "row" : "rule") : startsWith(b, "> ") ? "option" : startsWith(b, "## ") ? "heading" : startsWith(b, "- ") ? "bullet" : flags && startsWith(b, "**") ? "flag" : "text"
    let code = match(unlinked, '^```(?:[a-z]*\n)?([\s\S]*?)\n?```$')[0] ?? unlinked
    // An install line reads "pacman: sudo pacman -S tar"; only the command is copied.
    let cmd = install ? match(code, '^[\w-]+: (.*)$')[0] ?? code : code
    let cells = split(trim(plain), "|")
    if kind == "code" {
      Text {
        text: code; font: mono; style: small; fill: width; padding: [10, 8]; radius: 4 * corners
        color: copied == cmd ? accent : foreground
        background: copied == cmd ? alpha(accent, 0.12) : alpha(foreground, 0.06)
        onTap: { copy(cmd); copied = cmd; haptic() }
      }
    }
    if kind == "row" {
      Row {
        gap: 10
        align: top
        for c in cells.drop(1).take(max(len(cells) - 2, 0)) { Text { text: trim(c); style: small; weight: 1 } }
      }
    }
    if kind == "option" { Text { text: trim(drop(plain, 2)); color: muted; padding: [16, 0, 0, 4] } }
    if kind == "heading" { Text { text: trim(drop(plain, 3)); bold: true; padding: [0, 10, 0, 0] } }
    if kind == "bullet" { Text { text: "•  ${trim(drop(plain, 2))}"; padding: [8, 0, 0, 0] } }
    if kind == "flag" { Text { text: plain; font: mono; color: accent } }
    if kind == "text" { Text { text: plain } }
  }

  component Body(md, flags = false, install = false) {
    Column {
      gap: 8
      fill: width
      // Fenced blocks (one line or several), then every other line; page titles and comments are left out.
      // Install lines put Arch's first.
      for b in matchAll(md, '```[^`\n]*\n[\s\S]*?\n```|```[^\n]*?```|[^\n]+').filter(l => !startsWith(l, "# ") && !startsWith(l, "<!--")).sortBy(l => install && !startsWith(l, "```pacman") ? 1 : 0) {
        Block { b: b; flags: flags; install: install }
      }
    }
  }

  component Status() {
    if !ready {
      Text { text: str.loading; color: muted }
    } else {
      if !page.ok {
        Text { text: page.code > 0 ? str.httpError(page.code) : str.offline; color: muted }
        Button { text: str.tryAgain; onTap: refresh() }
      }
    }
  }

  Column {
    fill: true
    gap: 0
    // The pages keep a margin; the bar below runs to the screen's edges.
    Column {
      weight: 1
      gap: 10
      padding: [12, 0, 12, 10]
      if tab == "commands" && sel == "" {
        Row {
          align: center
          Input { text: q; placeholder: str.search; weight: 1; onChange: { q = value; copied = "" } }
          if q != "" {
            Text { text: "✕"; color: muted; width: 32; align: center; onTap: q = "" }
          }
        }
        Column {
          scroll: true
          weight: 1
          gap: 2
          if idx == null {
            Text { text: str.loadingList; color: muted }
          } else {
            if qq == "" {
              Text { text: len(mine) > 0 ? str.installed(len(mine)) : str.popular; style: label; color: muted; padding: [0, 6, 0, 4] }
              Flow {
                gap: 6
                for n in len(mine) > 0 ? mine : popular key n { Chip { name: n } }
              }
            } else {
              if len(hits) == 0 {
                Text { text: str.noMatch(qq); color: muted }
              }
              for n in hits key n {
                Text { text: n; font: mono; fill: width; maxLines: 1; padding: [4, 9]; onTap: { back = []; was = url == "commands/${n}.md" ? null : page; url = "commands/${n}.md"; sel = n; copied = "" } }
              }
            }
          }
        }
      }

      if tab == "commands" && sel != "" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            if tagline != "" {
              Text { text: tagline; color: muted }
            }
            for s in shown key s[0] {
              Text { text: lower(s[0]); style: label; color: accent; padding: [0, 10, 0, 0] }
              if s[0] == "SEE ALSO" {
                Flow {
                  gap: 6
                  for l in matchAll(s[1], '\[([^\]]+)\]\(/man/([^)]+)\)') { Chip { name: l[1]; push: true } }
                }
              }
              if s[0] == "RESOURCES" {
                for l in matchAll(s[1], '\[([^\]]+)\]\((https?://[^)\s]+)\)') {
                  Text { text: "${l[0]} ↗"; color: accent; padding: [0, 4]; onTap: url(l[1]) }
                }
              }
              if s[0] != "SEE ALSO" && s[0] != "RESOURCES" {
                Body { md: s[1]; flags: s[0] == "PARAMETERS" || s[0] == "OPTIONS"; install: s[0] == "INSTALL" }
              }
            }
          }
        }
      }

      if tab == "basics" && basic == "" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          if bidx == null {
            Text { text: str.loading; color: muted }
          }
          for b in basics key b {
            Text { text: get(str.topics, b, b); fill: width; maxLines: 1; padding: [4, 10]; onTap: { was = url == "basics/${b}.md" ? null : page; url = "basics/${b}.md"; basic = b; copied = "" } }
          }
        }
      }

      if tab == "basics" && basic != "" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            Body { md: doc }
          }
        }
      }

      if tab == "tips" {
        Column {
          scroll: true
          weight: 1
          gap: 10
          Status { }
          if ready && page.ok {
            Body { md: doc }
          }
        }
      }
    }

    Box { height: 1; fill: width; background: alpha(muted, 0.25) }
    Row {
      gap: 0
      Tab { name: "basics"; label: str.basics; icon: puzzle }
      Tab { name: "tips"; label: str.tips; icon: idea }
      Tab { name: "commands"; label: str.commands; icon: search }
    }
  }
}
