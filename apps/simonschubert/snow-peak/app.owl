    + (c.zt == 4 ? [12, 36].map(dz => [c.z0 + dz].map(z => [(((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + ((hash(floor((c.k) / 6), seed, 63) < 0.5 ? -1 : 1)) * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 5.5))].map(x => [[x, ((((-0.34 * z + 5 * sin(z / 120 + S.s4))) + pow(clamp(min(abs(x - (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)))) - ((10.5 + 2.5 * sin(z / 130 + S.s3))), abs(x - ([first(LANES.filter(s => (z) >= s.zs && (z) <= s.ze))].map(s => s == null ? 9999 : (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))[0])) - 2.4), 0, 26), 2) * 0.024 + 0.4 * sin(x * 0.23 + S.s5) * sin(z * 0.11))), z, 1, 11, 9999]].map(u => {x: u[0], y: u[1], z: u[2], s: u[3], k: u[4], ln: u[5], r: HIT[u[4]][0] * u[3], rz: HIT[u[4]][1] * u[3], h: HIT[u[4]][2] * u[3], cr: HIT[u[4]][3] * u[3]})[0])[0])[0]) : []))
  // Everything that stands, as boxes: what's in the chunk, the poles along both edges of the piste and the gate. What
