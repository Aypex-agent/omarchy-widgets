    + flatten(flatten(LANES.map(s => range(6).map(i => c.z0 + i * 8 + 4).filter(z => z >= s.zs + 30 && z <= s.ze - 30).map(z => [(((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150))].map(L => [-1, 1].map(sd => {x: L + sd * 3, y: (((-0.34 * z + 5 * sin(z / 120 + S.s4))) + pow(clamp(min(abs(((L + sd * 3)) - (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)))) - ((10.5 + 2.5 * sin(z / 130 + S.s3))), abs(((L + sd * 3)) - ([first(LANES.filter(s => (z) >= s.zs && (z) <= s.ze))].map(s => s == null ? 9999 : (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))[0])) - 2.4), 0, 26), 2) * 0.024 + 0.4 * sin(((L + sd * 3)) * 0.23 + S.s5) * sin(z * 0.11)) - 0.3, z: z, w: 0.24, h: 2.2, d: 0.24, c: floor(z / 8) % 2 == 0 ? ICE : GOLD, t: GOLD}))[0]))))
    + flatten(LANES.filter(s => s.zs + 22 >= c.z0 && s.zs + 22 < c.z0 + CH).map(s => [s.zs + 22].map(z => [[(((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)), (((-0.34 * z + 5 * sin(z / 120 + S.s4))) + pow(clamp(min(abs((((((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))) - (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)))) - ((10.5 + 2.5 * sin(z / 130 + S.s3))), abs((((((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))) - ([first(LANES.filter(s => (z) >= s.zs && (z) <= s.ze))].map(s => s == null ? 9999 : (((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))[0])) - 2.4), 0, 26), 2) * 0.024 + 0.4 * sin((((((S.a1 * sin(z / S.p1 + S.s1) + S.a2 * sin(z / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(z / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(z / 130 + S.s3)) + 6) * sin(3.1416 * ((z) - s.zs) / 150)))) * 0.23 + S.s5) * sin(z * 0.11))]].map(e => [
