        }
        // A tree or a rock in the way (and not flown over): a wipeout, set down beside it.
        let hit = ending ? null : first(OBN.filter(o => abs(o.z - pz) < o.rz && abs(o.x - px) < o.r && ay - o.y < o.h))
        if hit != null {
          crashT = gt
          ending = true
          fallS = px < hit.x ? -1 : 1
          px = hit.x + (px < hit.x ? -1 : 1) * (hit.r + 0.2)
          v = 3
          air = false
          ay = (((-0.34 * pz + 5 * sin(pz / 120 + S.s4))) + pow(clamp(min(abs(px - (((S.a1 * sin(pz / S.p1 + S.s1) + S.a2 * sin(pz / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(pz / 160, 0, 1)))) - ((10.5 + 2.5 * sin(pz / 130 + S.s3))), abs(px - ([first(LANES.filter(s => (pz) >= s.zs && (pz) <= s.ze))].map(s => s == null ? 9999 : (((S.a1 * sin(pz / S.p1 + S.s1) + S.a2 * sin(pz / S.p2 + S.s2) - S.a1 * sin(S.s1) - S.a2 * sin(S.s2)) * clamp(pz / 160, 0, 1)) + s.sd * ((10.5 + 2.5 * sin(pz / 130 + S.s3)) + 6) * sin(3.1416 * ((pz) - s.zs) / 150)))[0])) - 2.4), 0, 26), 2) * 0.024 + 0.4 * sin(px * 0.23 + S.s5) * sin(pz * 0.11))
          vy = 0
          msg = str.wipeout
          msg2 = ""
          msgK = 1
          msgAt = gt
        }
        // Through a gate, every 400 m: how far.
        if pz >= nextCP * CPD {
          msg = str.meters(fmtNum(nextCP * CPD))
          msg2 = ""
          msgK = 2
          msgAt = gt
          nextCP = nextCP + 1
        }
        // Onto a shortcut lane, off the piste.
        if (lane && abs(px - c0) > w0) != laneS {
          laneS = lane && abs(px - c0) > w0
          if laneS {
            msg = str.shortcut
            msg2 = str.boost
            msgK = 3
            msgAt = gt
          }
        }
        // A zone's name as the rider comes into it.
        if pz > 0 && floor(floor(pz / CH) / 6) != zoneI {
          zoneI = floor(floor(pz / CH) / 6)
          msg = str.zone((((floor(pz / CH))) < 6 ? 0 : ZORD[floor(((floor(pz / CH))) / 6) % 5]))
          msg2 = ""
          msgK = 3
          msgAt = gt
        }
        // The end of the run, a wipeout once the rider has tumbled: how far it got, the best kept.
        if ending && gt - crashT > 1.4 {
          let sc = max(0, floor(pz))
          why = "WIPEOUT"
          mode = "over"
          overAt = gt
          score = sc
          newBest = sc > (best[str(seed)] ?? 0)
          if sc > (best[str(seed)] ?? 0) {
            best = set(best, str(seed), sc)
          }
          if sc > bestAll {
            bestAll = sc
          }
        }
        // Snow spray off the tail: more carving hard, in powder and fast; a burst landing and in a wipeout.
        let fwx = sin(rad(ph))
        let fwz = cos(rad(ph))
        let rate = air ? 0 : abs(sd) * v * 2.2 + (off ? v * 1.6 : v * 0.3) + (gt - landT < 0.1 ? 260 : 0) + (gt - crashT < 0.25 ? 260 : 0)
        let ns = min(8, floor(rate * dt + random()))
        let born = range(ns).map(i => [[random(), random(), random()]].map(q => {
          x: px - fwx * 0.7 + (q[0] - 0.5) * 0.6, y: ay + 0.1, z: pz - fwz * 0.7 + (q[1] - 0.5) * 0.6,
          vx: fwx * v * 0.35 + fwz * sd * (2 + q[2] * 4) + (q[0] - 0.5) * 3, vy: 1.2 + q[2] * 3.2, vz: fwz * v * 0.35 - fwx * sd * (2 + q[2] * 4) + (q[1] - 0.5) * 3,
          t: 0, l: 0.45 + q[2] * 0.5})[0])
        fx = take(born + fx.filter(p => p.t + dt < p.l).map(p => merge(p, {x: p.x + p.vx * dt, y: p.y + p.vy * dt, z: p.z + p.vz * dt, vx: p.vx * pow(0.4, dt), vy: p.vy - 9 * dt, vz: p.vz * pow(0.4, dt), t: p.t + dt})), 48)
      }
      if mode == "over" {
        // the next run starts by itself
        if gt - overAt > 4 {
          go = go + 1
        }
        fx = fx.filter(p => p.t + dt < p.l).map(p => merge(p, {x: p.x + p.vx * dt, y: p.y + p.vy * dt, z: p.z + p.vz * dt, vy: p.vy - 9 * dt, t: p.t + dt}))
      }
      // The camera swings round after the rider's way and follows its height, slower in the air.
      camH = camH + (((ph - camH + 540) % 360) - 180) * (1 - pow(0.04, dt))
      camY = camY + (ay - camY) * (1 - pow(air ? 0.01 : 0.0002, dt))
    }
  }

  // The screens' parts. The UI is square blocks on darker ledges, like the world, in a blocky pixel font.
  let LAND = LANDV
  let PADT = max(screenTop ?? 0, 10)

  component Block(label, bg, ledge, fg = white, size = 16, pad = 14) {
    Column {
      gap: 0
      Text { text: label; fill: width; align: center; padding: [10, pad]; font: PIX; fontSize: size; color: fg; background: bg }
      Spacer { fill: width; height: 6; background: ledge }
    }
  }

  component Title(size = 34) {
    Column {
      gap: 0
      fill: width
      Text { text: "SNOW PEAK"; fill: width; font: PIX; fontSize: size; color: white; align: center; padding: [0, size / 3]; background: ICE }
      Spacer { fill: width; height: 6; background: ICED }
    }
  }

  // The mountain: its name, seed and light, the best score on it, and other mountains to pick.
  component Mountain() {
    Column {
      fill: width
      gap: 0
      Column {
        fill: width
        gap: 4
        padding: [14, 12]
        background: alpha(INK, 0.86)
        Row {
          fill: width
          align: center
          Text { text: NAME; weight: 1; maxLines: 1; font: PIX; fontSize: 17; color: white }
          if seed == DAY {
            Text { text: str.today; padding: [6, 3]; font: PIX; fontSize: 9; color: INK; background: GOLD }
          }
        }
        Text { text: str.seed(SEEDS) + " - " + str.sky(floor(hash(seed, 10) * 4) % 4) + (SNOWING && !SKY.snow ? " - " + str.flurries : ""); font: PIX; fontSize: 9; maxLines: 1; color: alpha(white, 0.7) }
        Text { text: BEST > 0 ? str.best(fmtNum(BEST)) : str.noRun; font: PIX; fontSize: 11; color: BEST > 0 ? #9fe6a8 : alpha(white, 0.6) }
      }
      Spacer { fill: width; height: 5; background: alpha(black, 0.6) }
    }
  }

  component Pickers() {
    Column {
      fill: width
      gap: 8
      Row {
        fill: width
        gap: 8
        Column { gap: 0; weight: 1; onTap: seed = floor(random() * 100000); Block { label: str.newMountain; bg: #3a3d45; ledge: #26282e; size: 11; pad: 11; fill: width } }
        Column { gap: 0; weight: 1; onTap: seed = DAY; Block { label: str.todays; bg: seed == DAY ? GOLD : #3a3d45; ledge: seed == DAY ? #a8841a : #26282e; fg: seed == DAY ? INK : white; size: 11; pad: 11; fill: width } }
      }
      Row {
        fill: width
        gap: 6
        align: center
        for r in [["ski", str.ski], ["board", str.board]] {
          Column { gap: 0; width: 64; onTap: rider = r[0]; Block { label: r[1]; bg: rider == r[0] ? white : #3a3d45; ledge: rider == r[0] ? #9aa3b0 : #26282e; fg: rider == r[0] ? INK : white; size: 11; pad: 11; fill: width } }
        }
        Spacer { weight: 1 }
        for jc, i in JACKETS {
          Column {
            gap: 0
            onTap: jacket = i
            Column {
              gap: 0
              padding: 3
              background: jacket == i ? white : alpha(INK, 0.86)
              Spacer { size: 18; background: jc.c }
            }
            Spacer { width: 24; height: 5; background: jacket == i ? #9aa3b0 : alpha(black, 0.6) }
          }
        }
      }
    }
  }

  component Hint() {
    Text { text: tilted ? str.hintTilt : str.hintArrows; font: PIX; fontSize: 9; color: white; align: center; fill: width; padding: [10, 8]; background: alpha(INK, 0.7) }
  }

  Box {
    fill: true
    background: HAZE
    Canvas {
      fill: true
      // The sky, from deep overhead to the haze at the horizon (found by projecting a point far out at eye height),
      // and a square sun low in it, glowing.
      let EY = cam.eye
      let DX = cam.look[0] - EY[0]
      let DZ = cam.look[2] - EY[2]
      let DL = max(0.001, sqrt(DX * DX + DZ * DZ))
      let HY = clamp((project([EY[0] + DX / DL * 30000, EY[1], EY[2] + DZ / DL * 30000], camB, width, height) ?? {y: height * 0.4}).y, 1, height)
      // (both reach well past the sides: in landscape the 3D scene also draws over the strips beside the cutout and
      // the navigation bar, which the canvas doesn't cover)
      rect(-400, -400, width + 800, HY + 400, fill: linear(0, 0, 0, HY, [SKY.top, SKY.sky, HAZE]))
      rect(-400, HY - 1, width + 800, height - HY + 401, fill: linear(0, HY, 0, height, [HAZE, mix(SKY.pow, HAZE, 0.25)]))
      let SP = project([EY[0] + SKY.sunDir[0] * 30000, EY[1] + SKY.sunDir[1] * 30000, EY[2] + SKY.sunDir[2] * 30000], camB, width, height)
      if SP != null && !SKY.snow {
        rect(SP.x - 120, SP.y - 120, 240, 240, fill: alpha(SKY.sun, 0.1))
        rect(SP.x - 78, SP.y - 78, 156, 156, fill: alpha(SKY.sun, 0.18))
        rect(SP.x - 48, SP.y - 48, 96, 96, fill: alpha(SKY.sun, 0.35))
        rect(SP.x - 32, SP.y - 32, 64, 64, fill: SKY.sun)
      }
      // The ranges round the valley: two stepped skylines, far and pale, near and darker, each step a block of rock
      // with snow on its upper part, by compass bearing (so they turn with the camera), drawn from the horizon up.
      let YAW = deg(atan2(DX, DZ))
      let FOCB = height / 2 / tan(rad(cam.fov / 2))
      for L in [0, 1] {
        let stp = L == 0 ? 2 : 3
        let b0 = floor((YAW - 72) / stp)
        let EL = range(b0, b0 + ceil(144 / stp) + 1).map(b => PROF[L][((b % len(PROF[L])) + len(PROF[L])) % len(PROF[L])])
        let XS = range(b0, b0 + ceil(144 / stp) + 2).map(b => width / 2 + tan(rad(clamp(b * stp - YAW, -80, 80))) * FOCB)
        let snowC = mix(#f4f8fc, HAZE, L == 0 ? 0.5 : 0.22)
        let rockC = mix(SKY.rock, HAZE, L == 0 ? 0.55 : 0.3)
        path([[XS[0], HY + 1]] + flatten(range(len(EL)).map(i => [[XS[i], HY - tan(rad(EL[i])) * FOCB], [XS[i + 1], HY - tan(rad(EL[i])) * FOCB]])) + [[XS[len(EL)], HY + 1]], closed: true, fill: snowC)
        path([[XS[0], HY + 1]] + flatten(range(len(EL)).map(i => [[XS[i], HY - tan(rad(min(EL[i], SNOWL[L] + (EL[i] - SNOWL[L]) * 0.35))) * FOCB], [XS[i + 1], HY - tan(rad(min(EL[i], SNOWL[L] + (EL[i] - SNOWL[L]) * 0.35))) * FOCB]])) + [[XS[len(EL)], HY + 1]], closed: true, fill: rockC)
      }
      // The snow, each chunk a smooth terrain 4 m a cell; then the rider's shadow on it, in a scene of its own so the
      // slope never sorts over it.
      scene(cam, light: LIGHT, ambient: 0.72, fog: HAZE) {
        for c, n in CHD {
          model(TER[n], at: [c.xc, 0, c.z0 + 24], scale: [4, 1, 4])
        }
      }
      scene(cam, light: LIGHT, ambient: 1, fog: HAZE) {
        model(SHADOWM, at: [0, 0, 0])
      }
      scene(cam, light: LIGHT, ambient: 0.66, fog: HAZE) {
        for om in OBM {
          model(om, at: [0, 0, 0])
        }
        if boot >= 2 {
          for o in NEARO {
            model(UNITM[o.k], at: [o.x, o.y, o.z], scale: o.s)
          }
        }
        for rm in RAMPM {
          model(rm, at: [0, 0, 0])
        }
        for cm in CABM {
          model(cm, at: [0, 0, 0])
        }
        for ch in CHAIRS {
          model(CHAIRM[ch.m], at: [ch.x, ch.y, ch.z])
        }
        model(RB, at: ROOT, turn: BT)
        for i in [0, 1] {
          model(SHM, at: [[ANK, LEGO[i]]].map(q => [q[0][0] + q[1][0], q[0][1] + q[1][1], q[0][2] + q[1][2]])[0], turn: SHT)
          model(THM, at: [[KNE, LEGO[i]]].map(q => [q[0][0] + q[1][0], q[0][1] + q[1][1], q[0][2] + q[1][2]])[0], turn: THT)
          model(UAM, at: SHW[i], turn: UAT[i])
          model(FAM, at: ELW[i], turn: FAT[i])
          if !BOARD {
            model(POLM, at: HND[i], turn: PLT[i])
          }
        }
        model(RU, at: HIPC, turn: TT)
        model(SCM, at: SCF, turn: SCFT)
      }
      // The spray, drawn over the scene as squares where it shows, smaller further off, growing and fading.
      if chase {
        let FOC = height / 2 / tan(rad(cam.fov / 2))
        for p in fx {
          let q = project([p.x, p.y, p.z], cam, width, height)
          if q != null {
            let a = p.t / p.l
            let sz = min(14, (0.1 + a * 0.22) * FOC / q.depth)
            rect(q.x - sz / 2, q.y - sz / 2, sz, sz, fill: alpha(SKY.spray, 0.85 * (1 - a)))
          }
        }
      }
      // Falling snow on some mountains: flakes drifting down and sideways as the camera turns.
      if SNOWING {
        for i in range(46) {
          let fz = 0.4 + hash(i, 7) * 0.6
          let sx = (hash(i, 1) * (width + 40) + sin(gt * 0.8 + i) * 14 * fz - camH * 6 * fz + 100000) % (width + 40) - 20
          let sy = (hash(i, 2) * (height + 40) + gt * (40 + 70 * fz) + (chase ? pz * 4 * fz : 0)) % (height + 40) - 20
          rect(sx, sy, 2 + 3 * fz, 2 + 3 * fz, fill: alpha(#ffffff, 0.5 + 0.4 * fz))
        }
      }
    }
    // The run's numbers on square dark blocks: how far, the best, the speed, and
    // the checkpoint or wipeout just now.
    if chase {
      Canvas {
        fill: true
        let TOPY = PADT + 8
        rect(12, TOPY, 150, 66, fill: alpha(INK, 0.82))
        rect(12, TOPY + 66, 150, 5, fill: alpha(black, 0.55))
        text(str.distance, 24, TOPY + 15, size: 10, font: PIX, color: alpha(white, 0.75))
        text(str.meters(fmtNum(dist)), 24, TOPY + 44, size: 24, font: PIX, color: white)
        rect(width - 152, TOPY, 140, 66, fill: alpha(INK, 0.82))
        rect(width - 152, TOPY + 66, 140, 5, fill: alpha(black, 0.55))
        text(str.bestLabel, width - 24, TOPY + 15, size: 10, font: PIX, align: end, color: alpha(GOLD, 0.8))
        text(str.meters(fmtNum(BESTD)), width - 24, TOPY + 44, size: 24, font: PIX, align: end, color: GOLD)
        if mode != "over" {
          // landscape: at the top on a block of its own, clear of the rider; portrait: on the snow under it
          if LAND {
            rect(width / 2 - 56, TOPY, 112, 66, fill: alpha(INK, 0.82))
            rect(width / 2 - 56, TOPY + 66, 112, 5, fill: alpha(black, 0.55))
          }
          text(str(kmh), width / 2, LAND ? TOPY + 26 : height - 74, size: 32, font: PIX, align: center, color: LAND ? white : INK)
          text(str.kmh, width / 2, LAND ? TOPY + 52 : height - 46, size: 11, font: PIX, align: center, color: LAND ? alpha(white, 0.75) : alpha(INK, 0.75))
        }
        if mode == "count" {
          let left3 = ceil(t0 - gt)
          text(left3 > 3 ? "" : str(left3), width / 2, height * 0.34, size: 80, font: PIX, align: center, color: left3 == 1 ? GOLD : INK)
        }
        if mode == "run" && gt - t0 < 0.9 {
          text(str.go, width / 2, height * 0.34, size: 80, font: PIX, align: center, color: RED)
        }
        if mode == "run" && gt - t0 > 0.9 && gt - t0 < 4.5 {
          rect(width / 2 - 150, height * 0.3 - 16, 300, 32, fill: alpha(INK, 0.8))
          text(tilted ? str.runTilt : str.runArrows, width / 2, height * 0.3, size: 11, font: PIX, align: center, color: white)
        }
        if mode == "run" && gt - msgAt < 1.6 {
          let mw = max(160, len(msg) * 17 + 40)
          rect(width / 2 - mw / 2, height * 0.24, mw, msg2 == "" ? 46 : 70, fill: msgK == 1 ? alpha(#d8242a, 0.9) : (msgK == 2 ? alpha(ICE, 0.92) : alpha(INK, 0.86)))
          text(msg, width / 2, height * 0.24 + 24, size: 20, font: PIX, align: center, color: msgK == 3 ? GOLD : white)
          if msg2 != "" {
            text(msg2, width / 2, height * 0.24 + 52, size: 13, font: PIX, align: center, color: white)
          }
        }
      }
    }
    // Without tilt, arrows in the bottom corners carve.
    if mode == "count" || mode == "run" {
      if !tilted {
        Column {
          fill: true
          padding: [16, 24]
          justify: end
          Row {
            fill: width
            justify: spaceBetween
            align: bottom
            Column {
              gap: 0
              onPress: left = true
              onRelease: left = false
              Spacer { height: left ? 6 : 0 }
              Text { text: "<"; width: 84; height: 84; align: center; padding: [0, 26]; font: PIX; fontSize: 26; color: white; background: left ? ICE : alpha(INK, 0.82) }
              Spacer { width: 84; height: left ? 0 : 6; background: alpha(black, 0.6) }
            }
            Column {
              gap: 0
              onPress: right = true
              onRelease: right = false
              Spacer { height: right ? 6 : 0 }
              Text { text: ">"; width: 84; height: 84; align: center; padding: [0, 26]; font: PIX; fontSize: 26; color: white; background: right ? ICE : alpha(INK, 0.82) }
              Spacer { width: 84; height: right ? 0 : 6; background: alpha(black, 0.6) }
            }
          }
        }
      }
      Column {
        fill: true
        padding: [12, PADT + 84, 0, 0]
        align: start
        Text { text: "X"; width: 44; height: 44; align: center; padding: [0, 12]; font: PIX; fontSize: 16; color: white; background: alpha(INK, 0.8); onTap: { mode = "menu"; left = false; right = false } }
      }
    }
    // The end of a run: how far, and the best on this mountain.
    if mode == "over" {
      Column {
        fill: true
        justify: center
        align: center
        padding: 24
        Column {
          gap: 0
          Column {
            width: 320
            gap: 6
            align: center
            padding: [20, 22]
            background: alpha(INK, 0.9)
            Text { text: why == "WIPEOUT" ? str.wipeout : why; font: PIX; fontSize: 28; color: why == "WIPEOUT" ? #ff5a4a : GOLD; align: center }
            Text { text: NAME; font: PIX; fontSize: 12; color: alpha(white, 0.7); align: center }
            Spacer { size: 4 }
            Text { text: str.distance; font: PIX; fontSize: 10; color: alpha(white, 0.6); align: center }
            Text { text: str.meters(fmtNum(score)); font: PIX; fontSize: 36; color: white; align: center }
            Text { text: newBest ? str.newHigh : str.highScore(fmtNum(BEST)); font: PIX; fontSize: 12; color: newBest ? #5cdc5a : GOLD; align: center }
            Spacer { size: 4 }
            Text { text: str.nextRun(max(1, ceil(4 - (gt - overAt)))); font: PIX; fontSize: 10; color: alpha(white, 0.6); align: center }
            Spacer { width: 276 * clamp((gt - overAt) / 4, 0, 1); height: 4; background: RED }
            Spacer { size: 6 }
            Row {
              gap: 10
              Column { gap: 0; width: 120; onTap: go = go + 1; Block { label: str.again; bg: RED; ledge: REDD; size: 13; pad: 11; fill: width } }
              Column { gap: 0; width: 120; onTap: mode = "menu"; Block { label: str.menu; bg: #5a5f6a; ledge: #33363d; size: 13; pad: 11; fill: width } }
            }
          }
          Spacer { width: 320; height: 6; background: alpha(black, 0.6) }
        }
      }
    }
    // The menu: the rider waiting above the start gate. Portrait: the title at the top, the mountain, the rider and
    // RIDE at the bottom; landscape: the title on the left, the rest in a panel on the right.
    if mode == "menu" {
      if LAND {
        Row {
          fill: true
          gap: 20
          align: top
          padding: [16, PADT + 6, 16, 14]
          Column {
            weight: 1
            gap: 10
            Title { size: 26 }
          }
          Column {
            width: 400
            fill: height
            gap: 8
            justify: end
            Mountain {}
            Pickers {}
            Hint {}
            Column { gap: 0; fill: width; onTap: go = go + 1; Block { label: str.ride; bg: RED; ledge: REDD; size: 24; pad: 12; fill: width } }
          }
        }
      } else {
        Column {
          fill: true
          padding: [20, PADT + 16, 20, 26]
          justify: spaceBetween
          Title {}
          Column {
            fill: width
            gap: 10
            Mountain {}
            Pickers {}
            Hint {}
            Column { gap: 0; fill: width; onTap: go = go + 1; Block { label: str.ride; bg: RED; ledge: REDD; size: 26; pad: 14; fill: width } }
          }
        }
      }
    }
  }
}
