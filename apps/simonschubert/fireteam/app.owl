      squadLost: "ESCOUADE PERDUE"
      cameHome: n => n == 1 ? "1 SUR 3 EST RENTRÉ" : "${n} SUR 3 SONT RENTRÉS"
      noneHome: "PERSONNE N'EST RENTRÉ"
      turns: n => n <= 1 ? "${n} TOUR" : "${n} TOURS"
      mapsRound: "LES CARTES REVIENNENT, PLUS DURES"
      next: name => "SUIVANTE : ${name}"
      tryAnother: "ESSAIE UNE AUTRE ENTRÉE"
      nextOp: "OP SUIVANTE"
      retry: "RÉESSAYER"
      tagline: "TACTIQUE D'ESCOUADE"
      carryOn: "CONTINUER"
      deploy: "DÉPLOYER"
      newCampaign: "NOUVELLE CAMPAGNE"
      soundOn: "SON ACTIVÉ"
      soundOff: "SON COUPÉ"
      best: n => "RECORD : ${n} OPS RÉUSSIES"
    }
    tr {
      op: n => "OP ${n}"
      opName: i => ["İLK TEMAS", "RIHTIM", "DEPO", "KAVŞAK", "TRAFO MERKEZİ", "AVLU", "YERLEŞKE", "KARARGÂH"][i]
      hostiles: "DÜŞMAN"
      onMove: "HAREKETTE"
      turn: n => "TUR ${n}"
      yourMove: "SIRA SENDE"
      flanked: "KANATTAN"
      miss: "ISKA"
      overwatch: "NÖBET"
      watch: "NÖBET"
      kia: "ÖLDÜ"
      nadeAll: "9 KAREYE 3 HASAR"
      nadePick: "EN FAZLA 5 UZAKTA BİR KARE SEÇ"
      outRange: "MENZİL DIŞI"
      noLos: "GÖRÜŞ HATTI YOK"
      blows: "3x3 PATLAR · 3 HASAR"
      shotInfo: (hc, lo, hi, cov) => "${hc}% · ${lo}-${hi} HASAR · ${cov}"
      full: "TAM SİPER"
      half: "YARIM SİPER"
      none: "SİPER YOK"
      move: "YÜRÜ"
      dash: "KOŞ"
      status: (f, g) => "${f} DÜŞMAN · ${g} BOMBA"
      waiting: "BEKLENİYOR"
      throw: "AT"
      shoot: "ATEŞ"
      fire: hc => "ATEŞ %${hc}"
      noShot: "ATIŞ YOK"
      grenade: "BOMBA"
      endTurn: "TURU BİTİR"
      opCleared: "OP TAMAM"
      squadLost: "TİM KAYBEDİLDİ"
      cameHome: n => "3 KİŞİDEN ${n} KİŞİ DÖNDÜ"
      noneHome: "KİMSE DÖNMEDİ"
      turns: n => "${n} TUR"
      mapsRound: "HARİTALAR BAŞA DÖNER, DAHA ZOR"
      next: name => "SIRADAKİ: ${name}"
      tryAnother: "BAŞKA BİR YOL DENE"
      nextOp: "SONRAKİ OP"
      retry: "TEKRAR"
      tagline: "TİM TAKTİĞİ"
      carryOn: "DEVAM"
