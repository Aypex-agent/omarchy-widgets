  """
  let SP_CHEV = """
    ooooooo
    oYYYYYo
    .oYYYo.
    ..oYo..
    ...o...
  """
  let PAL = [
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#5e7a3e", h: "#86a85a", P: "#4e6a34", p: "#3a5028", L: "#3e4a2c", K: "#5ad1e8"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#5e7a3e", h: "#86a85a", P: "#4e6a34", p: "#3a5028", L: "#3e4a2c", K: "#f0a040"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#5e7a3e", h: "#86a85a", P: "#4e6a34", p: "#3a5028", L: "#3e4a2c", K: "#c08aff"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#3a3a44", h: "#5a5a68", P: "#7a3434", p: "#5a2424", L: "#3a3038", K: "#ff5a4a"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#3a3a44", h: "#5a5a68", P: "#8a4a2a", p: "#5e321c", L: "#3a3038", K: "#ff5a4a", A: "#6a6e7a"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#5a5034", h: "#7a6e48", P: "#5e5a38", p: "#44402a", L: "#3a3628", K: "#ff5a4a"},
    {o: "#14121c", S: "#e8b088", s: "#b47a58", e: "#14121c", G: "#2c3038", g: "#6a7282", B: "#2a2420", W: "#ffffff", H: "#a83030", h: "#d04a40", P: "#2e2e3a", p: "#20202a", L: "#24242c", K: "#f0c040"}
  ]
  let ART = [SP_RIFLE, SP_SHOTGUN, SP_SNIPER, SP_GRUNT, SP_HEAVY, SP_MARKSMAN, SP_OFFICER]
  let DEADP = {o: "#16141c", S: "#6e6260", s: "#564c4c", e: "#16141c", G: "#26262c", g: "#40404a", B: "#201e26", W: "#8a8a90", H: "#44444c", h: "#52525a", P: "#3a3842", p: "#302e38", L: "#2a2830", K: "#52525a", A: "#44444c"}
  let PROPP = {o: INK, T: "#c08a50", t: "#8a5a30", u: "#e0aa6a", n: "#5e3a1e", R: "#c8423a", r: "#8a2a2a", Y: "#f0c040", m: "#2c2e35", W: "#ffffff"}
  let BARP = {o: INK, R: "#c8423a", r: "#8a2a2a", u: "#ee6a5a", Y: "#f0c040", n: "#3a2226"}
  let BAGP = {o: INK, T: "#bcaa78", t: "#8a7c56", u: "#d8ca9a"}
  let SCP = {n: "#25272e", m: "#2e3038", Y: "#ff8a3a"}
  // Buttons are pixel art: a light band on top, the face, a shaded band at its foot and a dark lip under it.
  let BTN = {
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
    blue: ["#a8d8ff", "#4a90e0", "#2e64b0", "#173866"],
    off: ["#8e88ac", "#5a5474", "#443e5c", "#221e36"],
    red: ["#ffaa94", "#e8504a", "#b8333a", "#621822"]
  }

  Box {
    fill: true
    background: background
    // ---- the map: drawn again only when it changes --------------------------------------------
    Canvas {
      fill: true
      if mode == "play" && len(grid) == N && len(vis) == N {
        rect(BX - 2 * q, BY - 2 * q, W * T + 4 * q, H * T + 4 * q, fill: INK)
        rect(BX, BY, W * T, H * T, fill: "#3a3f4b")
        for c in range(N) {
          let x0 = BX + c % W * T
          let y0 = BY + floor(c / W) * T
          let g = grid[c]
          if g != 1 {
            if (c % W + floor(c / W)) % 2 == 1 { rect(x0, y0, T, T, fill: "#363b46") }
            rect(x0, y0, T, 0.5 * q, fill: "#30343e")
            rect(x0, y0, 0.5 * q, T, fill: "#30343e")
            if hash(mis, c, 1) < 0.4 { rect(x0 + floor(1 + hash(mis, c, 2) * 9) * q, y0 + floor(1 + hash(mis, c, 3) * 9) * q, q, q, fill: "#454b58") }
            if hash(mis, c, 4) < 0.1 {
              rect(x0 + 3 * q, y0 + 6 * q, 3 * q, 0.6 * q, fill: "#2c3038")
              rect(x0 + 5.4 * q, y0 + 6 * q, 0.6 * q, 3 * q, fill: "#2c3038")
            }
            if g == 2 { sprite(SP_CRATE, x0, y0, q, palette: PROPP) }
            if g == 3 { sprite(SP_BARREL, x0, y0, q, palette: BARP) }
            if g == 4 { sprite(SP_SCORCH, x0, y0 + q, q, palette: SCP) }
            if g == 5 { sprite(SP_SANDBAG, x0, y0, q, palette: BAGP) }
          } else {
            // a wall: its top, lit along the north edge, and a face of bricks where the south is open
            let so = floor(c / W) == H - 1 || grid[c + W] != 1
            let no = floor(c / W) == 0 || grid[c - W] != 1
            rect(x0, y0, T, T, fill: "#5a5f70")
            if hash(mis, c, 5) < 0.5 { rect(x0 + 3 * q, y0 + 3 * q, q, q, fill: "#4c5060") }
            if no { rect(x0, y0, T, 1.5 * q, fill: "#7c8296") }
            if so {
              rect(x0, y0 + 7 * q, T, 5 * q, fill: "#3c4050")
              rect(x0, y0 + 7 * q, T, 0.6 * q, fill: "#2a2d38")
              rect(x0, y0 + 9.5 * q, T, 0.6 * q, fill: "#30333f")
              rect(x0 + (c % 2 == 0 ? 4 : 8) * q, y0 + 7 * q, 0.6 * q, 2.5 * q, fill: "#30333f")
              rect(x0 + (c % 2 == 0 ? 9 : 3) * q, y0 + 9.5 * q, 0.6 * q, 2.5 * q, fill: "#30333f")
            }
            if c % W == 0 || grid[c - 1] != 1 { rect(x0, y0, 0.6 * q, T, fill: INK) }
            if c % W == W - 1 || grid[c + 1] != 1 { rect(x0 + T - 0.6 * q, y0, 0.6 * q, T, fill: INK) }
            if no { rect(x0, y0, T, 0.6 * q, fill: INK) }
            if so { rect(x0, y0 + T - 0.6 * q, T, 0.6 * q, fill: INK) }
          }
        }
        // what the squad can't see lies in shadow
        for c in range(N) {
          if grid[c] != 1 && !vis[c] { rect(BX + c % W * T, BY + floor(c / W) * T, T, T, fill: alpha("#06070b", 0.55)) }
        }
      }
    }
    // ---- where the soldier picked can go or throw, and the way, the cover and the aim picked: drawn
    // again only when they change ----
    Canvas {
      fill: true
      if mode == "play" && len(grid) == N && len(vis) == N {
        if !won && !wiped && me != null && me.ap > 0 {
          if nade {
            for c in range(N) {
              if grid[c] != 1 && (c % W - me.x) * (c % W - me.x) + (floor(c / W) - me.y) * (floor(c / W) - me.y) <= 25 { rect(BX + c % W * T + q, BY + floor(c / W) * T + q, T - 2 * q, T - 2 * q, radius: q, fill: alpha("#ff9a3c", 0.14)) }
            }
            if tgt >= 0 {
              rect(BX + (tgt % W - 1) * T, BY + (floor(tgt / W) - 1) * T, 3 * T, 3 * T, radius: 2 * q, fill: alpha("#ff5a4a", 0.25), stroke: "#ff7a5a", width: q)
            }
          } else {
            for c in range(N) {
              if D[c] > 0 && D[c] <= KD[me.k].mv { rect(BX + c % W * T + q, BY + floor(c / W) * T + q, T - 2 * q, T - 2 * q, radius: q, fill: alpha("#5ab4ff", 0.16)) }
              if D[c] > KD[me.k].mv && D[c] < 99 { rect(BX + c % W * T + 1.5 * q, BY + floor(c / W) * T + 1.5 * q, T - 3 * q, T - 3 * q, radius: q, stroke: alpha("#f0c040", 0.4), width: 0.6 * q) }
            }
            if len(path) > 1 {
              path(path.map(z => [BX + (z % W + 0.5) * T, BY + (floor(z / W) + 0.5) * T]), stroke: alpha(D[tgt] <= KD[me.k].mv ? "#a8d8ff" : "#ffe9a0", 0.9), width: 1.5 * q, cap: round)
              let tx = BX + tgt % W * T
              let ty = BY + floor(tgt / W) * T
              rect(tx + q, ty + q, T - 2 * q, T - 2 * q, radius: q, stroke: "#ffffff", width: q)
              // shields on the sides that have cover
              for sd in range(4) {
                if tcov[sd] > 0 {
                  let sx = tx + T / 2 + [0, 0.42, 0, -0.42][sd] * T
                  let sy = ty + T / 2 + [-0.42, 0, 0.42, 0][sd] * T
                  rect(sx - 1.8 * q, sy - 2 * q, 3.6 * q, 4 * q, radius: 0.8 * q, fill: tcov[sd] >= 40 ? "#5ab4ff" : "#a8d8ff", stroke: INK, width: 0.5 * q)
                  if tcov[sd] >= 40 { rect(sx - 0.5 * q, sy - 1.2 * q, q, 2.4 * q, fill: INK) }
                }
              }
            }
            if pick != null {
              let ax = BX + (me.x + 0.5) * T
              let ay = BY + (me.y + 0.5) * T
              let ex = BX + (tgt % W + 0.5) * T
              let ey = BY + (floor(tgt / W) + 0.5) * T
              line(ax, ay, ex, ey, stroke: alpha(pick.ok ? "#ff5a4a" : "#8e88ac", 0.7), width: q)
              rect(ex - T / 2 + q, ey - T / 2 + q, T - 2 * q, T - 2 * q, radius: q, stroke: pick.ok ? "#ff5a4a" : "#8e88ac", width: q)
            }
          }
        }
      }
    }
    // ---- everyone on the map, and what the last action set going ----------------------------------
    Canvas {
      fill: true
      if mode == "play" && len(grid) == N && len(vis) == N {
        let now = time
        // a time far ahead is from before a reload, when the clock started again
        let FX = fxEnd > now + 10 ? [] : fx
        let idle = (now >= fxEnd || fxEnd > now + 10) && !won && !wiped && me != null && me.ap > 0
        // ---- everyone: where each one is drawn, sliding along a walk, and the health still to lose ----
        let DISP = units.map(u => [FX.find(z => z.k == 0 && z.i == u.i && now < z.t1)].map(mv => [mv == null ? 0 : clamp((now - mv.t0) / max(0.01, mv.t1 - mv.t0), 0, 1) * (len(mv.p) - 1)].map(pr => [floor(pr)].map(pj => [mv == null ? 0 : min(pj + 1, len(mv.p) - 1)].map(pn => [mv == null ? u.x : lerp(mv.p[pj][0], mv.p[pn][0], pr - pj)].map(ux => [mv == null ? u.y : lerp(mv.p[pj][1], mv.p[pn][1], pr - pj)].map(uy => {
            u: u, ux: ux, uy: uy, cx: BX + (ux + 0.5) * T, fy: BY + (uy + 1) * T - q,
            walking: mv != null && now >= mv.t0,
            fd: mv != null && now >= mv.t0 && mv.p[pn][0] != mv.p[pj][0] ? sign(mv.p[pn][0] - mv.p[pj][0]) : u.f,
            hs: u.hp + sum(FX.filter(z => z.k == 5 && z.i == u.i && now < z.t0).map(z => z.d)),
            seen: u.s == 0 || vis[round(uy) * W + round(ux)]
          })[0])[0])[0])[0])[0])[0]).filter(d => d.seen)
        // the fallen first, then from the top down
        for d in DISP.sortBy(d => (d.hs > 0 ? 100 : 0) + d.uy) {
          let u = d.u
          let cx = d.cx
          let fy = d.fy
          if d.hs <= 0 {
            rect(cx - 5 * q, fy - 4 * q, 10 * q, 3 * q, radius: 1.5 * q, fill: alpha("#4a0a10", 0.6))
            rotate(u.s == 0 ? -90 : 90, cx, fy - 4 * q) { sprite(ART[u.k], cx - 6 * q, fy - 11 * q, q, palette: DEADP) }
          } else {
            let bob = d.walking ? abs(sin(now * 18)) * q : 0
            rect(cx - 4.5 * q, fy - 2 * q, 9 * q, 2.5 * q, radius: 1.2 * q, fill: alpha("#000000", 0.35))
            if u.i == sel && u.s == 0 && !won {
              rect(cx - T / 2 + q, fy - T + 2 * q, T - 2 * q, T - 2 * q, radius: q, stroke: alpha("#ffe14a", 0.55 + 0.3 * sin(now * 5)), width: q)
            }
            scale(d.fd, 1, cx, fy) {
              if any(FX, z => z.k == 5 && z.i == u.i && now >= z.t0 && now < z.t0 + 0.14) {
                sprite(ART[u.k], cx - 6 * q, fy - 14 * q - bob, q, color: "#ffffff")
              } else {
                sprite(ART[u.k], cx - 6 * q, fy - 14 * q - bob, q, palette: PAL[u.k])
              }
            }
          }
        }
        // over all of them: health, a pip a point, overwatch, the one picked, and the odds of a shot
        for d in DISP {
          let u = d.u
          if d.hs > 0 {
            let cx = d.cx
            let pw = min(2.4 * q, T * 0.86 / u.mh)
            let hx = cx - pw * u.mh / 2
            // under the feet, so a unit standing above isn't hidden
            let hy = d.fy + 0.4 * q
            let ty = d.fy - 16 * q
            rect(hx - 0.6 * q, hy - 0.6 * q, pw * u.mh + 1.2 * q, 2.6 * q, fill: INK)
            for pp in range(u.mh) { rect(hx + pp * pw + 0.3 * q, hy, pw - 0.6 * q, 1.4 * q, fill: pp < d.hs ? (u.s == 0 ? "#6fe05a" : "#ff5a4a") : "#3a3440") }
            if u.ow { sprite(SP_EYE, cx - 3.5 * q, ty - 4 * q, q, palette: {o: INK, W: "#a8d8ff"}) }
            if u.i == sel && u.s == 0 && idle { sprite(SP_CHEV, cx - 3.5 * q, ty - 4 * q - abs(sin(now * 4)) * 2 * q - (u.ow ? 6 * q : 0), q, palette: {o: INK, Y: "#ffe14a"}) }
            let ai = idle && !nade ? aims.find(a => a.i == u.i && a.i >= 0) : null
            if ai != null && ai.ok {
              // beside the head
              rect(cx + 3 * q, d.fy - 15 * q, 9 * q, 5 * q, radius: q, fill: INK)
              text("${ai.hc}", cx + 7.5 * q, d.fy - 12.5 * q, size: 3.2 * q, color: ai.hc >= 65 ? "#6fe05a" : ai.hc >= 40 ? "#ffe14a" : "#ff8a5a", font: press, align: center)
            }
          }
        }
        // ---- what the last action set going ----
        for f in FX {
          if f.k == 1 && now >= f.t0 && now < f.t0 + 0.32 {
            // a shot: a muzzle flash, tracers, and sparks where it lands
            let e = (now - f.t0) / 0.32
            let ax = BX + (f.a[0] + 0.5) * T
            let ay = BY + (f.a[1] + 0.5) * T - 2 * q
            let bx = BX + (f.b[0] + 0.5) * T + (f.hit ? 0 : (hash(f.t0, 1) - 0.5) * 1.6 * T)
            let by = BY + (f.b[1] + 0.5) * T - 2 * q + (f.hit ? 0 : (hash(f.t0, 2) - 0.5) * 1.6 * T)
            let dl = max(1, sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay)))
            let mx = ax + (bx - ax) / dl * 6 * q
            let my = ay + (by - ay) / dl * 6 * q
            if e < 0.35 { circle(mx, my, (3.2 - 4 * e) * q, fill: "#ffe14a") }
            for s in (f.sg ? [-1, 0, 1] : [0]) {
              let sbx = bx + s * (by - ay) / dl * 0.35 * T
              let sby = by - s * (bx - ax) / dl * 0.35 * T
              let h0 = min(1, e * 2.4)
              let h1 = max(0, e * 2.4 - 0.5)
              if h1 < 1 { line(lerp(mx, sbx, h1), lerp(my, sby, h1), lerp(mx, sbx, h0), lerp(my, sby, h0), stroke: "#fff3a0", width: 0.9 * q, cap: round) }
            }
            if e > 0.45 && f.hit {
              for k in range(5) { rect(bx + cos(k * 1.26 + f.t0) * (e - 0.45) * 2 * T - 0.5 * q, by + sin(k * 1.26 + f.t0) * (e - 0.45) * 2 * T - 0.5 * q, q, q, fill: "#ffd27a") }
            }
          } else if f.k == 3 && now >= f.t0 && now < f.t1 {
            // a grenade in the air
            let s = (now - f.t0) / (f.t1 - f.t0)
            let gx = BX + (lerp(f.a[0], f.b[0], s) + 0.5) * T
            let gy = BY + (lerp(f.a[1], f.b[1], s) + 0.5) * T
            rect(gx - 1.5 * q, gy - q, 3 * q, 2 * q, radius: q, fill: alpha("#000000", 0.35))
            rect(gx - 1.5 * q, gy - 1.5 * q - sin(s * 3.1416) * 1.6 * T, 3 * q, 3 * q, radius: 0.8 * q, fill: "#4a5a34", stroke: INK, width: 0.5 * q)
          } else if f.k == 4 && now >= f.t0 && now < f.t0 + 0.8 {
            // a blast: a flash over the nine tiles, fire, and smoke drifting off
            let e = (now - f.t0) / 0.8
            let ex = BX + (f.x + 0.5) * T
            let ey = BY + (f.y + 0.5) * T
            if e < 0.3 { rect(ex - 1.5 * T, ey - 1.5 * T, 3 * T, 3 * T, fill: alpha("#ffd27a", 0.45 * (1 - e / 0.3))) }
            circle(ex, ey, T * (0.6 + 1.1 * e), fill: alpha("#ff7a3a", 0.85 * (1 - e)))
            circle(ex, ey, T * (0.3 + 0.7 * e), fill: alpha("#ffe9a0", max(0, 1 - e * 1.6)))
            for k in range(8) {
              let sz = (3 + 3 * hash(f.x, f.y, k)) * q * (1 - e * 0.5)
              rect(ex + cos(k * 0.785 + 0.3) * e * 1.6 * T - sz / 2, ey + sin(k * 0.785 + 0.3) * e * 1.4 * T - e * 0.6 * T - sz / 2, sz, sz, fill: alpha(k % 2 == 0 ? "#5a5660" : "#7a7480", 0.85 * (1 - e)))
            }
          } else if f.k == 5 && now >= f.t0 && now < f.t0 + 1.1 {
            let e = (now - f.t0) / 1.1
            let dx = BX + (f.x + 0.5) * T
            let dy = BY + (f.y + 0.1) * T - e * 0.7 * T
            text("-${f.d}", dx + q * 0.5, dy + q * 0.5, size: 4.5 * q, color: INK, font: press, align: center)
            text("-${f.d}", dx, dy, size: 4.5 * q, color: "#ff5a4a", font: press, align: center)
            if f.fl { text("FLANKED", dx, dy - 5 * q, size: 2.6 * q, color: "#ffe14a", font: press, align: center) }
          } else if f.k == 6 && now >= f.t0 && now < f.t0 + 1 {
            let e = now - f.t0
            text("MISS", BX + (f.x + 0.5) * T, BY + (f.y + 0.1) * T - e * 0.6 * T, size: 3.2 * q, color: "#d8d4ec", font: press, align: center)
          } else if f.k == 7 && now >= f.t0 && now < f.t0 + 1 {
            let e = now - f.t0
            text("OVERWATCH", BX + (f.x + 0.5) * T, BY + (f.y - 0.6) * T - e * 0.5 * T, size: 2.8 * q, color: "#a8d8ff", font: press, align: center)
          } else if f.k == 9 && now >= f.t0 && now < f.t0 + 1.2 && vis[f.y * W + f.x] {
            let ax = BX + (f.x + 0.5) * T
            let ay = BY + (f.y - 0.7) * T - abs(sin((now - f.t0) * 9)) * 2 * q
            rect(ax - 2 * q, ay - 3.5 * q, 4 * q, 7 * q, radius: q, fill: INK)
            rect(ax - q, ay - 2.5 * q, 2 * q, 3.5 * q, fill: "#ffe14a")
            rect(ax - q, ay + 1.5 * q, 2 * q, q, fill: "#ffe14a")
          } else if f.k == 8 && now >= f.t0 && now < f.t0 + 1.5 {
            // a banner across the map
            let e = (now - f.t0) / 1.5
            let a = clamp(min(e * 8, (1 - e) * 6), 0, 1)
            let cy = BY + H * T * 0.45
            layer(a) {
              rect(BX, cy - 30, W * T, 60, fill: alpha(INK, 0.85))
              rect(BX, cy - 30, W * T, 2, fill: f.s == "HOSTILES" ? "#ff5a4a" : "#ffe14a")
              rect(BX, cy + 28, W * T, 2, fill: f.s == "HOSTILES" ? "#ff5a4a" : "#ffe14a")
              text(f.s, BX + W * T / 2 + (1 - a) * 30, cy - 8, size: 16, color: f.s == "HOSTILES" ? "#ff5a4a" : "#ffffff", font: press, align: center)
              text(f.s2, BX + W * T / 2 - (1 - a) * 30, cy + 14, size: 8, color: "#d8d4ec", font: press, align: center)
            }
          }
        }
      }
    }
    // ---- the top bar, the panel, and the title and end screens over everything; taps land here --
    Canvas {
      fill: true
      onPress: { downAt = [x, y] }
      onRelease: { downAt = [-1, -1] }
      ripple: false
      onTap: {
        if mode == "title" {
          if y >= TBY && y < TBY + 56 && abs(x - SW / 2) < 120 {
            if won {
              best = max(best, mis + 1)
              mis = mis + 1
            }
            if len(units) == 0 || won || wiped { go = go + 1 } else { mode = "play" }
            haptic()
          } else if len(units) > 0 && y >= TBY + 70 && y < TBY + 106 && abs(x - SW / 2) < 110 {
            mis = 0
            go = go + 1
          }
        } else if time >= fxEnd || fxEnd > time + 10 {
          if won || wiped {
            if y >= OBY && y < OBY + 50 && abs(x - SW / 2) < 110 {
              if won {
                best = max(best, mis + 1)
                mis = mis + 1
              }
              go = go + 1
              haptic()
            }
          } else if x >= HX + HW - 46 && y < TOP + 32 {
            mode = "title"
            tgt = -1
            nade = false
          } else {
            let onMap = x >= BX && x < BX + W * T && y >= BY && y < BY + H * T
            let conf = tgt >= 0 && y >= BTY && y < BTY + 46 && x >= PX && x < PX + PW - 54
            let cancel = tgt >= 0 && y >= BTY && y < BTY + 46 && x >= PX + PW - 46 && x < PX + PW
            let card = y >= PY && y < PY + 56 && x >= PX && x < PX + PW ? floor((x - PX) / (CW + 8)) : -1
            if cancel {
              tgt = -1
              nade = false
            } else if onMap || conf {
              let c = conf ? tgt : floor((y - BY) / T) * W + floor((x - BX) / T)
              let again = conf || c == tgt
              let wu = occ[c] >= 0 ? units.find(z => z.i == occ[c]) : null
              let ai = aims.find(a => a.c == c)
              if wu != null && wu.s == 0 {
                sel = wu.i
                tgt = -1
                nade = false
              } else if me == null || me.ap == 0 {
                tgt = -1
              } else if nade {
                if grid[c] != 1 && (c % W - me.x) * (c % W - me.x) + (floor(c / W) - me.y) * (floor(c / W) - me.y) <= 25 {
                  if again {
                    // a grenade: it lands, then the blast
                    let mi = me.i
                    let mx = me.x
                    nades = nades - 1
                    units = units.map(z => z.i == mi ? merge(z, {ap: 0, f: c % W == mx ? z.f : sign(c % W - mx)}) : z)
                    fx = [{k: 3, a: [mx, me.y], b: [c % W, floor(c / W)], t0: time, t1: time + 0.6}]
                    fxEnd = time + 0.7
                    tgt = -1
                    nade = false
                    bq = {cs: [c], t: time + 0.6}
                    bqn = bqn + 1
                    haptic()
                  } else {
                    tgt = c
                  }
                } else {
                  tgt = -1
                }
              } else if ai != null {
                if again && ai.ok {
                  let mi = me.i
                  let mx = me.x
                  let my = me.y
                  let ex = c % W
                  let ey = floor(c / W)
                  if ai.b {
                    // a barrel: it can't be missed
                    units = units.map(z => z.i == mi ? merge(z, {ap: 0, ow: false, f: ex == mx ? z.f : sign(ex - mx)}) : z)
                    fx = [{k: 1, a: [mx, my], b: [ex, ey], hit: true, t0: time + 0.1, sg: me.k == 1}]
                    fxEnd = time + 0.5
                    tgt = -1
                    bq = {cs: [c], t: time + 0.3}
                    bqn = bqn + 1
                  } else {
                    let hit = random(100) < ai.hc
                    let dm = hit ? random(KD[me.k].lo, KD[me.k].hi) + (ai.cv == 0 ? 1 : 0) : 0
                    let sg = me.k == 1
                    units = units.map(z => z.i == ai.i ? merge(z, {hp: z.hp - dm, al: true}) : z.i == mi ? merge(z, {ap: 0, ow: false, f: ex == mx ? z.f : sign(ex - mx)}) : z.s == 1 && (abs(z.x - ex) + abs(z.y - ey) <= 5 || abs(z.x - mx) + abs(z.y - my) <= 5) ? merge(z, {al: true}) : z)
                    fx = [{k: 1, a: [mx, my], b: [ex, ey], hit: hit, t0: time + 0.1, sg: sg}] + (hit ? [{k: 5, i: ai.i, d: dm, x: ex, y: ey, t0: time + 0.25, fl: ai.cv == 0}] : [{k: 6, x: ex, y: ey, t0: time + 0.25}])
                    fxEnd = time + 1.0
                    tgt = -1
                    chk = chk + 1
                  }
                  haptic()
                } else {
                  tgt = c
                }
              } else if D[c] > 0 && D[c] < 99 {
                if again {
                  let pp = path
                  let mi = me.i
                  let cost = D[c] <= KD[me.k].mv ? 1 : 2
                  let fd = c % W == me.x ? me.f : sign(c % W - me.x)
                  units = units.map(z => z.i == mi ? merge(z, {x: c % W, y: floor(c / W), ap: z.ap - cost, f: fd}) : z)
                  fx = [{k: 0, i: mi, p: pp.map(z => [z % W, floor(z / W)]), t0: time, t1: time + 0.13 * (len(pp) - 1)}]
                  fxEnd = time + 0.13 * (len(pp) - 1)
                  tgt = -1
                  chk = chk + 1
                } else {
                  tgt = c
                }
              } else {
                tgt = -1
              }
            } else if card >= 0 && card < 3 {
              let sq = units.filter(u => u.s == 0).sortBy(u => u.k)
              if card < len(sq) && sq[card].hp > 0 {
                sel = sq[card].i
                tgt = -1
                nade = false
              }
            } else if tgt < 0 && y >= BTY && y < BTY + 46 && x >= PX && x < PX + PW {
              let b = floor((x - PX) / (BW + 8))
              if b == 0 && me != null && me.ap > 0 {
                let mi = me.i
                fx = [{k: 7, x: me.x, y: me.y, t0: time}]
                fxEnd = time + 0.5
                units = units.map(z => z.i == mi ? merge(z, {ap: 0, ow: true}) : z)
                nade = false
                chk = chk + 1
              } else if b == 1 && me != null && me.ap > 0 && nades > 0 {
                nade = !nade
                tgt = -1
              } else if b == 2 {
                units = units.map(z => z.s == 0 ? merge(z, {ap: 0}) : z)
                tgt = -1
                nade = false
                chk = chk + 1
              }
            }
          }
        }
      }
      if mode == "play" && len(grid) == N {
        // ---- the top bar: the operation, the turn, and the way to the title ----
        let ty = TOP + 14
        text("OP ${mis + 1}", HX, ty, size: 9, color: accent, font: press)
        text(OPS[mis % 8].n, HX + 8 * len("OP ${mis + 1}") + 10, ty, size: 7, color: foreground, font: press)
        text("TURN ${turn}", HX + HW - 52, ty, size: 7, color: muted, font: press, align: end)
        let md = downAt[0] >= HX + HW - 46 && downAt[1] < TOP + 32 ? 2 : 0
        rect(HX + HW - 38, TOP + 2, 38, 24, radius: 4, fill: INK)
        rect(HX + HW - 36, TOP + 4 + md, 34, 18, radius: 3, fill: "#4a4466")
        for k in range(3) { rect(HX + HW - 27, TOP + 8 + md + k * 4, 16, 2, fill: "#ffffff") }
        // ---- the squad: a card each ----
        let sq = units.filter(u => u.s == 0).sortBy(u => u.k)
        // the health after the last action (reading the clock here would redraw the panel every frame)
        for u, n in sq {
          let uh = u.hp
          let x0 = PX + n * (CW + 8)
          let on = u.i == sel && u.hp > 0
          rect(x0, PY + 3, CW, 52, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(x0, PY, CW, 52, radius: 6 * corners, fill: on ? mix(surface, accent, 0.18) : surface, stroke: on ? accent : alpha(foreground, 0.12), width: on ? 2 : 1)
          sprite(ART[u.k], x0 + 6, PY + 4, 3.1, palette: uh > 0 ? PAL[u.k] : DEADP)
          text(KD[u.k].n, x0 + 48, PY + 12, size: 7, color: uh > 0 ? foreground : muted, font: press)
          if uh > 0 {
            let pw = min(5, (CW - 54) / u.mh)
            for pp in range(u.mh) { rect(x0 + 48 + pp * pw, PY + 22, pw - 1, 5, fill: pp < uh ? "#6fe05a" : alpha(foreground, 0.15)) }
            for a in range(2) { rect(x0 + 48 + a * 10, PY + 34, 7, 7, radius: 1, fill: a < u.ap ? "#5ab4ff" : alpha(foreground, 0.15)) }
            if u.ow { text("WATCH", x0 + 72, PY + 38, size: 6, color: "#a8d8ff", font: press) }
          } else {
            text("KIA", x0 + 48, PY + 30, size: 8, color: "#ff5a4a", font: press)
          }
        }
        // ---- a line about what's picked ----
        let info = won || wiped ? "" : nade ? (tgt >= 0 ? "3 DMG TO ALL 9 TILES" : "PICK A TILE UP TO 5 AWAY") : pick != null ? (!pick.ok ? (pick.d > KD[me.k].rng ? "OUT OF RANGE" : "NO LINE OF SIGHT") : pick.b ? "BLOWS UP 3x3 · 3 DMG" : "${pick.hc}% · ${KD[me.k].lo + (pick.cv == 0 ? 1 : 0)}-${KD[me.k].hi + (pick.cv == 0 ? 1 : 0)} DMG · ${pick.cv >= 40 ? "FULL COVER" : pick.cv > 0 ? "HALF COVER" : "FLANKED"}") : len(path) > 1 ? "${D[tgt] <= KD[me.k].mv ? "MOVE" : "DASH"} · ${max(tcov) >= 40 ? "FULL COVER" : max(tcov) > 0 ? "HALF COVER" : "NO COVER"}" : me != null && me.ap > 0 ? "${len(foes)} HOSTILES · ${nades} GRENADES" : "WAITING"
        text(info, PX + PW / 2, IY, size: 7, color: pick != null && pick.ok ? foreground : muted, font: press, align: center)
        // ---- buttons: what the soldier can do, or the go-ahead for what's picked ----
        if tgt >= 0 && !won && !wiped {
          let lab = nade ? "THROW" : pick != null ? (pick.ok ? (pick.b ? "SHOOT" : "FIRE ${pick.hc}%") : "") : D[tgt] <= KD[me.k].mv ? "MOVE" : "DASH"
          let pal = lab == "" ? BTN.off : pick != null || nade ? BTN.red : BTN.blue
          let bw = PW - 54
          let pd = downAt[1] >= BTY && downAt[1] < BTY + 46 && downAt[0] >= PX && downAt[0] < PX + bw ? 3 : 0
          rect(PX, BTY + 4, bw, 42, radius: 4, fill: pal[3])
          rect(PX, BTY + pd, bw, 42, radius: 4, fill: pal[1], stroke: INK, width: 2)
          rect(PX + 3, BTY + pd + 3, bw - 6, 4, radius: 2, fill: pal[0])
          rect(PX + 3, BTY + pd + 34, bw - 6, 5, radius: 2, fill: pal[2])
          text(lab == "" ? "NO SHOT" : lab, PX + bw / 2 + 1, BTY + pd + 23, size: 11, color: INK, font: press, align: center)
          text(lab == "" ? "NO SHOT" : lab, PX + bw / 2, BTY + pd + 21, size: 11, color: "#ffffff", font: press, align: center)
          let cd = downAt[1] >= BTY && downAt[1] < BTY + 46 && downAt[0] >= PX + PW - 46 ? 3 : 0
          rect(PX + PW - 46, BTY + 4, 46, 42, radius: 4, fill: BTN.off[3])
          rect(PX + PW - 46, BTY + cd, 46, 42, radius: 4, fill: BTN.off[1], stroke: INK, width: 2)
          rotate(45, PX + PW - 23, BTY + cd + 21) {
            rect(PX + PW - 32, BTY + cd + 19, 18, 4, fill: "#ffffff")
            rect(PX + PW - 25, BTY + cd + 12, 4, 18, fill: "#ffffff")
          }
        } else if !won && !wiped {
          for b in range(3) {
            let x0 = PX + b * (BW + 8)
            let can = b == 2 || (me != null && me.ap > 0 && (b == 0 || nades > 0))
            let pal = !can ? BTN.off : b == 2 ? BTN.go : b == 1 && nade ? BTN.red : BTN.blue
            let pd = downAt[1] >= BTY && downAt[1] < BTY + 46 && downAt[0] >= x0 && downAt[0] < x0 + BW ? 3 : 0
            rect(x0, BTY + 4, BW, 42, radius: 4, fill: pal[3])
            rect(x0, BTY + pd, BW, 42, radius: 4, fill: pal[1], stroke: INK, width: 2)
            rect(x0 + 3, BTY + pd + 3, BW - 6, 4, radius: 2, fill: pal[0])
            rect(x0 + 3, BTY + pd + 34, BW - 6, 5, radius: 2, fill: pal[2])
            let lab = ["WATCH", "GRENADE", "END TURN"][b]
            let ls = min(8, (BW - 12) / len(lab))
            text(lab, x0 + BW / 2 + 1, BTY + pd + (b == 1 ? 18 : 23), size: ls, color: INK, font: press, align: center)
            text(lab, x0 + BW / 2, BTY + pd + (b == 1 ? 16 : 21), size: ls, color: can ? "#ffffff" : "#b8b2d0", font: press, align: center)
            if b == 1 { text("x${nades}", x0 + BW / 2, BTY + pd + 29, size: 6, color: can ? "#ffffff" : "#b8b2d0", font: press, align: center) }
          }
        }
        // ---- the end of an operation ----
        if (won || wiped) && (time >= fxEnd || fxEnd > time + 10) {
          rect(0, 0, SW, SH, fill: alpha("#06070b", 0.6))
          let ccw = min(SW - 40, 320)
          let ccx = SW / 2 - ccw / 2
          let ccy = SH * 0.3
          rect(ccx, ccy + 4, ccw, 260, radius: 14 * corners, fill: alpha("#000000", 0.35))
          rect(ccx, ccy, ccw, 260, radius: 14 * corners, fill: surface, stroke: INK, width: 2)
          rect(ccx - 10, ccy + 16, ccw + 20, 44, radius: 4, fill: won ? "#3a7a3a" : "#8a2a32", stroke: INK, width: 2)
          rect(ccx - 7, ccy + 19, ccw + 14, 3, radius: 1.5, fill: alpha("#ffffff", 0.3))
          let hd = won ? "OP CLEARED" : "SQUAD LOST"
          text(hd, SW / 2 + 2, ccy + 41, size: 14, color: INK, font: press, align: center)
          text(hd, SW / 2, ccy + 39, size: 14, color: "#ffffff", font: press, align: center)
          text("OP ${mis + 1} · ${OPS[mis % 8].n}", SW / 2, ccy + 84, size: 7, color: muted, font: press, align: center)
          text(won ? "${len(squad)} OF 3 CAME HOME" : "NO ONE CAME HOME", SW / 2, ccy + 110, size: 8, color: foreground, font: press, align: center)
          text("${turn} TURNS", SW / 2, ccy + 130, size: 8, color: foreground, font: press, align: center)
          text(won ? (mis % 8 == 7 ? "THE MAPS COME ROUND, HARDER" : "NEXT: ${OPS[(mis + 1) % 8].n}") : "TRY ANOTHER WAY IN", SW / 2, ccy + 160, size: 7, color: accent, font: press, align: center)
          let pd = downAt[1] >= OBY && downAt[1] < OBY + 50 && abs(downAt[0] - SW / 2) < 110 ? 3 : 0
          let pal = won ? BTN.go : BTN.red
          rect(SW / 2 - 110, OBY + 4, 220, 46, radius: 4, fill: pal[3])
          rect(SW / 2 - 110, OBY + pd, 220, 46, radius: 4, fill: pal[1], stroke: INK, width: 2)
          rect(SW / 2 - 107, OBY + pd + 3, 214, 4, radius: 2, fill: pal[0])
          rect(SW / 2 - 107, OBY + pd + 37, 214, 6, radius: 2, fill: pal[2])
          text(won ? "NEXT OP" : "RETRY", SW / 2 + 2, OBY + pd + 25, size: 13, color: INK, font: press, align: center)
          text(won ? "NEXT OP" : "RETRY", SW / 2, OBY + pd + 23, size: 13, color: "#ffffff", font: press, align: center)
        }
      }
      // ---- the title ----
      if mode == "title" {
        let tt = time
        // faint slabs
        let gs = 36
        for k in range(ceil(SW / gs) + 1) { rect(k * gs, 0, 1, SH, fill: alpha(foreground, 0.04)) }
        for k in range(ceil(SH / gs) + 1) { rect(0, k * gs, SW, 1, fill: alpha(foreground, 0.04)) }
        let ty = LS ? TOP + 40 : SH * 0.2
        let ls = min(30, (SW - 40) / 8)
        text("FIRETEAM", SW / 2 + 3, ty + 3, size: ls, color: INK, font: press, align: center)
        text("FIRETEAM", SW / 2, ty, size: ls, color: accent, font: press, align: center)
        text("SQUAD TACTICS", SW / 2, ty + ls + 8, size: 8, color: muted, font: press, align: center)
        // the squad, behind sandbags, and a hostile across the way taking fire
        let sc = LS ? 4 : min(6, SW / 70)
        let gy = LS ? ty + 60 : SH * 0.36
        let gx = SW / 2 - 30 * sc
        for k in range(3) {
          rect(gx + k * 15 * sc + 1.5 * sc, gy + 13 * sc, 9 * sc, 2.5 * sc, radius: sc, fill: alpha("#000000", 0.35))
          sprite(ART[k], gx + k * 15 * sc, gy + (k == 1 ? 0 : 2 * sc) - (floor(tt * 2 + k) % 4 == 0 ? sc : 0), sc, palette: PAL[k])
        }
        sprite(SP_SANDBAG, gx, gy + 9 * sc, sc, palette: BAGP)
        sprite(SP_SANDBAG, gx + 30 * sc, gy + 9 * sc, sc, palette: BAGP)
        let ex = gx + 52 * sc
        scale(-1, 1, ex + 6 * sc, gy) { sprite(SP_GRUNT, ex, gy + sc, sc, palette: PAL[3]) }
        sprite(SP_CRATE, ex - sc, gy + 6 * sc, sc, palette: PROPP)
        let fl = tt % 1.6
        if fl < 0.2 {
          line(gx + 12 * sc, gy + 10 * sc, lerp(gx + 12 * sc, ex, fl * 5), gy + 10 * sc, stroke: "#fff3a0", width: sc * 0.8)
          circle(gx + 12.5 * sc, gy + 10 * sc, 2 * sc * (1 - fl * 4), fill: "#ffe14a")
        }
        // deploy, or carry on with the operation under way
        let going = len(units) > 0 && !won && !wiped
        let pd = downAt[1] >= TBY && downAt[1] < TBY + 56 && abs(downAt[0] - SW / 2) < 120 ? 3 : 0
        rect(SW / 2 - 120, TBY + 5, 240, 50, radius: 4, fill: BTN.go[3])
        rect(SW / 2 - 120, TBY + pd, 240, 50, radius: 4, fill: BTN.go[1], stroke: INK, width: 2)
        rect(SW / 2 - 117, TBY + pd + 3, 234, 4, radius: 2, fill: BTN.go[0])
        rect(SW / 2 - 117, TBY + pd + 41, 234, 6, radius: 2, fill: BTN.go[2])
        let dl = going ? "CONTINUE" : "DEPLOY"
        text(dl, SW / 2 + 2, TBY + pd + 26, size: 14, color: INK, font: press, align: center)
        text(dl, SW / 2, TBY + pd + 24, size: 14, color: "#ffffff", font: press, align: center)
        let nextOp = going || len(units) == 0 || wiped ? mis : mis + 1
        text("OP ${nextOp + 1} · ${OPS[nextOp % 8].n}", SW / 2, TBY - 18, size: 8, color: foreground, font: press, align: center)
        if len(units) > 0 {
          let nd = downAt[1] >= TBY + 70 && downAt[1] < TBY + 106 && abs(downAt[0] - SW / 2) < 110 ? 2 : 0
          rect(SW / 2 - 110, TBY + 72 + nd, 220, 32, radius: 4, fill: alpha(foreground, 0.08), stroke: alpha(foreground, 0.2), width: 1)
          text("NEW CAMPAIGN", SW / 2, TBY + 88 + nd, size: 8, color: muted, font: press, align: center)
        }
        if best > 0 { text("BEST: ${best} OPS CLEARED", SW / 2, LS ? TBY - 40 : TBY + 130, size: 7, color: accent, font: press, align: center) }
      }
    }
  }
}
