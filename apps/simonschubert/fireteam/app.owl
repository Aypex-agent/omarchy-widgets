app "fireteam" {
  // Turn-based squad tactics in pixel art, seen from above. A rifleman, a shotgunner and a sniper
  // clear eight operations of hostiles across maps of walls, crates, sandbags and barrels. Each
  // soldier has two actions a turn: a move costs one (a long move both), a shot or a grenade ends
  // the soldier's turn. Cover between shooter and target takes 40 (a wall) or 20 (a crate, a
  // barrel, sandbags) off the odds; a target without it is flanked and takes a point more.
  // Overwatch fires at the first hostile that moves into view; grenades and barrels blow cover
  // away. Hostiles only wake once they're seen, shot at or near a blast. After the eighth
  // operation the maps come round again with tougher hostiles.
  //
  // There's no game loop: every action resolves at once, in a handler, and leaves timed events
  // (`fx`) that the canvases play: walks, shots, hits, blasts and banners. Once no soldier has an
  // action left, `on chk` plays the hostiles' whole turn in one go, each picking the tile it likes
  // best of those it can reach: one it can shoot from, in cover, near the squad.

  meta { owl: 16; description: "Turn-based squad tactics in pixel art: lead a rifleman, a shotgunner and a sniper through eight operations; take cover, flank, set overwatch, throw grenades and blow up barrels"; version: "1.2"; license: "MIT"; category: "games" }

  // pixel font in capitals: the WATCH tag under a soldier holds 6 letters, KIA 7, the big buttons
  // about 15; button words shrink to fit
  strings {
    en {
      op: n => "OP ${n}"
      opName: i => ["FIRST CONTACT", "DOCKS", "WAREHOUSE", "CROSSROADS", "SUBSTATION", "THE YARD", "COMPOUND", "HQ"][i]
      hostiles: "HOSTILES"
      onMove: "ON THE MOVE"
      turn: n => "TURN ${n}"
      yourMove: "YOUR MOVE"
      flanked: "FLANKED"
      miss: "MISS"
      overwatch: "OVERWATCH"
      watch: "WATCH"
      kia: "KIA"
      nadeAll: "3 DMG TO ALL 9 TILES"
      nadePick: "PICK A TILE UP TO 5 AWAY"
      outRange: "OUT OF RANGE"
      noLos: "NO LINE OF SIGHT"
      blows: "BLOWS UP 3x3 · 3 DMG"
      shotInfo: (hc, lo, hi, cov) => "${hc}% · ${lo}-${hi} DMG · ${cov}"
      full: "FULL COVER"
      half: "HALF COVER"
      none: "NO COVER"
      move: "MOVE"
      dash: "DASH"
      status: (f, g) => "${f} HOSTILES · ${g} GRENADES"
      waiting: "WAITING"
      throw: "THROW"
      shoot: "SHOOT"
      fire: hc => "FIRE ${hc}%"
      noShot: "NO SHOT"
      grenade: "GRENADE"
      endTurn: "END TURN"
      opCleared: "OP CLEARED"
      squadLost: "SQUAD LOST"
      cameHome: n => "${n} OF 3 CAME HOME"
      noneHome: "NO ONE CAME HOME"
      turns: n => "${n} TURNS"
      mapsRound: "THE MAPS COME ROUND, HARDER"
      next: name => "NEXT: ${name}"
      tryAnother: "TRY ANOTHER WAY IN"
      nextOp: "NEXT OP"
      retry: "RETRY"
      tagline: "SQUAD TACTICS"
      carryOn: "CONTINUE"
      deploy: "DEPLOY"
      newCampaign: "NEW CAMPAIGN"
      soundOn: "SOUND ON"
      soundOff: "SOUND OFF"
      best: n => "BEST: ${n} OPS CLEARED"
    }
    id {
      op: n => "OP ${n}"
