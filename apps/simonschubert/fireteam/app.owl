    }
    it {
      op: n => "OP ${n}"
      opName: i => ["PRIMO CONTATTO", "MOLI", "MAGAZZINO", "INCROCIO", "SOTTOSTAZIONE", "IL CORTILE", "RECINTO", "QG"][i]
      hostiles: "NEMICI"
      onMove: "IN MOVIMENTO"
      turn: n => "TURNO ${n}"
      yourMove: "TOCCA A TE"
      flanked: "AI FIANCHI"
      miss: "MANCATO"
      overwatch: "VEGLIA"
      watch: "VEGLIA"
      kia: "CADUTO"
      nadeAll: "3 DANNI A TUTTE LE 9 CASELLE"
      nadePick: "SCEGLI UNA CASELLA ENTRO 5"
      outRange: "FUORI PORTATA"
      noLos: "NESSUNA LINEA DI TIRO"
      blows: "ESPLODE 3x3 · 3 DANNI"
      shotInfo: (hc, lo, hi, cov) => "${hc}% · ${lo}-${hi} DANNI · ${cov}"
      full: "COPERTURA PIENA"
      half: "MEZZA COPERTURA"
      none: "SCOPERTO"
      move: "MUOVI"
      dash: "SCATTO"
      status: (f, g) => "${f} ${f == 1 ? "NEMICO" : "NEMICI"} · ${g} ${g == 1 ? "GRANATA" : "GRANATE"}"
      waiting: "IN ATTESA"
      throw: "LANCIA"
      shoot: "SPARA"
      fire: hc => "FUOCO ${hc}%"
      noShot: "NESSUN TIRO"
      grenade: "GRANATA"
