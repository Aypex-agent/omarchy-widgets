      outRange: "HORS DE PORTÉE"
      noLos: "PAS DE LIGNE DE TIR"
      blows: "EXPLOSE 3x3 · 3 DÉGÂTS"
      shotInfo: (hc, lo, hi, cov) => "${hc}% · ${lo}-${hi} DÉGÂTS · ${cov}"
      full: "COUVERT TOTAL"
      half: "DEMI-COUVERT"
      none: "À DÉCOUVERT"
      move: "AVANCER"
      dash: "SPRINT"
      status: (f, g) => "${f} ${f <= 1 ? "ENNEMI" : "ENNEMIS"} · ${g} ${g <= 1 ? "GRENADE" : "GRENADES"}"
      waiting: "EN ATTENTE"
      throw: "LANCER"
      shoot: "TIRER"
      fire: hc => "FEU ${hc}%"
      noShot: "PAS DE TIR"
      grenade: "GRENADE"
      endTurn: "FIN DU TOUR"
