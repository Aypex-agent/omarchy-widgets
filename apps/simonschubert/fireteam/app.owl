    .ottttoottto
    oooooooooooo
    ouuuoouuuuuo
    oTTTooTTTTTo
    otttoottttto
    oooooooooooo
  """
  let SP_SCORCH = """
    ............
    ............
    ...nnnnn....
    ..nmmmmmnn..
    .nmnnnnnmmn.
    .nmnnYnnnmn.
    .nmnnnnnYmn.
    ..nmmnnmmn..
