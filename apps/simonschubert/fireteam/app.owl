    .onnnnnnnno.
    .orrnnnnrro.
    .oooooooooo.
    .oRuRRRRRro.
    .oRuRYYRRro.
    .oRuYooYRro.
    .oRuRYYRRro.
    .oooooooooo.
    .oRuRRRRRro.
