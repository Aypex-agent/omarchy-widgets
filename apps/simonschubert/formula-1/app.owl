      teamWins: n => n == 0 ? "без перемог" : ("${n} " + (n % 10 == 1 && n % 100 != 11 ? "перемога" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? "перемоги" : "перемог"))
