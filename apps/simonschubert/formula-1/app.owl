      wins: n => "${n}勝"; teamWins: n => n == 0 ? "未勝利" : "${n}勝"; loadingSeason: "シーズンを読み込み中…"; busy: "OpenF1が混み合っています。まもなく再試行します…"
      f1Offline: "OpenF1はオフラインです"; loadingTiming: "タイムを読み込み中…"; air: (a, t) => "気温 ${a}° · 路面 ${t}°"; rain: w => "雨 · 風 ${w} m/s"
      dry: w => "ドライ · 風 ${w} m/s"; isOn: s => "${s}が進行中です"; opensAt: t => "OpenF1のタイムはセッションの30分後、${t}に誰でも見られるようになります"
