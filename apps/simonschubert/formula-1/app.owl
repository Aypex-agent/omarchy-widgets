      timingFrom: "хронометраж OpenF1 · openf1.org ↗"; savedOffline: t => "нет сети · сохранено ${t}"
    }
    ja {
      tab: i => ["今", "カレンダー", "ランキング", "タイム"][i]; sess: i => ["フリー走行1", "フリー走行2", "フリー走行3", "スプリント予選", "スプリント", "予選", "決勝"][i]
      days: n => "${n}日"; dayHours: h => "1日${h}時間"; now: "まもなく"; laps: n => "${n}周"; live: "ライブ"; resultsOffline: "結果はオフラインです"
