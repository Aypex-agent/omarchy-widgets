      live: "наживо"; resultsOffline: "результати недоступні"; loading: "завантаження…"; tryAgain: "повторити"; seasonOver: "сезон завершено"
      sessLive: s => "${s} наживо"; raceWeekend: "гоночний вікенд"; nextUp: r => "далі · етап ${r}"; to: s => "до: ${s}"
      then: "потім"; lastRace: "остання гонка"; round: r => "етап ${r}"; championship: "чемпіонат"; afterRound: r => "після етапу ${r}"
