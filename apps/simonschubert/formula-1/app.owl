app "formula 1" {
  meta {
    owl: 23
    description: "Formula 1 on one screen: the race weekend and its sessions, the calendar, every result, the driver and team standings, and OpenF1 timing."
    version: "1.3"
    license: "MIT"
    category: "sport"
  }
  strings {
    en {
      tab: i => ["now", "calendar", "standings", "timing"][i]; sess: i => ["practice 1", "practice 2", "practice 3", "sprint quali", "sprint", "qualifying", "race"][i]
      days: n => "${n}d"; dayHours: h => "1d ${h}h"; now: "now"; laps: n => "${n} laps"; live: "live"; resultsOffline: "results offline"
      loading: "loading…"; tryAgain: "try again"; seasonOver: "the season is over"; sessLive: s => "${s} live"; raceWeekend: "race weekend"
      nextUp: r => "next up · round ${r}"; to: s => "to ${s}"; then: "then"; lastRace: "last race"; round: r => "round ${r}"
      championship: "championship"; afterRound: r => "after round ${r}"; gap: n => "${n} points between first and second"
      cityRound: (c, k, r) => "${c}, ${k} · round ${r}"; afterRace: "results come after the race"; noResults: "no results yet"
      loadingResults: "loading results…"; drivers: "drivers"; teams: "teams"; loadingStandings: "loading the standings…"
      wins: n => n == 1 ? "1 win" : "${n} wins"; teamWins: n => n == 0 ? "no wins" : n == 1 ? "1 win" : "${n} wins"; loadingSeason: "loading the season…"
      busy: "OpenF1 is busy, trying again in a moment…"; f1Offline: "OpenF1 is offline"; loadingTiming: "loading the timing…"
      air: (a, t) => "air ${a}° · track ${t}°"; rain: w => "rain · wind ${w} m/s"; dry: w => "dry · wind ${w} m/s"; isOn: s => "${s} is on"
      opensAt: t => "OpenF1's timing for it opens to everyone at ${t}, half an hour after the session"; firstStarts: t => "the first session starts ${t}"
      noTiming: "no timing for this session"; raceControl: "race control"; timingFrom: "timing from OpenF1 · openf1.org ↗"
      savedOffline: t => "offline · saved ${t}"
    }
    id {
      tab: i => ["kini", "kalender", "klasemen", "timing"][i]; sess: i => ["latihan 1", "latihan 2", "latihan 3", "kualifikasi sprint", "sprint", "kualifikasi", "balapan"][i]
      days: n => "${n}h"; dayHours: h => "1h ${h}j"; now: "sekarang"; laps: n => "${n} lap"; live: "langsung"; resultsOffline: "hasil offline"
      loading: "memuat…"; tryAgain: "coba lagi"; seasonOver: "musim sudah selesai"; sessLive: s => "${s} langsung"; raceWeekend: "akhir pekan balapan"
      nextUp: r => "berikutnya · seri ${r}"; to: s => "menuju ${s}"; then: "lalu"; lastRace: "balapan terakhir"; round: r => "seri ${r}"
      championship: "kejuaraan"; afterRound: r => "setelah seri ${r}"; gap: n => "selisih ${n} poin antara pertama dan kedua"
      cityRound: (c, k, r) => "${c}, ${k} · seri ${r}"; afterRace: "hasil muncul setelah balapan"; noResults: "belum ada hasil"
      loadingResults: "memuat hasil…"; drivers: "pembalap"; teams: "tim"; loadingStandings: "memuat klasemen…"; wins: n => "${n} menang"
      teamWins: n => n == 0 ? "belum menang" : "${n} menang"; loadingSeason: "memuat musim…"; busy: "OpenF1 sedang sibuk, mencoba lagi sebentar…"
      f1Offline: "OpenF1 sedang offline"; loadingTiming: "memuat timing…"; air: (a, t) => "udara ${a}° · lintasan ${t}°"
      rain: w => "hujan · angin ${w} m/s"; dry: w => "kering · angin ${w} m/s"; isOn: s => "${s} sedang berlangsung"; opensAt: t => "timing OpenF1 untuk sesi ini terbuka untuk semua pukul ${t}, setengah jam setelah sesi"
      firstStarts: t => "sesi pertama mulai ${t}"; noTiming: "tidak ada timing untuk sesi ini"; raceControl: "kontrol balapan"
      timingFrom: "timing dari OpenF1 · openf1.org ↗"; savedOffline: t => "offline · disimpan ${t}"
    }
    es {
      tab: i => ["ahora", "calendario", "clasificación", "tiempos"][i]; sess: i => ["libres 1", "libres 2", "libres 3", "clasif. sprint", "sprint", "clasificación", "carrera"][i]
      days: n => "${n}d"; dayHours: h => "1d ${h}h"; now: "ya"; laps: n => n == 1 ? "1 vuelta" : "${n} vueltas"; live: "en directo"
      resultsOffline: "resultados sin conexión"; loading: "cargando…"; tryAgain: "reintentar"; seasonOver: "la temporada ha terminado"
      sessLive: s => "${s} en directo"; raceWeekend: "fin de semana de carrera"; nextUp: r => "próxima · ronda ${r}"; to: s => "para ${s}"
      then: "luego"; lastRace: "última carrera"; round: r => "ronda ${r}"; championship: "campeonato"; afterRound: r => "tras la ronda ${r}"
      gap: n => "${n} puntos entre el primero y el segundo"; cityRound: (c, k, r) => "${c}, ${k} · ronda ${r}"; afterRace: "los resultados llegan tras la carrera"
      noResults: "aún no hay resultados"; loadingResults: "cargando resultados…"; drivers: "pilotos"; teams: "equipos"
      loadingStandings: "cargando la clasificación…"; wins: n => n == 1 ? "1 victoria" : "${n} victorias"; teamWins: n => n == 0 ? "sin victorias" : n == 1 ? "1 victoria" : "${n} victorias"
      loadingSeason: "cargando la temporada…"; busy: "OpenF1 está saturado, reintentando en un momento…"; f1Offline: "OpenF1 no responde"
      loadingTiming: "cargando los tiempos…"; air: (a, t) => "aire ${a}° · pista ${t}°"; rain: w => "lluvia · viento ${w} m/s"
      dry: w => "seco · viento ${w} m/s"; isOn: s => "${s} en curso"; opensAt: t => "los tiempos de OpenF1 se abren a todos a las ${t}, media hora después de la sesión"
      firstStarts: t => "la primera sesión empieza ${t}"; noTiming: "no hay tiempos para esta sesión"; raceControl: "dirección de carrera"
      timingFrom: "tiempos de OpenF1 · openf1.org ↗"; savedOffline: t => "sin conexión · guardado ${t}"
    }
    pt {
      tab: i => ["agora", "calendário", "classificação", "tempos"][i]; sess: i => ["treino 1", "treino 2", "treino 3", "quali sprint", "sprint", "classificação", "corrida"][i]
      days: n => "${n}d"; dayHours: h => "1d ${h}h"; now: "agora"; laps: n => n == 1 ? "1 volta" : "${n} voltas"; live: "ao vivo"
      resultsOffline: "resultados offline"; loading: "carregando…"; tryAgain: "tentar de novo"; seasonOver: "a temporada acabou"
      sessLive: s => "${s} ao vivo"; raceWeekend: "fim de semana de corrida"; nextUp: r => "próxima · etapa ${r}"; to: s => "para ${s}"
      then: "depois"; lastRace: "última corrida"; round: r => "etapa ${r}"; championship: "campeonato"; afterRound: r => "após a etapa ${r}"
      gap: n => "${n} pontos entre o primeiro e o segundo"; cityRound: (c, k, r) => "${c}, ${k} · etapa ${r}"; afterRace: "os resultados saem depois da corrida"
      noResults: "ainda sem resultados"; loadingResults: "carregando resultados…"; drivers: "pilotos"; teams: "equipes"
      loadingStandings: "carregando a classificação…"; wins: n => n == 1 ? "1 vitória" : "${n} vitórias"; teamWins: n => n == 0 ? "sem vitórias" : n == 1 ? "1 vitória" : "${n} vitórias"
      loadingSeason: "carregando a temporada…"; busy: "o OpenF1 está ocupado, tentando de novo em instantes…"; f1Offline: "o OpenF1 está offline"
      loadingTiming: "carregando os tempos…"; air: (a, t) => "ar ${a}° · pista ${t}°"; rain: w => "chuva · vento ${w} m/s"
      dry: w => "seco · vento ${w} m/s"; isOn: s => "${s} em andamento"; opensAt: t => "os tempos do OpenF1 abrem para todos às ${t}, meia hora após a sessão"
      firstStarts: t => "a primeira sessão começa ${t}"; noTiming: "sem tempos para esta sessão"; raceControl: "direção de prova"
      timingFrom: "tempos do OpenF1 · openf1.org ↗"; savedOffline: t => "offline · salvo ${t}"
    }
    de {
      tab: i => ["jetzt", "kalender", "wertung", "zeiten"][i]; sess: i => ["training 1", "training 2", "training 3", "sprint-quali", "sprint", "qualifying", "rennen"][i]
      days: n => "${n}T"; dayHours: h => "1T ${h}h"; now: "jetzt"; laps: n => n == 1 ? "1 runde" : "${n} runden"; live: "live"
      resultsOffline: "ergebnisse offline"; loading: "lädt…"; tryAgain: "nochmal"; seasonOver: "die saison ist vorbei"
      sessLive: s => "${s} live"; raceWeekend: "rennwochenende"; nextUp: r => "als nächstes · lauf ${r}"; to: s => "bis ${s}"
      then: "danach"; lastRace: "letztes rennen"; round: r => "lauf ${r}"; championship: "meisterschaft"; afterRound: r => "nach lauf ${r}"
      gap: n => "${n} punkte zwischen platz eins und zwei"; cityRound: (c, k, r) => "${c}, ${k} · lauf ${r}"; afterRace: "ergebnisse gibt's nach dem rennen"
      noResults: "noch keine ergebnisse"; loadingResults: "lade ergebnisse…"; drivers: "fahrer"; teams: "teams"; loadingStandings: "lade die wertung…"
      wins: n => n == 1 ? "1 sieg" : "${n} siege"; teamWins: n => n == 0 ? "keine siege" : n == 1 ? "1 sieg" : "${n} siege"
      loadingSeason: "lade die saison…"; busy: "OpenF1 ist ausgelastet, gleich nochmal…"; f1Offline: "OpenF1 ist offline"
      loadingTiming: "lade die zeiten…"; air: (a, t) => "luft ${a}° · strecke ${t}°"; rain: w => "regen · wind ${w} m/s"
      dry: w => "trocken · wind ${w} m/s"; isOn: s => "${s} läuft"; opensAt: t => "OpenF1s zeiten dafür sind ab ${t} für alle frei, eine halbe stunde nach der session"
      firstStarts: t => "die erste session beginnt ${t}"; noTiming: "keine zeiten für diese session"; raceControl: "rennleitung"
      timingFrom: "zeiten von OpenF1 · openf1.org ↗"; savedOffline: t => "offline · gespeichert ${t}"
    }
    zh {
      tab: i => ["当前", "赛历", "积分榜", "计时"][i]; sess: i => ["一练", "二练", "三练", "冲刺排位", "冲刺赛", "排位赛", "正赛"][i]; days: n => "${n}天"
      dayHours: h => "1天${h}小时"; now: "现在"; laps: n => "${n} 圈"; live: "进行中"; resultsOffline: "结果离线"; loading: "加载中…"
      tryAgain: "重试"; seasonOver: "本赛季已结束"; sessLive: s => "${s}进行中"; raceWeekend: "比赛周末"; nextUp: r => "下一站 · 第 ${r} 站"
      to: s => "距${s}"; then: "之后"; lastRace: "上一场"; round: r => "第 ${r} 站"; championship: "锦标赛"; afterRound: r => "第 ${r} 站后"
      gap: n => "第一和第二相差 ${n} 分"; cityRound: (c, k, r) => "${c}，${k} · 第 ${r} 站"; afterRace: "比赛结束后公布结果"; noResults: "暂无结果"
      loadingResults: "正在加载结果…"; drivers: "车手"; teams: "车队"; loadingStandings: "正在加载积分榜…"; wins: n => "${n} 胜"; teamWins: n => n == 0 ? "未胜" : "${n} 胜"
      loadingSeason: "正在加载赛季…"; busy: "OpenF1 繁忙，稍后重试…"; f1Offline: "OpenF1 离线"; loadingTiming: "正在加载计时…"; air: (a, t) => "气温 ${a}° · 赛道 ${t}°"
      rain: w => "有雨 · 风速 ${w} m/s"; dry: w => "干燥 · 风速 ${w} m/s"; isOn: s => "${s}进行中"; opensAt: t => "OpenF1 的计时将在 ${t} 向所有人开放，即赛段结束半小时后"
      firstStarts: t => "第一节 ${t} 开始"; noTiming: "这一节没有计时"; raceControl: "赛事干事"; timingFrom: "计时来自 OpenF1 · openf1.org ↗"
      savedOffline: t => "离线 · 保存于 ${t}"
    }
    ru {
      tab: i => ["сейчас", "календарь", "зачёт", "хронометраж"][i]; sess: i => ["практика 1", "практика 2", "практика 3", "квал. спринта", "спринт", "квалификация", "гонка"][i]
      days: n => "${n} д"; dayHours: h => "1 д ${h} ч"; now: "сейчас"; laps: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "круг" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? "круга" : "кругов")
      live: "в эфире"; resultsOffline: "результаты недоступны"; loading: "загрузка…"; tryAgain: "повторить"; seasonOver: "сезон завершён"
      sessLive: s => "${s} в эфире"; raceWeekend: "гоночный уик-энд"; nextUp: r => "далее · этап ${r}"; to: s => "до: ${s}"
      then: "потом"; lastRace: "последняя гонка"; round: r => "этап ${r}"; championship: "чемпионат"; afterRound: r => "после этапа ${r}"
      gap: n => "разрыв между первым и вторым: ${n} очк."; cityRound: (c, k, r) => "${c}, ${k} · этап ${r}"; afterRace: "результаты появятся после гонки"
      noResults: "результатов пока нет"; loadingResults: "загрузка результатов…"; drivers: "пилоты"; teams: "команды"
      loadingStandings: "загрузка зачёта…"; wins: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "победа" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? "победы" : "побед")
      teamWins: n => n == 0 ? "нет побед" : ("${n} " + (n % 10 == 1 && n % 100 != 11 ? "победа" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? "победы" : "побед"))
      loadingSeason: "загрузка сезона…"; busy: "OpenF1 перегружен, скоро попробуем снова…"; f1Offline: "OpenF1 недоступен"
      loadingTiming: "загрузка хронометража…"; air: (a, t) => "воздух ${a}° · трасса ${t}°"; rain: w => "дождь · ветер ${w} м/с"
      dry: w => "сухо · ветер ${w} м/с"; isOn: s => "идёт ${s}"; opensAt: t => "хронометраж OpenF1 откроется для всех в ${t}, через полчаса после сессии"
