      exporters: "輸出の多い国"; exportersSub: "買うより多く売った電力"; ofGen: p => "発電の ${p}%"
      importers: "輸入の多い国"; importersSub: "売るより多く買った電力"; ofUse: p => "消費の ${p}%"
