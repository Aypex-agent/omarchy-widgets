      windiest: "больше всего солнца и ветра"; windiestSub: "доля солнца и ветра, страны от миллиона жителей"; solarWind: (s, w) => "${s}% солнце · ${w}% ветер"
      exporters: "крупнейшие экспортёры"; exportersSub: "продано больше, чем куплено"; ofGen: p => "${p}% выработки"
      importers: "крупнейшие импортёры"; importersSub: "куплено больше, чем продано"; ofUse: p => "${p}% потребления"
      mostPerPerson: "больше всего на человека"; millionSub: "страны от миллиона жителей"; timesAvg: x => "${x}× от среднего по миру"
      change: "сменить"; howMuch: "сколько"; imported: "импорт"; exported: "экспорт"; forSize: "с учётом размера"; nucRen: "атом и возобновляемые"; whereThe: "откуда электричество"
      reading: "как читать цифры"
      twhBody: "Тераватт-час — это миллиард киловатт-часов. Дом потребляет около 10 kWh электричества в день, так что 1 TWh — это год электричества примерно для 270 000 домов."
      kwhDayBody: "Всё электричество, которое потребляет страна (дома, магазины, заводы и поезда вместе), разделённое на её жителей и дни года. Чтобы вскипятить полный чайник, нужно около 0,1 kWh."
      genUse: "Выработка и потребление"; genUseBody: "Выработка — это то, что дают электростанции, солнечные панели и ветряки страны. Потребление — это выработка плюс импорт минус экспорт."
      cleanCap: "Чистая"; cleanBody: "Электричество от атомных станций и возобновляемых источников: солнца, ветра, воды, биомассы, геотермии и приливов. Ископаемое топливо — это уголь, газ и нефть, сжигаемые на электростанциях."
      tradeCap: "Импорт и экспорт"; tradeBody: "Электричество, которое идёт по линиям электропередачи в соседние страны и из них. Многие страны делают и то и другое: в одни часы покупают, в другие продают."
      theData: "данные"; dataBody: n => "Выработка электричества по источникам, импорт и экспорт для ${n} стран за 2024 год взяты из международной энергетической статистики U.S. Energy Information Administration. Население и площадь — от Всемирного банка. Всё хранится в приложении, поэтому оно работает офлайн."
      eiaData: "данные EIA"; worldBank: "Всемирный банк"
    }
