    {n: "Palestine", id: "PSE", f: "🇵🇸", r: "Middle East", pop: 5413596, km2: 6025, el: [0, 0, 0.6, 0, 0.39, 0, 0, 0, 0], E: 0.99, U: 7.99, im: 7, ex: 0, net: 7, cl: 0.394, sw: 0.394, pd: 4.04, pk: 0.164, ss: 0.124, rE: 155, rU: 117, rD: 110, rK: 89, rC: 90, rS: 11},
    {n: "Niger", id: "NER", f: "🇳🇪", r: "Africa", pop: 27917831, km2: 1267000, el: [0.17, 0.05, 0.7, 0, 0.03, 0, 0, 0, 0], E: 0.95, U: 2.15, im: 1.2, ex: 0, net: 1.2, cl: 0.032, sw: 0.032, pd: 0.21, pk: 0.001, ss: 0.442, rE: 156, rU: 151, rD: 170, rK: 175, rC: 160, rS: 109},
    {n: "Haiti", id: "HTI", f: "🇭🇹", r: "Americas", pop: 11906095, km2: 27750, el: [0, 0, 0.7, 0, 0, 0, 0.16, 0, 0], E: 0.86, U: 0.86, im: 0, ex: 0, net: 0, cl: 0.186, sw: 0, pd: 0.2, pk: 0.031, ss: 1, rE: 157, rU: 160, rD: 172, rK: 134, rC: 129, rS: 172},
    {n: "Maldives", id: "MDV", f: "🇲🇻", r: "Asia", pop: 529676, km2: 300, el: [0, 0, 0.79, 0, 0.06, 0, 0, 0, 0], E: 0.85, U: 0.85, im: 0, ex: 0, net: 0, cl: 0.071, sw: 0.071, pd: 4.4, pk: 2.833, ss: 1, rE: 158, rU: 161, rD: 109, rK: 12, rC: 149, rS: 81},
    {n: "Macau", id: "MAC", f: "🇲🇴", r: "Asia", pop: 685900, km2: 33, el: [0, 0.48, 0.05, 0, 0, 0, 0, 0.24, 0], E: 0.77, U: 6.27, im: 5.5, ex: 0, net: 5.5, cl: 0.312, sw: 0, pd: 25.04, pk: 23.333, ss: 0.123, rE: 159, rU: 125, rD: 20, rK: 4, rC: 105, rS: 173},
    {n: "French Polynesia", id: "PYF", f: "🇵🇫", r: "Oceania", pop: 282465, km2: 3521, el: [0, 0, 0.47, 0, 0.06, 0, 0.19, 0, 0], E: 0.72, U: 0.72, im: 0, ex: 0, net: 0, cl: 0.347, sw: 0.083, pd: 6.98, pk: 0.204, ss: 1, rE: 160, rU: 164, rD: 89, rK: 75, rC: 100, rS: 77},
    {n: "Togo", id: "TGO", f: "🇹🇬", r: "Africa", pop: 8591626, km2: 56785, el: [0, 0.5, 0, 0, 0.13, 0, 0.08, 0, 0], E: 0.71, U: 2.21, im: 1.5, ex: 0, net: 1.5, cl: 0.296, sw: 0.183, pd: 0.7, pk: 0.013, ss: 0.321, rE: 161, rU: 150, rD: 150, rK: 149, rC: 108, rS: 36},
    {n: "Eswatini", id: "SWZ", f: "🇸🇿", r: "Africa", pop: 1256174, km2: 17364, el: [0.02, 0, 0, 0, 0.03, 0, 0.35, 0.21, 0], E: 0.61, U: 1.65, im: 1.04, ex: 0, net: 1.04, cl: 0.967, sw: 0.049, pd: 3.6, pk: 0.035, ss: 0.37, rE: 162, rU: 154, rD: 113, rK: 130, rC: 16, rS: 95},
    {n: "Liberia", id: "LBR", f: "🇱🇷", r: "Africa", pop: 5731206, km2: 111370, el: [0, 0, 0.26, 0, 0.01, 0, 0.3, 0, 0], E: 0.57, U: 0.57, im: 0, ex: 0, net: 0, cl: 0.544, sw: 0.018, pd: 0.27, pk: 0.005, ss: 1, rE: 163, rU: 165, rD: 167, rK: 166, rC: 74, rS: 119},
    {n: "South Sudan", id: "SSD", f: "🇸🇸", r: "Africa", pop: 12188788, km2: 646883, el: [0, 0, 0.55, 0, 0.01, 0, 0, 0, 0], E: 0.56, U: 0.56, im: 0, ex: 0, net: 0, cl: 0.018, sw: 0.018, pd: 0.13, pk: 0.001, ss: 1, rE: 164, rU: 167, rD: 173, rK: 176, rC: 164, rS: 120},
    {n: "Cabo Verde", id: "CPV", f: "🇨🇻", r: "Africa", pop: 527326, km2: 4030, el: [0, 0, 0.36, 0, 0.08, 0.08, 0, 0, 0], E: 0.52, U: 0.52, im: 0, ex: 0, net: 0, cl: 0.308, sw: 0.308, pd: 2.7, pk: 0.129, ss: 1, rE: 165, rU: 168, rD: 124, rK: 98, rC: 106, rS: 19},
    {n: "Gambia", id: "GMB", f: "🇬🇲", r: "Africa", pop: 2822093, km2: 11295, el: [0, 0, 0.51, 0, 0, 0, 0, 0, 0], E: 0.51, U: 0.51, im: 0, ex: 0, net: 0, cl: 0, sw: 0, pd: 0.5, pk: 0.045, ss: 1, rE: 166, rU: 169, rD: 154, rK: 122, rC: 176, rS: 174},
    {n: "Timor-Leste", id: "TLS", f: "🇹🇱", r: "Asia", pop: 1418517, km2: 14870, el: [0, 0, 0.51, 0, 0, 0, 0, 0, 0], E: 0.51, U: 0.51, im: 0, ex: 0, net: 0, cl: 0, sw: 0, pd: 0.99, pk: 0.034, ss: 1, rE: 167, rU: 170, rD: 145, rK: 131, rC: 177, rS: 175},
    {n: "Burundi", id: "BDI", f: "🇧🇮", r: "Africa", pop: 14390003, km2: 27834, el: [0, 0, 0.12, 0, 0, 0, 0.36, 0.01, 0], E: 0.49, U: 0.57, im: 0.08, ex: 0, net: 0.08, cl: 0.755, sw: 0, pd: 0.11, pk: 0.018, ss: 0.86, rE: 168, rU: 166, rD: 174, rK: 142, rC: 45, rS: 176},
    {n: "Belize", id: "BLZ", f: "🇧🇿", r: "Americas", pop: 422924, km2: 22966, el: [0, 0, 0.06, 0, 0.01, 0, 0.24, 0.16, 0], E: 0.47, U: 0.85, im: 0.38, ex: 0, net: 0.38, cl: 0.872, sw: 0.021, pd: 5.51, pk: 0.02, ss: 0.553, rE: 169, rU: 162, rD: 97, rK: 141, rC: 32, rS: 118},
    {n: "Eritrea", id: "ERI", f: "🇪🇷", r: "Africa", pop: 3607003, km2: 121630, el: [0, 0, 0.4, 0, 0.05, 0, 0, 0, 0], E: 0.45, U: 0.45, im: 0, ex: 0, net: 0, cl: 0.111, sw: 0.111, pd: 0.34, pk: 0.004, ss: 1, rE: 170, rU: 171, rD: 164, rK: 168, rC: 143, rS: 61},
    {n: "Somalia", id: "SOM", f: "🇸🇴", r: "Africa", pop: 19654739, km2: 637657, el: [0, 0, 0.34, 0, 0.08, 0.01, 0, 0, 0], E: 0.43, U: 0.43, im: 0, ex: 0, net: 0, cl: 0.209, sw: 0.209, pd: 0.06, pk: 0.001, ss: 1, rE: 171, rU: 172, rD: 178, rK: 177, rC: 123, rS: 34},
    {n: "Chad", id: "TCD", f: "🇹🇩", r: "Africa", pop: 21003705, km2: 1284000, el: [0, 0, 0.35, 0, 0, 0.01, 0, 0.01, 0], E: 0.37, U: 0.37, im: 0, ex: 0, net: 0, cl: 0.054, sw: 0.027, pd: 0.05, pk: 0, ss: 1, rE: 172, rU: 173, rD: 179, rK: 178, rC: 152, rS: 114},
    {n: "Sierra Leone", id: "SLE", f: "🇸🇱", r: "Africa", pop: 8819794, km2: 72300, el: [0, 0, 0.01, 0, 0.02, 0, 0.18, 0.01, 0], E: 0.22, U: 0.22, im: 0, ex: 0, net: 0, cl: 0.955, sw: 0.091, pd: 0.07, pk: 0.003, ss: 1, rE: 173, rU: 174, rD: 176, rK: 170, rC: 20, rS: 70},
    {n: "Djibouti", id: "DJI", f: "🇩🇯", r: "Africa", pop: 1184076, km2: 23200, el: [0, 0, 0.13, 0, 0, 0.07, 0, 0, 0], E: 0.2, U: 0.79, im: 0.59, ex: 0, net: 0.59, cl: 0.35, sw: 0.35, pd: 1.83, pk: 0.009, ss: 0.253, rE: 174, rU: 163, rD: 134, rK: 157, rC: 99, rS: 14},
    {n: "Central African Rep.", id: "CAF", f: "🇨🇫", r: "Africa", pop: 5513282, km2: 622980, el: [0, 0, 0, 0, 0, 0, 0.14, 0, 0], E: 0.14, U: 0.14, im: 0, ex: 0, net: 0, cl: 1, sw: 0, pd: 0.07, pk: 0, ss: 1, rE: 175, rU: 175, rD: 177, rK: 179, rC: 8, rS: 177},
    {n: "Comoros", id: "COM", f: "🇰🇲", r: "Africa", pop: 882847, km2: 1870, el: [0, 0, 0.14, 0, 0, 0, 0, 0, 0], E: 0.14, U: 0.14, im: 0, ex: 0, net: 0, cl: 0, sw: 0, pd: 0.43, pk: 0.075, ss: 1, rE: 176, rU: 176, rD: 157, rK: 114, rC: 178, rS: 178},
    {n: "Solomon Islands", id: "SLB", f: "🇸🇧", r: "Oceania", pop: 838645, km2: 28446, el: [0, 0, 0.1, 0, 0.01, 0, 0, 0, 0], E: 0.11, U: 0.11, im: 0, ex: 0, net: 0, cl: 0.091, sw: 0.091, pd: 0.36, pk: 0.004, ss: 1, rE: 177, rU: 177, rD: 161, rK: 169, rC: 146, rS: 71},
    {n: "Guinea-Bissau", id: "GNB", f: "🇬🇼", r: "Africa", pop: 2249515, km2: 36125, el: [0, 0, 0.08, 0, 0, 0, 0, 0, 0], E: 0.08, U: 0.08, im: 0, ex: 0, net: 0, cl: 0, sw: 0, pd: 0.1, pk: 0.002, ss: 1, rE: 178, rU: 178, rD: 175, rK: 174, rC: 179, rS: 179},
    {n: "Vanuatu", id: "VUT", f: "🇻🇺", r: "Oceania", pop: 335169, km2: 12189, el: [0, 0, 0.06, 0, 0.01, 0, 0.01, 0, 0], E: 0.08, U: 0.08, im: 0, ex: 0, net: 0, cl: 0.25, sw: 0.125, pd: 0.65, pk: 0.007, ss: 1, rE: 179, rU: 179, rD: 152, rK: 160, rC: 114, rS: 52}
  ]
  let NM = str.names(0)
  let C = CD.map(c => set(c, "n", get(NM, c.id, c.n)))

  state view = "world"
  state openId = ""
  state typed = ""
  state reg = "all"
  state regOpen = false
  state sortKey = "E" persist
  state cmpA = "DEU" persist
  state cmpB = "FRA" persist
  state picking = ""
  state pickTyped = ""

  // Fixed colors, so solar is yellow and hydro blue in every theme; checked for color blindness
  // and contrast on dark and light backgrounds. ES is in the data's order of `el`.
  let coalC = "#7E8187"
  let nucC = "#9B6BD6"
  let renC = "#5E9A3A"
  let ES = [{l: str.coal, c: coalC}, {l: str.gas, c: "#CF7A22"}, {l: str.oil, c: "#B8364E"}, {l: str.nuclear, c: nucC}, {l: str.solar, c: "#AD8612"}, {l: str.wind, c: "#16A0A0"}, {l: str.hydro, c: "#3F66D6"}, {l: str.biomass, c: renC}, {l: str.geoTide, c: muted}]
  // The same, in three: burning fossil fuels, nuclear, and renewables.
  let GS = [{l: str.fossil, c: coalC}, {l: str.nuclear, c: nucC}, {l: str.renewables, c: renC}]
  let impC = "#D45D79"
  let expC = "#2E9E6E"
  let bC = alpha(foreground, 0.55)

  let cn = C.find(c => c.id == openId) ?? W
  let cA = C.find(c => c.id == cmpA) ?? C[0]
  let cB = C.find(c => c.id == cmpB) ?? C[1]

  // The countries tab: what the list is sorted by, and what each row says about it.
  let sorts = [
    {k: "E", l: str.sGenerates}, {k: "U", l: str.sUses}, {k: "pd", l: str.sPerPerson}, {k: "pk", l: str.sPerKm},
    {k: "cl", l: str.sClean}, {k: "sw", l: str.sSunWind}, {k: "im", l: str.sImports}, {k: "ex", l: str.sExports}
  ]
  let regions = ["all", "Europe", "Asia", "Americas", "Africa", "Middle East", "Oceania"]
  let found = C.filter(c => (reg == "all" || c.r == reg) && (len(typed) == 0 || contains(lower(c.n), lower(typed))))
  let keyed = found.map(c => {c: c, v: get(c, sortKey, 0)}).filter(x => (sortKey != "im" && sortKey != "ex") || x.v >= 0.05)
  let rows = keyed.sortBy(x => -x.v)
  let vmax = len(rows) > 0 ? max(rows.map(x => x.v)) : 1

  let picks = len(pickTyped) == 0 ? C.sortBy(c => c.n) : C.filter(c => contains(lower(c.n), lower(pickTyped))).sortBy(c => c.n)

  // World lists.
  let top = C.take(10)
  let exporters = C.filter(c => c.net < 0).sortBy(c => c.net).take(8)
  let importers = C.filter(c => c.net > 0).sortBy(c => -c.net).take(8)
  let big = C.filter(c => c.pop >= 1000000)
  let hungry = big.sortBy(c => -c.pd).take(8)
  let cleanest = big.sortBy(c => -c.cl).take(8)
  let windy = big.sortBy(c => -c.sw).take(8)

  // A bar in parts, each as wide as its share, with 2 dp of the view between them.
  component Stack(vals, cols, h = 14) {
    let tot = sum(vals)
    if tot > 0 {
      Row {
        gap: 2
        height: h
        fill: width
        for v, i in vals {
          if v > tot * 0.003 {
            Box { weight: v; height: h; background: cols[i].c; radius: 2 }
          }
        }
      }
    } else {
      Box { height: h; fill: width; radius: 2; background: alpha(muted, 0.15) }
    }
  }

  // A bar `f` (0 to 1) of the width it has, on a faint track.
  component Bar(f, tint = accent, h = 8) {
    Row {
      gap: 0
      height: h
      fill: width
      background: alpha(muted, 0.14)
      radius: 2
      Box { weight: max(0.0001, clamp(f, 0, 1)); height: h; background: tint; radius: 2 }
      Box { weight: max(0.0001, 1 - clamp(f, 0, 1)); height: h }
    }
  }

  // The parts of a Stack, named, in its order, with their TWh and share.
  component Legend(vals, srcs) {
    let tot = sum(vals)
    Column {
      gap: 8
      for v, i in vals {
        if v >= 0.05 {
          Row {
            gap: 10
            align: center
            Box { width: 10; height: 10; radius: 5; background: srcs[i].c }
            Text { text: srcs[i].l; weight: 1; maxLines: 1 }
            Text { text: "${fmtNum(v, v >= 100 ? 0 : 1)} TWh"; style: small; color: muted }
            Text { text: v / tot < 0.01 ? "<1%" : "${round(v / tot * 100)}%"; bold: true; width: 46; align: end }
          }
        }
      }
    }
  }

  component Head(t, sub = "") {
    Column {
      gap: 2
      padding: [0, 14, 0, 2]
      Text { text: t; style: label; color: muted }
      if sub != "" {
        Text { text: sub; style: small; color: muted }
      }
    }
  }

  // One country in a ranked list: its flag and name, the value, and a bar against the first.
  component Ranked(c, i, value, sub, f, mixBar = false, tint = accent) {
    Row {
      gap: 12
      align: center
      padding: [0, 7]
      onTap: { openId = c.id; haptic() }
      Text { text: "${i + 1}"; style: small; color: muted; width: 26; align: end }
      Text { text: c.f; fontSize: 26 }
      Column {
        weight: 1
        gap: 4
        Row {
          gap: 8
          align: center
          Text { text: c.n; bold: true; maxLines: 1; weight: 1 }
          Text { text: value; maxLines: 1 }
        }
        if mixBar {
          Row {
            gap: 0
            height: 8
            fill: width
            Box { weight: max(0.0001, f); Stack { vals: c.el; cols: ES; h: 8 } }
            Box { weight: max(0.0001, 1 - f); height: 8 }
          }
        } else {
          Bar { f: f; h: 6; tint: tint }
        }
        Text { text: sub; style: small; color: muted; maxLines: 1 }
      }
    }
  }

  // A share of the world's total, as a bar against the largest of the group.
  component Share(label, s, smax, tint = accent) {
    Row {
      gap: 10
      align: center
      Text { text: label; style: small; width: 112; maxLines: 1 }
      Column { weight: 1; Bar { f: s / smax; tint: tint; h: 10 } }
      Text { text: s < 0.001 ? "<0.1%" : "${fixed(s * 100, s < 0.1 ? 1 : 0)}%"; style: small; bold: true; width: 50; align: end }
    }
  }

  component Tile(label, value, unit, sub) {
    Column {
      gap: 2
      padding: [12, 10]
      background: alpha(foreground, 0.05)
      radius: 10 * corners
      Text { text: label; style: small; color: muted; maxLines: 1 }
      Text { spans: [{text: value, fontSize: 24, bold: true}, " ${unit}"]; style: small; maxLines: 1 }
      Text { text: sub; style: small; color: muted; maxLines: 2 }
    }
  }

  // Two countries side by side on one measure.
  component Versus(label, a, b, ta, tb) {
    let m = max(a, b)
    Column {
      gap: 5
      Row {
        gap: 8
        Text { text: label; bold: true; weight: 1 }
        Text { text: a > 0 && b > 0 ? (a >= b ? "${cA.f} ${fixed(a / b, a / b >= 10 ? 0 : 1)}×" : "${cB.f} ${fixed(b / a, b / a >= 10 ? 0 : 1)}×") : ""; style: small; color: muted }
      }
      Row {
        gap: 8
        align: center
        Text { text: cA.f; fontSize: 16 }
        Column { weight: 1; Bar { f: m > 0 ? a / m : 0; tint: accent; h: 10 } }
        Text { text: ta; style: small; width: 112; align: end; maxLines: 1 }
      }
      Row {
        gap: 8
        align: center
        Text { text: cB.f; fontSize: 16 }
        Column { weight: 1; Bar { f: m > 0 ? b / m : 0; tint: bC; h: 10 } }
        Text { text: tb; style: small; width: 112; align: end; maxLines: 1 }
      }
    }
  }

  component Tab(name, label, img) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; openId = ""; picking = ""; haptic("light") }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: img; size: 24; tint: view == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: view == name; color: view == name ? foreground : muted }
    }
  }

  Column {
    gap: 0
    fill: true

    if picking != "" {
      // ---------------------------------------------------------------- country picker
      Row {
        gap: 10
        align: center
        padding: [16, 4, 16, 8]
        Image { src: searchIcon; size: 20; tint: muted }
        Input { text: pickTyped; placeholder: str.search; weight: 1; onChange: pickTyped = value }
      }
      Column {
        lazy: true
        weight: 1
        gap: 0
        padding: [16, 0]
        for c in picks key c.id {
          Row {
            gap: 12
            align: center
            padding: [0, 9]
            onTap: {
              if picking == "a" { cmpA = c.id } else { cmpB = c.id }
              picking = ""
              pickTyped = ""
            }
            Text { text: c.f; fontSize: 24 }
            Text { text: c.n; weight: 1; maxLines: 1; bold: c.id == (picking == "a" ? cmpA : cmpB) }
            Text { text: str.region(c.r); style: small; color: muted }
          }
        }
      }

    } else if openId != "" {
      // ---------------------------------------------------------------- a country
      let ss = cn.ss
      let bmax = max(cn.E, cn.U)
      let tmax = max(cn.im, cn.ex)
      let groups = [cn.el[0] + cn.el[1] + cn.el[2], cn.el[3], cn.el[4] + cn.el[5] + cn.el[6] + cn.el[7] + cn.el[8]]
      let shares = [cn.pop / W.pop, cn.km2 / W.km2, cn.E / W.E, cn.U / W.U]
      let smax = max(shares)
      Column {
        weight: 1
        scroll: true
        gap: 12
        padding: [16, 4, 16, 16]

        Row {
          gap: 14
          align: center
          Text { text: cn.f; fontSize: 52 }
          Column {
            weight: 1
            gap: 2
            Text { text: cn.n; style: title; maxLines: 2 }
            Text { text: "${str.region(cn.r)} · ${str.people(fmtNum(cn.pop, {compact: true}))} · ${fmtNum(cn.km2, {compact: true})} km²"; style: small; color: muted; maxLines: 2 }
          }
        }

        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Text {
            spans: ss >= 1.95 ? [str.genXa, {text: "${fixed(ss, ss >= 10 ? 0 : 1)}×", bold: true, color: expC}, str.genXb]
              : ss > 1.02 ? [str.sellsA, {text: "${round((1 - 1 / ss) * 100)}%", bold: true, color: expC}, str.sellsB]
              : ss >= 0.98 ? [str.allA, {text: str.allBold, bold: true}, str.allB]
              : [str.buysA, {text: "${round((1 - ss) * 100)}%", bold: true, color: impC}, str.buysB]
            fontSize: 20
          }
          Column {
            gap: 8
            Row {
              gap: 10
              align: center
              Text { text: str.rowGen; style: small; color: muted; width: 72 }
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, cn.E / bmax); Stack { vals: cn.el; cols: ES; h: 16 } }
                Box { weight: max(0.0001, 1 - cn.E / bmax); height: 16 }
              }
              Text { text: "${fmtNum(cn.E, cn.E >= 100 ? 0 : 1)} TWh"; style: small; bold: true; width: 86; align: end }
            }
            Row {
              gap: 10
              align: center
              Text { text: str.rowUse; style: small; color: muted; width: 72 }
              Column { weight: 1; Bar { f: cn.U / bmax; tint: bC; h: 16 } }
              Text { text: "${fmtNum(cn.U, cn.U >= 100 ? 0 : 1)} TWh"; style: small; bold: true; width: 86; align: end }
            }
          }
          Text { text: str.worldShare(fixed(cn.E / W.E * 100, cn.E / W.E < 0.1 ? 1 : 0), cn.rE, len(C)); style: small; color: muted }
        }

        Head { t: str.howClean; sub: str.cleanSub(round(cn.cl * 100), cn.rC, len(C)) }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Stack { vals: groups; cols: GS; h: 18 }
          Legend { vals: groups; srcs: GS }
        }

        Head { t: str.whereFrom; sub: str.generatedIn(fmtNum(cn.E, cn.E >= 100 ? 0 : 1)) }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Stack { vals: cn.el; cols: ES; h: 18 }
          Legend { vals: cn.el; srcs: ES }
        }

        Head { t: str.trade; sub: str.tradeSub }
        Column {
          gap: 8
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          if tmax < 0.05 {
            Text { text: str.noTrade; style: small; color: muted }
          } else {
            Row {
              Text { text: str.importedArrow; style: small; color: impC; weight: 1 }
              Text { text: str.exportedArrow; style: small; color: expC; weight: 1; align: end }
            }
            Row {
              gap: 0
              height: 16
              fill: width
              align: center
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, 1 - cn.im / tmax); height: 16 }
                Box { weight: max(0.0001, cn.im / tmax); height: 16; background: impC; radius: 2 }
              }
              Box { width: 2; height: 24; background: alpha(foreground, 0.5) }
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, cn.ex / tmax); height: 16; background: expC; radius: 2 }
                Box { weight: max(0.0001, 1 - cn.ex / tmax); height: 16 }
              }
            }
            Row {
              gap: 8
              Text { text: "${fmtNum(cn.im, cn.im >= 100 ? 0 : 1)} TWh"; bold: true; weight: 1 }
              Text { text: "${fmtNum(cn.ex, cn.ex >= 100 ? 0 : 1)} TWh"; bold: true; weight: 1; align: end }
            }
            Text {
              spans: abs(cn.net) < 0.05 ? [str.balanced]
                : cn.net > 0 ? [str.netImport, {text: "${fmtNum(cn.net, cn.net >= 100 ? 0 : 1)} TWh", bold: true, color: impC}, str.ofUsesTail(round(cn.net / cn.U * 100))]
                : [str.netExport, {text: "${fmtNum(-cn.net, -cn.net >= 100 ? 0 : 1)} TWh", bold: true, color: expC}, str.ofGenTail(round(-cn.net / cn.E * 100))]
              style: small
            }
          }
        }

        Head { t: str.sizeHead; sub: str.sizeSub }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Share { label: str.lPeople; s: shares[0]; smax: smax; tint: bC }
          Share { label: str.land; s: shares[1]; smax: smax; tint: bC }
          Share { label: str.generated; s: shares[2]; smax: smax }
          Share { label: str.used; s: shares[3]; smax: smax }
          Text {
            spans: [str.eachA, {text: cn.pd >= W.pd ? "${fixed(cn.pd / W.pd, 1)}×" : "${round(cn.pd / W.pd * 100)}%", bold: true}, cn.pd >= W.pd ? str.avgMore : str.avgLess]
            style: small
          }
        }
        Grid {
          columns: 2
          gap: 8
          Tile { label: str.perPerson; value: fmtNum(cn.pd, cn.pd >= 100 ? 0 : 1); unit: str.kwhDay; sub: str.worldRef(cn.rD, fmtNum(W.pd, 1)) }
          Tile { label: str.perKm; value: fmtNum(cn.pk * 1000); unit: "MWh"; sub: str.worldRef(cn.rK, fmtNum(W.pk * 1000)) }
          Tile { label: str.clean; value: "${round(cn.cl * 100)}"; unit: "%"; sub: str.worldRef(cn.rC, "${round(W.cl * 100)}%") }
          Tile { label: str.sunWind; value: "${round(cn.sw * 100)}"; unit: "%"; sub: str.worldRef(cn.rS, "${round(W.sw * 100)}%") }
        }
        Row {
          gap: 8
          Button { text: str.compareWith; color: accent; onTap: { cmpA = openId; openId = ""; view = "compare"; picking = "b" } }
        }
        Text { text: str.dataLine(cn.y ?? 2024); style: small; color: muted; align: center }
      }

    } else {
      if view == "countries" {
        // ---------------------------------------------------------------- countries
        Column {
          gap: 8
          padding: [16, 4, 16, 8]
          Row {
            gap: 10
            align: center
            Image { src: searchIcon; size: 20; tint: muted }
            Input { text: typed; placeholder: str.search; weight: 1; onChange: typed = value }
            if len(typed) > 0 {
              Text { text: "✕"; color: muted; width: 28; align: center; onTap: typed = "" }
            }
            Box {
              width: 150
              Text { text: reg == "all" ? "${str.everywhere} ▾" : "${str.region(reg)} ▾"; style: small; maxLines: 1; padding: [12, 6]; color: (reg != "all") ? foreground : muted; background: (reg != "all") ? alpha(foreground, 0.12) : null; border: 1; borderColor: (reg != "all") ? alpha(foreground, 0.7) : alpha(muted, 0.4); radius: 14 * corners; onTap: regOpen = true }
              Popup {
                visible: regOpen
                onDismiss: regOpen = false
                align: end
                Column {
                  gap: 0
                  for r in regions {
                    Text { text: r == "all" ? str.everywhere : str.region(r); padding: [16, 10]; bold: r == reg; color: r == reg ? accent : foreground; width: 160; onTap: { reg = r; regOpen = false } }
                  }
                }
              }
            }
          }
          Flow {
            gap: 6
            for s in sorts {
              Text { text: s.l; style: small; maxLines: 1; padding: [12, 6]; color: (sortKey == s.k) ? foreground : muted; background: (sortKey == s.k) ? alpha(foreground, 0.12) : null; border: 1; borderColor: (sortKey == s.k) ? alpha(foreground, 0.7) : alpha(muted, 0.4); radius: 14 * corners; onTap: sortKey = s.k }
            }
          }
        }
        if len(rows) == 0 {
          Text { text: str.noMatch; color: muted; align: center; padding: [16, 24] }
          Spacer { weight: 1 }
        } else {
          Column {
            lazy: true
            weight: 1
            gap: 0
            padding: [16, 0]
            for x, i in rows key x.c.id {
              let c = x.c
              let v = x.v
              Ranked {
                c: c
                i: i
                f: v / vmax
                mixBar: sortKey == "E"
                tint: sortKey == "im" ? impC : sortKey == "ex" ? expC : sortKey == "cl" ? renC : accent
                value: sortKey == "pd" ? "${fmtNum(v, v >= 100 ? 0 : 1)} ${str.kwhPerDay}"
                  : sortKey == "pk" ? "${fmtNum(v * 1000)} MWh/km²"
                  : sortKey == "cl" || sortKey == "sw" ? "${round(v * 100)}%"
                  : "${fmtNum(v, v >= 100 ? 0 : 1)} TWh"
                sub: sortKey == "E" ? str.rowElec(fixed(c.E / W.E * 100, c.E / W.E < 0.1 ? 1 : 0))
                  : sortKey == "U" ? str.rowUse2(fixed(c.U / W.U * 100, c.U / W.U < 0.1 ? 1 : 0))
                  : sortKey == "pd" ? str.rowPd(fixed(c.pd / W.pd, 1))
                  : sortKey == "pk" ? str.rowPk(fixed(c.pk / W.pk, 1))
                  : sortKey == "cl" ? str.fromClean
                  : sortKey == "sw" ? str.fromSunWind
                  : sortKey == "im" ? (c.net > 0 ? str.rowNetImp(round(c.net / c.U * 100)) : str.rowExpMore(fmtNum(c.ex, c.ex >= 100 ? 0 : 1)))
                  : (c.net < 0 ? str.rowNetExp(round(-c.net / c.E * 100)) : str.rowImpMore(fmtNum(c.im, c.im >= 100 ? 0 : 1)))
              }
            }
          }
        }

      } else {
        Column {
          weight: 1
          scroll: true
          gap: 12
          padding: [16, 4, 16, 16]

          if view == "world" {
            // ---------------------------------------------------------------- world
            let wg = [W.el[0] + W.el[1] + W.el[2], W.el[3], W.el[4] + W.el[5] + W.el[6] + W.el[7] + W.el[8]]
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Text { text: str.worldGen; style: small; color: muted }
              Text { spans: [{text: fmtNum(W.E), fontSize: 40, bold: true}, {text: " TWh", fontSize: 18, color: muted}] }
              Text { text: str.worldPer(fmtNum(W.pd, 1), fmtNum(W.pop, {compact: true})); style: small }
              Stack { vals: W.el; cols: ES; h: 18 }
              Legend { vals: W.el; srcs: ES }
            }

            Head { t: str.howClean; sub: str.worldClean(round(W.cl * 100), round(W.sw * 100)) }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Stack { vals: wg; cols: GS; h: 18 }
              Legend { vals: wg; srcs: GS }
            }

            Head { t: str.biggest; sub: str.tapHint }
            Column {
              gap: 0
              for c, i in top key c.id {
                Ranked { c: c; i: i; f: c.E / top[0].E; mixBar: true; value: "${fmtNum(c.E)} TWh"; sub: str.topSub(fixed(c.E / W.E * 100, 0), fmtNum(c.pop, {compact: true})) }
              }
            }

            Head { t: str.cleanest; sub: str.cleanestSub }
            Column {
              gap: 0
              for c, i in cleanest key c.id {
                Ranked { c: c; i: i; f: c.cl; tint: renC; value: "${round(c.cl * 100)}%"; sub: str.twhYear(fmtNum(c.E, c.E >= 100 ? 0 : 1)) }
              }
            }

            Head { t: str.windiest; sub: str.windiestSub }
            Column {
              gap: 0
              for c, i in windy key c.id {
                Ranked { c: c; i: i; f: c.sw / windy[0].sw; tint: "#16A0A0"; value: "${round(c.sw * 100)}%"; sub: str.solarWind(round(c.el[4] / c.E * 100), round(c.el[5] / c.E * 100)) }
              }
            }

            Head { t: str.exporters; sub: str.exportersSub }
            Column {
              gap: 0
              for c, i in exporters key c.id {
                Ranked { c: c; i: i; f: c.net / exporters[0].net; tint: expC; value: "${fmtNum(-c.net, -c.net >= 100 ? 0 : 1)} TWh"; sub: str.ofGen(round(-c.net / c.E * 100)) }
              }
            }

            Head { t: str.importers; sub: str.importersSub }
            Column {
              gap: 0
              for c, i in importers key c.id {
                Ranked { c: c; i: i; f: c.net / importers[0].net; tint: impC; value: "${fmtNum(c.net, c.net >= 100 ? 0 : 1)} TWh"; sub: str.ofUse(round(c.net / c.U * 100)) }
              }
            }

            Head { t: str.mostPerPerson; sub: str.millionSub }
            Column {
              gap: 0
              for c, i in hungry key c.id {
                Ranked { c: c; i: i; f: c.pd / hungry[0].pd; value: "${fmtNum(c.pd)} ${str.kwhPerDay}"; sub: str.timesAvg(fixed(c.pd / W.pd, 1)) }
              }
            }

          } else if view == "compare" {
            // ---------------------------------------------------------------- compare
            Row {
              gap: 8
              align: center
              Column {
                weight: 1
                gap: 2
                padding: [12, 10]
                background: alpha(accent, 0.12)
                border: 1
                borderColor: alpha(accent, 0.6)
                radius: 10 * corners
                onTap: picking = "a"
                Text { text: cA.f; fontSize: 32 }
                Text { text: cA.n; bold: true; maxLines: 1 }
                Text { text: str.change; style: small; color: accent }
              }
              Text { text: "⇄"; fontSize: 22; color: muted; width: 32; align: center; onTap: { cmpA = cB.id; cmpB = cA.id } }
              Column {
                weight: 1
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.06)
                border: 1
                borderColor: alpha(foreground, 0.35)
                radius: 10 * corners
                onTap: picking = "b"
                Text { text: cB.f; fontSize: 32 }
                Text { text: cB.n; bold: true; maxLines: 1 }
                Text { text: str.change; style: small; color: muted }
              }
            }

            Head { t: str.howMuch }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: str.generated; a: cA.E; b: cB.E; ta: "${fmtNum(cA.E, cA.E >= 100 ? 0 : 1)} TWh"; tb: "${fmtNum(cB.E, cB.E >= 100 ? 0 : 1)} TWh" }
              Versus { label: str.used; a: cA.U; b: cB.U; ta: "${fmtNum(cA.U, cA.U >= 100 ? 0 : 1)} TWh"; tb: "${fmtNum(cB.U, cB.U >= 100 ? 0 : 1)} TWh" }
              Versus { label: str.imported; a: cA.im; b: cB.im; ta: "${fmtNum(cA.im, cA.im >= 100 ? 0 : 1)} TWh"; tb: "${fmtNum(cB.im, cB.im >= 100 ? 0 : 1)} TWh" }
              Versus { label: str.exported; a: cA.ex; b: cB.ex; ta: "${fmtNum(cA.ex, cA.ex >= 100 ? 0 : 1)} TWh"; tb: "${fmtNum(cB.ex, cB.ex >= 100 ? 0 : 1)} TWh" }
            }

            Head { t: str.forSize }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: str.lPeople; a: cA.pop; b: cB.pop; ta: fmtNum(cA.pop, {compact: true}); tb: fmtNum(cB.pop, {compact: true}) }
              Versus { label: str.land; a: cA.km2; b: cB.km2; ta: "${fmtNum(cA.km2, {compact: true})} km²"; tb: "${fmtNum(cB.km2, {compact: true})} km²" }
              Versus { label: str.perPerson; a: cA.pd; b: cB.pd; ta: "${fmtNum(cA.pd, 1)} ${str.kwhPerDay}"; tb: "${fmtNum(cB.pd, 1)} ${str.kwhPerDay}" }
              Versus { label: str.perKm; a: cA.pk; b: cB.pk; ta: "${fmtNum(cA.pk * 1000)} MWh"; tb: "${fmtNum(cB.pk * 1000)} MWh" }
            }

            Head { t: str.howClean }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: str.nucRen; a: cA.cl; b: cB.cl; ta: "${round(cA.cl * 100)}%"; tb: "${round(cB.cl * 100)}%" }
              Versus { label: str.sunWind; a: cA.sw; b: cB.sw; ta: "${round(cA.sw * 100)}%"; tb: "${round(cB.sw * 100)}%" }
            }

            Head { t: str.whereThe }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Row { gap: 10; align: center; Text { text: cA.f; fontSize: 18 }; Column { weight: 1; Stack { vals: cA.el; cols: ES } } }
              Row { gap: 10; align: center; Text { text: cB.f; fontSize: 18 }; Column { weight: 1; Stack { vals: cB.el; cols: ES } } }
              Flow {
                gap: 12
                for s in ES {
                  Row { gap: 6; align: center; Box { width: 10; height: 10; radius: 5; background: s.c }; Text { text: s.l; style: small; color: muted } }
                }
              }
            }
            Row {
              gap: 8
              Button { text: "${cA.n}"; color: accent; onTap: openId = cA.id }
              Button { text: "${cB.n}"; color: muted; onTap: openId = cB.id }
            }

          } else {
            // ---------------------------------------------------------------- about
            Head { t: str.reading }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Column {
                gap: 2
                Text { text: "TWh"; bold: true; color: accent }
                Text { text: str.twhBody; style: small }
              }
              Column {
                gap: 2
                Text { text: str.kwhDay; bold: true; color: accent }
                Text { text: str.kwhDayBody; style: small }
              }
              Column {
                gap: 2
                Text { text: str.genUse; bold: true; color: accent }
                Text { text: str.genUseBody; style: small }
              }
              Column {
                gap: 2
                Text { text: str.cleanCap; bold: true; color: accent }
                Text { text: str.cleanBody; style: small }
              }
              Column {
                gap: 2
                Text { text: str.tradeCap; bold: true; color: accent }
                Text { text: str.tradeBody; style: small }
              }
            }
            Head { t: str.theData }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Text { text: str.dataBody(len(C)); style: small }
              Row {
                gap: 8
                Button { text: str.eiaData; color: accent; onTap: url("https://www.eia.gov/international/data/world") }
                Button { text: str.worldBank; color: muted; onTap: url("https://data.worldbank.org") }
              }
            }
          }
        }
      }

      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "world"; label: str.tabWorld; img: worldIcon }
        Tab { name: "countries"; label: str.tabCountries; img: rankIcon }
        Tab { name: "compare"; label: str.tabCompare; img: compareIcon }
        Tab { name: "about"; label: str.tabAbout; img: aboutIcon }
      }
    }
  }
}
