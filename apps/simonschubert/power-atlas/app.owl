app "power atlas" {
  meta { owl: 23; description: "How much electricity each country generates and uses, from coal to solar, how clean it is, what it imports and exports, and how that compares to its size and population"; version: "1.3"; license: "MIT"; category: "world" }
  // A country's page and the country picker are a level of their own; Back returns to the tab.
  title: openId != "" ? cn.n : picking != "" ? str.pick : view == "world" ? str.title : view == "countries" ? str.tabCountries : view == "compare" ? str.tabCompare : str.tabAbout
  back: openId != "" || picking != ""
  onBack: {
    if openId != "" { openId = "" } else { picking = "" }
  }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <circle cx="128" cy="128" r="82" fill="none" stroke="#7AA2F7" stroke-width="14"/>
    <ellipse cx="128" cy="128" rx="38" ry="82" fill="none" stroke="#7AA2F7" stroke-width="9" stroke-opacity="0.5"/>
    <path d="M50 128h156M60 88h136M60 168h136" fill="none" stroke="#7AA2F7" stroke-width="9" stroke-opacity="0.5"/>
    <path d="M146 40l-64 100h44l-18 76 66-106h-44z" fill="#E0AF68" stroke="#1A1B26" stroke-width="10" stroke-linejoin="round"/>
  </svg>"""

  // Country names for the other languages come in `names` (by id, English where missing); regions by `region`.
  strings {
    en {
      title: "world electricity"; pick: "pick a country"; tabWorld: "world"; tabCountries: "countries"; tabCompare: "compare"; tabAbout: "about"
      names: x => ({}); region: r => r; everywhere: "everywhere"
      coal: "coal"; gas: "gas"; oil: "oil"; nuclear: "nuclear"; solar: "solar"; wind: "wind"; hydro: "hydro"; biomass: "biomass"; geoTide: "geothermal and tide"
      fossil: "fossil fuels"; renewables: "renewables"
      sGenerates: "generates"; sUses: "uses"; sPerPerson: "per person"; sPerKm: "per km²"; sClean: "clean"; sSunWind: "sun & wind"; sImports: "imports"; sExports: "exports"
      search: "search countries"; noMatch: "no country matches"; people: p => "${p} people"
      genXa: "generates "; genXb: " the electricity it uses, and sells the rest abroad"; sellsA: "sells "; sellsB: " of the electricity it generates abroad"
      allA: "generates "; allBold: "all the electricity"; allB: " it uses"; buysA: "buys "; buysB: " of the electricity it uses from abroad"
      rowGen: "generates"; rowUse: "uses"
      worldShare: (p, r, n) => "That's ${p}% of the world's electricity, #${r} of ${n} countries."
      howClean: "how clean"; cleanSub: (p, r, n) => "${p}% from nuclear and renewables, #${r} of ${n}"
      whereFrom: "where its electricity comes from"; generatedIn: t => "${t} TWh generated in 2024"
      trade: "imports and exports"; tradeSub: "electricity across its borders, TWh a year"
      noTrade: "no power lines to its neighbours carry electricity in the data"
      importedArrow: "◀ imported"; exportedArrow: "exported ▶"; balanced: "as much in as out"
      netImport: "net import "; netExport: "net export "; ofUsesTail: p => ", ${p}% of what it uses"; ofGenTail: p => ", ${p}% of what it generates"
      sizeHead: "compared to its size"; sizeSub: "its share of the world"
      lPeople: "people"; land: "land"; generated: "generated"; used: "used"
      eachA: "Each person uses "; avgMore: " the world's average."; avgLess: " of the world's average."
      perPerson: "per person"; kwhDay: "kWh a day"; worldRef: (r, x) => "#${r} · world ${x}"
      perKm: "generated per km²"; clean: "clean"; sunWind: "sun and wind"
      compareWith: "compare with…"; dataLine: y => "${y} · data: U.S. EIA, World Bank"; kwhPerDay: "kWh/day"
      rowElec: p => "${p}% of the world's electricity"; rowUse2: p => "${p}% of the world's use"
      rowPd: x => "per person, ${x}× the world's average"; rowPk: x => "generated on each km², ${x}× the world's average"
      fromClean: "from nuclear and renewables"; fromSunWind: "from solar and wind"
      rowNetImp: p => "net import, ${p}% of what it uses"; rowExpMore: t => "but exports more: ${t} TWh"
      rowNetExp: p => "net export, ${p}% of what it generates"; rowImpMore: t => "but imports more: ${t} TWh"
      worldGen: "in 2024 the world generated"; worldPer: (k, p) => "of electricity: ${k} kWh a day for each of its ${p} people"
      worldClean: (a, b) => "${a}% from nuclear and renewables, ${b}% from sun and wind alone"
      biggest: "biggest generators"; tapHint: "tap one to see its page"; topSub: (p, pop) => "${p}% of the world · ${pop} people"
      cleanest: "cleanest grids"; cleanestSub: "share from nuclear and renewables, countries of a million people or more"; twhYear: t => "${t} TWh a year"
      windiest: "most sun and wind"; windiestSub: "share from solar and wind, countries of a million people or more"; solarWind: (s, w) => "${s}% solar · ${w}% wind"
      exporters: "biggest exporters"; exportersSub: "electricity sold beyond what it buys"; ofGen: p => "${p}% of what it generates"
      importers: "biggest importers"; importersSub: "electricity bought beyond what it sells"; ofUse: p => "${p}% of what it uses"
      mostPerPerson: "most per person"; millionSub: "countries of a million people or more"; timesAvg: x => "${x}× the world's average"
      change: "change"; howMuch: "how much"; imported: "imported"; exported: "exported"; forSize: "for its size"; nucRen: "nuclear and renewables"; whereThe: "where the electricity comes from"
      reading: "reading the numbers"
      twhBody: "A terawatt-hour is a billion kilowatt-hours. A home uses about 10 kWh of electricity a day, so 1 TWh is a year of electricity for some 270,000 homes."
      kwhDayBody: "All the electricity a country uses, homes, shops, factories and trains together, shared out over its people and the days of the year. Boiling a full kettle takes about 0.1 kWh."
      genUse: "Generates and uses"; genUseBody: "Generated is what the country's power stations, solar panels and wind turbines make. Used is that plus what it imports, minus what it exports."
      cleanCap: "Clean"; cleanBody: "Electricity from nuclear power and renewables: solar, wind, hydro, biomass, geothermal and tide. Fossil fuels are coal, gas and oil burnt in power stations."
      tradeCap: "Imports and exports"; tradeBody: "Electricity sent through power lines to and from neighbouring countries. Many countries do both, buying at some hours and selling at others."
      theData: "the data"; dataBody: n => "Electricity generation by source, imports and exports for ${n} countries in 2024 come from the U.S. Energy Information Administration's international energy statistics. Population and area come from the World Bank. Everything is in the app, so it works offline."
      eiaData: "EIA data"; worldBank: "World Bank"
    }
    id {
      title: "listrik dunia"; pick: "pilih negara"; tabWorld: "dunia"; tabCountries: "negara"; tabCompare: "bandingkan"; tabAbout: "tentang"
      names: x => {CHN: "Tiongkok", USA: "Amerika Serikat", IND: "India", RUS: "Rusia", JPN: "Jepang", BRA: "Brasil", CAN: "Kanada", KOR: "Korea Selatan", FRA: "Prancis", DEU: "Jerman", SAU: "Arab Saudi", IDN: "Indonesia", IRN: "Iran", MEX: "Meksiko", TUR: "Turki", VNM: "Vietnam", TWN: "Taiwan", AUS: "Australia", ESP: "Spanyol", GBR: "Britania Raya", ITA: "Italia", ZAF: "Afrika Selatan", EGY: "Mesir", THA: "Thailand", MYS: "Malaysia", SWE: "Swedia", ARE: "UEA", POL: "Polandia", NOR: "Norwegia", PAK: "Pakistan", IRQ: "Irak", ARG: "Argentina", PHL: "Filipina", KAZ: "Kazakhstan", NLD: "Belanda", COL: "Kolombia", BGD: "Bangladesh", UKR: "Ukraina", DZA: "Aljazair", KWT: "Kuwait", CHL: "Chili", VEN: "Venezuela", FIN: "Finlandia", ISR: "Israel", CHE: "Swiss", UZB: "Uzbekistan", CZE: "Ceko", AUT: "Austria", BEL: "Belgia", PER: "Peru", SGP: "Singapura", QAT: "Qatar", GRC: "Yunani", PRY: "Paraguay", LAO: "Laos", ROU: "Rumania", PRT: "Portugal", OMN: "Oman", BLR: "Belarus", NZL: "Selandia Baru", MAR: "Maroko", BGR: "Bulgaria", BHR: "Bahrain", NGA: "Nigeria", HKG: "Hong Kong", SRB: "Serbia", HUN: "Hungaria", LBY: "Libya", DNK: "Denmark", TKM: "Turkmenistan", ECU: "Ekuador", IRL: "Irlandia", SVK: "Slowakia", AZE: "Azerbaijan", PRK: "Korea Utara", SYR: "Suriah", GHA: "Ghana", DOM: "Rep. Dominika", JOR: "Yordania", TJK: "Tajikistan", MMR: "Myanmar", TUN: "Tunisia", PRI: "Puerto Riko", MOZ: "Mozambik", ZMB: "Zambia", CUB: "Kuba", ISL: "Islandia", KHM: "Kamboja", SVN: "Slovenia", ETH: "Etiopia", LKA: "Sri Lanka", COD: "RD Kongo", GTM: "Guatemala", KGZ: "Kirgistan", BIH: "Bosnia", AGO: "Angola", SDN: "Sudan", HRV: "Kroasia", GEO: "Georgia", BOL: "Bolivia", PAN: "Panama", URY: "Uruguay", KEN: "Kenya", HND: "Honduras", NPL: "Nepal", BTN: "Bhutan", CRI: "Kosta Rika", CIV: "Pantai Gading", ZWE: "Zimbabwe", TTO: "Trinidad & Tobago", ARM: "Armenia", TZA: "Tanzania", MNG: "Mongolia", ALB: "Albania", SEN: "Senegal", CMR: "Kamerun", SLV: "El Salvador", MKD: "Makedonia Utara", MDA: "Moldova", LTU: "Lituania", MLI: "Mali", LVA: "Latvia", UGA: "Uganda", BRN: "Brunei", CYP: "Siprus", COG: "Kongo", LBN: "Lebanon", EST: "Estonia", YEM: "Yaman", JAM: "Jamaika", PNG: "Papua Nugini", NIC: "Nikaragua", GIN: "Guinea", MNE: "Montenegro", BWA: "Botswana", MUS: "Mauritius", NCL: "Kaledonia Baru", GAB: "Gabon", MDG: "Madagaskar", BHS: "Bahama", MLT: "Malta", MRT: "Mauritania", MWI: "Malawi", SUR: "Suriname", BFA: "Burkina Faso", NAM: "Namibia", GNQ: "Guinea Khatulistiwa", LUX: "Luksemburg", GUY: "Guyana", FJI: "Fiji", RWA: "Rwanda", BRB: "Barbados", BEN: "Benin", AFG: "Afganistan", PSE: "Palestina", NER: "Niger", HTI: "Haiti", MDV: "Maladewa", MAC: "Makau", PYF: "Polinesia Prancis", TGO: "Togo", SWZ: "Eswatini", LBR: "Liberia", SSD: "Sudan Selatan", CPV: "Tanjung Verde", GMB: "Gambia", TLS: "Timor Leste", BDI: "Burundi", BLZ: "Belize", ERI: "Eritrea", SOM: "Somalia", TCD: "Chad", SLE: "Sierra Leone", DJI: "Djibouti", CAF: "Rep. Afrika Tengah", COM: "Komoro", SLB: "Kepulauan Solomon", GNB: "Guinea-Bissau", VUT: "Vanuatu"}; region: r => r == "Europe" ? "Eropa" : r == "Americas" ? "Amerika" : r == "Africa" ? "Afrika" : r == "Middle East" ? "Timur Tengah" : r == "Oceania" ? "Oseania" : r; everywhere: "semua"
      coal: "batu bara"; gas: "gas"; oil: "minyak"; nuclear: "nuklir"; solar: "surya"; wind: "angin"; hydro: "air"; biomass: "biomassa"; geoTide: "panas bumi dan pasang surut"
      fossil: "bahan bakar fosil"; renewables: "terbarukan"
      sGenerates: "produksi"; sUses: "pemakaian"; sPerPerson: "per orang"; sPerKm: "per km²"; sClean: "bersih"; sSunWind: "surya & angin"; sImports: "impor"; sExports: "ekspor"
      search: "cari negara"; noMatch: "tidak ada negara yang cocok"; people: p => "${p} jiwa"
      genXa: "menghasilkan "; genXb: " listrik yang dipakainya, dan menjual sisanya ke luar negeri"; sellsA: "menjual "; sellsB: " listrik yang dihasilkannya ke luar negeri"
      allA: "menghasilkan "; allBold: "semua listrik"; allB: " yang dipakainya"; buysA: "membeli "; buysB: " listrik yang dipakainya dari luar negeri"
      rowGen: "produksi"; rowUse: "pemakaian"
      worldShare: (p, r, n) => "Itu ${p}% listrik dunia, #${r} dari ${n} negara."
      howClean: "seberapa bersih"; cleanSub: (p, r, n) => "${p}% dari nuklir dan terbarukan, #${r} dari ${n}"
      whereFrom: "dari mana listriknya"; generatedIn: t => "${t} TWh dihasilkan pada 2024"
      trade: "impor dan ekspor"; tradeSub: "listrik lintas perbatasan, TWh per tahun"
      noTrade: "menurut data, tidak ada jaringan listrik yang mengalirkan listrik ke negara tetangganya"
      importedArrow: "◀ diimpor"; exportedArrow: "diekspor ▶"; balanced: "masuk dan keluar sama banyak"
      netImport: "impor bersih "; netExport: "ekspor bersih "; ofUsesTail: p => ", ${p}% dari yang dipakainya"; ofGenTail: p => ", ${p}% dari yang dihasilkannya"
      sizeHead: "dibanding ukurannya"; sizeSub: "bagiannya dari dunia"
      lPeople: "penduduk"; land: "daratan"; generated: "dihasilkan"; used: "dipakai"
      eachA: "Tiap orang memakai "; avgMore: " rata-rata dunia."; avgLess: " dari rata-rata dunia."
      perPerson: "per orang"; kwhDay: "kWh sehari"; worldRef: (r, x) => "#${r} · dunia ${x}"
      perKm: "dihasilkan per km²"; clean: "bersih"; sunWind: "surya dan angin"
      compareWith: "bandingkan dengan…"; dataLine: y => "${y} · data: U.S. EIA, Bank Dunia"; kwhPerDay: "kWh/hari"
      rowElec: p => "${p}% listrik dunia"; rowUse2: p => "${p}% pemakaian dunia"
      rowPd: x => "per orang, ${x}× rata-rata dunia"; rowPk: x => "dihasilkan tiap km², ${x}× rata-rata dunia"
      fromClean: "dari nuklir dan terbarukan"; fromSunWind: "dari surya dan angin"
      rowNetImp: p => "impor bersih, ${p}% dari yang dipakainya"; rowExpMore: t => "tapi lebih banyak ekspor: ${t} TWh"
      rowNetExp: p => "ekspor bersih, ${p}% dari yang dihasilkannya"; rowImpMore: t => "tapi lebih banyak impor: ${t} TWh"
      worldGen: "pada 2024 dunia menghasilkan"; worldPer: (k, p) => "listrik: ${k} kWh sehari untuk tiap orang dari ${p} penduduknya"
      worldClean: (a, b) => "${a}% dari nuklir dan terbarukan, ${b}% dari surya dan angin saja"
      biggest: "produsen terbesar"; tapHint: "ketuk untuk melihat halamannya"; topSub: (p, pop) => "${p}% dunia · ${pop} jiwa"
      cleanest: "jaringan terbersih"; cleanestSub: "bagian dari nuklir dan terbarukan, negara berpenduduk sejuta atau lebih"; twhYear: t => "${t} TWh per tahun"
      windiest: "surya dan angin terbanyak"; windiestSub: "bagian dari surya dan angin, negara berpenduduk sejuta atau lebih"; solarWind: (s, w) => "${s}% surya · ${w}% angin"
      exporters: "eksportir terbesar"; exportersSub: "listrik yang dijual melebihi yang dibeli"; ofGen: p => "${p}% dari yang dihasilkannya"
      importers: "importir terbesar"; importersSub: "listrik yang dibeli melebihi yang dijual"; ofUse: p => "${p}% dari yang dipakainya"
      mostPerPerson: "terbanyak per orang"; millionSub: "negara berpenduduk sejuta atau lebih"; timesAvg: x => "${x}× rata-rata dunia"
      change: "ganti"; howMuch: "seberapa banyak"; imported: "diimpor"; exported: "diekspor"; forSize: "untuk ukurannya"; nucRen: "nuklir dan terbarukan"; whereThe: "dari mana listriknya"
      reading: "membaca angkanya"
      twhBody: "Satu terawatt-jam adalah satu miliar kilowatt-jam. Sebuah rumah memakai sekitar 10 kWh listrik sehari, jadi 1 TWh adalah listrik setahun untuk sekitar 270.000 rumah."
      kwhDayBody: "Semua listrik yang dipakai sebuah negara, rumah, toko, pabrik dan kereta sekaligus, dibagi rata ke penduduknya dan hari-hari dalam setahun. Merebus satu ketel penuh butuh sekitar 0,1 kWh."
      genUse: "Produksi dan pemakaian"; genUseBody: "Produksi adalah listrik yang dibuat pembangkit, panel surya dan turbin angin negara itu. Pemakaian adalah produksi ditambah impor, dikurangi ekspor."
      cleanCap: "Bersih"; cleanBody: "Listrik dari tenaga nuklir dan terbarukan: surya, angin, air, biomassa, panas bumi dan pasang surut. Bahan bakar fosil adalah batu bara, gas dan minyak yang dibakar di pembangkit listrik."
      tradeCap: "Impor dan ekspor"; tradeBody: "Listrik yang dikirim lewat jaringan transmisi ke dan dari negara tetangga. Banyak negara melakukan keduanya, membeli di jam tertentu dan menjual di jam lain."
      theData: "datanya"; dataBody: n => "Produksi listrik per sumber, impor dan ekspor untuk ${n} negara pada 2024 berasal dari statistik energi internasional U.S. Energy Information Administration. Penduduk dan luas wilayah dari Bank Dunia. Semuanya ada di dalam aplikasi, jadi tetap jalan saat offline."
      eiaData: "data EIA"; worldBank: "Bank Dunia"
    }
    es {
      title: "electricidad mundial"; pick: "elige un país"; tabWorld: "mundo"; tabCountries: "países"; tabCompare: "comparar"; tabAbout: "acerca de"
