app "harbour master" {
  meta { owl: 23; description: "A busy 3D port from above: draw the courses that bring ships into their berths and send them back out to sea through two harbour mouths, without a collision"; version: "1.1"; license: "MIT"; category: "games" }
  // How it works. Ships come in from the open sea in three colours, through either of the breakwater's two mouths. A
  // finger drawn from a ship lays its course; drawn into a berth of its own colour (there are two of each), it docks.
  // The cranes unload it by themselves onto the train, then it backs out of the berth, empty, and waits for a course
  // back out to sea. Ships going out and ships coming in share the two mouths: two that touch sink (a strike), and
  // every ship coming in has a ring that drains until it docks; when it runs out the ship gives up, and that's a
  // strike too (ships going out can take their time). Lifebuoys come back, one for every 8 ships sent out; with all three gone the score starts again
  // (the best stays). The port is kept between visits. Ships going out come with the first empty ship, with a card the
  // first time.
  //
  // Drawing: the sea is a shader; the quay, its markings and the lighthouses are scenes that read no clock, so the
  // launcher keeps them recorded, and the cranes a recorded scene after them. Ships, the train and the boxes are one
  // scene that changes every frame, drawn after the cranes so a docked ship shows. The courses and rings are 2D
  // on a Canvas on top. The camera never moves,
  // so a finger's point on the water is a ray from the camera down to y = 0 (the same maths as Camera.project).
  //
  // The app.owl is built by a script that writes out the meshes and a few repeated formulas (PICK: a screen point
  // to the water; WATER: is a point open water).
  title: ""
  statusBar: false
  edge: true
  fps: mode == "play" ? 60 : 30
  back: mode == "play"
  onBack: mode = "pause"
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
<defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath>
<linearGradient id="s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#15506f"/><stop offset="1" stop-color="#2a8fbb"/></linearGradient></defs>
<g clip-path="url(#t)">
<rect width="256" height="256" fill="url(#s)"/>
<path d="M178 44h40M30 210h40M200 196h30" stroke="#4aa8cf" stroke-width="8" stroke-linecap="round" opacity="0.6"/>
<path d="M150 176 L118 236 M150 176 L214 214" stroke="#bfe3f2" stroke-width="10" stroke-linecap="round" opacity="0.75"/>
<path d="M118 112 C 96 84, 70 74, 44 64" stroke="#fff" stroke-width="8" stroke-linecap="round" stroke-dasharray="2 18" fill="none"/>
<circle cx="40" cy="62" r="13" fill="none" stroke="#fff" stroke-width="7"/>
<g transform="translate(140 150) rotate(-52) scale(0.95)"><path d="M-34 70 L-34 -28 Q-34 -62 0 -86 Q34 -62 34 -28 L34 70 Q34 78 26 78 L-26 78 Q-34 78 -34 70Z" fill="#b8323b"/><path d="M-27 66 L-27 -26 Q-27 -54 0 -74 Q27 -54 27 -26 L27 66Z" fill="#ef5b5b"/><rect x="-30" y="44" width="60" height="30" rx="4" fill="#f4efe4"/><rect x="-30" y="44" width="60" height="8" fill="#26384a"/><rect x="-22" y="-40" width="20" height="36" rx="2" fill="#1fb5a5"/><rect x="2" y="-40" width="20" height="36" rx="2" fill="#f6bf26"/><rect x="-22" y="0" width="20" height="36" rx="2" fill="#9a6bf0"/><rect x="2" y="0" width="20" height="36" rx="2" fill="#1fb5a5"/></g>
</g></svg>"""

  // ---- kept --------------------------------------------------------------------------------------------------
  state best = 0 persist
  state snd = true persist

  // ---- the port, kept between visits -------------------------------------------------------------------------------------------------
  // the port carries on where it was left: it opens paused, on the title
  state mode = "pause"
  state gt = 0 persist
  state score = 0 persist
  state nShips = 0 persist
  state nOut = 0 persist
  state strikes = 0 persist
  // ships: {id, x, z, h (heading, degrees, 0 = +z), c (colour = berth), st, out (empty, on its way out), p (course:
  // [x, z, screen x, screen y]), b (berth it's bound for; -2 a course out to sea), cg (four deck places: -1 empty,
  // 0 teal, 1 purple), t0 (came in, or got ready to leave), t1 (docked), ua (next box), lt, bk (blocked), au (on its
  // own way to an anchorage an)}
  // st: 0 sailing on a course (in or out), 1 docked, 3 empty and about to back out, 4 backing out, 2 leaving by itself
  state ships = [] persist
  state nid = 0 persist
  state spAt = 1.5 persist
  // the train: x, st (0 coming, 1 waiting, 2 going, 3 away until t), w: per wagon -1 or when its box lands
  state tr = {x: -17, st: 3, t: 5, w: [-1, -1, -1, -1]} persist
  // boxes in the air: from a to b, starting at t
  state fl = []
  // sinkings, for the rings
  state fx = []
  // weather, from when there were storms: kept at 0 (a saved port from before clears)
  state wx = 0 persist
  state wdir = 1 persist
  state msg = ""
  state msgT = -10
  // what the finger is doing: k -2 nothing, -1 ignored, 0 a ship's course
  state dg = {k: -2}
  // ships sent out since the last time every lifebuoy was lost: the traffic grows with it
  state run = 0 persist
  // START OVER asks once more before it clears the port
  state sure = false
  // a lifebuoy just lost: the port holds still this many seconds, with red rings where (lp) and the reason in the banner
  state hold = 0
  state lp = []
  // what cost each lifebuoy since the last time all three were lost, for the PORT CLOSED screen
  state losses = [] persist
  // set by the store's screenshots (screens.txt) to hold a scene still while it's drawn
  state still = false
  // the port opens up in stages: 0 ships coming in, 1 ships going out too. card: a stage's card on screen
  // (stage + 1), which holds the game
  state lvl = 0 persist
  state card = 0
  // when the train's stage came, which starts the weather's clock (-1 before)
  state wt = -1 persist
  // the highest stage whose card has been read, so a card shows once
  state taught = -1 persist

  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 10)
  let INS = screenInset ?? 0
  // the port is 11.2 units across at the quay: a wider fov on narrow screens keeps it in
  // In landscape the whole port turns a quarter: the camera stands to the west, so the sea is on the left and the quay
  // on the right, and the six berths run up the screen.
  let LAND = SW > SH
  let FOV = LAND ? 28 : clamp(44 * 0.4613 / (SW / SH), 40, 64)
  let TH = tan(rad(FOV / 2))
  let LOOK = LAND ? [1.0, 0, -4.6] : [0, 0, -4.5]
  let EYE = LAND ? [-5, 32, -4.6] : [0, 32, 8]
  let CAM = {eye: EYE, look: LOOK, fov: FOV, far: 90}
  let FW = norm([LOOK[0] - EYE[0], LOOK[1] - EYE[1], LOOK[2] - EYE[2]])
  let RT = norm(cross(FW, [0, 1, 0]))
  let UPV = cross(RT, FW)
  let LIGHT = [-0.45, 1, 0.5]

  // ---- the port ----------------------------------------------------------------------------------------------------
  // six berths, two of each colour mirrored, so a ship has one on each side of the port
  let BX = [-4.65, -2.8, -0.93, 0.93, 2.8, 4.65]
  let BCOL = [0, 1, 2, 2, 1, 0]
  // the two harbour mouths, between the breakwater's three pieces
  let GX = [-2.7, 2.7]
  let BZ = 3.85
  let BC = [#e5484d, #f6bf26, #3d85f0]
  let BN = ["RED", "YELLOW", "BLUE"]
  let KC = [#1fb5a5, #9a6bf0]
  let FOGC = #9aa3ab
  let RZ = 7.1
  let WOFF = [1.38, 0, -1.38, -2.76]
  // deck places on a ship, across and along
  let SLX = [-0.15, 0.15, -0.15, 0.15]
  let SLZ = [0.28, 0.28, -0.3, -0.3]
  let BOXS = [0.28, 0.24, 0.56]
  let SPD = 1.1
  let TRN = 150
  // how long a ship coming in may take to dock before it costs a lifebuoy (ships going out have no limit)
  let PAT = 50
  let FD = 0.9
  // how long an empty ship waits for its course out before it goes by itself (a strike)
  let TRW = 17

  // ---- the look --------------------------------------------------------------------------------------------------------
  // Sounds from Google's sound library (actions.google.com/sounds, CC BY 4.0), trimmed and made mono Opus to fit in
  // the file: wood plank flicks (a box set down by a crane) and magic chime (a full train, a new best).
  asset SBUILD = base64""
  asset SCHIME = base64""
  let FONT = "https://raw.githubusercontent.com/google/fonts/main/ofl/sairastencilone/SairaStencilOne-Regular.ttf"
  let NAVY = #0f2a3d
  let NAVY2 = #07182a
  let CRM = #f3efe4
  let YEL = #f6bf26
  let YEL2 = #a87d0e
  let SEA = #1f6f95
  let REDC = #e5484d

  let WAKE = mesh([[-0.28, 0.005, -0.9], [-0.36, 0.005, -0.9], [-0.95, 0.005, -2.5], [-0.8, 0.005, -2.5], [0.28, 0.005, -0.9], [0.36, 0.005, -0.9], [0.95, 0.005, -2.5], [0.8, 0.005, -2.5], [-0.22, 0.005, -0.95], [0.22, 0.005, -0.95], [0.1, 0.005, -1.9], [-0.1, 0.005, -1.9]], [[3, 2, 1, 0], [4, 5, 6, 7], [8, 9, 10, 11]], [#9fd0e4, #9fd0e4, #7fbcd6])
  let HULL = [mesh([[-0.34, 0, -0.95], [0.34, 0, -0.95], [0.34, 0, 0.5], [0.17, 0, 0.92], [0, 0, 1.1], [-0.17, 0, 0.92], [-0.34, 0, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.2, -0.95], [0.34, 0.2, -0.95], [0.34, 0.2, 0.5], [0.17, 0.2, 0.92], [0, 0.2, 1.1], [-0.17, 0.2, 0.92], [-0.34, 0.2, 0.5], [-0.3, 0.2, -0.93], [0.3, 0.2, -0.93], [0.3, 0.2, -0.62], [-0.3, 0.2, -0.62], [-0.3, 0.56, -0.93], [0.3, 0.56, -0.93], [0.3, 0.56, -0.62], [-0.3, 0.56, -0.62], [-0.1, 0.56, -0.9], [0.1, 0.56, -0.9], [0.1, 0.56, -0.74], [-0.1, 0.56, -0.74], [-0.1, 0.8, -0.9], [0.1, 0.8, -0.9], [0.1, 0.8, -0.74], [-0.1, 0.8, -0.74]], [[7, 8, 1, 0], [8, 9, 2, 1], [9, 10, 3, 2], [10, 11, 4, 3], [11, 12, 5, 4], [12, 13, 6, 5], [13, 7, 0, 6], [27, 26, 25, 24, 23, 22, 21], [21, 22, 15, 14], [22, 23, 16, 15], [23, 24, 17, 16], [24, 25, 18, 17], [25, 26, 19, 18], [26, 27, 20, 19], [27, 21, 14, 20], [35, 34, 33, 32], [32, 33, 29, 28], [33, 34, 30, 29], [34, 35, 31, 30], [35, 32, 28, 31], [43, 42, 41, 40], [40, 41, 37, 36], [41, 42, 38, 37], [42, 43, 39, 38], [43, 40, 36, 39]], [#a8323a, #a8323a, #a8323a, #a8323a, #a8323a, #a8323a, #a8323a, #f2716f, #e5484d, #e5484d, #e5484d, #e5484d, #e5484d, #e5484d, #e5484d, #d8d1c2, #efe9dc, #efe9dc, #2a3a4a, #efe9dc, #1e2730, #e5484d, #e5484d, #e5484d, #e5484d]), mesh([[-0.34, 0, -0.95], [0.34, 0, -0.95], [0.34, 0, 0.5], [0.17, 0, 0.92], [0, 0, 1.1], [-0.17, 0, 0.92], [-0.34, 0, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.2, -0.95], [0.34, 0.2, -0.95], [0.34, 0.2, 0.5], [0.17, 0.2, 0.92], [0, 0.2, 1.1], [-0.17, 0.2, 0.92], [-0.34, 0.2, 0.5], [-0.3, 0.2, -0.93], [0.3, 0.2, -0.93], [0.3, 0.2, -0.62], [-0.3, 0.2, -0.62], [-0.3, 0.56, -0.93], [0.3, 0.56, -0.93], [0.3, 0.56, -0.62], [-0.3, 0.56, -0.62], [-0.1, 0.56, -0.9], [0.1, 0.56, -0.9], [0.1, 0.56, -0.74], [-0.1, 0.56, -0.74], [-0.1, 0.8, -0.9], [0.1, 0.8, -0.9], [0.1, 0.8, -0.74], [-0.1, 0.8, -0.74]], [[7, 8, 1, 0], [8, 9, 2, 1], [9, 10, 3, 2], [10, 11, 4, 3], [11, 12, 5, 4], [12, 13, 6, 5], [13, 7, 0, 6], [27, 26, 25, 24, 23, 22, 21], [21, 22, 15, 14], [22, 23, 16, 15], [23, 24, 17, 16], [24, 25, 18, 17], [25, 26, 19, 18], [26, 27, 20, 19], [27, 21, 14, 20], [35, 34, 33, 32], [32, 33, 29, 28], [33, 34, 30, 29], [34, 35, 31, 30], [35, 32, 28, 31], [43, 42, 41, 40], [40, 41, 37, 36], [41, 42, 38, 37], [42, 43, 39, 38], [43, 40, 36, 39]], [#b98a12, #b98a12, #b98a12, #b98a12, #b98a12, #b98a12, #b98a12, #ffd65c, #f6bf26, #f6bf26, #f6bf26, #f6bf26, #f6bf26, #f6bf26, #f6bf26, #d8d1c2, #efe9dc, #efe9dc, #2a3a4a, #efe9dc, #1e2730, #f6bf26, #f6bf26, #f6bf26, #f6bf26]), mesh([[-0.34, 0, -0.95], [0.34, 0, -0.95], [0.34, 0, 0.5], [0.17, 0, 0.92], [0, 0, 1.1], [-0.17, 0, 0.92], [-0.34, 0, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.2, -0.95], [0.34, 0.2, -0.95], [0.34, 0.2, 0.5], [0.17, 0.2, 0.92], [0, 0.2, 1.1], [-0.17, 0.2, 0.92], [-0.34, 0.2, 0.5], [-0.3, 0.2, -0.93], [0.3, 0.2, -0.93], [0.3, 0.2, -0.62], [-0.3, 0.2, -0.62], [-0.3, 0.56, -0.93], [0.3, 0.56, -0.93], [0.3, 0.56, -0.62], [-0.3, 0.56, -0.62], [-0.1, 0.56, -0.9], [0.1, 0.56, -0.9], [0.1, 0.56, -0.74], [-0.1, 0.56, -0.74], [-0.1, 0.8, -0.9], [0.1, 0.8, -0.9], [0.1, 0.8, -0.74], [-0.1, 0.8, -0.74]], [[7, 8, 1, 0], [8, 9, 2, 1], [9, 10, 3, 2], [10, 11, 4, 3], [11, 12, 5, 4], [12, 13, 6, 5], [13, 7, 0, 6], [27, 26, 25, 24, 23, 22, 21], [21, 22, 15, 14], [22, 23, 16, 15], [23, 24, 17, 16], [24, 25, 18, 17], [25, 26, 19, 18], [26, 27, 20, 19], [27, 21, 14, 20], [35, 34, 33, 32], [32, 33, 29, 28], [33, 34, 30, 29], [34, 35, 31, 30], [35, 32, 28, 31], [43, 42, 41, 40], [40, 41, 37, 36], [41, 42, 38, 37], [42, 43, 39, 38], [43, 40, 36, 39]], [#2a5fae, #2a5fae, #2a5fae, #2a5fae, #2a5fae, #2a5fae, #2a5fae, #6aa5ff, #3d85f0, #3d85f0, #3d85f0, #3d85f0, #3d85f0, #3d85f0, #3d85f0, #d8d1c2, #efe9dc, #efe9dc, #2a3a4a, #efe9dc, #1e2730, #3d85f0, #3d85f0, #3d85f0, #3d85f0]), mesh([[-0.34, 0, -0.95], [0.34, 0, -0.95], [0.34, 0, 0.5], [0.17, 0, 0.92], [0, 0, 1.1], [-0.17, 0, 0.92], [-0.34, 0, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.12, -0.95], [0.34, 0.12, -0.95], [0.34, 0.12, 0.5], [0.17, 0.12, 0.92], [0, 0.12, 1.1], [-0.17, 0.12, 0.92], [-0.34, 0.12, 0.5], [-0.34, 0.2, -0.95], [0.34, 0.2, -0.95], [0.34, 0.2, 0.5], [0.17, 0.2, 0.92], [0, 0.2, 1.1], [-0.17, 0.2, 0.92], [-0.34, 0.2, 0.5], [-0.3, 0.2, -0.93], [0.3, 0.2, -0.93], [0.3, 0.2, -0.62], [-0.3, 0.2, -0.62], [-0.3, 0.56, -0.93], [0.3, 0.56, -0.93], [0.3, 0.56, -0.62], [-0.3, 0.56, -0.62], [-0.1, 0.56, -0.9], [0.1, 0.56, -0.9], [0.1, 0.56, -0.74], [-0.1, 0.56, -0.74], [-0.1, 0.8, -0.9], [0.1, 0.8, -0.9], [0.1, 0.8, -0.74], [-0.1, 0.8, -0.74]], [[7, 8, 1, 0], [8, 9, 2, 1], [9, 10, 3, 2], [10, 11, 4, 3], [11, 12, 5, 4], [12, 13, 6, 5], [13, 7, 0, 6], [27, 26, 25, 24, 23, 22, 21], [21, 22, 15, 14], [22, 23, 16, 15], [23, 24, 17, 16], [24, 25, 18, 17], [25, 26, 19, 18], [26, 27, 20, 19], [27, 21, 14, 20], [35, 34, 33, 32], [32, 33, 29, 28], [33, 34, 30, 29], [34, 35, 31, 30], [35, 32, 28, 31], [43, 42, 41, 40], [40, 41, 37, 36], [41, 42, 38, 37], [42, 43, 39, 38], [43, 40, 36, 39]], [#6b737a, #6b737a, #6b737a, #6b737a, #6b737a, #6b737a, #6b737a, #aab2b9, #8e979f, #8e979f, #8e979f, #8e979f, #8e979f, #8e9