        .map(s => s.st == 0 && s.au && len(s.p) > 0 && any(ships, o => o.id != s.id && o.st != 2 && ((o.x) - (s.x)) * ((o.x) - (s.x)) + ((o.z) - (s.z)) * ((o.z) - (s.z)) < 4.4 && sin(rad(s.h)) * (o.x - s.x) + cos(rad(s.h)) * (o.z - s.z) > 0.3) ? merge(s, {bk: false}) : s.st == 0 && len(s.p) > 0 ? [[s.x + sin(rad(s.h)) * SPD * dt, s.z + cos(rad(s.h)) * SPD * dt]].map(q => [[q[0] + sin(rad(s.h)) * 1.1, q[1] + cos(rad(s.h)) * 1.1]].map(w => w[1] < 5 && w[1] > -23 && abs(w[0]) < 11.5 && !(w[1] > -5.5 && abs(w[0]) > 5.6) && !(w[1] > -5.5 && w[1] < -4.7 && !(abs(w[0]) > 1.5 && abs(w[0]) < 3.9)))[0] && [[q[0] - sin(rad(s.h)) * 0.9, q[1] - cos(rad(s.h)) * 0.9]].map(w => w[1] < 5 && w[1] > -23 && abs(w[0]) < 11.5 && !(w[1] > -5.5 && abs(w[0]) > 5.6) && !(w[1] > -5.5 && w[1] < -4.7 && !(abs(w[0]) > 1.5 && abs(w[0]) < 3.9)))[0] ? merge(s, {x: q[0], z: q[1], bk: false}) : merge(s, {bk: true}))[0]
          : s.st == 2 ? merge(s, {x: s.x + sin(rad(s.h)) * SPD * 1.3 * dt, z: s.z + cos(rad(s.h)) * SPD * 1.3 * dt})
