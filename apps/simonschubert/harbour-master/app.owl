        .map(s => len(s.p) == 0 || (s.st != 0 && s.st != 2) ? s : [((s.x) - (s.p[0][0])) * ((s.x) - (s.p[0][0])) + ((s.z) - (s.p[0][1])) * ((s.z) - (s.p[0][1]))].map(d => s.st == 0 && s.b >= 0 && len(s.p) == 1 ? (d < 0.1 || s.bk ? merge(s, {st: 1, x: BX[s.b], z: BZ, h: 0, p: [], t1: gt, ua: gt + 1.0, bk: false}) : s) : d < 0.09 || (d < 1.0 && sin(rad(s.h)) * (s.p[0][0] - s.x) + cos(rad(s.h)) * (s.p[0][1] - s.z) < 0) ? merge(s, {p: drop(s.p, 1)}) : s)[0])
        // unloaded: it backs out of the berth, then follows the course drawn for it meanwhile, or waits for one
        .map(s => s.st == 3 && gt > s.lt ? merge(s, {st: 4}) : s.st == 4 && s.z < 2.1 ? merge(s, {st: 0, out: true, b: s.b == -2 ? -2 : -1, t0: gt, au: false, an: -1}) : s)
      let nd = count(ships, s => s.st == 1 && s.t1 == gt)
      if nd > 0 {
        score = score + 5 * nd
        nShips = nShips + nd
        haptic("light")
      }
      // out at sea on its way: a ship sent out
      let gone = count(ships, s => s.st == 0 && s.out && s.z < -19)
      if gone > 0 {
        score = score + 10 * gone
        nOut = nOut + gone
        ships = ships.filter(s => !(s.st == 0 && s.out && s.z < -19))
        if snd { sound(SBUILD) }
        // every 8 ships sent out bring a lifebuoy back
        if strikes > 0 && floor((run + gone) / 8) > floor(run / 8) {
          strikes = strikes - 1
          msg = "A LIFEBUOY BACK!"
          msgT = gt
          if snd { sound(SCHIME) }
        }
        run = run + gone
        best = max(best, score)
      }

      // kept waiting too long to dock: it goes off by itself, and that's a strike
      let tired = ships.filter(s => s.st == 0 && !s.out && gt - s.t0 > PAT)
      if len(tired) > 0 {
        strikes = strikes + len(tired)
        lp = tired.map(q => [q.x, q.z])
        hold = 2.2
        losses = (losses + tired.map(q => "THE ${BN[q.c]} SHIP WAITED TOO LONG TO DOCK")).take(3)
        ships = ships.map(s => s.st == 0 && !s.out && gt - s.t0 > PAT ? merge(s, {st: 2, b: -1, p: s.z > -5 ? [[GX[s.x < 0 ? 0 : 1], -2.8], [GX[s.x < 0 ? 0 : 1], -5.1], [GX[s.x < 0 ? 0 : 1], -9], [GX[s.x < 0 ? 0 : 1] * 1.6, -24]] : [[s.x, -24]]}) : s)
        msg = "THE ${BN[tired[0].c]} SHIP WAITED TOO LONG TO DOCK"
        msgT = gt
        haptic()
        if dg.k == 0 && any(tired, q => q.id == dg.id) { dg = {k: -1, fid: dg.fid} }
      }

      // ships that clearly overlap sink: each is two small circles, bow half and stern half, so a brush of the hulls
      // doesn't count. They stay on show, ringed in red, while the port holds still
      let hit = hold > 0 ? [] : ships.filter(a => a.st != 2 && a.z > -19 && any(ships, b => b.id != a.id && b.st != 2 && b.z > -19 && (a.st == 0 || b.st == 0 || a.st == 4 || b.st == 4) && ((a.x) - (b.x)) * ((a.x) - (b.x)) + ((a.z) - (b.z)) * ((a.z) - (b.z)) < 4 && any([[0.5, 0.5], [0.5, -0.5], [-0.5, 0.5], [-0.5, -0.5]], o => ((a.x + sin(rad(a.h)) * o[0]) - (b.x + sin(rad(b.h)) * o[1])) * ((a.x + sin(rad(a.h)) * o[0]) - (b.x + sin(rad(b.h)) * o[1])) + ((a.z + cos(rad(a.h)) * o[0]) - (b.z + cos(rad(b.h)) * o[1])) * ((a.z + cos(rad(a.h)) * o[0]) - (b.z + cos(rad(b.h)) * o[1])) < 0.2)))
      if len(hit) > 0 {
        ships = ships.map(s => any(hit, q => q.id == s.id) ? merge(s, {sk: true}) : s)
        strikes = strikes + 1
        lp = [[avg(hit.map(q => q.x)), avg(hit.map(q => q.z))]]
        hold = 2.2
        msg = len(hit) >= 2 && hit[0].c != hit[1].c ? "THE ${BN[hit[0].c]} AND ${BN[hit[1].c]} SHIPS COLLIDED" : "TWO ${BN[hit[0].c]} SHIPS COLLIDED"
        losses = (losses + [msg]).take(3)
        msgT = gt
        haptic("strong")
        if dg.k == 0 && any(hit, q => q.id == dg.id) { dg = {k: -1, fid: dg.fid} }
      }
      ships = ships.filter(s => s.z > -23.5 && abs(s.x) < 11)
      fx = fx.filter(f => gt - f.t < 1.6)
      fl = fl.filter(f => gt - f.t < FD + 0.05)

      // The cranes work by themselves: a box a second off a docked ship, onto the train if it's in, else onto the quay
      // behind the crane to be carted off.
      let U = first(ships.filter(s => s.st == 1 && gt >= s.ua && any(s.cg, c => c >= 0)))
      if U != null {
        let i = last(range(4).filter(j => U.cg[j] >= 0))
        let wi = tr.st == 1 ? first(range(4).filter(w => tr.w[w] < 0)) : null
        fl = fl + [{a: [U.x + SLX[i], 0.32, U.z + SLZ[i]], b: wi != null ? [tr.x + WOFF[wi], 0.62, RZ] : [U.x, 0.42, 6.0], t: gt, k: U.cg[i], ha: 0, hb: 90}]
        if wi != null {
          tr = merge(tr, {w: set(tr.w, wi, gt + FD)})
        }
        ships = ships.map(s => s.id == U.id ? [set(s.cg, i, -1)].map(c => merge(s, all(c, k => k < 0) ? {cg: c, st: 3, out: true, lt: gt + FD + 0.6} : {cg: c, ua: gt + 0.9}))[0] : s)
      }

      // the train comes, waits, and goes, sooner once it's full
      if tr.st == 3 && gt > tr.t {
        tr = {x: -17, st: 0, t: gt, w: [-1, -1, -1, -1]}
      } else if tr.st == 0 {
        let v = clamp(-tr.x * 1.1, 1.0, 8) * dt
        tr = tr.x + v >= 0 ? merge(tr, {x: 0, st: 1, t: gt}) : merge(tr, {x: tr.x + v})
      } else if tr.st == 1 && gt > reduce(tr.w, (m, a) => max(m, a), -1) + 0.5 && (all(tr.w, a => a >= 0) || gt > tr.t + TRW) {
        tr = merge(tr, {st: 2, t: gt})
      } else if tr.st == 2 {
        tr = tr.x > 18 ? merge(tr, {st: 3, t: gt + 4}) : merge(tr, {x: tr.x + min(9, 0.5 + (gt - tr.t) * 5) * dt})
      }
    }
  }

  Box {
    fill: true
    background: SEA

    // ---- the water: each pixel is traced down to the sea, so the swell lies flat in the scene ----
    Shader {
      fill: true
      fallback: SEA
      uniforms: {eye: EYE, fw: FW, rt: RT, upv: UPV, th: TH, deep: wx == 2 ? #164a68 : #1d6c96, shal: wx == 2 ? #22678a : #3197c0, wxs: wx == 2 ? 1 : 0, fogv: wx == 1 ? 1 : 0, tt: gt}
      code: """
        uniform float3 eye;
        uniform float3 fw;
        uniform float3 rt;
        uniform float3 upv;
        uniform float th;
        uniform half4 deep;
        uniform half4 shal;
        uniform float wxs;
        uniform float fogv;
        uniform float tt;
        half4 main(float2 p) {
          float2 q = float2((2.0 * p.x / size.x - 1.0) * th * size.x / size.y, (1.0 - 2.0 * p.y / size.y) * th);
          float3 d = fw + rt * q.x + upv * q.y;
          float2 w = float2(eye.x - d.x * eye.y / d.y, eye.z - d.z * eye.y / d.y);
          float a = 1.0 + wxs * 1.4;
          float sp = 1.0 + wxs * 1.5;
          float v = sin(w.x * 1.9 + w.y * 0.7 + tt * 0.9 * sp) * sin(w.y * 2.4 - w.x * 0.9 - tt * 0.7 * sp);
          float v2 = sin(w.x * 4.1 - w.y * 3.3 + tt * 1.6 * sp) * 0.5;
          float g = smoothstep(0.8, 1.05, v * 0.8 + v2 * 0.4);
          half3 c = mix(deep.rgb, shal.rgb, half(smoothstep(-7.0, 0.5, w.y)));
          c += half3(0.02, 0.03, 0.035) * half(v * a);
          c += half3(0.1, 0.11, 0.11) * half(g * a * 0.4);
          c = mix(c, half3(0.78, 0.82, 0.85), half(fogv * smoothstep(-1.5, -9.0, w.y) * 0.75));
          return half4(c, 1.0);
        }
      """
    }

    // ---- the port, recorded: it reads no clock ----
    Canvas {
      fill: true
      scene(CAM, light: LIGHT, ambient: 0.9) {
        model(BERTHW, ambient: 1)
      }
      scene(CAM, light: LIGHT, ambient: 0.6) {
        model(LAND)
      }
      scene(CAM, light: LIGHT, ambient: 0.75) {
        model(DECALS)
      }
      scene(CAM, light: LIGHT, ambient: 0.6) {
        model(PROPS)
      }
    }

    // ---- the cranes, recorded; the ships are drawn after them, so a docked ship and its boxes show ----
    Canvas {
      fill: true
      scene(CAM, light: LIGHT, ambient: 0.6) {
        for b in range(6) { model(CRANE[BCOL[b]], at: [BX[b], 0, 0]) }
      }
    }

    // ---- what moves ----
    Canvas {
      fill: true
      scene(CAM, light: LIGHT, ambient: 0.6) {
        for s in ships {
          let fg = false
          let ch = cos(rad(s.h))
          let sh = sin(rad(s.h))
          if s.st == 2 || s.st == 4 || (s.st == 0 && !s.bk && len(s.p) > 0) {
            model(WAKE, at: [s.x, 0, s.z], turn: [0, s.h, 0], ambient: 1)
          }
          model(HULL[fg ? 3 : s.c], at: [s.x, 0, s.z], turn: [0, s.h, 0])
          for j in range(4) {
            if s.cg[j] >= 0 {
              model(BOX, at: [s.x + SLX[j] * ch + SLZ[j] * sh, 0.32, s.z - SLX[j] * sh + SLZ[j] * ch], turn: [0, s.h, 0], scale: BOXS, color: fg ? FOGC : KC[s.cg[j]])
            }
          }
        }
        if tr.st != 3 {
          model(LOCO, at: [tr.x + 2.76, 0.3, RZ], turn: [0, 90, 0])
          for w in range(4) {
            model(WAGON, at: [tr.x + WOFF[w], 0.3, RZ], turn: [0, 90, 0])
            if tr.w[w] >= 0 && gt >= tr.w[w] {
              model(BOX, at: [tr.x + WOFF[w], 0.62, RZ], turn: [0, 90, 0], scale: BOXS, color: KC[0])
            }
          }
        }
        for f in fl {
          let u = clamp((gt - f.t) / FD, 0, 1)
          let e = u * u * (3 - 2 * u)
          model(BOX, at: [lerp(f.a[0], f.b[0], e), lerp(f.a[1], f.b[1], e) + sin(u * 3.1416) * 1.7, lerp(f.a[2], f.b[2], e)], turn: [0, lerp(f.ha, f.hb, e), 0], scale: BOXS, color: KC[f.k])
        }
      }
    }

    // ---- courses, rings and warnings; the finger ----
    Canvas {
      fill: true
      if mode == "play" || mode == "pause" {
        if wx == 1 && WXA > 0 {
          rect(0, 0, width, height * 0.5, fill: linear(0, 0, 0, height * 0.5, [alpha(#e3e9ec, 0.94 * WXA), alpha(#e3e9ec, 0.8 * WXA), alpha(#e3e9ec, 0)]))
        }
        for s in ships {
          let sp = project([s.x, 0.2, s.z], CAM, width, height)
          if sp != null {
            let fg = false
            let col = BC[s.c]
            if (s.st == 0 || s.st == 3 || s.st == 4) && len(s.p) > 0 && !s.au {
              path([[sp.x, sp.y]] + s.p.map(q => len(q) > 2 ? [q[2], q[3]] : [project([q[0], 0.2, q[1]], CAM, width, height)].map(pp => [pp.x, pp.y])[0]), stroke: alpha(col, 0.85), width: s.id == DRAW ? 5 : 3.5, cap: round)
              let ep = len(last(s.p)) > 2 ? {x: last(s.p)[2], y: last(s.p)[3]} : project([last(s.p)[0], 0.2, last(s.p)[1]], CAM, width, height)
              if s.b >= 0 {
                circle(ep.x, ep.y, 6, fill: col)
              } else if s.b == -2 {
                path([[ep.x - 8, ep.y + 6], [ep.x, ep.y - 6], [ep.x + 8, ep.y + 6]], stroke: col, width: 3.5, cap: round)
              } else {
                circle(ep.x, ep.y, 5, stroke: col, width: 2.5)
              }
            }
            if s.st == 0 {
              // patience: a ring that drains, the ship's colour, then yellow, then red and pulsing
              let left = clamp(1 - (gt - s.t0) / PAT, 0, 1)
              if s.z > -19 && !s.out {
                arc(sp.x, sp.y, 25, 0, 360, stroke: alpha(NAVY2, 0.35), width: 4)
                arc(sp.x, sp.y, 25, 0, 360 * left, stroke: left < 0.25 ? alpha(REDC, 0.6 + 0.4 * sin(gt * 12)) : left < 0.5 ? YEL : alpha(BC[s.c], 0.9), width: 4, cap: round)
              }
              if fg {
                let ph = (gt * 0.9 + s.id * 0.37) % 1
                circle(sp.x, sp.y, 12 + ph * 26, stroke: alpha(#ffffff, 0.8 * (1 - ph)), width: 2.5)
              }
              if s.bk {
                circle(sp.x, sp.y - 30, 10, fill: REDC)
                text("!", sp.x, sp.y - 30, size: 14, font: FONT, align: center, color: CRM)
              }
              // empty and waiting for its way out: a pulsing ring and an arrow out to sea
              if s.out && len(s.p) == 0 {
                let ph = (gt * 1.2 + s.id * 0.3) % 1
                circle(sp.x, sp.y, 16 + ph * 16, stroke: alpha(col, 1 - ph), width: 3)
                path([[sp.x - 9, sp.y - 34], [sp.x, sp.y - 44], [sp.x + 9, sp.y - 34]], stroke: CRM, width: 4, cap: round)
              }
            }
            // about to back out of its berth: arrows behind its stern
            if s.st == 3 || s.st == 4 || (s.st == 1 && count(s.cg, c => c >= 0) == 1) {
              let bp = project([s.x, 0.2, s.z - 1.5], CAM, width, height)
              let ph = (gt * 2) % 1
              path([[bp.x - 8, bp.y + 4 - ph * 6], [bp.x, bp.y - 4 - ph * 6], [bp.x + 8, bp.y + 4 - ph * 6]], stroke: alpha(CRM, 0.4 + 0.6 * (1 - ph)), width: 3.5, cap: round)
            }
          }
        }
        // two ships getting close: a red line between them and rings, before they touch
        for q in NEARP {
          let a = project([q[0], 0.2, q[1]], CAM, width, height)
          let b = project([q[2], 0.2, q[3]], CAM, width, height)
          let pu = 0.5 + 0.5 * sin(gt * 14)
          line(a.x, a.y, b.x, b.y, stroke: alpha(REDC, 0.5 + 0.4 * pu), width: 3, cap: round)
          circle(a.x, a.y, 20, stroke: alpha(REDC, 0.4 + 0.5 * pu), width: 3)
          circle(b.x, b.y, 20, stroke: alpha(REDC, 0.4 + 0.5 * pu), width: 3)
        }
        // a lifebuoy just lost: everything holds, red rings close in on where it happened
        if hold > 0 {
          rect(0, 0, width, height, fill: alpha(#2a0508, 0.25))
          for q in lp {
            let a = project([q[0], 0.2, q[1]], CAM, width, height)
            circle(a.x, a.y, 30 + hold * 40, stroke: alpha(REDC, 0.9), width: 5)
            circle(a.x, a.y, 30, stroke: REDC, width: 4)
            line(a.x - 14, a.y - 14, a.x + 14, a.y + 14, stroke: REDC, width: 5, cap: round)
            line(a.x - 14, a.y + 14, a.x + 14, a.y - 14, stroke: REDC, width: 5, cap: round)
          }
        }
        // a sinking: rings on the water
        for f in fx {
          let fp = project([f.x, 0, f.z], CAM, width, height)
          let u = (gt - f.t) / 1.6
          if fp != null {
            circle(fp.x, fp.y, 10 + u * 50, stroke: alpha(#ffffff, 1 - u), width: 4)
            circle(fp.x, fp.y, 4 + u * 28, stroke: alpha(#ffffff, 0.7 * (1 - u)), width: 2.5)
          }
        }
      }

      // One finger, drawn from a ship: the course it sails. Coming in, it ends in a berth of the ship's colour; going
      // out, past the breakwater at sea.
      onTouch: {
        let T = touches
        if mode == "play" && card == 0 && hold == 0 {
          let t = first(T.filter(f => dg.k > -2 && f.id == dg.fid)) ?? (dg.k == -2 ? first(T) : null)
          if t == null && dg.k > -2 {
            dg = {k: -2}
          } else if t != null && dg.k == -2 {
            // a finger down: on which ship?
            let W = [[(2 * (t.x) / SW - 1) * TH * SW / SH, (1 - 2 * (t.y) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            let S = first(ships.filter(s => (s.st == 0 || s.st == 3 || s.st == 4) && s.z > -23).sortBy(s => ((s.x) - (W[0])) * ((s.x) - (W[0])) + ((s.z) - (W[1])) * ((s.z) - (W[1]))))
            if S != null && ((S.x) - (W[0])) * ((S.x) - (W[0])) + ((S.z) - (W[1])) * ((S.z) - (W[1])) < 2.0 {
              dg = {k: 0, id: S.id, fid: t.id, lx: t.x, ly: t.y}
              ships = ships.map(s => s.id == S.id ? merge(s, {p: [], b: s.st == 0 ? -1 : -3, au: false, an: -1}) : s)
            } else {
              dg = {k: -1, fid: t.id}
            }
          } else if t != null && dg.k == 0 {
            let W = [[(2 * (t.x) / SW - 1) * TH * SW / SH, (1 - 2 * (t.y) / SH) * TH]].map(q => [FW[0] + RT[0] * q[0] + UPV[0] * q[1], FW[1] + RT[1] * q[0] + UPV[1] * q[1], FW[2] + RT[2] * q[0] + UPV[2] * q[1]]).map(d => [EYE[0] - d[0] * EYE[1] / d[1], EYE[2] - d[2] * EYE[1] / d[1]])[0]
            let S = first(ships.filter(s => s.id == dg.id))
            dg = merge(dg, {lx: t.x, ly: t.y})
            if S == null || !(S.st == 0 || S.st == 3 || S.st == 4) {
              dg = {k: -1, fid: t.id}
            } else if S.b == -1 || S.b == -3 {
              let L = len(S.p) > 0 ? last(S.p) : [S.x, S.z]
              if ((W[0]) - (L[0])) * ((W[0]) - (L[0])) + ((W[1]) - (L[1])) * ((W[1]) - (L[1])) > 0.1 && len(S.p) < 90 && [[W[0], W[1]]].map(w => w[1] < 5 && w[1] > -23 && abs(w[0]) < 11.5 && !(w[1] > -5.5 && abs(w[0]) > 5.6) && !(w[1] > -5.5 && w[1] < -4.7 && !(abs(w[0]) > 1.5 && abs(w[0]) < 3.9)))[0] {
                let bb = S.out ? null : first(range(6).filter(b => abs(W[0] - BX[b]) < 0.6 && W[1] > 1.7))
                let free = bb != null && BCOL[bb] == S.c && !any(ships, o => o.id != S.id && o.b == bb && o.st != 2)
                let sea = S.out && W[1] < -9.5
                if bb != null && BCOL[bb] != S.c && (gt - msgT > 1.5 || msg != "${BN[S.c]} SHIPS DOCK AT A ${BN[S.c]} BERTH") {
                  msg = "${BN[S.c]} SHIPS DOCK AT A ${BN[S.c]} BERTH"
                  msgT = gt
                }
                if bb != null && BCOL[bb] == S.c && !free && gt - msgT > 1.5 {
                  msg = "THAT BERTH IS BUSY"
                  msgT = gt
                }
                let pts = free ? [[BX[bb], clamp(W[1], 1.7, 2.8)], [BX[bb], BZ]] : sea ? [[W[0], W[1]], [W[0], -25]] : [[W[0], W[1]]]
                ships = ships.map(s => s.id == S.id ? merge(s, {b: free ? bb : sea ? -2 : S.b, p: s.p + pts.map(q => [project([q[0], 0.2, q[1]], CAM, SW, SH)].map(pp => [q[0], q[1], pp.x, pp.y])[0])}) : s)
                if free || sea { haptic("light") }
              }
            }
          }
        }
      }
    }

    // ---- along the top: score, the best, the lifebuoys left ----
    if mode == "play" {
      Column {
        fill: width
        gap: 6
        padding: [10, TOP, 10, 0]
        Row {
          fill: width
          gap: 6
          Column {
            gap: 0
            background: NAVY2
            padding: [0, 0, 0, 4]
            Column {
              gap: 0
              background: NAVY
              padding: [12, 5]
              Text { text: fmtNum(score); font: FONT; fontSize: 22; color: CRM; maxLines: 1 }
              Text { text: "SCORE"; font: FONT; fontSize: 10; color: #8fb3c9 }
            }
          }
          Column {
            gap: 0
            background: NAVY2
            padding: [0, 0, 0, 4]
            Column {
              gap: 0
              background: NAVY
              padding: [12, 5]
              Text { text: fmtNum(best); font: FONT; fontSize: 22; color: CRM; maxLines: 1 }
              Text { text: "BEST"; font: FONT; fontSize: 10; color: #8fb3c9 }
            }
          }
          Spacer { weight: 1 }
          Column {
            gap: 0
            background: NAVY2
            padding: [0, 0, 0, 4]
            Canvas {
              width: 96
              height: 47
              background: NAVY
              for i in range(3) {
                let on = i < 3 - strikes
                circle(20 + i * 28, 23.5, 10, stroke: on ? #ff5a4e : #3a5163, width: 6)
                if on {
                  for a in [45, 135, 225, 315] {
                    arc(20 + i * 28, 23.5, 10, a - 12, 24, stroke: CRM, width: 6)
                  }
                }
              }
            }
          }
          Column {
            gap: 0
            background: YEL2
            padding: [0, 0, 0, 4]
            onTap: mode = "pause"
            Canvas {
              width: 47
              height: 47
              background: YEL
              if mode == "play" {
                rect(16, 14, 5, 19, fill: NAVY)
                rect(26, 14, 5, 19, fill: NAVY)
              } else {
                path([[18, 13], [33, 23.5], [18, 34]], closed: true, fill: NAVY)
              }
            }
          }
        }
        if HINT != "" {
          Text { text: HINT; font: FONT; fontSize: 13; color: NAVY; background: CRM; padding: [10, 6]; maxLines: 2; width: LAND ? 460 : SW - 20 }
        }
      }
    }

    // ---- a new stage's card: the game holds while it's up ----
    if mode == "play" && card > 0 {
      Column {
        fill: true
        align: center
        justify: center
        padding: [20, TOP, 20, INS + 12]
        background: alpha(#05121c, 0.5)
        Column {
          gap: 0
          width: LAND ? 560 : SW - 40
          background: NAVY2
          padding: [0, 0, 0, 5]
          Column {
            gap: LAND ? 7 : 12
            background: NAVY
            padding: LAND ? [20, 12] : [20, 18]
            Text { text: card == 1 ? "WELCOME, HARBOUR MASTER" : "NEW AT THE PORT"; font: FONT; fontSize: 12; color: #8fb3c9 }
            Text { text: CARDS[card - 1].t; font: FONT; fontSize: 30; color: YEL }
            Canvas {
              fill: width
              height: 64
              if card == 1 {
                for i in range(3) {
                  rect(16 + i * 70, 18, 16, 34, fill: BC[i])
                  path([[16 + i * 70, 52], [32 + i * 70, 52], [24 + i * 70, 62]], closed: true, fill: BC[i])
                  rect(44 + i * 70, 10, 16, 50, stroke: BC[i], width: 3)
                }
              } else if card == 2 {
                rect(24, 34, 16, 26, fill: BC[0])
                path([[24, 34], [32, 22], [40, 34]], closed: true, fill: BC[0])
                path([[32, 18], [32, 6], [120, 6]], stroke: BC[0], width: 3.5, cap: round)
                path([[112, 0], [122, 6], [112, 12]], stroke: BC[0], width: 3.5, cap: round)
                rect(150, 30, 34, 14, fill: BC[2])
                path([[184, 30], [196, 37], [184, 44]], closed: true, fill: BC[2])
                path([[146, 37], [110, 37], [100, 56]], stroke: BC[2], width: 3.5, cap: round)
                circle(222, 37, 9, stroke: CRM, width: 2.5)
                line(216, 31, 228, 43, stroke: CRM, width: 2.5)
              } else if card == 99 {
                for i in range(3) {
                  circle(40 + i * 80, 32, 10, fill: FOGC)
                  circle(40 + i * 80, 32, 20, stroke: alpha(CRM, 0.8), width: 2.5)
                  circle(40 + i * 80, 32, 29, stroke: alpha(CRM, 0.35), width: 2)
                }
              } else {
                for i in range(12) { line(10 + i * 22, 6, 18 + i * 22, 30, stroke: alpha(#cfe3f0, 0.8), width: 2) }
                path([[30, 46], [200, 46]], stroke: CRM, width: 3, cap: round)
                path([[190, 39], [202, 46], [190, 53]], stroke: CRM, width: 3, cap: round)
              }
            }
            Text { text: upper(CARDS[card - 1].a); font: FONT; fontSize: 15; color: CRM }
            Text { text: upper(CARDS[card - 1].b); font: FONT; fontSize: 13; color: #8fb3c9 }
            Column {
              gap: 0
              background: YEL2
              padding: [0, 0, 0, 5]
              onTap: {
                taught = max(taught, card - 1)
                card = 0
              }
              Text { text: "GOT IT"; font: FONT; fontSize: 20; color: NAVY; background: YEL; padding: [26, 10]; align: center; fill: width }
            }
          }
        }
      }
    }

    // ---- a word in the middle of the water ----
    if mode == "play" && card == 0 && (hold > 0 || gt - msgT < (len(msg) > 30 ? 3.5 : 2.4)) && msg != "" {
      Column {
        fill: width
        align: center
        padding: [16, SH * 0.27, 16, 0]
        Text { text: msg; font: FONT; fontSize: hold > 0 ? 19 : 17; color: hold > 0 ? CRM : NAVY; background: hold > 0 ? REDC : YEL; padding: [14, 8]; align: center; maxLines: 2 }
      }
    }

    // ---- every lifebuoy lost: what cost each one, then carry on with the score at 0 ----
    if mode == "lost" {
      Column {
        fill: true
        align: center
        justify: center
        gap: LAND ? 8 : 14
        padding: [20, TOP, 20, INS + 12]
        background: alpha(#1a0507, 0.6)
        Text { text: "PORT CLOSED"; font: FONT; fontSize: LAND ? 36 : 44; color: CRM; align: center }
        Text { text: "ALL THREE LIFEBUOYS ARE GONE. THIS IS WHAT HAPPENED:"; font: FONT; fontSize: 13; color: #f0b8b8; align: center }
        Column {
          gap: 0
          width: LAND ? 520 : SW - 40
          background: NAVY2
          padding: [0, 0, 0, 5]
          Column {
            gap: 8
            background: NAVY
            padding: [16, 12]
            for w, i in losses {
              Row {
                gap: 12
                align: center
                Canvas {
                  width: 26
                  height: 26
                  circle(13, 13, 9, stroke: #3a5163, width: 5)
                  line(5, 5, 21, 21, stroke: REDC, width: 3.5, cap: round)
                }
                Text { text: w; font: FONT; fontSize: 14; color: CRM; weight: 1; maxLines: 2 }
              }
            }
          }
        }
        Text { text: "SCORE ${fmtNum(score)} · BEST ${fmtNum(best)}"; font: FONT; fontSize: 16; color: CRM; align: center }
        Column {
          gap: 0
          width: LAND ? 420 : SW - 40
          background: YEL2
          padding: [0, 0, 0, 5]
          onTap: {
            ships = []
            fl = []
            fx = []
            lp = []
            score = 0
            run = 0
            strikes = 0
            losses = []
            spAt = gt + 2
            msg = ""
            msgT = -10
            dg = {k: -2}
            mode = "play"
          }
          Text { text: "CARRY ON"; font: FONT; fontSize: 24; color: NAVY; background: YEL; padding: [34, 12]; align: center }
        }
        Text { text: "THE SCORE STARTS AGAIN FROM 0"; font: FONT; fontSize: 12; color: #8fb3c9; align: center }
      }
    }

    // ---- paused, which is also how the port opens: the name, the score so far, the rules ----
    if mode == "pause" {
      Column {
        fill: true
        align: center
        justify: center
        gap: LAND ? 6 : 14
        padding: [20, TOP, 20, INS + 12]
        background: alpha(#05121c, 0.45)
        if LAND {
          Row {
            gap: 14
            align: center
            Text { text: "HARBOUR"; font: FONT; fontSize: 40; color: CRM }
            Text { text: "MASTER"; font: FONT; fontSize: 40; color: YEL }
          }
        } else {
          Column {
            gap: 0
            align: center
            Text { text: "HARBOUR"; font: FONT; fontSize: 54; color: CRM; align: center }
            Text { text: "MASTER"; font: FONT; fontSize: 54; color: YEL; align: center }
          }
        }
        Text { text: "BRING THEM IN · SEND THEM OUT · NEVER LET THEM TOUCH"; font: FONT; fontSize: 12; color: CRM; align: center }
        Column {
          gap: 0
          width: LAND ? 420 : SW - 40
          background: YEL2
          padding: [0, 0, 0, 5]
          onTap: {
            mode = "play"
            sure = false
          }
          Text { text: nShips > 0 ? "BACK TO THE PORT" : "OPEN THE PORT"; font: FONT; fontSize: 24; color: NAVY; background: YEL; padding: [34, 12]; align: center }
        }
        if nShips > 0 {
          Column {
            gap: 0
            width: LAND ? 420 : SW - 40
            background: NAVY2
            padding: [0, 0, 0, 5]
            onTap: {
              if sure {
                ships = []
                fl = []
                fx = []
                score = 0
                run = 0
                strikes = 0
                losses = []
                lp = []
                hold = 0
                nShips = 0
                nOut = 0
                gt = 0
                spAt = 1.5
                tr = {x: -17, st: 3, t: 5, w: [-1, -1, -1, -1]}
                wx = 0
                wt = -1
                lvl = 0
                msg = ""
                msgT = -10
                dg = {k: -2}
                sure = false
                mode = "play"
              } else {
                sure = true
              }
            }
            Text { text: sure ? "TAP AGAIN: CLEAR THE PORT" : "START OVER"; font: FONT; fontSize: 18; color: sure ? YEL : CRM; background: NAVY; padding: [26, 9]; align: center }
          }
        }
        Row {
          gap: 18
          align: center
          Text { text: nShips > 0 ? "SCORE ${fmtNum(score)} · BEST ${fmtNum(best)}" : "A NEW PORT"; font: FONT; fontSize: 16; color: CRM }
          Text { text: snd ? "SOUND ON" : "SOUND OFF"; font: FONT; fontSize: 16; color: snd ? YEL : #8fb3c9; padding: [6, 4]; onTap: snd = !snd }
        }
        Column {
          gap: LAND ? 3 : 6
          padding: [0, LAND ? 2 : 10, 0, 0]
          Row {
            gap: 10
            align: center
            Canvas { width: 30; height: 16; rect(0, 3, 9, 10, fill: BC[0]); rect(10, 3, 9, 10, fill: BC[1]); rect(20, 3, 9, 10, fill: BC[2]) }
            Text { text: "SHIPS TO A BERTH OF THEIR COLOUR"; font: FONT; fontSize: 12; color: CRM }
          }
          Row {
            gap: 10
            align: center
            Canvas { width: 30; height: 16; path([[4, 14], [15, 3], [26, 14]], stroke: CRM, width: 3.5, cap: round) }
            Text { text: "EMPTY SHIPS: DRAW THEIR WAY OUT TO SEA"; font: FONT; fontSize: 12; color: CRM }
          }
          Row {
            gap: 10
            align: center
            Canvas { width: 30; height: 16; circle(8, 8, 6, stroke: #ff5a4e, width: 4); circle(22, 8, 6, stroke: #ff5a4e, width: 4) }
            Text { text: "A CRASH, OR A SHIP WHOSE RING RUNS OUT BEFORE IT DOCKS, COSTS A LIFEBUOY"; font: FONT; fontSize: 12; color: CRM }
          }
          Row {
            gap: 10
            align: center
            Canvas { width: 30; height: 16; circle(15, 8, 6, stroke: #ff5a4e, width: 4) }
            Text { text: "EVERY 8 SHIPS SENT OUT BRING ONE BACK"; font: FONT; fontSize: 12; color: CRM }
          }
        }
      }
    }
  }
}
