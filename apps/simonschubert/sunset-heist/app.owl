  let TYPES = [
    {name: "compact", len: 3.6, wid: 1.8, top: 30, acc: 28, turn: 1.15, grip: 0.0003, drift: 0.35, armor: 1, r: 1.8},
    {name: "sedan", len: 4.2, wid: 2, top: 34, acc: 26, turn: 1, grip: 0.0004, drift: 0.3, armor: 1, r: 2},
