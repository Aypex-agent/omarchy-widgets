app "sunset heist" {
  meta { owl: 23; description: "A sunny city by the sea, seen from above: drive, get out, take any car, race rivals, chase down cars and run missions for cash, jump the ramps and shake off the police"; version: "1.6"; license: "MIT"; category: "games" }
  // How it works: the city is made from a seed in lets, 12 by 16 cells of 32 units, each a block with
  // roads along its edges, and a kind: docks on the north shore, a canal across the middle, hotels on the
  // beach, houses in the south, towers downtown and a few landmarks. Only the cells around the camera are drawn. Two scenes share one camera: the
  // ground first, so nothing on it is ever sorted under it, then everything that stands on it. Traffic
  // drives on the right along the road grid and picks a turn at each corner; the police drive straight
  // at you and slide along buildings. The stick comes from onTouch: wherever a thumb goes down,
  // pushed the way to drive or walk.
  title: ""
  statusBar: false
  edge: true
  fps: mode == "play" ? 60 : modes.saver ? 15 : 30
  source modes = android.modes
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#8fd0ec"/>
    <path d="M0 176H256V200A56 56 0 0 1 200 256H56A56 56 0 0 1 0 200Z" fill="#2a9cb8"/>
    <path d="M30 176V96H74V176ZM86 176V60H128V176ZM140 176V112H176V176Z" fill="#e8dcc4"/>
    <path d="M74 176V96H82V176ZM128 176V60H136V176ZM176 176V112H184V176Z" fill="#b8ab92"/>
    <path d="M38 108H66M38 124H66M38 140H66M94 74H120M94 90H120M94 106H120M94 122H120M148 124H168M148 140H168" stroke="#5f86a8" stroke-width="7"/>
    <path d="M196 176C196 132 206 112 222 98" stroke="#7a5a3a" stroke-width="7" fill="none"/>
    <path d="M222 98C200 92 186 100 180 110M222 98C240 86 252 92 256 100M222 98C226 80 220 70 208 66" stroke="#2f8f6f" stroke-width="9" fill="none" stroke-linecap="round"/>
    <path d="M150 206H214L206 224H158Z" fill="#d23a32"/>
  </svg>"""

  asset roadTex = base64""
  asset parkTex = base64""
  asset beachTex = base64""
  asset facadeTex = base64""
  asset glowTex = base64""
  asset beamTex = base64""
  asset roofTex = base64""
  asset heliTex = base64""
  asset seaTex = base64""
  asset docksTex = base64""
  asset lawnTex = base64""
  asset plazaTex = base64""
  asset dirtTex = base64""
  asset canalTex = base64""
  asset canalBeachTex = base64""
  asset poolTex = base64""
  asset courtTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAABACAYAAAB7jnWuAAAAmklEQVR42u3ZwQ2AIAxAUQZjFAdxJidxHC6cMR3A2EJJwfxDg4kEXxooiimfVyulNmnfQu7fRzaFZkxpk1xERgrPAAAAAAAA0AJ6wg0wIwAAAAAAgAtAU/PdASMb0DDg6yEWhBmgHdzSzwywpncPwDZfxz0rhTnwr2UYXoiWKMVLbEa8DwAAAABACCD8kIpzQgAAAADg5/XMDDyu2eBnP1wGLQAAAABJRU5ErkJggg=="
  asset ribTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAYAAAB3AH1ZAAAAL0lEQVR42mOIikj5P5CYAUS8fv0BjFet2EZX9qgDRh0w6oBRB4w6YNQBg8cBA4kBAQqHMyW8ENMAAAAASUVORK5CYII="
  asset edgeWTex = base64"iVBORw0KGgoAAAANSUhEUgAAABIAAACAAgMAAAB7DtGMAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAKUlEQVQoz2NgGEAgACUXAAEyyYCFJMYcYkly3TlqPvHmo8cptvgdBAAAMl8gwboHYqAAAAAASUVORK5CYII="
  asset edgeNTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbq6uTqwDKjP0pLAAAAJUlEQVQoz2NgAAHWUAYMEBqAxCGogHIw6obB4waCYBUQYcEgAACv3w9HszkBfQAAAABJRU5ErkJggg=="
  asset edgeSTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAIUlEQVQoz2NgAIFQIMKCSQBcqzDFVi0gRQHlYNQNg8ENAI11E5i/YrZnAAAAAElFTkSuQmCC"
  asset skidTex = base64"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAIElEQVR42mMQEZJgAOITaJgBB8ZQxzBqwKgBowYMFwMArEiiAW6IzpwAAAAASUVORK5CYII="
  // Sounds from Google's sound library (actions.google.com/sounds, CC BY 4.0), trimmed and made
  // mono Opus to fit in the file: car door closing, car horn, crash, emergency siren short burst, bugle tune,
  // deflate, loose change on wood and slide whistle to drum.
  asset S_DOOR = base64""
  asset S_HORN = base64""
  asset S_CRASH = base64""
  asset S_SIREN = base64""
  asset S_PASS = base64""
  asset S_FAIL = base64""
  asset S_CASH = base64""
  asset S_DOWN = base64""

  strings {
    en {
      // The mission spots, in GIVERS' order: its name and subtitle (shown in capitals in a tall condensed font,
      // also over its spot on the map), what it pays, and what to do (a paragraph on the mission card).
      givers: [
        {name: "street race", sub: "harbor run", pay: "up to $500", goal: "Beat three racers round the harbor. Drive through every checkpoint; the first back to the start wins."},
        {name: "street race", sub: "canal circuit", pay: "up to $500", goal: "Beat three racers over the canal bridges and round the suburbs. Drive through every checkpoint; the first back wins."},
        {name: "takedown", sub: "for the precinct", pay: "$350", goal: "A red sports car is on the run. Catch it and ram it until it's wrecked, within 2:30, before it gets away."},
        {name: "getaway", sub: "hot car", pay: "$500", goal: "Take the hot car with three stars on it, lose the police, and drive it into the garage with no stars left."},
        {name: "stunt tour", sub: "three ramps", pay: "$150 a jump", goal: "Land a jump off each marked ramp in turn within 2:30. Hit it fast, the way its stripes point."},
        {name: "fragile cargo", sub: "champagne", pay: "up to $450", goal: "Drive a crate of champagne across town before the clock runs out. Every knock breaks bottles, and the pay drops."},
        {name: "courier", sub: "three drops", pay: "$80 a drop", goal: "Take three parcels, one after another, each to its door before the clock runs out."}
      ]
      // Car types, in TYPES' order: in capitals on a 220 dp button ("take the ..."), in the HUD and as a message.
      cars: ["compact", "sedan", "sports car", "muscle car", "van", "box truck", "motorbike", "supercar", "gran turismo", "police car"]
      // The guns, on a 150 dp button with the ammo after them.
      guns: ["pistol", "SMG", "shotgun"]
      // The running mission's two lines under its name, in capitals; m is metres to go, t a time like 1:05.
      getReady: "get ready"
      checkpoint: (i, n, m) => "checkpoint ${i} of ${n} · ${m} m"
      ramRed: m => "ram the red car · ${m} m"
      losePolice: "lose the police"
      intoGarage: m => "into the garage · ${m} m"
      rampOf: (i, m) => "ramp ${i} of 3 · ${m} m"
      deliverChamp: m => "deliver the champagne · ${m} m"
      parcelOf: (i, m) => "parcel ${i} of 3 · ${m} m"
      onGrid: "on the grid"
      place: (p, t) => p == 1 ? "1st place · ${t}" : p == 2 ? "2nd place · ${t}" : p == 3 ? "3rd place · ${t}" : "4th place · ${t}"
      itsCar: (pct, t) => "its car ${pct}% · ${t} left"
      starsDrop: "out of their sight the stars drop"
      noStars: "no stars on you · keep it that way"
      rampFast: t => "drive up the ramp fast · ${t} left"
      cargoLeft: (pct, t) => "cargo ${pct}% · ${t} left"
      timeLeft: t => "${t} left"
      // The HUD, top left, already in capitals.
      missions: "MISSIONS"
      doneTap: (d, n) => "${d} OF ${n} DONE · TAP FOR THE LIST"
      distTap: m => "${m} M · TAP FOR THE LIST"
      quit: "QUIT"
      // The countdown's last word, huge, and the line under it.
      go: "GO"
      beFirst: "BE FIRST BACK TO THE START"
      // Messages in the middle of the screen, in capitals: the part before the first " · " big, each part after it
      // on a line of its own. One that starts with wastedWord, bustedWord, wrecked or failedWord shows in red, so
      // those messages must start with exactly that word.
      wastedWord: "wasted"; bustedWord: "busted"; failedWord: "failed"
      stunt: (m, b) => "stunt · ${m} m · +$${b}"
      busted: n => "busted · -$${n}"
      wrecked: "wrecked"
      health: "+ health"; armor: "+ armor"
      wasted: n => "wasted · -$${n}"
      drowned: n => "wasted · drowned · -$${n}"
      raceEnd: (p, t) => p == 1 ? "1st place · ${t}" : p == 2 ? "2nd place · ${t}" : p == 3 ? "3rd place · ${t}" : "failed · 4th place · ${t}"
      newBest: "new best"
      targetDown: "target down · +$350"
      hitCar: n => "hit · its car ${n}%"
      gotAway: "failed · it got away"
      cleanGetaway: "clean getaway · +$500"
      stillOnYou: "they're still on you · lose them first"
      stuntDone: "stunt tour done · +$550"
      jumpOf: i => "jump ${i} of 3 · +$150 · on to the next ramp"
      champBroken: "failed · the champagne's all broken"
      delivered: (pct, n) => "delivered · ${pct}% whole · +$${n}"
      allThree: n => "all three delivered · +$${n}"
      parcelDone: i => "parcel ${i} delivered · +$80 · on to the next"
      lostCar: "failed · you lost the car"
      outOfTime: "failed · out of time"
      freshPaint: "fresh paint · they've lost you"
      gaveUp: "failed · you gave up"
      startTakedown: "takedown · catch the red car · ram it till it's wrecked"
      startGetaway: "getaway · lose the police · then into the garage"
      startStunt: "stunt tour · follow the arrows to the ramp · hit it fast"
      startCargo: "fragile cargo · drive gently · every knock breaks bottles"
      startCourier: "courier · three parcels · follow the arrows"
      // Buttons, in capitals: GET OUT 150 dp wide, take/get in 220 dp, BRAKE and FIRE in a 92 dp circle.
      getOut: "GET OUT"
      take: car => "take the ${car}"
      getIn: car => "get in the ${car}"
      brake: "BRAKE"; fire: "FIRE"
      // Read out for the fist on the attack button.
      punch: "punch"
      // The mission card and the list, small and green under the goal.
      pays: p => "pays ${p}"
      donePays: p => "done · again, it pays ${p}"
      yourBest: t => "your best ${t}"
      getCarFirst: "GET A CAR FIRST"; start: "START"
      doneOf: (d, n) => "${d} OF ${n} DONE"
      back: "BACK"
      pickHelp: "Pick one, and the arrows on the road and on the map lead you to it. Drive into its marker to see what to do and start."
      soundOn: "SOUND ON"; soundOff: "SOUND OFF"
      metres: m => "${m} M"
      // The title screen: the cash saved ("$00001200"), the two lines of how to play and the big button.
      saved: cash => "${cash} SAVED"
      howDrive: "touch anywhere and push the way you want to drive"
      howPlay: "get out anywhere and take any car · pick a mission from the list or drive into a marker · jump the ramps · lose the police at the paint shop"
      tapToDrive: "TAP TO DRIVE"
      // Over the game at the start, big; and the unit under the speed.
      touchHint: "TOUCH ANYWHERE AND PUSH THE WAY TO GO"
      kmh: "KM/H"
    }
    id {
      givers: [
        {name: "balap jalanan", sub: "putaran pelabuhan", pay: "hingga $500", goal: "Kalahkan tiga pembalap mengelilingi pelabuhan. Lewati setiap checkpoint; yang pertama kembali ke start menang."},
        {name: "balap jalanan", sub: "sirkuit kanal", pay: "hingga $500", goal: "Kalahkan tiga pembalap melewati jembatan kanal dan pinggiran kota. Lewati setiap checkpoint; yang pertama kembali menang."},
        {name: "penyergapan", sub: "untuk kantor polisi", pay: "$350", goal: "Sebuah mobil sport merah sedang kabur. Kejar dan tabrak sampai hancur, dalam 2:30, sebelum dia lolos."},
        {name: "pelarian", sub: "mobil panas", pay: "$500", goal: "Ambil mobil panas dengan tiga bintang, lolos dari polisi, lalu bawa ke garasi tanpa bintang tersisa."},
        {name: "tur stunt", sub: "tiga ramp", pay: "$150 per lompatan", goal: "Melompatlah dari setiap ramp bertanda secara berurutan dalam 2:30. Naiki dengan cepat, searah garisnya."},
        {name: "kargo rapuh", sub: "sampanye", pay: "hingga $450", goal: "Bawa satu peti sampanye melintasi kota sebelum waktu habis. Setiap benturan memecahkan botol, dan bayarannya turun."},
        {name: "kurir", sub: "tiga antaran", pay: "$80 per antaran", goal: "Antar tiga paket, satu demi satu, masing-masing ke pintunya sebelum waktu habis."}
      ]
      cars: ["mobil kecil", "sedan", "mobil sport", "muscle car", "van", "truk boks", "motor", "supercar", "gran turismo", "mobil polisi"]
      guns: ["pistol", "SMG", "shotgun"]
      getReady: "bersiap"
      checkpoint: (i, n, m) => "checkpoint ${i} dari ${n} · ${m} m"
      ramRed: m => "tabrak mobil merah · ${m} m"
      losePolice: "lolos dari polisi"
      intoGarage: m => "masuk garasi · ${m} m"
      rampOf: (i, m) => "ramp ${i} dari 3 · ${m} m"
      deliverChamp: m => "antar sampanye · ${m} m"
      parcelOf: (i, m) => "paket ${i} dari 3 · ${m} m"
      onGrid: "di garis start"
      place: (p, t) => "posisi ${p} · ${t}"
      itsCar: (pct, t) => "mobilnya ${pct}% · sisa ${t}"
      starsDrop: "di luar pandangan mereka bintang turun"
      noStars: "tanpa bintang · pertahankan"
      rampFast: t => "naik ramp dengan cepat · sisa ${t}"
      cargoLeft: (pct, t) => "kargo ${pct}% · sisa ${t}"
      timeLeft: t => "sisa ${t}"
      missions: "MISI"
      doneTap: (d, n) => "${d} DARI ${n} SELESAI · KETUK UNTUK DAFTAR"
      distTap: m => "${m} M · KETUK UNTUK DAFTAR"
      quit: "BATAL"
      go: "JALAN"
      beFirst: "JADILAH YANG PERTAMA KEMBALI KE START"
      wastedWord: "tewas"; bustedWord: "tertangkap"; failedWord: "gagal"
      stunt: (m, b) => "stunt · ${m} m · +$${b}"
      busted: n => "tertangkap · -$${n}"
      wrecked: "hancur"
      health: "+ kesehatan"; armor: "+ zirah"
      wasted: n => "tewas · -$${n}"
      drowned: n => "tewas · tenggelam · -$${n}"
      raceEnd: (p, t) => p <= 3 ? "posisi ${p} · ${t}" : "gagal · posisi 4 · ${t}"
      newBest: "rekor baru"
      targetDown: "target lumpuh · +$350"
      hitCar: n => "kena · mobilnya ${n}%"
      gotAway: "gagal · dia lolos"
      cleanGetaway: "pelarian bersih · +$500"
      stillOnYou: "mereka masih mengejar · lolos dulu"
      stuntDone: "tur stunt selesai · +$550"
      jumpOf: i => "lompatan ${i} dari 3 · +$150 · lanjut ke ramp berikutnya"
      champBroken: "gagal · sampanyenya pecah semua"
      delivered: (pct, n) => "terantar · ${pct}% utuh · +$${n}"
      allThree: n => "ketiganya terantar · +$${n}"
      parcelDone: i => "paket ${i} terantar · +$80 · lanjut ke berikutnya"
      lostCar: "gagal · mobilnya hilang"
      outOfTime: "gagal · waktu habis"
      freshPaint: "cat baru · mereka kehilangan jejakmu"
      gaveUp: "gagal · kamu menyerah"
      startTakedown: "penyergapan · kejar mobil merah · tabrak sampai hancur"
      startGetaway: "pelarian · lolos dari polisi · lalu ke garasi"
      startStunt: "tur stunt · ikuti panah ke ramp · naiki dengan cepat"
      startCargo: "kargo rapuh · menyetir pelan · tiap benturan memecahkan botol"
      startCourier: "kurir · tiga paket · ikuti panahnya"
      getOut: "KELUAR"
      take: car => "ambil ${car}"
      getIn: car => "naik ${car}"
      brake: "REM"; fire: "TEMBAK"
      punch: "pukul"
      pays: p => "bayaran ${p}"
      donePays: p => "selesai · main lagi, bayaran ${p}"
      yourBest: t => "terbaikmu ${t}"
      getCarFirst: "CARI MOBIL DULU"; start: "MULAI"
      doneOf: (d, n) => "${d} DARI ${n} SELESAI"
      back: "KEMBALI"
      pickHelp: "Pilih satu, dan panah di jalan dan di peta menuntunmu ke sana. Masuk ke penandanya untuk melihat tugasnya dan mulai."
      soundOn: "SUARA NYALA"; soundOff: "SUARA MATI"
      metres: m => "${m} M"
      saved: cash => "${cash} TERSIMPAN"
      howDrive: "sentuh di mana saja dan dorong ke arah yang kamu mau"
      howPlay: "keluar di mana saja dan ambil mobil apa pun · pilih misi dari daftar atau masuk ke penanda · lompati ramp · lolos dari polisi di bengkel cat"
      tapToDrive: "KETUK UNTUK MENYETIR"
      touchHint: "SENTUH DI MANA SAJA DAN DORONG KE ARAH TUJUAN"
      kmh: "KM/J"
    }
    es {
      givers: [
        {name: "carrera callejera", sub: "vuelta al puerto", pay: "hasta $500", goal: "Gana a tres pilotos alrededor del puerto. Pasa por cada control; el primero en volver a la salida gana."},
        {name: "carrera callejera", sub: "circuito del canal", pay: "hasta $500", goal: "Gana a tres pilotos por los puentes del canal y las afueras. Pasa por cada control; el primero en volver gana."},
        {name: "derribo", sub: "para la comisaría", pay: "$350", goal: "Un deportivo rojo está huyendo. Alcánzalo y embístelo hasta destrozarlo, en 2:30, antes de que escape."},
        {name: "fuga", sub: "coche robado", pay: "$500", goal: "Toma el coche robado con tres estrellas, despista a la policía y mételo en el garaje sin estrellas."},
        {name: "ruta de saltos", sub: "tres rampas", pay: "$150 por salto", goal: "Salta desde cada rampa marcada, en orden, en 2:30. Entra rápido, hacia donde apuntan sus franjas."},
        {name: "carga frágil", sub: "champán", pay: "hasta $450", goal: "Lleva una caja de champán al otro lado de la ciudad antes de que se acabe el tiempo. Cada golpe rompe botellas y baja la paga."},
        {name: "mensajero", sub: "tres entregas", pay: "$80 por entrega", goal: "Lleva tres paquetes, uno tras otro, cada uno a su puerta antes de que se acabe el tiempo."}
      ]
      cars: ["compacto", "sedán", "deportivo", "muscle car", "furgoneta", "camión", "moto", "superdeportivo", "gran turismo", "patrulla"]
      guns: ["pistola", "subfusil", "escopeta"]
      getReady: "prepárate"
      checkpoint: (i, n, m) => "control ${i} de ${n} · ${m} m"
      ramRed: m => "embiste el coche rojo · ${m} m"
      losePolice: "despista a la policía"
      intoGarage: m => "al garaje · ${m} m"
      rampOf: (i, m) => "rampa ${i} de 3 · ${m} m"
      deliverChamp: m => "entrega el champán · ${m} m"
      parcelOf: (i, m) => "paquete ${i} de 3 · ${m} m"
      onGrid: "en la parrilla"
      place: (p, t) => "${p}.º puesto · ${t}"
      itsCar: (pct, t) => "su coche ${pct}% · quedan ${t}"
      starsDrop: "si no te ven, bajan las estrellas"
      noStars: "sin estrellas · sigue así"
      rampFast: t => "sube la rampa rápido · quedan ${t}"
      cargoLeft: (pct, t) => "carga ${pct}% · quedan ${t}"
      timeLeft: t => "quedan ${t}"
      missions: "MISIONES"
      doneTap: (d, n) => "${d} DE ${n} HECHAS · TOCA PARA LA LISTA"
      distTap: m => "${m} M · TOCA PARA LA LISTA"
      quit: "RENDIRSE"
      go: "YA"
      beFirst: "SÉ EL PRIMERO EN VOLVER A LA SALIDA"
      wastedWord: "muerto"; bustedWord: "arrestado"; failedWord: "fallaste"
      stunt: (m, b) => "salto · ${m} m · +$${b}"
      busted: n => "arrestado · -$${n}"
      wrecked: "destrozado"
      health: "+ salud"; armor: "+ blindaje"
      wasted: n => "muerto · -$${n}"
      drowned: n => "muerto · ahogado · -$${n}"
      raceEnd: (p, t) => p <= 3 ? "${p}.º puesto · ${t}" : "fallaste · 4.º puesto · ${t}"
      newBest: "nuevo récord"
      targetDown: "objetivo abatido · +$350"
      hitCar: n => "golpe · su coche ${n}%"
      gotAway: "fallaste · se escapó"
      cleanGetaway: "fuga limpia · +$500"
      stillOnYou: "aún te siguen · despístalos primero"
      stuntDone: "ruta de saltos hecha · +$550"
      jumpOf: i => "salto ${i} de 3 · +$150 · a la siguiente rampa"
      champBroken: "fallaste · se rompió todo el champán"
      delivered: (pct, n) => "entregado · ${pct}% intacto · +$${n}"
      allThree: n => "los tres entregados · +$${n}"
      parcelDone: i => "paquete ${i} entregado · +$80 · al siguiente"
      lostCar: "fallaste · perdiste el coche"
      outOfTime: "fallaste · se acabó el tiempo"
      freshPaint: "pintura nueva · te perdieron"
      gaveUp: "fallaste · te rendiste"
      startTakedown: "derribo · alcanza el coche rojo · embístelo hasta destrozarlo"
      startGetaway: "fuga · despista a la policía · luego al garaje"
      startStunt: "ruta de saltos · sigue las flechas a la rampa · entra rápido"
      startCargo: "carga frágil · conduce con cuidado · cada golpe rompe botellas"
      startCourier: "mensajero · tres paquetes · sigue las flechas"
      getOut: "BAJAR"
      take: car => "tomar: ${car}"
      getIn: car => "subir: ${car}"
      brake: "FRENO"; fire: "FUEGO"
      punch: "puñetazo"
      pays: p => "paga ${p}"
      donePays: p => "hecha · otra vez, paga ${p}"
      yourBest: t => "tu récord ${t}"
      getCarFirst: "CONSIGUE UN COCHE"; start: "EMPEZAR"
      doneOf: (d, n) => "${d} DE ${n} HECHAS"
      back: "VOLVER"
      pickHelp: "Elige una, y las flechas en la calle y en el mapa te llevan hasta ella. Entra en su marcador para ver qué hacer y empezar."
      soundOn: "SONIDO SÍ"; soundOff: "SONIDO NO"
      metres: m => "${m} M"
      saved: cash => "${cash} AHORRADOS"
      howDrive: "toca donde quieras y empuja hacia donde quieras conducir"
      howPlay: "bájate donde quieras y toma cualquier coche · elige una misión de la lista o entra en un marcador · salta las rampas · despista a la policía en el taller de pintura"
      tapToDrive: "TOCA PARA CONDUCIR"
      touchHint: "TOCA DONDE QUIERAS Y EMPUJA HACIA DONDE IR"
      kmh: "KM/H"
    }
    pt {
      givers: [
        {name: "racha de rua", sub: "volta do porto", pay: "até $500", goal: "Vença três pilotos ao redor do porto. Passe por todos os checkpoints; o primeiro a voltar à largada vence."},
        {name: "racha de rua", sub: "circuito do canal", pay: "até $500", goal: "Vença três pilotos pelas pontes do canal e pelos subúrbios. Passe por todos os checkpoints; o primeiro a voltar vence."},
        {name: "abate", sub: "para a delegacia", pay: "$350", goal: "Um esportivo vermelho está fugindo. Alcance e bata nele até destruí-lo, em 2:30, antes que ele escape."},
        {name: "fuga", sub: "carro quente", pay: "$500", goal: "Pegue o carro quente com três estrelas, despiste a polícia e leve-o para a garagem sem nenhuma estrela."},
        {name: "tour de saltos", sub: "três rampas", pay: "$150 por salto", goal: "Salte de cada rampa marcada, em ordem, em 2:30. Entre rápido, na direção das listras."},
        {name: "carga frágil", sub: "champanhe", pay: "até $450", goal: "Leve uma caixa de champanhe pela cidade antes que o tempo acabe. Cada batida quebra garrafas, e o pagamento cai."},
        {name: "entregador", sub: "três entregas", pay: "$80 por entrega", goal: "Leve três pacotes, um depois do outro, cada um até a porta antes que o tempo acabe."}
      ]
