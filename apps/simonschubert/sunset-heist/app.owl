    zh {
      givers: [
        {name: "街头赛车", sub: "港口赛道", pay: "最多 $500", goal: "绕港口击败三名车手。穿过每个检查点，第一个回到起点的获胜。"},
        {name: "街头赛车", sub: "运河赛道", pay: "最多 $500", goal: "越过运河桥、绕过郊区，击败三名车手。穿过每个检查点，第一个回来的获胜。"},
        {name: "拦截", sub: "替警局出手", pay: "$350", goal: "一辆红色跑车正在逃跑。在 2:30 内追上它，一直撞到它报废，别让它跑掉。"},
        {name: "逃脱", sub: "赃车", pay: "$500", goal: "开走带三颗星的赃车，甩掉警察，等星星全没了再把它开进车库。"},
        {name: "特技之旅", sub: "三个跳台", pay: "每跳 $150", goal: "在 2:30 内依次从每个标记的跳台起跳。顺着条纹的方向，高速冲上去。"},
        {name: "易碎货物", sub: "香槟", pay: "最多 $450", goal: "在时间用完前把一箱香槟运到城市另一头。每次碰撞都会打碎酒瓶，报酬也随之减少。"},
        {name: "快递员", sub: "三次投递", pay: "每次 $80", goal: "在时间用完前，把三个包裹依次送到各自的门口。"}
