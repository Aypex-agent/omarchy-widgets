      startStunt: "akrobasi turu · okları izleyip rampaya git · hızlı gir"
      startCargo: "kırılacak yük · yavaş sür · her darbe şişe kırar"
      startCourier: "kurye · üç paket · okları izle"
      getOut: "İN"
      take: car => "al: ${car}"
      getIn: car => "bin: ${car}"
      brake: "FREN"; fire: "ATEŞ"
      punch: "yumruk"
      pays: p => "ödeme ${p}"
      donePays: p => "bitti · tekrar, ödeme ${p}"
      yourBest: t => "en iyin ${t}"
      getCarFirst: "ÖNCE BİR ARABA BUL"; start: "BAŞLA"
      doneOf: (d, n) => "${d}/${n} BİTTİ"
      back: "GERİ"
      pickHelp: "Birini seç; yoldaki ve haritadaki oklar seni oraya götürür. Ne yapacağını görüp başlamak için işaretine gir."
      soundOn: "SES AÇIK"; soundOff: "SES KAPALI"
      metres: m => "${m} M"
