    de {
      givers: [
        {name: "straßenrennen", sub: "hafenrunde", pay: "bis zu $500", goal: "Schlag drei Fahrer rund um den Hafen. Fahr durch jeden Checkpoint; wer zuerst zurück am Start ist, gewinnt."},
        {name: "straßenrennen", sub: "kanalkurs", pay: "bis zu $500", goal: "Schlag drei Fahrer über die Kanalbrücken und durch die Vororte. Fahr durch jeden Checkpoint; wer zuerst zurück ist, gewinnt."},
        {name: "takedown", sub: "fürs revier", pay: "$350", goal: "Ein roter Sportwagen ist auf der Flucht. Hol ihn ein und ramm ihn, bis er Schrott ist, in 2:30, bevor er entkommt."},
        {name: "flucht", sub: "heißer wagen", pay: "$500", goal: "Schnapp dir den heißen Wagen mit drei Sternen, häng die Polizei ab und fahr ihn ohne Sterne in die Garage."},
        {name: "stunt-tour", sub: "drei rampen", pay: "$150 pro sprung", goal: "Spring der Reihe nach von jeder markierten Rampe, in 2:30. Fahr schnell drauf, in Richtung ihrer Streifen."},
        {name: "zerbrechliche fracht", sub: "champagner", pay: "bis zu $450", goal: "Bring eine Kiste Champagner quer durch die Stadt, bevor die Zeit abläuft. Jeder Stoß zerbricht Flaschen, und die Bezahlung sinkt."},
        {name: "kurier", sub: "drei lieferungen", pay: "$80 pro lieferung", goal: "Bring drei Pakete, eins nach dem anderen, jedes an seine Tür, bevor die Zeit abläuft."}
      ]
