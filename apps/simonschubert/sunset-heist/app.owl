      pickHelp: "Choisis-en une, et les flèches sur la route et sur la carte t'y mènent. Entre dans son marqueur pour voir quoi faire et commencer."
      soundOn: "SON ACTIVÉ"; soundOff: "SON COUPÉ"
      metres: m => "${m} M"
      saved: cash => "${cash} ÉCONOMISÉS"
      howDrive: "touche n'importe où et pousse dans la direction où tu veux rouler"
      howPlay: "descends n'importe où et prends n'importe quelle voiture · choisis une mission dans la liste ou entre dans un marqueur · saute les tremplins · sème la police à l'atelier de peinture"
      tapToDrive: "TOUCHE POUR ROULER"
      touchHint: "TOUCHE N'IMPORTE OÙ ET POUSSE VERS OÙ ALLER"
      kmh: "KM/H"
    }
    tr {
      givers: [
        {name: "sokak yarışı", sub: "liman turu", pay: "en fazla $500", goal: "Limanın çevresinde üç yarışçıyı yen. Her kontrol noktasından geç; başlangıca ilk dönen kazanır."},
        {name: "sokak yarışı", sub: "kanal pisti", pay: "en fazla $500", goal: "Kanal köprülerinden geçip banliyöleri dolaşarak üç yarışçıyı yen. Her kontrol noktasından geç; ilk dönen kazanır."},
        {name: "takip", sub: "karakol için", pay: "$350", goal: "Kırmızı bir spor araba kaçıyor. 2:30 içinde onu yakala ve kaçmadan hurdaya dönene kadar çarp."},
        {name: "kaçış", sub: "sıcak araba", pay: "$500", goal: "Üç yıldızlı sıcak arabayı al, polisi ekip at ve hiç yıldız kalmadan onu garaja sok."},
        {name: "akrobasi turu", sub: "üç rampa", pay: "atlayış başı $150", goal: "2:30 içinde işaretli her rampadan sırayla atla. Hızlı gir, şeritlerin gösterdiği yönde."},
        {name: "kırılacak yük", sub: "şampanya", pay: "en fazla $450", goal: "Süre dolmadan bir kasa şampanyayı şehrin öbür ucuna götür. Her darbe şişe kırar ve ödeme düşer."},
        {name: "kurye", sub: "üç teslimat", pay: "teslimat başı $80", goal: "Süre dolmadan üç paketi birbiri ardına, her birini kendi kapısına götür."}
      ]
      cars: ["küçük araba", "sedan", "spor araba", "muscle car", "minibüs", "kamyon", "motosiklet", "süper araba", "gran turismo", "polis arabası"]
      guns: ["tabanca", "SMG", "pompalı"]
      getReady: "hazırlan"
      checkpoint: (i, n, m) => "kontrol noktası ${i}/${n} · ${m} m"
      ramRed: m => "kırmızı arabaya çarp · ${m} m"
      losePolice: "polisi ekip at"
