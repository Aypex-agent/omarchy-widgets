      stillOnYou: "hâlâ peşindeler · önce onları ekip at"
      stuntDone: "akrobasi turu bitti · +$550"
      jumpOf: i => "atlayış ${i}/3 · +$150 · sıradaki rampaya"
      champBroken: "başarısız · şampanyanın hepsi kırıldı"
      delivered: (pct, n) => "teslim edildi · %${pct} sağlam · +$${n}"
      allThree: n => "üçü de teslim edildi · +$${n}"
      parcelDone: i => "paket ${i} teslim edildi · +$80 · sıradakine"
      lostCar: "başarısız · arabayı kaybettin"
