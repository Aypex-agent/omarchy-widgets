      howPlay: "her yerde in ve istediğin arabayı al · listeden görev seç ya da bir işarete gir · rampalardan atla · polisi boyacıda ekip at"
      tapToDrive: "SÜRMEK İÇİN DOKUN"
      touchHint: "HERHANGİ BİR YERE DOKUN VE GİDECEĞİN YÖNE İT"
      kmh: "KM/S"
    }
    it {
      givers: [
        {name: "corsa clandestina", sub: "giro del porto", pay: "fino a $500", goal: "Batti tre piloti intorno al porto. Passa da ogni checkpoint; chi torna per primo al via vince."},
        {name: "corsa clandestina", sub: "circuito del canale", pay: "fino a $500", goal: "Batti tre piloti sui ponti del canale e per la periferia. Passa da ogni checkpoint; chi torna per primo vince."},
        {name: "inseguimento", sub: "per il distretto", pay: "$350", goal: "Un'auto sportiva rossa è in fuga. Raggiungila e speronala finché non è distrutta, entro 2:30, prima che scappi."},
        {name: "fuga", sub: "auto che scotta", pay: "$500", goal: "Prendi l'auto che scotta con tre stelle, semina la polizia e portala in garage senza più stelle."},
        {name: "tour acrobatico", sub: "tre rampe", pay: "$150 a salto", goal: "Salta da ogni rampa segnata, in ordine, entro 2:30. Prendila veloce, nel verso delle strisce."},
        {name: "carico fragile", sub: "champagne", pay: "fino a $450", goal: "Porta una cassa di champagne dall'altra parte della città prima che scada il tempo. Ogni urto rompe bottiglie, e la paga scende."},
        {name: "corriere", sub: "tre consegne", pay: "$80 a consegna", goal: "Porta tre pacchi, uno dopo l'altro, ognuno alla sua porta prima che scada il tempo."}
      ]
      cars: ["utilitaria", "berlina", "sportiva", "muscle car", "furgone", "camion", "moto", "supercar", "gran turismo", "volante"]
      guns: ["pistola", "mitra", "fucile"]
      getReady: "preparati"
      checkpoint: (i, n, m) => "checkpoint ${i} di ${n} · ${m} m"
      ramRed: m => "sperona l'auto rossa · ${m} m"
      losePolice: "semina la polizia"
      intoGarage: m => "in garage · ${m} m"
      rampOf: (i, m) => "rampa ${i} di 3 · ${m} m"
      deliverChamp: m => "consegna lo champagne · ${m} m"
      parcelOf: (i, m) => "pacco ${i} di 3 · ${m} m"
      onGrid: "in griglia"
      place: (p, t) => "${p}° posto · ${t}"
      itsCar: (pct, t) => "la sua auto ${pct}% · mancano ${t}"
      starsDrop: "fuori dalla loro vista le stelle calano"
