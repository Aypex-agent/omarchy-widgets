    ru {
      givers: [
        {name: "уличная гонка", sub: "портовый круг", pay: "до $500", goal: "Обгоните трёх гонщиков вокруг гавани. Проезжайте каждый чекпоинт; кто первым вернётся на старт, тот и победил."},
        {name: "уличная гонка", sub: "канальная трасса", pay: "до $500", goal: "Обгоните трёх гонщиков через мосты канала и по окраинам. Проезжайте каждый чекпоинт; кто первым вернётся, тот и победил."},
        {name: "перехват", sub: "для участка", pay: "$350", goal: "Красный спорткар скрывается. Догоните и тараньте его, пока он не разобьётся, за 2:30, пока он не ушёл."},
        {name: "побег", sub: "горячая тачка", pay: "$500", goal: "Возьмите горячую тачку с тремя звёздами, оторвитесь от полиции и загоните её в гараж без звёзд."},
        {name: "трюк-тур", sub: "три трамплина", pay: "$150 за прыжок", goal: "Прыгните с каждого отмеченного трамплина по очереди за 2:30. Заезжайте быстро, по направлению полос."},
        {name: "хрупкий груз", sub: "шампанское", pay: "до $450", goal: "Довезите ящик шампанского через город, пока не вышло время. Каждый удар бьёт бутылки, и оплата падает."},
