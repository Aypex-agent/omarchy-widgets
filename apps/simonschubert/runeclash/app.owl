app "runeclash" {
  // A collectible card game in pixel art, played against the phone. Two heroes, a board of minions
  // each and a mana crystal more every turn: minions come down asleep (unless they charge), then
  // attack once a turn, and a taunt has to be dealt with first. Spells burn, freeze, heal and
  // destroy; battlecries go off as a minion is played, deathrattles as it dies. 48 cards across six
  // elements, from common to legendary. Beat the eight foes of the ladder one by one for gold, buy
  // packs with it, and build a deck of 20 from what you've collected. Taps only, no network.
  //
  // There's no game loop. A play or an attack becomes `act`, and `on actQ` turns it into effects in
  // `pend`; `on resQ` works them out against the board (hits, heals, freezes, summons, draws),
  // leaves timed events (`fx`) for the canvases to play, and runs again for the deathrattles of what
  // died. Both sides go through the same code: the foe's turn is one action at a time, each picked
  // by `AIP` (a card to play) or `AIA` (an attack) once the last one has finished playing.

  meta { owl: 14; description: "A collectible card game in pixel art: summon minions, cast spells, beat eight foes on the ladder, open packs and build your deck; single player and offline"; version: "1.0.1"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges"><defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath></defs><g clip-path="url(#t)"><rect width="256" height="256" fill="#2a2238"/><rect x="0" y="168" width="256" height="88" fill="#3a2e4c"/></g><rect x="30" y="44" width="116" height="164" rx="10" fill="#14121c" transform="rotate(-12 88 126)"/><rect x="38" y="52" width="100" height="148" rx="6" fill="#5ab4ff" transform="rotate(-12 88 126)"/><rect x="44" y="58" width="88" height="136" rx="4" fill="#3a78c8" transform="rotate(-12 88 126)"/><rect x="104" y="36" width="122" height="172" rx="10" fill="#14121c"/><rect x="112" y="44" width="106" height="156" rx="6" fill="#ffb02a"/><rect x="118" y="50" width="94" height="144" rx="4" fill="#c8483a"/><rect x="126" y="60" width="78" height="60" fill="#6a1e1e"/><path fill="#ff8a3a" d="M160 68h10v10h10v10h10v20h-10v10h-30v-10h-10v-20h10v-10h10z"/><path fill="#ffd04a" d="M160 88h10v10h10v10h-30v-10h10z"/><rect x="124" y="130" width="82" height="54" rx="3" fill="#efe4c8"/><rect x="136" y="144" width="58" height="8" fill="#14121c"/><rect x="144" y="162" width="42" height="8" fill="#14121c"/><circle cx="118" cy="48" r="22" fill="#14121c"/><circle cx="118" cy="48" r="17" fill="#3a7ae8"/><rect x="113" y="38" width="10" height="20" fill="#ffffff"/><circle cx="214" cy="196" r="20" fill="#14121c"/><circle cx="214" cy="196" r="15" fill="#e8504a"/><circle cx="116" cy="196" r="20" fill="#14121c"/><circle cx="116" cy="196" r="15" fill="#ffd04a"/></svg>"""

  // "title", "ladder", "deck", "shop" or "game"
  state mode = "title" persist
  // the collection: how many of each card are owned; the deck of 20; gold; the foes beaten
  state col = [] persist
  state deck = [] persist
  state gold = 100 persist
  state beat = [] persist
  state wins = 0 persist
  // the match. Everything is by side, 0 you and 1 the foe: the boards, hands, draw piles and heroes
  // ({hp, mh, mx mana crystals, m mana left, fat fatigue}). A minion is {c card, a, h, mh, tn taunt,
  // sh shield, po poison, ls lifesteal, at attacks left, fz frozen, u its id, dd its deathrattle done}.
  state foe = 0 persist
  state live = false persist
  state bd = [[], []] persist
  state hd = [[], []] persist
  state dk = [[], []] persist
  state hr = [{}, {}] persist
  state cur = 0 persist
  // 0 while it's played, 1 won, 2 lost; and the gold it paid
  state over = 0 persist
  state rwd = 0 persist
  state uid = 0 persist
  // a pack being opened: [{c, f flipped, g gold for a spare copy}]
  state pack = [] persist
  // the deck builder's element tab
  state tab = 0
  // what's picked: a card in the hand, a minion to attack with, a minion looked at (by its code)
  state selH = -1
  state selM = -1
  state insp = -1
  // the card the foe is playing, shown while it plays
  state shown = -1
  // what the canvases play, in seconds from `fxAt`; `fxAt` is -1 until the next frame sets it
  state fx = []
  state fxAt = -100
  state fxTap = 0
  state fxDur = 0
  state fxT = 0
  // busy from an action until its events have played; rsv while it's still being worked out
  state busy = false
  state rsv = false
  state act = {}
  state pend = []
  state downAt = [-1, -1]
  // triggers, bumped to run
  state startQ = 0
  state turnQ = 0
  state endQ = 0
  state actQ = 0
  state resQ = 0
  state aiQ = 0

  // ---- the cards ----------------------------------------------------------------------------------
  // el element (0 neutral, 1 fire, 2 water, 3 nature, 4 light, 5 shadow); t 0 minion, 1 spell; c cost;
  // r 0 common, 1 rare, 2 epic, 3 legendary, 4 token. tn taunt, ch charge, sh shield, po poison, ls
  // lifesteal. ef: what playing it does, aimed at a target of the kind tg names (any character, en an
  // enemy, em an enemy minion, fm a friendly minion); dr: what it does as it dies; x: its text.
  let CD = [
    {n: "SQUIRE", el: 0, t: 0, c: 1, a: 1, h: 2, r: 0},
    {n: "FOOTMAN", el: 0, t: 0, c: 2, a: 2, h: 3, r: 0},
    {n: "ARCHER", el: 0, t: 0, c: 2, a: 2, h: 1, r: 0, tg: "any", ef: [{e: "dmg", n: 1}], x: ["BATTLECRY: DEAL", "1 DAMAGE"]},
    {n: "TROLL", el: 0, t: 0, c: 3, a: 3, h: 4, r: 0},
    {n: "BARD", el: 0, t: 0, c: 3, a: 2, h: 3, r: 0, ef: [{e: "draw", n: 1}], x: ["BATTLECRY:", "DRAW A CARD"]},
    {n: "IRON KNIGHT", el: 0, t: 0, c: 4, a: 4, h: 3, r: 1, sh: true},
    {n: "OGRE", el: 0, t: 0, c: 6, a: 6, h: 7, r: 0},
    {n: "ELDER DRAGON", el: 0, t: 0, c: 8, a: 7, h: 7, r: 3, ef: [{e: "aoe", n: 2}], x: ["BATTLECRY: DEAL 2", "TO ENEMY MINIONS"]},
    {n: "IMP", el: 1, t: 0, c: 1, a: 2, h: 1, r: 0},
    {n: "EMBER", el: 1, t: 1, c: 1, r: 0, tg: "any", ef: [{e: "dmg", n: 2}], x: ["DEAL 2 DAMAGE"]},
    {n: "HELLHOUND", el: 1, t: 0, c: 3, a: 3, h: 2, r: 0, ch: true},
    {n: "FIREBALL", el: 1, t: 1, c: 4, r: 1, tg: "any", ef: [{e: "dmg", n: 6}], x: ["DEAL 6 DAMAGE"]},
    {n: "PHOENIX", el: 1, t: 0, c: 4, a: 4, h: 3, r: 1, dr: [{e: "face", n: 3}], x: ["DEATHRATTLE: DEAL", "3 TO THE ENEMY HERO"]},
    {n: "FLAME DJINN", el: 1, t: 0, c: 5, a: 4, h: 4, r: 0, tg: "any", ef: [{e: "dmg", n: 3}], x: ["BATTLECRY: DEAL", "3 DAMAGE"]},
    {n: "FLAMESTRIKE", el: 1, t: 1, c: 6, r: 2, ef: [{e: "aoe", n: 4}], x: ["DEAL 4 DAMAGE", "TO ALL ENEMY", "MINIONS"]},
    {n: "INFERNO DRAKE", el: 1, t: 0, c: 7, a: 6, h: 6, r: 3, pl: {X: "#e8504a", x: "#982a2e"}, ef: [{e: "face", n: 3}, {e: "aoe", n: 1}], x: ["BATTLECRY: DEAL 3", "TO THE ENEMY HERO,", "1 TO ITS MINIONS"]},
    {n: "FROSTBOLT", el: 2, t: 1, c: 2, r: 0, tg: "en", ef: [{e: "dmg", n: 3}, {e: "frz"}], x: ["DEAL 3 DAMAGE", "TO AN ENEMY", "AND FREEZE IT"]},
    {n: "FROST NYMPH", el: 2, t: 0, c: 2, a: 2, h: 2, r: 0, tg: "em", ef: [{e: "frz"}], x: ["BATTLECRY: FREEZE", "AN ENEMY MINION"]},
    {n: "INSIGHT", el: 2, t: 1, c: 3, r: 0, ef: [{e: "draw", n: 2}], x: ["DRAW 2 CARDS"]},
    {n: "SHELLBACK", el: 2, t: 0, c: 3, a: 2, h: 5, r: 0, tn: true},
    {n: "WATER SPIRIT", el: 2, t: 0, c: 4, a: 3, h: 5, r: 1, ef: [{e: "draw", n: 1}], x: ["BATTLECRY:", "DRAW A CARD"]},
    {n: "BLIZZARD", el: 2, t: 1, c: 6, r: 2, ef: [{e: "aoe", n: 2}, {e: "frzall"}], x: ["DEAL 2 TO ALL", "ENEMY MINIONS", "AND FREEZE THEM"]},
    {n: "KRAKEN", el: 2, t: 0, c: 7, a: 6, h: 8, r: 1, tn: true},
    {n: "TIDE QUEEN", el: 2, t: 0, c: 6, a: 4, h: 6, r: 3, ef: [{e: "frzall"}, {e: "draw", n: 1}], x: ["BATTLECRY: FREEZE", "ENEMY MINIONS", "AND DRAW A CARD"]},
    {n: "VIPER", el: 3, t: 0, c: 2, a: 1, h: 2, r: 0, po: true},
    {n: "GROWTH", el: 3, t: 1, c: 2, r: 0, ef: [{e: "ramp"}], x: ["GAIN AN EMPTY", "MANA CRYSTAL"]},
    {n: "WILD MIGHT", el: 3, t: 1, c: 2, r: 0, tg: "fm", ef: [{e: "buff", a: 2, h: 2, kw: "tn"}], x: ["GIVE A MINION", "+2/+2 AND TAUNT"]},
    {n: "BEAR", el: 3, t: 0, c: 3, a: 3, h: 3, r: 0, tn: true},
    {n: "HOWL", el: 3, t: 1, c: 3, r: 0, ef: [{e: "sum", c: 48, n: 2}], x: ["SUMMON TWO", "2/2 WOLVES"]},
    {n: "SPIDER QUEEN", el: 3, t: 0, c: 5, a: 3, h: 3, r: 2, po: true, dr: [{e: "sum", c: 49, n: 2}], x: ["DEATHRATTLE: SUMMON", "TWO 1/1 POISONOUS", "SPIDERS"]},
    {n: "OLD OAK", el: 3, t: 0, c: 6, a: 5, h: 8, r: 1, tn: true},
    {n: "GAIA", el: 3, t: 0, c: 8, a: 6, h: 6, r: 3, ef: [{e: "buffall", a: 2, h: 2}], x: ["BATTLECRY: GIVE", "YOUR OTHER MINIONS", "+2/+2"]},
    {n: "ACOLYTE", el: 4, t: 0, c: 1, a: 1, h: 2, r: 0, sh: true},
    {n: "HOLY LIGHT", el: 4, t: 1, c: 2, r: 0, ef: [{e: "heal", n: 8}], x: ["RESTORE 8 HEALTH", "TO YOUR HERO"]},
    {n: "BLESSING", el: 4, t: 1, c: 1, r: 0, tg: "fm", ef: [{e: "buff", a: 1, h: 1, kw: "sh"}], x: ["GIVE A MINION", "+1/+1 AND SHIELD"]},
    {n: "TEMPLAR", el: 4, t: 0, c: 3, a: 2, h: 2, r: 0, tn: true, sh: true},
    {n: "RALLY", el: 4, t: 1, c: 3, r: 1, ef: [{e: "buffall", a: 1, h: 1}], x: ["GIVE YOUR", "MINIONS +1/+1"]},
    {n: "JUDGMENT", el: 4, t: 1, c: 4, r: 1, tg: "em", ef: [{e: "kill"}], x: ["DESTROY AN", "ENEMY MINION"]},
    {n: "SERAPH", el: 4, t: 0, c: 5, a: 4, h: 4, r: 2, sh: true, ls: true},
    {n: "SUN TITAN", el: 4, t: 0, c: 8, a: 6, h: 8, r: 3, tn: true, sh: true, ef: [{e: "heal", n: 8}], x: ["BATTLECRY: RESTORE", "8 HEALTH TO", "YOUR HERO"]},
    {n: "VAMPIRE BAT", el: 5, t: 0, c: 1, a: 1, h: 1, r: 0, ch: true, ls: true},
    {n: "SOUL DRAIN", el: 5, t: 1, c: 2, r: 0, tg: "any", ef: [{e: "dmg", n: 2}, {e: "heal", n: 2}], x: ["DEAL 2 DAMAGE,", "RESTORE 2 HEALTH", "TO YOUR HERO"]},
    {n: "GRAVE ROBBER", el: 5, t: 0, c: 3, a: 2, h: 3, r: 0, dr: [{e: "draw", n: 1}], x: ["DEATHRATTLE:", "DRAW A CARD"]},
    {n: "SHADOW BOLT", el: 5, t: 1, c: 3, r: 0, tg: "em", ef: [{e: "dmg", n: 4}], x: ["DEAL 4 DAMAGE", "TO AN ENEMY", "MINION"]},
    {n: "BONE LORD", el: 5, t: 0, c: 4, a: 3, h: 3, r: 1, dr: [{e: "sum", c: 50, n: 2}], x: ["DEATHRATTLE: SUMMON", "TWO 1/1 SKELETONS"]},
    {n: "VAMPIRE", el: 5, t: 0, c: 4, a: 3, h: 4, r: 0, ls: true},
    {n: "PLAGUE", el: 5, t: 1, c: 5, r: 2, ef: [{e: "aoeall", n: 3}], x: ["DEAL 3 DAMAGE", "TO ALL MINIONS"]},
    {n: "THE LICH", el: 5, t: 0, c: 7, a: 5, h: 6, r: 3, tg: "em", ef: [{e: "kill"}], x: ["BATTLECRY: DESTROY", "AN ENEMY MINION"]},
    {n: "WOLF", el: 3, t: 0, c: 2, a: 2, h: 2, r: 4},
    {n: "SPIDERLING", el: 3, t: 0, c: 1, a: 1, h: 1, r: 4, po: true},
    {n: "SKELETON", el: 5, t: 0, c: 1, a: 1, h: 1, r: 4},
    {n: "THE COIN", el: 0, t: 1, c: 0, r: 4, ef: [{e: "gm", n: 1}], x: ["GAIN 1 MANA", "THIS TURN ONLY"]}
  ]
  // the 48 that can be collected, and by rarity for the packs
  let NCOL = 48
  let POOL = range(4).map(r => range(NCOL).filter(c => CD[c].r == r))
  // a card's text: its keywords, then what it does
  let TXT = CD.map(C => [[C.tn ? "TAUNT" : "", C.ch ? "CHARGE" : "", C.sh ? "SHIELD" : "", C.po ? "POISON" : "", C.ls ? "LIFESTEAL" : ""].filter(z => z != "")].map(K => (len(K) > 0 ? [join(K, " ")] : []) + (C.x ?? []))[0])
  let EL = [
    {n: "NEUTRAL", s: "NEUT", f: "#8a8698", d: "#46425a"},
    {n: "FIRE", s: "FIRE", f: "#c8483a", d: "#6a1e1e"},
    {n: "WATER", s: "WATER", f: "#3a78c8", d: "#1a3a6a"},
    {n: "NATURE", s: "WILD", f: "#4a9a4a", d: "#1e4a26"},
    {n: "LIGHT", s: "LIGHT", f: "#d0a040", d: "#6a4a18"},
    {n: "SHADOW", s: "DARK", f: "#7a4ab0", d: "#341e5a"}
  ]
  let RIM = ["#c8c4d4", "#5ab4ff", "#d07aff", "#ffb02a", "#8a8698"]
  let RN = ["COMMON", "RARE", "EPIC", "LEGENDARY", "TOKEN"]
  // what a spare copy from a pack pays back
  let SPARE = [5, 20, 50, 150, 0]
  let STARTER = [0, 0, 1, 1, 2, 2, 3, 3, 4, 6, 6, 8, 9, 16, 19, 24, 27, 32, 40, 43]
  let FIRSTCOL = range(NCOL).map(c => count(STARTER, z => z == c) + (c == 4 || c == 33 ? 1 : 0))

  // ---- the ladder ---------------------------------------------------------------------------------
  // hp the foe's health; sp its portrait; pl colours swapped in it; dk its deck
  let FOES = [
    {n: "GRUK", t: "GOBLIN WARBOSS", hp: 18, el: 1, sp: 1, pl: {}, dk: [8, 8, 9, 9, 0, 0, 1, 1, 2, 2, 10, 10, 3, 3, 13, 4, 4, 6, 6, 11]},
    {n: "MIRA", t: "FROST WITCH", hp: 20, el: 2, sp: 2, pl: {X: "#3a78c8", x: "#1a3a6a", Z: "#9ae0ff"}, dk: [16, 16, 17, 17, 18, 19, 19, 20, 20, 0, 0, 1, 1, 3, 3, 6, 6, 22, 4, 4]},
    {n: "OAKHEART", t: "GROVE DRUID", hp: 22, el: 3, sp: 3, pl: {}, dk: [24, 24, 25, 25, 26, 26, 27, 27, 28, 28, 29, 30, 30, 1, 1, 3, 3, 2, 2, 6]},
    {n: "MORGRIM", t: "BONE KING", hp: 24, el: 5, sp: 4, pl: {}, dk: [40, 40, 41, 41, 42, 42, 43, 43, 44, 44, 45, 45, 46, 1, 1, 3, 3, 6, 6, 5]},
    {n: "SERAPHINE", t: "HIGH PRIESTESS", hp: 25, el: 4, sp: 5, pl: {}, dk: [32, 32, 33, 34, 34, 35, 35, 36, 37, 37, 38, 38, 39, 1, 1, 3, 3, 5, 5, 6]},
    {n: "IGNAR", t: "FIRE LORD", hp: 26, el: 1, sp: 6, pl: {}, dk: [8, 8, 9, 9, 10, 10, 11, 11, 12, 12, 13, 13, 14, 15, 2, 2, 5, 5, 3, 3]},
    {n: "ZORAL", t: "ARCHMAGE", hp: 28, el: 2, sp: 2, pl: {X: "#6a3aa8", x: "#3a1e6a", Z: "#f4f0e8"}, dk: [16, 16, 18, 18, 20, 20, 21, 23, 22, 19, 19, 11, 11, 9, 9, 17, 17, 7, 6, 6]},
    {n: "VARGOTH", t: "DRAGON KING", hp: 30, el: 0, sp: 7, pl: {}, dk: [7, 15, 47, 39, 31, 11, 11, 43, 43, 37, 5, 5, 38, 27, 27, 35, 35, 16, 16, 29]}
  ]
  let OPEN = range(8).map(f => f == 0 || indexOf(beat, f - 1) >= 0 || indexOf(beat, f) >= 0)

  // ---- the screen, in dp --------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  // held sideways, the heroes go left of the boards and the card looked at to their right
  let LS = SW > SH
  let TOP = max(screenTop ?? 0, 10) + 4
  let INS = max(screenInset ?? 0, 12)
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"
  let INK = "#14121c"

  // ---- the match's layout -------------------------------------------------------------------------
  // the hand: cards of 80 x 112 scaled to CW wide
  let CW = LS ? min(72, floor((SH - TOP - INS) / 5.2)) : min(88, floor((SW - 16) / 4.6))
  let CS = CW / 80
  let CH = 112 * CS
  let HY = SH - INS - CH - 2
  let HAW = LS ? SW - 380 : SW - 16
  let HN = len(hd[0])
  let HST = HN <= 1 ? 0 : min(CW + 4, (HAW - CW) / (HN - 1))
  let HX0 = SW / 2 - (HST * (HN - 1) + CW) / 2
  let HL = range(HN).map(j => {x: HX0 + j * HST, y: j == selH ? HY - 16 : HY})
  // the boards: five minions a side, MW x MH each
  let BAW = LS ? SW - 330 : SW - 16
  let MW = min(70, floor((BAW - 24) / 5))
  let MH = floor(MW * 1.32)
  let SPS = floor((MW - 12) / 6) / 2
  let HXc = LS ? 62 : SW / 2
  let BCX = LS ? 124 + BAW / 2 : SW / 2
  let PH0 = HY - 46
  let EH0 = TOP + 40
  let GAP = clamp(((PH0 - EH0) - 80 - 2 * MH - 150) / 4, 4, 34)
  let EBY = LS ? TOP + 8 + MH / 2 : EH0 + 38 + GAP + MH / 2
  let PBY = LS ? EBY + MH + 18 : PH0 - 38 - GAP - MH / 2
  let HYS = [LS ? PBY : PH0, LS ? EBY : EH0]
  let BY = [PBY, EBY]
  let MID = (EBY + PBY) / 2
  // the card looked at, big, between the boards (or right of them, sideways)
  let PVS = LS ? min(1.7, (HY - TOP - 30) / 112) : clamp((PBY - EBY - MH - 34) / 112, 0.9, 1.9)
  let PVX = LS ? SW - 40 - 80 * PVS : SW / 2 - 40 * PVS
  let PVY = LS ? TOP + 10 : MID - 8 - 56 * PVS
  // where each minion stands: SLX[side][index] is its left edge
  let SLX = [0, 1].map(s => [len(bd[s])].map(n => range(n).map(i => BCX - (n * MW + (n - 1) * 6) / 2 + i * (MW + 6)))[0])
  // a character's code: side * 10, plus 1 + its index for a minion (0 and 10 are the heroes)
  let CEN = range(20).map(t => [floor(t / 10)].map(s => t % 10 == 0 ? {x: HXc, y: HYS[s]} : {x: (SLX[s][t % 10 - 1] ?? BCX) + MW / 2, y: BY[s]})[0])
  let END = LS ? {x: SW - 150, y: HY + CH / 2 - 24, w: 110, h: 46} : {x: SW - 104, y: MID - 22, w: 96, h: 44}

  // ---- the match's state, worked out ----------------------------------------------------------------
  let AL = [0, 1].map(s => range(len(bd[s])).filter(i => bd[s][i].h > 0))
  // what a card can aim at, by its kind, for each side
  let VTG = [0, 1].map(s => [1 - s].map(o => {any: [0, 10] + AL[0].map(i => 1 + i) + AL[1].map(i => 11 + i), en: [o * 10] + AL[o].map(i => o * 10 + 1 + i), em: AL[o].map(i => o * 10 + 1 + i), fm: AL[s].map(i => s * 10 + 1 + i)})[0])
  let myTurn = mode == "game" && live && over == 0 && cur == 0 && !busy
  let HC = hd[0].map(c => CD[c])
  let CANP = HC.map(C => C.c <= (hr[0].m ?? 0) && (C.t == 0 ? len(AL[0]) < 5 : C.tg == null || len(get(VTG[0], C.tg, [])) > 0))
  let CANA = range(len(bd[0])).map(i => [bd[0][i]].map(m => m.h > 0 && m.at > 0 && m.a > 0 && !(m.fz ?? false))[0])
  let TN1 = AL[1].filter(i => bd[1][i].tn)
  // what the card or minion picked can aim at
  let selC = selH >= 0 && selH < HN ? HC[selH] : null
  let VT = selC != null ? (selC.tg == null ? [] : get(VTG[0], selC.tg, [])) : selM >= 0 ? (len(TN1) > 0 ? TN1.map(i => 11 + i) : [10] + AL[1].map(i => 11 + i)) : []
  let idle = myTurn && !any(CANP, z => z) && !any(CANA, z => z)

  // ---- the foe: what it does next ------------------------------------------------------------------
  // each card in its hand, with the best target for it and how much it wants to play it
  let AIH = mode != "game" || cur != 1 || over != 0 ? [] : range(len(hd[1])).map(j => [CD[hd[1][j]]].map(C => [C.ef[0].e].map(e => [C.tg == null ? [] : get(VTG[1], C.tg, []).filter(t => (e == "buff") == (t >= 10)).map(t => {t: t, v: t % 10 == 0 ? (e == "dmg" ? (C.ef[0].n >= hr[0].hp ? 999 : C.ef[0].n) : 0) : [bd[floor(t / 10)][t % 10 - 1]].map(m => e == "dmg" ? (m.sh ? 1 : C.ef[0].n >= m.h ? 8 + m.a * 3 + m.h : m.a) : e == "kill" ? 2 + m.a * 2 + m.h : e == "frz" ? m.a : m.a + m.h)[0]}).sortBy(z => -z.v)].map(TS => {
    j: j, c: hd[1][j], t: len(TS) > 0 ? TS[0].t : -1,
    ok: C.c <= hr[1].m && (C.t == 0 ? len(AL[1]) < 5 : (C.tg == null || (len(TS) > 0 && TS[0].v >= 1)) && (e == "aoe" ? len(AL[0]) >= 2 : e == "aoeall" ? len(AL[0]) >= len(AL[1]) + 2 : e == "heal" ? hr[1].hp <= hr[1].mh - 6 : e == "buffall" ? len(AL[1]) >= 2 : e == "sum" ? len(AL[1]) <= 3 : e == "ramp" ? hr[1].mx <= 8 : e == "gm" ? any(hd[1], z => CD[z].c == hr[1].m + 1) : e == "draw" ? len(hd[1]) <= 6 : true)),
    sc: C.c * 10 + (C.t == 0 ? 3 : 0) + (len(TS) > 0 ? min(TS[0].v, 30) / 3 : 0)
  })[0])[0])[0])
  let AIP = AIH.filter(z => z.ok).sortBy(z => -z.sc)[0]
  // its minions that can attack, the biggest first, and what the first of them goes for: a taunt,
  // the hero if that's lethal, a minion it can kill and come out of well, or else the hero
  let AIAT = mode != "game" || cur != 1 ? [] : AL[1].filter(i => bd[1][i].at > 0 && bd[1][i].a > 0 && !(bd[1][i].fz ?? false)).sortBy(i => -bd[1][i].a)
  let TN0 = AL[0].filter(i => bd[0][i].tn)
  let AIA = len(AIAT) == 0 ? null : [bd[1][AIAT[0]]].map(A => {i: AIAT[0], t: len(TN0) > 0 ? 1 + TN0.sortBy(i => [bd[0][i]].map(m => !m.sh && (A.a >= m.h || A.po) ? -100 - m.a : m.h)[0])[0] : sum(AIAT.map(i => bd[1][i].a)) >= hr[0].hp ? 0 : [AL[0].filter(i => [bd[0][i]].map(m => !m.sh && (A.a >= m.h || A.po) && (m.a < A.h || m.a >= A.a + 2 || m.a >= 4))[0]).sortBy(i => -(bd[0][i].a * 2 + bd[0][i].h))].map(Q => len(Q) > 0 ? 1 + Q[0] : 0)[0]})[0]

  // ---- the deck builder's layout --------------------------------------------------------------------
  let DKU = unique(deck).sortBy(c => CD[c].c * 100 + c)
  let DLH = 19
  let DLY = TOP + 50
  let DLW = (SW - 30) / 2
  let TBY = DLY + 10 * DLH + 8
  let TBW = (SW - 24) / 6
  let GRY = TBY + 40
  let GS = min(((SW - 24) / 4 - 8) / 80, (SH - INS - GRY - 40) / 2 / 112)
  let GCW = (SW - 24) / 4
  let GRID = range(8).map(k => {c: tab * 8 + k, x: 12 + (k % 4) * GCW + (GCW - 80 * GS) / 2, y: GRY + floor(k / 4) * (112 * GS + 22)})
  let INDK = range(NCOL).map(c => count(deck, z => z == c))
  let MAXC = range(NCOL).map(c => CD[c].r == 3 ? 1 : 2)

  // ---- the shop's layout --------------------------------------------------------------------------
  let PKS = min(1.35, (SW - 48) / 3 / 80, (SH - TOP - INS - 220) / 2 / 112)
  let PKC = range(len(pack)).map(j => [j < 3 ? 3 : len(pack) - 3].map(n => {x: SW / 2 - (n * 80 * PKS + (n - 1) * 12) / 2 + (j < 3 ? j : j - 3) * (80 * PKS + 12), y: TOP + 70 + (j < 3 ? 0 : 112 * PKS + 34)})[0])

  // ---- the ladder's layout ------------------------------------------------------------------------
  let LH = min(80, (SH - INS - TOP - 76) / 8)
  let LY = TOP + 64

  // ---- starting a match against `foe` ---------------------------------------------------------------
  on startQ {
    let first = random(2)
    let D0 = shuffle(deck)
    let D1 = shuffle(FOES[foe].dk)
    let n0 = first == 0 ? 3 : 4
    let n1 = first == 1 ? 3 : 4
    hd = [D0.take(n0) + (first == 1 ? [51] : []), D1.take(n1) + (first == 0 ? [51] : [])]
    dk = [D0.drop(n0), D1.drop(n1)]
    bd = [[], []]
    hr = [{hp: 30, mh: 30, mx: 0, m: 0, fat: 0}, {hp: FOES[foe].hp, mh: FOES[foe].hp, mx: 0, m: 0, fat: 0}]
    cur = first
    over = 0
    rwd = 0
    live = true
    mode = "game"
    selH = -1
    selM = -1
    insp = -1
    shown = -1
    fx = [{k: "ban", s: "VS ${FOES[foe].n}", s2: first == 0 ? "YOU GO FIRST" : "${FOES[foe].n} GOES FIRST", c: "#ffe14a", t0: 0}]
    fxT = 1.1
    busy = true
    rsv = true
    turnQ = turnQ + 1
  }

  // ---- a turn starts: a mana crystal, the minions wake, a card ----------------------------------------
  on turnQ {
    if live && over == 0 {
      let s = cur
      let H = hr[s]
      let mx = min(10, H.mx + 1)
      hr = set(hr, s, merge(H, {mx: mx, m: mx}))
      bd = set(bd, s, bd[s].map(m => merge(m, {at: m.fz ? 0 : 1, zz: false})))
      fx = fx + [{k: "ban", s: s == 0 ? "YOUR TURN" : "${FOES[foe].n}'S TURN", s2: "", c: s == 0 ? "#ffe14a" : "#ff5a4a", t0: fxT}]
      fxT = fxT + 0.75
      pend = [{e: "draw", s: s, n: 1}]
      resQ = resQ + 1
    }
  }

  // ---- a turn ends: what was frozen thaws -------------------------------------------------------------
  on endQ {
    if live && over == 0 {
      let s = cur
      bd = set(bd, s, bd[s].map(m => merge(m, {fz: false, at: 0})))
      cur = 1 - s
      fx = []
      fxT = 0
      turnQ = turnQ + 1
    }
  }

  // ---- a card played or an attack made, by either side ----------------------------------------------
  on actQ {
    let A = act
    let s = A.s
    if A.k == "play" {
      let c = hd[s][A.j]
      let C = CD[c]
      let nb = len(bd[s])
      hd = set(hd, s, remove(hd[s], A.j))
      hr = set(hr, s, merge(hr[s], {m: hr[s].m - C.c}))
      if C.t == 0 {
        bd = set(bd, s, bd[s] + [{c: c, a: C.a, h: C.h, mh: C.h, tn: C.tn ?? false, sh: C.sh ?? false, po: C.po ?? false, ls: C.ls ?? false, at: C.ch ? 1 : 0, zz: !C.ch, fz: false, u: uid, dd: false}])
        uid = uid + 1
      }
      fx = C.t == 0 ? [{k: "spawn", u: uid, t0: s == 1 ? 0.8 : 0}] : []
      fxT = s == 1 ? 0.9 : 0.1
      pend = (C.ef ?? []).map((E, q) => merge(E, {s: s, t: A.t, x: C.t == 0 ? nb : -1, el: C.el, z: q == 0}))
    } else {
      fx = [{k: "lunge", f: s * 10 + 1 + A.i, t: A.t, t0: 0}]
      fxT = 0
      pend = [{e: "atk", s: s, i: A.i, t: A.t}]
    }
    resQ = resQ + 1
  }

  // ---- working out what was played: effects become hits, heals and the rest, then they land ---------
  on resQ {
    let T0 = fxT
    let ZC = ["#ffffff", "#ff8a3a", "#9ae0ff", "#b8f07a", "#ffe14a", "#c87aff"]
    // sparks flying to what a card aims at, waves over a board it hits all of
    let ZF = flatten(pend.map(E => (E.z ?? false) && E.t >= 0 && (E.e == "dmg" || E.e == "frz" || E.e == "kill" || E.e == "buff") ? [{k: "zap", f: E.x >= 0 ? E.s * 10 + 1 + E.x : E.s * 10, t: E.t, c: ZC[E.el], t0: T0}] : E.e == "aoe" || E.e == "frzall" ? [{k: "wave", s: 1 - E.s, c: ZC[E.el], t0: T0 + 0.05}] : E.e == "aoeall" ? [{k: "wave", s: 0, c: ZC[E.el], t0: T0 + 0.05}, {k: "wave", s: 1, c: ZC[E.el], t0: T0 + 0.05}] : []))
    let OPS = flatten(pend.map(E => [1 - E.s].map(o =>
        E.e == "dmg" ? (E.t < 0 ? [] : [{op: "hit", t: E.t, n: E.n, po: false, at: 0.2}])
      : E.e == "frz" ? (E.t < 0 ? [] : [{op: "frz", t: E.t, at: 0.3}])
      : E.e == "kill" ? (E.t < 0 ? [] : [{op: "kill", t: E.t, at: 0.2}])
      : E.e == "buff" ? (E.t < 0 ? [] : [{op: "buff", t: E.t, a: E.a, h: E.h, kw: E.kw ?? "", at: 0.2}])
      : E.e == "aoe" ? AL[o].map(i => {op: "hit", t: o * 10 + 1 + i, n: E.n, po: false, at: 0.3})
      : E.e == "aoeall" ? AL[0].map(i => {op: "hit", t: 1 + i, n: E.n, po: false, at: 0.3}) + AL[1].map(i => {op: "hit", t: 11 + i, n: E.n, po: false, at: 0.3})
      : E.e == "frzall" ? AL[o].map(i => {op: "frz", t: o * 10 + 1 + i, at: 0.45})
      : E.e == "face" ? [{op: "hit", t: o * 10, n: E.n, po: false, at: 0.25}]
      : E.e == "heal" ? [{op: "heal", t: E.s * 10, n: E.n, at: 0.3}]
      : E.e == "buffall" ? AL[E.s].filter(i => i != E.x).map(i => {op: "buff", t: E.s * 10 + 1 + i, a: E.a, h: E.h, kw: "", at: 0.25})
      : E.e == "atk" ? [bd[E.s][E.i]].map(M => [E.t % 10 == 0 ? null : bd[floor(E.t / 10)][E.t % 10 - 1]].map(D =>
          [{op: "used", t: E.s * 10 + 1 + E.i, at: 0}, {op: "hit", t: E.t, n: M.a, po: M.po, at: 0.18}]
          + (D == null ? [] : [{op: "hit", t: E.s * 10 + 1 + E.i, n: D.a, po: D.po, at: 0.18}])
          + (M.ls ? [{op: "heal", t: E.s * 10, n: M.a, at: 0.3}] : [])
          + (D != null && D.ls ? [{op: "heal", t: o * 10, n: D.a, at: 0.3}] : []))[0])[0]
      : [merge(E, {op: E.e, at: 0.25})]
    )[0]))
    let G1 = reduce(OPS, (G, p) => [floor((p.t ?? 0) / 10)].map(ts => [(p.t ?? 0) % 10 - 1].map(ti => [ti < 0 ? null : G.bd[ts][ti]].map(m => [T0 + p.at].map(tz =>
        p.op == "hit" ? (ti < 0
            ? merge(G, {hr: set(G.hr, ts, merge(G.hr[ts], {hp: G.hr[ts].hp - p.n})), fx: G.fx + [{k: "hit", t: p.t, n: p.n, d: p.n, t0: tz}]})
            : m == null || m.h <= 0 || p.n <= 0 ? G
            : m.sh ? merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {sh: false}))), fx: G.fx + [{k: "pop", t: p.t, t0: tz}]})
            : [p.po ? min(0, m.h - p.n) : m.h - p.n].map(nh => merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {h: nh}))), fx: G.fx + [{k: "hit", t: p.t, n: p.n, d: m.h - nh, t0: tz}]}))[0])
      : p.op == "heal" ? [min(G.hr[ts].mh, G.hr[ts].hp + p.n)].map(nh => merge(G, {hr: set(G.hr, ts, merge(G.hr[ts], {hp: nh})), fx: G.fx + (nh > G.hr[ts].hp ? [{k: "heal", t: p.t, n: nh - G.hr[ts].hp, t0: tz}] : [])}))[0]
      : p.op == "frz" ? (m == null || m.h <= 0 ? G : merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {fz: true}))), fx: G.fx + [{k: "txt", t: p.t, s: "FROZEN", c: "#9ae0ff", t0: tz}]}))
      : p.op == "kill" ? (m == null || m.h <= 0 ? G : merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {h: 0}))), fx: G.fx + [{k: "kill", t: p.t, d: m.h, t0: tz}]}))
      : p.op == "buff" ? (m == null || m.h <= 0 ? G : merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {a: m.a + p.a, h: m.h + p.h, mh: m.mh + p.h, tn: m.tn || p.kw == "tn", sh: m.sh || p.kw == "sh"}))), fx: G.fx + [{k: "txt", t: p.t, s: "+${p.a}/+${p.h}", c: "#8aff7a", t0: tz}]}))
      : p.op == "used" ? merge(G, {bd: set(G.bd, ts, set(G.bd[ts], ti, merge(m, {at: m.at - 1})))})
      : p.op == "ramp" ? merge(G, {hr: set(G.hr, p.s, merge(G.hr[p.s], {mx: min(10, G.hr[p.s].mx + 1)})), fx: G.fx + [{k: "txt", t: p.s * 10, s: "+1 CRYSTAL", c: "#5ab4ff", t0: tz}]})
      : p.op == "gm" ? merge(G, {hr: set(G.hr, p.s, merge(G.hr[p.s], {m: G.hr[p.s].m + p.n})), fx: G.fx + [{k: "txt", t: p.s * 10, s: "+${p.n} MANA", c: "#5ab4ff", t0: tz}]})
      : p.op == "sum" ? reduce(range(p.n), (H, z) => len(H.bd[p.s].filter(q => q.h > 0)) >= 5 ? H : [CD[p.c]].map(C => merge(H, {bd: set(H.bd, p.s, H.bd[p.s] + [{c: p.c, a: C.a, h: C.h, mh: C.h, tn: C.tn ?? false, sh: C.sh ?? false, po: C.po ?? false, ls: C.ls ?? false, at: 0, zz: true, fz: false, u: H.u, dd: false}]), u: H.u + 1, fx: H.fx + [{k: "spawn", u: H.u, t0: tz + z * 0.15}]}))[0], G)
      : p.op == "draw" ? reduce(range(p.n), (H, z) => len(H.dk[p.s]) == 0
            ? [H.hr[p.s].fat + 1].map(f => merge(H, {hr: set(H.hr, p.s, merge(H.hr[p.s], {fat: f, hp: H.hr[p.s].hp - f})), fx: H.fx + [{k: "hit", t: p.s * 10, n: f, d: f, t0: tz + z * 0.35}, {k: "txt", t: p.s * 10, s: "FATIGUE", c: "#ff8a5a", t0: tz + z * 0.35}]}))[0]
            : len(H.hd[p.s]) >= 8 ? merge(H, {dk: set(H.dk, p.s, H.dk[p.s].drop(1)), fx: H.fx + [{k: "txt", t: p.s * 10, s: "BURNED ${CD[H.dk[p.s][0]].n}", c: "#ff8a5a", t0: tz + z * 0.35}]})
            : merge(H, {hd: set(H.hd, p.s, H.hd[p.s] + [H.dk[p.s][0]]), dk: set(H.dk, p.s, H.dk[p.s].drop(1))}), G)
      : G
    )[0])[0])[0])[0], {bd: bd, hd: hd, dk: dk, hr: hr, u: uid, fx: []})
    // what died: its deathrattle goes next
    let DR = flatten(range(2).map(s => range(len(G1.bd[s])).filter(i => G1.bd[s][i].h <= 0 && !G1.bd[s][i].dd).map(i => (CD[G1.bd[s][i].c].dr ?? []).map(E => merge(E, {s: s, t: -1, x: -1, el: CD[G1.bd[s][i].c].el, z: false})))))
    let mxAt = max([0] + OPS.map(p => p.at))
    bd = G1.bd.map(B => B.map(m => m.h <= 0 ? merge(m, {dd: true}) : m))
    hd = G1.hd
    dk = G1.dk
    hr = G1.hr
    uid = G1.u
    fx = fx + ZF + G1.fx
    fxT = T0 + (len(OPS) > 0 ? mxAt + 0.5 : 0.1)
    if len(DR) > 0 {
      pend = DR
      resQ = resQ + 1
    } else {
      let res = G1.hr[0].hp <= 0 ? 2 : G1.hr[1].hp <= 0 ? 1 : 0
      let fw = res == 1 && indexOf(beat, foe) < 0
      let g = res == 1 ? (fw ? 100 + foe * 25 : 30) : res == 2 ? 10 : 0
      if res > 0 {
        over = res
        rwd = g
        gold = gold + g
        if res == 1 { wins = wins + 1 }
        if fw { beat = beat + [foe] }
      }
      pend = []
      fxDur = T0 + (len(OPS) > 0 ? mxAt + 0.5 : 0.1) + (res > 0 ? 0.9 : 0)
      fxTap = time
      fxAt = -1
      rsv = false
    }
  }

  // ---- the foe's turn, one action at a time ------------------------------------------------------------
  on aiQ {
    if live && over == 0 && cur == 1 && !busy && mode == "game" {
      busy = true
      rsv = true
      if AIP != null {
        act = {k: "play", s: 1, j: AIP.j, t: AIP.t}
        shown = AIP.c
        actQ = actQ + 1
      } else if AIA != null {
        act = {k: "atk", s: 1, i: AIA.i, t: AIA.t}
        actQ = actQ + 1
      } else {
        endQ = endQ + 1
      }
    }
  }

  // a frame after the action's worked out: a tap's own `time` can be off the frame clock
  when fxAt == -1 && !rsv && time != fxTap { fxAt = time }
  when busy && !rsv && fxAt >= 0 && (time > fxAt + fxDur || time < fxAt - 1) {
    busy = false
    shown = -1
    bd = bd.map(B => B.filter(m => m.h > 0))
  }
  when live && over == 0 && cur == 1 && !busy && mode == "game" { aiQ = aiQ + 1 }
  // the first time: the starter collection and deck
  when len(col) == 0 {
    col = FIRSTCOL
    deck = STARTER
  }

  back: mode != "title"
  onBack: {
    if mode == "game" && (selH >= 0 || selM >= 0 || insp >= 0) {
      selH = -1
      selM = -1
      insp = -1
    } else if mode == "shop" && len(pack) > 0 {
      pack = []
    } else {
      mode = "title"
    }
  }

  // ---- the art ----------------------------------------------------------------------------------------
  // one palette for every picture; a card or a hero can swap colours in it
  let ICP = {o: INK, W: "#f4f0e8", w: "#b8b4c4", g: "#7e7a8c", k: "#3a3648", S: "#f0b890", s: "#c07a5a", R: "#e8504a", r: "#982a2e", O: "#ff8a3a", Y: "#ffd04a", y: "#c08a30", F: "#fff4b0", B: "#4a8ae8", b: "#2a4a98", C: "#9ae0ff", G: "#5ac85a", D: "#2e7a3e", L: "#b8f07a", N: "#9a6a3e", n: "#5e3a22", P: "#9a5ad8", p: "#4e2a7a", M: "#ff7ab8", T: "#3ac8a8", H: "#a8b2c6", h: "#e2e8f2", q: "#c8a878", E: "#ff3a3a", X: "#c8a040", x: "#8a6a2a", Z: "#ffd04a"}
  let CPL = CD.map(C => C.pl == null ? ICP : merge(ICP, C.pl))
  let SP_DRAGON = """
    ........oo..
    ......ooXXo.
    ....ooXXXXo.
    ...oXXXXXXxo
    ..oXXWoXXXxo
    .oXXXooXXXxo
    oXXXXXXXXxo.
    oWoWoXXXXxo.
    .ooooXXXxxo.
    oWoWoXXXxo..
    .oooXXXXxo..
    ....oooooo..
  """
  // the cards' pictures, 12 by 12, by card
  let IC = [
    """
    ....oooo....
    ...oHHHHo...
    ..oHhHHHHo..
    ..oHHHHHHo..
    ..oooooooo..
    ..oSoSSoSo..
    ..oSSSSSSo..
    ...oSssSo...
    ..ooBBBBoo..
    .oBBBYYBBBo.
    .oBBBYYBBBo.
    .oooooooooo.
    """,
    """
    ..........o.
    ...oooo..oho
    ..oHHHHo.oHo
    .oHhHHHHooHo
    .oooooooo.No
    .oSoSSoSo.No
    .oSSSSSSo.No
    ..oSssSo..No
    .ooRRRRoooNo
    oRRRhRRRRRNo
    oRRRRRRRRo..
    oooooooooo..
    """,
    """
    ....oooo....
    ...oDDDDo.o.
    ..oDDDDDDoNo
    ..oDoSSoDooN
    ..oDSSSSDo.N
    ...oSssSo..N
    ..ooDDDDoo.N
    .oDDDNDDDDoN
    .oDDDNDDDDoN
    .oDDDNDDDDo.
    .oDDDDDDDDo.
    .oooooooooo.
    """,
    """
    ............
    ...oooooo...
    ..oTTTTTTo..
    .oTToTToTTo.
    .oTTTTTTTTo.
    .oTWoooWTTo.
    ..oTTTTTTo..
    .ooNNNNNNoo.
    oTTNNNNNNTTo
    oTTNNNNNNTTo
    .ooNNNNNNoo.
    ..oooooooo..
    """,
    """
    .........oR.
    ...ooooooRo.
    ..oPPPPPPPo.
    .oPPPPPPPPPo
    ..oooooooo..
    ..oSoSSoSo..
    ..oSSSSSSo..
    ...oSMMSo...
    ..ooYYYYoo..
    .oYYoNNoYYo.
    .oYoNNNNoYo.
    .oooonnoooo.
    """,
    """
    ....oooo....
    ...ohHHHo...
    ..oHhHHHHo..
    ..oHHHHHHo..
    ..oooooooo..
    ..oHokkoHo..
    ..oHHHHHHo..
    ..oHHoHHHo..
    .ooHHHHHHoo.
    oHHHHYYHHHHo
    oHHHHYYHHHHo
    oooooooooooo
    """,
    """
    ............
    ...oooooo...
    ..oqqqqqqo..
    .oqqoqqoqqo.
    .oqqqqqqqqo.
    .oqoWoWoqqo.
    ..oqqqqqqo..
    .ooNNNNNNoo.
    oqqNnNNnNqqo
    oqqNNNNNNqqo
    .oonNNNNnoo.
    ..oooooooo..
    """,
    SP_DRAGON,
    """
    .o........o.
    .oRo....oRo.
    ..oRooooRo..
    ..oRRRRRRo..
    .oRRYRRYRRo.
    .oRRRRRRRRo.
