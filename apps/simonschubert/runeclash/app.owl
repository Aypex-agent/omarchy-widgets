  let HPL = [ICP] + FOES.map(F => merge(ICP, F.sp == 7 ? {X: "#8a3ab8", x: "#4e1e6e"} : {}, F.pl))
  // small marks on a minion: poison, lifesteal, frozen
  let SP_DROP = """
    ..o..
    .oGo.
    oGGGo
    oGLGo
    .ooo.
  """
  let SP_HEART = """
    oo.oo
