  """
  // a card's back
  let SP_RUNE = """
    ....oo....
    ...oYYo...
    ..oYooYo..
    .oYo..oYo.
    oYo.YY.oYo
    oYo.YY.oYo
    .oYo..oYo.
    ..oYooYo..
    ...oYYo...
    ....oo....
  """
  // buttons are pixel art: a light band on top, the face, a shaded band at its foot and a dark lip under it
  let BTN = {
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
    blue: ["#a8d8ff", "#4a90e0", "#2e64b0", "#173866"],
    off: ["#8e88ac", "#5a5474", "#443e5c", "#221e36"],
    red: ["#ffaa94", "#e8504a", "#b8333a", "#621822"],
    green: ["#b8f0a0", "#4aa84a", "#2e7a32", "#173e1a"]
  }

  // ---- what's on screen, for drawing and for taps -------------------------------------------------
  let G = mode == "game"
  let BT = mode == "title" ? [{id: "play", x: SW / 2 - 120, y: SH * 0.62, w: 240, h: 56, l: live ? "CONTINUE" : "PLAY", p: "go"}, {id: "deck", x: SW / 2 - 120, y: SH * 0.62 + 68, w: 114, h: 48, l: "DECK", p: "blue"}, {id: "shop", x: SW / 2 + 6, y: SH * 0.62 + 68, w: 114, h: 48, l: "PACKS", p: "blue"}]
    : mode == "ladder" ? [{id: "home", x: 10, y: TOP + 6, w: 46, h: 36, l: "<", p: "off"}]
    : mode == "deck" ? [{id: "home", x: 10, y: TOP + 6, w: 46, h: 36, l: "<", p: "off"}, {id: "auto", x: SW - 96, y: TOP + 6, w: 86, h: 36, l: "AUTO", p: "blue"}]
    : mode == "shop" ? (len(pack) > 0 ? [{id: all(pack, z => z.f) ? "done" : "flip", x: SW / 2 - 110, y: SH - INS - 70, w: 220, h: 54, l: all(pack, z => z.f) ? "DONE" : "OPEN ALL", p: "go"}] : [{id: "home", x: 10, y: TOP + 6, w: 46, h: 36, l: "<", p: "off"}, {id: "buy", x: SW / 2 - 120, y: SH * 0.64, w: 240, h: 58, l: "BUY A PACK", l2: "100 GOLD", p: gold >= 100 ? "go" : "off", dis: gold < 100}])
    : G ? (over != 0 && !busy ? [{id: "fin", x: SW / 2 - 110, y: MID + 60, w: 220, h: 54, l: "CONTINUE", p: "go"}] : [{id: "menu", x: SW - 50, y: TOP, w: 42, h: 30, l: "", p: "off"}] + (myTurn ? [{id: "end", x: END.x, y: END.y, w: END.w, h: END.h, l: "END TURN", p: idle ? "green" : "go"}] : live && over == 0 && cur == 1 ? [{id: "wait", x: END.x, y: END.y, w: END.w, h: END.h, l: "FOE", p: "off", dis: true}] : []))
    : []
  // the card looked at: one picked in the hand, a minion's, or what the foe is playing
  let PV = !G || over != 0 ? null : shown >= 0 ? {c: shown, mn: null, lab: "${FOES[foe].n} PLAYS"} : selH >= 0 && selH < HN ? {c: hd[0][selH], mn: null, lab: ""} : selM >= 0 && selM < len(bd[0]) ? {c: bd[0][selM].c, mn: bd[0][selM], lab: ""} : insp >= 0 && floor(insp / 10) < 2 && insp % 10 > 0 && bd[floor(insp / 10)][insp % 10 - 1] != null ? {c: bd[floor(insp / 10)][insp % 10 - 1].c, mn: bd[floor(insp / 10)][insp % 10 - 1], lab: ""} : null
  // every card drawn: in the hand, looked at, in the deck builder, out of a pack, on the title
  let CARDS = G ? (live ? range(HN).sortBy(j => j == selH ? 1 : 0).map(j => {c: hd[0][j], x: HL[j].x, y: HL[j].y, s: CS, dim: myTurn && !CANP[j], glow: j == selH ? "#ffe14a" : myTurn && CANP[j] ? "#5aff6a" : ""}) : []) + (PV == null ? [] : [{c: PV.c, mn: PV.mn, x: PVX, y: PVY, s: PVS, dim: false, glow: ""}])
    : mode == "deck" ? GRID.map(g => {c: g.c, x: g.x, y: g.y, s: GS, dim: col[g.c] == 0, glow: INDK[g.c] > 0 ? "#ffd04a" : ""})
    : mode == "shop" ? range(len(pack)).map(j => {c: pack[j].c, x: PKC[j].x, y: PKC[j].y, s: PKS, back: !pack[j].f, dim: false, glow: pack[j].f && CD[pack[j].c].r >= 1 ? RIM[CD[pack[j].c].r] : ""})
    : mode == "title" ? [{c: 23, x: SW / 2 - 130, y: SH * 0.33 + 14, s: 1.05, r: -14, dim: false, glow: ""}, {c: 47, x: SW / 2 + 46, y: SH * 0.33 + 14, s: 1.05, r: 14, dim: false, glow: ""}, {c: 15, x: SW / 2 - 46, y: SH * 0.33, s: 1.15, r: 0, dim: false, glow: ""}]
    : []

  Box {
    fill: true
    background: background
    // ---- what stays put: the table --------------------------------------------------------------------
    Canvas {
      fill: true
      if G && live {
        let tx = LS ? 120 : 6
        let tw = LS ? BAW + 8 : SW - 12
        // the table, and a lane for each side's minions
        rect(tx, EBY - MH / 2 - 14, tw, PBY - EBY + MH + 28, radius: 8 * corners, fill: "#3a2e24")
        rect(tx + 4, EBY - MH / 2 - 10, tw - 8, PBY - EBY + MH + 20, radius: 6 * corners, fill: "#5a4632")
        for k in range(ceil((PBY - EBY + MH + 20) / 18)) {
          rect(tx + 4, EBY - MH / 2 - 10 + k * 18, tw - 8, 1, fill: "#4e3c2a")
        }
        for s in [0, 1] {
          rect(tx + 10, BY[s] - MH / 2 - 5, tw - 20, MH + 10, radius: 5 * corners, fill: alpha(s == 0 ? "#4a8ae8" : "#e8504a", 0.13))
        }
        rect(tx + 10, MID - 1, tw - 20, 2, fill: "#3a2e24")
        // the heroes' frames
        for s in [0, 1] {
          let F = s == 0 ? {el: 0} : FOES[foe]
          rect(HXc - 36, HYS[s] - 36, 72, 72, radius: 8 * corners, fill: INK)
          rect(HXc - 33, HYS[s] - 33, 66, 66, radius: 6 * corners, fill: s == 0 ? "#4a78b8" : EL[F.el].f)
          rect(HXc - 30, HYS[s] - 30, 60, 60, radius: 4 * corners, fill: s == 0 ? "#22344e" : EL[F.el].d)
        }
      }
    }
    // ---- what moves: the heroes, the minions, and what an action set going ----------------------------
    Canvas {
      fill: true
      if G && live {
        let anim = busy || selH >= 0 || selM >= 0
        let now = !busy ? 999 : fxAt == -1 ? 0 : time < fxAt - 1 ? 999 : time - fxAt
        let tt = anim ? time : 0
        let FX = busy ? fx : []
        // ---- the heroes ----
        for s in [0, 1] {
          let t = s * 10
          let H = hr[s]
          let hs = (H.hp ?? 0) + sum([0] + FX.filter(f => f.k == "hit" && f.t == t && now < f.t0).map(f => f.d)) - sum([0] + FX.filter(f => f.k == "heal" && f.t == t && now < f.t0).map(f => f.n))
          let fl = any(FX, f => f.k == "hit" && f.t == t && now >= f.t0 && now < f.t0 + 0.14)
          let sx = HXc - 28 + (fl ? (hash(floor(tt * 60), s) - 0.5) * 6 : 0)
          if fl {
            sprite(HSP[s == 0 ? 0 : FOES[foe].sp], sx, HYS[s] - 28, 3.5, color: "#ffffff")
          } else {
            sprite(HSP[s == 0 ? 0 : FOES[foe].sp], sx, HYS[s] - 28, 3.5, palette: HPL[s == 0 ? 0 : foe + 1])
          }
          // health
          circle(HXc + 30, HYS[s] + 28, 15, fill: INK)
          circle(HXc + 30, HYS[s] + 28, 12.5, fill: hs < (H.mh ?? 30) ? "#c8323a" : "#e8504a")
          text("${max(0, hs)}", HXc + 30.5, HYS[s] + 28.5, size: hs >= 10 ? 9 : 10, color: "#ffffff", font: press, align: center)
          // a target for what's picked
          if indexOf(VT, t) >= 0 && myTurn {
            let a = 0.55 + 0.4 * sin(tt * 6)
            rect(HXc - 39, HYS[s] - 39, 78, 78, radius: 9 * corners, stroke: alpha(selM >= 0 || (selC != null && (selC.ef[0].e == "dmg" || selC.ef[0].e == "kill")) ? "#ff5a4a" : "#ffe14a", a), width: 3)
          }
        }
        // ---- the minions ----
        for s in [0, 1] {
          for m, i in bd[s] {
            let t = s * 10 + 1 + i
            let x0 = SLX[s][i]
            let y0 = BY[s] - MH / 2
            let hs = m.h + sum([0] + FX.filter(f => (f.k == "hit" || f.k == "kill") && f.t == t && now < f.t0).map(f => f.d))
            let lh = max([-9] + FX.filter(f => (f.k == "hit" || f.k == "kill") && f.t == t).map(f => f.t0))
            let gone = m.h <= 0 && (lh < -1 || now > lh + 0.6)
            let sp = FX.find(f => f.k == "spawn" && f.u == m.u)
            let hid = sp != null && now < sp.t0
            if !gone && !hid {
              let fade = m.h <= 0 && hs <= 0 ? clamp(1 - (now - lh - 0.1) / 0.45, 0, 1) : 1
              let ps = sp != null && now < sp.t0 + 0.25 ? 0.6 + 0.4 * (now - sp.t0) / 0.25 : 1
              let lg = FX.find(f => f.k == "lunge" && f.f == t && now >= f.t0 && now < f.t0 + 0.36)
              let le = lg == null ? 0 : sin((now - lg.t0) / 0.36 * 3.1416) * 0.75
              let dx = lg == null ? 0 : (CEN[lg.t].x - CEN[t].x) * le
              let dy = lg == null ? 0 : (CEN[lg.t].y - CEN[t].y) * le
              let fl = any(FX, f => f.k == "hit" && f.t == t && now >= f.t0 && now < f.t0 + 0.14)
              let shk = fl ? (hash(floor(tt * 60), t) - 0.5) * 6 : 0
              let up = s == 0 && i == selM ? -8 : 0
              let shs = m.sh || any(FX, f => f.k == "pop" && f.t == t && now < f.t0)
              let C = CD[m.c]
              let E = EL[C.el]
              let X = x0 + dx + shk
              let Y = y0 + dy + up
              layer(fade) {
                scale(ps, ps, X + MW / 2, Y + MH / 2) {
                  rect(X + 2, Y + 4, MW, MH, radius: 6, fill: alpha("#000000", 0.35))
                  if m.tn {
                    rect(X - 4, Y - 4, MW + 8, MH + 8, radius: 8, fill: INK)
                    rect(X - 2, Y - 2, MW + 4, MH + 4, radius: 7, fill: "#a8a4b4")
                  }
                  rect(X, Y, MW, MH, radius: 6, fill: INK)
                  rect(X + 2, Y + 2, MW - 4, MH - 4, radius: 5, fill: RIM[C.r])
                  rect(X + 4, Y + 4, MW - 8, MH - 8, radius: 4, fill: E.f)
                  rect(X + 6, Y + 6, MW - 12, 12 * SPS + 4, radius: 3, fill: E.d)
                  if fl {
                    sprite(IC[m.c], X + MW / 2 - 6 * SPS, Y + 8, SPS, color: "#ffffff")
                  } else {
                    sprite(IC[m.c], X + MW / 2 - 6 * SPS, Y + 8, SPS, palette: CPL[m.c])
                  }
                  text(C.n, X + MW / 2, Y + 16 + 12 * SPS, size: min(5, (MW - 8) / len(C.n)), color: "#ffffff", font: press, align: center)
                  if m.fz {
                    rect(X + 4, Y + 4, MW - 8, MH - 8, radius: 4, fill: alpha("#9ae0ff", 0.4))
                    rect(X + 4, Y + 4, MW - 8, 4, fill: "#e8f8ff")
                    rect(X + 4, Y + 4, 4, 14, fill: "#e8f8ff")
                    rect(X + MW - 8, Y + 4, 4, 14, fill: "#e8f8ff")
                  }
                  if m.po { sprite(SP_DROP, X + 7, Y + 8, 2, palette: ICP) }
                  if m.ls { sprite(SP_HEART, X + MW - 17, Y + 8, 2, palette: ICP) }
                  if shs {
                    rect(X - 3, Y - 3, MW + 6, MH + 6, radius: 8, fill: alpha("#ffe14a", 0.16), stroke: alpha("#ffe14a", 0.9), width: 2)
                  }
                  // attack and health
                  circle(X + 11, Y + MH - 11, 11, fill: INK)
                  circle(X + 11, Y + MH - 11, 9, fill: "#f4b840")
                  text("${m.a}", X + 11.5, Y + MH - 10.5, size: 8, color: m.a > (C.a ?? 0) ? "#1e6a1e" : INK, font: press, align: center)
                  circle(X + MW - 11, Y + MH - 11, 11, fill: INK)
                  circle(X + MW - 11, Y + MH - 11, 9, fill: "#e8504a")
                  text("${max(0, hs)}", X + MW - 10.5, Y + MH - 10.5, size: 8, color: hs < m.mh ? "#ffe0a0" : "#ffffff", font: press, align: center)
                  // whose it is to use
                  if s == 0 && myTurn && CANA[i] {
                    rect(X - 1, Y - 1, MW + 2, MH + 2, radius: 7, stroke: i == selM ? "#ffe14a" : "#5aff6a", width: 2.5)
                  }
                  if s == 0 && cur == 0 && m.h > 0 && (m.zz ?? false) && !busy {
                    sprite(SP_ZZ, X + MW - 16, Y - 4 - (floor(tt * 1.5) % 2) * 2, 2, palette: {o: "#ffffff"})
                  }
                  if indexOf(VT, t) >= 0 && myTurn {
                    let a = 0.55 + 0.4 * sin(tt * 6)
                    rect(X - 4, Y - 4, MW + 8, MH + 8, radius: 8, stroke: alpha(selM >= 0 || (selC != null && (selC.ef[0].e == "dmg" || selC.ef[0].e == "kill")) ? "#ff5a4a" : "#ffe14a", a), width: 3)
                  }
                  if t == insp { rect(X - 2, Y - 2, MW + 4, MH + 4, radius: 7, stroke: "#ffffff", width: 2) }
                }
              }
            }
          }
        }
        // ---- what the last action set going ----
        for f in FX {
          if f.k == "zap" && now >= f.t0 && now < f.t0 + 0.22 {
            let e2 = (now - f.t0) / 0.22
            let zx = lerp(CEN[f.f].x, CEN[f.t].x, e2)
            let zy = lerp(CEN[f.f].y, CEN[f.t].y, e2)
            circle(zx, zy, 9, fill: alpha(f.c, 0.35))
            circle(zx, zy, 5, fill: f.c)
            circle(zx, zy, 2.5, fill: "#ffffff")
          } else if f.k == "wave" && now >= f.t0 && now < f.t0 + 0.35 {
            let e2 = (now - f.t0) / 0.35
            let tx = LS ? 124 : 12
            let tw = LS ? BAW : SW - 24
            rect(tx, BY[f.s] - MH / 2 - 4, tw * e2, MH + 8, radius: 6, fill: alpha(f.c, 0.3 * (1 - e2 * 0.5)))
            rect(tx + tw * e2 - 6, BY[f.s] - MH / 2 - 4, 6, MH + 8, fill: alpha(f.c, 0.8))
          } else if (f.k == "hit" || f.k == "heal" || f.k == "kill") && now >= f.t0 && now < f.t0 + 0.9 {
            let e2 = (now - f.t0) / 0.9
            let hx = CEN[f.t].x
            let hy = CEN[f.t].y - 10 - e2 * 26
            let lab = f.k == "kill" ? "DESTROYED" : f.k == "heal" ? "+${f.n}" : "-${f.n}"
            let sz = f.k == "kill" ? 8 : 14
            layer(clamp((1 - e2) * 3, 0, 1)) {
              if f.k == "hit" {
                let r0 = 16 + 6 * (1 - e2)
                circle(hx, hy + 2, r0, fill: alpha("#e8323a", 0.85))
              }
              text(lab, hx + 1.5, hy + 1.5, size: sz, color: INK, font: press, align: center)
              text(lab, hx, hy, size: sz, color: f.k == "heal" ? "#8aff7a" : f.k == "kill" ? "#d8a8ff" : "#ffffff", font: press, align: center)
            }
          } else if f.k == "pop" && now >= f.t0 && now < f.t0 + 0.6 {
            let e2 = (now - f.t0) / 0.6
            let hx = CEN[f.t].x
            let hy = CEN[f.t].y
            circle(hx, hy, MW * 0.5 + e2 * 24, stroke: alpha("#ffe14a", 1 - e2), width: 4)
            text("SHIELD", hx, hy - 16 - e2 * 16, size: 7, color: alpha("#ffe14a", 1 - e2), font: press, align: center)
          } else if f.k == "txt" && now >= f.t0 && now < f.t0 + 1.0 {
            let e2 = now - f.t0
            let hx = CEN[f.t].x
            let hy = CEN[f.t].y - 30 - e2 * 16
            layer(clamp((1 - e2) * 3, 0, 1)) {
              text(f.s, hx + 1, hy + 1, size: 7, color: INK, font: press, align: center)
              text(f.s, hx, hy, size: 7, color: f.c, font: press, align: center)
            }
          } else if f.k == "ban" && now >= f.t0 && now < f.t0 + 0.8 {
            let e2 = (now - f.t0) / 0.8
            let a = clamp(min(e2 * 8, (1 - e2) * 6), 0, 1)
            layer(a) {
              rect(0, MID - 30, SW, 60, fill: alpha(INK, 0.9))
              rect(0, MID - 30, SW, 2, fill: f.c)
              rect(0, MID + 28, SW, 2, fill: f.c)
              text(f.s, SW / 2 + (1 - a) * 30, MID - (f.s2 == "" ? 0 : 8), size: min(16, (SW - 30) / len(f.s)), color: f.c, font: press, align: center)
              if f.s2 != "" { text(f.s2, SW / 2 - (1 - a) * 30, MID + 13, size: 7, color: "#d8d4ec", font: press, align: center) }
            }
          }
        }
      }
    }
    // ---- the panels, words and cards; taps land here ----------------------------------------------------
    Canvas {
      fill: true
      onPress: { downAt = [x, y] }
      onRelease: { downAt = [-1, -1] }
      ripple: false
      onTap: {
        let b = BT.find(z => !(z.dis ?? false) && x >= z.x && x < z.x + z.w && y >= z.y && y < z.y + z.h)
        if b != null {
          if b.id == "play" {
            mode = live ? "game" : "ladder"
          } else if b.id == "deck" {
            mode = "deck"
          } else if b.id == "shop" {
            mode = "shop"
          } else if b.id == "home" || b.id == "menu" {
            mode = "title"
            selH = -1
            selM = -1
            insp = -1
          } else if b.id == "auto" {
            deck = flatten(range(NCOL).map(c => range(min(col[c], MAXC[c])).map(z => c))).sortBy(c => -CD[c].r * 10 + abs(CD[c].c - 3.5) + c * 0.001).take(20)
            haptic()
          } else if b.id == "buy" {
            let picks = range(5).map(k => [random()].map(z => k == 4 ? (z < 0.05 ? 3 : z < 0.25 ? 2 : 1) : (z < 0.01 ? 3 : z < 0.05 ? 2 : z < 0.25 ? 1 : 0))[0]).map(r => POOL[r][random(len(POOL[r]))])
            let RS = reduce(picks, (A, c) => A.col[c] >= MAXC[c] ? merge(A, {p: A.p + [{c: c, f: false, g: SPARE[CD[c].r], nw: false}], g: A.g + SPARE[CD[c].r]}) : merge(A, {col: set(A.col, c, A.col[c] + 1), p: A.p + [{c: c, f: false, g: 0, nw: A.col[c] == 0}]}), {col: col, p: [], g: 0})
            col = RS.col
            pack = RS.p
            gold = gold - 100 + RS.g
            haptic()
          } else if b.id == "flip" {
            pack = pack.map(z => merge(z, {f: true}))
            haptic()
          } else if b.id == "done" {
            pack = []
          } else if b.id == "fin" {
            live = false
            over = 0
            mode = "ladder"
          } else if b.id == "end" {
            selH = -1
            selM = -1
            insp = -1
            busy = true
            rsv = true
            endQ = endQ + 1
          }
        } else if mode == "ladder" {
          let f = range(8).find(k => y >= LY + k * LH && y < LY + (k + 1) * LH - 4)
          if f != null && OPEN[f] {
            if len(deck) == 20 {
              foe = f
              startQ = startQ + 1
              haptic()
            } else {
              mode = "deck"
            }
          }
        } else if mode == "deck" {
          let tb = floor((x - 12) / TBW)
          let gk = range(8).find(k => x >= GRID[k].x && x < GRID[k].x + 80 * GS && y >= GRID[k].y && y < GRID[k].y + 112 * GS)
          let dj = range(len(DKU)).find(j => x >= 10 + (j % 2) * (DLW + 10) && x < 10 + (j % 2) * (DLW + 10) + DLW && y >= DLY + floor(j / 2) * DLH && y < DLY + floor(j / 2) * DLH + DLH)
          if y >= TBY && y < TBY + 32 && tb >= 0 && tb < 6 {
            tab = tb
          } else if gk != null {
            let c = GRID[gk].c
            if len(deck) < 20 && INDK[c] < min(col[c], MAXC[c]) {
              deck = deck + [c]
              haptic()
            }
          } else if dj != null {
            deck = remove(deck, indexOf(deck, DKU[dj]))
          }
        } else if mode == "shop" && len(pack) > 0 {
          let pj = range(len(pack)).find(j => x >= PKC[j].x && x < PKC[j].x + 80 * PKS && y >= PKC[j].y && y < PKC[j].y + 112 * PKS)
          if pj != null && !pack[pj].f {
            pack = set(pack, pj, merge(pack[pj], {f: true}))
            haptic()
          }
        } else if G && live && over == 0 && !busy {
          // a card in the hand, a hero or a minion
          let hj = selH >= 0 && selH < HN && x >= HL[selH].x && x < HL[selH].x + CW && y >= HL[selH].y && y < HL[selH].y + CH ? selH : reverse(range(HN)).find(j => j != selH && x >= HL[j].x && x < HL[j].x + (j == HN - 1 ? CW : min(CW, HST)) && y >= HL[j].y && y < HL[j].y + CH) ?? -1
          let tc = ([0, 10] + AL[0].map(i => 1 + i) + AL[1].map(i => 11 + i)).find(t => abs(x - CEN[t].x) < (t % 10 == 0 ? 36 : MW / 2 + 2) && abs(y - CEN[t].y) < (t % 10 == 0 ? 36 : MH / 2 + 2)) ?? -1
          let onPV = PV != null && x >= PVX && x < PVX + 80 * PVS && y >= PVY && y < PVY + 112 * PVS
          if hj >= 0 {
            if hj == selH {
              if myTurn && CANP[hj] && (selC.tg == null || (selC.t == 0 && len(VT) == 0)) {
                act = {k: "play", s: 0, j: hj, t: -1}
                busy = true
                rsv = true
                selH = -1
                actQ = actQ + 1
                haptic()
              } else {
                selH = -1
              }
            } else {
              selH = hj
              selM = -1
              insp = -1
            }
          } else if selH >= 0 {
            if myTurn && CANP[selH] && tc >= 0 && indexOf(VT, tc) >= 0 {
              act = {k: "play", s: 0, j: selH, t: tc}
              busy = true
              rsv = true
              selH = -1
              actQ = actQ + 1
              haptic()
            } else if myTurn && CANP[selH] && (selC.tg == null || (selC.t == 0 && len(VT) == 0)) && (onPV || (y > PBY - MH / 2 - 20 && y < PBY + MH / 2 + 20)) {
              act = {k: "play", s: 0, j: selH, t: -1}
              busy = true
              rsv = true
              selH = -1
              actQ = actQ + 1
              haptic()
            } else {
              selH = -1
            }
          } else if selM >= 0 {
            if myTurn && tc >= 0 && indexOf(VT, tc) >= 0 {
              act = {k: "atk", s: 0, i: selM, t: tc}
              busy = true
              rsv = true
              selM = -1
              actQ = actQ + 1
              haptic()
            } else if tc >= 1 && tc < 10 && CANA[tc - 1] && tc - 1 != selM {
              selM = tc - 1
            } else {
              selM = -1
            }
          } else if tc >= 1 && tc < 10 && myTurn && CANA[tc - 1] {
            selM = tc - 1
            insp = -1
          } else if tc >= 0 && tc % 10 != 0 {
            insp = insp == tc ? -1 : tc
          } else {
            insp = -1
          }
        }
      }
      // ---- the match: mana, decks, hands, words ----
      if G && live {
        for s in [0, 1] {
          let H = hr[s]
          let hy = HYS[s]
          let mx0 = LS ? HXc - 34 : HXc + 46
          let my0 = LS ? hy + 46 : hy - 6
          // mana: crystals full, spent, and still to come
          text("${H.m ?? 0}/${H.mx ?? 0}", mx0, my0, size: 8, color: "#8ac8ff", font: press)
          for k in range(LS ? 0 : 10) {
            let gx = mx0 + k * 10
            let gy = my0 + 10
            let st = k < (H.m ?? 0) ? 2 : k < (H.mx ?? 0) ? 1 : 0
            path([[gx + 4, gy], [gx + 8, gy + 4], [gx + 4, gy + 8], [gx, gy + 4]], closed: true, fill: st == 2 ? "#4a9aff" : st == 1 ? "#2a3a5a" : alpha(foreground, 0.08))
          }
          // the draw pile and, for the foe, its hand
          let lx = LS ? HXc - 34 : HXc - 46
          let ly = LS ? hy + 58 : hy - 6
          text("DECK ${len(dk[s])}", lx, ly, size: 6, color: muted, font: press, align: LS ? "start" : "end")
          if s == 1 {
            let nh = len(hd[1])
            for k in range(nh) {
              let bx = LS ? HXc - 34 + k * 7 : HXc - 46 - 14 - k * 9
              let by = LS ? hy + 64 : hy + 6
              rect(bx, by, 14, 20, radius: 2, fill: INK)
              rect(bx + 1.5, by + 1.5, 11, 17, radius: 1.5, fill: "#5a3a8a")
              rect(bx + 5, by + 7, 4, 6, fill: "#ffd04a")
            }
            text(LS ? "" : FOES[foe].n, HXc + 46, hy + 22, size: 7, color: foreground, font: press)
          }
        }
        // a hint for what's picked
        let hint = !myTurn ? "" : selC != null ? (!CANP[selH] ? (selC.c > hr[0].m ? "NOT ENOUGH MANA" : selC.t == 0 ? "YOUR BOARD IS FULL" : "NOTHING TO AIM AT") : len(VT) > 0 ? "PICK A TARGET" : "TAP AGAIN TO PLAY") : selM >= 0 ? (len(TN1) > 0 ? "A TAUNT IS IN THE WAY" : "PICK WHAT TO ATTACK") : idle ? "NOTHING LEFT TO DO" : ""
        if hint != "" {
          text(hint, LS ? BCX : SW / 2, PBY - MH / 2 - 14, size: 6, color: hint == "PICK A TARGET" || hint == "PICK WHAT TO ATTACK" || hint == "TAP AGAIN TO PLAY" ? "#ffe14a" : "#ff9a7a", font: press, align: center)
        }
        if PV != null && PV.lab != "" {
          text(PV.lab, PVX + 40 * PVS, PVY - 8, size: 7, color: "#ff8a6a", font: press, align: center)
        }
      }
      // ---- the title ----
      if mode == "title" {
        let ls = min(28, (SW - 30) / 9)
        let ty = SH * 0.14
        text("RUNECLASH", SW / 2 + 3, ty + 3, size: ls, color: INK, font: press, align: center)
        text("RUNECLASH", SW / 2, ty, size: ls, color: accent, font: press, align: center)
        text("A PIXEL CARD GAME", SW / 2, ty + ls + 12, size: 7, color: muted, font: press, align: center)
        text("${gold} GOLD   ${len(beat)}/8 FOES   ${len(range(NCOL).filter(c => col[c] > 0))}/${NCOL} CARDS", SW / 2, SH * 0.62 - 20, size: 6, color: "#ffd04a", font: press, align: center)
      }
      // ---- the ladder ----
      if mode == "ladder" {
        text("THE LADDER", SW / 2, TOP + 24, size: 11, color: accent, font: press, align: center)
        text(len(deck) == 20 ? "PICK A FOE" : "YOUR DECK NEEDS 20 CARDS", SW / 2, TOP + 44, size: 6, color: len(deck) == 20 ? muted : "#ff8a6a", font: press, align: center)
        for F, k in FOES {
          let y0 = LY + k * LH
          let op = OPEN[k]
          let won = indexOf(beat, k) >= 0
          let ps = min(3.5, (LH - 12) / 16)
          rect(10, y0, SW - 20, LH - 4, radius: 6 * corners, fill: op ? surface : alpha(surface, 0.4), stroke: won ? "#5ac85a" : alpha(foreground, 0.15), width: won ? 2 : 1)
          rect(16, y0 + (LH - 4) / 2 - 8 * ps - 2, 16 * ps + 4, 16 * ps + 4, radius: 3, fill: EL[F.el].d)
          layer(op ? 1 : 0.3) {
            sprite(HSP[F.sp], 18, y0 + (LH - 4) / 2 - 8 * ps, ps, palette: HPL[k + 1])
          }
          let tx = 30 + 16 * ps
          text(op ? F.n : "???", tx, y0 + LH * 0.32, size: 9, color: op ? foreground : muted, font: press)
          text(op ? F.t : "LOCKED", tx, y0 + LH * 0.32 + 14, size: 6, color: muted, font: press)
          text(op ? "${EL[F.el].n} · ${F.hp} HP" : "", tx, y0 + LH * 0.32 + 26, size: 5, color: EL[F.el].f, font: press)
          text(won ? "BEATEN" : op ? "FIGHT" : "", SW - 22, y0 + (LH - 4) / 2, size: 7, color: won ? "#5ac85a" : "#ffd04a", font: press, align: end)
        }
      }
      // ---- the deck builder ----
      if mode == "deck" {
        text("DECK ${len(deck)}/20", 66, TOP + 24, size: 10, color: len(deck) == 20 ? accent : "#ff8a6a", font: press)
        for c, j in DKU {
          let dx = 10 + (j % 2) * (DLW + 10)
          let dy = DLY + floor(j / 2) * DLH
          let C = CD[c]
          rect(dx, dy, DLW, DLH - 3, radius: 3, fill: EL[C.el].d, stroke: RIM[C.r], width: 1)
          circle(dx + 8, dy + (DLH - 3) / 2, 6.5, fill: "#3a7ae8")
          text("${C.c}", dx + 8.5, dy + (DLH - 3) / 2 + 0.5, size: 6, color: "#ffffff", font: press, align: center)
          text(C.n, dx + 18, dy + (DLH - 3) / 2, size: min(6, (DLW - 44) / len(C.n)), color: "#ffffff", font: press)
          if INDK[c] > 1 { text("x${INDK[c]}", dx + DLW - 5, dy + (DLH - 3) / 2, size: 6, color: "#ffd04a", font: press, align: end) }
        }
        if len(DKU) == 0 { text("TAP CARDS BELOW TO ADD THEM", SW / 2, DLY + 60, size: 6, color: muted, font: press, align: center) }
        for e, k in EL {
          let bx = 12 + k * TBW
          rect(bx + 2, TBY, TBW - 4, 30, radius: 4 * corners, fill: k == tab ? e.f : alpha(e.f, 0.25), stroke: k == tab ? "#ffffff" : alpha(foreground, 0.15), width: 1)
          text(e.s, bx + TBW / 2, TBY + 15, size: min(6, (TBW - 10) / len(e.s)), color: "#ffffff", font: press, align: center)
        }
        for g in GRID {
          let own = col[g.c] ?? 0
          text(own == 0 ? "NOT OWNED" : "${INDK[g.c]}/${min(own, MAXC[g.c])} IN DECK", g.x + 40 * GS, g.y + 112 * GS + 9, size: 5, color: own == 0 ? muted : INDK[g.c] > 0 ? "#ffd04a" : foreground, font: press, align: center)
        }
        text("TAP A CARD TO ADD IT, A ROW TO TAKE IT OUT", SW / 2, SH - INS - 8, size: 5, color: muted, font: press, align: center)
      }
      // ---- the packs ----
      if mode == "shop" {
        text("CARD PACKS", SW / 2, TOP + 24, size: 11, color: accent, font: press, align: center)
        text("${gold} GOLD", SW / 2, TOP + 44, size: 7, color: "#ffd04a", font: press, align: center)
        if len(pack) == 0 {
          // a pack, in foil
          let pw = min(150, SW * 0.4)
          let ph = pw * 1.4
          let px = SW / 2 - pw / 2
          let py = TOP + 80
          rect(px + 4, py + 6, pw, ph, radius: 6, fill: alpha("#000000", 0.35))
          rect(px, py, pw, ph, radius: 6, fill: INK)
          rect(px + 3, py + 3, pw - 6, ph - 6, radius: 4, fill: "#6a3aa8")
          rect(px + 3, py + 3, pw - 6, 14, fill: "#8a5ad8")
          rect(px + 3, py + ph - 17, pw - 6, 14, fill: "#8a5ad8")
          for k in range(6) { rect(px + 6 + k * (pw - 12) / 6, py + 6, 3, 8, fill: "#c8a0ff") }
          sprite(SP_RUNE, px + pw / 2 - 30, py + ph / 2 - 40, 6, palette: {o: INK, Y: "#ffd04a"})
          text("RUNECLASH", px + pw / 2, py + ph - 36, size: min(9, (pw - 16) / 9), color: "#ffffff", font: press, align: center)
          text("5 CARDS, ONE RARE OR BETTER", SW / 2, py + ph + 24, size: 6, color: foreground, font: press, align: center)
          text("SPARE COPIES TURN INTO GOLD", SW / 2, py + ph + 40, size: 5, color: muted, font: press, align: center)
        } else {
          for p, j in pack {
            if p.f {
              let C = CD[p.c]
              text(p.g > 0 ? "SPARE +${p.g} GOLD" : p.nw ? "NEW!" : RN[C.r], PKC[j].x + 40 * PKS, PKC[j].y + 112 * PKS + 12, size: 5, color: p.g > 0 ? "#ffd04a" : p.nw ? "#8aff7a" : RIM[C.r], font: press, align: center)
            }
          }
          text(all(pack, z => z.f) ? "" : "TAP A CARD TO TURN IT OVER", SW / 2, SH - INS - 84, size: 6, color: muted, font: press, align: center)
        }
      }
      // ---- every card on screen ----
      for k in CARDS {
        let C = CD[k.c]
        let E = EL[C.el]
        let M = k.mn
        rotate(k.r ?? 0, k.x + 40 * k.s, k.y + 56 * k.s) {
          scale(k.s, k.s, k.x, k.y) {
            layer(k.dim ? 0.5 : 1) {
              rect(k.x + 1, k.y + 4, 80, 112, radius: 5, fill: alpha("#000000", 0.35))
              rect(k.x, k.y, 80, 112, radius: 5, fill: INK)
              if k.back ?? false {
                rect(k.x + 2, k.y + 2, 76, 108, radius: 4, fill: "#8a5ad8")
                rect(k.x + 5, k.y + 5, 70, 102, radius: 3, fill: "#4e2a7a")
                rect(k.x + 9, k.y + 9, 62, 94, radius: 2, stroke: "#8a5ad8", width: 1.5)
                sprite(SP_RUNE, k.x + 25, k.y + 41, 3, palette: {o: INK, Y: "#ffd04a"})
              } else {
                rect(k.x + 2, k.y + 2, 76, 108, radius: 4, fill: RIM[C.r])
                rect(k.x + 4, k.y + 4, 72, 104, radius: 3, fill: E.f)
                rect(k.x + 8, k.y + 7, 64, 42, radius: 2, fill: E.d)
                rect(k.x + 8, k.y + 7, 64, 2, fill: alpha("#000000", 0.3))
                sprite(IC[k.c], k.x + 22, k.y + 10, 3, palette: CPL[k.c])
                rect(k.x + 5, k.y + 51, 70, 12, radius: 2, fill: INK)
                text(C.n, k.x + 40, k.y + 57.5, size: min(6, 66 / len(C.n)), color: "#ffffff", font: press, align: center)
                rect(k.x + 7, k.y + 65, 66, 39, radius: 2, fill: "#efe4c8")
                for ln, j in TXT[k.c] {
                  text(ln, k.x + 40, k.y + 71 + j * 8, size: min(7, 104 / len(ln)), color: j == 0 && C.t == 0 && TXT[k.c][0] != (C.x ?? [""])[0] ? "#6a3a10" : INK, bold: true, align: center)
                }
                circle(k.x + 8, k.y + 8, 9.5, fill: INK)
                circle(k.x + 8, k.y + 8, 8, fill: "#3a7ae8")
                text("${C.c}", k.x + 8.5, k.y + 8.5, size: 8, color: "#ffffff", font: press, align: center)
                if C.t == 0 {
                  let av = M == null ? C.a : M.a
                  let hv = M == null ? C.h : max(0, M.h)
                  circle(k.x + 9, k.y + 103, 9.5, fill: INK)
                  circle(k.x + 9, k.y + 103, 8, fill: "#f4b840")
                  text("${av}", k.x + 9.5, k.y + 103.5, size: 8, color: av > C.a ? "#1e6a1e" : INK, font: press, align: center)
                  circle(k.x + 71, k.y + 103, 9.5, fill: INK)
                  circle(k.x + 71, k.y + 103, 8, fill: "#e8504a")
                  text("${hv}", k.x + 71.5, k.y + 103.5, size: 8, color: M != null && M.h < M.mh ? "#ffe0a0" : "#ffffff", font: press, align: center)
                } else {
                  rect(k.x + 26, k.y + 104, 28, 8, radius: 2, fill: INK)
                  text("SPELL", k.x + 40, k.y + 108, size: 4, color: "#ffffff", font: press, align: center)
                }
              }
              if k.glow != "" { rect(k.x - 2, k.y - 2, 84, 116, radius: 6, stroke: k.glow, width: 2.5) }
            }
          }
        }
      }
      // ---- the end of a match ----
      if G && live && over != 0 && !busy {
        let vic = over == 1
        rect(0, 0, SW, SH, fill: alpha(INK, 0.6))
        rect(18, MID - 90, SW - 36, 130, radius: 6 * corners, fill: vic ? "#2e5a2e" : "#5a1e26", stroke: INK, width: 3)
        text(vic ? "VICTORY" : "DEFEAT", SW / 2 + 2, MID - 52, size: 18, color: INK, font: press, align: center)
        text(vic ? "VICTORY" : "DEFEAT", SW / 2, MID - 54, size: 18, color: "#ffffff", font: press, align: center)
        text(vic ? "${FOES[foe].n} IS BEATEN" : "${FOES[foe].n} WINS THIS TIME", SW / 2, MID - 18, size: 7, color: "#e8e4f4", font: press, align: center)
        text("+${rwd} GOLD", SW / 2, MID + 10, size: 10, color: "#ffd04a", font: press, align: center)
      }
      // ---- the buttons ----
      for b in BT {
        let P = get(BTN, b.p, BTN.off)
        let off = b.dis ?? false
        let pd = !off && downAt[0] >= b.x && downAt[0] < b.x + b.w && downAt[1] >= b.y && downAt[1] < b.y + b.h ? 3 : 0
        rect(b.x, b.y + 4, b.w, b.h - 4, radius: 4, fill: P[3])
        rect(b.x, b.y + pd, b.w, b.h - 4, radius: 4, fill: P[1], stroke: INK, width: 2)
        rect(b.x + 3, b.y + pd + 3, b.w - 6, 3, radius: 1.5, fill: P[0])
        rect(b.x + 3, b.y + pd + b.h - 12, b.w - 6, 4, radius: 2, fill: P[2])
        let ls = min(11, (b.w - 14) / max(1, len(b.l)))
        let ly = b.y + pd + (b.h - 4) / 2 - (b.l2 == null ? 0 : 7)
        text(b.l, b.x + b.w / 2 + 1, ly + 1, size: ls, color: INK, font: press, align: center)
        text(b.l, b.x + b.w / 2, ly, size: ls, color: off ? "#b8b2d0" : "#ffffff", font: press, align: center)
        if b.l2 != null {
          text(b.l2, b.x + b.w / 2, ly + 15, size: min(7, (b.w - 12) / len(b.l2)), color: off ? "#b8b2d0" : "#ffffff", font: press, align: center)
        }
        if b.id == "menu" {
          for k in range(3) { rect(b.x + 12, b.y + pd + 7 + k * 5, 18, 2, fill: "#ffffff") }
        }
      }
    }
  }
}
