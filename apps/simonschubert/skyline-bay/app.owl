      {k: 0, x: 0.05, y: 0, z: 0.22, w: 0.66, h: 0.2, d: 0.3, c: #c9bfae, t: #8f99a5}]},
      {p: [
      {k: 0, x: -0.1, y: 0, z: 0, w: 0.6, h: 0.36, d: 0.6, c: #b5634a, t: #7e8b99},
      {k: 0, x: -0.1, y: 0.18, z: 0.305, w: 0.5, h: 0.08, d: 0.01, c: GL},
      {k: 0, x: 0.3, y: 0, z: 0.2, w: 0.2, h: 0.22, d: 0.3, c: #8b97a4},
