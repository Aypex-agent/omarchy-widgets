    <path d="M91.9 141.2 L52.0 161.2 L52.0 147.2 L91.9 127.2 Z" fill="#c9d3dd"/>
    <path d="M12.1 127.2 L52.0 147.2 L52.0 133.2 L12.1 113.2 Z" fill="#8fd0f2"/>
