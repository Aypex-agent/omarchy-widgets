      {k: 2, x: -0.2, y: 0.36, z: -0.02, w: 0.3, h: 0.08, d: 0.3, c: GL}]},
      {p: [
      {k: 3, x: 0, y: 0, z: 0, r: 0.34, r2: 0.34, h: 0.2, n: 10, c: #c9ced6, nt: true},
      {k: 3, x: 0, y: 0.2, z: 0, r: 0.3, r2: 0.3, h: 1.6, n: 10, c: #4f9fdc, nt: true},
      {k: 3, x: 0, y: 0.7, z: 0, r: 0.31, r2: 0.31, h: 0.04, n: 10, c: #e4eaf1, nt: true},
      {k: 3, x: 0, y: 1.25, z: 0, r: 0.31, r2: 0.31, h: 0.04, n: 10, c: #e4eaf1, nt: true},
