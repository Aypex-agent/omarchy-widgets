    <path d="M128.0 27.3 L171.7 49.2 L128.0 71.0 L84.3 49.2 Z" fill="#eef3f7"/>
    <path d="M128.0 48.2 L130.7 49.5 L130.7 31.5 L128.0 30.2 Z" fill="#ffc94a"/>
    <path d="M164.1 155.2 L204.0 175.2 L204.0 161.2 L164.1 141.2 Z" fill="#58c2c0"/>
    <path d="M243.9 155.2 L204.0 175.2 L204.0 161.2 L243.9 141.2 Z" fill="#3a9a98"/>
    <path d="M164.1 141.2 L204.0 161.2 L204.0 147.2 L164.1 127.2 Z" fill="#e8eef5"/>
    <path d="M243.9 141.2 L204.0 161.2 L204.0 147.2 L243.9 127.2 Z" fill="#c9d3dd"/>
    <path d="M164.1 127.2 L204.0 147.2 L204.0 133.2 L164.1 113.2 Z" fill="#58c2c0"/>
    <path d="M243.9 127.2 L204.0 147.2 L204.0 133.2 L243.9 113.2 Z" fill="#3a9a98"/>
    <path d="M164.1 113.2 L204.0 133.2 L204.0 119.2 L164.1 99.2 Z" fill="#e8eef5"/>
