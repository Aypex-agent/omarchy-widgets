      {p: [{k: 2, x: 0, y: 3.3, z: 0, w: 0.42, h: 0.2, d: 0.4, c: #58c2c0}],
      st: [{y: 0, f: 4, w: 0.8, d: 0.74, s: 0.05, b: 0.3, c: #eef2f6, g: #58c2c0}, {y: 1.45, f: 3, w: 0.6, d: 0.56, s: 0.05, b: 0.3, c: #eef2f6, g: #58c2c0}, {y: 2.55, f: 2, w: 0.4, d: 0.38, s: 0.05, b: 0.3, c: #eef2f6, g: #58c2c0}]},
      {p: [
