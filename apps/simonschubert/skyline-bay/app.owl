    <path d="M204.0 79.3 L243.9 99.2 L204.0 119.2 L164.1 99.2 Z" fill="#eef3f7"/>
    <path d="M12.1 155.2 L52.0 175.2 L52.0 161.2 L12.1 141.2 Z" fill="#8fd0f2"/>
