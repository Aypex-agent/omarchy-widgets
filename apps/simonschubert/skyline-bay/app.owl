  strings {
    en {
      // The maps' descriptions on the new-city cards (their names stay as they are), and the difficulties.
      mapD: ["A sheltered bay and a winding river", "Thick forest round a mountain lake", "Green hills round a deep harbor", "Lush land split by a river delta: bring bridges"]
      diff: ["EASY", "MEDIUM", "HARD"]
      solarNow: "POWER PLANTS ARE SOLAR FARMS NOW"
      // What a tile holds, by its number (0 is nothing); shown on the toolbar (upper case) and the tile's panel.
      tnames: ["", "Road", "Homes", "Shops", "Industry", "Woods", "Water", "Beach", "Subway", "Bulldoze", "Landfill", "Water Tower", "Park", "Police", "Fire Station", "Clinic", "School", "Solar Farm", "Plaza", "Stadium", "Bay Tower", "Battery", "Lab", "Launch Pad", "Bus Depot", "Bus Stop", "Station"]
      // A tool's tip, said once when it's picked.
      tipRoad: "TAP FOR ONE TILE · HOLD, THEN DRAG FOR A ROAD"
      tipTunnel: "HOLD AND DRAG TO DIG TUNNELS · AGAIN OVER ONE TO FILL IT IN"
      tipStop: "TAP A ROAD FOR A STOP ON ITS SIDEWALK · AGAIN TO REMOVE IT"
      tipFill: "TAP WATER BESIDE YOUR LAND TO FILL IT IN"
      tipZone: zone => "TAP, OR HOLD AND DRAG, TO ZONE ${zone}"
      tipClear: "TAP, OR HOLD AND DRAG, TO CLEAR"
      tipBuild: "TAP AN EMPTY TILE TO BUILD"
      // The toolbar's six tabs, about 60 dp each.
      cats: ["ROAD", "ZONE", "POWER", "SERVICE", "SPECIAL", "LAND"]
      // The city's levels, 1 to 9.
      levels: ["Hamlet", "Village", "Town", "Big Town", "City", "Big City", "Metropolis", "Megacity", "Capital"]
      // The lab's technologies: names and what they do, in the order the code keeps them.
      techN: ["Better Panels", "Lithium Cells", "Water Recycling", "Smart Grid", "Perovskite Cells", "Solid-State Cells", "Rocketry", "Reusable Boosters", "Space Solar", "Anti-Glare Glass", "Bifacial Panels", "Sun Tracking", "PERC Cells", "Tandem Cells", "Quantum Dot Cells", "LFP Cells", "Silicon Anodes", "Sodium-Ion Packs", "Lithium-Sulfur", "Graphene Cells", "AI Grid"]
      techD: ["Solar farms make 30% more", "Batteries hold 50% more", "Water towers pump 50% more", "Buildings use 15% less power", "Solar farms make 40% more", "Batteries hold 100% more", "Unlocks the launch pad", "Launches cost half and pay 50% more", "Farms make 25% more, and a quarter under clouds", "Solar farms make 15% more", "Panels catch light on both sides: 20% more", "Panels turn with the sun: 25% more", "Solar farms make 20% more", "Two layers of cells: 35% more", "Solar farms make 40% more", "Batteries hold 40% more", "Batteries hold 50% more", "Batteries hold 60% more", "Batteries hold 80% more", "Batteries hold 100% more", "Buildings use another 10% less power"]
      groups: ["SOLAR CELLS", "BATTERIES", "THE CITY", "SPACE"]
      weather: ["SUNNY", "PARTLY CLOUDY", "CLOUDY"]
      traffic: ["free", "light", "busy", "jammed"]
      // The cash's change a minute, under the cash: "+$120".
      perMin: v => "${v} /MIN"
      quests: ["Lay a road in from the highway", "Zone 6 homes beside the road", "Build a solar farm", "Reach 25 residents", "Build a battery for cloudy spells", "Zone 4 shops", "Zone 4 industry lots", "Build a water tower", "Plant a park", "Reach 100 residents", "Build a police station", "Build a fire station", "Grow 5 townhouses", "Reach 300 residents", "Buy a parcel of land", "Build a research lab", "Research a technology", "Build a clinic", "Build a school", "Build a plaza", "Provide 400 jobs", "Grow a high-rise", "Reach 1,000 residents", "Build a bus depot", "Put up 3 bus stops", "Research 4 technologies", "Reach 2,000 residents", "Link 2 subway stations", "Build the stadium", "Grow 10 high-rises", "Reach 5,000 residents", "Build the Bay Tower", "Research rocketry", "Build a launch pad", "Launch a rocket", "Reach 10,000 residents", "Grow a residential tower: transit near", "Fill in a tile of the sea (Land)", "Reach 15,000 residents"]
      // The demand panel.
      demand: ["HIGH", "SOME", "NONE", "TOO MANY"]
      zones: ["HOMES", "SHOPS", "INDUSTRY"]
      homesA: (jobs, workers, happy, tax) => "${jobs} jobs for ${workers} workers · ${happy}% happy · ${tax}% tax"
      shopsA: (jobs, want) => "${jobs} shop jobs · the people want about ${want}"
      indA: (jobs, want) => "${jobs} factory jobs · the people want about ${want}"
      homesGrow: n => n == 1 ? "1 home lot can grow now" : "${n} home lots can grow now"
      shopsGrow: n => n == 1 ? "1 shop lot can grow now" : "${n} shop lots can grow now"
      indGrow: n => n == 1 ? "1 industry lot can grow now" : "${n} industry lots can grow now"
      homesMore: "Zone more homes, or help lots grow: power, water, parks, services"
      noJobs: "Not enough jobs: zone shops and industry"
      unhappy: "People are unhappy: see City Hall"
      homesFull: "Homes are full for now: add jobs to grow"
      shopsMore: "Zone more shops beside a road"
      shopsEnough: "Enough shops for now: grow the population"
      indMore: "Zone more industry, away from homes"
      indEnough: "Enough industry for now: grow the population"
      // City Hall's advice, most pressing first.
      advice: ["Drag a road in from the highway on the left", "Running out of room: tap the dim land to buy more", "Zone homes, shops and industry along the road", "Some lots have no road out to the highway", "Nothing grows without power: build a solar farm", "Traffic jams: add roads, bus stops or a subway", "Link subway stations with tunnels", "Power is short even by day: build more solar farms", "Clouds darken the city: build batteries to store the sun", "Build a water tower so lots can grow past level 1", "Water is short: build another tower", "People need jobs: zone shops and industry", "Shops are wanted: zone more shops", "Industry is wanted: zone more lots", "People want to move in: zone more homes", "Factories next to homes make them unhappy", "Parks near homes raise land value", "Taxes are high and people grumble", "You're losing money: grow the city or raise taxes"]
      // A zoned lot's building by level (0 the empty lot): homes, shops, industry.
      znames: [["Home lot", "House", "Townhouses", "Apartments", "Residential Tower"], ["Shop lot", "Corner Shop", "Offices", "Skyscraper", "Supertall"], ["Industry lot", "Workshop", "Factory", "Plant", "Plant"]]
      forSale: "Land for sale"
      villas: ["Beach Villa", "Seaside Mansion"]
      // An empty tile, by map.
      grass: ["Grass", "Meadow", "Grass", "Grass"]
      // What a lot still wants to grow, joined with commas after wants().
      needCity: (n, now) => "city level ${n} (now ${now})"
      needWater: "water"
      needLand: (n, now) => "land value ${n} (now ${now})"
      needSvc: (n, now) => "services ${n} (now ${now}): police, fire, clinic, school closer"
      needTransit: "a bus stop or subway station near"
      needLab: "a research lab within 6 tiles"
      noRoad: "Needs a road out to the highway"
      darkNow: "Dark: not enough power right now"
      needPower: "Needs power to grow"
      grown: "Fully grown!"
      soon: "Building soon: there's demand"
      waiting: "Waiting for demand"
      wants: (name, list) => "To grow into ${name} it wants ${list}"
      readySoon: name => "Ready to grow into ${name}: lots take turns, so soon"
      readyDemand: name => "Ready to grow into ${name} once there's demand"
      // The parts of a lot's land value, after "Land value 2.5: 1 + ".
      lvPark: "park +1"
      lvSea: "sea view +1"
      lvPlaza: "plaza +1"
      lvTower: "Bay Tower +0.5"
      lvSvc: v => "services +${v}"
      lvSmog: "smog −2"
      lvTraffic: v => "traffic −${v}"
      // The panel of a tile looked at.
      parcelSale: "This parcel of the island is for sale"
      buyBeside: "Buy the land beside your city first"
      landTiles: n => "${n} tiles of land"
      residents: n => "${n} residents"
      jobs: n => "${n} jobs"
      utilities: (power, water, road) => "Power ${power ? "on" : "off"} · Water ${water ? "on" : "off"} · Road ${road ? "yes" : "no"}"
      landValue: v => "Land value ${v}"
      services: ["Police", "Fire", "Clinic", "School"]
      svcNone: "none"
      svcMin: n => "${n} min"
      trafficIs: word => "Traffic ${word}"
      buses: "buses"
      subway: "subway"
      solarMakes: n => "Makes ${n} power in full sun"
      spaceSolar: "Space solar keeps a quarter of it going under clouds"
      tenthClouds: "A tenth under clouds: batteries carry the city"
      upkeep: v => "Upkeep $${v} /min"
      battStores: n => "Stores ${n} power for cloudy spells"
      battAll: p => "All batteries ${p}% full"
      labDoes: "Researches new technology"
      labPlants: "Factories within 6 tiles can grow into plants"
      labCount: (done, all) => "${done} of ${all} researched · upkeep $60 /min"
      padDoes: "Sends satellites up for paying customers"
      rocketReady: (cost, pay) => "A rocket stands ready: $${cost} fuel, pays $${pay}"
      rocketIn: s => "Next rocket ready in ${s}s"
      towerPumps: n => "Pumps ${n} water for the city"
      parkRaises: "Raises land value 3 tiles around"
      parkHappy: "Makes nearby homes happier"
      svcReach: "Reaches the whole island: quickest within 3 tiles, slower further out"
      svcTall: "Tall buildings want all four services close by"
      plazaRaises: "Raises land value 4 tiles around"
      plazaLove: "Shops and homes love it"
      stadiumDoes: "Makes the whole city happier"
      bayTowerDoes: "The city's landmark: land value up everywhere"
      stopEases: "Bus stop: traffic eases by a third 3 tiles round"
      reachesHwy: "Reaches the highway"
      noHwy: "Doesn't reach the highway yet"
      tunnelUnder: "a subway tunnel runs under it"
      depotDoes: "Runs the buses that stop at bus stops"
      stopsIn: n => n == 1 ? "1 bus stop in the city" : "${n} bus stops in the city"
      stopHere: "Buses stop here: traffic eases by a third 3 tiles round"
      needDepot: "Needs a bus depot to run buses"
      stationOn: "Linked: traffic eases by 60% 4 tiles round"
      stationDig: "Dig a tunnel to another station to open it"
      bridge: "Roads can bridge it ($60 a tile)"
      clearCost: "Clearing costs $5"
      sandBuild: "Build on it straight away, or bulldoze it to grass ($5)"
      rim: "The island's rim: nothing can be built here"
      freeBuild: "Free to build on"
      // Messages over the toolbar, upper case, a few seconds each.
      welcomeBack: v => "WELCOME BACK! +$${v}"
      welcomeMayor: "WELCOME BACK, MAYOR!"
      researchDone: name => "RESEARCH DONE: ${name}"
      satellite: v => "SATELLITE IN ORBIT! +$${v}"
      levelUp: (n, name, v) => "LEVEL ${n}: ${name}! +$${v}"
      buyFirst: "BUY THIS LAND FIRST: TAP IT WITH NO TOOL"
      unlocksAt: n => "UNLOCKS AT CITY LEVEL ${n}"
      depotFirst: "BUILD A BUS DEPOT FIRST"
      stopsOnRoad: "BUS STOPS GO ON A ROAD"
      stopRemoved: v => "BUS STOP REMOVED: +$${v} BACK"
      noSidewalk: "NO SIDEWALK HERE: PICK A STRAIGHT ROAD OR A CORNER"
      noMoney: "NOT ENOUGH MONEY"
      fillWater: "LANDFILL GOES ON OPEN WATER"
      fillBeside: "FILL WATER RIGHT BESIDE THE LAND"
      oneDepot: "ONE DEPOT RUNS ALL THE BUSES"
      oneTower: "A CITY HAS ONE BAY TOWER"
      onePad: "A CITY HAS ONE LAUNCH PAD"
      rocketryFirst: "RESEARCH ROCKETRY FIRST"
      pickEmpty: "PICK AN EMPTY TILE"
      tunnelFilled: "TUNNEL FILLED IN"
      nothingClear: "NOTHING TO CLEAR THERE"
      cantBuild: "CAN'T BUILD THERE"
      refund: (v, n) => n == 1 ? "+$${v} BACK FOR THE BUILDING" : "+$${v} BACK FOR THE BUILDINGS"
      // The top bar: the level badge (128 dp), the people and happiness boxes (84 and 66 dp), the quest.
      lvBadge: (n, name) => "LV ${n} ${name}"
      residentsCap: "RESIDENTS"
      happy: "HAPPY"
      questDone: v => "QUEST DONE! +$${v}"
      questTap: v => "DONE! TAP FOR +$${v}"
      questOf: (i, v, goal) => "QUEST ${i} · ${v}/${goal}"
      // Under small icons, 50 dp wide.
      map: "MAP"
      city: "CITY"
      // Under the demand bars: residential, commercial, industrial; one letter each.
      rci: ["R", "C", "I"]
      // While painting roads or zones: how many tiles and what it costs (or gives back).
      tiles: (n, cost) => n == 1 ? "1 TILE · ${cost}" : "${n} TILES · ${cost}"
      back: v => "+$${v} BACK"
      showAcross: name => "SHOW ${name} ACROSS THE CITY"
      svcLower: ["police", "fire", "clinic", "school"]
      buyLand: v => "BUY THIS LAND · $${v}"
      landBought: "LAND BOUGHT!"
      openResearch: "OPEN RESEARCH"
      launch: v => "LAUNCH · $${v}"
      rocketInCap: s => "NEXT ROCKET IN ${s}S"
      notReady: "THE NEXT ROCKET ISN'T READY YET"
      noFuel: "NOT ENOUGH MONEY FOR FUEL"
      liftoff: "3, 2, 1... LIFTOFF!"
      // City Hall; its buttons are 104 dp wide, ON/OFF 70.
      cityHall: "CITY HALL"
      citiesOf: n => "${n} of 4 cities"
      cities: "CITIES"
      technology: "TECHNOLOGY"
      researching: name => "Researching ${name}"
      queued: n => "${n} queued"
