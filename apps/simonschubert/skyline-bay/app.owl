    <rect x="28.6" y="156.7" width="5" height="10" fill="#7a5236"/>
    <circle cx="31.1" cy="148.7" r="14" fill="#4fa83f"/>
    <circle cx="28.1" cy="144.7" r="8" fill="#6cc055"/>
    <rect x="203.4" y="166.2" width="5" height="10" fill="#7a5236"/>
    <circle cx="205.9" cy="158.2" r="14" fill="#4fa83f"/>
    <circle cx="202.9" cy="154.2" r="8" fill="#6cc055"/>
    <path d="M160.7 181.7 L169.0 185.8 L169.0 178.8 L160.7 174.7 Z" fill="#f2b134"/>
    <path d="M174.4 183.2 L169.0 185.8 L169.0 178.8 L174.4 176.2 Z" fill="#f2b134"/>
