    <path d="M95.7 193.2 L126.1 208.4 L126.1 192.4 L95.7 177.2 Z" fill="#fbf3e4"/>
    <path d="M156.5 193.2 L126.1 208.4 L126.1 192.4 L156.5 177.2 Z" fill="#e3d6bf"/>
    <path d="M126.1 162.1 L156.5 177.2 L126.1 192.4 L95.7 177.2 Z" fill="#fbf3e4"/>
    <path d="M95.7 177.2 L126.1 192.4 L126.1 159.2 Z" fill="#e4574a"/>
    <path d="M156.5 177.2 L126.1 192.4 L126.1 159.2 Z" fill="#b8402f"/>
    <path d="M69.1 208.4 L99.5 223.6 L99.5 207.6 L69.1 192.4 Z" fill="#ffe0c2"/>
    <path d="M129.9 208.4 L99.5 223.6 L99.5 207.6 L129.9 192.4 Z" fill="#e6c3a2"/>
    <path d="M99.5 177.2 L129.9 192.4 L99.5 207.6 L69.1 192.4 Z" fill="#ffe0c2"/>
    <path d="M69.1 192.4 L99.5 207.6 L99.5 174.4 Z" fill="#3d7fd0"/>
