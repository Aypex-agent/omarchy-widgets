      {k: 4, x: 0.3, y: 0.2, z: -0.04, r: 0.13, h: 0.07, n: 8, c: #3d7fd0}]},
      {p: [
      {k: 0, x: 0, y: 0, z: -0.05, w: 0.84, h: 0.36, d: 0.66, c: #dfe5ec, cs: [#b9c0c9, GL2, #dfe5ec, #dfe5ec, #dfe5ec]},
      {k: 0, x: 0, y: 0, z: 0.29, w: 0.22, h: 0.26, d: 0.04, c: #3d7fd0},
