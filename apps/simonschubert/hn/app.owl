app "hacker news" {
  meta { owl: 23; description: "A Hacker News reader: the front page, newest, Ask and Show HN, and every story's comments, threaded and in HN's order"; version: "2.3"; license: "MIT"; category: "news" }
  // A story's comments are a view of their own; Back returns to the list.
  title: open == 0 ? "hacker news" : str.comments(story.comments ?? 0)
  back: open != 0
  onBack: { open = 0; expanded = [] }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#FF6600"/>
    <g fill="#FFFFFF">
      <path d="M52 116l30-40 30 40z"/>
      <rect x="132" y="80" width="72" height="14" rx="7"/>
      <rect x="132" y="104" width="72" height="14" rx="7"/>
      <rect x="52" y="140" width="152" height="14" rx="7"/>
      <rect x="52" y="168" width="112" height="14" rx="7"/>
    </g>
  </svg>"""

  // The bottom bar's icons, Material's trending up, schedule, help outline and visibility (Apache 2.0).
  asset topIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTE2IDZsMi4yOSAyLjI5LTQuODggNC44OC00LTRMMiAxNi41OSAzLjQxIDE4bDYtNiA0IDQgNi4zLTYuMjlMMjIgMTJWNnoiLz48L3N2Zz4K"
  asset newIcon = base64""
  asset askIcon = base64""
  asset showIcon = base64""

  strings {
    en {
      // The title over a story's comments.
      comments: n => n == 1 ? "1 comment" : "${n} comments"
      deleted: "[deleted]"
      offline: "offline"; loading: "loading…"; tryAgain: "try again"
      // Under a story's title, orange: its points and who posted it.
      points: (n, who) => "${n} points · ${who}"
      showingLast: "offline · showing the last list"
      openArticle: "open the article ↗"
      noLoad: "the comments didn't load"; noComments: "no comments yet"; loadingComments: "loading the comments…"
      hideReplies: "hide replies"
      replies: n => n == 1 ? "1 reply" : "${n} replies"
      more: "more on news.ycombinator.com ↗"
      // The bottom bar's tabs, a quarter of the width each. Ask and show are HN's own section names.
      tabTop: "top"; tabNew: "new"; tabAsk: "ask"; tabShow: "show"
    }
    id {
      comments: n => "${n} komentar"
      deleted: "[dihapus]"
      offline: "offline"; loading: "memuat…"; tryAgain: "coba lagi"
      points: (n, who) => "${n} poin · ${who}"
      showingLast: "offline · daftar terakhir"
      openArticle: "buka artikel ↗"
      noLoad: "komentar gagal dimuat"; noComments: "belum ada komentar"; loadingComments: "memuat komentar…"
      hideReplies: "sembunyikan balasan"
      replies: n => "${n} balasan"
      more: "selengkapnya di news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "baru"; tabAsk: "ask"; tabShow: "show"
    }
    es {
      comments: n => n == 1 ? "1 comentario" : "${n} comentarios"
      deleted: "[borrado]"
      offline: "sin conexión"; loading: "cargando…"; tryAgain: "reintentar"
      points: (n, who) => n == 1 ? "1 punto · ${who}" : "${n} puntos · ${who}"
      showingLast: "sin conexión · la última lista"
      openArticle: "abrir el artículo ↗"
      noLoad: "los comentarios no cargaron"; noComments: "aún no hay comentarios"; loadingComments: "cargando los comentarios…"
      hideReplies: "ocultar respuestas"
      replies: n => n == 1 ? "1 respuesta" : "${n} respuestas"
      more: "más en news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "nuevo"; tabAsk: "ask"; tabShow: "show"
    }
    pt {
      comments: n => n == 1 ? "1 comentário" : "${n} comentários"
      deleted: "[apagado]"
      offline: "offline"; loading: "carregando…"; tryAgain: "tentar de novo"
      points: (n, who) => n == 1 ? "1 ponto · ${who}" : "${n} pontos · ${who}"
      showingLast: "offline · mostrando a última lista"
      openArticle: "abrir o artigo ↗"
      noLoad: "os comentários não carregaram"; noComments: "nenhum comentário ainda"; loadingComments: "carregando os comentários…"
      hideReplies: "ocultar respostas"
      replies: n => n == 1 ? "1 resposta" : "${n} respostas"
      more: "mais em news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "novo"; tabAsk: "ask"; tabShow: "show"
    }
    de {
      comments: n => n == 1 ? "1 kommentar" : "${n} kommentare"
      deleted: "[gelöscht]"
      offline: "offline"; loading: "lädt…"; tryAgain: "nochmal versuchen"
      points: (n, who) => n == 1 ? "1 punkt · ${who}" : "${n} punkte · ${who}"
      showingLast: "offline · die letzte liste"
      openArticle: "artikel öffnen ↗"
      noLoad: "die kommentare haben nicht geladen"; noComments: "noch keine kommentare"; loadingComments: "kommentare laden…"
      hideReplies: "antworten ausblenden"
      replies: n => n == 1 ? "1 antwort" : "${n} antworten"
      more: "mehr auf news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "neu"; tabAsk: "ask"; tabShow: "show"
    }
    zh {
      comments: n => "${n} 条评论"
      deleted: "[已删除]"
      offline: "离线"; loading: "加载中…"; tryAgain: "重试"
      points: (n, who) => "${n} 分 · ${who}"
      showingLast: "离线 · 显示上次的列表"
      openArticle: "打开文章 ↗"
      noLoad: "评论没有加载出来"; noComments: "还没有评论"; loadingComments: "正在加载评论…"
      hideReplies: "收起回复"
      replies: n => "${n} 条回复"
      more: "在 news.ycombinator.com 查看更多 ↗"
      tabTop: "热门"; tabNew: "最新"; tabAsk: "ask"; tabShow: "show"
    }
    ru {
      comments: n => n % 10 == 1 && n % 100 != 11 ? "${n} комментарий" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} комментария" : "${n} комментариев"
      deleted: "[удалено]"
      offline: "нет сети"; loading: "загрузка…"; tryAgain: "попробовать снова"
      points: (n, who) => n % 10 == 1 && n % 100 != 11 ? "${n} балл · ${who}" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} балла · ${who}" : "${n} баллов · ${who}"
      showingLast: "нет сети · последний список"
      openArticle: "открыть статью ↗"
      noLoad: "комментарии не загрузились"; noComments: "комментариев пока нет"; loadingComments: "загрузка комментариев…"
      hideReplies: "скрыть ответы"
      replies: n => n % 10 == 1 && n % 100 != 11 ? "${n} ответ" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} ответа" : "${n} ответов"
      more: "ещё на news.ycombinator.com ↗"
      tabTop: "топ"; tabNew: "новое"; tabAsk: "ask"; tabShow: "show"
    }
    ja {
      comments: n => "${n} 件のコメント"
      deleted: "[削除済み]"
      offline: "オフライン"; loading: "読み込み中…"; tryAgain: "再試行"
      points: (n, who) => "${n} ポイント · ${who}"
      showingLast: "オフライン · 前回のリストを表示中"
      openArticle: "記事を開く ↗"
      noLoad: "コメントを読み込めませんでした"; noComments: "まだコメントはありません"; loadingComments: "コメントを読み込み中…"
      hideReplies: "返信を隠す"
      replies: n => "${n} 件の返信"
      more: "news.ycombinator.com でもっと見る ↗"
      tabTop: "トップ"; tabNew: "新着"; tabAsk: "ask"; tabShow: "show"
    }
    uk {
      comments: n => n % 10 == 1 && n % 100 != 11 ? "${n} коментар" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} коментарі" : "${n} коментарів"
      deleted: "[видалено]"
      offline: "немає мережі"; loading: "завантаження…"; tryAgain: "ще раз"
      points: (n, who) => n % 10 == 1 && n % 100 != 11 ? "${n} бал · ${who}" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} бали · ${who}" : "${n} балів · ${who}"
      showingLast: "немає мережі · останній список"
      openArticle: "відкрити статтю ↗"
      noLoad: "коментарі не завантажилися"; noComments: "коментарів ще немає"; loadingComments: "завантаження коментарів…"
      hideReplies: "сховати відповіді"
      replies: n => n % 10 == 1 && n % 100 != 11 ? "${n} відповідь" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "${n} відповіді" : "${n} відповідей"
      more: "більше на news.ycombinator.com ↗"
      tabTop: "топ"; tabNew: "нове"; tabAsk: "ask"; tabShow: "show"
    }
    fr {
      comments: n => n <= 1 ? "${n} commentaire" : "${n} commentaires"
      deleted: "[supprimé]"
      offline: "hors ligne"; loading: "chargement…"; tryAgain: "réessayer"
      points: (n, who) => n <= 1 ? "${n} point · ${who}" : "${n} points · ${who}"
      showingLast: "hors ligne · la dernière liste"
      openArticle: "ouvrir l'article ↗"
      noLoad: "les commentaires n'ont pas chargé"; noComments: "pas encore de commentaires"; loadingComments: "chargement des commentaires…"
      hideReplies: "masquer les réponses"
      replies: n => n <= 1 ? "${n} réponse" : "${n} réponses"
      more: "plus sur news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "nouveau"; tabAsk: "ask"; tabShow: "show"
    }
    tr {
      comments: n => "${n} yorum"
      deleted: "[silindi]"
      offline: "çevrimdışı"; loading: "yükleniyor…"; tryAgain: "tekrar dene"
      points: (n, who) => "${n} puan · ${who}"
      showingLast: "çevrimdışı · son liste"
      openArticle: "makaleyi aç ↗"
      noLoad: "yorumlar yüklenmedi"; noComments: "henüz yorum yok"; loadingComments: "yorumlar yükleniyor…"
      hideReplies: "yanıtları gizle"
      replies: n => "${n} yanıt"
      more: "devamı news.ycombinator.com'da ↗"
      tabTop: "top"; tabNew: "yeni"; tabAsk: "ask"; tabShow: "show"
    }
    it {
      comments: n => n == 1 ? "1 commento" : "${n} commenti"
      deleted: "[eliminato]"
      offline: "offline"; loading: "caricamento…"; tryAgain: "riprova"
      points: (n, who) => n == 1 ? "1 punto · ${who}" : "${n} punti · ${who}"
      showingLast: "offline · l'ultima lista"
      openArticle: "apri l'articolo ↗"
      noLoad: "i commenti non si sono caricati"; noComments: "ancora nessun commento"; loadingComments: "caricamento dei commenti…"
      hideReplies: "nascondi le risposte"
      replies: n => n == 1 ? "1 risposta" : "${n} risposte"
      more: "altro su news.ycombinator.com ↗"
      tabTop: "top"; tabNew: "nuovi"; tabAsk: "ask"; tabShow: "show"
    }
  }

  state feed = "top" persist
  // The story whose comments are open (0 for the lists), and the comment threads unfolded in it.
  state open = 0
  state story = {}
  state expanded = []
  // Stories read, so the lists show them dimmed; the last 500.
  state seen = [] persist
  // Each feed as it last loaded, so a start shows it at once and the app reads offline.
  state savedTop = [] persist
  state savedNew = [] persist
  state savedAsk = [] persist
  state savedShow = [] persist

  source now = clock every 1m
  // Only the feed on show is asked for; the others wait with their saved lists.
  source top = http(feed == "top" ? "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=50" : null) every 5m json timeout 15s status
  source fresh = http(feed == "new" ? "https://hn.algolia.com/api/v1/search_by_date?tags=story&hitsPerPage=50" : null) every 5m json timeout 15s status
  source ask = http(feed == "ask" ? "https://hn.algolia.com/api/v1/search?tags=ask_hn&hitsPerPage=50" : null) every 5m json timeout 15s status
  source show = http(feed == "show" ? "https://hn.algolia.com/api/v1/search?tags=show_hn&hitsPerPage=50" : null) every 5m json timeout 15s status
  // The open story's comment tree from Algolia, and from HN itself the order its top comments rank in.
  source thread = http(open == 0 ? null : "https://hn.algolia.com/api/v1/items/${open}") every 5m json timeout 25s status
  source ranked = http(open == 0 ? null : "https://hacker-news.firebaseio.com/v0/item/${open}.json") every 5m json timeout 15s status

  // Each feed's stories, trimmed to what a row shows.
  let liveTop = top == null || !top.ok ? null : top.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveNew = fresh == null || !fresh.ok ? null : fresh.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveAsk = ask == null || !ask.ok ? null : ask.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  let liveShow = show == null || !show.ok ? null : show.out.hits.filter(s => s.title != null).map(s => {id: num(s.objectID), title: s.title, url: s.url ?? "", site: match(s.url ?? "", '^https?://(?:www\.)?([^/]+)')[0] ?? "", points: s.points ?? 0, comments: s.num_comments ?? 0, time: s.created_at_i, author: s.author ?? "", text: s.story_text ?? ""})
  when liveTop != null && liveTop != savedTop { savedTop = liveTop }
  when liveNew != null && liveNew != savedNew { savedNew = liveNew }
  when liveAsk != null && liveAsk != savedAsk { savedAsk = liveAsk }
  when liveShow != null && liveShow != savedShow { savedShow = liveShow }

  let src = feed == "new" ? fresh : feed == "ask" ? ask : feed == "show" ? show : top
  let stories = feed == "new" ? savedNew : feed == "ask" ? savedAsk : feed == "show" ? savedShow : savedTop
  let offline = src != null && !src.ok

  // The open story's comments: top ones in HN's order, each with its replies flattened, six deep.
  let tree = thread != null && thread.ok && thread.out.id == open ? thread.out : null
  let kids = ranked != null && ranked.ok && ranked.out.id == open ? ranked.out.kids ?? [] : []
  let tops = tree == null ? [] : (tree.children ?? []).filter(c => c.text != null || len(c.children ?? []) > 0).sortBy(c => indexOf(kids, c.id) < 0 ? 100000 + c.created_at_i % 100000 : indexOf(kids, c.id))

  // "2h", "3d": how long ago.
  component Ago(t) {
    Text { text: now == null ? "" : now - t < 3600 ? "${max(1, floor((now - t) / 60))}m" : now - t < 86400 ? "${floor((now - t) / 3600)}h" : "${floor((now - t) / 86400)}d"; style: small; color: muted; width: 32; maxLines: 1 }
  }

  // HN's comment HTML as text: paragraphs from <p>, tags dropped, entities read; its links listed under it.
  component Html(t, small = false) {
    let raw = t ?? ""
    let plain = join(split(raw, "<p>").map(p => join(matchAll(p, '<[^>]*>|[^<]+').filter(x => !startsWith(x, "<")), "")), "\n\n")
    let read = replace(replace(replace(replace(replace(replace(replace(plain, "&#x2F;", "/"), "&#x27;", "'"), "&quot;", "\""), "&gt;", ">"), "&lt;", "<"), "&#x60;", "`"), "&amp;", "&")
    let links = matchAll(raw, 'href="([^"]+)"').map(l => replace(replace(l[0], "&#x2F;", "/"), "&amp;", "&"))
    Column {
      gap: 4
      Text { text: read; style: small ? "small" : "body"; font: contains(raw, "<pre>") ? "mono" : "sans" }
      for l in links.take(3) {
        Text { text: "${match(l, '^https?://(?:www\.)?([^/]+)')[0] ?? l} ↗"; style: small; color: accent; maxLines: 1; onTap: url(l) }
      }
    }
  }

  // One comment: who and when, what they wrote, and how many replies sit under it.
  component Comment(c, depth = 0) {
    let replies = len(c.children ?? [])
    Row {
      gap: 8
      align: top
      // A reply sits in from its parent.
      if depth > 0 { Spacer { width: depth * 12 - 8 } }
      Column {
        gap: 3
        weight: 1
        Row {
          gap: 6
          Text { text: c.author ?? str.deleted; style: small; bold: true; color: c.author == story.author ? orange : accent; weight: 1; maxLines: 1 }
          Ago { t: c.created_at_i }
        }
        if c.text == null {
          Text { text: str.deleted; style: small; color: muted }
        } else {
          Html { t: c.text; small: depth > 0 }
        }
      }
    }
  }

  // A tab of the bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, icon, label) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { feed = name; open = 0; expanded = []; haptic("light") }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: icon; size: 24; tint: feed == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: feed == name; color: feed == name ? foreground : muted }
    }
  }

  Column {
    fill: true
    gap: 0

    if open == 0 {
      Column {
        scroll: true
        weight: 1
        gap: 14
        padding: [12, 4, 12, 12]
        if len(stories) == 0 {
          Text { text: offline ? str.offline : str.loading; color: muted }
          if offline { Button { text: str.tryAgain; onTap: refresh() } }
        }
        for s, i in stories key s.id {
          let link = "https://news.ycombinator.com/item?id=${s.id}"
          let read = contains(seen, s.id)
          Row {
            gap: 10
            align: top
            Text { text: "${i + 1}"; color: muted; width: 24; align: end }
            Column {
              gap: 3
              weight: 1
              // The story opens its link, or its comments when it has none.
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); story = s; open = s.url == "" ? s.id : 0; expanded = []; url(s.url == "" ? null : s.url) }
              Text { text: s.title; bold: !read; color: read ? muted : foreground; maxLines: 3 }
              Row {
                gap: 6
                Text { text: s.site == "" ? "news.ycombinator.com" : s.site; style: small; color: muted; maxLines: 1; weight: 1 }
              }
              Text { text: str.points(s.points, s.author); style: small; color: orange; maxLines: 1 }
            }
            // The comments, in the app.
            Column {
              width: 44
              align: center
              gap: 0
              padding: [0, 2]
              radius: 6 * corners
              background: alpha(foreground, 0.06)
              onTap: { seen = read ? seen : (seen + [s.id]).drop(max(0, len(seen) - 499)); story = s; open = s.id; expanded = []; haptic() }
              Text { text: s.comments > 999 ? "${floor(s.comments / 1000)}k" : "${s.comments}"; bold: true; align: center; maxLines: 1 }
              Ago { t: s.time }
            }
          }
        }
        if offline && len(stories) > 0 {
          Text { text: str.showingLast; style: label; color: muted }
        }
      }
    } else {
      Column {
        scroll: true
        weight: 1
        gap: 12
        padding: [12, 4, 12, 12]
        // The story: its title opens the link.
        Column {
          gap: 4
          Text { text: story.title; style: title; onTap: url(story.url == "" ? "https://news.ycombinator.com/item?id=${open}" : story.url) }
          Text { text: str.points(story.points, story.author) + (story.site == "" ? "" : " · " + story.site); style: small; color: orange; maxLines: 1 }
          if story.url != "" {
            Text { text: str.openArticle; color: accent; onTap: url(story.url) }
          }
          if story.text != "" {
            Html { t: story.text }
          }
        }
        Box { height: 1; fill: width; background: alpha(muted, 0.25) }
        if tree == null {
          Text { text: thread != null && !thread.ok ? str.noLoad : story.comments == 0 ? str.noComments : str.loadingComments; color: muted }
          if thread != null && !thread.ok { Button { text: str.tryAgain; onTap: refresh() } }
        } else {
          if len(tops) == 0 { Text { text: str.noComments; color: muted } }
          for c in tops.take(150) key c.id {
            let all = flatten((c.children ?? []).map(a => [{c: a, d: 1}] + flatten((a.children ?? []).map(b => [{c: b, d: 2}] + flatten((b.children ?? []).map(x => [{c: x, d: 3}] + flatten((x.children ?? []).map(y => [{c: y, d: 4}] + flatten((y.children ?? []).map(z => [{c: z, d: 5}] + (z.children ?? []).map(w => {c: w, d: 6})))))))))))
            let unfolded = contains(expanded, c.id)
            Column {
              gap: 8
              // A tap folds a thread's replies in or out.
              Column {
                onTap: { expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
                Comment { c: c }
              }
              if len(all) > 0 {
                Text {
                  text: unfolded ? str.hideReplies : str.replies(len(all))
                  style: small
                  color: accent
                  padding: [0, 2]
                  onTap: { expanded = unfolded ? expanded.filter(e => e != c.id) : expanded + [c.id] }
                }
              }
              if unfolded {
                for r in all key r.c.id { Comment { c: r.c; depth: r.d } }
              }
            }
          }
          if len(tops) > 150 || tree.children == null {
            Text { text: str.more; color: accent; onTap: url("https://news.ycombinator.com/item?id=${open}") }
          }
        }
      }
    }

    if open == 0 {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "top"; icon: topIcon; label: str.tabTop }
        Tab { name: "new"; icon: newIcon; label: str.tabNew }
        Tab { name: "ask"; icon: askIcon; label: str.tabAsk }
        Tab { name: "show"; icon: showIcon; label: str.tabShow }
      }
    }
  }
}
