app "delve" {
  // A roguelike dungeon crawl in pixel art, one floor to a screen. Swipe (or tap beside the hero)
  // to step; walk into a monster to fight it. Every step is a turn, and then every monster that
  // has noticed the hero takes one too. Potions, bombs and scrolls wait to be used; swords and
  // shields count at once. The stairs lead down to a new floor, deeper and worse, and death ends
  // the run for good: only the deepest floor is kept.
  //
  // There's no game loop: a step resolves at once, in `on actN`, and `on chk` plays the monsters'
  // turn. Both leave timed events (`fx`, in seconds from the turn's start) that the canvases play
  // from `fxAt`, the frame clock when the turn began.

  meta { owl: 12; description: "A roguelike dungeon crawl in pixel art: swipe to move and fight, one floor per screen; potions, bombs and scrolls, stairs down to worse monsters, and death is for good"; version: "1.0"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges"><defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath></defs><g clip-path="url(#t)"><rect width="256" height="256" fill="#2c2636"/><rect x="128" y="64" width="128" height="64" fill="#28222f"/><rect x="0" y="128" width="128" height="64" fill="#28222f"/><rect x="128" y="192" width="128" height="64" fill="#28222f"/><rect width="256" height="64" fill="#3a3346"/><rect width="256" height="22" fill="#4a4258"/><rect y="22" width="256" height="4" fill="#24202c"/><rect y="42" width="256" height="4" fill="#2c2735"/><rect x="60" y="26" width="4" height="16" fill="#2c2735"/><rect x="150" y="26" width="4" height="16" fill="#2c2735"/><rect x="104" y="46" width="4" height="18" fill="#2c2735"/><rect x="200" y="46" width="4" height="18" fill="#2c2735"/><circle cx="212" cy="36" r="34" fill="#ff9a3c" fill-opacity="0.16"/><rect x="206" y="36" width="12" height="16" fill="#5e4430"/><rect x="202" y="14" width="20" height="22" rx="6" fill="#ff8a3a"/><rect x="208" y="22" width="8" height="14" fill="#ffe08a"/><rect x="186" y="176" width="56" height="56" fill="#0c0a10"/><rect x="186" y="176" width="56" height="13" fill="#8a80a0"/><rect x="192" y="189" width="44" height="13" fill="#665e7c"/><rect x="198" y="202" width="32" height="13" fill="#48425a"/><rect x="38" y="214" width="110" height="14" rx="7" fill="#000000" fill-opacity="0.4"/></g><path fill="#14121c" d="M74 64h13.3v13.3h-13.3zM87 64h13.3v13.3h-13.3zM100 64h13.3v13.3h-13.3zM113 64h13.3v13.3h-13.3zM152 64h13.3v13.3h-13.3zM61 77h13.3v13.3h-13.3zM126 77h13.3v13.3h-13.3zM139 77h13.3v13.3h-13.3zM165 77h13.3v13.3h-13.3zM48 90h13.3v13.3h-13.3zM126 90h13.3v13.3h-13.3zM165 90h13.3v13.3h-13.3zM48 103h13.3v13.3h-13.3zM126 103h13.3v13.3h-13.3zM152 103h13.3v13.3h-13.3zM48 116h13.3v13.3h-13.3zM126 116h13.3v13.3h-13.3zM152 116h13.3v13.3h-13.3zM35 129h13.3v13.3h-13.3zM48 129h13.3v13.3h-13.3zM61 129h13.3v13.3h-13.3zM74 129h13.3v13.3h-13.3zM87 129h13.3v13.3h-13.3zM100 129h13.3v13.3h-13.3zM113 129h13.3v13.3h-13.3zM126 129h13.3v13.3h-13.3zM152 129h13.3v13.3h-13.3zM22 142h13.3v13.3h-13.3zM48 142h13.3v13.3h-13.3zM165 142h13.3v13.3h-13.3zM22 155h13.3v13.3h-13.3zM48 155h13.3v13.3h-13.3zM126 155h13.3v13.3h-13.3zM152 155h13.3v13.3h-13.3zM22 168h13.3v13.3h-13.3zM48 168h13.3v13.3h-13.3zM126 168h13.3v13.3h-13.3zM35 181h13.3v13.3h-13.3zM61 181h13.3v13.3h-13.3zM100 181h13.3v13.3h-13.3zM139 181h13.3v13.3h-13.3zM48 194h13.3v13.3h-13.3zM61 194h13.3v13.3h-13.3zM100 194h13.3v13.3h-13.3zM139 194h13.3v13.3h-13.3zM48 207h13.3v13.3h-13.3zM87 207h13.3v13.3h-13.3zM100 207h13.3v13.3h-13.3zM139 207h13.3v13.3h-13.3z"/><path fill="#b8c0d0" d="M74 77h13.3v13.3h-13.3zM113 77h13.3v13.3h-13.3zM61 90h13.3v13.3h-13.3zM74 90h13.3v13.3h-13.3zM87 90h13.3v13.3h-13.3zM100 90h13.3v13.3h-13.3zM113 90h13.3v13.3h-13.3zM61 103h13.3v13.3h-13.3zM61 116h13.3v13.3h-13.3zM74 116h13.3v13.3h-13.3zM87 116h13.3v13.3h-13.3zM100 116h13.3v13.3h-13.3zM113 116h13.3v13.3h-13.3z"/><path fill="#eef2fa" d="M87 77h13.3v13.3h-13.3zM100 77h13.3v13.3h-13.3zM152 77h13.3v13.3h-13.3zM139 90h13.3v13.3h-13.3zM152 90h13.3v13.3h-13.3zM139 103h13.3v13.3h-13.3zM139 116h13.3v13.3h-13.3zM139 129h13.3v13.3h-13.3z"/><path fill="#20202a" d="M74 103h13.3v13.3h-13.3zM87 103h13.3v13.3h-13.3zM100 103h13.3v13.3h-13.3zM113 103h13.3v13.3h-13.3z"/><path fill="#c8423a" d="M35 142h13.3v13.3h-13.3zM35 155h13.3v13.3h-13.3zM35 168h13.3v13.3h-13.3zM48 181h13.3v13.3h-13.3z"/><path fill="#4a7ad0" d="M61 142h13.3v13.3h-13.3zM74 142h13.3v13.3h-13.3zM100 142h13.3v13.3h-13.3zM113 142h13.3v13.3h-13.3zM61 155h13.3v13.3h-13.3zM74 155h13.3v13.3h-13.3zM100 155h13.3v13.3h-13.3zM113 155h13.3v13.3h-13.3zM61 168h13.3v13.3h-13.3zM74 168h13.3v13.3h-13.3zM100 168h13.3v13.3h-13.3zM113 168h13.3v13.3h-13.3z"/><path fill="#2e5096" d="M87 142h13.3v13.3h-13.3zM87 155h13.3v13.3h-13.3zM87 168h13.3v13.3h-13.3z"/><path fill="#f0c040" d="M126 142h13.3v13.3h-13.3zM139 142h13.3v13.3h-13.3zM152 142h13.3v13.3h-13.3z"/><path fill="#e8b088" d="M139 155h13.3v13.3h-13.3z"/><path fill="#5a5068" d="M74 181h13.3v13.3h-13.3zM87 181h13.3v13.3h-13.3zM113 181h13.3v13.3h-13.3zM126 181h13.3v13.3h-13.3zM74 194h13.3v13.3h-13.3zM87 194h13.3v13.3h-13.3zM113 194h13.3v13.3h-13.3zM126 194h13.3v13.3h-13.3z"/><path fill="#3a3040" d="M61 207h13.3v13.3h-13.3zM74 207h13.3v13.3h-13.3zM113 207h13.3v13.3h-13.3zM126 207h13.3v13.3h-13.3z"/></svg>"""

  // "title" or "play"; a run that has ended stays "play" until the next one starts
  state mode = "title" persist
  // the floor, from 1, and the deepest any run reached
  state depth = 1 persist
  state best = 0 persist
  state bestGold = 0 persist
  // the map: 0 rock or wall, 1 floor, 2 the stairs down; and what the hero has seen of it
  state grid = [] persist
  state seen = [] persist
  // the hero: cell, health, attack, defence, level, experience, facing (1 right, -1 left)
  state hero = {x: 0, y: 0, hp: 15, mh: 15, atk: 3, def: 0, lv: 1, xp: 0, f: 1} persist
  // monsters: id, kind, cell, health, awake, facing, and the attack a deeper floor adds
  state mons = [] persist
  // what lies on the floor: cell and kind (0 potion, 1 bomb, 2 blink, 3 fire, 4 gold, 5 sword, 6 shield)
  state items = [] persist
  // potions, bombs, blink scrolls and fire scrolls carried
  state inv = [1, 0, 0, 0] persist
  state gold = 0 persist
  state kills = 0 persist
  state turnN = 0 persist
  state log = [] persist
  // what killed the hero
  state cause = "" persist

  // what the hero does next (0-3 a step north, east, south or west, 4 wait, 5-8 an item), and the
  // counter that sets it going
  state act = 0
  state actN = 0
  // set while the hero's action takes a turn
  state spent = false
  // experience earned this turn, counted in once the monsters have moved
  state xpGain = 0
  // bumped once the hero has acted: the map takes in what's in view, and with `mm` the monsters move
  state chk = 0
  state mm = false
  // bumped for a new floor, and for a new run
  state go = 0
  state fresh = 0
  // what the canvases play, and how long it takes
  state fx = []
  state fxLen = 0
  // A tap's `time` lags the frame clock, so a turn starts its events at the first frame after it.
  state fxTap = 0
  state fxAt = 0
  when fxAt == -1 && time != fxTap { fxAt = time }
  // while a turn plays out; the canvas with everyone in it only reads the clock then
  state anim = false
  when anim && fxAt >= 0 && (time - fxAt > fxLen + 0.1 || time < fxAt) { anim = false }
  // the end card shows once the last blow has played
  state over = false
  when hero.hp <= 0 && !over && fxAt >= 0 && (time - fxAt > fxLen || time < fxAt) { over = true }
  // a swipe so far, and whether it has stepped
  state sx = 0
  state sy = 0
  state swiped = false
  // where a finger is down, so the button under it shows pressed
  state downAt = [-1, -1]

  // ---- the screen, in dp ------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let INS = max(screenInset ?? 0, 16)
  // held sideways the panel goes right of the map
  let LS = SW > SH
  let W = 11
  let H = 17
  let N = 187
  let PH = 132
  // a tile, and an art pixel
  let T = floor(LS ? min((SH - TOP - INS - 8) / H, (SW - 300) / W) : min((SW - 12) / W, (SH - TOP - 34 - PH - INS - 8) / H))
  let q = T / 12
  let BX = LS ? max(14, floor((SW - 290 - W * T) / 2)) : floor((SW - W * T) / 2)
  let BY = LS ? TOP + floor((SH - TOP - INS - H * T) / 2) : TOP + 34 + max(0, floor((SH - INS - PH - 8 - TOP - 34 - H * T) / 2))
  // the panel: health and the rest, the last of the log, and the buttons
  let PX = LS ? BX + W * T + 18 : 10
  let PW = LS ? SW - PX - 18 : SW - 20
  let PY = LS ? TOP + 44 : SH - INS - PH
  let BTY = LS ? PY + 110 : PY + 80
  let BW = (PW - 24) / 5
  let HX = LS ? PX : 12
  let HW = LS ? PW : SW - 24
  // the title's buttons, and the end card's
  let TBY = LS ? SH - INS - 116 : SH * 0.64
  let OBY = SH * 0.26 + 214
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"
  let DX = [0, 1, 0, -1]
  let DY = [-1, 0, 1, 0]

  // ---- monsters and items -----------------------------------------------------------------------
  // ai: 0 walks up, 1 flutters (half its moves are random), 2 slow (every other turn), 3 shoots
  // along a row or a column, 4 drifts through walls
  let KD = [
    {n: "RAT", v: "BITES", hp: 3, atk: 2, def: 0, xp: 1, from: 1, ai: 0},
    {n: "BAT", v: "BITES", hp: 3, atk: 1, def: 0, xp: 1, from: 1, ai: 1},
    {n: "SLIME", v: "BURNS", hp: 8, atk: 2, def: 0, xp: 2, from: 2, ai: 2},
    {n: "GOBLIN", v: "STABS", hp: 6, atk: 3, def: 0, xp: 3, from: 2, ai: 0},
    {n: "ARCHER", v: "HITS", hp: 5, atk: 2, def: 0, xp: 3, from: 3, ai: 3},
    {n: "SKELETON", v: "HITS", hp: 10, atk: 3, def: 1, xp: 4, from: 4, ai: 0},
    {n: "ORC", v: "CLEAVES", hp: 14, atk: 4, def: 1, xp: 6, from: 6, ai: 0},
    {n: "GHOST", v: "CHILLS", hp: 9, atk: 4, def: 0, xp: 5, from: 7, ai: 4},
    {n: "DEMON", v: "CLAWS", hp: 22, atk: 6, def: 2, xp: 10, from: 9, ai: 0}
  ]
  let ITN = ["A POTION", "A BOMB", "A BLINK SCROLL", "A FIRE SCROLL", "GOLD", "A SWORD: ATK +1", "A SHIELD: DEF +1"]
  let EMPTY = ["NO POTIONS LEFT", "NO BOMBS LEFT", "NO BLINK SCROLLS", "NO FIRE SCROLLS"]

  // ---- what the hero sees and how far monsters must walk ----------------------------------------
  // every cell within five, in a straight line past nothing but floor; a wall is seen as the line ends on it
  let vis = len(grid) < N ? [] : range(N).map(c => [[c % W - hero.x, floor(c / W) - hero.y]].map(p => p[0] * p[0] + p[1] * p[1] <= 26 && [max(abs(p[0]), abs(p[1])) * 2].map(n => all(range(1, n), j => [floor(hero.y + 0.5 + p[1] * j / n) * W + floor(hero.x + 0.5 + p[0] * j / n)].map(z => z == c || grid[z] != 0)[0]))[0])[0])
  // steps from each cell to the hero, 99 past eighteen
  let DM = len(grid) < N ? [] : reduce(range(18), (A, k) => A.map((d, c) => d < 99 ? d : grid[c] != 0 && ((c % W > 0 && A[c - 1] == k) || (c % W < W - 1 && A[c + 1] == k) || (c >= W && A[c - W] == k) || (c < N - W && A[c + W] == k)) ? k + 1 : 99), range(N).map(c => c == hero.y * W + hero.x ? 0 : 99))

  // ---- a new run --------------------------------------------------------------------------------
  on fresh {
    hero = {x: 0, y: 0, hp: 15, mh: 15, atk: 3, def: 0, lv: 1, xp: 0, f: 1}
    depth = 1
    inv = [1, 0, 0, 0]
    gold = 0
    kills = 0
    turnN = 0
    log = ["THE DUNGEON TAKES YOU IN", "FIND THE STAIRS DOWN"]
    cause = ""
    over = false
    xpGain = 0
    go = go + 1
  }

  // ---- a floor: rooms joined by corridors ---------------------------------------------------------
  on go {
    let R = random(1000000)
    // The map is six zones, two across and three down, each holding a room (or, now and then, just a
    // bend in the corridor), visited in a winding order: along the rows or down the columns, from
    // any corner. Each zone is joined to the next, and two that are side by side but not in turn
    // sometimes are too, for a loop (never the first and the last, which would skip the floor).
    let ZN = [{zx: 1, zy: 1, zh: 4}, {zx: 6, zy: 1, zh: 4}, {zx: 1, zy: 6, zh: 5}, {zx: 6, zy: 6, zh: 5}, {zx: 1, zy: 12, zh: 4}, {zx: 6, zy: 12, zh: 4}]
    let pat = hash(R, 1) < 0.5
    let mx = hash(R, 2) < 0.5
    let my = hash(R, 3) < 0.5
    let order = (pat ? [0, 1, 3, 2, 4, 5] : [0, 2, 4, 5, 3, 1]).map(z => [mx ? z + 1 - 2 * (z % 2) : z].map(z1 => my ? z1 % 2 + (2 - floor(z1 / 2)) * 2 : z1)[0])
    let loops = (pat ? [[0, 2], [3, 5]] : [[2, 3]]).map(pr => pr.map(z => [mx ? z + 1 - 2 * (z % 2) : z].map(z1 => my ? z1 % 2 + (2 - floor(z1 / 2)) * 2 : z1)[0]))
    let RZ = range(6).map(z => [ZN[z]].map(Z => [indexOf(order, z) > 0 && indexOf(order, z) < 5 && hash(R, z, 8) < 0.22].map(jn => [jn ? {w: 1, h: 1} : {w: 3 + floor(hash(R, z, 1) * 2), h: 3 + floor(hash(R, z, 2) * (Z.zh - 2))}].map(s => [Z.zx + floor(hash(R, z, 3) * (5 - s.w))].map(rx => [Z.zy + floor(hash(R, z, 4) * (Z.zh - s.h + 1))].map(ry => merge(s, {x: rx, y: ry, cx: rx + floor(s.w / 2), cy: ry + floor(s.h / 2)}))[0])[0])[0])[0])[0])
    let rooms = order.map(z => RZ[z])
    // each to the next by an L, its bend one way or the other
    let links = range(5).map(i => {a: rooms[i], b: rooms[i + 1], hf: hash(R, i, 5) < 0.5}) + loops.filter((pr, n) => hash(R, n, 6) < 0.45).map((pr, n) => {a: RZ[pr[0]], b: RZ[pr[1]], hf: hash(R, n, 7) < 0.5})
    let open = range(N).map(c => [[c % W, floor(c / W)]].map(p => any(rooms, r => p[0] >= r.x && p[0] < r.x + r.w && p[1] >= r.y && p[1] < r.y + r.h) || any(links, l => l.hf ? (p[1] == l.a.cy && p[0] >= min(l.a.cx, l.b.cx) && p[0] <= max(l.a.cx, l.b.cx)) || (p[0] == l.b.cx && p[1] >= min(l.a.cy, l.b.cy) && p[1] <= max(l.a.cy, l.b.cy)) : (p[0] == l.a.cx && p[1] >= min(l.a.cy, l.b.cy) && p[1] <= max(l.a.cy, l.b.cy)) || (p[1] == l.b.cy && p[0] >= min(l.a.cx, l.b.cx) && p[0] <= max(l.a.cx, l.b.cx))))[0])
    // the hero in the first room, the stairs in the last
    let start = rooms[0].cy * W + rooms[0].cx
    let stairs = rooms[5].cy * W + rooms[5].cx
    grid = range(N).map(c => c == stairs ? 2 : open[c] ? 1 : 0)
    seen = range(N).map(c => false)
    // monsters and items in the other rooms, never the first
    let free = shuffle(range(N).filter(c => c != stairs && any(rooms.drop(1), r => c % W >= r.x && c % W < r.x + r.w && floor(c / W) >= r.y && floor(c / W) < r.y + r.h)))
    let nm = min(9, 2 + floor(depth * 0.6) + random(0, 1))
    let ni = 2 + random(0, 1) + (depth % 3 == 0 ? 1 : 0)
    let ng = 1 + random(0, 1)
    let ok = range(9).filter(k => KD[k].from <= depth)
    mons = free.take(nm).map((c, n) => [ok[min(len(ok) - 1, floor(pow(hash(R, n, 11), 0.6) * len(ok)))]].map(k => [max(0, depth - KD[k].from)].map(up => {
      i: depth * 100 + n, k: k, x: c % W, y: floor(c / W), hp: KD[k].hp + floor(up / 2), mh: KD[k].hp + floor(up / 2), aw: false, f: hash(R, n, 12) < 0.5 ? 1 : -1, ab: floor(up / 3)
    })[0])[0])
    // potions most, then fire and bombs, blink, swords and shields; and gold
    items = free.drop(nm).take(ni).map((c, n) => [hash(R, n, 13) * 100].map(h => {c: c, k: h < 34 ? 0 : h < 48 ? 1 : h < 60 ? 2 : h < 74 ? 3 : h < 87 ? 5 : 6})[0]) + free.drop(nm + ni).take(ng).map(c => {c: c, k: 4})
    hero = merge(hero, {x: start % W, y: floor(start / W)})
    fx = [{k: 7, s: "FLOOR ${depth}", s2: depth == 1 ? "THE DUNGEON" : "DEEPER", t0: 0.1}]
    fxLen = 1.6
    fxTap = time
    fxAt = -1
    anim = true
    mode = "play"
    mm = false
    chk = chk + 1
  }

  // ---- the hero's turn ----------------------------------------------------------------------------
  on actN {
    if mode == "play" && hero.hp > 0 && len(grid) == N {
      let hx = hero.x
      let hy = hero.y
      spent = false
      if act < 4 {
        let tx = hx + DX[act]
        let ty = hy + DY[act]
        let tc = ty * W + tx
        let inb = tx >= 0 && tx < W && ty >= 0 && ty < H
        let foe = inb ? mons.find(m => m.x == tx && m.y == ty) : null
        let fd = tx != hx ? sign(tx - hx) : hero.f
        if foe != null {
          // a blow: nine in ten land
          let K = KD[foe.k]
          let hit = random(100) < 90
          let dm = hit ? max(1, hero.atk - K.def + random(-1, 1)) : 0
          let dead = hit && foe.hp <= dm
          hero = merge(hero, {f: fd})
          mons = dead ? mons.filter(m => m.i != foe.i) : mons.map(m => m.i == foe.i ? merge(m, {hp: m.hp - dm, aw: true}) : m)
          fx = [{k: 1, i: -1, a: [hx, hy], b: [tx, ty], t0: 0}] + (hit ? [{k: 2, i: foe.i, t0: 0.07}, {k: 3, x: tx, y: ty, s: "-${dm}", c: "#ffffff", t0: 0.07}] : [{k: 3, x: tx, y: ty, s: "MISS", c: "#a8a0c0", t0: 0.07}]) + (dead ? [{k: 8, m: foe.k, x: tx, y: ty, f: foe.f, t0: 0.1}] : [])
          if dead {
            xpGain = xpGain + K.xp
            kills = kills + 1
          }
          log = (log + [dead ? "YOU SLAY THE ${K.n}" : hit ? "YOU HIT THE ${K.n}: ${dm}" : "YOU MISS THE ${K.n}"]).drop(max(0, len(log) - 2))
          spent = true
        } else if inb && grid[tc] != 0 {
          hero = merge(hero, {x: tx, y: ty, f: fd})
          fx = [{k: 0, i: -1, a: [hx, hy], b: [tx, ty], t0: 0, t1: 0.1}]
          let it = items.find(z => z.c == tc)
          if it != null {
            let amt = random(2, 4) * depth + random(1, 5)
            items = items.filter(z => z.c != tc)
            if it.k < 4 { inv = set(inv, it.k, min(9, inv[it.k] + 1)) }
            if it.k == 4 { gold = gold + amt }
            if it.k == 5 { hero = merge(hero, {atk: hero.atk + 1}) }
            if it.k == 6 { hero = merge(hero, {def: hero.def + 1}) }
            fx = fx + [{k: 9, x: tx, y: ty, t0: 0.06}, {k: 3, x: tx, y: ty, s: it.k == 4 ? "+${amt}" : it.k == 5 ? "ATK+1" : it.k == 6 ? "DEF+1" : "+1", c: "#ffe14a", t0: 0.08}]
            log = (log + [it.k == 4 ? "YOU FIND ${amt} GOLD" : "YOU FIND ${ITN[it.k]}"]).drop(max(0, len(log) - 2))
          }
          if grid[tc] == 2 {
            depth = depth + 1
            best = max(best, depth)
            log = (log + ["YOU GO DOWN TO FLOOR ${depth}"]).drop(max(0, len(log) - 2))
            haptic()
            go = go + 1
          } else {
            spent = true
          }
        }
      } else if act == 4 {
        fx = []
        spent = true
      } else {
        let k = act - 5
        if inv[k] <= 0 {
          log = (log + [EMPTY[k]]).drop(max(0, len(log) - 2))
        } else if k == 0 {
          let hl = min(10, hero.mh - hero.hp)
          hero = merge(hero, {hp: hero.hp + hl})
          inv = set(inv, 0, inv[0] - 1)
          fx = [{k: 9, x: hx, y: hy, t0: 0}, {k: 3, x: hx, y: hy, s: "+${hl}", c: "#6fe05a", t0: 0.05}]
          log = (log + ["YOU DRINK A POTION: +${hl} HP"]).drop(max(0, len(log) - 2))
          spent = true
        } else if k == 1 {
          // a bomb at the hero's feet: the eight cells around take the blast, the hero doesn't
          let dmg = 6 + floor(depth / 3)
          let hitm = mons.filter(m => abs(m.x - hx) <= 1 && abs(m.y - hy) <= 1)
          let dead = hitm.filter(m => m.hp <= dmg)
          mons = mons.filter(m => !any(dead, d => d.i == m.i)).map(m => any(hitm, z => z.i == m.i) ? merge(m, {hp: m.hp - dmg, aw: true}) : m)
          xpGain = xpGain + sum(dead.map(m => KD[m.k].xp))
          kills = kills + len(dead)
          inv = set(inv, 1, inv[1] - 1)
          fx = [{k: 4, x: hx, y: hy, t0: 0}] + hitm.map(m => {k: 3, x: m.x, y: m.y, s: "-${dmg}", c: "#ffffff", t0: 0.12}) + dead.map(m => {k: 8, m: m.k, x: m.x, y: m.y, f: m.f, t0: 0.15})
          log = (log + [len(hitm) == 0 ? "BOOM! NOTHING CAUGHT" : len(dead) > 0 ? "BOOM! ${len(dead)} BLOWN AWAY" : "BOOM! ${len(hitm)} CAUGHT"]).drop(max(0, len(log) - 2))
          haptic()
          spent = true
        } else if k == 2 {
          // somewhere far off, away from monsters
          let spots = shuffle(range(N).filter(c => grid[c] == 1 && abs(c % W - hx) + abs(floor(c / W) - hy) >= 6 && !any(mons, m => abs(m.x - c % W) + abs(m.y - floor(c / W)) <= 3) && !any(items, z => z.c == c)))
          let dest = spots[0] ?? hy * W + hx
          hero = merge(hero, {x: dest % W, y: floor(dest / W)})
          inv = set(inv, 2, inv[2] - 1)
          fx = [{k: 9, x: hx, y: hy, t0: 0}, {k: 9, x: dest % W, y: floor(dest / W), t0: 0.12}]
          log = (log + ["YOU BLINK AWAY"]).drop(max(0, len(log) - 2))
          spent = true
        } else {
          // fire: every monster in view
          let tg = mons.filter(m => vis[m.y * W + m.x])
          if len(tg) == 0 {
            log = (log + ["NOTHING IN VIEW TO BURN"]).drop(max(0, len(log) - 2))
          } else {
            let dmg = 5 + floor(depth / 2)
            let dead = tg.filter(m => m.hp <= dmg)
            mons = mons.filter(m => !any(dead, d => d.i == m.i)).map(m => any(tg, z => z.i == m.i) ? merge(m, {hp: m.hp - dmg, aw: true}) : m)
            xpGain = xpGain + sum(dead.map(m => KD[m.k].xp))
            kills = kills + len(dead)
            inv = set(inv, 3, inv[3] - 1)
            fx = tg.map((m, n) => {k: 6, a: [hx, hy], b: [m.x, m.y], t0: n * 0.06}) + tg.map((m, n) => {k: 3, x: m.x, y: m.y, s: "-${dmg}", c: "#ffb070", t0: 0.22 + n * 0.06}) + tg.map((m, n) => {k: 2, i: m.i, t0: 0.2 + n * 0.06}) + dead.map((m, n) => {k: 8, m: m.k, x: m.x, y: m.y, f: m.f, t0: 0.28 + n * 0.06})
            log = (log + [len(dead) > 0 ? "FIRE! ${len(dead)} BURNED TO ASH" : "FIRE! ${len(tg)} SCORCHED"]).drop(max(0, len(log) - 2))
            haptic()
            spent = true
          }
        }
      }
      if spent {
        turnN = turnN + 1
        fxLen = 0.5
        fxTap = time
        fxAt = -1
        anim = true
        mm = true
        chk = chk + 1
      }
    }
  }

  // ---- what's in view goes on the map; then the monsters' turn ----------------------------------
  on chk {
    if len(vis) == N {
      seen = seen.map((s, c) => s || vis[c])
    }
    if mm && hero.hp > 0 && len(DM) == N {
      let R = random(1000000)
      let hx = hero.x
      let hy = hero.y
      // Each monster in turn: one that hasn't noticed the hero stays put (it notices once in view);
      // next to the hero it strikes, an archer in line shoots, and the rest step the way that's shortest.
      let res = reduce(range(len(mons)), (A, j) => [A.ms[j]].map(m => [KD[m.k]].map(K => [abs(m.x - hx) + abs(m.y - hy)].map(md => [m.aw || vis[m.y * W + m.x]].map(aw =>
        !aw || A.hp <= 0 || (K.ai == 2 && (turnN + m.i) % 2 == 1) ? merge(A, {ms: set(A.ms, j, merge(m, {aw: aw})), wk: A.wk + (aw && !m.aw ? [j] : [])}) :
        md == 1 || (K.ai == 3 && (m.x == hx || m.y == hy) && md <= 5 && all(range(1, md), s => [(m.y + sign(hy - m.y) * s) * W + m.x + sign(hx - m.x) * s].map(z => grid[z] != 0 && !any(A.ms, o => o.y * W + o.x == z))[0])) ?
          [hash(R, m.i, 1) < (md == 1 ? 0.85 : 0.75)].map(hit => [hit ? max(1, K.atk + m.ab - (md == 1 ? 0 : 1) - hero.def + floor(hash(R, m.i, 2) * 3) - 1) : 0].map(dm => {
            ms: set(A.ms, j, merge(m, {aw: true, f: hx != m.x ? sign(hx - m.x) : m.f})),
            hp: A.hp - dm,
            by: A.hp > 0 && A.hp - dm <= 0 ? (md == 1 ? "A ${K.n}" : "AN ARCHER'S ARROW") : A.by,
            wk: A.wk + (m.aw ? [] : [j]),
            fx: A.fx + (md == 1 ? [{k: 1, i: m.i, a: [m.x, m.y], b: [hx, hy], t0: A.t}] : [{k: 5, a: [m.x, m.y], b: [hx, hy], t0: A.t}]) + (hit ? [{k: 2, i: -1, t0: A.t + 0.1}, {k: 3, x: hx, y: hy, s: "-${dm}", c: "#ff5a4a", t0: A.t + 0.1}] : [{k: 3, x: hx, y: hy, s: "MISS", c: "#a8a0c0", t0: A.t + 0.1}]),
            said: A.said + [hit ? (md == 1 ? "THE ${K.n} ${K.v} YOU: ${dm}" : "AN ARROW HITS YOU: ${dm}") : md == 1 ? "THE ${K.n} MISSES" : "AN ARROW FLIES PAST"],
            t: A.t + 0.16
          })[0])[0] :
          [[0, 1, 2, 3].map(d => [m.x + DX[d], m.y + DY[d]]).filter(p => p[0] >= 0 && p[0] < W && p[1] >= 0 && p[1] < H && (K.ai == 4 || grid[p[1] * W + p[0]] != 0) && !(p[0] == hx && p[1] == hy) && !any(A.ms, o => o.x == p[0] && o.y == p[1]))].map(nb =>
          [K.ai == 1 && hash(R, m.i, 3) < 0.5 ? nb[floor(hash(R, m.i, 4) * len(nb))] : nb.sortBy(p => (K.ai == 4 || DM[p[1] * W + p[0]] >= 99 ? 50 + abs(p[0] - hx) + abs(p[1] - hy) : DM[p[1] * W + p[0]]) + hash(R, m.i, p[0], p[1]) * 0.5)[0]].map(p =>
          p == null || (K.ai != 1 && (K.ai == 4 || DM[p[1] * W + p[0]] >= 99 ? 50 + abs(p[0] - hx) + abs(p[1] - hy) : DM[p[1] * W + p[0]]) >= (K.ai == 4 || DM[m.y * W + m.x] >= 99 ? 50 + md : DM[m.y * W + m.x])) ?
            merge(A, {ms: set(A.ms, j, merge(m, {aw: true})), wk: A.wk + (m.aw ? [] : [j])}) :
            merge(A, {
              ms: set(A.ms, j, merge(m, {x: p[0], y: p[1], aw: true, f: p[0] != m.x ? sign(p[0] - m.x) : m.f})),
              wk: A.wk + (m.aw ? [] : [j]),
              fx: A.fx + [{k: 0, i: m.i, a: [m.x, m.y], b: p, t0: 0.02, t1: 0.14}]
            }))[0])[0]
      )[0])[0])[0])[0], {ms: mons, hp: hero.hp, by: "", wk: [], fx: [], said: [], t: 0.14})
      mons = res.ms
      let nl = log + res.said
      log = nl.drop(max(0, len(nl) - 3))
      fx = fx + res.fx + res.wk.map(j => {k: 10, x: res.ms[j].x, y: res.ms[j].y, t0: 0.16})
      fxLen = max([fxLen] + fx.map(z => (z.t1 ?? z.t0) + 0.5))
      if res.hp <= 0 {
        hero = merge(hero, {hp: 0})
        cause = res.by
        best = max(best, depth)
        bestGold = max(bestGold, gold)
        fxLen = fxLen + 0.6
      } else {
        // the hero gets back a point every sixth turn, and levels up on enough experience
        let xp2 = hero.xp + xpGain
        let up = xp2 >= hero.lv * 5
        let rg = turnN % 6 == 0 ? 1 : 0
        hero = merge(hero, up ? {xp: xp2 - hero.lv * 5, lv: hero.lv + 1, mh: hero.mh + 4, hp: min(hero.mh + 4, res.hp + 4 + floor(hero.mh / 3)), atk: hero.atk + 1} : {xp: xp2, hp: min(hero.mh, res.hp + rg)})
        if up {
          fx = fx + [{k: 7, s: "LEVEL ${hero.lv}", s2: "ATK +1 · HP +4", t0: 0.3}]
          fxLen = max(fxLen, 1.8)
          let nl2 = log + ["YOU REACH LEVEL ${hero.lv}"]
          log = nl2.drop(max(0, len(nl2) - 3))
          haptic()
        }
      }
      xpGain = 0
    }
  }

  back: mode == "play"
  onBack: mode = "title"

  // ---- the art ----------------------------------------------------------------------------------
  let INK = "#0c0a10"

  let SP_HERO = """
    ....oooo..o.
    ...oHhhHooWo
    ..oHHHHHoWWo
    ..oHVVVVoWo.
    ..oHHHHHoWo.
