    .oooooooooo.
    ............
  """
  let P_HERO = {o: "#14121c", H: "#b8c0d0", h: "#eef2fa", V: "#20202a", B: "#4a7ad0", b: "#2e5096", C: "#c8423a", W: "#eef2fa", w: "#f0c040", S: "#e8b088", L: "#5a5068", F: "#3a3040"}
  let P_RAT = {o: "#14121c", R: "#8a7a70", r: "#6e6058", E: "#ff5a4a", P: "#e89aa0", N: "#e89aa0", F: "#e89aa0", t: "#e89aa0"}
  let P_BAT = {o: "#14121c", W: "#6a4a7e", B: "#3e2e4e", E: "#ff5a4a"}
  let P_SLIME = {o: "#14121c", G: "#5ac85a", h: "#b4f4a8", E: "#ffffff"}
  let P_GOBLIN = {o: "#14121c", G: "#7ab04a", Y: "#ffe14a", m: "#3a2020", T: "#8a5a30", W: "#d0d8e0"}
  let P_ARCHER = {o: "#14121c", K: "#4e6a34", k: "#2e401e", S: "#c89870", E: "#ffe14a", B: "#b07a3a", L: "#5a4a3a", F: "#3a2a20"}
  let P_SKELETON = {o: "#14121c", W: "#e8e4d8", m: "#14121c"}
  let P_ORC = {o: "#14121c", O: "#4e8a4a", Y: "#ff5a4a", t: "#f0ead8", A: "#a8b0c0", M: "#6a4a3a", L: "#4a3a30", F: "#2e2420"}
  let P_GHOST = {o: "#14121c", G: "#d0e0f8", g: "#94a6c8"}
  let P_DEMON = {o: "#14121c", R: "#c8303a", r: "#8a2030", W: "#f0e8d0", Y: "#ffe14a", m: "#14121c"}
  let P_POTION = {o: "#14121c", C: "#a07040", G: "#c8e0f0", R: "#e8404a", h: "#ffb0a8"}
  let P_BOMB = {o: "#14121c", B: "#3a3a4a", h: "#7a7a90", F: "#c8a070", Y: "#ffe14a"}
  let P_BLINK = {o: "#14121c", P: "#efe0b8", p: "#c8b488", L: "#a89878", X: "#4a90e0"}
  let P_FIRE = {o: "#14121c", P: "#efe0b8", p: "#c8b488", L: "#a89878", X: "#ff7a3a"}
  let P_GOLD = {o: "#14121c", Y: "#f0c040", h: "#fff0a0", y: "#b88a20"}
  let P_SWORD = {o: "#14121c", W: "#dfe6f0", G: "#f0c040", H: "#8a5a30"}
  let P_SHIELD = {o: "#14121c", A: "#a8b0c0", a: "#4a7ad0", X: "#f0c040"}
  let P_WAIT = {o: "#14121c", W: "#c08a50", S: "#f0d890"}
  let P_DEAD = {o: "#16141c", H: "#5a5866", h: "#6e6c7a", V: "#16141c", B: "#3e3c4a", b: "#34323e", C: "#4a3a40", W: "#6e6c7a", w: "#5a5866", S: "#5e5450", L: "#34323e", F: "#26242e"}
  let MA = [SP_RAT, SP_BAT, SP_SLIME, SP_GOBLIN, SP_ARCHER, SP_SKELETON, SP_ORC, SP_GHOST, SP_DEMON]
  let MP = [P_RAT, P_BAT, P_SLIME, P_GOBLIN, P_ARCHER, P_SKELETON, P_ORC, P_GHOST, P_DEMON]
  let ITA = [SP_POTION, SP_BOMB, SP_SCROLL, SP_SCROLL, SP_GOLD, SP_SWORD, SP_SHIELD]
  let ITP = [P_POTION, P_BOMB, P_BLINK, P_FIRE, P_GOLD, P_SWORD, P_SHIELD]
  // Buttons are pixel art: a light band on top, the face, a shaded band at its foot and a dark lip under it.
  let BTN = {
    wood: ["#f0c890", "#b07a44", "#84542a", "#3e2410"],
    off: ["#6a6680", "#46425a", "#36324a", "#1a1824"],
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
    red: ["#ffaa94", "#e8504a", "#b8333a", "#621822"]
  }
  // the hero and the monsters stand a little smaller than a tile, so one above doesn't sit on the head of one below
  let aq = q * 0.86
  // the walls that hold a torch: a face over floor, one in five or so
  let TORCH = len(grid) < N ? [] : range(N).filter(c => grid[c] == 0 && c < N - W && grid[c + W] != 0 && hash(depth, c, 7) < 0.2)

  Box {
    fill: true
    background: background
    // ---- the title's faint bricks, and the map: drawn again only when they change ---------------
    Canvas {
      fill: true
      if mode == "title" {
        for r in range(ceil(SH / 16) + 1) {
          rect(0, r * 16, SW, 1, fill: alpha(foreground, 0.05))
          for k in range(ceil(SW / 32) + 1) { rect(k * 32 + (r % 2) * 16, r * 16, 1, 16, fill: alpha(foreground, 0.05)) }
        }
      }
      if mode == "play" && len(grid) == N && len(seen) == N && len(vis) == N {
        rect(BX - 2 * q, BY - 2 * q, W * T + 4 * q, H * T + 4 * q, radius: 2 * q, fill: INK)
        for c in range(N) {
          if seen[c] {
            let x0 = BX + c % W * T
            let y0 = BY + floor(c / W) * T
            let g = grid[c]
            if g != 0 {
              rect(x0, y0, T, T, fill: (c % W + floor(c / W)) % 2 == 0 ? "#2c2636" : "#28222f")
              rect(x0, y0, T, 0.5 * q, fill: "#221d29")
              rect(x0, y0, 0.5 * q, T, fill: "#221d29")
              if hash(depth, c, 1) < 0.35 { rect(x0 + floor(1 + hash(depth, c, 2) * 9) * q, y0 + floor(1 + hash(depth, c, 3) * 9) * q, q, q, fill: "#383244") }
              if hash(depth, c, 4) < 0.08 {
                rect(x0 + 3 * q, y0 + 6 * q, 3 * q, 0.6 * q, fill: "#1e1a24")
                rect(x0 + 5.4 * q, y0 + 6 * q, 0.6 * q, 3 * q, fill: "#1e1a24")
              }
              if g == 2 {
                // the stairs down: steps into the dark
                rect(x0 + q, y0 + q, 10 * q, 10 * q, fill: INK)
                rect(x0 + q, y0 + q, 10 * q, 2.4 * q, fill: "#8a80a0")
                rect(x0 + 2 * q, y0 + 3.4 * q, 8 * q, 2.4 * q, fill: "#665e7c")
                rect(x0 + 3 * q, y0 + 5.8 * q, 6 * q, 2.4 * q, fill: "#48425a")
                rect(x0 + 4 * q, y0 + 8.2 * q, 4 * q, 2 * q, fill: "#2e2a3c")
              }
            } else {
              // a wall: its top, lit where floor lies above, a face of bricks where it lies below, and
              // dark edges against the floor
              let so = floor(c / W) < H - 1 && grid[c + W] != 0
              let no = floor(c / W) > 0 && grid[c - W] != 0
              rect(x0, y0, T, T, fill: "#5a5070")
              if hash(depth, c, 5) < 0.5 { rect(x0 + 3 * q, y0 + 3 * q, q, q, fill: "#4c4462") }
              if no { rect(x0, y0, T, 1.4 * q, fill: "#7c7296") }
              if so {
                rect(x0, y0 + 6 * q, T, 6 * q, fill: "#3e3650")
                rect(x0, y0 + 6 * q, T, 0.6 * q, fill: "#24202c")
                rect(x0, y0 + 9 * q, T, 0.6 * q, fill: "#2c2735")
                rect(x0 + (c % 2 == 0 ? 4 : 8) * q, y0 + 6 * q, 0.6 * q, 3 * q, fill: "#2c2735")
                rect(x0 + (c % 2 == 0 ? 9 : 3) * q, y0 + 9 * q, 0.6 * q, 3 * q, fill: "#2c2735")
              }
              if c % W > 0 && grid[c - 1] != 0 { rect(x0, y0, 0.7 * q, T, fill: INK) }
              if c % W < W - 1 && grid[c + 1] != 0 { rect(x0 + T - 0.7 * q, y0, 0.7 * q, T, fill: INK) }
              if no { rect(x0, y0, T, 0.7 * q, fill: INK) }
              if so { rect(x0, y0 + T - 0.7 * q, T, 0.7 * q, fill: INK) }
            }
          }
        }
        // what lies on the floor, where it's been seen
        for z in items {
          if seen[z.c] { sprite(ITA[z.k], BX + z.c % W * T + 1.5 * q, BY + floor(z.c / W) * T + 1.5 * q, 0.75 * q, palette: ITP[z.k]) }
        }
        // what's out of view lies in shadow
        for c in range(N) {
          if seen[c] && !vis[c] { rect(BX + c % W * T, BY + floor(c / W) * T, T, T, fill: alpha("#07060a", grid[c] == 0 ? 0.5 : 0.62)) }
        }
      }
    }
    // ---- the torches: the one thing that moves while nobody does -------------------------------
    Canvas {
      fill: true
      if mode == "play" && len(grid) == N && len(seen) == N && len(vis) == N {
        let tt = time
        for c in TORCH {
          if seen[c] {
            let fx0 = BX + (c % W + 0.5) * T
            let fy0 = BY + floor(c / W) * T + 6.5 * q
            let fl = hash(depth, c, floor(tt * 9))
            circle(fx0, fy0, T * (0.9 + 0.12 * fl), fill: alpha("#ff9a3c", vis[c] ? 0.1 : 0.04))
            rect(fx0 - q, fy0, 2 * q, 3 * q, fill: "#5e4430")
            rect(fx0 - 1.5 * q, fy0 - (2.5 + fl) * q, 3 * q, (2.5 + fl) * q, radius: q, fill: "#ff8a3a")
            rect(fx0 - 0.7 * q, fy0 - (1.6 + fl * 0.6) * q, 1.4 * q, (1.6 + fl * 0.6) * q, fill: "#ffe08a")
          }
        }
      }
    }
    // ---- the hero, the monsters, and what the turn set going: this reads the clock only while
    // a turn plays out, so a still dungeon costs nothing to draw ----
    Canvas {
      fill: true
      if mode == "play" && len(grid) == N && len(seen) == N && len(vis) == N {
        let tt = anim ? time : 0
        let now0 = !anim ? 99 : fxAt < 0 ? 0 : tt - fxAt
        // a time far ahead is from before a reload, when the clock started again
        let FX = now0 < 0 || now0 > 30 ? [] : fx
        let now = now0
        // ---- everyone: where each is drawn, sliding along a step or lunging at a blow ----
        let ACT = [{i: -1, k: -1, x: hero.x, y: hero.y, f: hero.f, hp: hero.hp, mh: hero.mh}] + mons.map(m => {i: m.i, k: m.k, x: m.x, y: m.y, f: m.f, hp: m.hp, mh: m.mh})
        let DISP = ACT.map(u => [FX.find(z => z.k == 0 && z.i == u.i)].map(mv => [FX.find(z => z.k == 1 && z.i == u.i && now >= z.t0 && now < z.t0 + 0.18)].map(lu =>
          [mv == null || now >= mv.t1 ? [u.x, u.y] : now < mv.t0 ? mv.a : [lerp(mv.a[0], mv.b[0], (now - mv.t0) / (mv.t1 - mv.t0)), lerp(mv.a[1], mv.b[1], (now - mv.t0) / (mv.t1 - mv.t0))]].map(p =>
          [lu == null ? 0 : sin((now - lu.t0) / 0.18 * 3.1416) * 0.35].map(lo => {
            u: u,
            px: p[0] + (lu == null ? 0 : (lu.b[0] - lu.a[0]) * lo),
            py: p[1] + (lu == null ? 0 : (lu.b[1] - lu.a[1]) * lo),
            fl: any(FX, z => z.k == 2 && z.i == u.i && now >= z.t0 && now < z.t0 + 0.12),
            sn: u.i == -1 || vis[u.y * W + u.x] || (mv != null && now < mv.t1 && vis[mv.a[1] * W + mv.a[0]])
          })[0])[0])[0])[0]).filter(d => d.sn)
        for d in DISP.sortBy(d => d.py) {
          let u = d.u
          let cx = BX + (d.px + 0.5) * T
          let fy = BY + (d.py + 1) * T - 0.5 * q
          if u.i == -1 && u.hp <= 0 && (over || now > fxLen - 0.6) {
            // fallen
            rect(cx - 5 * q, fy - 3 * q, 10 * q, 3 * q, radius: 1.5 * q, fill: alpha("#4a0a10", 0.6))
            rotate(-90, cx, fy - 4 * q) { sprite(SP_HERO, cx - 6 * aq, fy - 10 * aq, aq, palette: P_DEAD) }
          } else {
            let art = u.i == -1 ? SP_HERO : MA[u.k]
            let lift = u.i == -1 ? floor(tt * 2.2) % 2 * 0.5 * q : u.k == 1 ? (2.5 + sin(tt * 7 + u.i) * 1.5) * q : u.k == 7 ? (1.5 + sin(tt * 2.5 + u.i)) * q : u.k == 2 ? 0 : floor(tt * 1.6 + u.i) % 2 * 0.5 * q
            rect(cx - 4 * q, fy - 1.5 * q, 8 * q, 2 * q, radius: q, fill: alpha("#000000", 0.4))
            scale(u.f, 1, cx, fy) {
              if d.fl {
                sprite(art, cx - 6 * aq, fy - 12 * aq - lift, aq, color: "#ffffff")
              } else if u.k == 7 {
                layer(0.78) { sprite(art, cx - 6 * aq, fy - 12 * aq - lift, aq, palette: P_GHOST) }
              } else {
                sprite(art, cx - 6 * aq, fy - 12 * aq - lift, aq, palette: u.i == -1 ? P_HERO : MP[u.k])
              }
            }
            // a wounded monster's health, under its feet
            if u.i != -1 && u.hp < u.mh {
              rect(cx - 4.5 * q, fy + 0.2 * q, 9 * q, 1.6 * q, fill: INK)
              rect(cx - 4 * q, fy + 0.5 * q, 8 * q * clamp(u.hp / u.mh, 0, 1), q, fill: "#ff5a4a")
            }
          }
        }
        // ---- what the turn set going ----
        for f in FX {
          if f.k == 3 && now >= f.t0 && now < f.t0 + 0.8 {
            let e = now - f.t0
            let tx = BX + (f.x + 0.5) * T
            let ty = BY + (f.y + 0.1) * T - e * 0.7 * T
            text(f.s, tx + 0.5 * q, ty + 0.5 * q, size: 4 * q, color: INK, font: press, align: center)
            text(f.s, tx, ty, size: 4 * q, color: f.c, font: press, align: center)
          } else if f.k == 4 && now >= f.t0 && now < f.t0 + 0.55 {
            // a blast over the nine cells
            let e = (now - f.t0) / 0.55
            let ex = BX + (f.x + 0.5) * T
            let ey = BY + (f.y + 0.5) * T
            if e < 0.3 { rect(ex - 1.5 * T, ey - 1.5 * T, 3 * T, 3 * T, fill: alpha("#ffd27a", 0.45 * (1 - e / 0.3))) }
            circle(ex, ey, T * (0.6 + 1.1 * e), fill: alpha("#ff7a3a", 0.85 * (1 - e)))
            circle(ex, ey, T * (0.3 + 0.7 * e), fill: alpha("#ffe9a0", max(0, 1 - e * 1.6)))
            for k in range(8) {
              let sz = (3 + 3 * hash(f.x, f.y, k)) * q * (1 - e * 0.5)
              rect(ex + cos(k * 0.785 + 0.3) * e * 1.6 * T - sz / 2, ey + sin(k * 0.785 + 0.3) * e * 1.4 * T - e * 0.6 * T - sz / 2, sz, sz, fill: alpha(k % 2 == 0 ? "#5a5660" : "#7a7480", 0.85 * (1 - e)))
            }
          } else if f.k == 5 && now >= f.t0 && now < f.t0 + 0.16 {
            // an arrow
            let e = (now - f.t0) / 0.16
            let ax = BX + (lerp(f.a[0], f.b[0], e) + 0.5) * T
            let ay = BY + (lerp(f.a[1], f.b[1], e) + 0.45) * T
            let ux = sign(f.b[0] - f.a[0])
            let uy = sign(f.b[1] - f.a[1])
            line(ax - ux * 4 * q, ay - uy * 4 * q, ax, ay, stroke: "#e8d8b0", width: 0.8 * q, cap: round)
            rect(ax - q, ay - q, 2 * q, 2 * q, fill: "#ffffff")
          } else if f.k == 6 && now >= f.t0 && now < f.t0 + 0.36 {
            // a bolt of fire, then its burst
            let e = (now - f.t0) / 0.22
            let bx = BX + (f.b[0] + 0.5) * T
            let by = BY + (f.b[1] + 0.5) * T
            if e < 1 {
              let px = BX + (lerp(f.a[0], f.b[0], e) + 0.5) * T
              let py = BY + (lerp(f.a[1], f.b[1], e) + 0.5) * T
              circle(px, py, 2.6 * q, fill: alpha("#ff7a3a", 0.8))
              circle(px, py, 1.4 * q, fill: "#ffe9a0")
            } else {
              let e2 = (e - 1) / 0.64
              circle(bx, by, T * (0.3 + 0.4 * e2), fill: alpha("#ff7a3a", 0.8 * (1 - e2)))
            }
          } else if f.k == 7 && now >= f.t0 && now < f.t0 + 1.5 {
            // a banner across the map
            let e = (now - f.t0) / 1.5
            let a = clamp(min(e * 8, (1 - e) * 6), 0, 1)
            let cy = BY + H * T * 0.42
            layer(a) {
              rect(BX, cy - 30, W * T, 60, fill: alpha(INK, 0.85))
              rect(BX, cy - 30, W * T, 2, fill: "#ffe14a")
              rect(BX, cy + 28, W * T, 2, fill: "#ffe14a")
              text(f.s, BX + W * T / 2 + (1 - a) * 30, cy - 8, size: 16, color: "#ffffff", font: press, align: center)
              text(f.s2, BX + W * T / 2 - (1 - a) * 30, cy + 14, size: 8, color: "#d8d4ec", font: press, align: center)
            }
          } else if f.k == 8 && now >= f.t0 && now < f.t0 + 0.5 {
            // a monster's end: it pales, rises and breaks up
            let e = (now - f.t0) / 0.5
            let cx = BX + (f.x + 0.5) * T
            let fy = BY + (f.y + 1) * T - 0.5 * q
            layer(1 - e) {
              scale(f.f, 1, cx, fy) { sprite(MA[f.m], cx - 6 * aq, fy - 12 * aq - e * 4 * q, aq, color: "#ffffff") }
            }
            for k in range(6) { rect(cx + cos(k * 1.05 + 0.4) * e * T - 0.7 * q, fy - 6 * q + sin(k * 1.05 + 0.4) * e * T - 0.7 * q, 1.4 * q, 1.4 * q, fill: alpha("#ffffff", 1 - e)) }
          } else if f.k == 9 && now >= f.t0 && now < f.t0 + 0.45 {
            // a glint
            let e = (now - f.t0) / 0.45
            let gx = BX + (f.x + 0.5) * T
            let gy = BY + (f.y + 0.45) * T
            for k in range(4) {
              let ang = k * 1.5708 + e * 1.2
              rect(gx + cos(ang) * e * 0.6 * T - 0.8 * q, gy + sin(ang) * e * 0.6 * T - 0.8 * q, 1.6 * q, 1.6 * q, fill: alpha("#fff3a0", 1 - e))
            }
          } else if f.k == 10 && now >= f.t0 && now < f.t0 + 0.8 && vis[f.y * W + f.x] {
            // a monster notices
            let ax = BX + (f.x + 0.5) * T
            let ay = BY + (f.y - 0.55) * T - abs(sin((now - f.t0) * 9)) * 2 * q
            rect(ax - 2 * q, ay - 3.5 * q, 4 * q, 7 * q, radius: q, fill: INK)
            rect(ax - q, ay - 2.5 * q, 2 * q, 3.5 * q, fill: "#ff5a4a")
            rect(ax - q, ay + 1.5 * q, 2 * q, q, fill: "#ff5a4a")
          }
        }
      }
    }
    // ---- the top bar, the panel, and the title and end card over everything; touches land here --
    Canvas {
      fill: true
      onPress: {
        downAt = [x, y]
        sx = 0
        sy = 0
        swiped = false
      }
      onRelease: { downAt = [-1, -1] }
      // a swipe steps once it's gone 24 dp, and again for each 24 more without lifting
      onDrag: {
        sx = sx + dx
        sy = sy + dy
        if mode == "play" && hero.hp > 0 && (abs(sx) > 24 || abs(sy) > 24) {
          swiped = true
          act = abs(sx) > abs(sy) ? (sx > 0 ? 1 : 3) : (sy > 0 ? 2 : 0)
          actN = actN + 1
          sx = 0
          sy = 0
        }
      }
      onTap: {
        if swiped {
          swiped = false
        } else if mode == "title" {
          let going = len(grid) == N && hero.hp > 0
          if y >= TBY && y < TBY + 56 && abs(x - SW / 2) < 120 {
            if going { mode = "play" } else { fresh = fresh + 1 }
            haptic()
          } else if going && y >= TBY + 70 && y < TBY + 106 && abs(x - SW / 2) < 110 {
            fresh = fresh + 1
          }
        } else if hero.hp <= 0 {
          if over && y >= OBY && y < OBY + 50 && abs(x - SW / 2) < 110 {
            fresh = fresh + 1
            haptic()
          }
        } else if x >= HX + HW - 46 && y < TOP + 32 {
          mode = "title"
        } else if y >= BTY && y < BTY + 46 && x >= PX && x < PX + PW {
          let b = min(4, floor((x - PX) / (BW + 6)))
          act = b < 4 ? 5 + b : 4
          actN = actN + 1
        } else if x >= BX && x < BX + W * T && y >= BY && y < BY + H * T {
          // a tap beside the hero steps that way; on the hero, waits
          let ddx = floor((x - BX) / T) - hero.x
          let ddy = floor((y - BY) / T) - hero.y
          act = ddx == 0 && ddy == 0 ? 4 : abs(ddx) >= abs(ddy) ? (ddx > 0 ? 1 : 3) : (ddy > 0 ? 2 : 0)
          actN = actN + 1
        }
      }
      if mode == "play" && len(grid) == N {
        // ---- the top bar: the floor, the gold, the deepest yet, and the way to the title ----
        let ty = TOP + 14
        text("FLOOR ${depth}", HX, ty, size: 9, color: accent, font: press)
        let gx = HX + 9 * len("FLOOR ${depth}") + 14
        sprite(SP_GOLD, gx, ty - 13, 1.6, palette: P_GOLD)
        text("${gold}", gx + 22, ty, size: 8, color: foreground, font: press)
        text("BEST ${max(best, depth)}", HX + HW - 52, ty, size: 7, color: muted, font: press, align: end)
        let md = downAt[0] >= HX + HW - 46 && downAt[1] < TOP + 32 ? 2 : 0
        rect(HX + HW - 38, TOP + 2, 38, 24, radius: 4, fill: INK)
        rect(HX + HW - 36, TOP + 4 + md, 34, 18, radius: 3, fill: "#4a4466")
        for k in range(3) { rect(HX + HW - 27, TOP + 8 + md + k * 4, 16, 2, fill: "#ffffff") }
        // ---- health, experience, attack and defence ----
        let hpw = PW * 0.6
        let hp = max(0, hero.hp)
        text("HP", PX, PY + 10, size: 8, color: foreground, font: press)
        rect(PX + 22, PY + 2, hpw - 22, 16, radius: 3, fill: INK)
        rect(PX + 24, PY + 4, (hpw - 26) * clamp(hp / hero.mh, 0, 1), 12, radius: 2, fill: hp <= hero.mh / 3 ? "#ff5a4a" : "#6fe05a")
        text("${hp}/${hero.mh}", PX + 22 + (hpw - 22) / 2 + 1, PY + 11, size: 7, color: INK, font: press, align: center)
        text("${hp}/${hero.mh}", PX + 22 + (hpw - 22) / 2, PY + 10, size: 7, color: "#ffffff", font: press, align: center)
        text("LV${hero.lv}", PX, PY + 30, size: 7, color: accent, font: press)
        rect(PX + 40, PY + 27, hpw - 40, 6, radius: 2, fill: alpha(foreground, 0.12))
        rect(PX + 40, PY + 27, (hpw - 40) * clamp(hero.xp / (hero.lv * 5), 0, 1), 6, radius: 2, fill: accent)
        let ax = PX + hpw + 12
        sprite(SP_SWORD, ax, PY - 1, 1.7, palette: P_SWORD)
        text("${hero.atk}", ax + 23, PY + 10, size: 8, color: foreground, font: press)
        sprite(SP_SHIELD, ax + 46, PY - 1, 1.7, palette: P_SHIELD)
        text("${hero.def}", ax + 69, PY + 10, size: 8, color: foreground, font: press)
        text("${kills} SLAIN", ax, PY + 30, size: 6, color: muted, font: press)
        // ---- the last of the log ----
        let ll = log.drop(max(0, len(log) - 2))
        for s, n in ll { text(s, PX, PY + 50 + n * 14, size: 7, color: n == len(ll) - 1 ? foreground : muted, font: press) }
        // ---- the items carried, and a wait ----
        for b in range(5) {
          let x0 = PX + b * (BW + 6)
          let can = hero.hp > 0 && (b == 4 || inv[b] > 0)
          let pal = can ? BTN.wood : BTN.off
          let pd = downAt[1] >= BTY && downAt[1] < BTY + 46 && downAt[0] >= x0 && downAt[0] < x0 + BW ? 3 : 0
          rect(x0, BTY + 4, BW, 42, radius: 4, fill: pal[3])
          rect(x0, BTY + pd, BW, 42, radius: 4, fill: pal[1], stroke: INK, width: 2)
          rect(x0 + 3, BTY + pd + 3, BW - 6, 4, radius: 2, fill: pal[0])
          rect(x0 + 3, BTY + pd + 34, BW - 6, 5, radius: 2, fill: pal[2])
          layer(can ? 1 : 0.45) { sprite(b < 4 ? ITA[b] : SP_WAIT, x0 + BW / 2 - 12, BTY + pd + 4, 2, palette: b < 4 ? ITP[b] : P_WAIT) }
          let lab = ["HEAL", "BOMB", "BLINK", "FIRE", "WAIT"][b]
          text(lab, x0 + BW / 2 + 1, BTY + pd + 34, size: 6, color: INK, font: press, align: center)
          text(lab, x0 + BW / 2, BTY + pd + 33, size: 6, color: can ? "#ffffff" : "#a8a2c0", font: press, align: center)
          if b < 4 {
            rect(x0 + BW - 15, BTY + pd + 3, 13, 12, radius: 3, fill: INK)
            text("${inv[b]}", x0 + BW - 8.5, BTY + pd + 9.5, size: 6, color: inv[b] > 0 ? "#ffe14a" : "#7a7490", font: press, align: center)
          }
        }
        // ---- the end of a run ----
        if over && hero.hp <= 0 {
          rect(0, 0, SW, SH, fill: alpha("#06070b", 0.65))
          let ccw = min(SW - 40, 320)
          let ccx = SW / 2 - ccw / 2
          let ccy = SH * 0.26
          rect(ccx, ccy + 4, ccw, 280, radius: 14 * corners, fill: alpha("#000000", 0.35))
          rect(ccx, ccy, ccw, 280, radius: 14 * corners, fill: surface, stroke: INK, width: 2)
          rect(ccx - 10, ccy + 16, ccw + 20, 44, radius: 4, fill: "#8a2a32", stroke: INK, width: 2)
          rect(ccx - 7, ccy + 19, ccw + 14, 3, radius: 1.5, fill: alpha("#ffffff", 0.3))
          text("YOU DIED", SW / 2 + 2, ccy + 41, size: 16, color: INK, font: press, align: center)
          text("YOU DIED", SW / 2, ccy + 39, size: 16, color: "#ffffff", font: press, align: center)
          text("SLAIN BY ${cause}", SW / 2, ccy + 84, size: 7, color: foreground, font: press, align: center)
          text("ON FLOOR ${depth}", SW / 2, ccy + 104, size: 8, color: foreground, font: press, align: center)
          text("LEVEL ${hero.lv} · ${kills} SLAIN · ${gold} GOLD", SW / 2, ccy + 130, size: 7, color: muted, font: press, align: center)
          text(depth >= best ? "YOUR DEEPEST YET" : "DEEPEST: FLOOR ${best}", SW / 2, ccy + 160, size: 8, color: accent, font: press, align: center)
          text("DEATH IS FOR GOOD", SW / 2, ccy + 184, size: 6, color: muted, font: press, align: center)
          let pd = downAt[1] >= OBY && downAt[1] < OBY + 50 && abs(downAt[0] - SW / 2) < 110 ? 3 : 0
          rect(SW / 2 - 110, OBY + 4, 220, 46, radius: 4, fill: BTN.red[3])
          rect(SW / 2 - 110, OBY + pd, 220, 46, radius: 4, fill: BTN.red[1], stroke: INK, width: 2)
          rect(SW / 2 - 107, OBY + pd + 3, 214, 4, radius: 2, fill: BTN.red[0])
          rect(SW / 2 - 107, OBY + pd + 37, 214, 6, radius: 2, fill: BTN.red[2])
          text("NEW RUN", SW / 2 + 2, OBY + pd + 25, size: 13, color: INK, font: press, align: center)
          text("NEW RUN", SW / 2, OBY + pd + 23, size: 13, color: "#ffffff", font: press, align: center)
        }
      }
      // ---- the title ----
      if mode == "title" {
        let tt = time
        let ty = LS ? TOP + 40 : SH * 0.17
        let ls = min(40, (SW - 40) / 5)
        text("DELVE", SW / 2 + 3, ty + 3, size: ls, color: INK, font: press, align: center)
        text("DELVE", SW / 2, ty, size: ls, color: accent, font: press, align: center)
        text("A DUNGEON CRAWL", SW / 2, ty + ls * 0.5 + 18, size: 8, color: muted, font: press, align: center)
        // a doorway with stairs going down, a torch either side, and the hero before it
        let sc = LS ? 4 : min(6, SW / 64)
        let dy = LS ? ty + 50 : SH * 0.3
        let dx = SW / 2
        rect(dx - 22 * sc, dy, 44 * sc, 26 * sc, fill: "#4a4258")
        rect(dx - 22 * sc, dy, 44 * sc, 1.5 * sc, fill: "#6a6080")
        rect(dx - 9 * sc, dy + 5 * sc, 18 * sc, 21 * sc, radius: 9 * sc, fill: INK)
        rect(dx - 9 * sc, dy + 14 * sc, 18 * sc, 12 * sc, fill: INK)
        for k in range(4) { rect(dx - (8 - k * 1.5) * sc, dy + (14 + k * 3) * sc, (16 - k * 3) * sc, 2 * sc, fill: ["#8a80a0", "#665e7c", "#48425a", "#2e2a3c"][k]) }
        for sd in [-1, 1] {
          let fx0 = dx + sd * 14.5 * sc
          let fy0 = dy + 9 * sc
          let fl = hash(sd, floor(tt * 9))
          circle(fx0, fy0, (6 + fl) * sc, fill: alpha("#ff9a3c", 0.12))
          rect(fx0 - sc, fy0, 2 * sc, 3 * sc, fill: "#5e4430")
          rect(fx0 - 1.5 * sc, fy0 - (2.5 + fl) * sc, 3 * sc, (2.5 + fl) * sc, radius: sc, fill: "#ff8a3a")
          rect(fx0 - 0.7 * sc, fy0 - (1.6 + fl * 0.6) * sc, 1.4 * sc, (1.6 + fl * 0.6) * sc, fill: "#ffe08a")
        }
        rect(dx - 28 * sc, dy + 26 * sc, 56 * sc, 2 * sc, fill: "#2c2636")
        rect(dx - 19 * sc, dy + 26.5 * sc, 10 * sc, 2 * sc, radius: sc, fill: alpha("#000000", 0.4))
        sprite(SP_HERO, dx - 20 * sc, dy + 15.5 * sc - floor(tt * 2.2) % 2 * 0.5 * sc, sc, palette: P_HERO)
        // a run under way carries on; else a new one
        let going = len(grid) == N && hero.hp > 0
        if going { text("FLOOR ${depth} · LEVEL ${hero.lv}", SW / 2, TBY - 18, size: 8, color: foreground, font: press, align: center) }
        let pd = downAt[1] >= TBY && downAt[1] < TBY + 56 && abs(downAt[0] - SW / 2) < 120 ? 3 : 0
        rect(SW / 2 - 120, TBY + 5, 240, 50, radius: 4, fill: BTN.go[3])
        rect(SW / 2 - 120, TBY + pd, 240, 50, radius: 4, fill: BTN.go[1], stroke: INK, width: 2)
        rect(SW / 2 - 117, TBY + pd + 3, 234, 4, radius: 2, fill: BTN.go[0])
        rect(SW / 2 - 117, TBY + pd + 41, 234, 6, radius: 2, fill: BTN.go[2])
        let dl = going ? "CONTINUE" : "DESCEND"
        text(dl, SW / 2 + 2, TBY + pd + 26, size: 14, color: INK, font: press, align: center)
        text(dl, SW / 2, TBY + pd + 24, size: 14, color: "#ffffff", font: press, align: center)
        if going {
          let nd = downAt[1] >= TBY + 70 && downAt[1] < TBY + 106 && abs(downAt[0] - SW / 2) < 110 ? 2 : 0
          rect(SW / 2 - 110, TBY + 72 + nd, 220, 32, radius: 4, fill: alpha(foreground, 0.08), stroke: alpha(foreground, 0.2), width: 1)
          text("NEW RUN", SW / 2, TBY + 88 + nd, size: 8, color: muted, font: press, align: center)
        }
        let hy = going ? TBY + 128 : TBY + 82
        text("SWIPE OR TAP TO MOVE", SW / 2, hy, size: 7, color: muted, font: press, align: center)
        text("WALK INTO MONSTERS TO FIGHT", SW / 2, hy + 16, size: 7, color: muted, font: press, align: center)
        text("ONE LIFE: DEATH IS FOR GOOD", SW / 2, hy + 32, size: 7, color: muted, font: press, align: center)
        if best > 0 { text("DEEPEST: FLOOR ${best} · MOST GOLD: ${bestGold}", SW / 2, hy + 58, size: 7, color: accent, font: press, align: center) }
      }
    }
  }
}
