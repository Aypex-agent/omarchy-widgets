app "delve" {
  // A roguelike dungeon crawl in pixel art, one floor to a screen. Swipe (or tap beside the hero)
  // to step; walk into a monster to fight it. Every step is a turn, and then every monster that
  // has noticed the hero takes one too. Potions, bombs and scrolls wait to be used; swords and
  // shields count at once. The stairs lead down to a new floor, deeper and worse, and death ends
  // the run for good: only the deepest floor is kept.
  //
  // There's no game loop: a step resolves at once, in `on actN`, and `on chk` plays the monsters'
  // turn. Both leave timed events (`fx`, in seconds from the turn's start) that the canvases play
  // from `fxAt`, the frame clock when the turn began.

  meta { owl: 23; description: "A roguelike dungeon crawl in pixel art: swipe to move and fight, one floor per screen; potions, bombs and scrolls, stairs down to worse monsters, and death is for good"; version: "1.1"; license: "MIT"; category: "games" }
  strings {
    en {
      // Monsters, and what each does to the hero ("THE RAT BITES YOU: 2"); log lines are 7 px pixel font, keep them short.
      mons: ["RAT", "BAT", "SLIME", "GOBLIN", "ARCHER", "SKELETON", "ORC", "GHOST", "DEMON"]
      verbs: ["BITES", "BITES", "BURNS", "STABS", "HITS", "HITS", "CLEAVES", "CHILLS", "CLAWS"]
      items: ["A POTION", "A BOMB", "A BLINK SCROLL", "A FIRE SCROLL", "GOLD", "A SWORD: ATK +1", "A SHIELD: DEF +1"]
      empty: ["NO POTIONS LEFT", "NO BOMBS LEFT", "NO BLINK SCROLLS", "NO FIRE SCROLLS"]
      intro1: "THE DUNGEON TAKES YOU IN"
      intro2: "FIND THE STAIRS DOWN"
      floor: n => "FLOOR ${n}"
      theDungeon: "THE DUNGEON"
      deeper: "DEEPER"
      slay: n => "YOU SLAY THE ${n}"
      hit: (n, d) => "YOU HIT THE ${n}: ${d}"
      miss: n => "YOU MISS THE ${n}"
      missFx: "MISS"
      findGold: n => "YOU FIND ${n} GOLD"
      find: s => "YOU FIND ${s}"
      down: n => "YOU GO DOWN TO FLOOR ${n}"
      drink: n => "YOU DRINK A POTION: +${n} HP"
      boomNone: "BOOM! NOTHING CAUGHT"
      boomDead: n => "BOOM! ${n} BLOWN AWAY"
      boomHit: n => "BOOM! ${n} CAUGHT"
      blink: "YOU BLINK AWAY"
      noBurn: "NOTHING IN VIEW TO BURN"
      fireDead: n => "FIRE! ${n} BURNED TO ASH"
      fireHit: n => "FIRE! ${n} SCORCHED"
      // What killed the hero, after "SLAIN BY".
      byMon: n => "A ${n}"
      byArrow: "AN ARCHER'S ARROW"
      monHits: (n, v, d) => "THE ${n} ${v} YOU: ${d}"
      arrowHits: d => "AN ARROW HITS YOU: ${d}"
      monMisses: n => "THE ${n} MISSES"
      arrowPast: "AN ARROW FLIES PAST"
      level: n => "LEVEL ${n}"
      reachLevel: n => "YOU REACH LEVEL ${n}"
      best: n => "BEST ${n}"
      slain: n => "${n} SLAIN"
      // The item buttons, 6 px in a fifth of the width.
      buttons: ["HEAL", "BOMB", "BLINK", "FIRE", "WAIT"]
      youDied: "YOU DIED"
      slainBy: c => "SLAIN BY ${c}"
      onFloor: n => "ON FLOOR ${n}"
      runLine: (l, k, g) => "LEVEL ${l} · ${k} SLAIN · ${g} GOLD"
      deepestYet: "YOUR DEEPEST YET"
      deepest: n => "DEEPEST: FLOOR ${n}"
      forGood: "DEATH IS FOR GOOD"
      newRun: "NEW RUN"
      tagline: "A DUNGEON CRAWL"
      going: (f, l) => "FLOOR ${f} · LEVEL ${l}"
      cont: "CONTINUE"
      descend: "DESCEND"
      help1: "SWIPE OR TAP TO MOVE"
      help2: "WALK INTO MONSTERS TO FIGHT"
      help3: "ONE LIFE: DEATH IS FOR GOOD"
      records: (f, g) => "DEEPEST: FLOOR ${f} · MOST GOLD: ${g}"
    }
