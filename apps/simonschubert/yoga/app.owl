app "yoga" {
  meta { owl: 23; description: "Guided, spoken yoga sessions with a timer for every pose: 26 sessions, 48 poses with how-tos and benefits, a daily streak and levels. No account needed."; version: "1.6"; license: "MIT"; category: "home" }
  // The window's title names what's open; Back goes to the menu, and during a session it asks first.
  title: view == "pose" ? poses[pid - 1].name : view == "menu" ? str.title : session.name
  back: view != "menu"
  onBack: {
    quitting = view == "session" && phase != "intro" && !quitting
    endsAt = quitting ? endsAt : 0
    paused = quitting ? paused : false
    view = quitting ? view : "menu"
    sound(quitting ? null : "stop")
  }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <path d="M128 182c-38-8-72-36-82-76 40 0 72 30 82 76z" fill="#BB9AF7"/>
    <path d="M128 182c38-8 72-36 82-76-40 0-72 30-82 76z" fill="#BB9AF7"/>
    <path d="M128 50c26 30 30 92 0 132-30-40-26-102 0-132z" fill="#F5A8D0"/>
    <rect x="64" y="196" width="128" height="14" rx="7" fill="#7DCFFF"/>
  </svg>"""

  // A port of YogaBase (github.com/SimonSchubert/YogaBase), with its voice.
  source now = clock every 1s

  // Progress, kept by the launcher: finished session ids, the daily streak and XP.
  state done = [] persist
  state streak = 0 persist
  state lastDay = "" persist
  state xp = 0 persist
  state pace = 1 persist
  state voice = true persist

  state view = "menu"
  state tab = "sessions"
  // The bottom bar's icons, Material's playlist play and self improvement (Apache 2.0).
  asset sessionsIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI2ZmZiIgZD0iTTMgMTBoMTF2Mkgzem0wLTRoMTF2Mkgzem0wIDhoN3YySDN6bTEzLTF2OGw2LTR6Ii8+PC9zdmc+"
  asset posesIcon = base64""
  state sid = 1
  state pid = 1
  // A session runs intro → hold → gap → hold … → finish; at endsAt moves it on.
  state phase = "intro"
  state step = ""
  state idx = 0
  state endsAt = 0
  state paused = false
  state left = 0
  state quitting = false
  state gained = 0

  // The text a person reads; poseText and sessionText are by id - 1.
  strings {
    en {
      // The window's title on the menu.
      title: "yoga"
      // The menu's bottom bar tabs (style small, half the width each).
      sessions: "sessions"; poses: "poses"
      levels: {beginner: "beginner", intermediate: "intermediate", advanced: "advanced"}
      // Ranks by level, shown after "level N · ".
      ranks: {novice: "Novice", practitioner: "Practitioner", adept: "Adept", devotee: "Devotee", teacher: "Teacher", master: "Master"}
      // The pace buttons before a session starts: short (half the hold), normal, long (double).
      paces: {swift: "swift", balanced: "balanced", endurance: "endurance"}
      levelRank: (n, rank) => "level ${n} · ${rank}"
      // Right of levelRank, 120 dp wide; also big on the finish screen.
      streak: n => n == 1 ? "1 day streak" : "${n} day streak"
      xpLine: (xp, need, next) => "${xp} xp · ${need} to level ${next}"
      // A badge on a finished session's card, small text, 40 dp wide.
      completed: "done"
      // A session card's foot: its level, how many poses, how long.
      sessionLine: (level, n, time) => "${level} · ${n} poses · ${time}"
      // A pose's page: its level, how long it's held, and whether on both sides.
      poseLine: (level, time, sides) => sides ? "${level} · hold ${time} · both sides" : "${level} · hold ${time}"
      how: "how"; benefits: "benefits"; inSessions: "in sessions"
      // Starts a session from a pose's page; 60 dp wide.
      startArrow: "start ›"
      getReady: "get ready"
      first: name => "first: ${name}"
      introLine: (n, time) => "${n} poses · ${time} at this pace"
      startNow: "start now"
      poseOf: (i, n) => "pose ${i} of ${n}"
      voiceOn: "voice on"; voiceOff: "voice off"
      nextPose: "next pose"; paused: "paused"; readyNext: "get ready for the next pose…"
      firstSide: "first side"; secondSide: "second side"; lastPose: "last pose"
      quitAsk: "quit this session?"; keepGoing: "keep going"; quit: "quit"
      resume: "resume"; pause: "pause"; skip: "skip"
      greatJob: "great job"
      levelUp: (n, rank) => "level ${n}: ${rank}"
      xpHint: "xp comes with the first session of the day"
      done: "done"; again: "again"
      poseText: [
        {name: "Boat", translation: "nāva = boat, āsana = posture", description: "Sit with legs extended. Exhale, lift legs to 45 degrees, lean back slightly. Extend arms forward, palms facing. Balance on sit bones, engage core. Gaze at toes, breathe.", benefits: "Strengthens the abdomen, hip flexors, and spine. Stimulates the kidneys, thyroid and prostate glands, and intestines. Helps relieve stress. Improves digestion."},
        {name: "Half Boat", translation: "ardha = half, nāva = boat, āsana = posture", description: "Sit, knees bent, feet lifted. Lean back slightly, hold behind thighs or extend arms. Balance, engage core, gaze forward, breathe.", benefits: "Strengthens the abdomen, hip flexors and spine. Stimulates the kidneys, thyroid, prostate glands and intestines. Helps relieve stress. Improves digestion."},
        {name: "Bow", translation: "dhanur = bow, āsana = posture", description: "Lie on stomach. Bend knees, grab ankles. Inhale, lift chest and thighs, press feet into hands. Gaze forward, breathe.", benefits: "Stretches the entire front of the body, ankles, thighs and groins, abdomen and chest, and throat, and deep hip flexors (psoas). Strengthens the back muscles. Improves posture. Stimulates the organs of the abdomen and neck."},
        {name: "Bridge", translation: "setu = bridge, bandha = lock, sarva = all, āṅga = limb, āsana = posture", description: "Lie on back, knees bent, feet hip-width. Inhale, lift hips, clasp hands under back. Roll shoulders under, lift chest. Gaze up, breathe.", benefits: "Stretches the chest, neck, and spine. Stimulates abdominal organs, lungs, and thyroids. Rejuvenates tired legs. Improves digestion. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done supported. Reduces anxiety, fatigue, backache, headache, and insomnia. Therapeutic for asthma, high blood pressure, osteoporosis, and sinusitis."},
        {name: "Butterfly", translation: "baddha = bound, koṇa = angle, āsana = posture", description: "Sit with soles together, knees out. Hold feet, sit tall. Relax shoulders, breathe deeply.", benefits: "Opens the hips and groins. Stretches the shoulders, rib cage and back. Stimulates the abdominal organs, lungs and heart."},
        {name: "Camel", translation: "uṣṭra = camel, āsana = posture", description: "Kneel, hands on lower back. Inhale, lift chest, reach for heels if comfortable. Keep neck neutral, gaze forward, breathe.", benefits: "Stretches the entire front of the body, the ankles, thighs and groins, abdomen and chest, and throat. Stretches the deep hip flexors (psoas). Strengthens back muscles. Improves posture. Stimulates the organs of the abdomen and neck."},
        {name: "Cat", translation: "marjarya = cat, āsana = posture", description: "On hands and knees. Exhale, round spine up, tuck chin. Engage core, gaze at belly, breathe.", benefits: "Relieves the spine and neck. Energizes the body."},
        {name: "Cow", translation: "bitil = cow, āsana = posture", description: "On hands and knees. Inhale, arch spine down, lift tailbone and chest. Gaze up, breathe.", benefits: "Removes fatigue. Improves breathing and the circulation of blood to the brain. Rejuvenates the entire body."},
        {name: "Chair", translation: "utkaṭa = fierce, āsana = posture", description: "Stand, feet together. Inhale, bend knees as if sitting, lift arms overhead. Weight in heels, gaze forward, breathe.", benefits: "Strengthens the ankles, thighs, calves, and spine. Stretches shoulders and chest. Stimulates the abdominal organs, diaphragm, and heart. Reduces flat feet. Energizes the entire body."},
        {name: "Child's Pose", translation: "bala = child, āsana = posture", description: "Kneel, toes together, knees apart. Exhale, fold forward, arms extended. Forehead on mat, relax, breathe.", benefits: "Gently stretches the hips, thighs, and ankles. Calms the brain and helps relieve stress and fatigue. Relieves back and neck pain when done with head and torso supported."},
        {name: "Corpse", translation: "śava = corpse, āsana = posture", description: "Lie on back, legs extended, arms by sides, palms up. Close eyes, relax completely, breathe deeply.", benefits: "Calms the brain and helps relieve stress and mild depression. Relaxes the body. Reduces headache, fatigue, and insomnia. Helps to lower blood pressure."},
        {name: "Crescent Lunge", translation: "ashta = side, chandra = moon, āsana = posture", description: "Step one foot forward, lunge. Back knee down or lifted. Inhale, lift arms overhead. Sink hips, gaze forward, breathe.", benefits: "Stretches the rib cage, arms and torso. Tones the oblique muscles."},
        {name: "Crow", translation: "baka = crane, āsana = posture", description: "Squat, hands on mat, shoulder-width. Knees on upper arms. Exhale, shift forward, lift feet. Balance, gaze forward, breathe.", benefits: "Strengthens arms and wrists. Stretches the upper back. Strengthens the abdominal muscles. Opens the groin. Tones the abdominal organs."},
        {name: "Dolphin", translation: "pīñcha = feather, mayūra = peacock, āsana = posture", description: "From Downward Dog, lower to forearms, elbows under shoulders. Lift hips, press heels down. Engage core, gaze between hands, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Energizes the body. Stretches the shoulders, hamstrings, calves, arches, and hands. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done with the head supported. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica, and sinusitis. Warms up the ankles and the toes."},
        {name: "Downward-Facing Dog", translation: "parivṛtta = revolved, adho = downward, mukha = facing, śvāna = dog, āsana = posture", description: "Hands and knees. Exhale, lift hips up and back. Straighten legs, press heels down. Lengthen spine, gaze between legs, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Energizes the body. Stretches the shoulders, neck, hamstrings, calves, arches, and hands. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Relieves menstrual discomfort when done with the head supported. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica, and sinusitis."},
        {name: "Eagle", translation: "garuḍa = eagle, āsana = posture", description: "Stand, cross right leg over left, hook foot behind calf. Cross left arm over right, press palms. Lift elbows, gaze forward, breathe.", benefits: "Strengthens and stretches the ankles and calves. Stretches the thighs, hips, shoulders, and upper back. Improves concentration. Improves sense of balance."},
        {name: "Extended Hand to Toe", translation: "utthita = extended, hasta = hand, pādāṅguṣṭha = big toe, āsana = posture", description: "Stand, lift right leg, hold big toe with right hand. Extend leg forward, hips squared. Gaze forward, breathe.", benefits: "Opens the hips and groins. Stretches the hamstrings, IT bands and legs. Improves balance."},
        {name: "Extended Side Angle", translation: "utthita = extended, pārśva = side, koṇa = angle, āsana = posture", description: "From Warrior II, bend front knee deeper. Reach front arm overhead, back hand on leg or floor. Open chest, gaze up, breathe.", benefits: "Strengthens and stretches the legs, knees, and ankles. Stretches the groin, spine, waist, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina."},
        {name: "Forearm Stand", translation: "pīñcha = feather, mayūra = peacock, āsana = posture", description: "From Dolphin, walk feet closer. Exhale, lift legs one at a time, balance on forearms. Engage core, gaze forward, breathe.", benefits: "Strengthens arms and shoulders. Improves focus and balance. Stretches the upper and lower back. Strengthens the abdominal muscles. Tones the abdominal area."},
        {name: "Forward Bend with Shoulder Opener", translation: "uttāna = stretch out, āsana = posture", description: "Stand, fold forward, interlace hands behind back. Lift arms gently, relax head. Gaze down, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the liver and kidneys. Stretches the hamstrings, calves, and hips. Strengthens the thighs and knees. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and anxiety. Relieves headache and insomnia. Opens the shoulders."},
        {name: "Half-Moon", translation: "ardha = half, chandra = moon, āsana = posture", description: "From Warrior III, hand on floor beside front foot. Lift back leg parallel, extend opposite arm up. Open hips, gaze up or down, breathe.", benefits: "Strengthens the abdomen, ankles, thighs, buttocks and spine. Stretches the groins, hamstrings, calves, shoulders, chest and spine. Improves coordination and sense of balance. Helps relieve stress. Improves digestion."},
        {name: "Handstand", translation: "adho = downward, mukha = facing, vṛkṣa = tree, āsana = posture", description: "From Downward Dog, walk feet closer. Shift weight, kick legs up, straighten. Engage core, gaze forward, breathe.", benefits: "Strengthens the shoulders, arms and wrists. Stretches the belly. Improves sense of balance. Calms the brain and helps relieve stress and mild depression."},
        {name: "Low Lunge", translation: "aṅjaneya = praise, āsana = posture", description: "Step right foot forward, lunge. Lower left knee, hands on thigh or overhead. Sink hips, gaze forward, breathe.", benefits: "Stretches the chest, lungs, neck, belly and groin (psoas). Strengthens the shoulders, arms and back muscles. Strengthens and stretches the thighs, calves and ankles."},
        {name: "Pigeon", translation: "supta = supine, kapota = pigeon, āsana = posture", description: "Lie on back, cross right ankle over left knee. Pull left knee to chest. Keep back grounded, gaze up, breathe.", benefits: "Stretches the hamstrings and quads. If the elbow is used to push the thigh, it opens the hips as well."},
        {name: "King Pigeon", translation: "eka = one, pāda = foot or leg, rāja = king, kapota = pigeon, āsana = posture", description: "From Pigeon, bend back knee, grab foot with hand. Lift chest, open heart. Gaze forward, breathe.", benefits: "Stretches the thighs, groins (psoas), abdomen, chest, shoulders and neck. Stimulates the abdominal organs. Opens the shoulders and chest."},
        {name: "Plank", translation: "phalaka = plank, āsana = posture", description: "Hands and knees, step feet back. Body straight, hands under shoulders. Engage core, gaze down, breathe.", benefits: "Strengthens the arms, wrists, and spine. Tones the abdomen."},
        {name: "Plow", translation: "hala = plow, āsana = posture", description: "Lie on back. Exhale, lift legs over head, toes to floor behind. Support back or clasp hands. Gaze inward, breathe.", benefits: "Calms the brain. Stimulates the abdominal organs and the thyroid glands. Stretches the shoulders and spine. Helps relieve the symptoms of menopause. Reduces stress and fatigue. Therapeutic for backache, headache, infertility, insomnia, and sinusitis."},
        {name: "Pyramid", translation: "pārśva = side, uttāna = stretch out, āsana = posture", description: "Step right foot forward, left back. Hinge at hips, fold over front leg. Hands on floor or blocks. Gaze down, breathe.", benefits: "Calms the brain. Stretches the spine, the shoulders, the hips and the hamstrings. Strengthens the legs. Stimulates the abdominal organs. Improves posture and sense of balance. Improves digestion."},
        {name: "Reverse Warrior", translation: "pārśva = side, vīrabhadra = warrior, āsana = posture", description: "From Warrior II, reach front arm overhead and back. Slide back hand down leg. Open chest, gaze up, breathe.", benefits: "Strengthens and stretches the legs, knees, and ankles. Stretches the groin, spine, waist, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina. Relieves backaches, especially through second trimester of pregnancy. Therapeutic for carpal tunnel syndrome, flat feet, infertility, osteoporosis, and sciatica."},
        {name: "Seated Forward Bend", translation: "paśchima = back, uttāna = stretch out, āsana = posture", description: "Sit, legs extended. Inhale, lengthen spine. Exhale, fold forward, reach for feet or shins. Keep spine long, gaze forward, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stretches the spine, shoulders and hamstrings. Stimulates the liver, kidneys, ovaries and uterus. Improves digestion. Helps relieve the symptoms of menopause and menstrual discomfort. Soothes headache and anxiety. Reduces fatigue. Therapeutic for high blood pressure, infertility, insomnia and sinusitis. Traditional texts say that Paschimottanasana increases appetite, reduces obesity and cures diseases."},
        {name: "Lotus", translation: "padma = lotus, āsana = posture", description: "Sit, place right foot on left thigh, left foot on right. Hands on knees, sit tall, breathe.", benefits: "Opens the hips, groin and stretches the knees, ankles and thighs. Strengthens the back and calms the mind, reduces stress and anxiety. Improves circulation and blood flow in the pelvis."},
        {name: "Half Lord of the Fishes", translation: "ardha = half, matsya = fish, indra = king", description: "Sit, cross right knee over left, twist right. Left elbow outside right knee, right hand behind. Gaze over shoulder, breathe.", benefits: "Stretches the shoulders, the chest, the thighs, the groins, and the abdomen. Strengthens the legs and the ankles. Improves balance."},
        {name: "Shoulder Stand", translation: "sa = with, ālamba = support, sarvāṅga = all limb, āsana = posture", description: "Lie on back. Exhale, lift legs and hips up, support back with hands. Straighten legs, gaze inward, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the thyroid and prostate glands and abdominal organs. Stretches the shoulders and neck. Tones the legs and buttocks. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and alleviates insomnia. Therapeutic for asthma, infertility, and sinusitis."},
        {name: "Side Plank", translation: "vasiṣṭha = name of a sage, āsana = posture", description: "From Plank, roll onto outer right foot. Stack feet, lift left arm up. Engage core, gaze up, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stretches the shoulders, hamstrings, calves, and arches. Strengthens the arms and legs. Helps relieve the symptoms of menopause. Helps prevent osteoporosis. Improves digestion. Relieves headache, insomnia, back pain, and fatigue. Therapeutic for high blood pressure, asthma, flat feet, sciatica."},
        {name: "Sphinx", translation: "sālamba = supported, bhujaṅga = serpent, āsana = posture", description: "Lie on stomach, forearms on mat, elbows under shoulders. Inhale, lift chest, press shoulders down. Gaze forward, breathe.", benefits: "Strengthens the spine. Stretches the chest, the lungs, the shoulders and the abdomen. Stimulates the abdominal organs. Opens the heart and the lungs."},
        {name: "Splits", translation: "hanumān = monkey deity, āsana = posture", description: "From Lunge, slide front foot forward, back foot back. Lower hips, keep squared. Hands on floor or blocks. Gaze forward, breathe.", benefits: "Stretches the thighs, hamstrings, and groin. Stimulates the abdominal organs."},
        {name: "Garland Pose", translation: "mālā = garland or necklace, āsana = posture", description: "Squat, feet together or apart. Elbows inside knees, palms at heart. Push knees out, sink hips, gaze forward, breathe.", benefits: "Stretches the ankles, groins and back torso. Tones the belly."},
        {name: "Standing Forward Bend", translation: "uttāna = stretch out, āsana = posture", description: "Stand, fold forward, hands to floor or shins. Keep spine long, head heavy. Gaze down, breathe.", benefits: "Calms the brain and helps relieve stress and mild depression. Stimulates the liver and kidneys. Stretches the hamstrings, calves, and hips. Strengthens the thighs and knees. Improves digestion. Helps relieve the symptoms of menopause. Reduces fatigue and anxiety. Relieves headache and insomnia."},
        {name: "Crescent Moon", translation: "ashta = side, chandra = moon, āsana = posture", description: "Stand, clasp hands overhead. Inhale, lean to one side, stretch opposite side. Gaze up, breathe.", benefits: "Stretches the rib cage, arms and torso. Tones the oblique muscles."},
        {name: "Side Splits", translation: "upaviṣṭha = seated, koṇa = angle, āsana = posture", description: "Sit, legs wide. Exhale, walk hands forward, lower torso. Keep spine long, gaze down, breathe.", benefits: "Stretches the insides and backs of the legs. Stimulates the abdominal organs. Strengthens the spine. Calms the brain. Releases groin."},
        {name: "Tree", translation: "vṛkṣa = tree, āsana = posture", description: "Stand, place right foot on left thigh or calf. Palms together overhead or at chest. Balance, gaze forward, breathe.", benefits: "Strengthens the legs, ankles, and feet. Improves flexibility in the hips and knees. Improves balance."},
        {name: "Triangle", translation: "trikoṇa = triangle, āsana = posture", description: "Stand wide, turn right foot out. Reach right hand down to shin or floor, left arm up. Open chest, gaze up, breathe.", benefits: "Stretches and strengthens the thighs, knees, and ankles. Stretches the hips, groin, hamstrings, calves, shoulders, chest, and spine. Stimulates the abdominal organs. Helps relieve stress. Improves digestion. Helps relieve the symptoms of menopause. Relieves backache, especially through second trimester of pregnancy. Therapeutic for anxiety, flat feet, infertility, neck pain, osteoporosis, and sciatica."},
        {name: "Upward-Facing Dog", translation: "ūrdhva = upward, mukha = facing, śvāna = dog, āsana = posture", description: "Lie on stomach, hands by shoulders. Inhale, lift chest and thighs, roll shoulders back. Gaze forward, breathe.", benefits: "Improves posture. Strengthens the spine, arms, and wrists. Stretches the chest, lungs, shoulders, and abdomen. Firms the buttocks. Stimulates abdominal organs. Helps relieve mild depression, fatigue, and sciatica. Therapeutic for asthma."},
        {name: "Warrior One", translation: "vīrabhadra = warrior, āsana = posture", description: "Step left foot back, bend right knee to 90 degrees. Lift arms overhead, sink hips. Gaze forward, breathe.", benefits: "Stretches the chest, lungs, shoulders, neck, belly and groin (psoas). Strengthens the shoulders, arms and back muscles. Strengthens and stretches the thighs, calves and ankles."},
        {name: "Warrior Two", translation: "vīrabhadra = warrior, āsana = posture", description: "Step left foot back, bend right knee to 90 degrees. Arms parallel, sink hips. Gaze over right hand, breathe.", benefits: "Strengthens and stretches the legs and ankles. Stretches the groin, chest, lungs, and shoulders. Stimulates abdominal organs. Increases stamina. Relieves backaches, especially through second trimester of pregnancy. Therapeutic for carpal tunnel syndrome, flat feet, infertility, osteoporosis, and sciatica."},
        {name: "Warrior Three", translation: "vīrabhadra = warrior, āsana = posture", description: "Stand, shift to right leg. Lift left leg back parallel, arms forward or sides. Balance, gaze down, breathe.", benefits: "Strengthens the ankles and legs. Strengthens the shoulders and muscles of the back. Tones the abdomen. Improves balance and posture."},
        {name: "Wheel", translation: "ūrdhva = upward, dhanu = bow, āsana = posture", description: "Lie on your back with knees bent and hands placed by your ears. Exhale, then lift your hips and chest to form an arch. Gaze upward and breathe steadily.", benefits: "Strengthens the arms, wrists, legs, buttocks, abs, and spine. Stimulates the thyroid and pituitary glands. Boosts energy, helps counteract depression, and offers therapeutic benefits for asthma, back pain, infertility, and osteoporosis."},
        {name: "Wild Thing", translation: "camatkāra = struck with wonder, āsana = posture", description: "Start in Downward Dog, then lift your right leg and open your hips. Place your right hand beside your front foot, lift your left arm, arch your back, gaze upward, and breathe deeply.", benefits: "Stretches the chest, shoulders, back, and throat. Strengthens and opens the hips, hip flexors, and thighs."}
      ]
      sessionText: [
        {name: "Gentle Beginner Flow", description: "A soothing sequence for beginners to ease into yoga with foundational poses and breath focus."},
        {name: "Morning Wake-Up", description: "A beginner-friendly sequence to energize and stretch the body for the day ahead."},
        {name: "Restful Basics", description: "A calming beginner sequence to relax and restore with gentle poses."},
        {name: "Balanced Foundations", description: "A beginner sequence to build balance and strength with standing and seated poses."},
        {name: "Core and Stretch", description: "A beginner sequence to strengthen the core and improve flexibility with simple poses."},
        {name: "Intermediate Core Strength", description: "A dynamic intermediate sequence to build core stability and strength."},
        {name: "Hip Opening Flow", description: "An intermediate sequence to deeply stretch and open the hips for greater flexibility."},
        {name: "Twist and Energize", description: "An intermediate twisting sequence to detoxify and boost energy levels."},
        {name: "Balance Challenge", description: "An intermediate sequence to enhance balance and coordination with standing poses."},
        {name: "Vigorous Flow", description: "A high-energy intermediate flow to build endurance and strength through dynamic transitions."},
        {name: "Heart Opening Sequence", description: "An intermediate sequence to open the chest and strengthen the back with backbends."},
        {name: "Core and Stability", description: "An intermediate sequence blending core work and balancing poses for overall stability."},
        {name: "Seated Flexibility", description: "An intermediate sequence of seated poses to deepen hip and hamstring flexibility."},
        {name: "Warrior Power", description: "An intermediate sequence focusing on warrior poses to build strength and confidence."},
        {name: "Energy and Balance", description: "An energizing intermediate sequence to boost vitality and improve balance."},
        {name: "Advanced Core Intensive", description: "An advanced sequence to intensely target core strength with challenging poses."},
        {name: "Inversion Exploration", description: "An advanced sequence to master inversions, building strength and control."},
        {name: "Flexibility Extreme", description: "An advanced sequence to push flexibility boundaries with deep stretches and splits."},
        {name: "Arm Balance Mastery", description: "An advanced sequence focusing on arm balances to strengthen the upper body."},
        {name: "Deep Backbends", description: "An advanced sequence to deepen backbends, opening the chest and spine."},
        {name: "Ultimate Flow", description: "A comprehensive advanced flow combining strength, balance, and flexibility."},
        {name: "Precision and Power", description: "An advanced sequence emphasizing precise alignment and powerful poses."},
        {name: "Hip and Heart Intensive", description: "An advanced sequence to deeply open hips and heart for flexibility and emotional release."},
        {name: "Strength and Control", description: "An advanced sequence to build strength and control with challenging poses."},
        {name: "Yoga Mastery", description: "An advanced sequence to challenge strength, balance, and flexibility for seasoned practitioners."},
        {name: "Beginner's Blissful Flow", description: "A comprehensive beginner sequence that flows harmoniously through warm-up, standing strength and balance poses, gentle backbends, forward folds, hip openers, and restorative poses to build a well-rounded foundation."}
      ]
    }
    id {
      title: "yoga"
      sessions: "sesi"; poses: "pose"
      levels: {beginner: "pemula", intermediate: "menengah", advanced: "mahir"}
      ranks: {novice: "Pemula", practitioner: "Praktisi", adept: "Terampil", devotee: "Penekun", teacher: "Guru", master: "Mahaguru"}
      paces: {swift: "cepat", balanced: "seimbang", endurance: "ketahanan"}
      levelRank: (n, rank) => "level ${n} · ${rank}"
      streak: n => n == 1 ? "1 hari beruntun" : "${n} hari beruntun"
      xpLine: (xp, need, next) => "${xp} xp · ${need} lagi ke level ${next}"
      completed: "selesai"
      sessionLine: (level, n, time) => "${level} · ${n} pose · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · tahan ${time} · dua sisi" : "${level} · tahan ${time}"
      how: "cara"; benefits: "manfaat"; inSessions: "di sesi"
      startArrow: "mulai ›"
      getReady: "bersiap"
      first: name => "pertama: ${name}"
      introLine: (n, time) => "${n} pose · ${time} dengan tempo ini"
      startNow: "mulai sekarang"
      poseOf: (i, n) => "pose ${i} dari ${n}"
      voiceOn: "suara aktif"; voiceOff: "suara nonaktif"
      nextPose: "pose berikutnya"; paused: "dijeda"; readyNext: "bersiap untuk pose berikutnya…"
      firstSide: "sisi pertama"; secondSide: "sisi kedua"; lastPose: "pose terakhir"
      quitAsk: "keluar dari sesi ini?"; keepGoing: "lanjutkan"; quit: "keluar"
      resume: "lanjutkan"; pause: "jeda"; skip: "lewati"
      greatJob: "kerja bagus"
      levelUp: (n, rank) => "level ${n}: ${rank}"
      xpHint: "xp didapat dari sesi pertama tiap hari"
      done: "selesai"; again: "ulangi"
      poseText: [
        {name: "Perahu", translation: "nāva = perahu, āsana = sikap", description: "Duduk dengan kaki lurus. Embuskan napas, angkat kaki hingga 45 derajat, condongkan badan sedikit ke belakang. Luruskan lengan ke depan, telapak tangan saling berhadapan. Seimbangkan di tulang duduk, kencangkan perut. Pandang jari kaki, bernapas.", benefits: "Menguatkan perut, otot fleksor pinggul, dan tulang belakang. Merangsang ginjal, kelenjar tiroid dan prostat, serta usus. Membantu meredakan stres. Melancarkan pencernaan."},
        {name: "Setengah Perahu", translation: "ardha = setengah, nāva = perahu, āsana = sikap", description: "Duduk, lutut ditekuk, kaki terangkat. Condongkan badan sedikit ke belakang, pegang bagian belakang paha atau luruskan lengan. Jaga keseimbangan, kencangkan perut, pandang ke depan, bernapas.", benefits: "Menguatkan perut, otot fleksor pinggul, dan tulang belakang. Merangsang ginjal, tiroid, kelenjar prostat, dan usus. Membantu meredakan stres. Melancarkan pencernaan."},
        {name: "Busur", translation: "dhanur = busur, āsana = sikap", description: "Berbaring tengkurap. Tekuk lutut, pegang pergelangan kaki. Tarik napas, angkat dada dan paha, tekan kaki ke tangan. Pandang ke depan, bernapas.", benefits: "Meregangkan seluruh bagian depan tubuh: pergelangan kaki, paha dan selangkangan, perut dan dada, tenggorokan, serta fleksor pinggul dalam (psoas). Menguatkan otot punggung. Memperbaiki postur. Merangsang organ perut dan leher."},
        {name: "Jembatan", translation: "setu = jembatan, bandha = kunci, sarva = semua, āṅga = anggota tubuh, āsana = sikap", description: "Berbaring telentang, lutut ditekuk, kaki selebar pinggul. Tarik napas, angkat pinggul, kaitkan tangan di bawah punggung. Gulirkan bahu ke bawah, angkat dada. Pandang ke atas, bernapas.", benefits: "Meregangkan dada, leher, dan tulang belakang. Merangsang organ perut, paru-paru, dan tiroid. Menyegarkan kaki yang lelah. Melancarkan pencernaan. Membantu meredakan gejala menopause. Meredakan nyeri haid bila dilakukan dengan penyangga. Mengurangi kecemasan, kelelahan, sakit punggung, sakit kepala, dan insomnia. Bermanfaat untuk asma, tekanan darah tinggi, osteoporosis, dan sinusitis."},
        {name: "Kupu-Kupu", translation: "baddha = terikat, koṇa = sudut, āsana = sikap", description: "Duduk dengan telapak kaki saling menempel, lutut ke samping. Pegang kaki, duduk tegak. Rilekskan bahu, bernapas dalam.", benefits: "Membuka pinggul dan selangkangan. Meregangkan bahu, rongga dada, dan punggung. Merangsang organ perut, paru-paru, dan jantung."},
        {name: "Unta", translation: "uṣṭra = unta, āsana = sikap", description: "Berlutut, tangan di punggung bawah. Tarik napas, angkat dada, raih tumit jika nyaman. Jaga leher tetap netral, pandang ke depan, bernapas.", benefits: "Meregangkan seluruh bagian depan tubuh: pergelangan kaki, paha dan selangkangan, perut dan dada, serta tenggorokan. Meregangkan fleksor pinggul dalam (psoas). Menguatkan otot punggung. Memperbaiki postur. Merangsang organ perut dan leher."},
        {name: "Kucing", translation: "marjarya = kucing, āsana = sikap", description: "Bertumpu pada tangan dan lutut. Embuskan napas, lengkungkan punggung ke atas, tarik dagu ke dada. Kencangkan perut, pandang ke perut, bernapas.", benefits: "Melegakan tulang belakang dan leher. Menyegarkan tubuh."},
        {name: "Sapi", translation: "bitil = sapi, āsana = sikap", description: "Bertumpu pada tangan dan lutut. Tarik napas, lengkungkan punggung ke bawah, angkat tulang ekor dan dada. Pandang ke atas, bernapas.", benefits: "Menghilangkan lelah. Melancarkan pernapasan dan aliran darah ke otak. Menyegarkan seluruh tubuh."},
        {name: "Kursi", translation: "utkaṭa = garang, āsana = sikap", description: "Berdiri, kaki rapat. Tarik napas, tekuk lutut seperti hendak duduk, angkat lengan ke atas kepala. Bebankan berat di tumit, pandang ke depan, bernapas.", benefits: "Menguatkan pergelangan kaki, paha, betis, dan tulang belakang. Meregangkan bahu dan dada. Merangsang organ perut, diafragma, dan jantung. Membantu kaki datar. Menyegarkan seluruh tubuh."},
        {name: "Pose Anak", translation: "bala = anak, āsana = sikap", description: "Berlutut, jempol kaki bersentuhan, lutut dibuka. Embuskan napas, bungkukkan badan ke depan, lengan lurus. Dahi di matras, rileks, bernapas.", benefits: "Meregangkan pinggul, paha, dan pergelangan kaki dengan lembut. Menenangkan pikiran dan membantu meredakan stres dan lelah. Meredakan nyeri punggung dan leher bila kepala dan badan disangga."},
        {name: "Mayat", translation: "śava = mayat, āsana = sikap", description: "Berbaring telentang, kaki lurus, lengan di samping badan, telapak tangan menghadap ke atas. Pejamkan mata, rileks sepenuhnya, bernapas dalam.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Merilekskan tubuh. Mengurangi sakit kepala, kelelahan, dan insomnia. Membantu menurunkan tekanan darah."},
        {name: "Lunge Bulan Sabit", translation: "ashta = sisi, chandra = bulan, āsana = sikap", description: "Langkahkan satu kaki ke depan, lunge. Lutut belakang turun atau terangkat. Tarik napas, angkat lengan ke atas kepala. Turunkan pinggul, pandang ke depan, bernapas.", benefits: "Meregangkan rongga dada, lengan, dan badan. Mengencangkan otot perut samping."},
        {name: "Gagak", translation: "baka = bangau, āsana = sikap", description: "Jongkok, tangan di matras selebar bahu. Lutut di lengan atas. Embuskan napas, condongkan badan ke depan, angkat kaki. Jaga keseimbangan, pandang ke depan, bernapas.", benefits: "Menguatkan lengan dan pergelangan tangan. Meregangkan punggung atas. Menguatkan otot perut. Membuka selangkangan. Mengencangkan organ perut."},
        {name: "Lumba-Lumba", translation: "pīñcha = bulu, mayūra = merak, āsana = sikap", description: "Dari Anjing Menghadap ke Bawah, turunkan badan ke lengan bawah, siku di bawah bahu. Angkat pinggul, tekan tumit ke bawah. Kencangkan perut, pandang di antara tangan, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Menyegarkan tubuh. Meregangkan bahu, paha belakang, betis, lengkung kaki, dan tangan. Menguatkan lengan dan kaki. Membantu meredakan gejala menopause. Meredakan nyeri haid bila kepala disangga. Membantu mencegah osteoporosis. Melancarkan pencernaan. Meredakan sakit kepala, insomnia, sakit punggung, dan kelelahan. Bermanfaat untuk tekanan darah tinggi, asma, kaki datar, siatika, dan sinusitis. Menghangatkan pergelangan kaki dan jari kaki."},
        {name: "Anjing Menghadap ke Bawah", translation: "parivṛtta = berputar, adho = ke bawah, mukha = menghadap, śvāna = anjing, āsana = sikap", description: "Bertumpu pada tangan dan lutut. Embuskan napas, angkat pinggul ke atas dan ke belakang. Luruskan kaki, tekan tumit ke bawah. Panjangkan tulang belakang, pandang di antara kaki, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Menyegarkan tubuh. Meregangkan bahu, leher, paha belakang, betis, lengkung kaki, dan tangan. Menguatkan lengan dan kaki. Membantu meredakan gejala menopause. Meredakan nyeri haid bila kepala disangga. Membantu mencegah osteoporosis. Melancarkan pencernaan. Meredakan sakit kepala, insomnia, sakit punggung, dan kelelahan. Bermanfaat untuk tekanan darah tinggi, asma, kaki datar, siatika, dan sinusitis."},
        {name: "Elang", translation: "garuḍa = elang, āsana = sikap", description: "Berdiri, silangkan kaki kanan di atas kaki kiri, kaitkan kaki di belakang betis. Silangkan lengan kiri di atas lengan kanan, rapatkan telapak tangan. Angkat siku, pandang ke depan, bernapas.", benefits: "Menguatkan dan meregangkan pergelangan kaki dan betis. Meregangkan paha, pinggul, bahu, dan punggung atas. Meningkatkan konsentrasi. Melatih keseimbangan."},
        {name: "Tangan ke Jempol Kaki", translation: "utthita = terentang, hasta = tangan, pādāṅguṣṭha = jempol kaki, āsana = sikap", description: "Berdiri, angkat kaki kanan, pegang jempol kaki dengan tangan kanan. Luruskan kaki ke depan, pinggul sejajar. Pandang ke depan, bernapas.", benefits: "Membuka pinggul dan selangkangan. Meregangkan paha belakang, IT band, dan kaki. Melatih keseimbangan."},
        {name: "Sudut Samping Terentang", translation: "utthita = terentang, pārśva = samping, koṇa = sudut, āsana = sikap", description: "Dari Prajurit Dua, tekuk lutut depan lebih dalam. Rentangkan lengan depan ke atas kepala, tangan belakang di kaki atau lantai. Buka dada, pandang ke atas, bernapas.", benefits: "Menguatkan dan meregangkan kaki, lutut, dan pergelangan kaki. Meregangkan selangkangan, tulang belakang, pinggang, dada, paru-paru, dan bahu. Merangsang organ perut. Meningkatkan stamina."},
        {name: "Berdiri dengan Lengan Bawah", translation: "pīñcha = bulu, mayūra = merak, āsana = sikap", description: "Dari Lumba-Lumba, dekatkan kaki. Embuskan napas, angkat kaki satu per satu, seimbangkan di lengan bawah. Kencangkan perut, pandang ke depan, bernapas.", benefits: "Menguatkan lengan dan bahu. Meningkatkan fokus dan keseimbangan. Meregangkan punggung atas dan bawah. Menguatkan otot perut. Mengencangkan area perut."},
        {name: "Membungkuk ke Depan dengan Buka Bahu", translation: "uttāna = meregang, āsana = sikap", description: "Berdiri, bungkukkan badan ke depan, kaitkan tangan di belakang punggung. Angkat lengan perlahan, rilekskan kepala. Pandang ke bawah, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Merangsang hati dan ginjal. Meregangkan paha belakang, betis, dan pinggul. Menguatkan paha dan lutut. Melancarkan pencernaan. Membantu meredakan gejala menopause. Mengurangi kelelahan dan kecemasan. Meredakan sakit kepala dan insomnia. Membuka bahu."},
        {name: "Setengah Bulan", translation: "ardha = setengah, chandra = bulan, āsana = sikap", description: "Dari Prajurit Tiga, letakkan tangan di lantai di samping kaki depan. Angkat kaki belakang sejajar lantai, rentangkan lengan seberangnya ke atas. Buka pinggul, pandang ke atas atau ke bawah, bernapas.", benefits: "Menguatkan perut, pergelangan kaki, paha, bokong, dan tulang belakang. Meregangkan selangkangan, paha belakang, betis, bahu, dada, dan tulang belakang. Meningkatkan koordinasi dan keseimbangan. Membantu meredakan stres. Melancarkan pencernaan."},
        {name: "Berdiri dengan Tangan", translation: "adho = ke bawah, mukha = menghadap, vṛkṣa = pohon, āsana = sikap", description: "Dari Anjing Menghadap ke Bawah, dekatkan kaki. Pindahkan berat badan, ayunkan kaki ke atas, luruskan. Kencangkan perut, pandang ke depan, bernapas.", benefits: "Menguatkan bahu, lengan, dan pergelangan tangan. Meregangkan perut. Melatih keseimbangan. Menenangkan pikiran dan membantu meredakan stres dan depresi ringan."},
        {name: "Lunge Rendah", translation: "aṅjaneya = pujian, āsana = sikap", description: "Langkahkan kaki kanan ke depan, lunge. Turunkan lutut kiri, tangan di paha atau di atas kepala. Turunkan pinggul, pandang ke depan, bernapas.", benefits: "Meregangkan dada, paru-paru, leher, perut, dan selangkangan (psoas). Menguatkan bahu, lengan, dan otot punggung. Menguatkan dan meregangkan paha, betis, dan pergelangan kaki."},
        {name: "Merpati", translation: "supta = telentang, kapota = merpati, āsana = sikap", description: "Berbaring telentang, silangkan pergelangan kaki kanan di atas lutut kiri. Tarik lutut kiri ke dada. Jaga punggung tetap menempel, pandang ke atas, bernapas.", benefits: "Meregangkan paha belakang dan paha depan. Jika siku dipakai untuk mendorong paha, pinggul juga ikut terbuka."},
        {name: "Raja Merpati", translation: "eka = satu, pāda = kaki atau tungkai, rāja = raja, kapota = merpati, āsana = sikap", description: "Dari Merpati, tekuk lutut belakang, pegang kaki dengan tangan. Angkat dada, buka hati. Pandang ke depan, bernapas.", benefits: "Meregangkan paha, selangkangan (psoas), perut, dada, bahu, dan leher. Merangsang organ perut. Membuka bahu dan dada."},
        {name: "Plank", translation: "phalaka = papan, āsana = sikap", description: "Bertumpu pada tangan dan lutut, langkahkan kaki ke belakang. Badan lurus, tangan di bawah bahu. Kencangkan perut, pandang ke bawah, bernapas.", benefits: "Menguatkan lengan, pergelangan tangan, dan tulang belakang. Mengencangkan perut."},
        {name: "Bajak", translation: "hala = bajak, āsana = sikap", description: "Berbaring telentang. Embuskan napas, angkat kaki melewati kepala, jari kaki ke lantai di belakang. Sangga punggung atau kaitkan tangan. Pandang ke dalam, bernapas.", benefits: "Menenangkan pikiran. Merangsang organ perut dan kelenjar tiroid. Meregangkan bahu dan tulang belakang. Membantu meredakan gejala menopause. Mengurangi stres dan kelelahan. Bermanfaat untuk sakit punggung, sakit kepala, kemandulan, insomnia, dan sinusitis."},
        {name: "Piramida", translation: "pārśva = samping, uttāna = meregang, āsana = sikap", description: "Langkahkan kaki kanan ke depan, kaki kiri ke belakang. Tekuk di pinggul, bungkukkan badan di atas kaki depan. Tangan di lantai atau balok. Pandang ke bawah, bernapas.", benefits: "Menenangkan pikiran. Meregangkan tulang belakang, bahu, pinggul, dan paha belakang. Menguatkan kaki. Merangsang organ perut. Memperbaiki postur dan keseimbangan. Melancarkan pencernaan."},
        {name: "Prajurit Terbalik", translation: "pārśva = samping, vīrabhadra = prajurit, āsana = sikap", description: "Dari Prajurit Dua, rentangkan lengan depan ke atas kepala dan ke belakang. Turunkan tangan belakang menyusuri kaki. Buka dada, pandang ke atas, bernapas.", benefits: "Menguatkan dan meregangkan kaki, lutut, dan pergelangan kaki. Meregangkan selangkangan, tulang belakang, pinggang, dada, paru-paru, dan bahu. Merangsang organ perut. Meningkatkan stamina. Meredakan sakit punggung, terutama di trimester kedua kehamilan. Bermanfaat untuk sindrom terowongan karpal, kaki datar, kemandulan, osteoporosis, dan siatika."},
        {name: "Duduk Membungkuk ke Depan", translation: "paśchima = belakang, uttāna = meregang, āsana = sikap", description: "Duduk, kaki lurus. Tarik napas, panjangkan tulang belakang. Embuskan napas, bungkukkan badan ke depan, raih kaki atau tulang kering. Jaga tulang belakang tetap panjang, pandang ke depan, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Meregangkan tulang belakang, bahu, dan paha belakang. Merangsang hati, ginjal, ovarium, dan rahim. Melancarkan pencernaan. Membantu meredakan gejala menopause dan nyeri haid. Meredakan sakit kepala dan kecemasan. Mengurangi kelelahan. Bermanfaat untuk tekanan darah tinggi, kemandulan, insomnia, dan sinusitis. Menurut teks tradisional, Paschimottanasana menambah nafsu makan, mengurangi obesitas, dan menyembuhkan penyakit."},
        {name: "Teratai", translation: "padma = teratai, āsana = sikap", description: "Duduk, letakkan kaki kanan di paha kiri, kaki kiri di paha kanan. Tangan di lutut, duduk tegak, bernapas.", benefits: "Membuka pinggul dan selangkangan serta meregangkan lutut, pergelangan kaki, dan paha. Menguatkan punggung dan menenangkan pikiran, mengurangi stres dan kecemasan. Melancarkan sirkulasi dan aliran darah di panggul."},
        {name: "Setengah Raja Ikan", translation: "ardha = setengah, matsya = ikan, indra = raja", description: "Duduk, silangkan lutut kanan di atas lutut kiri, putar badan ke kanan. Siku kiri di luar lutut kanan, tangan kanan di belakang. Pandang melewati bahu, bernapas.", benefits: "Meregangkan bahu, dada, paha, selangkangan, dan perut. Menguatkan kaki dan pergelangan kaki. Melatih keseimbangan."},
        {name: "Sikap Lilin", translation: "sa = dengan, ālamba = sokongan, sarvāṅga = seluruh tubuh, āsana = sikap", description: "Berbaring telentang. Embuskan napas, angkat kaki dan pinggul, sangga punggung dengan tangan. Luruskan kaki, pandang ke dalam, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Merangsang kelenjar tiroid dan prostat serta organ perut. Meregangkan bahu dan leher. Mengencangkan kaki dan bokong. Melancarkan pencernaan. Membantu meredakan gejala menopause. Mengurangi kelelahan dan meredakan insomnia. Bermanfaat untuk asma, kemandulan, dan sinusitis."},
        {name: "Plank Samping", translation: "vasiṣṭha = nama seorang resi, āsana = sikap", description: "Dari Plank, gulingkan badan ke sisi luar kaki kanan. Tumpuk kaki, angkat lengan kiri ke atas. Kencangkan perut, pandang ke atas, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Meregangkan bahu, paha belakang, betis, dan lengkung kaki. Menguatkan lengan dan kaki. Membantu meredakan gejala menopause. Membantu mencegah osteoporosis. Melancarkan pencernaan. Meredakan sakit kepala, insomnia, sakit punggung, dan kelelahan. Bermanfaat untuk tekanan darah tinggi, asma, kaki datar, dan siatika."},
        {name: "Sfinks", translation: "sālamba = disokong, bhujaṅga = ular, āsana = sikap", description: "Berbaring tengkurap, lengan bawah di matras, siku di bawah bahu. Tarik napas, angkat dada, tekan bahu ke bawah. Pandang ke depan, bernapas.", benefits: "Menguatkan tulang belakang. Meregangkan dada, paru-paru, bahu, dan perut. Merangsang organ perut. Membuka hati dan paru-paru."},
        {name: "Split", translation: "hanumān = dewa kera, āsana = sikap", description: "Dari Lunge Rendah, geser kaki depan ke depan, kaki belakang ke belakang. Turunkan pinggul, jaga tetap sejajar. Tangan di lantai atau balok. Pandang ke depan, bernapas.", benefits: "Meregangkan paha, paha belakang, dan selangkangan. Merangsang organ perut."},
        {name: "Pose Karangan Bunga", translation: "mālā = karangan bunga atau kalung, āsana = sikap", description: "Jongkok, kaki rapat atau terbuka. Siku di sisi dalam lutut, telapak tangan di depan dada. Dorong lutut ke luar, turunkan pinggul, pandang ke depan, bernapas.", benefits: "Meregangkan pergelangan kaki, selangkangan, dan punggung. Mengencangkan perut."},
        {name: "Berdiri Membungkuk ke Depan", translation: "uttāna = meregang, āsana = sikap", description: "Berdiri, bungkukkan badan ke depan, tangan ke lantai atau tulang kering. Jaga tulang belakang tetap panjang, biarkan kepala menggantung. Pandang ke bawah, bernapas.", benefits: "Menenangkan pikiran dan membantu meredakan stres dan depresi ringan. Merangsang hati dan ginjal. Meregangkan paha belakang, betis, dan pinggul. Menguatkan paha dan lutut. Melancarkan pencernaan. Membantu meredakan gejala menopause. Mengurangi kelelahan dan kecemasan. Meredakan sakit kepala dan insomnia."},
        {name: "Bulan Sabit", translation: "ashta = sisi, chandra = bulan, āsana = sikap", description: "Berdiri, kaitkan tangan di atas kepala. Tarik napas, condongkan badan ke satu sisi, regangkan sisi seberangnya. Pandang ke atas, bernapas.", benefits: "Meregangkan rongga dada, lengan, dan badan. Mengencangkan otot perut samping."},
        {name: "Split Samping", translation: "upaviṣṭha = duduk, koṇa = sudut, āsana = sikap", description: "Duduk, kaki dibuka lebar. Embuskan napas, jalankan tangan ke depan, turunkan badan. Jaga tulang belakang tetap panjang, pandang ke bawah, bernapas.", benefits: "Meregangkan bagian dalam dan belakang kaki. Merangsang organ perut. Menguatkan tulang belakang. Menenangkan pikiran. Melemaskan selangkangan."},
        {name: "Pohon", translation: "vṛkṣa = pohon, āsana = sikap", description: "Berdiri, letakkan kaki kanan di paha atau betis kiri. Rapatkan telapak tangan di atas kepala atau di depan dada. Jaga keseimbangan, pandang ke depan, bernapas.", benefits: "Menguatkan kaki, pergelangan kaki, dan telapak kaki. Melenturkan pinggul dan lutut. Melatih keseimbangan."},
        {name: "Segitiga", translation: "trikoṇa = segitiga, āsana = sikap", description: "Berdiri dengan kaki terbuka lebar, putar kaki kanan ke luar. Turunkan tangan kanan ke tulang kering atau lantai, lengan kiri ke atas. Buka dada, pandang ke atas, bernapas.", benefits: "Meregangkan dan menguatkan paha, lutut, dan pergelangan kaki. Meregangkan pinggul, selangkangan, paha belakang, betis, bahu, dada, dan tulang belakang. Merangsang organ perut. Membantu meredakan stres. Melancarkan pencernaan. Membantu meredakan gejala menopause. Meredakan sakit punggung, terutama di trimester kedua kehamilan. Bermanfaat untuk kecemasan, kaki datar, kemandulan, nyeri leher, osteoporosis, dan siatika."},
        {name: "Anjing Menghadap ke Atas", translation: "ūrdhva = ke atas, mukha = menghadap, śvāna = anjing, āsana = sikap", description: "Berbaring tengkurap, tangan di samping bahu. Tarik napas, angkat dada dan paha, gulirkan bahu ke belakang. Pandang ke depan, bernapas.", benefits: "Memperbaiki postur. Menguatkan tulang belakang, lengan, dan pergelangan tangan. Meregangkan dada, paru-paru, bahu, dan perut. Mengencangkan bokong. Merangsang organ perut. Membantu meredakan depresi ringan, kelelahan, dan siatika. Bermanfaat untuk asma."},
        {name: "Prajurit Satu", translation: "vīrabhadra = prajurit, āsana = sikap", description: "Langkahkan kaki kiri ke belakang, tekuk lutut kanan hingga 90 derajat. Angkat lengan ke atas kepala, turunkan pinggul. Pandang ke depan, bernapas.", benefits: "Meregangkan dada, paru-paru, bahu, leher, perut, dan selangkangan (psoas). Menguatkan bahu, lengan, dan otot punggung. Menguatkan dan meregangkan paha, betis, dan pergelangan kaki."},
        {name: "Prajurit Dua", translation: "vīrabhadra = prajurit, āsana = sikap", description: "Langkahkan kaki kiri ke belakang, tekuk lutut kanan hingga 90 derajat. Lengan lurus sejajar lantai, turunkan pinggul. Pandang melewati tangan kanan, bernapas.", benefits: "Menguatkan dan meregangkan kaki dan pergelangan kaki. Meregangkan selangkangan, dada, paru-paru, dan bahu. Merangsang organ perut. Meningkatkan stamina. Meredakan sakit punggung, terutama di trimester kedua kehamilan. Bermanfaat untuk sindrom terowongan karpal, kaki datar, kemandulan, osteoporosis, dan siatika."},
        {name: "Prajurit Tiga", translation: "vīrabhadra = prajurit, āsana = sikap", description: "Berdiri, pindahkan berat ke kaki kanan. Angkat kaki kiri ke belakang sejajar lantai, lengan ke depan atau ke samping. Jaga keseimbangan, pandang ke bawah, bernapas.", benefits: "Menguatkan pergelangan kaki dan kaki. Menguatkan bahu dan otot punggung. Mengencangkan perut. Melatih keseimbangan dan postur."},
        {name: "Kayang", translation: "ūrdhva = ke atas, dhanu = busur, āsana = sikap", description: "Berbaring telentang dengan lutut ditekuk dan tangan di samping telinga. Embuskan napas, lalu angkat pinggul dan dada hingga membentuk lengkungan. Pandang ke atas dan bernapas dengan tenang.", benefits: "Menguatkan lengan, pergelangan tangan, kaki, bokong, perut, dan tulang belakang. Merangsang kelenjar tiroid dan hipofisis. Menambah energi, membantu melawan depresi, dan bermanfaat untuk asma, sakit punggung, kemandulan, dan osteoporosis."},
        {name: "Wild Thing", translation: "camatkāra = terpukau takjub, āsana = sikap", description: "Mulai dari Anjing Menghadap ke Bawah, lalu angkat kaki kanan dan buka pinggul. Letakkan tangan kanan di samping kaki depan, angkat lengan kiri, lengkungkan punggung, pandang ke atas, dan bernapas dalam.", benefits: "Meregangkan dada, bahu, punggung, dan tenggorokan. Menguatkan dan membuka pinggul, fleksor pinggul, dan paha."}
      ]
      sessionText: [
        {name: "Flow Lembut untuk Pemula", description: "Rangkaian menenangkan bagi pemula untuk mulai beryoga dengan pose dasar dan fokus pada napas."},
        {name: "Bangun Pagi", description: "Rangkaian ramah pemula untuk menyegarkan dan meregangkan tubuh menyambut hari."},
        {name: "Dasar yang Menenangkan", description: "Rangkaian pemula yang menenangkan untuk rileks dan memulihkan diri dengan pose-pose lembut."},
        {name: "Fondasi Seimbang", description: "Rangkaian pemula untuk membangun keseimbangan dan kekuatan dengan pose berdiri dan duduk."},
        {name: "Inti dan Peregangan", description: "Rangkaian pemula untuk menguatkan otot inti dan melenturkan tubuh dengan pose sederhana."},
        {name: "Kekuatan Inti Menengah", description: "Rangkaian menengah yang dinamis untuk membangun stabilitas dan kekuatan otot inti."},
        {name: "Flow Buka Pinggul", description: "Rangkaian menengah untuk meregangkan dan membuka pinggul secara dalam agar lebih lentur."},
        {name: "Putar dan Bersemangat", description: "Rangkaian putaran tingkat menengah untuk detoks dan menambah energi."},
        {name: "Tantangan Keseimbangan", description: "Rangkaian menengah untuk melatih keseimbangan dan koordinasi dengan pose berdiri."},
        {name: "Flow Penuh Tenaga", description: "Flow menengah berenergi tinggi untuk membangun daya tahan dan kekuatan lewat transisi yang dinamis."},
        {name: "Rangkaian Buka Hati", description: "Rangkaian menengah untuk membuka dada dan menguatkan punggung dengan pose melengkung ke belakang."},
        {name: "Inti dan Stabilitas", description: "Rangkaian menengah yang memadukan latihan inti dan pose keseimbangan untuk stabilitas menyeluruh."},
        {name: "Kelenturan Sambil Duduk", description: "Rangkaian menengah berisi pose duduk untuk memperdalam kelenturan pinggul dan paha belakang."},
        {name: "Kekuatan Prajurit", description: "Rangkaian menengah yang berfokus pada pose prajurit untuk membangun kekuatan dan rasa percaya diri."},
        {name: "Energi dan Keseimbangan", description: "Rangkaian menengah yang menyegarkan untuk menambah vitalitas dan melatih keseimbangan."},
        {name: "Inti Intensif Lanjutan", description: "Rangkaian mahir untuk melatih kekuatan inti secara intens dengan pose-pose menantang."},
        {name: "Jelajah Inversi", description: "Rangkaian mahir untuk menguasai inversi, membangun kekuatan dan kendali."},
        {name: "Kelenturan Ekstrem", description: "Rangkaian mahir untuk mendorong batas kelenturan dengan peregangan dalam dan split."},
        {name: "Mahir Keseimbangan Lengan", description: "Rangkaian mahir yang berfokus pada keseimbangan lengan untuk menguatkan tubuh bagian atas."},
        {name: "Lengkung Belakang Dalam", description: "Rangkaian mahir untuk memperdalam lengkungan ke belakang, membuka dada dan tulang belakang."},
        {name: "Flow Pamungkas", description: "Flow mahir yang lengkap, memadukan kekuatan, keseimbangan, dan kelenturan."},
        {name: "Presisi dan Tenaga", description: "Rangkaian mahir yang menekankan keselarasan yang presisi dan pose-pose bertenaga."},
        {name: "Pinggul dan Hati Intensif", description: "Rangkaian mahir untuk membuka pinggul dan hati secara dalam demi kelenturan dan pelepasan emosi."},
        {name: "Kekuatan dan Kendali", description: "Rangkaian mahir untuk membangun kekuatan dan kendali dengan pose-pose menantang."},
        {name: "Menguasai Yoga", description: "Rangkaian mahir yang menantang kekuatan, keseimbangan, dan kelenturan bagi praktisi berpengalaman."},
        {name: "Flow Bahagia untuk Pemula", description: "Rangkaian pemula yang lengkap dan mengalir harmonis: pemanasan, pose kekuatan dan keseimbangan berdiri, lengkung belakang ringan, membungkuk ke depan, buka pinggul, dan pose pemulihan untuk membangun dasar yang menyeluruh."}
      ]
    }
    es {
      title: "yoga"
      sessions: "sesiones"; poses: "posturas"
      levels: {beginner: "principiante", intermediate: "intermedio", advanced: "avanzado"}
      ranks: {novice: "Novato", practitioner: "Practicante", adept: "Adepto", devotee: "Devoto", teacher: "Instructor", master: "Maestro"}
      paces: {swift: "ágil", balanced: "equilibrado", endurance: "resistencia"}
      levelRank: (n, rank) => "nivel ${n} · ${rank}"
      streak: n => n == 1 ? "racha de 1 día" : "racha de ${n} días"
      xpLine: (xp, need, next) => "${xp} xp · ${need} para nivel ${next}"
      completed: "hecho"
      sessionLine: (level, n, time) => n == 1 ? "${level} · 1 postura · ${time}" : "${level} · ${n} posturas · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · mantén ${time} · ambos lados" : "${level} · mantén ${time}"
      how: "cómo"; benefits: "beneficios"; inSessions: "en sesiones"
      startArrow: "empezar ›"
      getReady: "prepárate"
      first: name => "primera: ${name}"
      introLine: (n, time) => n == 1 ? "1 postura · ${time} a este ritmo" : "${n} posturas · ${time} a este ritmo"
      startNow: "empezar ya"
      poseOf: (i, n) => "postura ${i} de ${n}"
      voiceOn: "voz activada"; voiceOff: "voz desactivada"
      nextPose: "siguiente postura"; paused: "en pausa"; readyNext: "prepárate para la siguiente postura…"
      firstSide: "primer lado"; secondSide: "segundo lado"; lastPose: "última postura"
      quitAsk: "¿salir de esta sesión?"; keepGoing: "seguir"; quit: "salir"
      resume: "reanudar"; pause: "pausa"; skip: "omitir"
      greatJob: "¡buen trabajo!"
      levelUp: (n, rank) => "nivel ${n}: ${rank}"
      xpHint: "ganas xp con la primera sesión del día"
      done: "listo"; again: "otra vez"
      poseText: [
        {name: "Barco", translation: "nāva = barco, āsana = postura", description: "Siéntate con las piernas extendidas. Exhala, eleva las piernas a 45 grados y reclínate un poco hacia atrás. Extiende los brazos al frente, palmas enfrentadas. Equilíbrate sobre los isquiones, activa el abdomen. Mira hacia los dedos de los pies, respira.", benefits: "Fortalece el abdomen, los flexores de la cadera y la columna. Estimula los riñones, la tiroides, la próstata y los intestinos. Ayuda a aliviar el estrés. Mejora la digestión."},
        {name: "Medio barco", translation: "ardha = medio, nāva = barco, āsana = postura", description: "Siéntate, rodillas flexionadas, pies elevados. Reclínate un poco, sujeta la parte trasera de los muslos o extiende los brazos. Equilíbrate, activa el abdomen, mira al frente, respira.", benefits: "Fortalece el abdomen, los flexores de la cadera y la columna. Estimula los riñones, la tiroides, la próstata y los intestinos. Ayuda a aliviar el estrés. Mejora la digestión."},
        {name: "Arco", translation: "dhanur = arco, āsana = postura", description: "Túmbate boca abajo. Flexiona las rodillas, sujeta los tobillos. Inhala, eleva el pecho y los muslos, presiona los pies contra las manos. Mira al frente, respira.", benefits: "Estira toda la parte delantera del cuerpo: tobillos, muslos e ingles, abdomen y pecho, garganta y los flexores profundos de la cadera (psoas). Fortalece los músculos de la espalda. Mejora la postura. Estimula los órganos del abdomen y el cuello."},
        {name: "Puente", translation: "setu = puente, bandha = cierre, sarva = todo, āṅga = miembro, āsana = postura", description: "Túmbate boca arriba, rodillas flexionadas, pies al ancho de la cadera. Inhala, eleva la cadera, entrelaza las manos bajo la espalda. Lleva los hombros hacia dentro, eleva el pecho. Mira hacia arriba, respira.", benefits: "Estira el pecho, el cuello y la columna. Estimula los órganos abdominales, los pulmones y la tiroides. Revitaliza las piernas cansadas. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia. Alivia las molestias menstruales si se hace con apoyo. Reduce la ansiedad, la fatiga, el dolor de espalda, el dolor de cabeza y el insomnio. Terapéutica para el asma, la hipertensión, la osteoporosis y la sinusitis."},
        {name: "Mariposa", translation: "baddha = atado, koṇa = ángulo, āsana = postura", description: "Siéntate con las plantas de los pies juntas, rodillas hacia fuera. Sujeta los pies, siéntate erguido. Relaja los hombros, respira hondo.", benefits: "Abre la cadera y las ingles. Estira los hombros, la caja torácica y la espalda. Estimula los órganos abdominales, los pulmones y el corazón."},
        {name: "Camello", translation: "uṣṭra = camello, āsana = postura", description: "Arrodíllate, manos en la zona lumbar. Inhala, eleva el pecho, busca los talones si te resulta cómodo. Mantén el cuello neutro, mira al frente, respira.", benefits: "Estira toda la parte delantera del cuerpo: tobillos, muslos e ingles, abdomen y pecho, y garganta. Estira los flexores profundos de la cadera (psoas). Fortalece los músculos de la espalda. Mejora la postura. Estimula los órganos del abdomen y el cuello."},
        {name: "Gato", translation: "marjarya = gato, āsana = postura", description: "Apóyate en manos y rodillas. Exhala, redondea la columna hacia arriba, mete la barbilla. Activa el abdomen, mira hacia el vientre, respira.", benefits: "Alivia la columna y el cuello. Da energía al cuerpo."},
        {name: "Vaca", translation: "bitil = vaca, āsana = postura", description: "Apóyate en manos y rodillas. Inhala, arquea la columna hacia abajo, eleva el coxis y el pecho. Mira hacia arriba, respira.", benefits: "Elimina la fatiga. Mejora la respiración y la circulación de la sangre al cerebro. Revitaliza todo el cuerpo."},
        {name: "Silla", translation: "utkaṭa = feroz, āsana = postura", description: "De pie, pies juntos. Inhala, flexiona las rodillas como si te sentaras, eleva los brazos por encima de la cabeza. Peso en los talones, mira al frente, respira.", benefits: "Fortalece los tobillos, los muslos, las pantorrillas y la columna. Estira los hombros y el pecho. Estimula los órganos abdominales, el diafragma y el corazón. Reduce el pie plano. Da energía a todo el cuerpo."},
        {name: "Postura del niño", translation: "bala = niño, āsana = postura", description: "Arrodíllate, dedos de los pies juntos, rodillas separadas. Exhala, inclínate hacia delante, brazos extendidos. Frente en la esterilla, relájate, respira.", benefits: "Estira suavemente la cadera, los muslos y los tobillos. Calma la mente y ayuda a aliviar el estrés y la fatiga. Alivia el dolor de espalda y cuello si se hace con la cabeza y el torso apoyados."},
        {name: "Cadáver", translation: "śava = cadáver, āsana = postura", description: "Túmbate boca arriba, piernas extendidas, brazos a los lados, palmas hacia arriba. Cierra los ojos, relájate por completo, respira hondo.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Relaja el cuerpo. Reduce el dolor de cabeza, la fatiga y el insomnio. Ayuda a bajar la presión arterial."},
        {name: "Estocada alta", translation: "ashta = lado, chandra = luna, āsana = postura", description: "Da un paso adelante con un pie y baja en estocada. Rodilla trasera en el suelo o elevada. Inhala, eleva los brazos por encima de la cabeza. Baja la cadera, mira al frente, respira.", benefits: "Estira la caja torácica, los brazos y el torso. Tonifica los oblicuos."},
        {name: "Cuervo", translation: "baka = grulla, āsana = postura", description: "En cuclillas, manos en la esterilla al ancho de los hombros. Rodillas sobre la parte alta de los brazos. Exhala, lleva el peso adelante, eleva los pies. Equilíbrate, mira al frente, respira.", benefits: "Fortalece los brazos y las muñecas. Estira la parte alta de la espalda. Fortalece los abdominales. Abre las ingles. Tonifica los órganos abdominales."},
        {name: "Delfín", translation: "pīñcha = pluma, mayūra = pavo real, āsana = postura", description: "Desde Perro boca abajo, baja a los antebrazos, codos bajo los hombros. Eleva la cadera, presiona los talones hacia el suelo. Activa el abdomen, mira entre las manos, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Da energía al cuerpo. Estira los hombros, los isquiotibiales, las pantorrillas, los arcos de los pies y las manos. Fortalece los brazos y las piernas. Ayuda a aliviar los síntomas de la menopausia. Alivia las molestias menstruales si se hace con la cabeza apoyada. Ayuda a prevenir la osteoporosis. Mejora la digestión. Alivia el dolor de cabeza, el insomnio, el dolor de espalda y la fatiga. Terapéutica para la hipertensión, el asma, el pie plano, la ciática y la sinusitis. Calienta los tobillos y los dedos de los pies."},
        {name: "Perro boca abajo", translation: "parivṛtta = girado, adho = hacia abajo, mukha = cara, śvāna = perro, āsana = postura", description: "En manos y rodillas. Exhala, eleva la cadera hacia arriba y atrás. Estira las piernas, presiona los talones hacia el suelo. Alarga la columna, mira entre las piernas, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Da energía al cuerpo. Estira los hombros, el cuello, los isquiotibiales, las pantorrillas, los arcos de los pies y las manos. Fortalece los brazos y las piernas. Ayuda a aliviar los síntomas de la menopausia. Alivia las molestias menstruales si se hace con la cabeza apoyada. Ayuda a prevenir la osteoporosis. Mejora la digestión. Alivia el dolor de cabeza, el insomnio, el dolor de espalda y la fatiga. Terapéutica para la hipertensión, el asma, el pie plano, la ciática y la sinusitis."},
        {name: "Águila", translation: "garuḍa = águila, āsana = postura", description: "De pie, cruza la pierna derecha sobre la izquierda, engancha el pie detrás de la pantorrilla. Cruza el brazo izquierdo sobre el derecho, junta las palmas. Eleva los codos, mira al frente, respira.", benefits: "Fortalece y estira los tobillos y las pantorrillas. Estira los muslos, la cadera, los hombros y la parte alta de la espalda. Mejora la concentración. Mejora el sentido del equilibrio."},
        {name: "Mano al pie extendida", translation: "utthita = extendido, hasta = mano, pādāṅguṣṭha = dedo gordo del pie, āsana = postura", description: "De pie, eleva la pierna derecha, sujeta el dedo gordo con la mano derecha. Extiende la pierna al frente, cadera nivelada. Mira al frente, respira.", benefits: "Abre la cadera y las ingles. Estira los isquiotibiales, la cintilla iliotibial y las piernas. Mejora el equilibrio."},
        {name: "Ángulo lateral extendido", translation: "utthita = extendido, pārśva = lado, koṇa = ángulo, āsana = postura", description: "Desde Guerrero II, flexiona más la rodilla delantera. Lleva el brazo delantero por encima de la cabeza, la mano trasera en la pierna o el suelo. Abre el pecho, mira hacia arriba, respira.", benefits: "Fortalece y estira las piernas, las rodillas y los tobillos. Estira las ingles, la columna, la cintura, el pecho, los pulmones y los hombros. Estimula los órganos abdominales. Aumenta la resistencia."},
        {name: "Parada de antebrazos", translation: "pīñcha = pluma, mayūra = pavo real, āsana = postura", description: "Desde Delfín, acerca los pies caminando. Exhala, eleva las piernas una a una, equilíbrate sobre los antebrazos. Activa el abdomen, mira al frente, respira.", benefits: "Fortalece los brazos y los hombros. Mejora la concentración y el equilibrio. Estira la parte alta y baja de la espalda. Fortalece los abdominales. Tonifica la zona abdominal."},
        {name: "Pinza de pie con apertura de hombros", translation: "uttāna = estiramiento intenso, āsana = postura", description: "De pie, inclínate hacia delante, entrelaza las manos detrás de la espalda. Eleva los brazos con suavidad, relaja la cabeza. Mira hacia abajo, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Estimula el hígado y los riñones. Estira los isquiotibiales, las pantorrillas y la cadera. Fortalece los muslos y las rodillas. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia. Reduce la fatiga y la ansiedad. Alivia el dolor de cabeza y el insomnio. Abre los hombros."},
        {name: "Media luna", translation: "ardha = medio, chandra = luna, āsana = postura", description: "Desde Guerrero III, mano en el suelo junto al pie delantero. Eleva la pierna trasera en paralelo al suelo, extiende el brazo contrario hacia arriba. Abre la cadera, mira arriba o abajo, respira.", benefits: "Fortalece el abdomen, los tobillos, los muslos, los glúteos y la columna. Estira las ingles, los isquiotibiales, las pantorrillas, los hombros, el pecho y la columna. Mejora la coordinación y el sentido del equilibrio. Ayuda a aliviar el estrés. Mejora la digestión."},
        {name: "Parada de manos", translation: "adho = hacia abajo, mukha = cara, vṛkṣa = árbol, āsana = postura", description: "Desde Perro boca abajo, acerca los pies caminando. Lleva el peso a las manos, impúlsate con las piernas hacia arriba y estíralas. Activa el abdomen, mira al frente, respira.", benefits: "Fortalece los hombros, los brazos y las muñecas. Estira el vientre. Mejora el sentido del equilibrio. Calma la mente y ayuda a aliviar el estrés y la depresión leve."},
        {name: "Estocada baja", translation: "aṅjaneya = alabanza, āsana = postura", description: "Da un paso adelante con el pie derecho y baja en estocada. Baja la rodilla izquierda, manos en el muslo o por encima de la cabeza. Baja la cadera, mira al frente, respira.", benefits: "Estira el pecho, los pulmones, el cuello, el vientre y las ingles (psoas). Fortalece los hombros, los brazos y los músculos de la espalda. Fortalece y estira los muslos, las pantorrillas y los tobillos."},
        {name: "Paloma", translation: "supta = tumbado, kapota = paloma, āsana = postura", description: "Túmbate boca arriba, cruza el tobillo derecho sobre la rodilla izquierda. Lleva la rodilla izquierda al pecho. Mantén la espalda en el suelo, mira hacia arriba, respira.", benefits: "Estira los isquiotibiales y los cuádriceps. Si usas el codo para empujar el muslo, también abre la cadera."},
        {name: "Rey paloma", translation: "eka = uno, pāda = pie o pierna, rāja = rey, kapota = paloma, āsana = postura", description: "Desde Paloma, flexiona la rodilla trasera, sujeta el pie con la mano. Eleva el pecho, abre el corazón. Mira al frente, respira.", benefits: "Estira los muslos, las ingles (psoas), el abdomen, el pecho, los hombros y el cuello. Estimula los órganos abdominales. Abre los hombros y el pecho."},
        {name: "Plancha", translation: "phalaka = tabla, āsana = postura", description: "En manos y rodillas, lleva los pies atrás. Cuerpo recto, manos bajo los hombros. Activa el abdomen, mira hacia abajo, respira.", benefits: "Fortalece los brazos, las muñecas y la columna. Tonifica el abdomen."},
        {name: "Arado", translation: "hala = arado, āsana = postura", description: "Túmbate boca arriba. Exhala, lleva las piernas por encima de la cabeza, dedos de los pies al suelo detrás. Sostén la espalda o entrelaza las manos. Mira hacia dentro, respira.", benefits: "Calma la mente. Estimula los órganos abdominales y la tiroides. Estira los hombros y la columna. Ayuda a aliviar los síntomas de la menopausia. Reduce el estrés y la fatiga. Terapéutica para el dolor de espalda, el dolor de cabeza, la infertilidad, el insomnio y la sinusitis."},
        {name: "Pirámide", translation: "pārśva = lado, uttāna = estiramiento intenso, āsana = postura", description: "Pie derecho adelante, izquierdo atrás. Bisagra desde la cadera, inclínate sobre la pierna delantera. Manos en el suelo o en bloques. Mira hacia abajo, respira.", benefits: "Calma la mente. Estira la columna, los hombros, la cadera y los isquiotibiales. Fortalece las piernas. Estimula los órganos abdominales. Mejora la postura y el sentido del equilibrio. Mejora la digestión."},
        {name: "Guerrero invertido", translation: "pārśva = lado, vīrabhadra = guerrero, āsana = postura", description: "Desde Guerrero II, lleva el brazo delantero por encima de la cabeza y hacia atrás. Desliza la mano trasera por la pierna. Abre el pecho, mira hacia arriba, respira.", benefits: "Fortalece y estira las piernas, las rodillas y los tobillos. Estira las ingles, la columna, la cintura, el pecho, los pulmones y los hombros. Estimula los órganos abdominales. Aumenta la resistencia. Alivia el dolor de espalda, sobre todo en el segundo trimestre del embarazo. Terapéutica para el síndrome del túnel carpiano, el pie plano, la infertilidad, la osteoporosis y la ciática."},
        {name: "Pinza sentada", translation: "paśchima = espalda, uttāna = estiramiento intenso, āsana = postura", description: "Siéntate, piernas extendidas. Inhala, alarga la columna. Exhala, inclínate hacia delante, busca los pies o las espinillas. Mantén la columna larga, mira al frente, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Estira la columna, los hombros y los isquiotibiales. Estimula el hígado, los riñones, los ovarios y el útero. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia y las molestias menstruales. Calma el dolor de cabeza y la ansiedad. Reduce la fatiga. Terapéutica para la hipertensión, la infertilidad, el insomnio y la sinusitis. Los textos tradicionales dicen que Paschimottanasana aumenta el apetito, reduce la obesidad y cura enfermedades."},
        {name: "Loto", translation: "padma = loto, āsana = postura", description: "Siéntate, pon el pie derecho sobre el muslo izquierdo y el izquierdo sobre el derecho. Manos en las rodillas, siéntate erguido, respira.", benefits: "Abre la cadera y las ingles y estira las rodillas, los tobillos y los muslos. Fortalece la espalda y calma la mente, reduce el estrés y la ansiedad. Mejora la circulación y el flujo sanguíneo en la pelvis."},
        {name: "Medio señor de los peces", translation: "ardha = medio, matsya = pez, indra = rey", description: "Siéntate, cruza la rodilla derecha sobre la izquierda, gira a la derecha. Codo izquierdo por fuera de la rodilla derecha, mano derecha detrás. Mira por encima del hombro, respira.", benefits: "Estira los hombros, el pecho, los muslos, las ingles y el abdomen. Fortalece las piernas y los tobillos. Mejora el equilibrio."},
        {name: "Vela", translation: "sa = con, ālamba = apoyo, sarvāṅga = todos los miembros, āsana = postura", description: "Túmbate boca arriba. Exhala, eleva las piernas y la cadera, sostén la espalda con las manos. Estira las piernas, mira hacia dentro, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Estimula la tiroides, la próstata y los órganos abdominales. Estira los hombros y el cuello. Tonifica las piernas y los glúteos. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia. Reduce la fatiga y alivia el insomnio. Terapéutica para el asma, la infertilidad y la sinusitis."},
        {name: "Plancha lateral", translation: "vasiṣṭha = nombre de un sabio, āsana = postura", description: "Desde Plancha, gira sobre el borde exterior del pie derecho. Apila los pies, eleva el brazo izquierdo. Activa el abdomen, mira hacia arriba, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Estira los hombros, los isquiotibiales, las pantorrillas y los arcos de los pies. Fortalece los brazos y las piernas. Ayuda a aliviar los síntomas de la menopausia. Ayuda a prevenir la osteoporosis. Mejora la digestión. Alivia el dolor de cabeza, el insomnio, el dolor de espalda y la fatiga. Terapéutica para la hipertensión, el asma, el pie plano y la ciática."},
        {name: "Esfinge", translation: "sālamba = con apoyo, bhujaṅga = serpiente, āsana = postura", description: "Túmbate boca abajo, antebrazos en la esterilla, codos bajo los hombros. Inhala, eleva el pecho, baja los hombros. Mira al frente, respira.", benefits: "Fortalece la columna. Estira el pecho, los pulmones, los hombros y el abdomen. Estimula los órganos abdominales. Abre el corazón y los pulmones."},
        {name: "Split frontal", translation: "hanumān = deidad mono, āsana = postura", description: "Desde Estocada baja, desliza el pie delantero hacia delante y el trasero hacia atrás. Baja la cadera, mantenla nivelada. Manos en el suelo o en bloques. Mira al frente, respira.", benefits: "Estira los muslos, los isquiotibiales y las ingles. Estimula los órganos abdominales."},
        {name: "Guirnalda", translation: "mālā = guirnalda o collar, āsana = postura", description: "En cuclillas, pies juntos o separados. Codos por dentro de las rodillas, palmas juntas frente al corazón. Empuja las rodillas hacia fuera, baja la cadera, mira al frente, respira.", benefits: "Estira los tobillos, las ingles y la espalda. Tonifica el vientre."},
        {name: "Pinza de pie", translation: "uttāna = estiramiento intenso, āsana = postura", description: "De pie, inclínate hacia delante, manos al suelo o a las espinillas. Mantén la columna larga, la cabeza pesada. Mira hacia abajo, respira.", benefits: "Calma la mente y ayuda a aliviar el estrés y la depresión leve. Estimula el hígado y los riñones. Estira los isquiotibiales, las pantorrillas y la cadera. Fortalece los muslos y las rodillas. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia. Reduce la fatiga y la ansiedad. Alivia el dolor de cabeza y el insomnio."},
        {name: "Luna creciente", translation: "ashta = lado, chandra = luna, āsana = postura", description: "De pie, junta las manos por encima de la cabeza. Inhala, inclínate hacia un lado, estira el lado contrario. Mira hacia arriba, respira.", benefits: "Estira la caja torácica, los brazos y el torso. Tonifica los oblicuos."},
        {name: "Split lateral", translation: "upaviṣṭha = sentado, koṇa = ángulo, āsana = postura", description: "Siéntate, piernas bien abiertas. Exhala, avanza con las manos, baja el torso. Mantén la columna larga, mira hacia abajo, respira.", benefits: "Estira la cara interna y posterior de las piernas. Estimula los órganos abdominales. Fortalece la columna. Calma la mente. Libera las ingles."},
        {name: "Árbol", translation: "vṛkṣa = árbol, āsana = postura", description: "De pie, apoya el pie derecho en el muslo o la pantorrilla izquierda. Palmas juntas sobre la cabeza o frente al pecho. Equilíbrate, mira al frente, respira.", benefits: "Fortalece las piernas, los tobillos y los pies. Mejora la flexibilidad de la cadera y las rodillas. Mejora el equilibrio."},
        {name: "Triángulo", translation: "trikoṇa = triángulo, āsana = postura", description: "De pie con las piernas abiertas, gira el pie derecho hacia fuera. Baja la mano derecha a la espinilla o al suelo, brazo izquierdo arriba. Abre el pecho, mira hacia arriba, respira.", benefits: "Estira y fortalece los muslos, las rodillas y los tobillos. Estira la cadera, las ingles, los isquiotibiales, las pantorrillas, los hombros, el pecho y la columna. Estimula los órganos abdominales. Ayuda a aliviar el estrés. Mejora la digestión. Ayuda a aliviar los síntomas de la menopausia. Alivia el dolor de espalda, sobre todo en el segundo trimestre del embarazo. Terapéutica para la ansiedad, el pie plano, la infertilidad, el dolor de cuello, la osteoporosis y la ciática."},
        {name: "Perro boca arriba", translation: "ūrdhva = hacia arriba, mukha = cara, śvāna = perro, āsana = postura", description: "Túmbate boca abajo, manos junto a los hombros. Inhala, eleva el pecho y los muslos, lleva los hombros atrás. Mira al frente, respira.", benefits: "Mejora la postura. Fortalece la columna, los brazos y las muñecas. Estira el pecho, los pulmones, los hombros y el abdomen. Reafirma los glúteos. Estimula los órganos abdominales. Ayuda a aliviar la depresión leve, la fatiga y la ciática. Terapéutica para el asma."},
        {name: "Guerrero I", translation: "vīrabhadra = guerrero, āsana = postura", description: "Lleva el pie izquierdo atrás, flexiona la rodilla derecha a 90 grados. Eleva los brazos por encima de la cabeza, baja la cadera. Mira al frente, respira.", benefits: "Estira el pecho, los pulmones, los hombros, el cuello, el vientre y las ingles (psoas). Fortalece los hombros, los brazos y los músculos de la espalda. Fortalece y estira los muslos, las pantorrillas y los tobillos."},
        {name: "Guerrero II", translation: "vīrabhadra = guerrero, āsana = postura", description: "Lleva el pie izquierdo atrás, flexiona la rodilla derecha a 90 grados. Brazos en paralelo al suelo, baja la cadera. Mira por encima de la mano derecha, respira.", benefits: "Fortalece y estira las piernas y los tobillos. Estira las ingles, el pecho, los pulmones y los hombros. Estimula los órganos abdominales. Aumenta la resistencia. Alivia el dolor de espalda, sobre todo en el segundo trimestre del embarazo. Terapéutica para el síndrome del túnel carpiano, el pie plano, la infertilidad, la osteoporosis y la ciática."},
        {name: "Guerrero III", translation: "vīrabhadra = guerrero, āsana = postura", description: "De pie, pasa el peso a la pierna derecha. Eleva la pierna izquierda atrás en paralelo al suelo, brazos al frente o a los lados. Equilíbrate, mira hacia abajo, respira.", benefits: "Fortalece los tobillos y las piernas. Fortalece los hombros y los músculos de la espalda. Tonifica el abdomen. Mejora el equilibrio y la postura."},
        {name: "Rueda", translation: "ūrdhva = hacia arriba, dhanu = arco, āsana = postura", description: "Túmbate boca arriba con las rodillas flexionadas y las manos junto a las orejas. Exhala y eleva la cadera y el pecho formando un arco. Mira hacia arriba y respira con calma.", benefits: "Fortalece los brazos, las muñecas, las piernas, los glúteos, el abdomen y la columna. Estimula la tiroides y la hipófisis. Aumenta la energía, ayuda a contrarrestar la depresión y es terapéutica para el asma, el dolor de espalda, la infertilidad y la osteoporosis."},
        {name: "Cosa salvaje", translation: "camatkāra = lleno de asombro, āsana = postura", description: "Empieza en Perro boca abajo, luego eleva la pierna derecha y abre la cadera. Apoya la mano derecha junto al pie delantero, eleva el brazo izquierdo, arquea la espalda, mira hacia arriba y respira hondo.", benefits: "Estira el pecho, los hombros, la espalda y la garganta. Fortalece y abre la cadera, los flexores de la cadera y los muslos."}
      ]
      sessionText: [
        {name: "Flujo suave para empezar", description: "Una secuencia relajante para iniciarte en el yoga con posturas básicas y atención a la respiración."},
        {name: "Despertar matutino", description: "Una secuencia para principiantes que da energía y estira el cuerpo para el día que empieza."},
        {name: "Bases para descansar", description: "Una secuencia tranquila para principiantes que relaja y restaura con posturas suaves."},
        {name: "Bases en equilibrio", description: "Una secuencia para principiantes que desarrolla equilibrio y fuerza con posturas de pie y sentadas."},
        {name: "Abdomen y estiramiento", description: "Una secuencia para principiantes que fortalece el abdomen y mejora la flexibilidad con posturas sencillas."},
        {name: "Abdomen fuerte", description: "Una secuencia intermedia y dinámica para ganar estabilidad y fuerza en el abdomen."},
        {name: "Flujo para abrir caderas", description: "Una secuencia intermedia que estira y abre a fondo la cadera para ganar flexibilidad."},
        {name: "Torsión y energía", description: "Una secuencia intermedia de torsiones para depurar el cuerpo y subir la energía."},
        {name: "Reto de equilibrio", description: "Una secuencia intermedia que mejora el equilibrio y la coordinación con posturas de pie."},
        {name: "Flujo vigoroso", description: "Un flujo intermedio lleno de energía que desarrolla resistencia y fuerza con transiciones dinámicas."},
        {name: "Abrir el corazón", description: "Una secuencia intermedia que abre el pecho y fortalece la espalda con extensiones."},
        {name: "Abdomen y estabilidad", description: "Una secuencia intermedia que combina trabajo abdominal y posturas de equilibrio para una estabilidad general."},
        {name: "Flexibilidad sentada", description: "Una secuencia intermedia de posturas sentadas para ganar flexibilidad en la cadera y los isquiotibiales."},
        {name: "Poder guerrero", description: "Una secuencia intermedia centrada en las posturas del guerrero para ganar fuerza y confianza."},
        {name: "Energía y equilibrio", description: "Una secuencia intermedia y energizante que aumenta la vitalidad y mejora el equilibrio."},
        {name: "Abdomen intensivo", description: "Una secuencia avanzada que trabaja a fondo la fuerza abdominal con posturas exigentes."},
        {name: "Explorar inversiones", description: "Una secuencia avanzada para dominar las inversiones, ganando fuerza y control."},
        {name: "Flexibilidad extrema", description: "Una secuencia avanzada que lleva la flexibilidad al límite con estiramientos profundos y splits."},
        {name: "Dominio de equilibrios", description: "Una secuencia avanzada centrada en los equilibrios sobre brazos para fortalecer el tren superior."},
        {name: "Extensiones profundas", description: "Una secuencia avanzada para profundizar las extensiones, abriendo el pecho y la columna."},
        {name: "Flujo definitivo", description: "Un flujo avanzado y completo que combina fuerza, equilibrio y flexibilidad."},
        {name: "Precisión y poder", description: "Una secuencia avanzada que pone el foco en una alineación precisa y en posturas potentes."},
        {name: "Cadera y corazón a fondo", description: "Una secuencia avanzada que abre a fondo la cadera y el corazón para ganar flexibilidad y liberar emociones."},
        {name: "Fuerza y control", description: "Una secuencia avanzada para ganar fuerza y control con posturas exigentes."},
        {name: "Maestría en yoga", description: "Una secuencia avanzada que pone a prueba la fuerza, el equilibrio y la flexibilidad de practicantes con experiencia."},
        {name: "Flujo dichoso para empezar", description: "Una secuencia completa para principiantes que fluye en armonía por el calentamiento, posturas de pie de fuerza y equilibrio, extensiones suaves, flexiones hacia delante, aperturas de cadera y posturas restaurativas, para construir una base sólida."}
      ]
    }
    pt {
      title: "yoga"
      sessions: "sessões"; poses: "posturas"
      levels: {beginner: "iniciante", intermediate: "intermediário", advanced: "avançado"}
      ranks: {novice: "Novato", practitioner: "Praticante", adept: "Adepto", devotee: "Devoto", teacher: "Professor", master: "Mestre"}
      paces: {swift: "rápido", balanced: "equilibrado", endurance: "resistência"}
      levelRank: (n, rank) => "nível ${n} · ${rank}"
      streak: n => n == 1 ? "1 dia seguido" : "${n} dias seguidos"
      xpLine: (xp, need, next) => "${xp} xp · ${need} até o nível ${next}"
      completed: "feito"
      sessionLine: (level, n, time) => "${level} · ${n} posturas · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · segure ${time} · dos dois lados" : "${level} · segure ${time}"
      how: "como fazer"; benefits: "benefícios"; inSessions: "nas sessões"
      startArrow: "iniciar ›"
      getReady: "prepare-se"
      first: name => "primeira: ${name}"
      introLine: (n, time) => "${n} posturas · ${time} neste ritmo"
      startNow: "começar agora"
      poseOf: (i, n) => "postura ${i} de ${n}"
      voiceOn: "voz ligada"; voiceOff: "voz desligada"
      nextPose: "próxima postura"; paused: "pausado"; readyNext: "prepare-se para a próxima postura…"
      firstSide: "primeiro lado"; secondSide: "segundo lado"; lastPose: "última postura"
      quitAsk: "sair desta sessão?"; keepGoing: "continuar"; quit: "sair"
      resume: "retomar"; pause: "pausar"; skip: "pular"
      greatJob: "mandou bem"
      levelUp: (n, rank) => "nível ${n}: ${rank}"
      xpHint: "o xp vem com a primeira sessão do dia"
      done: "pronto"; again: "de novo"
      poseText: [
        {name: "Barco", translation: "nāva = barco, āsana = postura", description: "Sente-se com as pernas estendidas. Expire, eleve as pernas a 45 graus e incline-se um pouco para trás. Estenda os braços à frente, palmas voltadas uma para a outra. Equilibre-se sobre os ísquios, ative o abdômen. Olhe para os dedos dos pés, respire.", benefits: "Fortalece o abdômen, os flexores do quadril e a coluna. Estimula os rins, a tireoide, a próstata e os intestinos. Ajuda a aliviar o estresse. Melhora a digestão."},
        {name: "Meio barco", translation: "ardha = metade, nāva = barco, āsana = postura", description: "Sente-se com os joelhos dobrados e os pés no ar. Incline-se um pouco para trás, segure atrás das coxas ou estenda os braços. Equilibre-se, ative o abdômen, olhe para a frente, respire.", benefits: "Fortalece o abdômen, os flexores do quadril e a coluna. Estimula os rins, a tireoide, a próstata e os intestinos. Ajuda a aliviar o estresse. Melhora a digestão."},
        {name: "Arco", translation: "dhanur = arco, āsana = postura", description: "Deite-se de bruços. Dobre os joelhos, segure os tornozelos. Inspire, eleve o peito e as coxas, pressione os pés contra as mãos. Olhe para a frente, respire.", benefits: "Alonga toda a parte da frente do corpo: tornozelos, coxas e virilhas, abdômen e peito, garganta e os flexores profundos do quadril (psoas). Fortalece os músculos das costas. Melhora a postura. Estimula os órgãos do abdômen e do pescoço."},
        {name: "Ponte", translation: "setu = ponte, bandha = trava, sarva = todo, āṅga = membro, āsana = postura", description: "Deite-se de costas, joelhos dobrados, pés na largura do quadril. Inspire, eleve o quadril, entrelace as mãos sob as costas. Encaixe os ombros por baixo, eleve o peito. Olhe para cima, respire.", benefits: "Alonga o peito, o pescoço e a coluna. Estimula os órgãos abdominais, os pulmões e a tireoide. Revigora pernas cansadas. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa. Alivia o desconforto menstrual quando feita com apoio. Reduz ansiedade, cansaço, dor nas costas, dor de cabeça e insônia. Terapêutica para asma, pressão alta, osteoporose e sinusite."},
        {name: "Borboleta", translation: "baddha = preso, koṇa = ângulo, āsana = postura", description: "Sente-se com as solas dos pés juntas, joelhos para fora. Segure os pés, sente-se ereto. Relaxe os ombros, respire fundo.", benefits: "Abre o quadril e as virilhas. Alonga os ombros, a caixa torácica e as costas. Estimula os órgãos abdominais, os pulmões e o coração."},
        {name: "Camelo", translation: "uṣṭra = camelo, āsana = postura", description: "Ajoelhe-se, mãos na lombar. Inspire, eleve o peito e, se for confortável, leve as mãos aos calcanhares. Mantenha o pescoço neutro, olhe para a frente, respire.", benefits: "Alonga toda a parte da frente do corpo: tornozelos, coxas e virilhas, abdômen e peito, e garganta. Alonga os flexores profundos do quadril (psoas). Fortalece os músculos das costas. Melhora a postura. Estimula os órgãos do abdômen e do pescoço."},
        {name: "Gato", translation: "marjarya = gato, āsana = postura", description: "Fique em quatro apoios. Expire, arredonde a coluna para cima, recolha o queixo. Ative o abdômen, olhe para a barriga, respire.", benefits: "Alivia a coluna e o pescoço. Energiza o corpo."},
        {name: "Vaca", translation: "bitil = vaca, āsana = postura", description: "Fique em quatro apoios. Inspire, curve a coluna para baixo, eleve o cóccix e o peito. Olhe para cima, respire.", benefits: "Elimina o cansaço. Melhora a respiração e a circulação do sangue para o cérebro. Revigora o corpo todo."},
        {name: "Cadeira", translation: "utkaṭa = feroz, āsana = postura", description: "Fique em pé, pés juntos. Inspire, dobre os joelhos como se fosse sentar, eleve os braços acima da cabeça. Peso nos calcanhares, olhe para a frente, respire.", benefits: "Fortalece os tornozelos, as coxas, as panturrilhas e a coluna. Alonga os ombros e o peito. Estimula os órgãos abdominais, o diafragma e o coração. Ajuda no pé chato. Energiza o corpo todo."},
        {name: "Postura da criança", translation: "bala = criança, āsana = postura", description: "Ajoelhe-se, dedões dos pés juntos, joelhos afastados. Expire, dobre o tronco à frente, braços estendidos. Testa no tapete, relaxe, respire.", benefits: "Alonga suavemente o quadril, as coxas e os tornozelos. Acalma a mente e ajuda a aliviar o estresse e o cansaço. Alivia dores nas costas e no pescoço quando feita com a cabeça e o tronco apoiados."},
        {name: "Cadáver", translation: "śava = cadáver, āsana = postura", description: "Deite-se de costas, pernas estendidas, braços ao lado do corpo, palmas para cima. Feche os olhos, relaxe por completo, respire fundo.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Relaxa o corpo. Reduz dor de cabeça, cansaço e insônia. Ajuda a baixar a pressão arterial."},
        {name: "Avanço em lua crescente", translation: "ashta = lado, chandra = lua, āsana = postura", description: "Dê um passo à frente com um pé e faça um avanço. Joelho de trás no chão ou elevado. Inspire, eleve os braços acima da cabeça. Afunde o quadril, olhe para a frente, respire.", benefits: "Alonga a caixa torácica, os braços e o tronco. Tonifica os músculos oblíquos."},
        {name: "Corvo", translation: "baka = garça, āsana = postura", description: "Agache, mãos no tapete na largura dos ombros. Joelhos sobre a parte de cima dos braços. Expire, leve o peso à frente, tire os pés do chão. Equilibre-se, olhe para a frente, respire.", benefits: "Fortalece os braços e os punhos. Alonga a parte superior das costas. Fortalece os músculos abdominais. Abre a virilha. Tonifica os órgãos abdominais."},
        {name: "Golfinho", translation: "pīñcha = pena, mayūra = pavão, āsana = postura", description: "Do cachorro olhando para baixo, desça aos antebraços, cotovelos sob os ombros. Eleve o quadril, leve os calcanhares para baixo. Ative o abdômen, olhe entre as mãos, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Energiza o corpo. Alonga os ombros, os isquiotibiais, as panturrilhas, os arcos dos pés e as mãos. Fortalece os braços e as pernas. Ajuda a aliviar os sintomas da menopausa. Alivia o desconforto menstrual quando feita com a cabeça apoiada. Ajuda a prevenir a osteoporose. Melhora a digestão. Alivia dor de cabeça, insônia, dor nas costas e cansaço. Terapêutica para pressão alta, asma, pé chato, ciática e sinusite. Aquece os tornozelos e os dedos dos pés."},
        {name: "Cachorro olhando para baixo", translation: "parivṛtta = girado, adho = para baixo, mukha = voltado, śvāna = cachorro, āsana = postura", description: "Fique em quatro apoios. Expire, eleve o quadril para cima e para trás. Estique as pernas, leve os calcanhares para baixo. Alongue a coluna, olhe entre as pernas, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Energiza o corpo. Alonga os ombros, o pescoço, os isquiotibiais, as panturrilhas, os arcos dos pés e as mãos. Fortalece os braços e as pernas. Ajuda a aliviar os sintomas da menopausa. Alivia o desconforto menstrual quando feita com a cabeça apoiada. Ajuda a prevenir a osteoporose. Melhora a digestão. Alivia dor de cabeça, insônia, dor nas costas e cansaço. Terapêutica para pressão alta, asma, pé chato, ciática e sinusite."},
        {name: "Águia", translation: "garuḍa = águia, āsana = postura", description: "Fique em pé, cruze a perna direita sobre a esquerda, prenda o pé atrás da panturrilha. Cruze o braço esquerdo sobre o direito, junte as palmas. Eleve os cotovelos, olhe para a frente, respire.", benefits: "Fortalece e alonga os tornozelos e as panturrilhas. Alonga as coxas, o quadril, os ombros e a parte superior das costas. Melhora a concentração. Melhora o equilíbrio."},
        {name: "Mão no dedão do pé estendida", translation: "utthita = estendido, hasta = mão, pādāṅguṣṭha = dedão do pé, āsana = postura", description: "Fique em pé, eleve a perna direita, segure o dedão do pé com a mão direita. Estenda a perna à frente, quadril alinhado. Olhe para a frente, respire.", benefits: "Abre o quadril e as virilhas. Alonga os isquiotibiais, a banda iliotibial e as pernas. Melhora o equilíbrio."},
        {name: "Ângulo lateral estendido", translation: "utthita = estendido, pārśva = lado, koṇa = ângulo, āsana = postura", description: "Do guerreiro II, dobre mais o joelho da frente. Leve o braço da frente acima da cabeça, a mão de trás na perna ou no chão. Abra o peito, olhe para cima, respire.", benefits: "Fortalece e alonga as pernas, os joelhos e os tornozelos. Alonga a virilha, a coluna, a cintura, o peito, os pulmões e os ombros. Estimula os órgãos abdominais. Aumenta a resistência."},
        {name: "Invertida sobre os antebraços", translation: "pīñcha = pena, mayūra = pavão, āsana = postura", description: "Do golfinho, aproxime os pés. Expire, eleve uma perna de cada vez, equilibre-se sobre os antebraços. Ative o abdômen, olhe para a frente, respire.", benefits: "Fortalece os braços e os ombros. Melhora o foco e o equilíbrio. Alonga a parte superior e inferior das costas. Fortalece os músculos abdominais. Tonifica a região abdominal."},
        {name: "Flexão à frente com abertura de ombros", translation: "uttāna = estender, āsana = postura", description: "Fique em pé, dobre o tronco à frente, entrelace as mãos atrás das costas. Eleve os braços com suavidade, relaxe a cabeça. Olhe para baixo, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Estimula o fígado e os rins. Alonga os isquiotibiais, as panturrilhas e o quadril. Fortalece as coxas e os joelhos. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa. Reduz o cansaço e a ansiedade. Alivia dor de cabeça e insônia. Abre os ombros."},
        {name: "Meia-lua", translation: "ardha = metade, chandra = lua, āsana = postura", description: "Do guerreiro III, apoie a mão no chão ao lado do pé da frente. Eleve a perna de trás paralela ao chão, estenda o braço oposto para cima. Abra o quadril, olhe para cima ou para baixo, respire.", benefits: "Fortalece o abdômen, os tornozelos, as coxas, os glúteos e a coluna. Alonga as virilhas, os isquiotibiais, as panturrilhas, os ombros, o peito e a coluna. Melhora a coordenação e o equilíbrio. Ajuda a aliviar o estresse. Melhora a digestão."},
        {name: "Parada de mãos", translation: "adho = para baixo, mukha = voltado, vṛkṣa = árvore, āsana = postura", description: "Do cachorro olhando para baixo, aproxime os pés. Leve o peso às mãos, impulsione as pernas para cima, estique-as. Ative o abdômen, olhe para a frente, respire.", benefits: "Fortalece os ombros, os braços e os punhos. Alonga a barriga. Melhora o equilíbrio. Acalma a mente e ajuda a aliviar o estresse e a depressão leve."},
        {name: "Avanço baixo", translation: "aṅjaneya = louvor, āsana = postura", description: "Dê um passo à frente com o pé direito e faça um avanço. Desça o joelho esquerdo, mãos na coxa ou acima da cabeça. Afunde o quadril, olhe para a frente, respire.", benefits: "Alonga o peito, os pulmões, o pescoço, a barriga e a virilha (psoas). Fortalece os ombros, os braços e os músculos das costas. Fortalece e alonga as coxas, as panturrilhas e os tornozelos."},
        {name: "Pombo", translation: "supta = deitado de costas, kapota = pombo, āsana = postura", description: "Deite-se de costas, cruze o tornozelo direito sobre o joelho esquerdo. Puxe o joelho esquerdo em direção ao peito. Mantenha as costas no chão, olhe para cima, respire.", benefits: "Alonga os isquiotibiais e os quadríceps. Se o cotovelo empurrar a coxa, também abre o quadril."},
        {name: "Rei pombo", translation: "eka = um, pāda = pé ou perna, rāja = rei, kapota = pombo, āsana = postura", description: "Do pombo, dobre o joelho de trás, segure o pé com a mão. Eleve o peito, abra o coração. Olhe para a frente, respire.", benefits: "Alonga as coxas, as virilhas (psoas), o abdômen, o peito, os ombros e o pescoço. Estimula os órgãos abdominais. Abre os ombros e o peito."},
        {name: "Prancha", translation: "phalaka = prancha, āsana = postura", description: "De quatro apoios, leve os pés para trás. Corpo reto, mãos sob os ombros. Ative o abdômen, olhe para baixo, respire.", benefits: "Fortalece os braços, os punhos e a coluna. Tonifica o abdômen."},
        {name: "Arado", translation: "hala = arado, āsana = postura", description: "Deite-se de costas. Expire, leve as pernas por cima da cabeça, dedos dos pés no chão atrás. Apoie as costas ou entrelace as mãos. Olhe para dentro, respire.", benefits: "Acalma a mente. Estimula os órgãos abdominais e a tireoide. Alonga os ombros e a coluna. Ajuda a aliviar os sintomas da menopausa. Reduz o estresse e o cansaço. Terapêutica para dor nas costas, dor de cabeça, infertilidade, insônia e sinusite."},
        {name: "Pirâmide", translation: "pārśva = lado, uttāna = estender, āsana = postura", description: "Pé direito à frente, esquerdo atrás. Dobre a partir do quadril, desça o tronco sobre a perna da frente. Mãos no chão ou em blocos. Olhe para baixo, respire.", benefits: "Acalma a mente. Alonga a coluna, os ombros, o quadril e os isquiotibiais. Fortalece as pernas. Estimula os órgãos abdominais. Melhora a postura e o equilíbrio. Melhora a digestão."},
        {name: "Guerreiro reverso", translation: "pārśva = lado, vīrabhadra = guerreiro, āsana = postura", description: "Do guerreiro II, leve o braço da frente para cima e para trás. Deslize a mão de trás pela perna. Abra o peito, olhe para cima, respire.", benefits: "Fortalece e alonga as pernas, os joelhos e os tornozelos. Alonga a virilha, a coluna, a cintura, o peito, os pulmões e os ombros. Estimula os órgãos abdominais. Aumenta a resistência. Alivia dores nas costas, especialmente no segundo trimestre da gravidez. Terapêutica para síndrome do túnel do carpo, pé chato, infertilidade, osteoporose e ciática."},
        {name: "Pinça sentada", translation: "paśchima = parte de trás, uttāna = estender, āsana = postura", description: "Sente-se com as pernas estendidas. Inspire, alongue a coluna. Expire, dobre o tronco à frente, leve as mãos aos pés ou às canelas. Mantenha a coluna longa, olhe para a frente, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Alonga a coluna, os ombros e os isquiotibiais. Estimula o fígado, os rins, os ovários e o útero. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa e o desconforto menstrual. Alivia dor de cabeça e ansiedade. Reduz o cansaço. Terapêutica para pressão alta, infertilidade, insônia e sinusite. Os textos tradicionais dizem que Paschimottanasana aumenta o apetite, reduz a obesidade e cura doenças."},
        {name: "Lótus", translation: "padma = lótus, āsana = postura", description: "Sente-se, coloque o pé direito sobre a coxa esquerda e o esquerdo sobre a direita. Mãos nos joelhos, sente-se ereto, respire.", benefits: "Abre o quadril e a virilha e alonga os joelhos, os tornozelos e as coxas. Fortalece as costas e acalma a mente, reduzindo o estresse e a ansiedade. Melhora a circulação e o fluxo sanguíneo na pelve."},
        {name: "Meio senhor dos peixes", translation: "ardha = metade, matsya = peixe, indra = rei", description: "Sente-se, cruze o joelho direito sobre o esquerdo, gire para a direita. Cotovelo esquerdo por fora do joelho direito, mão direita atrás. Olhe por cima do ombro, respire.", benefits: "Alonga os ombros, o peito, as coxas, as virilhas e o abdômen. Fortalece as pernas e os tornozelos. Melhora o equilíbrio."},
        {name: "Vela", translation: "sa = com, ālamba = apoio, sarvāṅga = todos os membros, āsana = postura", description: "Deite-se de costas. Expire, eleve as pernas e o quadril, apoie as costas com as mãos. Estique as pernas, olhe para dentro, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Estimula a tireoide, a próstata e os órgãos abdominais. Alonga os ombros e o pescoço. Tonifica as pernas e os glúteos. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa. Reduz o cansaço e alivia a insônia. Terapêutica para asma, infertilidade e sinusite."},
        {name: "Prancha lateral", translation: "vasiṣṭha = nome de um sábio, āsana = postura", description: "Da prancha, gire sobre a borda externa do pé direito. Empilhe os pés, eleve o braço esquerdo. Ative o abdômen, olhe para cima, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Alonga os ombros, os isquiotibiais, as panturrilhas e os arcos dos pés. Fortalece os braços e as pernas. Ajuda a aliviar os sintomas da menopausa. Ajuda a prevenir a osteoporose. Melhora a digestão. Alivia dor de cabeça, insônia, dor nas costas e cansaço. Terapêutica para pressão alta, asma, pé chato e ciática."},
        {name: "Esfinge", translation: "sālamba = apoiado, bhujaṅga = serpente, āsana = postura", description: "Deite-se de bruços, antebraços no tapete, cotovelos sob os ombros. Inspire, eleve o peito, leve os ombros para baixo. Olhe para a frente, respire.", benefits: "Fortalece a coluna. Alonga o peito, os pulmões, os ombros e o abdômen. Estimula os órgãos abdominais. Abre o coração e os pulmões."},
        {name: "Espacate", translation: "hanumān = divindade macaco, āsana = postura", description: "Do avanço, deslize o pé da frente para a frente e o de trás para trás. Desça o quadril, mantendo-o alinhado. Mãos no chão ou em blocos. Olhe para a frente, respire.", benefits: "Alonga as coxas, os isquiotibiais e a virilha. Estimula os órgãos abdominais."},
        {name: "Guirlanda", translation: "mālā = guirlanda ou colar, āsana = postura", description: "Agache, pés juntos ou afastados. Cotovelos por dentro dos joelhos, palmas unidas diante do coração. Empurre os joelhos para fora, afunde o quadril, olhe para a frente, respire.", benefits: "Alonga os tornozelos, as virilhas e a parte de trás do tronco. Tonifica a barriga."},
        {name: "Pinça em pé", translation: "uttāna = estender, āsana = postura", description: "Fique em pé, dobre o tronco à frente, mãos no chão ou nas canelas. Mantenha a coluna longa, a cabeça pesada. Olhe para baixo, respire.", benefits: "Acalma a mente e ajuda a aliviar o estresse e a depressão leve. Estimula o fígado e os rins. Alonga os isquiotibiais, as panturrilhas e o quadril. Fortalece as coxas e os joelhos. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa. Reduz o cansaço e a ansiedade. Alivia dor de cabeça e insônia."},
        {name: "Lua crescente", translation: "ashta = lado, chandra = lua, āsana = postura", description: "Fique em pé, entrelace as mãos acima da cabeça. Inspire, incline-se para um lado, alongando o lado oposto. Olhe para cima, respire.", benefits: "Alonga a caixa torácica, os braços e o tronco. Tonifica os músculos oblíquos."},
        {name: "Espacate lateral", translation: "upaviṣṭha = sentado, koṇa = ângulo, āsana = postura", description: "Sente-se com as pernas bem afastadas. Expire, caminhe com as mãos à frente, desça o tronco. Mantenha a coluna longa, olhe para baixo, respire.", benefits: "Alonga a parte interna e de trás das pernas. Estimula os órgãos abdominais. Fortalece a coluna. Acalma a mente. Solta a virilha."},
        {name: "Árvore", translation: "vṛkṣa = árvore, āsana = postura", description: "Fique em pé, apoie o pé direito na coxa ou na panturrilha esquerda. Palmas unidas acima da cabeça ou diante do peito. Equilibre-se, olhe para a frente, respire.", benefits: "Fortalece as pernas, os tornozelos e os pés. Melhora a flexibilidade do quadril e dos joelhos. Melhora o equilíbrio."},
        {name: "Triângulo", translation: "trikoṇa = triângulo, āsana = postura", description: "Fique em pé com as pernas afastadas, gire o pé direito para fora. Leve a mão direita à canela ou ao chão, o braço esquerdo para cima. Abra o peito, olhe para cima, respire.", benefits: "Alonga e fortalece as coxas, os joelhos e os tornozelos. Alonga o quadril, a virilha, os isquiotibiais, as panturrilhas, os ombros, o peito e a coluna. Estimula os órgãos abdominais. Ajuda a aliviar o estresse. Melhora a digestão. Ajuda a aliviar os sintomas da menopausa. Alivia dores nas costas, especialmente no segundo trimestre da gravidez. Terapêutica para ansiedade, pé chato, infertilidade, dor no pescoço, osteoporose e ciática."},
        {name: "Cachorro olhando para cima", translation: "ūrdhva = para cima, mukha = voltado, śvāna = cachorro, āsana = postura", description: "Deite-se de bruços, mãos ao lado dos ombros. Inspire, eleve o peito e as coxas, leve os ombros para trás. Olhe para a frente, respire.", benefits: "Melhora a postura. Fortalece a coluna, os braços e os punhos. Alonga o peito, os pulmões, os ombros e o abdômen. Firma os glúteos. Estimula os órgãos abdominais. Ajuda a aliviar a depressão leve, o cansaço e a ciática. Terapêutica para asma."},
        {name: "Guerreiro I", translation: "vīrabhadra = guerreiro, āsana = postura", description: "Leve o pé esquerdo para trás, dobre o joelho direito a 90 graus. Eleve os braços acima da cabeça, afunde o quadril. Olhe para a frente, respire.", benefits: "Alonga o peito, os pulmões, os ombros, o pescoço, a barriga e a virilha (psoas). Fortalece os ombros, os braços e os músculos das costas. Fortalece e alonga as coxas, as panturrilhas e os tornozelos."},
        {name: "Guerreiro II", translation: "vīrabhadra = guerreiro, āsana = postura", description: "Leve o pé esquerdo para trás, dobre o joelho direito a 90 graus. Braços paralelos ao chão, afunde o quadril. Olhe por cima da mão direita, respire.", benefits: "Fortalece e alonga as pernas e os tornozelos. Alonga a virilha, o peito, os pulmões e os ombros. Estimula os órgãos abdominais. Aumenta a resistência. Alivia dores nas costas, especialmente no segundo trimestre da gravidez. Terapêutica para síndrome do túnel do carpo, pé chato, infertilidade, osteoporose e ciática."},
        {name: "Guerreiro III", translation: "vīrabhadra = guerreiro, āsana = postura", description: "Fique em pé, leve o peso à perna direita. Eleve a perna esquerda para trás, paralela ao chão, braços à frente ou nas laterais. Equilibre-se, olhe para baixo, respire.", benefits: "Fortalece os tornozelos e as pernas. Fortalece os ombros e os músculos das costas. Tonifica o abdômen. Melhora o equilíbrio e a postura."},
        {name: "Roda", translation: "ūrdhva = para cima, dhanu = arco, āsana = postura", description: "Deite-se de costas com os joelhos dobrados e as mãos ao lado das orelhas. Expire e eleve o quadril e o peito, formando um arco. Olhe para cima e respire com calma.", benefits: "Fortalece os braços, os punhos, as pernas, os glúteos, o abdômen e a coluna. Estimula a tireoide e a hipófise. Aumenta a energia, ajuda a combater a depressão e traz benefícios terapêuticos para asma, dor nas costas, infertilidade e osteoporose."},
        {name: "Coisa selvagem", translation: "camatkāra = tomado de encanto, āsana = postura", description: "Comece no cachorro olhando para baixo, eleve a perna direita e abra o quadril. Apoie a mão direita ao lado do pé da frente, eleve o braço esquerdo, arqueie as costas, olhe para cima e respire fundo.", benefits: "Alonga o peito, os ombros, as costas e a garganta. Fortalece e abre o quadril, os flexores do quadril e as coxas."}
      ]
      sessionText: [
        {name: "Flow suave para iniciantes", description: "Uma sequência tranquila para quem está começando entrar no yoga com posturas básicas e foco na respiração."},
        {name: "Despertar matinal", description: "Uma sequência para iniciantes que energiza e alonga o corpo para o dia que começa."},
        {name: "Básico relaxante", description: "Uma sequência calma para iniciantes, para relaxar e se recuperar com posturas suaves."},
        {name: "Bases do equilíbrio", description: "Uma sequência para iniciantes que desenvolve equilíbrio e força com posturas em pé e sentadas."},
        {name: "Core e alongamento", description: "Uma sequência para iniciantes que fortalece o core e melhora a flexibilidade com posturas simples."},
        {name: "Força do core intermediária", description: "Uma sequência intermediária dinâmica para desenvolver estabilidade e força no core."},
        {name: "Flow de abertura de quadril", description: "Uma sequência intermediária para alongar e abrir bem o quadril, com mais flexibilidade."},
        {name: "Torção e energia", description: "Uma sequência intermediária de torções para desintoxicar e renovar a energia."},
        {name: "Desafio de equilíbrio", description: "Uma sequência intermediária que melhora o equilíbrio e a coordenação com posturas em pé."},
        {name: "Flow vigoroso", description: "Um flow intermediário cheio de energia que desenvolve resistência e força com transições dinâmicas."},
        {name: "Abertura do coração", description: "Uma sequência intermediária com extensões de coluna para abrir o peito e fortalecer as costas."},
        {name: "Core e estabilidade", description: "Uma sequência intermediária que une trabalho de core e posturas de equilíbrio para mais estabilidade."},
        {name: "Flexibilidade sentada", description: "Uma sequência intermediária de posturas sentadas para aprofundar a flexibilidade do quadril e dos isquiotibiais."},
        {name: "Força do guerreiro", description: "Uma sequência intermediária centrada nas posturas do guerreiro para ganhar força e confiança."},
        {name: "Energia e equilíbrio", description: "Uma sequência intermediária revigorante para aumentar a vitalidade e melhorar o equilíbrio."},
        {name: "Core intensivo avançado", description: "Uma sequência avançada que trabalha a fundo a força do core com posturas desafiadoras."},
        {name: "Explorando invertidas", description: "Uma sequência avançada para dominar as invertidas, ganhando força e controle."},
        {name: "Flexibilidade extrema", description: "Uma sequência avançada que leva a flexibilidade ao limite com alongamentos profundos e espacates."},
        {name: "Domínio dos equilíbrios de braço", description: "Uma sequência avançada centrada nos equilíbrios sobre os braços para fortalecer a parte superior do corpo."},
        {name: "Extensões profundas", description: "Uma sequência avançada para aprofundar as extensões de coluna, abrindo o peito e a coluna."},
        {name: "Flow supremo", description: "Um flow avançado e completo que combina força, equilíbrio e flexibilidade."},
        {name: "Precisão e potência", description: "Uma sequência avançada com foco no alinhamento preciso e em posturas potentes."},
        {name: "Quadril e coração intensivo", description: "Uma sequência avançada para abrir a fundo o quadril e o coração, com flexibilidade e liberação emocional."},
        {name: "Força e controle", description: "Uma sequência avançada para ganhar força e controle com posturas desafiadoras."},
        {name: "Maestria no yoga", description: "Uma sequência avançada que desafia força, equilíbrio e flexibilidade, para praticantes experientes."},
        {name: "Flow de iniciante feliz", description: "Uma sequência completa para iniciantes que flui com harmonia por aquecimento, posturas de força e equilíbrio em pé, extensões suaves, flexões à frente, aberturas de quadril e posturas restaurativas, para criar uma base sólida."}
      ]
    }
    de {
      title: "yoga"
      sessions: "einheiten"; poses: "haltungen"
      levels: {beginner: "anfänger", intermediate: "mittel", advanced: "fortgeschritten"}
      ranks: {novice: "Neuling", practitioner: "Übender", adept: "Adept", devotee: "Yogi", teacher: "Lehrer", master: "Meister"}
      paces: {swift: "zügig", balanced: "ausgewogen", endurance: "ausdauer"}
      levelRank: (n, rank) => "level ${n} · ${rank}"
      streak: n => n == 1 ? "1 tag in folge" : "${n} tage in folge"
      xpLine: (xp, need, next) => "${xp} xp · noch ${need} bis level ${next}"
      completed: "fertig"
      sessionLine: (level, n, time) => "${level} · ${n} haltungen · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · ${time} halten · beide seiten" : "${level} · ${time} halten"
      how: "anleitung"; benefits: "wirkung"; inSessions: "in einheiten"
      startArrow: "los ›"
      getReady: "mach dich bereit"
      first: name => "zuerst: ${name}"
      introLine: (n, time) => "${n} haltungen · ${time} in diesem tempo"
      startNow: "jetzt starten"
      poseOf: (i, n) => "haltung ${i} von ${n}"
      voiceOn: "stimme an"; voiceOff: "stimme aus"
      nextPose: "nächste haltung"; paused: "pausiert"; readyNext: "mach dich bereit für die nächste haltung…"
      firstSide: "erste seite"; secondSide: "zweite seite"; lastPose: "letzte haltung"
      quitAsk: "einheit abbrechen?"; keepGoing: "weitermachen"; quit: "abbrechen"
      resume: "weiter"; pause: "pause"; skip: "überspringen"
      greatJob: "super gemacht"
      levelUp: (n, rank) => "level ${n}: ${rank}"
      xpHint: "xp gibt’s für die erste einheit am tag"
      done: "fertig"; again: "nochmal"
      poseText: [
        {name: "Boot", translation: "nāva = Boot, āsana = Haltung", description: "Setz dich mit gestreckten Beinen hin. Hebe ausatmend die Beine auf 45 Grad, lehn dich leicht zurück. Streck die Arme nach vorn, Handflächen zueinander. Balanciere auf den Sitzbeinhöckern, spann die Körpermitte an. Blick zu den Zehen, atme.", benefits: "Kräftigt Bauch, Hüftbeuger und Wirbelsäule. Regt Nieren, Schilddrüse, Prostata und Darm an. Hilft, Stress abzubauen. Fördert die Verdauung."},
        {name: "Halbes Boot", translation: "ardha = halb, nāva = Boot, āsana = Haltung", description: "Setz dich, Knie gebeugt, Füße angehoben. Lehn dich leicht zurück, halte die Oberschenkel von hinten oder streck die Arme. Balanciere, spann die Körpermitte an, Blick nach vorn, atme.", benefits: "Kräftigt Bauch, Hüftbeuger und Wirbelsäule. Regt Nieren, Schilddrüse, Prostata und Darm an. Hilft, Stress abzubauen. Fördert die Verdauung."},
        {name: "Bogen", translation: "dhanur = Bogen, āsana = Haltung", description: "Leg dich auf den Bauch. Beug die Knie, greif die Fußgelenke. Hebe einatmend Brust und Oberschenkel, drück die Füße in die Hände. Blick nach vorn, atme.", benefits: "Dehnt die gesamte Körpervorderseite: Fußgelenke, Oberschenkel und Leisten, Bauch und Brust, Hals sowie die tiefen Hüftbeuger (Psoas). Kräftigt die Rückenmuskulatur. Verbessert die Haltung. Regt die Organe in Bauch und Hals an."},
        {name: "Schulterbrücke", translation: "setu = Brücke, bandha = Verschluss, sarva = alle, āṅga = Glied, āsana = Haltung", description: "Leg dich auf den Rücken, Knie gebeugt, Füße hüftbreit. Hebe einatmend das Becken, verschränke die Hände unter dem Rücken. Roll die Schultern unter, hebe die Brust. Blick nach oben, atme.", benefits: "Dehnt Brust, Nacken und Wirbelsäule. Regt Bauchorgane, Lunge und Schilddrüse an. Belebt müde Beine. Fördert die Verdauung. Lindert Wechseljahresbeschwerden. Lindert mit Unterstützung Menstruationsbeschwerden. Mindert Angst, Müdigkeit, Rücken- und Kopfschmerzen sowie Schlaflosigkeit. Hilfreich bei Asthma, Bluthochdruck, Osteoporose und Nebenhöhlenentzündung."},
        {name: "Schmetterling", translation: "baddha = gebunden, koṇa = Winkel, āsana = Haltung", description: "Setz dich, Fußsohlen aneinander, Knie nach außen. Halte die Füße, sitz aufrecht. Lass die Schultern locker, atme tief.", benefits: "Öffnet Hüften und Leisten. Dehnt Schultern, Brustkorb und Rücken. Regt Bauchorgane, Lunge und Herz an."},
        {name: "Kamel", translation: "uṣṭra = Kamel, āsana = Haltung", description: "Knie dich hin, Hände am unteren Rücken. Hebe einatmend die Brust, greif nach den Fersen, wenn es angenehm ist. Halte den Nacken neutral, Blick nach vorn, atme.", benefits: "Dehnt die gesamte Körpervorderseite: Fußgelenke, Oberschenkel und Leisten, Bauch und Brust sowie den Hals. Dehnt die tiefen Hüftbeuger (Psoas). Kräftigt die Rückenmuskulatur. Verbessert die Haltung. Regt die Organe in Bauch und Hals an."},
        {name: "Katze", translation: "marjarya = Katze, āsana = Haltung", description: "Geh in den Vierfüßlerstand. Mach ausatmend einen runden Rücken, zieh das Kinn zur Brust. Spann die Körpermitte an, Blick zum Bauch, atme.", benefits: "Entlastet Wirbelsäule und Nacken. Gibt dem Körper Energie."},
        {name: "Kuh", translation: "bitil = Kuh, āsana = Haltung", description: "Geh in den Vierfüßlerstand. Lass einatmend den Rücken durchhängen, hebe Steißbein und Brust. Blick nach oben, atme.", benefits: "Vertreibt Müdigkeit. Verbessert die Atmung und die Durchblutung des Gehirns. Belebt den ganzen Körper."},
        {name: "Stuhl", translation: "utkaṭa = kraftvoll, āsana = Haltung", description: "Steh mit geschlossenen Füßen. Beug einatmend die Knie, als würdest du dich setzen, hebe die Arme über den Kopf. Gewicht in den Fersen, Blick nach vorn, atme.", benefits: "Kräftigt Fußgelenke, Oberschenkel, Waden und Wirbelsäule. Dehnt Schultern und Brust. Regt Bauchorgane, Zwerchfell und Herz an. Hilft bei Plattfüßen. Belebt den ganzen Körper."},
        {name: "Kindhaltung", translation: "bala = Kind, āsana = Haltung", description: "Knie dich hin, große Zehen zusammen, Knie auseinander. Beug dich ausatmend nach vorn, Arme gestreckt. Stirn auf die Matte, entspann dich, atme.", benefits: "Dehnt sanft Hüften, Oberschenkel und Fußgelenke. Beruhigt den Geist und hilft gegen Stress und Müdigkeit. Lindert Rücken- und Nackenschmerzen, wenn Kopf und Oberkörper gestützt sind."},
        {name: "Totenstellung", translation: "śava = Leichnam, āsana = Haltung", description: "Leg dich auf den Rücken, Beine gestreckt, Arme neben dem Körper, Handflächen nach oben. Schließ die Augen, entspann dich ganz, atme tief.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Entspannt den Körper. Mindert Kopfschmerzen, Müdigkeit und Schlaflosigkeit. Hilft, den Blutdruck zu senken."},
        {name: "Hoher Ausfallschritt", translation: "ashta = Seite, chandra = Mond, āsana = Haltung", description: "Mach einen großen Schritt nach vorn in den Ausfallschritt. Hinteres Knie abgelegt oder angehoben. Hebe einatmend die Arme über den Kopf. Senk die Hüften, Blick nach vorn, atme.", benefits: "Dehnt Brustkorb, Arme und Oberkörper. Strafft die seitlichen Bauchmuskeln."},
        {name: "Krähe", translation: "baka = Kranich, āsana = Haltung", description: "Geh in die Hocke, Hände schulterbreit auf der Matte. Knie an die Oberarme. Verlager ausatmend das Gewicht nach vorn, hebe die Füße. Balanciere, Blick nach vorn, atme.", benefits: "Kräftigt Arme und Handgelenke. Dehnt den oberen Rücken. Kräftigt die Bauchmuskeln. Öffnet die Leisten. Strafft die Bauchorgane."},
        {name: "Delfin", translation: "pīñcha = Feder, mayūra = Pfau, āsana = Haltung", description: "Komm aus dem herabschauenden Hund auf die Unterarme, Ellbogen unter den Schultern. Hebe die Hüften, drück die Fersen Richtung Boden. Spann die Körpermitte an, Blick zwischen die Hände, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Gibt dem Körper Energie. Dehnt Schultern, hintere Oberschenkel, Waden, Fußgewölbe und Hände. Kräftigt Arme und Beine. Lindert Wechseljahresbeschwerden. Lindert Menstruationsbeschwerden, wenn der Kopf gestützt ist. Beugt Osteoporose vor. Fördert die Verdauung. Lindert Kopfschmerzen, Schlaflosigkeit, Rückenschmerzen und Müdigkeit. Hilfreich bei Bluthochdruck, Asthma, Plattfüßen, Ischias und Nebenhöhlenentzündung. Wärmt Fußgelenke und Zehen auf."},
        {name: "Herabschauender Hund", translation: "parivṛtta = gedreht, adho = nach unten, mukha = blickend, śvāna = Hund, āsana = Haltung", description: "Geh in den Vierfüßlerstand. Schieb ausatmend die Hüften nach oben und hinten. Streck die Beine, drück die Fersen Richtung Boden. Mach die Wirbelsäule lang, Blick zwischen die Beine, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Gibt dem Körper Energie. Dehnt Schultern, Nacken, hintere Oberschenkel, Waden, Fußgewölbe und Hände. Kräftigt Arme und Beine. Lindert Wechseljahresbeschwerden. Lindert Menstruationsbeschwerden, wenn der Kopf gestützt ist. Beugt Osteoporose vor. Fördert die Verdauung. Lindert Kopfschmerzen, Schlaflosigkeit, Rückenschmerzen und Müdigkeit. Hilfreich bei Bluthochdruck, Asthma, Plattfüßen, Ischias und Nebenhöhlenentzündung."},
        {name: "Adler", translation: "garuḍa = Adler, āsana = Haltung", description: "Steh, schlag das rechte Bein über das linke, hak den Fuß hinter der Wade ein. Kreuz den linken Arm über den rechten, leg die Handflächen aneinander. Hebe die Ellbogen, Blick nach vorn, atme.", benefits: "Kräftigt und dehnt Fußgelenke und Waden. Dehnt Oberschenkel, Hüften, Schultern und oberen Rücken. Fördert die Konzentration. Verbessert den Gleichgewichtssinn."},
        {name: "Hand zum großen Zeh", translation: "utthita = gestreckt, hasta = Hand, pādāṅguṣṭha = großer Zeh, āsana = Haltung", description: "Steh, hebe das rechte Bein, halte den großen Zeh mit der rechten Hand. Streck das Bein nach vorn, Hüften gerade. Blick nach vorn, atme.", benefits: "Öffnet Hüften und Leisten. Dehnt hintere Oberschenkel, Tractus iliotibialis und Beine. Verbessert das Gleichgewicht."},
        {name: "Gestreckter Seitwinkel", translation: "utthita = gestreckt, pārśva = Seite, koṇa = Winkel, āsana = Haltung", description: "Beug aus Krieger 2 das vordere Knie tiefer. Streck den vorderen Arm über den Kopf, die hintere Hand aufs Bein oder auf den Boden. Öffne die Brust, Blick nach oben, atme.", benefits: "Kräftigt und dehnt Beine, Knie und Fußgelenke. Dehnt Leisten, Wirbelsäule, Taille, Brust, Lunge und Schultern. Regt die Bauchorgane an. Steigert die Ausdauer."},
        {name: "Unterarmstand", translation: "pīñcha = Feder, mayūra = Pfau, āsana = Haltung", description: "Lauf aus dem Delfin mit den Füßen näher heran. Hebe ausatmend die Beine nacheinander, balanciere auf den Unterarmen. Spann die Körpermitte an, Blick nach vorn, atme.", benefits: "Kräftigt Arme und Schultern. Fördert Konzentration und Gleichgewicht. Dehnt oberen und unteren Rücken. Kräftigt die Bauchmuskeln. Strafft den Bauch."},
        {name: "Vorbeuge mit Schulteröffner", translation: "uttāna = ausgestreckt, āsana = Haltung", description: "Steh, beug dich nach vorn, verschränke die Hände hinter dem Rücken. Hebe die Arme sanft, lass den Kopf locker. Blick nach unten, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Regt Leber und Nieren an. Dehnt hintere Oberschenkel, Waden und Hüften. Kräftigt Oberschenkel und Knie. Fördert die Verdauung. Lindert Wechseljahresbeschwerden. Mindert Müdigkeit und Angst. Lindert Kopfschmerzen und Schlaflosigkeit. Öffnet die Schultern."},
        {name: "Halbmond", translation: "ardha = halb, chandra = Mond, āsana = Haltung", description: "Setz aus Krieger 3 die Hand neben dem vorderen Fuß auf den Boden. Hebe das hintere Bein parallel zum Boden, streck den anderen Arm nach oben. Öffne die Hüften, Blick nach oben oder unten, atme.", benefits: "Kräftigt Bauch, Fußgelenke, Oberschenkel, Po und Wirbelsäule. Dehnt Leisten, hintere Oberschenkel, Waden, Schultern, Brust und Wirbelsäule. Verbessert Koordination und Gleichgewichtssinn. Hilft, Stress abzubauen. Fördert die Verdauung."},
        {name: "Handstand", translation: "adho = nach unten, mukha = blickend, vṛkṣa = Baum, āsana = Haltung", description: "Lauf aus dem herabschauenden Hund mit den Füßen näher heran. Verlager das Gewicht, schwing die Beine hoch, streck sie. Spann die Körpermitte an, Blick nach vorn, atme.", benefits: "Kräftigt Schultern, Arme und Handgelenke. Dehnt den Bauch. Verbessert den Gleichgewichtssinn. Beruhigt den Geist und hilft gegen Stress und leichte Depression."},
        {name: "Tiefer Ausfallschritt", translation: "aṅjaneya = Lobpreis, āsana = Haltung", description: "Mach mit dem rechten Fuß einen großen Schritt nach vorn in den Ausfallschritt. Leg das linke Knie ab, Hände auf den Oberschenkel oder über den Kopf. Senk die Hüften, Blick nach vorn, atme.", benefits: "Dehnt Brust, Lunge, Nacken, Bauch und Leisten (Psoas). Kräftigt Schultern, Arme und Rückenmuskulatur. Kräftigt und dehnt Oberschenkel, Waden und Fußgelenke."},
        {name: "Taube", translation: "supta = liegend, kapota = Taube, āsana = Haltung", description: "Leg dich auf den Rücken, leg das rechte Fußgelenk über das linke Knie. Zieh das linke Knie zur Brust. Lass den Rücken am Boden, Blick nach oben, atme.", benefits: "Dehnt hintere und vordere Oberschenkel. Drückt der Ellbogen den Oberschenkel weg, öffnet es auch die Hüften."},
        {name: "Königstaube", translation: "eka = eins, pāda = Fuß oder Bein, rāja = König, kapota = Taube, āsana = Haltung", description: "Beug aus der Taube das hintere Knie, greif den Fuß mit der Hand. Hebe die Brust, öffne das Herz. Blick nach vorn, atme.", benefits: "Dehnt Oberschenkel, Leisten (Psoas), Bauch, Brust, Schultern und Nacken. Regt die Bauchorgane an. Öffnet Schultern und Brust."},
        {name: "Brett", translation: "phalaka = Brett, āsana = Haltung", description: "Geh in den Vierfüßlerstand, setz die Füße nach hinten. Körper gerade, Hände unter den Schultern. Spann die Körpermitte an, Blick nach unten, atme.", benefits: "Kräftigt Arme, Handgelenke und Wirbelsäule. Strafft den Bauch."},
        {name: "Pflug", translation: "hala = Pflug, āsana = Haltung", description: "Leg dich auf den Rücken. Führ ausatmend die Beine über den Kopf, Zehen hinter dir zum Boden. Stütz den Rücken oder verschränke die Hände. Blick nach innen, atme.", benefits: "Beruhigt den Geist. Regt Bauchorgane und Schilddrüse an. Dehnt Schultern und Wirbelsäule. Lindert Wechseljahresbeschwerden. Mindert Stress und Müdigkeit. Hilfreich bei Rückenschmerzen, Kopfschmerzen, Unfruchtbarkeit, Schlaflosigkeit und Nebenhöhlenentzündung."},
        {name: "Pyramide", translation: "pārśva = Seite, uttāna = ausgestreckt, āsana = Haltung", description: "Setz den rechten Fuß nach vorn, den linken nach hinten. Kipp aus der Hüfte, beug dich über das vordere Bein. Hände auf den Boden oder auf Blöcke. Blick nach unten, atme.", benefits: "Beruhigt den Geist. Dehnt Wirbelsäule, Schultern, Hüften und hintere Oberschenkel. Kräftigt die Beine. Regt die Bauchorgane an. Verbessert Haltung und Gleichgewichtssinn. Fördert die Verdauung."},
        {name: "Umgekehrter Krieger", translation: "pārśva = Seite, vīrabhadra = Krieger, āsana = Haltung", description: "Streck aus Krieger 2 den vorderen Arm über den Kopf nach hinten. Lass die hintere Hand am Bein hinuntergleiten. Öffne die Brust, Blick nach oben, atme.", benefits: "Kräftigt und dehnt Beine, Knie und Fußgelenke. Dehnt Leisten, Wirbelsäule, Taille, Brust, Lunge und Schultern. Regt die Bauchorgane an. Steigert die Ausdauer. Lindert Rückenschmerzen, besonders im zweiten Schwangerschaftsdrittel. Hilfreich bei Karpaltunnelsyndrom, Plattfüßen, Unfruchtbarkeit, Osteoporose und Ischias."},
        {name: "Sitzende Vorbeuge", translation: "paśchima = Rückseite, uttāna = ausgestreckt, āsana = Haltung", description: "Setz dich, Beine gestreckt. Mach einatmend die Wirbelsäule lang. Beug dich ausatmend nach vorn, greif nach Füßen oder Schienbeinen. Halte die Wirbelsäule lang, Blick nach vorn, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Dehnt Wirbelsäule, Schultern und hintere Oberschenkel. Regt Leber, Nieren, Eierstöcke und Gebärmutter an. Fördert die Verdauung. Lindert Wechseljahres- und Menstruationsbeschwerden. Lindert Kopfschmerzen und Angst. Mindert Müdigkeit. Hilfreich bei Bluthochdruck, Unfruchtbarkeit, Schlaflosigkeit und Nebenhöhlenentzündung. Laut traditionellen Texten steigert Paschimottanasana den Appetit, mindert Übergewicht und heilt Krankheiten."},
        {name: "Lotus", translation: "padma = Lotus, āsana = Haltung", description: "Setz dich, leg den rechten Fuß auf den linken Oberschenkel, den linken auf den rechten. Hände auf die Knie, sitz aufrecht, atme.", benefits: "Öffnet Hüften und Leisten und dehnt Knie, Fußgelenke und Oberschenkel. Kräftigt den Rücken, beruhigt den Geist, mindert Stress und Angst. Fördert die Durchblutung im Becken."},
        {name: "Halber Drehsitz", translation: "ardha = halb, matsya = Fisch, indra = König", description: "Setz dich, stell das rechte Knie über das linke, dreh dich nach rechts. Linker Ellbogen außen am rechten Knie, rechte Hand hinter dir. Blick über die Schulter, atme.", benefits: "Dehnt Schultern, Brust, Oberschenkel, Leisten und Bauch. Kräftigt Beine und Fußgelenke. Verbessert das Gleichgewicht."},
        {name: "Schulterstand", translation: "sa = mit, ālamba = Stütze, sarvāṅga = alle Glieder, āsana = Haltung", description: "Leg dich auf den Rücken. Hebe ausatmend Beine und Hüften, stütz den Rücken mit den Händen. Streck die Beine, Blick nach innen, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Regt Schilddrüse, Prostata und Bauchorgane an. Dehnt Schultern und Nacken. Strafft Beine und Po. Fördert die Verdauung. Lindert Wechseljahresbeschwerden. Mindert Müdigkeit und Schlaflosigkeit. Hilfreich bei Asthma, Unfruchtbarkeit und Nebenhöhlenentzündung."},
        {name: "Seitstütz", translation: "vasiṣṭha = Name eines Weisen, āsana = Haltung", description: "Roll dich aus dem Brett auf die Außenkante des rechten Fußes. Füße übereinander, linken Arm nach oben. Spann die Körpermitte an, Blick nach oben, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Dehnt Schultern, hintere Oberschenkel, Waden und Fußgewölbe. Kräftigt Arme und Beine. Lindert Wechseljahresbeschwerden. Beugt Osteoporose vor. Fördert die Verdauung. Lindert Kopfschmerzen, Schlaflosigkeit, Rückenschmerzen und Müdigkeit. Hilfreich bei Bluthochdruck, Asthma, Plattfüßen und Ischias."},
        {name: "Sphinx", translation: "sālamba = gestützt, bhujaṅga = Schlange, āsana = Haltung", description: "Leg dich auf den Bauch, Unterarme auf der Matte, Ellbogen unter den Schultern. Hebe einatmend die Brust, zieh die Schultern nach unten. Blick nach vorn, atme.", benefits: "Kräftigt die Wirbelsäule. Dehnt Brust, Lunge, Schultern und Bauch. Regt die Bauchorgane an. Öffnet Herz und Lunge."},
        {name: "Spagat", translation: "hanumān = Affengottheit, āsana = Haltung", description: "Schieb aus dem Ausfallschritt den vorderen Fuß nach vorn, den hinteren nach hinten. Senk die Hüften, halte sie gerade. Hände auf den Boden oder auf Blöcke. Blick nach vorn, atme.", benefits: "Dehnt Oberschenkel, hintere Oberschenkel und Leisten. Regt die Bauchorgane an."},
        {name: "Girlande", translation: "mālā = Girlande oder Halskette, āsana = Haltung", description: "Geh in die Hocke, Füße zusammen oder auseinander. Ellbogen innen an den Knien, Handflächen vor dem Herzen. Drück die Knie nach außen, senk die Hüften, Blick nach vorn, atme.", benefits: "Dehnt Fußgelenke, Leisten und Rücken. Strafft den Bauch."},
        {name: "Stehende Vorbeuge", translation: "uttāna = ausgestreckt, āsana = Haltung", description: "Steh, beug dich nach vorn, Hände zum Boden oder an die Schienbeine. Halte die Wirbelsäule lang, lass den Kopf schwer werden. Blick nach unten, atme.", benefits: "Beruhigt den Geist und hilft gegen Stress und leichte Depression. Regt Leber und Nieren an. Dehnt hintere Oberschenkel, Waden und Hüften. Kräftigt Oberschenkel und Knie. Fördert die Verdauung. Lindert Wechseljahresbeschwerden. Mindert Müdigkeit und Angst. Lindert Kopfschmerzen und Schlaflosigkeit."},
        {name: "Mondsichel", translation: "ashta = Seite, chandra = Mond, āsana = Haltung", description: "Steh, verschränke die Hände über dem Kopf. Neig dich einatmend zur Seite, dehn die andere Seite. Blick nach oben, atme.", benefits: "Dehnt Brustkorb, Arme und Oberkörper. Strafft die seitlichen Bauchmuskeln."},
        {name: "Seitspagat", translation: "upaviṣṭha = sitzend, koṇa = Winkel, āsana = Haltung", description: "Setz dich, Beine weit gegrätscht. Lauf ausatmend mit den Händen nach vorn, senk den Oberkörper. Halte die Wirbelsäule lang, Blick nach unten, atme.", benefits: "Dehnt Innen- und Rückseite der Beine. Regt die Bauchorgane an. Kräftigt die Wirbelsäule. Beruhigt den Geist. Löst die Leisten."},
        {name: "Baum", translation: "vṛkṣa = Baum, āsana = Haltung", description: "Steh, setz den rechten Fuß an den linken Oberschenkel oder die Wade. Handflächen über dem Kopf oder vor der Brust aneinander. Balanciere, Blick nach vorn, atme.", benefits: "Kräftigt Beine, Fußgelenke und Füße. Macht Hüften und Knie beweglicher. Verbessert das Gleichgewicht."},
        {name: "Dreieck", translation: "trikoṇa = Dreieck, āsana = Haltung", description: "Steh breitbeinig, dreh den rechten Fuß nach außen. Führ die rechte Hand zum Schienbein oder Boden, den linken Arm nach oben. Öffne die Brust, Blick nach oben, atme.", benefits: "Dehnt und kräftigt Oberschenkel, Knie und Fußgelenke. Dehnt Hüften, Leisten, hintere Oberschenkel, Waden, Schultern, Brust und Wirbelsäule. Regt die Bauchorgane an. Hilft, Stress abzubauen. Fördert die Verdauung. Lindert Wechseljahresbeschwerden. Lindert Rückenschmerzen, besonders im zweiten Schwangerschaftsdrittel. Hilfreich bei Angst, Plattfüßen, Unfruchtbarkeit, Nackenschmerzen, Osteoporose und Ischias."},
        {name: "Heraufschauender Hund", translation: "ūrdhva = nach oben, mukha = blickend, śvāna = Hund, āsana = Haltung", description: "Leg dich auf den Bauch, Hände neben den Schultern. Hebe einatmend Brust und Oberschenkel, roll die Schultern nach hinten. Blick nach vorn, atme.", benefits: "Verbessert die Haltung. Kräftigt Wirbelsäule, Arme und Handgelenke. Dehnt Brust, Lunge, Schultern und Bauch. Strafft den Po. Regt die Bauchorgane an. Hilft gegen leichte Depression, Müdigkeit und Ischias. Hilfreich bei Asthma."},
        {name: "Krieger 1", translation: "vīrabhadra = Krieger, āsana = Haltung", description: "Setz den linken Fuß nach hinten, beug das rechte Knie auf 90 Grad. Hebe die Arme über den Kopf, senk die Hüften. Blick nach vorn, atme.", benefits: "Dehnt Brust, Lunge, Schultern, Nacken, Bauch und Leisten (Psoas). Kräftigt Schultern, Arme und Rückenmuskulatur. Kräftigt und dehnt Oberschenkel, Waden und Fußgelenke."},
        {name: "Krieger 2", translation: "vīrabhadra = Krieger, āsana = Haltung", description: "Setz den linken Fuß nach hinten, beug das rechte Knie auf 90 Grad. Arme parallel zum Boden, senk die Hüften. Blick über die rechte Hand, atme.", benefits: "Kräftigt und dehnt Beine und Fußgelenke. Dehnt Leisten, Brust, Lunge und Schultern. Regt die Bauchorgane an. Steigert die Ausdauer. Lindert Rückenschmerzen, besonders im zweiten Schwangerschaftsdrittel. Hilfreich bei Karpaltunnelsyndrom, Plattfüßen, Unfruchtbarkeit, Osteoporose und Ischias."},
        {name: "Krieger 3", translation: "vīrabhadra = Krieger, āsana = Haltung", description: "Steh, verlager das Gewicht aufs rechte Bein. Hebe das linke Bein nach hinten parallel zum Boden, Arme nach vorn oder zur Seite. Balanciere, Blick nach unten, atme.", benefits: "Kräftigt Fußgelenke und Beine. Kräftigt Schultern und Rückenmuskulatur. Strafft den Bauch. Verbessert Gleichgewicht und Haltung."},
        {name: "Rad", translation: "ūrdhva = nach oben, dhanu = Bogen, āsana = Haltung", description: "Leg dich auf den Rücken, Knie gebeugt, Hände neben den Ohren. Hebe ausatmend Hüften und Brust zu einem Bogen. Blick nach oben, atme gleichmäßig.", benefits: "Kräftigt Arme, Handgelenke, Beine, Po, Bauch und Wirbelsäule. Regt Schilddrüse und Hirnanhangdrüse an. Gibt Energie, wirkt Depression entgegen und ist hilfreich bei Asthma, Rückenschmerzen, Unfruchtbarkeit und Osteoporose."},
        {name: "Wild Thing", translation: "camatkāra = vom Staunen ergriffen, āsana = Haltung", description: "Beginn im herabschauenden Hund, hebe dann das rechte Bein und öffne die Hüfte. Setz die rechte Hand neben den vorderen Fuß, hebe den linken Arm, mach einen Bogen mit dem Rücken, Blick nach oben, atme tief.", benefits: "Dehnt Brust, Schultern, Rücken und Hals. Kräftigt und öffnet Hüften, Hüftbeuger und Oberschenkel."}
      ]
      sessionText: [
        {name: "Sanfter Einsteiger-Flow", description: "Eine wohltuende Abfolge für Einsteiger, um mit Grundhaltungen und Fokus auf den Atem sanft ins Yoga zu finden."},
        {name: "Guten Morgen", description: "Eine einsteigerfreundliche Abfolge, die den Körper für den Tag weckt und dehnt."},
        {name: "Ruhige Basics", description: "Eine beruhigende Einsteiger-Abfolge, um mit sanften Haltungen zu entspannen und aufzutanken."},
        {name: "Stabile Basis", description: "Eine Einsteiger-Abfolge für Gleichgewicht und Kraft mit Haltungen im Stehen und Sitzen."},
        {name: "Mitte und Dehnung", description: "Eine Einsteiger-Abfolge, die mit einfachen Haltungen die Körpermitte kräftigt und beweglicher macht."},
        {name: "Starke Mitte", description: "Eine dynamische Abfolge für Fortgeschrittene, die Stabilität und Kraft in der Körpermitte aufbaut."},
        {name: "Hüftöffner-Flow", description: "Eine Abfolge für Fortgeschrittene, die die Hüften tief dehnt und öffnet, für mehr Beweglichkeit."},
        {name: "Drehen und Auftanken", description: "Eine Abfolge mit Drehungen für Fortgeschrittene, die entgiftet und Energie gibt."},
        {name: "Balance-Challenge", description: "Eine Abfolge für Fortgeschrittene, die mit Haltungen im Stehen Gleichgewicht und Koordination schult."},
        {name: "Kraftvoller Flow", description: "Ein energiegeladener Flow für Fortgeschrittene, der mit dynamischen Übergängen Ausdauer und Kraft aufbaut."},
        {name: "Herzöffner", description: "Eine Abfolge für Fortgeschrittene, die mit Rückbeugen die Brust öffnet und den Rücken kräftigt."},
        {name: "Mitte und Stabilität", description: "Eine Abfolge für Fortgeschrittene aus Übungen für die Körpermitte und Gleichgewichtshaltungen, für mehr Stabilität."},
        {name: "Beweglich im Sitzen", description: "Eine Abfolge für Fortgeschrittene mit Haltungen im Sitzen, die Hüften und hintere Oberschenkel beweglicher macht."},
        {name: "Kriegerkraft", description: "Eine Abfolge für Fortgeschrittene rund um die Kriegerhaltungen, für Kraft und Selbstvertrauen."},
        {name: "Energie und Balance", description: "Eine belebende Abfolge für Fortgeschrittene, die Vitalität schenkt und das Gleichgewicht verbessert."},
        {name: "Intensive Mitte", description: "Eine Abfolge für Profis, die mit fordernden Haltungen gezielt die Körpermitte kräftigt."},
        {name: "Umkehrhaltungen", description: "Eine Abfolge für Profis, um Umkehrhaltungen zu meistern und Kraft und Kontrolle aufzubauen."},
        {name: "Extrem beweglich", description: "Eine Abfolge für Profis, die mit tiefen Dehnungen und Spagaten die Grenzen der Beweglichkeit verschiebt."},
        {name: "Armbalancen meistern", description: "Eine Abfolge für Profis rund um Armbalancen, die den Oberkörper kräftigt."},
        {name: "Tiefe Rückbeugen", description: "Eine Abfolge für Profis, die Rückbeugen vertieft und Brust und Wirbelsäule öffnet."},
        {name: "Der ultimative Flow", description: "Ein umfassender Flow für Profis, der Kraft, Gleichgewicht und Beweglichkeit verbindet."},
        {name: "Präzision und Power", description: "Eine Abfolge für Profis mit Fokus auf genauer Ausrichtung und kraftvollen Haltungen."},
        {name: "Hüfte und Herz intensiv", description: "Eine Abfolge für Profis, die Hüften und Herz tief öffnet, für Beweglichkeit und emotionale Befreiung."},
        {name: "Kraft und Kontrolle", description: "Eine Abfolge für Profis, die mit fordernden Haltungen Kraft und Kontrolle aufbaut."},
        {name: "Yoga-Meisterschaft", description: "Eine Abfolge für Profis, die erfahrene Übende in Kraft, Gleichgewicht und Beweglichkeit fordert."},
        {name: "Glücklicher Einsteiger-Flow", description: "Eine umfassende Einsteiger-Abfolge, die harmonisch vom Aufwärmen über Kraft- und Gleichgewichtshaltungen im Stehen, sanfte Rückbeugen, Vorbeugen und Hüftöffner bis zu regenerierenden Haltungen führt und eine rundum solide Basis schafft."}
      ]
    }
    zh {
      title: "瑜伽"
      sessions: "课程"; poses: "体式"
      levels: {beginner: "初级", intermediate: "中级", advanced: "高级"}
      ranks: {novice: "新手", practitioner: "习练者", adept: "熟手", devotee: "精进者", teacher: "导师", master: "大师"}
      paces: {swift: "快速", balanced: "均衡", endurance: "持久"}
      levelRank: (n, rank) => "${n} 级 · ${rank}"
      streak: n => "连续 ${n} 天"
      xpLine: (xp, need, next) => "${xp} xp · 距 ${next} 级还差 ${need}"
      completed: "已完成"
      sessionLine: (level, n, time) => "${level} · ${n} 个体式 · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · 保持 ${time} · 左右两侧" : "${level} · 保持 ${time}"
      how: "做法"; benefits: "益处"; inSessions: "所在课程"
      startArrow: "开始 ›"
      getReady: "准备"
      first: name => "第一个：${name}"
      introLine: (n, time) => "${n} 个体式 · 按此节奏共 ${time}"
      startNow: "立即开始"
      poseOf: (i, n) => "第 ${i} 个体式，共 ${n} 个"
      voiceOn: "语音开"; voiceOff: "语音关"
      nextPose: "下一个体式"; paused: "已暂停"; readyNext: "准备下一个体式…"
      firstSide: "第一侧"; secondSide: "第二侧"; lastPose: "最后一个体式"
      quitAsk: "退出本次课程？"; keepGoing: "继续练习"; quit: "退出"
      resume: "继续"; pause: "暂停"; skip: "跳过"
      greatJob: "做得好"
      levelUp: (n, rank) => "${n} 级：${rank}"
      xpHint: "每天第一次练习才会获得 xp"
      done: "完成"; again: "再来一次"
      poseText: [
        {name: "船式", translation: "nāva = 船, āsana = 体式", description: "坐下，双腿伸直。呼气，双腿抬至 45 度，上身稍向后倾。双臂向前伸直，掌心相对。用坐骨保持平衡，收紧核心。目视脚尖，保持呼吸。", benefits: "强化腹部、髋屈肌和脊柱。刺激肾脏、甲状腺、前列腺和肠道。帮助缓解压力。促进消化。"},
        {name: "半船式", translation: "ardha = 半, nāva = 船, āsana = 体式", description: "坐下，屈膝，双脚离地。上身稍向后倾，双手抱住大腿后侧或向前伸直。保持平衡，收紧核心，目视前方，保持呼吸。", benefits: "强化腹部、髋屈肌和脊柱。刺激肾脏、甲状腺、前列腺和肠道。帮助缓解压力。促进消化。"},
        {name: "弓式", translation: "dhanur = 弓, āsana = 体式", description: "俯卧。屈膝，双手抓住脚踝。吸气，抬起胸部和大腿，双脚向后蹬手。目视前方，保持呼吸。", benefits: "伸展整个身体前侧：脚踝、大腿和腹股沟、腹部和胸部、喉部，以及深层髋屈肌（腰大肌）。强化背部肌肉。改善体态。刺激腹部和颈部器官。"},
        {name: "桥式", translation: "setu = 桥, bandha = 锁, sarva = 全部, āṅga = 肢体, āsana = 体式", description: "仰卧，屈膝，双脚与髋同宽。吸气，抬起臀部，双手在背后十指相扣。双肩向内收，抬起胸部。目视上方，保持呼吸。", benefits: "伸展胸部、颈部和脊柱。刺激腹部器官、肺部和甲状腺。让疲惫的双腿恢复活力。促进消化。帮助缓解更年期症状。在辅具支撑下练习可缓解经期不适。减轻焦虑、疲劳、背痛、头痛和失眠。对哮喘、高血压、骨质疏松和鼻窦炎有辅助疗效。"},
        {name: "蝴蝶式", translation: "baddha = 束缚, koṇa = 角, āsana = 体式", description: "坐下，脚掌相对，双膝向两侧打开。双手抓住双脚，坐直。放松双肩，深呼吸。", benefits: "打开髋部和腹股沟。伸展肩部、胸廓和背部。刺激腹部器官、肺部和心脏。"},
        {name: "骆驼式", translation: "uṣṭra = 骆驼, āsana = 体式", description: "跪立，双手扶住下背部。吸气，抬起胸部，感觉舒适时双手向后够脚跟。颈部保持中立，目视前方，保持呼吸。", benefits: "伸展整个身体前侧：脚踝、大腿和腹股沟、腹部和胸部，以及喉部。伸展深层髋屈肌（腰大肌）。强化背部肌肉。改善体态。刺激腹部和颈部器官。"},
        {name: "猫式", translation: "marjarya = 猫, āsana = 体式", description: "四肢着地。呼气，脊柱向上拱起，收下巴。收紧核心，目视腹部，保持呼吸。", benefits: "放松脊柱和颈部。为身体注入活力。"},
        {name: "牛式", translation: "bitil = 牛, āsana = 体式", description: "四肢着地。吸气，脊柱向下沉，抬起尾骨和胸部。目视上方，保持呼吸。", benefits: "消除疲劳。改善呼吸和大脑供血。让全身恢复活力。"},
        {name: "幻椅式", translation: "utkaṭa = 猛烈, āsana = 体式", description: "站立，双脚并拢。吸气，屈膝如同坐下，双臂举过头顶。重心放在脚跟，目视前方，保持呼吸。", benefits: "强化脚踝、大腿、小腿和脊柱。伸展肩部和胸部。刺激腹部器官、横膈膜和心脏。改善扁平足。为全身注入活力。"},
        {name: "婴儿式", translation: "bala = 孩子, āsana = 体式", description: "跪下，脚趾并拢，双膝分开。呼气，上身向前折叠，双臂向前伸直。额头贴垫，放松，保持呼吸。", benefits: "温和地伸展髋部、大腿和脚踝。让大脑平静，帮助缓解压力和疲劳。在头部和躯干有支撑时练习，可缓解背痛和颈痛。"},
        {name: "摊尸式", translation: "śava = 尸体, āsana = 体式", description: "仰卧，双腿伸直，双臂放在体侧，掌心向上。闭上眼睛，完全放松，深呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。放松身体。减轻头痛、疲劳和失眠。帮助降低血压。"},
        {name: "新月弓步式", translation: "ashta = 侧, chandra = 月亮, āsana = 体式", description: "一只脚向前迈步，成弓步。后膝着地或抬起。吸气，双臂举过头顶。臀部下沉，目视前方，保持呼吸。", benefits: "伸展胸廓、手臂和躯干。紧致腹斜肌。"},
        {name: "乌鸦式", translation: "baka = 鹤, āsana = 体式", description: "蹲下，双手撑垫，与肩同宽。双膝放在上臂上。呼气，身体前移，双脚离地。保持平衡，目视前方，保持呼吸。", benefits: "强化手臂和手腕。伸展上背部。强化腹肌。打开腹股沟。紧致腹部器官。"},
        {name: "海豚式", translation: "pīñcha = 羽毛, mayūra = 孔雀, āsana = 体式", description: "从下犬式开始，前臂着地，手肘在肩膀正下方。抬起臀部，脚跟向下压。收紧核心，目视双手之间，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。为身体注入活力。伸展肩部、腘绳肌、小腿、足弓和双手。强化手臂和双腿。帮助缓解更年期症状。头部有支撑时练习可缓解经期不适。帮助预防骨质疏松。促进消化。缓解头痛、失眠、背痛和疲劳。对高血压、哮喘、扁平足、坐骨神经痛和鼻窦炎有辅助疗效。活动脚踝和脚趾。"},
        {name: "下犬式", translation: "parivṛtta = 扭转, adho = 向下, mukha = 面朝, śvāna = 狗, āsana = 体式", description: "四肢着地。呼气，臀部向上向后抬起。伸直双腿，脚跟向下压。延展脊柱，目视双腿之间，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。为身体注入活力。伸展肩部、颈部、腘绳肌、小腿、足弓和双手。强化手臂和双腿。帮助缓解更年期症状。头部有支撑时练习可缓解经期不适。帮助预防骨质疏松。促进消化。缓解头痛、失眠、背痛和疲劳。对高血压、哮喘、扁平足、坐骨神经痛和鼻窦炎有辅助疗效。"},
        {name: "鹰式", translation: "garuḍa = 鹰, āsana = 体式", description: "站立，右腿交叉搭在左腿上，右脚勾住左小腿后侧。左臂交叉搭在右臂上，双掌相贴。抬起手肘，目视前方，保持呼吸。", benefits: "强化并伸展脚踝和小腿。伸展大腿、髋部、肩部和上背部。提高专注力。增强平衡感。"},
        {name: "站立手抓大脚趾式", translation: "utthita = 伸展, hasta = 手, pādāṅguṣṭha = 大脚趾, āsana = 体式", description: "站立，抬起右腿，用右手抓住右脚大脚趾。右腿向前伸直，髋部摆正。目视前方，保持呼吸。", benefits: "打开髋部和腹股沟。伸展腘绳肌、髂胫束和双腿。增强平衡。"},
        {name: "侧角伸展式", translation: "utthita = 伸展, pārśva = 侧, koṇa = 角, āsana = 体式", description: "从战士二式开始，前膝再屈深一些。前侧手臂经头顶伸展，后侧手放在腿上或地面。打开胸部，目视上方，保持呼吸。", benefits: "强化并伸展双腿、膝盖和脚踝。伸展腹股沟、脊柱、腰部、胸部、肺部和肩部。刺激腹部器官。增强耐力。"},
        {name: "前臂倒立", translation: "pīñcha = 羽毛, mayūra = 孔雀, āsana = 体式", description: "从海豚式开始，双脚向前走近。呼气，双腿依次抬起，用前臂保持平衡。收紧核心，目视前方，保持呼吸。", benefits: "强化手臂和肩部。提高专注力和平衡感。伸展上背部和下背部。强化腹肌。紧致腹部。"},
        {name: "前屈开肩式", translation: "uttāna = 强烈伸展, āsana = 体式", description: "站立，上身向前折叠，双手在背后十指相扣。双臂轻轻抬起，头部放松。目视下方，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。刺激肝脏和肾脏。伸展腘绳肌、小腿和髋部。强化大腿和膝盖。促进消化。帮助缓解更年期症状。减轻疲劳和焦虑。缓解头痛和失眠。打开肩部。"},
        {name: "半月式", translation: "ardha = 半, chandra = 月亮, āsana = 体式", description: "从战士三式开始，一只手放在前脚旁的地面上。后腿抬至与地面平行，另一只手臂向上伸展。打开髋部，目视上方或下方，保持呼吸。", benefits: "强化腹部、脚踝、大腿、臀部和脊柱。伸展腹股沟、腘绳肌、小腿、肩部、胸部和脊柱。改善协调性和平衡感。帮助缓解压力。促进消化。"},
        {name: "手倒立", translation: "adho = 向下, mukha = 面朝, vṛkṣa = 树, āsana = 体式", description: "从下犬式开始，双脚向前走近。转移重心，双腿向上踢起并伸直。收紧核心，目视前方，保持呼吸。", benefits: "强化肩部、手臂和手腕。伸展腹部。增强平衡感。让大脑平静，帮助缓解压力和轻度抑郁。"},
        {name: "低位新月式", translation: "aṅjaneya = 赞颂, āsana = 体式", description: "右脚向前迈步，成弓步。左膝着地，双手放在大腿上或举过头顶。臀部下沉，目视前方，保持呼吸。", benefits: "伸展胸部、肺部、颈部、腹部和腹股沟（腰大肌）。强化肩部、手臂和背部肌肉。强化并伸展大腿、小腿和脚踝。"},
        {name: "鸽子式", translation: "supta = 仰卧, kapota = 鸽子, āsana = 体式", description: "仰卧，右脚踝搭在左膝上。将左膝拉向胸部。背部贴地，目视上方，保持呼吸。", benefits: "伸展腘绳肌和股四头肌。如果用手肘推大腿，还能打开髋部。"},
        {name: "鸽王式", translation: "eka = 一, pāda = 脚或腿, rāja = 王, kapota = 鸽子, āsana = 体式", description: "从鸽子式开始，后膝弯曲，用手抓住后脚。抬起胸部，打开心胸。目视前方，保持呼吸。", benefits: "伸展大腿、腹股沟（腰大肌）、腹部、胸部、肩部和颈部。刺激腹部器官。打开肩部和胸部。"},
        {name: "平板式", translation: "phalaka = 木板, āsana = 体式", description: "四肢着地，双脚向后迈。身体成一条直线，双手在肩膀正下方。收紧核心，目视下方，保持呼吸。", benefits: "强化手臂、手腕和脊柱。紧致腹部。"},
        {name: "犁式", translation: "hala = 犁, āsana = 体式", description: "仰卧。呼气，双腿越过头顶，脚尖在头后点地。双手扶住背部或十指相扣。目光向内，保持呼吸。", benefits: "让大脑平静。刺激腹部器官和甲状腺。伸展肩部和脊柱。帮助缓解更年期症状。减轻压力和疲劳。对背痛、头痛、不孕、失眠和鼻窦炎有辅助疗效。"},
        {name: "金字塔式", translation: "pārśva = 侧, uttāna = 强烈伸展, āsana = 体式", description: "右脚在前，左脚在后。从髋部折叠，上身前屈至前腿上方。双手放在地面或瑜伽砖上。目视下方，保持呼吸。", benefits: "让大脑平静。伸展脊柱、肩部、髋部和腘绳肌。强化双腿。刺激腹部器官。改善体态和平衡感。促进消化。"},
        {name: "反转战士式", translation: "pārśva = 侧, vīrabhadra = 战士, āsana = 体式", description: "从战士二式开始，前侧手臂经头顶向后伸展。后侧手沿腿向下滑。打开胸部，目视上方，保持呼吸。", benefits: "强化并伸展双腿、膝盖和脚踝。伸展腹股沟、脊柱、腰部、胸部、肺部和肩部。刺激腹部器官。增强耐力。缓解背痛，尤其是孕中期。对腕管综合征、扁平足、不孕、骨质疏松和坐骨神经痛有辅助疗效。"},
        {name: "坐立前屈式", translation: "paśchima = 背部, uttāna = 强烈伸展, āsana = 体式", description: "坐下，双腿伸直。吸气，延展脊柱。呼气，上身向前折叠，双手够双脚或小腿。保持脊柱延长，目视前方，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。伸展脊柱、肩部和腘绳肌。刺激肝脏、肾脏、卵巢和子宫。促进消化。帮助缓解更年期症状和经期不适。舒缓头痛和焦虑。减轻疲劳。对高血压、不孕、失眠和鼻窦炎有辅助疗效。传统典籍记载，Paschimottanasana 能增进食欲、减轻肥胖并治愈疾病。"},
        {name: "莲花式", translation: "padma = 莲花, āsana = 体式", description: "坐下，右脚放在左大腿上，左脚放在右大腿上。双手放在膝盖上，坐直，保持呼吸。", benefits: "打开髋部和腹股沟，伸展膝盖、脚踝和大腿。强化背部，让心神平静，减轻压力和焦虑。改善骨盆的血液循环。"},
        {name: "半鱼王式", translation: "ardha = 半, matsya = 鱼, indra = 王", description: "坐下，右膝交叉跨过左腿，向右扭转。左肘抵在右膝外侧，右手放在身后。目光越过肩膀，保持呼吸。", benefits: "伸展肩部、胸部、大腿、腹股沟和腹部。强化双腿和脚踝。增强平衡。"},
        {name: "肩倒立", translation: "sa = 带有, ālamba = 支撑, sarvāṅga = 全身, āsana = 体式", description: "仰卧。呼气，抬起双腿和臀部，双手扶住背部。伸直双腿，目光向内，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。刺激甲状腺、前列腺和腹部器官。伸展肩部和颈部。紧致双腿和臀部。促进消化。帮助缓解更年期症状。减轻疲劳，改善失眠。对哮喘、不孕和鼻窦炎有辅助疗效。"},
        {name: "侧板式", translation: "vasiṣṭha = 一位圣人的名字, āsana = 体式", description: "从平板式开始，转到右脚外侧。双脚叠放，左臂向上举起。收紧核心，目视上方，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。伸展肩部、腘绳肌、小腿和足弓。强化手臂和双腿。帮助缓解更年期症状。帮助预防骨质疏松。促进消化。缓解头痛、失眠、背痛和疲劳。对高血压、哮喘、扁平足和坐骨神经痛有辅助疗效。"},
        {name: "狮身人面式", translation: "sālamba = 有支撑的, bhujaṅga = 蛇, āsana = 体式", description: "俯卧，前臂贴垫，手肘在肩膀正下方。吸气，抬起胸部，双肩下沉。目视前方，保持呼吸。", benefits: "强化脊柱。伸展胸部、肺部、肩部和腹部。刺激腹部器官。打开心胸和肺部。"},
        {name: "神猴哈努曼式", translation: "hanumān = 猴神, āsana = 体式", description: "从弓步开始，前脚向前滑，后脚向后滑。臀部下沉，保持摆正。双手放在地面或瑜伽砖上。目视前方，保持呼吸。", benefits: "伸展大腿、腘绳肌和腹股沟。刺激腹部器官。"},
        {name: "花环式", translation: "mālā = 花环或项链, āsana = 体式", description: "蹲下，双脚并拢或分开。手肘在双膝内侧，双手在胸前合十。双膝向外推，臀部下沉，目视前方，保持呼吸。", benefits: "伸展脚踝、腹股沟和背部。紧致腹部。"},
        {name: "站立前屈式", translation: "uttāna = 强烈伸展, āsana = 体式", description: "站立，上身向前折叠，双手放在地面或小腿上。保持脊柱延长，头部自然下垂。目视下方，保持呼吸。", benefits: "让大脑平静，帮助缓解压力和轻度抑郁。刺激肝脏和肾脏。伸展腘绳肌、小腿和髋部。强化大腿和膝盖。促进消化。帮助缓解更年期症状。减轻疲劳和焦虑。缓解头痛和失眠。"},
        {name: "站立新月式", translation: "ashta = 侧, chandra = 月亮, āsana = 体式", description: "站立，双手在头顶上方十指相扣。吸气，身体向一侧弯曲，伸展另一侧。目视上方，保持呼吸。", benefits: "伸展胸廓、手臂和躯干。紧致腹斜肌。"},
        {name: "坐角式", translation: "upaviṣṭha = 坐着的, koṇa = 角, āsana = 体式", description: "坐下，双腿大大分开。呼气，双手向前走，上身下沉。保持脊柱延长，目视下方，保持呼吸。", benefits: "伸展双腿内侧和后侧。刺激腹部器官。强化脊柱。让大脑平静。放松腹股沟。"},
        {name: "树式", translation: "vṛkṣa = 树, āsana = 体式", description: "站立，右脚放在左大腿内侧或小腿上。双手在头顶或胸前合十。保持平衡，目视前方，保持呼吸。", benefits: "强化双腿、脚踝和双脚。提高髋部和膝盖的灵活性。增强平衡。"},
        {name: "三角式", translation: "trikoṇa = 三角, āsana = 体式", description: "双脚大大分开站立，右脚向外转。右手向下够小腿或地面，左臂向上伸展。打开胸部，目视上方，保持呼吸。", benefits: "伸展并强化大腿、膝盖和脚踝。伸展髋部、腹股沟、腘绳肌、小腿、肩部、胸部和脊柱。刺激腹部器官。帮助缓解压力。促进消化。帮助缓解更年期症状。缓解背痛，尤其是孕中期。对焦虑、扁平足、不孕、颈痛、骨质疏松和坐骨神经痛有辅助疗效。"},
        {name: "上犬式", translation: "ūrdhva = 向上, mukha = 面朝, śvāna = 狗, āsana = 体式", description: "俯卧，双手放在肩膀两侧。吸气，抬起胸部和大腿，双肩向后转。目视前方，保持呼吸。", benefits: "改善体态。强化脊柱、手臂和手腕。伸展胸部、肺部、肩部和腹部。紧致臀部。刺激腹部器官。帮助缓解轻度抑郁、疲劳和坐骨神经痛。对哮喘有辅助疗效。"},
        {name: "战士一式", translation: "vīrabhadra = 战士, āsana = 体式", description: "左脚向后迈步，右膝弯曲至 90 度。双臂举过头顶，臀部下沉。目视前方，保持呼吸。", benefits: "伸展胸部、肺部、肩部、颈部、腹部和腹股沟（腰大肌）。强化肩部、手臂和背部肌肉。强化并伸展大腿、小腿和脚踝。"},
        {name: "战士二式", translation: "vīrabhadra = 战士, āsana = 体式", description: "左脚向后迈步，右膝弯曲至 90 度。双臂平举，臀部下沉。目光越过右手，保持呼吸。", benefits: "强化并伸展双腿和脚踝。伸展腹股沟、胸部、肺部和肩部。刺激腹部器官。增强耐力。缓解背痛，尤其是孕中期。对腕管综合征、扁平足、不孕、骨质疏松和坐骨神经痛有辅助疗效。"},
        {name: "战士三式", translation: "vīrabhadra = 战士, āsana = 体式", description: "站立，重心移到右腿。左腿向后抬至与地面平行，双臂向前或向两侧伸展。保持平衡，目视下方，保持呼吸。", benefits: "强化脚踝和双腿。强化肩部和背部肌肉。紧致腹部。增强平衡，改善体态。"},
        {name: "轮式", translation: "ūrdhva = 向上, dhanu = 弓, āsana = 体式", description: "仰卧，屈膝，双手放在耳朵两侧。呼气，抬起臀部和胸部，形成拱形。目视上方，平稳呼吸。", benefits: "强化手臂、手腕、双腿、臀部、腹肌和脊柱。刺激甲状腺和脑垂体。提升精力，帮助对抗抑郁，对哮喘、背痛、不孕和骨质疏松有辅助疗效。"},
        {name: "狂野式", translation: "camatkāra = 惊叹不已, āsana = 体式", description: "从下犬式开始，抬起右腿，打开髋部。右手放在前脚旁，抬起左臂，背部拱起，目视上方，深呼吸。", benefits: "伸展胸部、肩部、背部和喉部。强化并打开髋部、髋屈肌和大腿。"}
      ]
      sessionText: [
        {name: "温和入门流", description: "一套舒缓的入门序列，通过基础体式和呼吸练习，轻松走进瑜伽。"},
        {name: "晨起唤醒", description: "一套适合初学者的序列，唤醒并伸展身体，迎接新的一天。"},
        {name: "放松基础", description: "一套平静的入门序列，用温和的体式放松身心、恢复状态。"},
        {name: "平衡基础", description: "一套入门序列，通过站立和坐立体式培养平衡与力量。"},
        {name: "核心与伸展", description: "一套入门序列，用简单的体式强化核心、提高柔韧性。"},
        {name: "中级核心力量", description: "一套有活力的中级序列，提升核心稳定性和力量。"},
        {name: "开髋流", description: "一套中级序列，深度伸展并打开髋部，获得更好的柔韧性。"},
        {name: "扭转焕活", description: "一套中级扭转序列，帮助排毒、提升精力。"},
        {name: "平衡挑战", description: "一套中级序列，通过站立体式增强平衡与协调。"},
        {name: "活力流", description: "一套高能量的中级流，通过动态衔接培养耐力和力量。"},
        {name: "开心序列", description: "一套中级序列，通过后弯打开胸部、强化背部。"},
        {name: "核心与稳定", description: "一套中级序列，结合核心练习和平衡体式，全面提升稳定性。"},
        {name: "坐姿柔韧", description: "一套中级坐姿序列，加深髋部和腘绳肌的柔韧性。"},
        {name: "战士力量", description: "一套以战士式为主的中级序列，培养力量与自信。"},
        {name: "活力与平衡", description: "一套充满活力的中级序列，提升元气、增强平衡。"},
        {name: "高阶核心强化", description: "一套高阶序列，用富有挑战的体式集中强化核心力量。"},
        {name: "倒立探索", description: "一套高阶序列，掌握倒立，培养力量和控制力。"},
        {name: "极限柔韧", description: "一套高阶序列，通过深度伸展和劈叉突破柔韧极限。"},
        {name: "手臂平衡精通", description: "一套以手臂平衡为主的高阶序列，强化上半身。"},
        {name: "深度后弯", description: "一套高阶序列，加深后弯，打开胸部和脊柱。"},
        {name: "终极流", description: "一套全面的高阶流，融合力量、平衡与柔韧。"},
        {name: "精准与力量", description: "一套高阶序列，注重精准的身体对位和有力的体式。"},
        {name: "开髋开心强化", description: "一套高阶序列，深度打开髋部和心胸，提升柔韧性，释放情绪。"},
        {name: "力量与控制", description: "一套高阶序列，用富有挑战的体式培养力量和控制力。"},
        {name: "瑜伽精通", description: "一套高阶序列，为有经验的习练者挑战力量、平衡与柔韧。"},
        {name: "入门喜悦流", description: "一套全面的入门序列，从热身、站立力量和平衡体式，到温和后弯、前屈、开髋和修复体式，流畅衔接，打下全面扎实的基础。"}
      ]
    }
    ru {
      title: "йога"
      sessions: "занятия"; poses: "позы"
      levels: {beginner: "начальный", intermediate: "средний", advanced: "продвинутый"}
      ranks: {novice: "новичок", practitioner: "практик", adept: "адепт", devotee: "подвижник", teacher: "учитель", master: "мастер"}
      paces: {swift: "быстро", balanced: "размеренно", endurance: "долго"}
      levelRank: (n, rank) => "уровень ${n} · ${rank}"
      streak: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "день подряд" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "дня подряд" : "дней подряд")
      xpLine: (xp, need, next) => "${xp} xp · ещё ${need} до уровня ${next}"
      completed: "готово"
      sessionLine: (level, n, time) => "${level} · ${n} " + (n % 10 == 1 && n % 100 != 11 ? "поза" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "позы" : "поз") + " · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · удержание ${time} · обе стороны" : "${level} · удержание ${time}"
      how: "техника"; benefits: "польза"; inSessions: "в занятиях"
      startArrow: "начать ›"
      getReady: "приготовьтесь"
      first: name => "первая: ${name}"
      introLine: (n, time) => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "поза" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "позы" : "поз") + " · ${time} в этом темпе"
      startNow: "начать сейчас"
      poseOf: (i, n) => "поза ${i} из ${n}"
      voiceOn: "голос вкл."; voiceOff: "голос выкл."
      nextPose: "следующая поза"; paused: "пауза"; readyNext: "приготовьтесь к следующей позе…"
      firstSide: "первая сторона"; secondSide: "вторая сторона"; lastPose: "последняя поза"
      quitAsk: "завершить занятие?"; keepGoing: "продолжить"; quit: "выйти"
      resume: "продолжить"; pause: "пауза"; skip: "пропустить"
      greatJob: "отлично"
      levelUp: (n, rank) => "уровень ${n}: ${rank}"
      xpHint: "xp начисляются за первое занятие дня"
      done: "готово"; again: "ещё раз"
      poseText: [
        {name: "Поза лодки", translation: "nāva = лодка, āsana = поза", description: "Сядьте, вытянув ноги. На выдохе поднимите ноги под углом 45 градусов, слегка отклонитесь назад. Вытяните руки вперёд, ладони друг к другу. Балансируйте на седалищных костях, включите пресс. Смотрите на пальцы ног, дышите.", benefits: "Укрепляет пресс, сгибатели бедра и позвоночник. Стимулирует почки, щитовидную и предстательную железы, кишечник. Помогает снять стресс. Улучшает пищеварение."},
        {name: "Поза полулодки", translation: "ardha = половина, nāva = лодка, āsana = поза", description: "Сядьте, согните колени, оторвите стопы от пола. Слегка отклонитесь назад, держитесь за бёдра сзади или вытяните руки. Балансируйте, включите пресс, смотрите вперёд, дышите.", benefits: "Укрепляет пресс, сгибатели бедра и позвоночник. Стимулирует почки, щитовидную и предстательную железы, кишечник. Помогает снять стресс. Улучшает пищеварение."},
        {name: "Поза лука", translation: "dhanur = лук, āsana = поза", description: "Лягте на живот. Согните колени, возьмитесь за щиколотки. На вдохе поднимите грудь и бёдра, давите стопами в ладони. Смотрите вперёд, дышите.", benefits: "Растягивает всю переднюю поверхность тела: щиколотки, бёдра и пах, живот и грудь, горло и глубокие сгибатели бедра (поясничную мышцу). Укрепляет мышцы спины. Улучшает осанку. Стимулирует органы живота и шеи."},
        {name: "Поза моста", translation: "setu = мост, bandha = замок, sarva = все, āṅga = конечность, āsana = поза", description: "Лягте на спину, согните колени, стопы на ширине бёдер. На вдохе поднимите таз, сцепите руки под спиной. Сведите лопатки, поднимите грудь. Смотрите вверх, дышите.", benefits: "Растягивает грудь, шею и позвоночник. Стимулирует органы живота, лёгкие и щитовидную железу. Восстанавливает уставшие ноги. Улучшает пищеварение. Облегчает симптомы менопаузы. С опорой облегчает менструальный дискомфорт. Уменьшает тревогу, усталость, боль в спине, головную боль и бессонницу. Полезна при астме, высоком давлении, остеопорозе и синусите."},
        {name: "Поза бабочки", translation: "baddha = связанный, koṇa = угол, āsana = поза", description: "Сядьте, соедините стопы, разведите колени в стороны. Держитесь за стопы, выпрямите спину. Расслабьте плечи, дышите глубоко.", benefits: "Раскрывает тазобедренные суставы и пах. Растягивает плечи, грудную клетку и спину. Стимулирует органы живота, лёгкие и сердце."},
        {name: "Поза верблюда", translation: "uṣṭra = верблюд, āsana = поза", description: "Встаньте на колени, ладони на поясницу. На вдохе поднимите грудь, если удобно, дотянитесь до пяток. Держите шею нейтрально, смотрите вперёд, дышите.", benefits: "Растягивает всю переднюю поверхность тела: щиколотки, бёдра и пах, живот и грудь, горло. Растягивает глубокие сгибатели бедра (поясничную мышцу). Укрепляет мышцы спины. Улучшает осанку. Стимулирует органы живота и шеи."},
        {name: "Поза кошки", translation: "marjarya = кошка, āsana = поза", description: "Встаньте на четвереньки. На выдохе округлите спину вверх, подбородок к груди. Включите пресс, смотрите на живот, дышите.", benefits: "Разгружает позвоночник и шею. Придаёт телу энергию."},
        {name: "Поза коровы", translation: "bitil = корова, āsana = поза", description: "Встаньте на четвереньки. На вдохе прогните спину вниз, поднимите копчик и грудь. Смотрите вверх, дышите.", benefits: "Снимает усталость. Улучшает дыхание и кровоснабжение мозга. Омолаживает всё тело."},
        {name: "Поза стула", translation: "utkaṭa = грозный, āsana = поза", description: "Встаньте, стопы вместе. На вдохе согните колени, будто садитесь, поднимите руки над головой. Вес на пятках, смотрите вперёд, дышите.", benefits: "Укрепляет щиколотки, бёдра, икры и позвоночник. Растягивает плечи и грудь. Стимулирует органы живота, диафрагму и сердце. Помогает при плоскостопии. Придаёт энергию всему телу."},
        {name: "Поза ребёнка", translation: "bala = ребёнок, āsana = поза", description: "Встаньте на колени, большие пальцы ног вместе, колени врозь. На выдохе наклонитесь вперёд, вытяните руки. Лоб на коврик, расслабьтесь, дышите.", benefits: "Мягко растягивает тазобедренные суставы, бёдра и щиколотки. Успокаивает ум, помогает снять стресс и усталость. С опорой под голову и корпус снимает боль в спине и шее."},
        {name: "Поза трупа", translation: "śava = труп, āsana = поза", description: "Лягте на спину, ноги вытянуты, руки вдоль тела ладонями вверх. Закройте глаза, полностью расслабьтесь, дышите глубоко.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Расслабляет тело. Уменьшает головную боль, усталость и бессонницу. Помогает снизить давление."},
        {name: "Выпад полумесяцем", translation: "ashta = сторона, chandra = луна, āsana = поза", description: "Шагните одной ногой вперёд в выпад. Заднее колено на полу или на весу. На вдохе поднимите руки над головой. Опустите таз, смотрите вперёд, дышите.", benefits: "Растягивает грудную клетку, руки и корпус. Тонизирует косые мышцы живота."},
        {name: "Поза вороны", translation: "baka = журавль, āsana = поза", description: "Присядьте, ладони на коврик на ширине плеч. Колени на плечи. На выдохе подайтесь вперёд, оторвите стопы от пола. Балансируйте, смотрите вперёд, дышите.", benefits: "Укрепляет руки и запястья. Растягивает верх спины. Укрепляет мышцы живота. Раскрывает пах. Тонизирует органы живота."},
        {name: "Поза дельфина", translation: "pīñcha = перо, mayūra = павлин, āsana = поза", description: "Из собаки мордой вниз опуститесь на предплечья, локти под плечами. Поднимите таз, тяните пятки к полу. Включите пресс, смотрите между ладонями, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Придаёт телу энергию. Растягивает плечи, заднюю поверхность бедра, икры, своды стоп и кисти. Укрепляет руки и ноги. Облегчает симптомы менопаузы. С опорой под голову облегчает менструальный дискомфорт. Помогает предотвратить остеопороз. Улучшает пищеварение. Снимает головную боль, бессонницу, боль в спине и усталость. Полезна при высоком давлении, астме, плоскостопии, ишиасе и синусите. Разогревает щиколотки и пальцы ног."},
        {name: "Собака мордой вниз", translation: "parivṛtta = повёрнутый, adho = вниз, mukha = лицом, śvāna = собака, āsana = поза", description: "Встаньте на четвереньки. На выдохе поднимите таз вверх и назад. Выпрямите ноги, тяните пятки к полу. Вытяните позвоночник, смотрите между ногами, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Придаёт телу энергию. Растягивает плечи, шею, заднюю поверхность бедра, икры, своды стоп и кисти. Укрепляет руки и ноги. Облегчает симптомы менопаузы. С опорой под голову облегчает менструальный дискомфорт. Помогает предотвратить остеопороз. Улучшает пищеварение. Снимает головную боль, бессонницу, боль в спине и усталость. Полезна при высоком давлении, астме, плоскостопии, ишиасе и синусите."},
        {name: "Поза орла", translation: "garuḍa = орёл, āsana = поза", description: "Встаньте, положите правую ногу на левую, заведите стопу за икру. Положите левую руку на правую, соедините ладони. Поднимите локти, смотрите вперёд, дышите.", benefits: "Укрепляет и растягивает щиколотки и икры. Растягивает бёдра, тазобедренные суставы, плечи и верх спины. Улучшает концентрацию. Развивает чувство равновесия."},
        {name: "Рука к большому пальцу ноги", translation: "utthita = вытянутый, hasta = рука, pādāṅguṣṭha = большой палец ноги, āsana = поза", description: "Встаньте, поднимите правую ногу, возьмитесь правой рукой за большой палец. Вытяните ногу вперёд, таз ровно. Смотрите вперёд, дышите.", benefits: "Раскрывает тазобедренные суставы и пах. Растягивает заднюю поверхность бедра, илиотибиальный тракт и ноги. Улучшает равновесие."},
        {name: "Поза вытянутого бокового угла", translation: "utthita = вытянутый, pārśva = бок, koṇa = угол, āsana = поза", description: "Из воина II глубже согните переднее колено. Вытяните верхнюю руку над головой, нижнюю ладонь на ногу или на пол. Раскройте грудь, смотрите вверх, дышите.", benefits: "Укрепляет и растягивает ноги, колени и щиколотки. Растягивает пах, позвоночник, талию, грудь, лёгкие и плечи. Стимулирует органы живота. Повышает выносливость."},
        {name: "Стойка на предплечьях", translation: "pīñcha = перо, mayūra = павлин, āsana = поза", description: "Из позы дельфина подойдите стопами ближе. На выдохе поднимите ноги по одной, балансируйте на предплечьях. Включите пресс, смотрите вперёд, дышите.", benefits: "Укрепляет руки и плечи. Улучшает концентрацию и равновесие. Растягивает верх и низ спины. Укрепляет мышцы живота. Тонизирует область живота."},
        {name: "Наклон вперёд с замком за спиной", translation: "uttāna = вытяжение, āsana = поза", description: "Встаньте, наклонитесь вперёд, сцепите руки за спиной. Мягко поднимите руки, расслабьте голову. Смотрите вниз, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Стимулирует печень и почки. Растягивает заднюю поверхность бедра, икры и тазобедренные суставы. Укрепляет бёдра и колени. Улучшает пищеварение. Облегчает симптомы менопаузы. Уменьшает усталость и тревогу. Снимает головную боль и бессонницу. Раскрывает плечи."},
        {name: "Поза полулуны", translation: "ardha = половина, chandra = луна, āsana = поза", description: "Из воина III опустите ладонь на пол рядом с передней стопой. Поднимите заднюю ногу параллельно полу, вытяните другую руку вверх. Раскройте таз, смотрите вверх или вниз, дышите.", benefits: "Укрепляет пресс, щиколотки, бёдра, ягодицы и позвоночник. Растягивает пах, заднюю поверхность бедра, икры, плечи, грудь и позвоночник. Улучшает координацию и чувство равновесия. Помогает снять стресс. Улучшает пищеварение."},
        {name: "Стойка на руках", translation: "adho = вниз, mukha = лицом, vṛkṣa = дерево, āsana = поза", description: "Из собаки мордой вниз подойдите стопами ближе. Перенесите вес, толчком поднимите ноги, выпрямите их. Включите пресс, смотрите вперёд, дышите.", benefits: "Укрепляет плечи, руки и запястья. Растягивает живот. Развивает чувство равновесия. Успокаивает ум, помогает снять стресс и лёгкую депрессию."},
        {name: "Низкий выпад", translation: "aṅjaneya = хвала, āsana = поза", description: "Шагните правой ногой вперёд в выпад. Опустите левое колено, руки на бедро или над головой. Опустите таз, смотрите вперёд, дышите.", benefits: "Растягивает грудь, лёгкие, шею, живот и пах (поясничную мышцу). Укрепляет плечи, руки и мышцы спины. Укрепляет и растягивает бёдра, икры и щиколотки."},
        {name: "Поза голубя", translation: "supta = лёжа на спине, kapota = голубь, āsana = поза", description: "Лягте на спину, положите правую щиколотку на левое колено. Подтяните левое колено к груди. Спина прижата к полу, смотрите вверх, дышите.", benefits: "Растягивает заднюю и переднюю поверхность бедра. Если давить локтем на бедро, раскрывает и тазобедренные суставы."},
        {name: "Поза царя голубей", translation: "eka = один, pāda = стопа или нога, rāja = царь, kapota = голубь, āsana = поза", description: "Из позы голубя согните заднее колено, возьмитесь рукой за стопу. Поднимите грудь, раскройте сердце. Смотрите вперёд, дышите.", benefits: "Растягивает бёдра, пах (поясничную мышцу), живот, грудь, плечи и шею. Стимулирует органы живота. Раскрывает плечи и грудь."},
        {name: "Планка", translation: "phalaka = доска, āsana = поза", description: "Из положения на четвереньках шагните ногами назад. Тело прямое, ладони под плечами. Включите пресс, смотрите вниз, дышите.", benefits: "Укрепляет руки, запястья и позвоночник. Тонизирует живот."},
        {name: "Поза плуга", translation: "hala = плуг, āsana = поза", description: "Лягте на спину. На выдохе заведите ноги за голову, пальцы ног на пол. Поддерживайте спину руками или сцепите их. Взгляд внутрь, дышите.", benefits: "Успокаивает ум. Стимулирует органы живота и щитовидную железу. Растягивает плечи и позвоночник. Облегчает симптомы менопаузы. Уменьшает стресс и усталость. Полезна при боли в спине, головной боли, бесплодии, бессоннице и синусите."},
        {name: "Поза пирамиды", translation: "pārśva = бок, uttāna = вытяжение, āsana = поза", description: "Шагните правой ногой вперёд, левой назад. Наклонитесь от тазобедренных суставов к передней ноге. Ладони на пол или на блоки. Смотрите вниз, дышите.", benefits: "Успокаивает ум. Растягивает позвоночник, плечи, тазобедренные суставы и заднюю поверхность бедра. Укрепляет ноги. Стимулирует органы живота. Улучшает осанку и чувство равновесия. Улучшает пищеварение."},
        {name: "Обратный воин", translation: "pārśva = бок, vīrabhadra = воин, āsana = поза", description: "Из воина II вытяните переднюю руку вверх и назад. Скользите задней рукой вниз по ноге. Раскройте грудь, смотрите вверх, дышите.", benefits: "Укрепляет и растягивает ноги, колени и щиколотки. Растягивает пах, позвоночник, талию, грудь, лёгкие и плечи. Стимулирует органы живота. Повышает выносливость. Облегчает боль в спине, особенно во втором триместре беременности. Полезна при синдроме запястного канала, плоскостопии, бесплодии, остеопорозе и ишиасе."},
        {name: "Наклон вперёд сидя", translation: "paśchima = задний, uttāna = вытяжение, āsana = поза", description: "Сядьте, вытяните ноги. На вдохе вытяните позвоночник. На выдохе наклонитесь вперёд, дотянитесь до стоп или голеней. Спина длинная, смотрите вперёд, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Растягивает позвоночник, плечи и заднюю поверхность бедра. Стимулирует печень, почки, яичники и матку. Улучшает пищеварение. Облегчает симптомы менопаузы и менструальный дискомфорт. Смягчает головную боль и тревогу. Уменьшает усталость. Полезна при высоком давлении, бесплодии, бессоннице и синусите. Традиционные тексты говорят, что пашчимоттанасана усиливает аппетит, уменьшает ожирение и исцеляет болезни."},
        {name: "Поза лотоса", translation: "padma = лотос, āsana = поза", description: "Сядьте, положите правую стопу на левое бедро, левую на правое. Ладони на колени, спина прямая, дышите.", benefits: "Раскрывает тазобедренные суставы и пах, растягивает колени, щиколотки и бёдра. Укрепляет спину и успокаивает ум, уменьшает стресс и тревогу. Улучшает кровообращение в области таза."},
        {name: "Половинная поза царя рыб", translation: "ardha = половина, matsya = рыба, indra = царь", description: "Сядьте, перенесите правое колено через левое, повернитесь вправо. Левый локоть снаружи правого колена, правая рука сзади. Смотрите через плечо, дышите.", benefits: "Растягивает плечи, грудь, бёдра, пах и живот. Укрепляет ноги и щиколотки. Улучшает равновесие."},
        {name: "Стойка на плечах", translation: "sa = с, ālamba = опора, sarvāṅga = все конечности, āsana = поза", description: "Лягте на спину. На выдохе поднимите ноги и таз вверх, поддерживайте спину руками. Выпрямите ноги, взгляд внутрь, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Стимулирует щитовидную и предстательную железы и органы живота. Растягивает плечи и шею. Тонизирует ноги и ягодицы. Улучшает пищеварение. Облегчает симптомы менопаузы. Уменьшает усталость и бессонницу. Полезна при астме, бесплодии и синусите."},
        {name: "Боковая планка", translation: "vasiṣṭha = имя мудреца, āsana = поза", description: "Из планки перекатитесь на внешний край правой стопы. Поставьте стопы одна на другую, поднимите левую руку вверх. Включите пресс, смотрите вверх, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Растягивает плечи, заднюю поверхность бедра, икры и своды стоп. Укрепляет руки и ноги. Облегчает симптомы менопаузы. Помогает предотвратить остеопороз. Улучшает пищеварение. Снимает головную боль, бессонницу, боль в спине и усталость. Полезна при высоком давлении, астме, плоскостопии и ишиасе."},
        {name: "Поза сфинкса", translation: "sālamba = с опорой, bhujaṅga = змей, āsana = поза", description: "Лягте на живот, предплечья на коврик, локти под плечами. На вдохе поднимите грудь, опустите плечи. Смотрите вперёд, дышите.", benefits: "Укрепляет позвоночник. Растягивает грудь, лёгкие, плечи и живот. Стимулирует органы живота. Раскрывает сердце и лёгкие."},
        {name: "Шпагат", translation: "hanumān = божество-обезьяна, āsana = поза", description: "Из выпада скользите передней стопой вперёд, задней назад. Опустите таз, держите его ровно. Ладони на пол или на блоки. Смотрите вперёд, дышите.", benefits: "Растягивает бёдра, заднюю поверхность бедра и пах. Стимулирует органы живота."},
        {name: "Поза гирлянды", translation: "mālā = гирлянда или ожерелье, āsana = поза", description: "Присядьте, стопы вместе или врозь. Локти внутри коленей, ладони у сердца. Разводите колени, опустите таз, смотрите вперёд, дышите.", benefits: "Растягивает щиколотки, пах и спину. Тонизирует живот."},
        {name: "Наклон вперёд стоя", translation: "uttāna = вытяжение, āsana = поза", description: "Встаньте, наклонитесь вперёд, ладони на пол или на голени. Спина длинная, голова тяжёлая. Смотрите вниз, дышите.", benefits: "Успокаивает ум, помогает снять стресс и лёгкую депрессию. Стимулирует печень и почки. Растягивает заднюю поверхность бедра, икры и тазобедренные суставы. Укрепляет бёдра и колени. Улучшает пищеварение. Облегчает симптомы менопаузы. Уменьшает усталость и тревогу. Снимает головную боль и бессонницу."},
        {name: "Поза полумесяца", translation: "ashta = сторона, chandra = луна, āsana = поза", description: "Встаньте, сцепите руки над головой. На вдохе наклонитесь в сторону, растягивая другой бок. Смотрите вверх, дышите.", benefits: "Растягивает грудную клетку, руки и корпус. Тонизирует косые мышцы живота."},
        {name: "Поперечный шпагат", translation: "upaviṣṭha = сидящий, koṇa = угол, āsana = поза", description: "Сядьте, широко разведите ноги. На выдохе переступайте руками вперёд, опуская корпус. Спина длинная, смотрите вниз, дышите.", benefits: "Растягивает внутреннюю и заднюю поверхность ног. Стимулирует органы живота. Укрепляет позвоночник. Успокаивает ум. Расслабляет пах."},
        {name: "Поза дерева", translation: "vṛkṣa = дерево, āsana = поза", description: "Встаньте, поставьте правую стопу на левое бедро или икру. Ладони вместе над головой или у груди. Балансируйте, смотрите вперёд, дышите.", benefits: "Укрепляет ноги, щиколотки и стопы. Улучшает гибкость тазобедренных суставов и коленей. Улучшает равновесие."},
        {name: "Поза треугольника", translation: "trikoṇa = треугольник, āsana = поза", description: "Встаньте широко, разверните правую стопу наружу. Опустите правую руку к голени или на пол, левую поднимите вверх. Раскройте грудь, смотрите вверх, дышите.", benefits: "Растягивает и укрепляет бёдра, колени и щиколотки. Растягивает тазобедренные суставы, пах, заднюю поверхность бедра, икры, плечи, грудь и позвоночник. Стимулирует органы живота. Помогает снять стресс. Улучшает пищеварение. Облегчает симптомы менопаузы. Облегчает боль в спине, особенно во втором триместре беременности. Полезна при тревоге, плоскостопии, бесплодии, боли в шее, остеопорозе и ишиасе."},
        {name: "Собака мордой вверх", translation: "ūrdhva = вверх, mukha = лицом, śvāna = собака, āsana = поза", description: "Лягте на живот, ладони у плеч. На вдохе поднимите грудь и бёдра, отведите плечи назад. Смотрите вперёд, дышите.", benefits: "Улучшает осанку. Укрепляет позвоночник, руки и запястья. Растягивает грудь, лёгкие, плечи и живот. Подтягивает ягодицы. Стимулирует органы живота. Помогает при лёгкой депрессии, усталости и ишиасе. Полезна при астме."},
        {name: "Воин I", translation: "vīrabhadra = воин, āsana = поза", description: "Шагните левой ногой назад, согните правое колено под 90 градусов. Поднимите руки над головой, опустите таз. Смотрите вперёд, дышите.", benefits: "Растягивает грудь, лёгкие, плечи, шею, живот и пах (поясничную мышцу). Укрепляет плечи, руки и мышцы спины. Укрепляет и растягивает бёдра, икры и щиколотки."},
        {name: "Воин II", translation: "vīrabhadra = воин, āsana = поза", description: "Шагните левой ногой назад, согните правое колено под 90 градусов. Руки параллельно полу, опустите таз. Смотрите поверх правой руки, дышите.", benefits: "Укрепляет и растягивает ноги и щиколотки. Растягивает пах, грудь, лёгкие и плечи. Стимулирует органы живота. Повышает выносливость. Облегчает боль в спине, особенно во втором триместре беременности. Полезна при синдроме запястного канала, плоскостопии, бесплодии, остеопорозе и ишиасе."},
        {name: "Воин III", translation: "vīrabhadra = воин, āsana = поза", description: "Встаньте, перенесите вес на правую ногу. Поднимите левую ногу назад параллельно полу, руки вперёд или в стороны. Балансируйте, смотрите вниз, дышите.", benefits: "Укрепляет щиколотки и ноги. Укрепляет плечи и мышцы спины. Тонизирует живот. Улучшает равновесие и осанку."},
        {name: "Поза колеса", translation: "ūrdhva = вверх, dhanu = лук, āsana = поза", description: "Лягте на спину, согните колени, ладони поставьте у ушей. На выдохе поднимите таз и грудь, образуя арку. Смотрите вверх и дышите ровно.", benefits: "Укрепляет руки, запястья, ноги, ягодицы, пресс и позвоночник. Стимулирует щитовидную железу и гипофиз. Придаёт энергию, помогает против депрессии, полезна при астме, боли в спине, бесплодии и остеопорозе."},
        {name: "Дикая штучка", translation: "camatkāra = поражённый изумлением, āsana = поза", description: "Начните в собаке мордой вниз, затем поднимите правую ногу и раскройте таз. Поставьте правую ладонь рядом с передней стопой, поднимите левую руку, прогните спину, смотрите вверх и дышите глубоко.", benefits: "Растягивает грудь, плечи, спину и горло. Укрепляет и раскрывает тазобедренные суставы, сгибатели бедра и бёдра."}
      ]
      sessionText: [
        {name: "Мягкий старт", description: "Успокаивающая последовательность для начинающих: базовые позы и внимание к дыханию, чтобы плавно войти в йогу."},
        {name: "Утреннее пробуждение", description: "Последовательность для начинающих, чтобы зарядиться энергией и потянуть тело перед днём."},
        {name: "Спокойная база", description: "Успокаивающая последовательность для начинающих, чтобы расслабиться и восстановиться в мягких позах."},
        {name: "Основы равновесия", description: "Последовательность для начинающих, чтобы развить равновесие и силу в позах стоя и сидя."},
        {name: "Пресс и растяжка", description: "Последовательность для начинающих, чтобы укрепить мышцы кора и стать гибче в простых позах."},
        {name: "Сильный кор", description: "Динамичная последовательность среднего уровня для устойчивости и силы мышц кора."},
        {name: "Раскрытие таза", description: "Последовательность среднего уровня, чтобы глубоко растянуть и раскрыть тазобедренные суставы."},
        {name: "Скрутки и энергия", description: "Последовательность скруток среднего уровня, чтобы очиститься и зарядиться энергией."},
        {name: "Испытание равновесия", description: "Последовательность среднего уровня в позах стоя для равновесия и координации."},
        {name: "Энергичный поток", description: "Интенсивный поток среднего уровня, чтобы развить выносливость и силу в динамичных переходах."},
        {name: "Раскрытие сердца", description: "Последовательность среднего уровня с прогибами, чтобы раскрыть грудь и укрепить спину."},
        {name: "Кор и устойчивость", description: "Последовательность среднего уровня: работа с кором и балансы для общей устойчивости."},
        {name: "Гибкость сидя", description: "Последовательность среднего уровня из поз сидя для гибкости таза и задней поверхности бедра."},
        {name: "Сила воина", description: "Последовательность среднего уровня на позах воина для силы и уверенности."},
        {name: "Энергия и равновесие", description: "Бодрящая последовательность среднего уровня, чтобы зарядиться силами и улучшить равновесие."},
        {name: "Кор на максимум", description: "Продвинутая последовательность сложных поз для интенсивной работы над кором."},
        {name: "Мир перевёрнутых поз", description: "Продвинутая последовательность, чтобы освоить перевёрнутые позы, развивая силу и контроль."},
        {name: "Гибкость на пределе", description: "Продвинутая последовательность с глубокими растяжками и шпагатами, чтобы расширить границы гибкости."},
        {name: "Балансы на руках", description: "Продвинутая последовательность балансов на руках для силы верхней части тела."},
        {name: "Глубокие прогибы", description: "Продвинутая последовательность, чтобы углубить прогибы и раскрыть грудь и позвоночник."},
        {name: "Большой поток", description: "Полный продвинутый поток, объединяющий силу, равновесие и гибкость."},
        {name: "Точность и сила", description: "Продвинутая последовательность с упором на точное выравнивание и мощные позы."},
        {name: "Таз и сердце", description: "Продвинутая последовательность, чтобы глубоко раскрыть таз и сердце для гибкости и эмоциональной разрядки."},
        {name: "Сила и контроль", description: "Продвинутая последовательность сложных поз для силы и контроля."},
        {name: "Мастерство йоги", description: "Продвинутая последовательность для опытных практиков: испытание силы, равновесия и гибкости."},
        {name: "Блаженный поток для начинающих", description: "Полная последовательность для начинающих, которая плавно проходит через разминку, силовые позы и балансы стоя, мягкие прогибы, наклоны вперёд, раскрытие таза и восстанавливающие позы, чтобы заложить прочную основу."}
      ]
    }
    ja {
      title: "ヨガ"
      sessions: "セッション"; poses: "ポーズ"
      levels: {beginner: "初級", intermediate: "中級", advanced: "上級"}
      ranks: {novice: "見習い", practitioner: "実践者", adept: "熟練者", devotee: "求道者", teacher: "指導者", master: "達人"}
      paces: {swift: "短め", balanced: "標準", endurance: "長め"}
      levelRank: (n, rank) => "レベル ${n} · ${rank}"
      streak: n => "${n} 日連続"
      xpLine: (xp, need, next) => "${xp} xp · レベル ${next} まで ${need}"
      completed: "完了"
      sessionLine: (level, n, time) => "${level} · ${n} ポーズ · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · ${time} キープ · 左右" : "${level} · ${time} キープ"
      how: "やり方"; benefits: "効果"; inSessions: "含まれるセッション"
      startArrow: "開始 ›"
      getReady: "準備してください"
      first: name => "最初：${name}"
      introLine: (n, time) => "${n} ポーズ · このペースで ${time}"
      startNow: "今すぐ開始"
      poseOf: (i, n) => "ポーズ ${i} / ${n}"
      voiceOn: "音声オン"; voiceOff: "音声オフ"
      nextPose: "次のポーズ"; paused: "一時停止中"; readyNext: "次のポーズの準備をしてください…"
      firstSide: "片側"; secondSide: "反対側"; lastPose: "最後のポーズ"
      quitAsk: "このセッションを終了しますか？"; keepGoing: "続ける"; quit: "終了"
      resume: "再開"; pause: "一時停止"; skip: "スキップ"
      greatJob: "お疲れさまでした"
      levelUp: (n, rank) => "レベル ${n}：${rank}"
      xpHint: "xp はその日最初のセッションで獲得できます"
      done: "完了"; again: "もう一度"
      poseText: [
        {name: "舟のポーズ", translation: "nāva = 舟、āsana = 姿勢", description: "脚を伸ばして座ります。息を吐きながら脚を 45 度に上げ、上体を少し後ろに傾けます。腕を前に伸ばし、手のひらを向かい合わせます。坐骨でバランスをとり、体幹を引き締めます。つま先を見つめ、呼吸します。", benefits: "腹部、股関節の屈筋、背骨を強くします。腎臓、甲状腺、前立腺、腸を刺激します。ストレスの緩和に役立ちます。消化を促します。"},
        {name: "半舟のポーズ", translation: "ardha = 半分、nāva = 舟、āsana = 姿勢", description: "座って膝を曲げ、足を浮かせます。上体を少し後ろに傾け、太ももの裏を持つか腕を伸ばします。バランスをとり、体幹を引き締め、前を見つめて呼吸します。", benefits: "腹部、股関節の屈筋、背骨を強くします。腎臓、甲状腺、前立腺、腸を刺激します。ストレスの緩和に役立ちます。消化を促します。"},
        {name: "弓のポーズ", translation: "dhanur = 弓、āsana = 姿勢", description: "うつ伏せになります。膝を曲げ、足首をつかみます。息を吸いながら胸と太ももを持ち上げ、足で手を押し返します。前を見つめ、呼吸します。", benefits: "足首、太もも、鼠径部、腹部、胸、喉、深層の股関節屈筋（大腰筋）など、体の前面全体を伸ばします。背筋を強くします。姿勢を改善します。腹部と首の器官を刺激します。"},
        {name: "橋のポーズ", translation: "setu = 橋、bandha = 締める、sarva = すべて、āṅga = 肢、āsana = 姿勢", description: "仰向けになり、膝を曲げ、足を腰幅に開きます。息を吸いながら腰を持ち上げ、背中の下で両手を組みます。肩を内側に寄せ、胸を持ち上げます。上を見つめ、呼吸します。", benefits: "胸、首、背骨を伸ばします。腹部の臓器、肺、甲状腺を刺激します。疲れた脚をよみがえらせます。消化を促します。更年期の症状の緩和に役立ちます。補助を使って行うと生理痛を和らげます。不安、疲労、腰痛、頭痛、不眠を軽減します。喘息、高血圧、骨粗しょう症、副鼻腔炎に効果があります。"},
        {name: "合せきのポーズ", translation: "baddha = 結ばれた、koṇa = 角度、āsana = 姿勢", description: "足の裏を合わせ、膝を外に開いて座ります。足を持ち、背筋を伸ばして座ります。肩の力を抜き、深く呼吸します。", benefits: "股関節と鼠径部を開きます。肩、肋骨まわり、背中を伸ばします。腹部の臓器、肺、心臓を刺激します。"},
        {name: "ラクダのポーズ", translation: "uṣṭra = ラクダ、āsana = 姿勢", description: "膝立ちになり、手を腰に当てます。息を吸いながら胸を持ち上げ、無理がなければかかとに手を伸ばします。首は自然な位置に保ち、前を見つめて呼吸します。", benefits: "足首、太もも、鼠径部、腹部、胸、喉など、体の前面全体を伸ばします。深層の股関節屈筋（大腰筋）を伸ばします。背筋を強くします。姿勢を改善します。腹部と首の器官を刺激します。"},
        {name: "猫のポーズ", translation: "marjarya = 猫、āsana = 姿勢", description: "四つんばいになります。息を吐きながら背中を丸めて持ち上げ、あごを引きます。体幹を引き締め、おへそを見つめて呼吸します。", benefits: "背骨と首の緊張をほぐします。体に活力を与えます。"},
        {name: "牛のポーズ", translation: "bitil = 牛、āsana = 姿勢", description: "四つんばいになります。息を吸いながら背中を反らし、尾骨と胸を持ち上げます。上を見つめ、呼吸します。", benefits: "疲労を取り除きます。呼吸と脳への血流を改善します。全身をよみがえらせます。"},
        {name: "椅子のポーズ", translation: "utkaṭa = 力強い、āsana = 姿勢", description: "足をそろえて立ちます。息を吸いながら座るように膝を曲げ、腕を頭上に上げます。重心はかかとに置き、前を見つめて呼吸します。", benefits: "足首、太もも、ふくらはぎ、背骨を強くします。肩と胸を伸ばします。腹部の臓器、横隔膜、心臓を刺激します。偏平足を改善します。全身に活力を与えます。"},
        {name: "チャイルドポーズ", translation: "bala = 子ども、āsana = 姿勢", description: "膝をつき、足の親指をそろえて膝を開きます。息を吐きながら前に倒れ、腕を伸ばします。額をマットにつけ、力を抜いて呼吸します。", benefits: "股関節、太もも、足首をやさしく伸ばします。脳を落ち着かせ、ストレスと疲労の緩和に役立ちます。頭と胴体を支えて行うと、背中と首の痛みを和らげます。"},
        {name: "屍のポーズ", translation: "śava = 屍、āsana = 姿勢", description: "仰向けになり、脚を伸ばし、腕は体の横に置いて手のひらを上に向けます。目を閉じ、全身の力を完全に抜いて、深く呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。体をリラックスさせます。頭痛、疲労、不眠を軽減します。血圧を下げるのに役立ちます。"},
        {name: "クレセントランジ", translation: "ashta = 側面、chandra = 月、āsana = 姿勢", description: "片足を前に踏み出し、ランジの姿勢になります。後ろの膝は床につけても浮かせてもかまいません。息を吸いながら腕を頭上に上げます。腰を沈め、前を見つめて呼吸します。", benefits: "肋骨まわり、腕、胴体を伸ばします。腹斜筋を引き締めます。"},
        {name: "カラスのポーズ", translation: "baka = 鶴、āsana = 姿勢", description: "しゃがみ、手を肩幅に開いてマットにつきます。膝を上腕に乗せます。息を吐きながら体重を前に移し、足を浮かせます。バランスをとり、前を見つめて呼吸します。", benefits: "腕と手首を強くします。背中の上部を伸ばします。腹筋を強くします。鼠径部を開きます。腹部の臓器を引き締めます。"},
        {name: "イルカのポーズ", translation: "pīñcha = 羽、mayūra = 孔雀、āsana = 姿勢", description: "下向きの犬のポーズから前腕を床につき、肘を肩の真下に置きます。腰を持ち上げ、かかとを下に押します。体幹を引き締め、両手の間を見つめて呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。体に活力を与えます。肩、ハムストリング、ふくらはぎ、土踏まず、手を伸ばします。腕と脚を強くします。更年期の症状の緩和に役立ちます。頭を支えて行うと生理痛を和らげます。骨粗しょう症の予防に役立ちます。消化を促します。頭痛、不眠、腰痛、疲労を和らげます。高血圧、喘息、偏平足、坐骨神経痛、副鼻腔炎に効果があります。足首とつま先を温めます。"},
        {name: "下向きの犬のポーズ", translation: "parivṛtta = ねじった、adho = 下に、mukha = 顔、śvāna = 犬、āsana = 姿勢", description: "四つんばいになります。息を吐きながら腰を上と後ろに持ち上げます。脚を伸ばし、かかとを下に押します。背骨を長く伸ばし、両脚の間を見つめて呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。体に活力を与えます。肩、首、ハムストリング、ふくらはぎ、土踏まず、手を伸ばします。腕と脚を強くします。更年期の症状の緩和に役立ちます。頭を支えて行うと生理痛を和らげます。骨粗しょう症の予防に役立ちます。消化を促します。頭痛、不眠、腰痛、疲労を和らげます。高血圧、喘息、偏平足、坐骨神経痛、副鼻腔炎に効果があります。"},
        {name: "ワシのポーズ", translation: "garuḍa = ワシ、āsana = 姿勢", description: "立って右脚を左脚に重ね、足先をふくらはぎの後ろに引っかけます。左腕を右腕に重ね、手のひらを合わせます。肘を持ち上げ、前を見つめて呼吸します。", benefits: "足首とふくらはぎを強くし、伸ばします。太もも、股関節、肩、背中の上部を伸ばします。集中力を高めます。バランス感覚を高めます。"},
        {name: "足の親指をつかむポーズ", translation: "utthita = 伸ばした、hasta = 手、pādāṅguṣṭha = 足の親指、āsana = 姿勢", description: "立って右脚を上げ、右手で足の親指をつかみます。脚を前に伸ばし、腰は正面に向けたまま保ちます。前を見つめ、呼吸します。", benefits: "股関節と鼠径部を開きます。ハムストリング、腸脛靱帯、脚を伸ばします。バランス感覚を高めます。"},
        {name: "体側を伸ばすポーズ", translation: "utthita = 伸ばした、pārśva = 側面、koṇa = 角度、āsana = 姿勢", description: "戦士のポーズ II から前の膝をさらに深く曲げます。前の腕を頭上に伸ばし、後ろの手は脚か床に置きます。胸を開き、上を見つめて呼吸します。", benefits: "脚、膝、足首を強くし、伸ばします。鼠径部、背骨、ウエスト、胸、肺、肩を伸ばします。腹部の臓器を刺激します。持久力を高めます。"},
        {name: "孔雀の羽のポーズ", translation: "pīñcha = 羽、mayūra = 孔雀、āsana = 姿勢", description: "イルカのポーズから足を手に近づけます。息を吐きながら片脚ずつ持ち上げ、前腕でバランスをとります。体幹を引き締め、前を見つめて呼吸します。", benefits: "腕と肩を強くします。集中力とバランス感覚を高めます。背中の上部と下部を伸ばします。腹筋を強くします。お腹まわりを引き締めます。"},
        {name: "肩を開く前屈", translation: "uttāna = 強く伸ばす、āsana = 姿勢", description: "立って前屈し、背中の後ろで両手を組みます。腕をゆっくり持ち上げ、頭の力を抜きます。下を見つめ、呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。肝臓と腎臓を刺激します。ハムストリング、ふくらはぎ、股関節を伸ばします。太ももと膝を強くします。消化を促します。更年期の症状の緩和に役立ちます。疲労と不安を軽減します。頭痛と不眠を和らげます。肩を開きます。"},
        {name: "半月のポーズ", translation: "ardha = 半分、chandra = 月、āsana = 姿勢", description: "戦士のポーズ III から、前足の横の床に手をつきます。後ろの脚を床と平行に上げ、反対の腕を上に伸ばします。腰を開き、上か下を見つめて呼吸します。", benefits: "腹部、足首、太もも、お尻、背骨を強くします。鼠径部、ハムストリング、ふくらはぎ、肩、胸、背骨を伸ばします。協調性とバランス感覚を高めます。ストレスの緩和に役立ちます。消化を促します。"},
        {name: "逆立ち", translation: "adho = 下に、mukha = 顔、vṛkṣa = 木、āsana = 姿勢", description: "下向きの犬のポーズから足を手に近づけます。体重を移し、脚を蹴り上げて伸ばします。体幹を引き締め、前を見つめて呼吸します。", benefits: "肩、腕、手首を強くします。お腹を伸ばします。バランス感覚を高めます。脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。"},
        {name: "ローランジ", translation: "aṅjaneya = 賛美、āsana = 姿勢", description: "右足を前に踏み出し、ランジの姿勢になります。左膝を床につき、手は太ももに置くか頭上に上げます。腰を沈め、前を見つめて呼吸します。", benefits: "胸、肺、首、お腹、鼠径部（大腰筋）を伸ばします。肩、腕、背筋を強くします。太もも、ふくらはぎ、足首を強くし、伸ばします。"},
        {name: "鳩のポーズ", translation: "supta = 仰向けの、kapota = 鳩、āsana = 姿勢", description: "仰向けになり、右の足首を左膝に乗せます。左膝を胸に引き寄せます。背中を床につけたまま、上を見つめて呼吸します。", benefits: "ハムストリングと大腿四頭筋を伸ばします。肘で太ももを押すと、股関節も開きます。"},
        {name: "鳩の王のポーズ", translation: "eka = 一つ、pāda = 足または脚、rāja = 王、kapota = 鳩、āsana = 姿勢", description: "鳩のポーズから後ろの膝を曲げ、手で足をつかみます。胸を持ち上げ、ハートを開きます。前を見つめ、呼吸します。", benefits: "太もも、鼠径部（大腰筋）、腹部、胸、肩、首を伸ばします。腹部の臓器を刺激します。肩と胸を開きます。"},
        {name: "プランク", translation: "phalaka = 板、āsana = 姿勢", description: "四つんばいから足を後ろに引きます。体をまっすぐにし、手を肩の真下に置きます。体幹を引き締め、下を見つめて呼吸します。", benefits: "腕、手首、背骨を強くします。お腹を引き締めます。"},
        {name: "鋤のポーズ", translation: "hala = 鋤、āsana = 姿勢", description: "仰向けになります。息を吐きながら脚を頭の上へ持ち上げ、つま先を頭の後ろの床につけます。背中を手で支えるか、両手を組みます。内側に意識を向け、呼吸します。", benefits: "脳を落ち着かせます。腹部の臓器と甲状腺を刺激します。肩と背骨を伸ばします。更年期の症状の緩和に役立ちます。ストレスと疲労を軽減します。腰痛、頭痛、不妊、不眠、副鼻腔炎に効果があります。"},
        {name: "ピラミッドのポーズ", translation: "pārśva = 側面、uttāna = 強く伸ばす、āsana = 姿勢", description: "右足を前に、左足を後ろに踏み出します。股関節から上体を折り、前脚の上に倒します。手は床かブロックに置きます。下を見つめ、呼吸します。", benefits: "脳を落ち着かせます。背骨、肩、股関節、ハムストリングを伸ばします。脚を強くします。腹部の臓器を刺激します。姿勢とバランス感覚を改善します。消化を促します。"},
        {name: "リバースウォーリア", translation: "pārśva = 側面、vīrabhadra = 戦士、āsana = 姿勢", description: "戦士のポーズ II から前の腕を頭上へ、そして後ろへ伸ばします。後ろの手を脚に沿って滑らせます。胸を開き、上を見つめて呼吸します。", benefits: "脚、膝、足首を強くし、伸ばします。鼠径部、背骨、ウエスト、胸、肺、肩を伸ばします。腹部の臓器を刺激します。持久力を高めます。腰痛、特に妊娠中期の腰痛を和らげます。手根管症候群、偏平足、不妊、骨粗しょう症、坐骨神経痛に効果があります。"},
        {name: "座位の前屈", translation: "paśchima = 背面、uttāna = 強く伸ばす、āsana = 姿勢", description: "脚を伸ばして座ります。息を吸いながら背骨を伸ばします。息を吐きながら前に倒れ、足かすねに手を伸ばします。背骨を長く保ち、前を見つめて呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。背骨、肩、ハムストリングを伸ばします。肝臓、腎臓、卵巣、子宮を刺激します。消化を促します。更年期の症状や生理痛の緩和に役立ちます。頭痛と不安を和らげます。疲労を軽減します。高血圧、不妊、不眠、副鼻腔炎に効果があります。伝統的な文献では、パスチモッターナーサナは食欲を増し、肥満を減らし、病を癒やすとされています。"},
        {name: "蓮華座", translation: "padma = 蓮、āsana = 姿勢", description: "座って右足を左の太ももに、左足を右の太ももに乗せます。手を膝に置き、背筋を伸ばして座り、呼吸します。", benefits: "股関節と鼠径部を開き、膝、足首、太ももを伸ばします。背中を強くし、心を落ち着かせ、ストレスと不安を軽減します。骨盤内の血行を促します。"},
        {name: "半分の魚の王のポーズ", translation: "ardha = 半分、matsya = 魚、indra = 王", description: "座って右膝を左膝の上で交差させ、右にねじります。左肘を右膝の外側に当て、右手は後ろにつきます。肩越しに見つめ、呼吸します。", benefits: "肩、胸、太もも、鼠径部、腹部を伸ばします。脚と足首を強くします。バランス感覚を高めます。"},
        {name: "肩立ちのポーズ", translation: "sa = ともに、ālamba = 支え、sarvāṅga = 全身、āsana = 姿勢", description: "仰向けになります。息を吐きながら脚と腰を持ち上げ、手で背中を支えます。脚を伸ばし、内側に意識を向けて呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。甲状腺、前立腺、腹部の臓器を刺激します。肩と首を伸ばします。脚とお尻を引き締めます。消化を促します。更年期の症状の緩和に役立ちます。疲労を軽減し、不眠を和らげます。喘息、不妊、副鼻腔炎に効果があります。"},
        {name: "サイドプランク", translation: "vasiṣṭha = 聖者の名、āsana = 姿勢", description: "プランクから右足の外側に体を転がします。両足を重ね、左腕を上に伸ばします。体幹を引き締め、上を見つめて呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。肩、ハムストリング、ふくらはぎ、土踏まずを伸ばします。腕と脚を強くします。更年期の症状の緩和に役立ちます。骨粗しょう症の予防に役立ちます。消化を促します。頭痛、不眠、腰痛、疲労を和らげます。高血圧、喘息、偏平足、坐骨神経痛に効果があります。"},
        {name: "スフィンクスのポーズ", translation: "sālamba = 支えのある、bhujaṅga = 蛇、āsana = 姿勢", description: "うつ伏せになり、前腕をマットにつけ、肘を肩の真下に置きます。息を吸いながら胸を持ち上げ、肩を下げます。前を見つめ、呼吸します。", benefits: "背骨を強くします。胸、肺、肩、腹部を伸ばします。腹部の臓器を刺激します。胸と肺を開きます。"},
        {name: "前後開脚", translation: "hanumān = 猿の神、āsana = 姿勢", description: "ローランジから前足を前へ、後ろ足を後ろへ滑らせます。腰を下ろし、正面に向けたまま保ちます。手は床かブロックに置きます。前を見つめ、呼吸します。", benefits: "太もも、ハムストリング、鼠径部を伸ばします。腹部の臓器を刺激します。"},
        {name: "花輪のポーズ", translation: "mālā = 花輪または首飾り、āsana = 姿勢", description: "足をそろえるか開いてしゃがみます。肘を膝の内側に置き、胸の前で合掌します。膝を外に押し、腰を沈め、前を見つめて呼吸します。", benefits: "足首、鼠径部、背中を伸ばします。お腹を引き締めます。"},
        {name: "立位前屈", translation: "uttāna = 強く伸ばす、āsana = 姿勢", description: "立って前屈し、手を床かすねに置きます。背骨を長く保ち、頭の重さに任せます。下を見つめ、呼吸します。", benefits: "脳を落ち着かせ、ストレスや軽い抑うつの緩和に役立ちます。肝臓と腎臓を刺激します。ハムストリング、ふくらはぎ、股関節を伸ばします。太ももと膝を強くします。消化を促します。更年期の症状の緩和に役立ちます。疲労と不安を軽減します。頭痛と不眠を和らげます。"},
        {name: "三日月のポーズ", translation: "ashta = 側面、chandra = 月、āsana = 姿勢", description: "立って頭上で両手を組みます。息を吸いながら片側に体を倒し、反対側を伸ばします。上を見つめ、呼吸します。", benefits: "肋骨まわり、腕、胴体を伸ばします。腹斜筋を引き締めます。"},
        {name: "座位開脚前屈", translation: "upaviṣṭha = 座った、koṇa = 角度、āsana = 姿勢", description: "脚を大きく開いて座ります。息を吐きながら手を前に歩かせ、上体を下ろします。背骨を長く保ち、下を見つめて呼吸します。", benefits: "脚の内側と裏側を伸ばします。腹部の臓器を刺激します。背骨を強くします。脳を落ち着かせます。鼠径部をほぐします。"},
        {name: "木のポーズ", translation: "vṛkṣa = 木、āsana = 姿勢", description: "立って右足を左の太ももかふくらはぎに当てます。手のひらを頭上か胸の前で合わせます。バランスをとり、前を見つめて呼吸します。", benefits: "脚、足首、足を強くします。股関節と膝の柔軟性を高めます。バランス感覚を高めます。"},
        {name: "三角のポーズ", translation: "trikoṇa = 三角、āsana = 姿勢", description: "脚を大きく開いて立ち、右足を外に向けます。右手をすねか床に下ろし、左腕を上に伸ばします。胸を開き、上を見つめて呼吸します。", benefits: "太もも、膝、足首を伸ばし、強くします。股関節、鼠径部、ハムストリング、ふくらはぎ、肩、胸、背骨を伸ばします。腹部の臓器を刺激します。ストレスの緩和に役立ちます。消化を促します。更年期の症状の緩和に役立ちます。腰痛、特に妊娠中期の腰痛を和らげます。不安、偏平足、不妊、首の痛み、骨粗しょう症、坐骨神経痛に効果があります。"},
        {name: "上向きの犬のポーズ", translation: "ūrdhva = 上に、mukha = 顔、śvāna = 犬、āsana = 姿勢", description: "うつ伏せになり、手を肩の横に置きます。息を吸いながら胸と太ももを持ち上げ、肩を後ろに回します。前を見つめ、呼吸します。", benefits: "姿勢を改善します。背骨、腕、手首を強くします。胸、肺、肩、腹部を伸ばします。お尻を引き締めます。腹部の臓器を刺激します。軽い抑うつ、疲労、坐骨神経痛の緩和に役立ちます。喘息に効果があります。"},
        {name: "戦士のポーズ I", translation: "vīrabhadra = 戦士、āsana = 姿勢", description: "左足を後ろに引き、右膝を 90 度に曲げます。腕を頭上に上げ、腰を沈めます。前を見つめ、呼吸します。", benefits: "胸、肺、肩、首、お腹、鼠径部（大腰筋）を伸ばします。肩、腕、背筋を強くします。太もも、ふくらはぎ、足首を強くし、伸ばします。"},
        {name: "戦士のポーズ II", translation: "vīrabhadra = 戦士、āsana = 姿勢", description: "左足を後ろに引き、右膝を 90 度に曲げます。腕を床と平行に伸ばし、腰を沈めます。右手の先を見つめ、呼吸します。", benefits: "脚と足首を強くし、伸ばします。鼠径部、胸、肺、肩を伸ばします。腹部の臓器を刺激します。持久力を高めます。腰痛、特に妊娠中期の腰痛を和らげます。手根管症候群、偏平足、不妊、骨粗しょう症、坐骨神経痛に効果があります。"},
        {name: "戦士のポーズ III", translation: "vīrabhadra = 戦士、āsana = 姿勢", description: "立って右脚に体重を移します。左脚を後ろに上げて床と平行にし、腕は前か横に伸ばします。バランスをとり、下を見つめて呼吸します。", benefits: "足首と脚を強くします。肩と背筋を強くします。お腹を引き締めます。バランス感覚と姿勢を改善します。"},
        {name: "車輪のポーズ", translation: "ūrdhva = 上に、dhanu = 弓、āsana = 姿勢", description: "仰向けになって膝を曲げ、手を耳の横に置きます。息を吐きながら腰と胸を持ち上げ、アーチを作ります。上を見つめ、落ち着いて呼吸します。", benefits: "腕、手首、脚、お尻、腹筋、背骨を強くします。甲状腺と下垂体を刺激します。活力を高め、抑うつを和らげ、喘息、腰痛、不妊、骨粗しょう症に効果があります。"},
        {name: "ワイルドシング", translation: "camatkāra = 驚きに打たれた、āsana = 姿勢", description: "下向きの犬のポーズから右脚を上げ、股関節を開きます。右手を前足の横に置き、左腕を上げて背中を反らします。上を見つめ、深く呼吸します。", benefits: "胸、肩、背中、喉を伸ばします。股関節、股関節の屈筋、太ももを強くし、開きます。"}
      ]
      sessionText: [
        {name: "やさしい入門フロー", description: "基本のポーズと呼吸を通して、初心者が無理なくヨガを始められる心地よいシーケンスです。"},
        {name: "朝のめざめ", description: "一日に向けて体に活力を与え、伸ばす、初心者向けのシーケンスです。"},
        {name: "くつろぎの基本", description: "やさしいポーズでリラックスし、心身を回復させる、穏やかな初心者向けシーケンスです。"},
        {name: "バランスの土台", description: "立位と座位のポーズでバランスと筋力を養う、初心者向けシーケンスです。"},
        {name: "体幹とストレッチ", description: "シンプルなポーズで体幹を鍛え、柔軟性を高める、初心者向けシーケンスです。"},
        {name: "中級の体幹強化", description: "体幹の安定性と筋力を養う、ダイナミックな中級シーケンスです。"},
        {name: "股関節を開くフロー", description: "股関節を深く伸ばして開き、柔軟性を高める中級シーケンスです。"},
        {name: "ねじって活力アップ", description: "デトックスとエネルギーアップのための、ねじりの中級シーケンスです。"},
        {name: "バランスチャレンジ", description: "立位のポーズでバランスと協調性を高める中級シーケンスです。"},
        {name: "パワフルフロー", description: "ダイナミックな移行で持久力と筋力を養う、エネルギッシュな中級フローです。"},
        {name: "胸を開くシーケンス", description: "後屈で胸を開き、背中を強くする中級シーケンスです。"},
        {name: "体幹と安定", description: "体幹トレーニングとバランスのポーズを組み合わせ、全身の安定性を高める中級シーケンスです。"},
        {name: "座位の柔軟性", description: "座位のポーズで股関節とハムストリングの柔軟性を深める中級シーケンスです。"},
        {name: "戦士のパワー", description: "戦士のポーズを中心に、筋力と自信を養う中級シーケンスです。"},
        {name: "エネルギーとバランス", description: "活力を高め、バランスを改善する、元気が出る中級シーケンスです。"},
        {name: "上級の体幹集中", description: "難しいポーズで体幹を集中的に鍛える上級シーケンスです。"},
        {name: "逆転ポーズの探求", description: "筋力とコントロールを養いながら逆転のポーズを極める上級シーケンスです。"},
        {name: "究極の柔軟性", description: "深いストレッチと開脚で柔軟性の限界に挑む上級シーケンスです。"},
        {name: "アームバランスを極める", description: "アームバランスを中心に上半身を鍛える上級シーケンスです。"},
        {name: "深い後屈", description: "後屈を深め、胸と背骨を開く上級シーケンスです。"},
        {name: "究極のフロー", description: "筋力、バランス、柔軟性を組み合わせた総合的な上級フローです。"},
        {name: "精密さとパワー", description: "正確なアライメントと力強いポーズを重視する上級シーケンスです。"},
        {name: "股関節と胸の集中", description: "股関節と胸を深く開き、柔軟性を高めて感情を解き放つ上級シーケンスです。"},
        {name: "筋力とコントロール", description: "難しいポーズで筋力とコントロールを養う上級シーケンスです。"},
        {name: "ヨガを極める", description: "経験を積んだ実践者に向けて、筋力、バランス、柔軟性に挑む上級シーケンスです。"},
        {name: "初心者の至福フロー", description: "ウォームアップ、立位の筋力とバランスのポーズ、やさしい後屈、前屈、股関節を開くポーズ、回復のポーズへと調和よく流れ、バランスのとれた土台を築く総合的な初心者向けシーケンスです。"}
      ]
    }
    uk {
      title: "йога"
      sessions: "заняття"; poses: "пози"
      levels: {beginner: "початковий", intermediate: "середній", advanced: "просунутий"}
      ranks: {novice: "новачок", practitioner: "практик", adept: "адепт", devotee: "відданий", teacher: "учитель", master: "майстер"}
      paces: {swift: "швидкий", balanced: "помірний", endurance: "витривалий"}
      levelRank: (n, rank) => "рівень ${n} · ${rank}"
      streak: n => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "день поспіль" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "дні поспіль" : "днів поспіль")
      xpLine: (xp, need, next) => "${xp} xp · ще ${need} до рівня ${next}"
      completed: "готово"
      sessionLine: (level, n, time) => "${level} · ${n} " + (n % 10 == 1 && n % 100 != 11 ? "поза" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "пози" : "поз") + " · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · тримати ${time} · обидва боки" : "${level} · тримати ${time}"
      how: "техніка"; benefits: "користь"; inSessions: "у заняттях"
      startArrow: "старт ›"
      getReady: "приготуйтеся"
      first: name => "спершу: ${name}"
      introLine: (n, time) => "${n} " + (n % 10 == 1 && n % 100 != 11 ? "поза" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? "пози" : "поз") + " · ${time} у цьому темпі"
      startNow: "почати зараз"
      poseOf: (i, n) => "поза ${i} з ${n}"
      voiceOn: "голос увімкнено"; voiceOff: "голос вимкнено"
      nextPose: "наступна поза"; paused: "пауза"; readyNext: "приготуйтеся до наступної пози…"
      firstSide: "перша сторона"; secondSide: "друга сторона"; lastPose: "остання поза"
      quitAsk: "завершити це заняття?"; keepGoing: "продовжити"; quit: "вийти"
      resume: "продовжити"; pause: "пауза"; skip: "пропустити"
      greatJob: "чудова робота"
      levelUp: (n, rank) => "рівень ${n}: ${rank}"
      xpHint: "xp нараховується за перше заняття дня"
      done: "готово"; again: "ще раз"
      poseText: [
        {name: "Човен", translation: "nāva = човен, āsana = поза", description: "Сядьте, ноги випрямлені. На видиху підніміть ноги під кутом 45 градусів, трохи відхиліться назад. Витягніть руки вперед, долоні одна до одної. Балансуйте на сідничних кістках, напружте прес. Дивіться на пальці ніг, дихайте.", benefits: "Зміцнює прес, згиначі стегна й хребет. Стимулює нирки, щитоподібну та передміхурову залози, кишечник. Допомагає зняти стрес. Покращує травлення."},
        {name: "Напівчовен", translation: "ardha = половина, nāva = човен, āsana = поза", description: "Сядьте, коліна зігнуті, стопи підняті. Трохи відхиліться назад, тримайтеся за стегна ззаду або витягніть руки. Балансуйте, напружте прес, дивіться вперед, дихайте.", benefits: "Зміцнює прес, згиначі стегна й хребет. Стимулює нирки, щитоподібну та передміхурову залози, кишечник. Допомагає зняти стрес. Покращує травлення."},
        {name: "Лук", translation: "dhanur = лук, āsana = поза", description: "Ляжте на живіт. Зігніть коліна, візьміться за щиколотки. На вдиху підніміть груди й стегна, тисніть стопами в долоні. Дивіться вперед, дихайте.", benefits: "Розтягує всю передню поверхню тіла: щиколотки, стегна й пах, живіт і груди, горло та глибокі згиначі стегна (поперековий м’яз). Зміцнює м’язи спини. Покращує поставу. Стимулює органи черевної порожнини та шиї."},
        {name: "Міст", translation: "setu = міст, bandha = замок, sarva = увесь, āṅga = кінцівка, āsana = поза", description: "Ляжте на спину, коліна зігнуті, стопи на ширині стегон. На вдиху підніміть таз, зчепіть руки під спиною. Заведіть плечі під себе, підніміть груди. Дивіться вгору, дихайте.", benefits: "Розтягує груди, шию та хребет. Стимулює органи черевної порожнини, легені й щитоподібну залозу. Відновлює втомлені ноги. Покращує травлення. Полегшує симптоми менопаузи. З опорою зменшує менструальний дискомфорт. Зменшує тривогу, втому, біль у спині, головний біль і безсоння. Корисна при астмі, підвищеному тиску, остеопорозі та синуситі."},
        {name: "Метелик", translation: "baddha = зв’язаний, koṇa = кут, āsana = поза", description: "Сядьте, з’єднайте стопи, коліна в сторони. Тримайтеся за стопи, сидіть рівно. Розслабте плечі, дихайте глибоко.", benefits: "Розкриває стегна й пах. Розтягує плечі, грудну клітку та спину. Стимулює органи черевної порожнини, легені й серце."},
        {name: "Верблюд", translation: "uṣṭra = верблюд, āsana = поза", description: "Станьте на коліна, долоні на поперек. На вдиху підніміть груди, якщо комфортно, дотягніться до п’ят. Шия нейтральна, дивіться вперед, дихайте.", benefits: "Розтягує всю передню поверхню тіла: щиколотки, стегна й пах, живіт і груди, горло. Розтягує глибокі згиначі стегна (поперековий м’яз). Зміцнює м’язи спини. Покращує поставу. Стимулює органи черевної порожнини та шиї."},
        {name: "Кішка", translation: "marjarya = кішка, āsana = поза", description: "Станьте на долоні й коліна. На видиху округліть спину вгору, притисніть підборіддя. Напружте прес, дивіться на живіт, дихайте.", benefits: "Розвантажує хребет і шию. Додає тілу енергії."},
        {name: "Корова", translation: "bitil = корова, āsana = поза", description: "Станьте на долоні й коліна. На вдиху прогніть спину донизу, підніміть куприк і груди. Дивіться вгору, дихайте.", benefits: "Знімає втому. Покращує дихання та кровообіг мозку. Оновлює все тіло."},
        {name: "Стілець", translation: "utkaṭa = могутній, āsana = поза", description: "Станьте, стопи разом. На вдиху зігніть коліна, ніби сідаєте, підніміть руки над головою. Вага на п’ятах, дивіться вперед, дихайте.", benefits: "Зміцнює щиколотки, стегна, литки й хребет. Розтягує плечі та груди. Стимулює органи черевної порожнини, діафрагму й серце. Допомагає при плоскостопості. Додає енергії всьому тілу."},
        {name: "Поза дитини", translation: "bala = дитина, āsana = поза", description: "Станьте на коліна, великі пальці ніг разом, коліна нарізно. На видиху нахиліться вперед, руки витягнуті. Чоло на килимок, розслабтеся, дихайте.", benefits: "М’яко розтягує стегна та щиколотки. Заспокоює мозок, допомагає зняти стрес і втому. З опорою під голову й тулуб полегшує біль у спині та шиї."},
        {name: "Поза трупа", translation: "śava = труп, āsana = поза", description: "Ляжте на спину, ноги випрямлені, руки вздовж тіла долонями вгору. Заплющте очі, повністю розслабтеся, дихайте глибоко.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Розслабляє тіло. Зменшує головний біль, втому й безсоння. Допомагає знизити тиск."},
        {name: "Високий випад", translation: "ashta = бік, chandra = місяць, āsana = поза", description: "Зробіть крок однією ногою вперед, у випад. Заднє коліно опущене або підняте. На вдиху підніміть руки над головою. Опустіть таз, дивіться вперед, дихайте.", benefits: "Розтягує грудну клітку, руки й тулуб. Тонізує косі м’язи живота."},
        {name: "Ворона", translation: "baka = журавель, āsana = поза", description: "Присядьте, долоні на килимку на ширині плечей. Коліна на плечі рук. На видиху переносьте вагу вперед, підніміть стопи. Балансуйте, дивіться вперед, дихайте.", benefits: "Зміцнює руки та зап’ястя. Розтягує верх спини. Зміцнює м’язи преса. Розкриває пах. Тонізує органи черевної порожнини."},
        {name: "Дельфін", translation: "pīñcha = перо, mayūra = павич, āsana = поза", description: "Із собаки мордою вниз опустіться на передпліччя, лікті під плечима. Підніміть таз, тягніть п’яти до підлоги. Напружте прес, дивіться між руками, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Додає тілу енергії. Розтягує плечі, задню поверхню стегон, литки, склепіння стоп і кисті. Зміцнює руки та ноги. Полегшує симптоми менопаузи. З опорою під голову зменшує менструальний дискомфорт. Допомагає запобігти остеопорозу. Покращує травлення. Знімає головний біль, безсоння, біль у спині та втому. Корисна при підвищеному тиску, астмі, плоскостопості, ішіасі та синуситі. Розігріває щиколотки й пальці ніг."},
        {name: "Собака мордою вниз", translation: "parivṛtta = повернутий, adho = вниз, mukha = обличчя, śvāna = собака, āsana = поза", description: "Станьте на долоні й коліна. На видиху підніміть таз угору й назад. Випряміть ноги, тягніть п’яти до підлоги. Витягніть хребет, дивіться між ногами, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Додає тілу енергії. Розтягує плечі, шию, задню поверхню стегон, литки, склепіння стоп і кисті. Зміцнює руки та ноги. Полегшує симптоми менопаузи. З опорою під голову зменшує менструальний дискомфорт. Допомагає запобігти остеопорозу. Покращує травлення. Знімає головний біль, безсоння, біль у спині та втому. Корисна при підвищеному тиску, астмі, плоскостопості, ішіасі та синуситі."},
        {name: "Орел", translation: "garuḍa = орел, āsana = поза", description: "Станьте, перехрестіть праву ногу над лівою, зачепіть стопу за литку. Перехрестіть ліву руку над правою, з’єднайте долоні. Підніміть лікті, дивіться вперед, дихайте.", benefits: "Зміцнює й розтягує щиколотки та литки. Розтягує стегна, таз, плечі та верх спини. Покращує концентрацію. Покращує відчуття рівноваги."},
        {name: "Рука до великого пальця ноги", translation: "utthita = витягнутий, hasta = рука, pādāṅguṣṭha = великий палець ноги, āsana = поза", description: "Станьте, підніміть праву ногу, візьміться правою рукою за великий палець. Витягніть ногу вперед, таз рівно. Дивіться вперед, дихайте.", benefits: "Розкриває стегна й пах. Розтягує задню поверхню стегон, ілеотибіальний тракт і ноги. Покращує рівновагу."},
        {name: "Витягнутий бічний кут", translation: "utthita = витягнутий, pārśva = бік, koṇa = кут, āsana = поза", description: "Із воїна II зігніть переднє коліно глибше. Витягніть передню руку над головою, задню поставте на ногу або підлогу. Розкрийте груди, дивіться вгору, дихайте.", benefits: "Зміцнює й розтягує ноги, коліна та щиколотки. Розтягує пах, хребет, талію, груди, легені й плечі. Стимулює органи черевної порожнини. Підвищує витривалість."},
        {name: "Стійка на передпліччях", translation: "pīñcha = перо, mayūra = павич, āsana = поза", description: "Із дельфіна підійдіть стопами ближче. На видиху по черзі підніміть ноги, балансуйте на передпліччях. Напружте прес, дивіться вперед, дихайте.", benefits: "Зміцнює руки та плечі. Покращує зосередженість і рівновагу. Розтягує верх і низ спини. Зміцнює м’язи преса. Тонізує ділянку живота."},
        {name: "Нахил уперед із розкриттям плечей", translation: "uttāna = витягнутий, āsana = поза", description: "Станьте, нахиліться вперед, зчепіть руки за спиною. М’яко підніміть руки, розслабте голову. Дивіться вниз, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Стимулює печінку й нирки. Розтягує задню поверхню стегон, литки та таз. Зміцнює стегна й коліна. Покращує травлення. Полегшує симптоми менопаузи. Зменшує втому й тривогу. Знімає головний біль і безсоння. Розкриває плечі."},
        {name: "Півмісяць", translation: "ardha = половина, chandra = місяць, āsana = поза", description: "Із воїна III поставте долоню на підлогу біля передньої стопи. Підніміть задню ногу паралельно підлозі, протилежну руку витягніть угору. Розкрийте таз, дивіться вгору або вниз, дихайте.", benefits: "Зміцнює прес, щиколотки, стегна, сідниці й хребет. Розтягує пах, задню поверхню стегон, литки, плечі, груди й хребет. Покращує координацію та відчуття рівноваги. Допомагає зняти стрес. Покращує травлення."},
        {name: "Стійка на руках", translation: "adho = вниз, mukha = обличчя, vṛkṣa = дерево, āsana = поза", description: "Із собаки мордою вниз підійдіть стопами ближче. Перенесіть вагу, закиньте ноги вгору, випряміть їх. Напружте прес, дивіться вперед, дихайте.", benefits: "Зміцнює плечі, руки та зап’ястя. Розтягує живіт. Покращує відчуття рівноваги. Заспокоює мозок, допомагає зняти стрес і легку депресію."},
        {name: "Низький випад", translation: "aṅjaneya = хвала, āsana = поза", description: "Зробіть крок правою ногою вперед, у випад. Опустіть ліве коліно, руки на стегно або над головою. Опустіть таз, дивіться вперед, дихайте.", benefits: "Розтягує груди, легені, шию, живіт і пах (поперековий м’яз). Зміцнює плечі, руки та м’язи спини. Зміцнює й розтягує стегна, литки та щиколотки."},
        {name: "Голуб", translation: "supta = лежачи, kapota = голуб, āsana = поза", description: "Ляжте на спину, покладіть праву щиколотку на ліве коліно. Підтягніть ліве коліно до грудей. Спина притиснута до підлоги, дивіться вгору, дихайте.", benefits: "Розтягує задню й передню поверхні стегон. Якщо тиснути ліктем на стегно, розкриває ще й таз."},
        {name: "Королівський голуб", translation: "eka = один, pāda = стопа або нога, rāja = король, kapota = голуб, āsana = поза", description: "Із голуба зігніть заднє коліно, візьміться рукою за стопу. Підніміть груди, розкрийте серце. Дивіться вперед, дихайте.", benefits: "Розтягує стегна, пах (поперековий м’яз), живіт, груди, плечі та шию. Стимулює органи черевної порожнини. Розкриває плечі та груди."},
        {name: "Планка", translation: "phalaka = дошка, āsana = поза", description: "Із пози на долонях і колінах відставте стопи назад. Тіло рівне, долоні під плечима. Напружте прес, дивіться вниз, дихайте.", benefits: "Зміцнює руки, зап’ястя та хребет. Тонізує прес."},
        {name: "Плуг", translation: "hala = плуг, āsana = поза", description: "Ляжте на спину. На видиху заведіть ноги за голову, пальці ніг до підлоги позаду. Підтримуйте спину руками або зчепіть їх. Погляд усередину, дихайте.", benefits: "Заспокоює мозок. Стимулює органи черевної порожнини та щитоподібну залозу. Розтягує плечі й хребет. Полегшує симптоми менопаузи. Зменшує стрес і втому. Корисна при болю в спині, головному болю, безплідді, безсонні та синуситі."},
        {name: "Піраміда", translation: "pārśva = бік, uttāna = витягнутий, āsana = поза", description: "Праву ногу вперед, ліву назад. Нахиліться від таза над передньою ногою. Долоні на підлогу або на блоки. Дивіться вниз, дихайте.", benefits: "Заспокоює мозок. Розтягує хребет, плечі, таз і задню поверхню стегон. Зміцнює ноги. Стимулює органи черевної порожнини. Покращує поставу та відчуття рівноваги. Покращує травлення."},
        {name: "Зворотний воїн", translation: "pārśva = бік, vīrabhadra = воїн, āsana = поза", description: "Із воїна II витягніть передню руку вгору й назад. Ковзніть задньою рукою вниз по нозі. Розкрийте груди, дивіться вгору, дихайте.", benefits: "Зміцнює й розтягує ноги, коліна та щиколотки. Розтягує пах, хребет, талію, груди, легені й плечі. Стимулює органи черевної порожнини. Підвищує витривалість. Полегшує біль у спині, особливо в другому триместрі вагітності. Корисна при тунельному синдромі зап’ястя, плоскостопості, безплідді, остеопорозі та ішіасі."},
        {name: "Нахил уперед сидячи", translation: "paśchima = задня частина, uttāna = витягнутий, āsana = поза", description: "Сядьте, ноги випрямлені. На вдиху витягніть хребет. На видиху нахиліться вперед, дотягніться до стоп або гомілок. Спина довга, дивіться вперед, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Розтягує хребет, плечі та задню поверхню стегон. Стимулює печінку, нирки, яєчники й матку. Покращує травлення. Полегшує симптоми менопаузи та менструальний дискомфорт. Заспокоює головний біль і тривогу. Зменшує втому. Корисна при підвищеному тиску, безплідді, безсонні та синуситі. Традиційні тексти кажуть, що пашчимоттанасана підсилює апетит, зменшує ожиріння та зцілює хвороби."},
        {name: "Лотос", translation: "padma = лотос, āsana = поза", description: "Сядьте, покладіть праву стопу на ліве стегно, ліву на праве. Долоні на коліна, сидіть рівно, дихайте.", benefits: "Розкриває таз і пах, розтягує коліна, щиколотки та стегна. Зміцнює спину й заспокоює розум, зменшує стрес і тривогу. Покращує кровообіг у ділянці таза."},
        {name: "Половинний володар риб", translation: "ardha = половина, matsya = риба, indra = цар", description: "Сядьте, перекиньте праве коліно через ліве, скрутіться вправо. Лівий лікоть ззовні правого коліна, права рука позаду. Дивіться через плече, дихайте.", benefits: "Розтягує плечі, груди, стегна, пах і живіт. Зміцнює ноги та щиколотки. Покращує рівновагу."},
        {name: "Стійка на лопатках", translation: "sa = з, ālamba = опора, sarvāṅga = усе тіло, āsana = поза", description: "Ляжте на спину. На видиху підніміть ноги й таз угору, підтримуйте спину руками. Випряміть ноги, погляд усередину, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Стимулює щитоподібну й передміхурову залози та органи черевної порожнини. Розтягує плечі й шию. Тонізує ноги та сідниці. Покращує травлення. Полегшує симптоми менопаузи. Зменшує втому й безсоння. Корисна при астмі, безплідді та синуситі."},
        {name: "Бічна планка", translation: "vasiṣṭha = ім’я мудреця, āsana = поза", description: "Із планки перекотіться на зовнішнє ребро правої стопи. Поставте стопи одна на одну, підніміть ліву руку вгору. Напружте прес, дивіться вгору, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Розтягує плечі, задню поверхню стегон, литки та склепіння стоп. Зміцнює руки та ноги. Полегшує симптоми менопаузи. Допомагає запобігти остеопорозу. Покращує травлення. Знімає головний біль, безсоння, біль у спині та втому. Корисна при підвищеному тиску, астмі, плоскостопості, ішіасі."},
        {name: "Сфінкс", translation: "sālamba = з опорою, bhujaṅga = змія, āsana = поза", description: "Ляжте на живіт, передпліччя на килимку, лікті під плечима. На вдиху підніміть груди, опустіть плечі. Дивіться вперед, дихайте.", benefits: "Зміцнює хребет. Розтягує груди, легені, плечі та живіт. Стимулює органи черевної порожнини. Розкриває серце й легені."},
        {name: "Шпагат", translation: "hanumān = бог-мавпа, āsana = поза", description: "Із випаду ковзайте передньою стопою вперед, задньою назад. Опустіть таз, тримайте його рівно. Долоні на підлогу або на блоки. Дивіться вперед, дихайте.", benefits: "Розтягує стегна, їхню задню поверхню та пах. Стимулює органи черевної порожнини."},
        {name: "Поза гірлянди", translation: "mālā = гірлянда або намисто, āsana = поза", description: "Присядьте, стопи разом або нарізно. Лікті всередині колін, долоні біля серця. Розводьте коліна, опустіть таз, дивіться вперед, дихайте.", benefits: "Розтягує щиколотки, пах і спину. Тонізує живіт."},
        {name: "Нахил уперед стоячи", translation: "uttāna = витягнутий, āsana = поза", description: "Станьте, нахиліться вперед, долоні до підлоги або гомілок. Спина довга, голова важка. Дивіться вниз, дихайте.", benefits: "Заспокоює мозок, допомагає зняти стрес і легку депресію. Стимулює печінку й нирки. Розтягує задню поверхню стегон, литки та таз. Зміцнює стегна й коліна. Покращує травлення. Полегшує симптоми менопаузи. Зменшує втому й тривогу. Знімає головний біль і безсоння."},
        {name: "Молодий місяць", translation: "ashta = бік, chandra = місяць, āsana = поза", description: "Станьте, зчепіть руки над головою. На вдиху нахиліться в один бік, розтягуючи протилежний. Дивіться вгору, дихайте.", benefits: "Розтягує грудну клітку, руки й тулуб. Тонізує косі м’язи живота."},
        {name: "Поперечний шпагат", translation: "upaviṣṭha = сидячий, koṇa = кут, āsana = поза", description: "Сядьте, ноги широко. На видиху переставляйте руки вперед, опускайте тулуб. Спина довга, дивіться вниз, дихайте.", benefits: "Розтягує внутрішню й задню поверхні ніг. Стимулює органи черевної порожнини. Зміцнює хребет. Заспокоює мозок. Розслабляє пах."},
        {name: "Дерево", translation: "vṛkṣa = дерево, āsana = поза", description: "Станьте, поставте праву стопу на ліве стегно або литку. Долоні разом над головою або біля грудей. Балансуйте, дивіться вперед, дихайте.", benefits: "Зміцнює ноги, щиколотки та стопи. Покращує гнучкість таза й колін. Покращує рівновагу."},
        {name: "Трикутник", translation: "trikoṇa = трикутник, āsana = поза", description: "Станьте широко, розверніть праву стопу назовні. Опустіть праву руку до гомілки або підлоги, ліву підніміть угору. Розкрийте груди, дивіться вгору, дихайте.", benefits: "Розтягує й зміцнює стегна, коліна та щиколотки. Розтягує таз, пах, задню поверхню стегон, литки, плечі, груди й хребет. Стимулює органи черевної порожнини. Допомагає зняти стрес. Покращує травлення. Полегшує симптоми менопаузи. Полегшує біль у спині, особливо в другому триместрі вагітності. Корисна при тривозі, плоскостопості, безплідді, болю в шиї, остеопорозі та ішіасі."},
        {name: "Собака мордою вгору", translation: "ūrdhva = вгору, mukha = обличчя, śvāna = собака, āsana = поза", description: "Ляжте на живіт, долоні біля плечей. На вдиху підніміть груди й стегна, відведіть плечі назад. Дивіться вперед, дихайте.", benefits: "Покращує поставу. Зміцнює хребет, руки та зап’ястя. Розтягує груди, легені, плечі та живіт. Зміцнює сідниці. Стимулює органи черевної порожнини. Допомагає при легкій депресії, втомі та ішіасі. Корисна при астмі."},
        {name: "Воїн I", translation: "vīrabhadra = воїн, āsana = поза", description: "Відставте ліву ногу назад, зігніть праве коліно під прямим кутом. Підніміть руки над головою, опустіть таз. Дивіться вперед, дихайте.", benefits: "Розтягує груди, легені, плечі, шию, живіт і пах (поперековий м’яз). Зміцнює плечі, руки та м’язи спини. Зміцнює й розтягує стегна, литки та щиколотки."},
        {name: "Воїн II", translation: "vīrabhadra = воїн, āsana = поза", description: "Відставте ліву ногу назад, зігніть праве коліно під прямим кутом. Руки паралельно підлозі, опустіть таз. Дивіться поверх правої руки, дихайте.", benefits: "Зміцнює й розтягує ноги та щиколотки. Розтягує пах, груди, легені й плечі. Стимулює органи черевної порожнини. Підвищує витривалість. Полегшує біль у спині, особливо в другому триместрі вагітності. Корисна при тунельному синдромі зап’ястя, плоскостопості, безплідді, остеопорозі та ішіасі."},
        {name: "Воїн III", translation: "vīrabhadra = воїн, āsana = поза", description: "Станьте, перенесіть вагу на праву ногу. Підніміть ліву ногу назад паралельно підлозі, руки вперед або в сторони. Балансуйте, дивіться вниз, дихайте.", benefits: "Зміцнює щиколотки та ноги. Зміцнює плечі й м’язи спини. Тонізує прес. Покращує рівновагу та поставу."},
        {name: "Колесо", translation: "ūrdhva = вгору, dhanu = лук, āsana = поза", description: "Ляжте на спину, коліна зігнуті, долоні біля вух. На видиху підніміть таз і груди, утворивши арку. Дивіться вгору й рівно дихайте.", benefits: "Зміцнює руки, зап’ястя, ноги, сідниці, прес і хребет. Стимулює щитоподібну залозу та гіпофіз. Додає енергії, допомагає протидіяти депресії, корисна при астмі, болю в спині, безплідді та остеопорозі."},
        {name: "Дике створіння", translation: "camatkāra = вражений дивом, āsana = поза", description: "Почніть у собаці мордою вниз, підніміть праву ногу й розкрийте таз. Поставте праву долоню біля передньої стопи, підніміть ліву руку, прогніть спину, дивіться вгору й глибоко дихайте.", benefits: "Розтягує груди, плечі, спину та горло. Зміцнює й розкриває таз, згиначі стегна та стегна."}
      ]
      sessionText: [
        {name: "М’який старт", description: "Заспокійлива послідовність для початківців: базові пози й увага до дихання, щоб легко увійти в йогу."},
        {name: "Ранкове пробудження", description: "Послідовність для початківців, що додає енергії та розтягує тіло на весь день."},
        {name: "Спокійні основи", description: "Заспокійлива послідовність для початківців, щоб розслабитися й відновитися в м’яких позах."},
        {name: "Рівновага з нуля", description: "Послідовність для початківців, що розвиває рівновагу й силу в позах стоячи та сидячи."},
        {name: "Прес і розтяжка", description: "Послідовність для початківців, що зміцнює м’язи кора та покращує гнучкість простими позами."},
        {name: "Сильний кор", description: "Динамічна послідовність середнього рівня для стабільності та сили кора."},
        {name: "Розкриття таза", description: "Послідовність середнього рівня, що глибоко розтягує й розкриває таз для більшої гнучкості."},
        {name: "Скручування й енергія", description: "Послідовність скручувань середнього рівня, що очищує й додає енергії."},
        {name: "Виклик рівновазі", description: "Послідовність середнього рівня, що покращує рівновагу й координацію в позах стоячи."},
        {name: "Енергійний потік", description: "Енергійний потік середнього рівня, що розвиває витривалість і силу через динамічні переходи."},
        {name: "Відкрите серце", description: "Послідовність середнього рівня з прогинами, що розкриває груди й зміцнює спину."},
        {name: "Кор і стабільність", description: "Послідовність середнього рівня, що поєднує роботу з кором і пози на рівновагу для загальної стабільності."},
        {name: "Гнучкість сидячи", description: "Послідовність середнього рівня з поз сидячи, що поглиблює гнучкість таза й задньої поверхні стегон."},
        {name: "Сила воїна", description: "Послідовність середнього рівня з позами воїна, що розвиває силу та впевненість."},
        {name: "Енергія й рівновага", description: "Бадьора послідовність середнього рівня, що додає життєвих сил і покращує рівновагу."},
        {name: "Інтенсив для кора", description: "Просунута послідовність зі складними позами, що інтенсивно зміцнює кор."},
        {name: "Світ перевернутих поз", description: "Просунута послідовність, щоб опанувати перевернуті пози, розвиваючи силу й контроль."},
        {name: "Гнучкість без меж", description: "Просунута послідовність, що розсуває межі гнучкості глибокими розтяжками та шпагатами."},
        {name: "Баланс на руках", description: "Просунута послідовність балансів на руках, що зміцнює верхню частину тіла."},
        {name: "Глибокі прогини", description: "Просунута послідовність, що поглиблює прогини й розкриває груди та хребет."},
        {name: "Найвищий потік", description: "Повний просунутий потік, що поєднує силу, рівновагу та гнучкість."},
        {name: "Точність і сила", description: "Просунута послідовність з акцентом на точне вирівнювання та потужні пози."},
        {name: "Таз і серце", description: "Просунута послідовність, що глибоко розкриває таз і серце для гнучкості та емоційного звільнення."},
        {name: "Сила й контроль", description: "Просунута послідовність зі складними позами, що розвиває силу й контроль."},
        {name: "Майстерність йоги", description: "Просунута послідовність для досвідчених практиків, що випробовує силу, рівновагу та гнучкість."},
        {name: "Блаженний потік для початківців", description: "Повна послідовність для початківців, що гармонійно веде через розминку, пози стоячи на силу й рівновагу, м’які прогини, нахили вперед, розкриття таза та відновлювальні пози, щоб закласти міцну основу."}
      ]
    }
    fr {
      title: "yoga"
      sessions: "séances"; poses: "postures"
      levels: {beginner: "débutant", intermediate: "intermédiaire", advanced: "avancé"}
      ranks: {novice: "Novice", practitioner: "Pratiquant", adept: "Adepte", devotee: "Fervent", teacher: "Enseignant", master: "Maître"}
      paces: {swift: "rapide", balanced: "équilibré", endurance: "endurance"}
      levelRank: (n, rank) => "niveau ${n} · ${rank}"
      streak: n => n < 2 ? "${n} jour d’affilée" : "${n} jours d’affilée"
      xpLine: (xp, need, next) => "${xp} xp · ${need} avant le niveau ${next}"
      completed: "faite"
      sessionLine: (level, n, time) => "${level} · ${n} postures · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · tenir ${time} · des deux côtés" : "${level} · tenir ${time}"
      how: "comment"; benefits: "bienfaits"; inSessions: "dans les séances"
      startArrow: "lancer ›"
      getReady: "prépare-toi"
      first: name => "d’abord : ${name}"
      introLine: (n, time) => "${n} postures · ${time} à ce rythme"
      startNow: "commencer"
      poseOf: (i, n) => "posture ${i} sur ${n}"
      voiceOn: "voix activée"; voiceOff: "voix coupée"
      nextPose: "posture suivante"; paused: "en pause"; readyNext: "prépare-toi pour la suivante…"
      firstSide: "premier côté"; secondSide: "second côté"; lastPose: "dernière posture"
      quitAsk: "quitter cette séance ?"; keepGoing: "continuer"; quit: "quitter"
      resume: "reprendre"; pause: "pause"; skip: "passer"
      greatJob: "bravo"
      levelUp: (n, rank) => "niveau ${n} : ${rank}"
      xpHint: "les xp arrivent avec la première séance du jour"
      done: "terminé"; again: "recommencer"
      poseText: [
        {name: "Bateau", translation: "nāva = bateau, āsana = posture", description: "Assieds-toi, jambes tendues. Expire, lève les jambes à 45 degrés, penche-toi un peu en arrière. Tends les bras devant toi, paumes face à face. Équilibre-toi sur les ischions, engage la sangle abdominale. Regarde tes orteils, respire.", benefits: "Renforce l’abdomen, les fléchisseurs de la hanche et la colonne. Stimule les reins, la thyroïde, la prostate et les intestins. Aide à soulager le stress. Améliore la digestion."},
        {name: "Demi-bateau", translation: "ardha = moitié, nāva = bateau, āsana = posture", description: "Assieds-toi, genoux pliés, pieds décollés. Penche-toi un peu en arrière, tiens l’arrière des cuisses ou tends les bras. Équilibre-toi, engage la sangle abdominale, regarde devant toi, respire.", benefits: "Renforce l’abdomen, les fléchisseurs de la hanche et la colonne. Stimule les reins, la thyroïde, la prostate et les intestins. Aide à soulager le stress. Améliore la digestion."},
        {name: "Arc", translation: "dhanur = arc, āsana = posture", description: "Allonge-toi sur le ventre. Plie les genoux, attrape tes chevilles. Inspire, soulève la poitrine et les cuisses, pousse les pieds dans les mains. Regarde devant toi, respire.", benefits: "Étire tout l’avant du corps : chevilles, cuisses et aines, abdomen et poitrine, gorge et fléchisseurs profonds de la hanche (psoas). Renforce les muscles du dos. Améliore la posture. Stimule les organes de l’abdomen et du cou."},
        {name: "Pont", translation: "setu = pont, bandha = verrou, sarva = tout, āṅga = membre, āsana = posture", description: "Allonge-toi sur le dos, genoux pliés, pieds écartés à largeur de hanches. Inspire, soulève les hanches, joins les mains sous le dos. Rentre les épaules dessous, ouvre la poitrine. Regarde vers le haut, respire.", benefits: "Étire la poitrine, le cou et la colonne. Stimule les organes abdominaux, les poumons et la thyroïde. Revitalise les jambes fatiguées. Améliore la digestion. Aide à soulager les symptômes de la ménopause. Soulage les douleurs menstruelles avec un support. Réduit l’anxiété, la fatigue, le mal de dos, le mal de tête et l’insomnie. Bénéfique en cas d’asthme, d’hypertension, d’ostéoporose et de sinusite."},
        {name: "Papillon", translation: "baddha = lié, koṇa = angle, āsana = posture", description: "Assieds-toi, plantes de pieds jointes, genoux vers l’extérieur. Tiens tes pieds, grandis-toi. Relâche les épaules, respire profondément.", benefits: "Ouvre les hanches et les aines. Étire les épaules, la cage thoracique et le dos. Stimule les organes abdominaux, les poumons et le cœur."},
        {name: "Chameau", translation: "uṣṭra = chameau, āsana = posture", description: "Mets-toi à genoux, mains sur le bas du dos. Inspire, soulève la poitrine, attrape les talons si c’est confortable. Garde la nuque neutre, regarde devant toi, respire.", benefits: "Étire tout l’avant du corps : chevilles, cuisses et aines, abdomen et poitrine, gorge. Étire les fléchisseurs profonds de la hanche (psoas). Renforce les muscles du dos. Améliore la posture. Stimule les organes de l’abdomen et du cou."},
        {name: "Chat", translation: "marjarya = chat, āsana = posture", description: "À quatre pattes. Expire, arrondis le dos vers le haut, rentre le menton. Engage la sangle abdominale, regarde ton ventre, respire.", benefits: "Soulage la colonne et le cou. Donne de l’énergie au corps."},
        {name: "Vache", translation: "bitil = vache, āsana = posture", description: "À quatre pattes. Inspire, creuse le dos, lève le coccyx et la poitrine. Regarde vers le haut, respire.", benefits: "Chasse la fatigue. Améliore la respiration et la circulation du sang vers le cerveau. Revitalise tout le corps."},
        {name: "Chaise", translation: "utkaṭa = puissant, āsana = posture", description: "Debout, pieds joints. Inspire, plie les genoux comme pour t’asseoir, lève les bras au-dessus de la tête. Poids dans les talons, regarde devant toi, respire.", benefits: "Renforce les chevilles, les cuisses, les mollets et la colonne. Étire les épaules et la poitrine. Stimule les organes abdominaux, le diaphragme et le cœur. Atténue les pieds plats. Donne de l’énergie à tout le corps."},
        {name: "Posture de l’enfant", translation: "bala = enfant, āsana = posture", description: "À genoux, gros orteils joints, genoux écartés. Expire, penche-toi en avant, bras tendus. Front sur le tapis, détends-toi, respire.", benefits: "Étire en douceur les hanches, les cuisses et les chevilles. Calme le mental et aide à soulager le stress et la fatigue. Soulage le dos et la nuque avec la tête et le buste soutenus."},
        {name: "Cadavre", translation: "śava = cadavre, āsana = posture", description: "Allonge-toi sur le dos, jambes tendues, bras le long du corps, paumes vers le haut. Ferme les yeux, relâche tout, respire profondément.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Détend le corps. Réduit les maux de tête, la fatigue et l’insomnie. Aide à faire baisser la tension."},
        {name: "Fente en croissant", translation: "ashta = côté, chandra = lune, āsana = posture", description: "Avance un pied, descends en fente. Genou arrière posé ou décollé. Inspire, lève les bras au-dessus de la tête. Descends les hanches, regarde devant toi, respire.", benefits: "Étire la cage thoracique, les bras et le buste. Tonifie les obliques."},
        {name: "Corbeau", translation: "baka = grue, āsana = posture", description: "Accroupis-toi, mains sur le tapis, à largeur d’épaules. Genoux sur le haut des bras. Expire, bascule vers l’avant, décolle les pieds. Équilibre-toi, regarde devant toi, respire.", benefits: "Renforce les bras et les poignets. Étire le haut du dos. Renforce les abdominaux. Ouvre l’aine. Tonifie les organes abdominaux."},
        {name: "Dauphin", translation: "pīñcha = plume, mayūra = paon, āsana = posture", description: "Depuis le chien tête en bas, descends sur les avant-bras, coudes sous les épaules. Monte les hanches, pousse les talons vers le sol. Engage la sangle abdominale, regarde entre tes mains, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Donne de l’énergie au corps. Étire les épaules, les ischio-jambiers, les mollets, les voûtes plantaires et les mains. Renforce les bras et les jambes. Aide à soulager les symptômes de la ménopause. Soulage les douleurs menstruelles avec la tête soutenue. Aide à prévenir l’ostéoporose. Améliore la digestion. Soulage les maux de tête, l’insomnie, le mal de dos et la fatigue. Bénéfique en cas d’hypertension, d’asthme, de pieds plats, de sciatique et de sinusite. Échauffe les chevilles et les orteils."},
        {name: "Chien tête en bas", translation: "parivṛtta = tourné, adho = vers le bas, mukha = visage, śvāna = chien, āsana = posture", description: "À quatre pattes. Expire, monte les hanches vers le haut et l’arrière. Tends les jambes, pousse les talons vers le sol. Allonge la colonne, regarde entre tes jambes, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Donne de l’énergie au corps. Étire les épaules, le cou, les ischio-jambiers, les mollets, les voûtes plantaires et les mains. Renforce les bras et les jambes. Aide à soulager les symptômes de la ménopause. Soulage les douleurs menstruelles avec la tête soutenue. Aide à prévenir l’ostéoporose. Améliore la digestion. Soulage les maux de tête, l’insomnie, le mal de dos et la fatigue. Bénéfique en cas d’hypertension, d’asthme, de pieds plats, de sciatique et de sinusite."},
        {name: "Aigle", translation: "garuḍa = aigle, āsana = posture", description: "Debout, croise la jambe droite sur la gauche, accroche le pied derrière le mollet. Croise le bras gauche sur le droit, joins les paumes. Lève les coudes, regarde devant toi, respire.", benefits: "Renforce et étire les chevilles et les mollets. Étire les cuisses, les hanches, les épaules et le haut du dos. Améliore la concentration. Améliore l’équilibre."},
        {name: "Main au gros orteil", translation: "utthita = étendu, hasta = main, pādāṅguṣṭha = gros orteil, āsana = posture", description: "Debout, lève la jambe droite, attrape le gros orteil avec la main droite. Tends la jambe devant toi, hanches de face. Regarde devant toi, respire.", benefits: "Ouvre les hanches et les aines. Étire les ischio-jambiers, les bandelettes ilio-tibiales et les jambes. Améliore l’équilibre."},
        {name: "Angle latéral étiré", translation: "utthita = étendu, pārśva = côté, koṇa = angle, āsana = posture", description: "Depuis le guerrier II, plie davantage le genou avant. Tends le bras du dessus au-dessus de la tête, main du bas sur la jambe ou au sol. Ouvre la poitrine, regarde vers le haut, respire.", benefits: "Renforce et étire les jambes, les genoux et les chevilles. Étire l’aine, la colonne, la taille, la poitrine, les poumons et les épaules. Stimule les organes abdominaux. Augmente l’endurance."},
        {name: "Équilibre sur les avant-bras", translation: "pīñcha = plume, mayūra = paon, āsana = posture", description: "Depuis le dauphin, rapproche les pieds. Expire, monte les jambes l’une après l’autre, équilibre-toi sur les avant-bras. Engage la sangle abdominale, regarde devant toi, respire.", benefits: "Renforce les bras et les épaules. Améliore la concentration et l’équilibre. Étire le haut et le bas du dos. Renforce les abdominaux. Tonifie la zone abdominale."},
        {name: "Flexion avant, épaules ouvertes", translation: "uttāna = étirement intense, āsana = posture", description: "Debout, penche-toi en avant, croise les doigts derrière le dos. Lève doucement les bras, relâche la tête. Regarde vers le bas, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Stimule le foie et les reins. Étire les ischio-jambiers, les mollets et les hanches. Renforce les cuisses et les genoux. Améliore la digestion. Aide à soulager les symptômes de la ménopause. Réduit la fatigue et l’anxiété. Soulage les maux de tête et l’insomnie. Ouvre les épaules."},
        {name: "Demi-lune", translation: "ardha = moitié, chandra = lune, āsana = posture", description: "Depuis le guerrier III, pose la main au sol à côté du pied avant. Monte la jambe arrière à l’horizontale, tends le bras opposé vers le haut. Ouvre les hanches, regarde en haut ou en bas, respire.", benefits: "Renforce l’abdomen, les chevilles, les cuisses, les fessiers et la colonne. Étire les aines, les ischio-jambiers, les mollets, les épaules, la poitrine et la colonne. Améliore la coordination et l’équilibre. Aide à soulager le stress. Améliore la digestion."},
        {name: "Équilibre sur les mains", translation: "adho = vers le bas, mukha = visage, vṛkṣa = arbre, āsana = posture", description: "Depuis le chien tête en bas, rapproche les pieds. Transfère le poids, lance les jambes vers le haut, tends-les. Engage la sangle abdominale, regarde devant toi, respire.", benefits: "Renforce les épaules, les bras et les poignets. Étire le ventre. Améliore l’équilibre. Calme le mental et aide à soulager le stress et la déprime légère."},
        {name: "Fente basse", translation: "aṅjaneya = louange, āsana = posture", description: "Avance le pied droit, descends en fente. Pose le genou gauche, mains sur la cuisse ou au-dessus de la tête. Descends les hanches, regarde devant toi, respire.", benefits: "Étire la poitrine, les poumons, le cou, le ventre et l’aine (psoas). Renforce les épaules, les bras et les muscles du dos. Renforce et étire les cuisses, les mollets et les chevilles."},
        {name: "Pigeon", translation: "supta = allongé, kapota = pigeon, āsana = posture", description: "Allonge-toi sur le dos, croise la cheville droite sur le genou gauche. Ramène le genou gauche vers la poitrine. Garde le dos au sol, regarde vers le haut, respire.", benefits: "Étire les ischio-jambiers et les quadriceps. Si tu pousses la cuisse avec le coude, ouvre aussi les hanches."},
        {name: "Roi pigeon", translation: "eka = un, pāda = pied ou jambe, rāja = roi, kapota = pigeon, āsana = posture", description: "Depuis le pigeon, plie le genou arrière, attrape le pied avec la main. Soulève la poitrine, ouvre le cœur. Regarde devant toi, respire.", benefits: "Étire les cuisses, les aines (psoas), l’abdomen, la poitrine, les épaules et le cou. Stimule les organes abdominaux. Ouvre les épaules et la poitrine."},
        {name: "Planche", translation: "phalaka = planche, āsana = posture", description: "À quatre pattes, recule les pieds. Corps bien droit, mains sous les épaules. Engage la sangle abdominale, regarde vers le bas, respire.", benefits: "Renforce les bras, les poignets et la colonne. Tonifie l’abdomen."},
        {name: "Charrue", translation: "hala = charrue, āsana = posture", description: "Allonge-toi sur le dos. Expire, passe les jambes au-dessus de la tête, orteils au sol derrière. Soutiens le dos ou joins les mains. Regard intérieur, respire.", benefits: "Calme le mental. Stimule les organes abdominaux et la thyroïde. Étire les épaules et la colonne. Aide à soulager les symptômes de la ménopause. Réduit le stress et la fatigue. Bénéfique en cas de mal de dos, de maux de tête, d’infertilité, d’insomnie et de sinusite."},
        {name: "Pyramide", translation: "pārśva = côté, uttāna = étirement intense, āsana = posture", description: "Avance le pied droit, recule le gauche. Bascule depuis les hanches, penche-toi sur la jambe avant. Mains au sol ou sur des briques. Regarde vers le bas, respire.", benefits: "Calme le mental. Étire la colonne, les épaules, les hanches et les ischio-jambiers. Renforce les jambes. Stimule les organes abdominaux. Améliore la posture et l’équilibre. Améliore la digestion."},
        {name: "Guerrier inversé", translation: "pārśva = côté, vīrabhadra = guerrier, āsana = posture", description: "Depuis le guerrier II, tends le bras avant au-dessus de la tête et vers l’arrière. Fais glisser la main arrière le long de la jambe. Ouvre la poitrine, regarde vers le haut, respire.", benefits: "Renforce et étire les jambes, les genoux et les chevilles. Étire l’aine, la colonne, la taille, la poitrine, les poumons et les épaules. Stimule les organes abdominaux. Augmente l’endurance. Soulage le mal de dos, surtout au deuxième trimestre de grossesse. Bénéfique en cas de syndrome du canal carpien, de pieds plats, d’infertilité, d’ostéoporose et de sciatique."},
        {name: "Pince assise", translation: "paśchima = dos, uttāna = étirement intense, āsana = posture", description: "Assieds-toi, jambes tendues. Inspire, allonge la colonne. Expire, penche-toi en avant, attrape les pieds ou les tibias. Garde la colonne longue, regarde devant toi, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Étire la colonne, les épaules et les ischio-jambiers. Stimule le foie, les reins, les ovaires et l’utérus. Améliore la digestion. Aide à soulager les symptômes de la ménopause et les douleurs menstruelles. Apaise les maux de tête et l’anxiété. Réduit la fatigue. Bénéfique en cas d’hypertension, d’infertilité, d’insomnie et de sinusite. Selon les textes traditionnels, paschimottanasana ouvre l’appétit, réduit l’obésité et guérit les maladies."},
        {name: "Lotus", translation: "padma = lotus, āsana = posture", description: "Assieds-toi, pose le pied droit sur la cuisse gauche, le pied gauche sur la droite. Mains sur les genoux, grandis-toi, respire.", benefits: "Ouvre les hanches et l’aine, étire les genoux, les chevilles et les cuisses. Renforce le dos et calme l’esprit, réduit le stress et l’anxiété. Améliore la circulation sanguine dans le bassin."},
        {name: "Demi-seigneur des poissons", translation: "ardha = moitié, matsya = poisson, indra = roi", description: "Assieds-toi, croise le genou droit par-dessus le gauche, tourne-toi vers la droite. Coude gauche à l’extérieur du genou droit, main droite derrière toi. Regarde par-dessus l’épaule, respire.", benefits: "Étire les épaules, la poitrine, les cuisses, les aines et l’abdomen. Renforce les jambes et les chevilles. Améliore l’équilibre."},
        {name: "Chandelle", translation: "sa = avec, ālamba = soutien, sarvāṅga = tout le corps, āsana = posture", description: "Allonge-toi sur le dos. Expire, monte les jambes et les hanches, soutiens le dos avec les mains. Tends les jambes, regard intérieur, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Stimule la thyroïde, la prostate et les organes abdominaux. Étire les épaules et le cou. Tonifie les jambes et les fessiers. Améliore la digestion. Aide à soulager les symptômes de la ménopause. Réduit la fatigue et atténue l’insomnie. Bénéfique en cas d’asthme, d’infertilité et de sinusite."},
        {name: "Planche latérale", translation: "vasiṣṭha = nom d’un sage, āsana = posture", description: "Depuis la planche, bascule sur le bord extérieur du pied droit. Superpose les pieds, lève le bras gauche. Engage la sangle abdominale, regarde vers le haut, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Étire les épaules, les ischio-jambiers, les mollets et les voûtes plantaires. Renforce les bras et les jambes. Aide à soulager les symptômes de la ménopause. Aide à prévenir l’ostéoporose. Améliore la digestion. Soulage les maux de tête, l’insomnie, le mal de dos et la fatigue. Bénéfique en cas d’hypertension, d’asthme, de pieds plats et de sciatique."},
        {name: "Sphinx", translation: "sālamba = soutenu, bhujaṅga = serpent, āsana = posture", description: "Allonge-toi sur le ventre, avant-bras sur le tapis, coudes sous les épaules. Inspire, soulève la poitrine, abaisse les épaules. Regarde devant toi, respire.", benefits: "Renforce la colonne. Étire la poitrine, les poumons, les épaules et l’abdomen. Stimule les organes abdominaux. Ouvre le cœur et les poumons."},
        {name: "Grand écart", translation: "hanumān = dieu singe, āsana = posture", description: "Depuis la fente basse, glisse le pied avant vers l’avant, le pied arrière vers l’arrière. Descends les hanches, garde-les de face. Mains au sol ou sur des briques. Regarde devant toi, respire.", benefits: "Étire les cuisses, les ischio-jambiers et l’aine. Stimule les organes abdominaux."},
        {name: "Guirlande", translation: "mālā = guirlande ou collier, āsana = posture", description: "Accroupis-toi, pieds joints ou écartés. Coudes à l’intérieur des genoux, paumes jointes devant le cœur. Pousse les genoux vers l’extérieur, descends les hanches, regarde devant toi, respire.", benefits: "Étire les chevilles, les aines et l’arrière du buste. Tonifie le ventre."},
        {name: "Pince debout", translation: "uttāna = étirement intense, āsana = posture", description: "Debout, penche-toi en avant, mains au sol ou sur les tibias. Garde la colonne longue, la tête lourde. Regarde vers le bas, respire.", benefits: "Calme le mental et aide à soulager le stress et la déprime légère. Stimule le foie et les reins. Étire les ischio-jambiers, les mollets et les hanches. Renforce les cuisses et les genoux. Améliore la digestion. Aide à soulager les symptômes de la ménopause. Réduit la fatigue et l’anxiété. Soulage les maux de tête et l’insomnie."},
        {name: "Croissant de lune", translation: "ashta = côté, chandra = lune, āsana = posture", description: "Debout, joins les mains au-dessus de la tête. Inspire, penche-toi sur un côté, étire le côté opposé. Regarde vers le haut, respire.", benefits: "Étire la cage thoracique, les bras et le buste. Tonifie les obliques."},
        {name: "Grand écart latéral", translation: "upaviṣṭha = assis, koṇa = angle, āsana = posture", description: "Assieds-toi, jambes très écartées. Expire, avance les mains, descends le buste. Garde la colonne longue, regarde vers le bas, respire.", benefits: "Étire l’intérieur et l’arrière des jambes. Stimule les organes abdominaux. Renforce la colonne. Calme le mental. Libère l’aine."},
        {name: "Arbre", translation: "vṛkṣa = arbre, āsana = posture", description: "Debout, pose le pied droit sur la cuisse ou le mollet gauche. Paumes jointes au-dessus de la tête ou devant la poitrine. Équilibre-toi, regarde devant toi, respire.", benefits: "Renforce les jambes, les chevilles et les pieds. Assouplit les hanches et les genoux. Améliore l’équilibre."},
        {name: "Triangle", translation: "trikoṇa = triangle, āsana = posture", description: "Debout, jambes écartées, tourne le pied droit vers l’extérieur. Descends la main droite vers le tibia ou le sol, bras gauche vers le haut. Ouvre la poitrine, regarde vers le haut, respire.", benefits: "Étire et renforce les cuisses, les genoux et les chevilles. Étire les hanches, l’aine, les ischio-jambiers, les mollets, les épaules, la poitrine et la colonne. Stimule les organes abdominaux. Aide à soulager le stress. Améliore la digestion. Aide à soulager les symptômes de la ménopause. Soulage le mal de dos, surtout au deuxième trimestre de grossesse. Bénéfique en cas d’anxiété, de pieds plats, d’infertilité, de douleurs au cou, d’ostéoporose et de sciatique."},
        {name: "Chien tête en haut", translation: "ūrdhva = vers le haut, mukha = visage, śvāna = chien, āsana = posture", description: "Allonge-toi sur le ventre, mains près des épaules. Inspire, soulève la poitrine et les cuisses, roule les épaules vers l’arrière. Regarde devant toi, respire.", benefits: "Améliore la posture. Renforce la colonne, les bras et les poignets. Étire la poitrine, les poumons, les épaules et l’abdomen. Raffermit les fessiers. Stimule les organes abdominaux. Aide à soulager la déprime légère, la fatigue et la sciatique. Bénéfique en cas d’asthme."},
        {name: "Guerrier I", translation: "vīrabhadra = guerrier, āsana = posture", description: "Recule le pied gauche, plie le genou droit à 90 degrés. Lève les bras au-dessus de la tête, descends les hanches. Regarde devant toi, respire.", benefits: "Étire la poitrine, les poumons, les épaules, le cou, le ventre et l’aine (psoas). Renforce les épaules, les bras et les muscles du dos. Renforce et étire les cuisses, les mollets et les chevilles."},
        {name: "Guerrier II", translation: "vīrabhadra = guerrier, āsana = posture", description: "Recule le pied gauche, plie le genou droit à 90 degrés. Bras à l’horizontale, descends les hanches. Regarde au-delà de ta main droite, respire.", benefits: "Renforce et étire les jambes et les chevilles. Étire l’aine, la poitrine, les poumons et les épaules. Stimule les organes abdominaux. Augmente l’endurance. Soulage le mal de dos, surtout au deuxième trimestre de grossesse. Bénéfique en cas de syndrome du canal carpien, de pieds plats, d’infertilité, d’ostéoporose et de sciatique."},
        {name: "Guerrier III", translation: "vīrabhadra = guerrier, āsana = posture", description: "Debout, porte le poids sur la jambe droite. Monte la jambe gauche vers l’arrière à l’horizontale, bras devant toi ou sur les côtés. Équilibre-toi, regarde vers le bas, respire.", benefits: "Renforce les chevilles et les jambes. Renforce les épaules et les muscles du dos. Tonifie l’abdomen. Améliore l’équilibre et la posture."},
        {name: "Roue", translation: "ūrdhva = vers le haut, dhanu = arc, āsana = posture", description: "Allonge-toi sur le dos, genoux pliés, mains posées près des oreilles. Expire, puis soulève les hanches et la poitrine pour former une arche. Regarde vers le haut et respire calmement.", benefits: "Renforce les bras, les poignets, les jambes, les fessiers, les abdominaux et la colonne. Stimule la thyroïde et l’hypophyse. Donne de l’énergie, aide à lutter contre la déprime, et se montre bénéfique en cas d’asthme, de mal de dos, d’infertilité et d’ostéoporose."},
        {name: "Wild Thing", translation: "camatkāra = frappé d’émerveillement, āsana = posture", description: "Commence en chien tête en bas, puis lève la jambe droite et ouvre les hanches. Pose la main droite à côté du pied avant, lève le bras gauche, cambre le dos, regarde vers le haut et respire profondément.", benefits: "Étire la poitrine, les épaules, le dos et la gorge. Renforce et ouvre les hanches, les fléchisseurs de la hanche et les cuisses."}
      ]
      sessionText: [
        {name: "Flow doux pour débuter", description: "Un enchaînement apaisant pour débuter le yoga en douceur, avec les postures de base et l’attention au souffle."},
        {name: "Réveil matinal", description: "Un enchaînement accessible aux débutants pour réveiller et étirer le corps avant la journée."},
        {name: "Bases tout en calme", description: "Un enchaînement débutant apaisant pour te détendre et récupérer avec des postures douces."},
        {name: "Fondations équilibrées", description: "Un enchaînement débutant pour gagner en équilibre et en force avec des postures debout et assises."},
        {name: "Gainage et étirements", description: "Un enchaînement débutant pour renforcer la sangle abdominale et gagner en souplesse avec des postures simples."},
        {name: "Gainage intermédiaire", description: "Un enchaînement intermédiaire dynamique pour construire la stabilité et la force du centre."},
        {name: "Flow ouverture des hanches", description: "Un enchaînement intermédiaire pour étirer et ouvrir les hanches en profondeur et gagner en souplesse."},
        {name: "Torsions et énergie", description: "Un enchaînement intermédiaire de torsions pour détoxifier le corps et faire le plein d’énergie."},
        {name: "Défi équilibre", description: "Un enchaînement intermédiaire pour améliorer l’équilibre et la coordination avec des postures debout."},
        {name: "Flow vigoureux", description: "Un flow intermédiaire plein d’énergie pour développer l’endurance et la force par des transitions dynamiques."},
        {name: "Ouverture du cœur", description: "Un enchaînement intermédiaire pour ouvrir la poitrine et renforcer le dos avec des flexions arrière."},
        {name: "Gainage et stabilité", description: "Un enchaînement intermédiaire qui mêle gainage et postures d’équilibre pour une stabilité globale."},
        {name: "Souplesse assise", description: "Un enchaînement intermédiaire de postures assises pour assouplir davantage les hanches et les ischio-jambiers."},
        {name: "Force du guerrier", description: "Un enchaînement intermédiaire centré sur les guerriers pour gagner en force et en confiance."},
        {name: "Énergie et équilibre", description: "Un enchaînement intermédiaire tonique pour booster ta vitalité et améliorer ton équilibre."},
        {name: "Gainage intensif", description: "Un enchaînement avancé qui sollicite intensément la sangle abdominale avec des postures exigeantes."},
        {name: "Exploration des inversions", description: "Un enchaînement avancé pour maîtriser les inversions, en gagnant force et contrôle."},
        {name: "Souplesse extrême", description: "Un enchaînement avancé pour repousser les limites de ta souplesse avec des étirements profonds et des grands écarts."},
        {name: "Maîtrise des équilibres sur les bras", description: "Un enchaînement avancé centré sur les équilibres sur les bras pour renforcer le haut du corps."},
        {name: "Flexions arrière profondes", description: "Un enchaînement avancé pour approfondir les flexions arrière et ouvrir la poitrine et la colonne."},
        {name: "Flow ultime", description: "Un flow avancé complet qui allie force, équilibre et souplesse."},
        {name: "Précision et puissance", description: "Un enchaînement avancé qui met l’accent sur un alignement précis et des postures puissantes."},
        {name: "Hanches et cœur intensif", description: "Un enchaînement avancé pour ouvrir profondément les hanches et le cœur, pour la souplesse et la libération émotionnelle."},
        {name: "Force et contrôle", description: "Un enchaînement avancé pour développer force et contrôle avec des postures exigeantes."},
        {name: "Maîtrise du yoga", description: "Un enchaînement avancé qui met à l’épreuve la force, l’équilibre et la souplesse des pratiquants confirmés."},
        {name: "Flow bienheureux du débutant", description: "Un enchaînement débutant complet qui passe en douceur par l’échauffement, la force et l’équilibre debout, des flexions arrière douces, des flexions avant, des ouvertures de hanches et des postures de récupération, pour des bases solides."}
      ]
    }
    tr {
      title: "yoga"
      sessions: "seanslar"; poses: "pozlar"
      levels: {beginner: "başlangıç", intermediate: "orta", advanced: "ileri"}
      ranks: {novice: "Acemi", practitioner: "Uygulayıcı", adept: "Deneyimli", devotee: "Tutkun", teacher: "Öğretmen", master: "Usta"}
      paces: {swift: "hızlı", balanced: "dengeli", endurance: "dayanıklılık"}
      levelRank: (n, rank) => "seviye ${n} · ${rank}"
      streak: n => "${n} günlük seri"
      xpLine: (xp, need, next) => "${xp} xp · seviye ${next} için ${need}"
      completed: "bitti"
      sessionLine: (level, n, time) => "${level} · ${n} poz · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · ${time} tut · iki taraf" : "${level} · ${time} tut"
      how: "nasıl"; benefits: "faydaları"; inSessions: "seanslarda"
      startArrow: "başla ›"
      getReady: "hazırlan"
      first: name => "ilki: ${name}"
      introLine: (n, time) => "${n} poz · bu tempoda ${time}"
      startNow: "şimdi başla"
      poseOf: (i, n) => "poz ${i}/${n}"
      voiceOn: "ses açık"; voiceOff: "ses kapalı"
      nextPose: "sonraki poz"; paused: "duraklatıldı"; readyNext: "sonraki poza hazırlan…"
      firstSide: "ilk taraf"; secondSide: "ikinci taraf"; lastPose: "son poz"
      quitAsk: "bu seanstan çıkılsın mı?"; keepGoing: "devam et"; quit: "çık"
      resume: "sürdür"; pause: "duraklat"; skip: "atla"
      greatJob: "harikasın"
      levelUp: (n, rank) => "seviye ${n}: ${rank}"
      xpHint: "xp günün ilk seansıyla gelir"
      done: "bitti"; again: "tekrar"
      poseText: [
        {name: "Tekne", translation: "nāva = tekne, āsana = duruş", description: "Bacakların uzanmış şekilde otur. Nefes ver, bacaklarını 45 dereceye kaldır, hafifçe geriye yaslan. Kollarını öne uzat, avuç içleri birbirine baksın. Oturma kemiklerinde dengede kal, karnını sıkılaştır. Ayak parmaklarına bak, nefes al.", benefits: "Karnı, kalça fleksörlerini ve omurgayı güçlendirir. Böbrekleri, tiroit ve prostat bezlerini ve bağırsakları uyarır. Stresi azaltmaya yardımcı olur. Sindirimi iyileştirir."},
        {name: "Yarım Tekne", translation: "ardha = yarım, nāva = tekne, āsana = duruş", description: "Otur, dizler bükülü, ayaklar havada. Hafifçe geriye yaslan, uyluklarının arkasından tut ya da kollarını uzat. Dengede kal, karnını sıkılaştır, öne bak, nefes al.", benefits: "Karnı, kalça fleksörlerini ve omurgayı güçlendirir. Böbrekleri, tiroidi, prostat bezlerini ve bağırsakları uyarır. Stresi azaltmaya yardımcı olur. Sindirimi iyileştirir."},
        {name: "Yay", translation: "dhanur = yay, āsana = duruş", description: "Karnının üstüne uzan. Dizlerini bük, ayak bileklerini tut. Nefes al, göğsünü ve uyluklarını kaldır, ayaklarını ellerine bastır. Öne bak, nefes al.", benefits: "Vücudun tüm ön yüzünü esnetir: ayak bilekleri, uyluklar ve kasıklar, karın ve göğüs, boğaz ve derin kalça fleksörleri (psoas). Sırt kaslarını güçlendirir. Duruşu iyileştirir. Karın ve boyun organlarını uyarır."},
        {name: "Köprü", translation: "setu = köprü, bandha = kilit, sarva = tüm, āṅga = uzuv, āsana = duruş", description: "Sırtüstü uzan, dizler bükülü, ayaklar kalça genişliğinde. Nefes al, kalçanı kaldır, ellerini sırtının altında kenetle. Omuzlarını içe doğru yuvarla, göğsünü kaldır. Yukarı bak, nefes al.", benefits: "Göğsü, boynu ve omurgayı esnetir. Karın organlarını, akciğerleri ve tiroidi uyarır. Yorgun bacakları canlandırır. Sindirimi iyileştirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Destekle yapıldığında adet sancısını hafifletir. Kaygıyı, yorgunluğu, sırt ağrısını, baş ağrısını ve uykusuzluğu azaltır. Astım, yüksek tansiyon, osteoporoz ve sinüzite iyi gelir."},
        {name: "Kelebek", translation: "baddha = bağlı, koṇa = açı, āsana = duruş", description: "Ayak tabanların birbirine değecek, dizlerin yanlara açık şekilde otur. Ayaklarını tut, dik otur. Omuzlarını gevşet, derin nefes al.", benefits: "Kalçaları ve kasıkları açar. Omuzları, göğüs kafesini ve sırtı esnetir. Karın organlarını, akciğerleri ve kalbi uyarır."},
        {name: "Deve", translation: "uṣṭra = deve, āsana = duruş", description: "Diz çök, ellerin belinde. Nefes al, göğsünü kaldır, rahatsan topuklarına uzan. Boynunu nötr tut, öne bak, nefes al.", benefits: "Vücudun tüm ön yüzünü esnetir: ayak bilekleri, uyluklar ve kasıklar, karın ve göğüs ve boğaz. Derin kalça fleksörlerini (psoas) esnetir. Sırt kaslarını güçlendirir. Duruşu iyileştirir. Karın ve boyun organlarını uyarır."},
        {name: "Kedi", translation: "marjarya = kedi, āsana = duruş", description: "Ellerin ve dizlerin üstünde dur. Nefes ver, omurganı yukarı doğru yuvarla, çeneni içeri al. Karnını sıkılaştır, karnına bak, nefes al.", benefits: "Omurgayı ve boynu rahatlatır. Vücuda enerji verir."},
        {name: "İnek", translation: "bitil = inek, āsana = duruş", description: "Ellerin ve dizlerin üstünde dur. Nefes al, omurganı aşağı doğru çukurlaştır, kuyruk sokumunu ve göğsünü kaldır. Yukarı bak, nefes al.", benefits: "Yorgunluğu giderir. Nefes almayı ve beyne giden kan dolaşımını iyileştirir. Tüm vücudu canlandırır."},
        {name: "Sandalye", translation: "utkaṭa = güçlü, āsana = duruş", description: "Ayakta dur, ayaklar bitişik. Nefes al, oturur gibi dizlerini bük, kollarını başının üstüne kaldır. Ağırlık topuklarda, öne bak, nefes al.", benefits: "Ayak bileklerini, uylukları, baldırları ve omurgayı güçlendirir. Omuzları ve göğsü esnetir. Karın organlarını, diyaframı ve kalbi uyarır. Düz tabanlığı azaltır. Tüm vücuda enerji verir."},
        {name: "Çocuk Pozu", translation: "bala = çocuk, āsana = duruş", description: "Diz çök, ayak başparmakları bitişik, dizler açık. Nefes ver, öne eğil, kollar uzanmış. Alnın matta, gevşe, nefes al.", benefits: "Kalçaları, uylukları ve ayak bileklerini nazikçe esnetir. Zihni sakinleştirir, stresi ve yorgunluğu azaltmaya yardımcı olur. Baş ve gövde desteklendiğinde sırt ve boyun ağrısını hafifletir."},
        {name: "Ceset Pozu", translation: "śava = ceset, āsana = duruş", description: "Sırtüstü uzan, bacaklar uzanmış, kollar yanlarda, avuç içleri yukarı. Gözlerini kapat, tamamen gevşe, derin nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Vücudu gevşetir. Baş ağrısını, yorgunluğu ve uykusuzluğu azaltır. Tansiyonu düşürmeye yardımcı olur."},
        {name: "Hilal Hamlesi", translation: "ashta = yan, chandra = ay, āsana = duruş", description: "Bir ayağınla öne adım at, hamle yap. Arka diz yerde ya da havada. Nefes al, kollarını başının üstüne kaldır. Kalçanı aşağı indir, öne bak, nefes al.", benefits: "Göğüs kafesini, kolları ve gövdeyi esnetir. Yan karın kaslarını sıkılaştırır."},
        {name: "Karga", translation: "baka = turna, āsana = duruş", description: "Çömel, ellerin matta, omuz genişliğinde. Dizlerin üst kollarında. Nefes ver, öne doğru kay, ayaklarını kaldır. Dengede kal, öne bak, nefes al.", benefits: "Kolları ve bilekleri güçlendirir. Üst sırtı esnetir. Karın kaslarını güçlendirir. Kasıkları açar. Karın organlarını sıkılaştırır."},
        {name: "Yunus", translation: "pīñcha = tüy, mayūra = tavus kuşu, āsana = duruş", description: "Aşağı Bakan Köpek pozundan ön kollarına in, dirsekler omuzların altında. Kalçanı kaldır, topuklarını aşağı bastır. Karnını sıkılaştır, ellerinin arasına bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Vücuda enerji verir. Omuzları, arka bacak kaslarını, baldırları, ayak kemerlerini ve elleri esnetir. Kolları ve bacakları güçlendirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Baş desteklendiğinde adet sancısını hafifletir. Osteoporozu önlemeye yardımcı olur. Sindirimi iyileştirir. Baş ağrısını, uykusuzluğu, sırt ağrısını ve yorgunluğu hafifletir. Yüksek tansiyon, astım, düz tabanlık, siyatik ve sinüzite iyi gelir. Ayak bileklerini ve ayak parmaklarını ısıtır."},
        {name: "Aşağı Bakan Köpek", translation: "parivṛtta = döndürülmüş, adho = aşağı, mukha = yüz, śvāna = köpek, āsana = duruş", description: "Ellerin ve dizlerin üstünde dur. Nefes ver, kalçanı yukarı ve geriye kaldır. Bacaklarını düzleştir, topuklarını aşağı bastır. Omurganı uzat, bacaklarının arasına bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Vücuda enerji verir. Omuzları, boynu, arka bacak kaslarını, baldırları, ayak kemerlerini ve elleri esnetir. Kolları ve bacakları güçlendirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Baş desteklendiğinde adet sancısını hafifletir. Osteoporozu önlemeye yardımcı olur. Sindirimi iyileştirir. Baş ağrısını, uykusuzluğu, sırt ağrısını ve yorgunluğu hafifletir. Yüksek tansiyon, astım, düz tabanlık, siyatik ve sinüzite iyi gelir."},
        {name: "Kartal", translation: "garuḍa = kartal, āsana = duruş", description: "Ayakta dur, sağ bacağını solun üstünden çaprazla, ayağını baldırın arkasına tak. Sol kolunu sağın üstünden çaprazla, avuçlarını birleştir. Dirseklerini kaldır, öne bak, nefes al.", benefits: "Ayak bileklerini ve baldırları güçlendirir ve esnetir. Uylukları, kalçaları, omuzları ve üst sırtı esnetir. Konsantrasyonu artırır. Denge duygusunu geliştirir."},
        {name: "Elle Ayak Başparmağı", translation: "utthita = uzatılmış, hasta = el, pādāṅguṣṭha = ayak başparmağı, āsana = duruş", description: "Ayakta dur, sağ bacağını kaldır, ayak başparmağını sağ elinle tut. Bacağını öne uzat, kalçan düz. Öne bak, nefes al.", benefits: "Kalçaları ve kasıkları açar. Arka bacak kaslarını, IT bantlarını ve bacakları esnetir. Dengeyi geliştirir."},
        {name: "Uzatılmış Yan Açı", translation: "utthita = uzatılmış, pārśva = yan, koṇa = açı, āsana = duruş", description: "Savaşçı 2 pozundan ön dizini daha derin bük. Ön kolunu başının üstüne uzat, arka elin bacakta ya da yerde. Göğsünü aç, yukarı bak, nefes al.", benefits: "Bacakları, dizleri ve ayak bileklerini güçlendirir ve esnetir. Kasığı, omurgayı, beli, göğsü, akciğerleri ve omuzları esnetir. Karın organlarını uyarır. Dayanıklılığı artırır."},
        {name: "Ön Kol Duruşu", translation: "pīñcha = tüy, mayūra = tavus kuşu, āsana = duruş", description: "Yunus pozundan ayaklarını yaklaştır. Nefes ver, bacaklarını birer birer kaldır, ön kollarında dengede kal. Karnını sıkılaştır, öne bak, nefes al.", benefits: "Kolları ve omuzları güçlendirir. Odaklanmayı ve dengeyi geliştirir. Üst ve alt sırtı esnetir. Karın kaslarını güçlendirir. Karın bölgesini sıkılaştırır."},
        {name: "Omuz Açıcılı Öne Eğilme", translation: "uttāna = germek, āsana = duruş", description: "Ayakta dur, öne eğil, ellerini sırtının arkasında kenetle. Kollarını nazikçe kaldır, başını gevşet. Aşağı bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Karaciğeri ve böbrekleri uyarır. Arka bacak kaslarını, baldırları ve kalçaları esnetir. Uylukları ve dizleri güçlendirir. Sindirimi iyileştirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Yorgunluğu ve kaygıyı azaltır. Baş ağrısını ve uykusuzluğu hafifletir. Omuzları açar."},
        {name: "Yarım Ay", translation: "ardha = yarım, chandra = ay, āsana = duruş", description: "Savaşçı 3 pozundan elini ön ayağının yanında yere koy. Arka bacağını yere paralel kaldır, karşı kolunu yukarı uzat. Kalçanı aç, yukarı ya da aşağı bak, nefes al.", benefits: "Karnı, ayak bileklerini, uylukları, kalçayı ve omurgayı güçlendirir. Kasıkları, arka bacak kaslarını, baldırları, omuzları, göğsü ve omurgayı esnetir. Koordinasyonu ve denge duygusunu geliştirir. Stresi azaltmaya yardımcı olur. Sindirimi iyileştirir."},
        {name: "Amut", translation: "adho = aşağı, mukha = yüz, vṛkṣa = ağaç, āsana = duruş", description: "Aşağı Bakan Köpek pozundan ayaklarını yaklaştır. Ağırlığını aktar, bacaklarını yukarı savur, düzleştir. Karnını sıkılaştır, öne bak, nefes al.", benefits: "Omuzları, kolları ve bilekleri güçlendirir. Karnı esnetir. Denge duygusunu geliştirir. Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur."},
        {name: "Alçak Hamle", translation: "aṅjaneya = övgü, āsana = duruş", description: "Sağ ayağınla öne adım at, hamle yap. Sol dizini yere indir, ellerin uyluğunda ya da başının üstünde. Kalçanı aşağı indir, öne bak, nefes al.", benefits: "Göğsü, akciğerleri, boynu, karnı ve kasığı (psoas) esnetir. Omuzları, kolları ve sırt kaslarını güçlendirir. Uylukları, baldırları ve ayak bileklerini güçlendirir ve esnetir."},
        {name: "Güvercin", translation: "supta = sırtüstü, kapota = güvercin, āsana = duruş", description: "Sırtüstü uzan, sağ ayak bileğini sol dizinin üstüne koy. Sol dizini göğsüne çek. Sırtını yerde tut, yukarı bak, nefes al.", benefits: "Arka ve ön bacak kaslarını esnetir. Dirsekle uyluk itilirse kalçaları da açar."},
        {name: "Kral Güvercin", translation: "eka = bir, pāda = ayak ya da bacak, rāja = kral, kapota = güvercin, āsana = duruş", description: "Güvercin pozundan arka dizini bük, ayağını elinle tut. Göğsünü kaldır, kalbini aç. Öne bak, nefes al.", benefits: "Uylukları, kasıkları (psoas), karnı, göğsü, omuzları ve boynu esnetir. Karın organlarını uyarır. Omuzları ve göğsü açar."},
        {name: "Plank", translation: "phalaka = tahta, āsana = duruş", description: "Ellerin ve dizlerin üstünden ayaklarını geriye at. Vücudun düz, ellerin omuzlarının altında. Karnını sıkılaştır, aşağı bak, nefes al.", benefits: "Kolları, bilekleri ve omurgayı güçlendirir. Karnı sıkılaştırır."},
        {name: "Saban", translation: "hala = saban, āsana = duruş", description: "Sırtüstü uzan. Nefes ver, bacaklarını başının üstünden geçir, ayak parmakların arkada yerde. Sırtını destekle ya da ellerini kenetle. İçine bak, nefes al.", benefits: "Zihni sakinleştirir. Karın organlarını ve tiroit bezlerini uyarır. Omuzları ve omurgayı esnetir. Menopoz belirtilerini hafifletmeye yardımcı olur. Stresi ve yorgunluğu azaltır. Sırt ağrısı, baş ağrısı, kısırlık, uykusuzluk ve sinüzite iyi gelir."},
        {name: "Piramit", translation: "pārśva = yan, uttāna = germek, āsana = duruş", description: "Sağ ayağınla öne, sol ayağınla geriye adım at. Kalçandan bükül, ön bacağının üstüne eğil. Ellerin yerde ya da bloklarda. Aşağı bak, nefes al.", benefits: "Zihni sakinleştirir. Omurgayı, omuzları, kalçaları ve arka bacak kaslarını esnetir. Bacakları güçlendirir. Karın organlarını uyarır. Duruşu ve denge duygusunu geliştirir. Sindirimi iyileştirir."},
        {name: "Ters Savaşçı", translation: "pārśva = yan, vīrabhadra = savaşçı, āsana = duruş", description: "Savaşçı 2 pozundan ön kolunu başının üstünden geriye uzat. Arka elini bacağın boyunca aşağı kaydır. Göğsünü aç, yukarı bak, nefes al.", benefits: "Bacakları, dizleri ve ayak bileklerini güçlendirir ve esnetir. Kasığı, omurgayı, beli, göğsü, akciğerleri ve omuzları esnetir. Karın organlarını uyarır. Dayanıklılığı artırır. Özellikle hamileliğin ikinci üç ayında sırt ağrısını hafifletir. Karpal tünel sendromu, düz tabanlık, kısırlık, osteoporoz ve siyatiğe iyi gelir."},
        {name: "Oturarak Öne Eğilme", translation: "paśchima = arka, uttāna = germek, āsana = duruş", description: "Otur, bacaklar uzanmış. Nefes al, omurganı uzat. Nefes ver, öne eğil, ayaklarına ya da kaval kemiklerine uzan. Omurganı uzun tut, öne bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Omurgayı, omuzları ve arka bacak kaslarını esnetir. Karaciğeri, böbrekleri, yumurtalıkları ve rahmi uyarır. Sindirimi iyileştirir. Menopoz belirtilerini ve adet sancısını hafifletmeye yardımcı olur. Baş ağrısını ve kaygıyı yatıştırır. Yorgunluğu azaltır. Yüksek tansiyon, kısırlık, uykusuzluk ve sinüzite iyi gelir. Geleneksel metinlere göre Paschimottanasana iştahı artırır, obeziteyi azaltır ve hastalıkları iyileştirir."},
        {name: "Lotus", translation: "padma = lotus, āsana = duruş", description: "Otur, sağ ayağını sol uyluğuna, sol ayağını sağ uyluğuna koy. Ellerin dizlerinde, dik otur, nefes al.", benefits: "Kalçaları ve kasığı açar, dizleri, ayak bileklerini ve uylukları esnetir. Sırtı güçlendirir ve zihni sakinleştirir, stresi ve kaygıyı azaltır. Leğen bölgesinde dolaşımı ve kan akışını iyileştirir."},
        {name: "Yarım Balıkların Efendisi", translation: "ardha = yarım, matsya = balık, indra = kral", description: "Otur, sağ dizini solun üstünden çaprazla, sağa dön. Sol dirseğin sağ dizinin dışında, sağ elin arkada. Omzunun üstünden bak, nefes al.", benefits: "Omuzları, göğsü, uylukları, kasıkları ve karnı esnetir. Bacakları ve ayak bileklerini güçlendirir. Dengeyi geliştirir."},
        {name: "Omuz Duruşu", translation: "sa = ile, ālamba = destek, sarvāṅga = tüm uzuvlar, āsana = duruş", description: "Sırtüstü uzan. Nefes ver, bacaklarını ve kalçanı yukarı kaldır, sırtını ellerinle destekle. Bacaklarını düzleştir, içine bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Tiroit ve prostat bezlerini ve karın organlarını uyarır. Omuzları ve boynu esnetir. Bacakları ve kalçayı sıkılaştırır. Sindirimi iyileştirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Yorgunluğu azaltır ve uykusuzluğu hafifletir. Astım, kısırlık ve sinüzite iyi gelir."},
        {name: "Yan Plank", translation: "vasiṣṭha = bir bilgenin adı, āsana = duruş", description: "Plank pozundan sağ ayağının dış kenarına dön. Ayaklarını üst üste koy, sol kolunu yukarı kaldır. Karnını sıkılaştır, yukarı bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Omuzları, arka bacak kaslarını, baldırları ve ayak kemerlerini esnetir. Kolları ve bacakları güçlendirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Osteoporozu önlemeye yardımcı olur. Sindirimi iyileştirir. Baş ağrısını, uykusuzluğu, sırt ağrısını ve yorgunluğu hafifletir. Yüksek tansiyon, astım, düz tabanlık ve siyatiğe iyi gelir."},
        {name: "Sfenks", translation: "sālamba = destekli, bhujaṅga = yılan, āsana = duruş", description: "Karnının üstüne uzan, ön kolların matta, dirsekler omuzların altında. Nefes al, göğsünü kaldır, omuzlarını aşağı bastır. Öne bak, nefes al.", benefits: "Omurgayı güçlendirir. Göğsü, akciğerleri, omuzları ve karnı esnetir. Karın organlarını uyarır. Kalbi ve akciğerleri açar."},
        {name: "Spagat", translation: "hanumān = maymun tanrı, āsana = duruş", description: "Hamle pozundan ön ayağını öne, arka ayağını geriye kaydır. Kalçanı indir, düz tut. Ellerin yerde ya da bloklarda. Öne bak, nefes al.", benefits: "Uylukları, arka bacak kaslarını ve kasığı esnetir. Karın organlarını uyarır."},
        {name: "Çelenk Pozu", translation: "mālā = çelenk ya da kolye, āsana = duruş", description: "Çömel, ayaklar bitişik ya da açık. Dirseklerin dizlerinin iç tarafında, avuçların göğsünde birleşik. Dizlerini dışa it, kalçanı indir, öne bak, nefes al.", benefits: "Ayak bileklerini, kasıkları ve sırtı esnetir. Karnı sıkılaştırır."},
        {name: "Ayakta Öne Eğilme", translation: "uttāna = germek, āsana = duruş", description: "Ayakta dur, öne eğil, ellerin yerde ya da kaval kemiklerinde. Omurganı uzun tut, başını sarkıt. Aşağı bak, nefes al.", benefits: "Zihni sakinleştirir, stresi ve hafif depresyonu azaltmaya yardımcı olur. Karaciğeri ve böbrekleri uyarır. Arka bacak kaslarını, baldırları ve kalçaları esnetir. Uylukları ve dizleri güçlendirir. Sindirimi iyileştirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Yorgunluğu ve kaygıyı azaltır. Baş ağrısını ve uykusuzluğu hafifletir."},
        {name: "Hilal", translation: "ashta = yan, chandra = ay, āsana = duruş", description: "Ayakta dur, ellerini başının üstünde kenetle. Nefes al, bir yana eğil, karşı tarafı esnet. Yukarı bak, nefes al.", benefits: "Göğüs kafesini, kolları ve gövdeyi esnetir. Yan karın kaslarını sıkılaştırır."},
        {name: "Yan Spagat", translation: "upaviṣṭha = oturmuş, koṇa = açı, āsana = duruş", description: "Otur, bacaklar geniş açık. Nefes ver, ellerinle öne yürü, gövdeni indir. Omurganı uzun tut, aşağı bak, nefes al.", benefits: "Bacakların iç ve arka yüzünü esnetir. Karın organlarını uyarır. Omurgayı güçlendirir. Zihni sakinleştirir. Kasıkları gevşetir."},
        {name: "Ağaç", translation: "vṛkṣa = ağaç, āsana = duruş", description: "Ayakta dur, sağ ayağını sol uyluğuna ya da baldırına koy. Avuçların başının üstünde ya da göğsünde birleşik. Dengede kal, öne bak, nefes al.", benefits: "Bacakları, ayak bileklerini ve ayakları güçlendirir. Kalça ve dizlerde esnekliği artırır. Dengeyi geliştirir."},
        {name: "Üçgen", translation: "trikoṇa = üçgen, āsana = duruş", description: "Bacakların geniş açık dur, sağ ayağını dışa çevir. Sağ elini kaval kemiğine ya da yere uzat, sol kolun yukarıda. Göğsünü aç, yukarı bak, nefes al.", benefits: "Uylukları, dizleri ve ayak bileklerini esnetir ve güçlendirir. Kalçaları, kasığı, arka bacak kaslarını, baldırları, omuzları, göğsü ve omurgayı esnetir. Karın organlarını uyarır. Stresi azaltmaya yardımcı olur. Sindirimi iyileştirir. Menopoz belirtilerini hafifletmeye yardımcı olur. Özellikle hamileliğin ikinci üç ayında sırt ağrısını hafifletir. Kaygı, düz tabanlık, kısırlık, boyun ağrısı, osteoporoz ve siyatiğe iyi gelir."},
        {name: "Yukarı Bakan Köpek", translation: "ūrdhva = yukarı, mukha = yüz, śvāna = köpek, āsana = duruş", description: "Karnının üstüne uzan, ellerin omuzlarının yanında. Nefes al, göğsünü ve uyluklarını kaldır, omuzlarını geriye yuvarla. Öne bak, nefes al.", benefits: "Duruşu iyileştirir. Omurgayı, kolları ve bilekleri güçlendirir. Göğsü, akciğerleri, omuzları ve karnı esnetir. Kalçayı sıkılaştırır. Karın organlarını uyarır. Hafif depresyonu, yorgunluğu ve siyatiği hafifletmeye yardımcı olur. Astıma iyi gelir."},
        {name: "Savaşçı 1", translation: "vīrabhadra = savaşçı, āsana = duruş", description: "Sol ayağınla geriye adım at, sağ dizini 90 dereceye bük. Kollarını başının üstüne kaldır, kalçanı indir. Öne bak, nefes al.", benefits: "Göğsü, akciğerleri, omuzları, boynu, karnı ve kasığı (psoas) esnetir. Omuzları, kolları ve sırt kaslarını güçlendirir. Uylukları, baldırları ve ayak bileklerini güçlendirir ve esnetir."},
        {name: "Savaşçı 2", translation: "vīrabhadra = savaşçı, āsana = duruş", description: "Sol ayağınla geriye adım at, sağ dizini 90 dereceye bük. Kolların yere paralel, kalçanı indir. Sağ elinin üstünden bak, nefes al.", benefits: "Bacakları ve ayak bileklerini güçlendirir ve esnetir. Kasığı, göğsü, akciğerleri ve omuzları esnetir. Karın organlarını uyarır. Dayanıklılığı artırır. Özellikle hamileliğin ikinci üç ayında sırt ağrısını hafifletir. Karpal tünel sendromu, düz tabanlık, kısırlık, osteoporoz ve siyatiğe iyi gelir."},
        {name: "Savaşçı 3", translation: "vīrabhadra = savaşçı, āsana = duruş", description: "Ayakta dur, ağırlığını sağ bacağına ver. Sol bacağını geriye, yere paralel kaldır, kolların önde ya da yanlarda. Dengede kal, aşağı bak, nefes al.", benefits: "Ayak bileklerini ve bacakları güçlendirir. Omuzları ve sırt kaslarını güçlendirir. Karnı sıkılaştırır. Dengeyi ve duruşu geliştirir."},
        {name: "Tekerlek", translation: "ūrdhva = yukarı, dhanu = yay, āsana = duruş", description: "Sırtüstü uzan, dizlerin bükülü, ellerin kulaklarının yanında. Nefes ver, sonra kalçanı ve göğsünü kaldırıp bir kemer oluştur. Yukarı bak ve düzenli nefes al.", benefits: "Kolları, bilekleri, bacakları, kalçayı, karın kaslarını ve omurgayı güçlendirir. Tiroit ve hipofiz bezlerini uyarır. Enerjiyi artırır, depresyona karşı yardımcı olur; astım, sırt ağrısı, kısırlık ve osteoporoza iyi gelir."},
        {name: "Vahşi Şey", translation: "camatkāra = hayranlıkla vurulmuş, āsana = duruş", description: "Aşağı Bakan Köpek pozunda başla, sonra sağ bacağını kaldır ve kalçanı aç. Sağ elini ön ayağının yanına koy, sol kolunu kaldır, sırtını kavisle, yukarı bak ve derin nefes al.", benefits: "Göğsü, omuzları, sırtı ve boğazı esnetir. Kalçaları, kalça fleksörlerini ve uylukları güçlendirir ve açar."}
      ]
      sessionText: [
        {name: "Yumuşak Başlangıç Akışı", description: "Temel pozlar ve nefese odaklanarak yogaya rahatça başlaman için yatıştırıcı bir başlangıç seansı."},
        {name: "Sabah Uyanışı", description: "Güne hazırlanırken vücudu canlandırıp esnetmek için başlangıç dostu bir seans."},
        {name: "Dinlendirici Temeller", description: "Yumuşak pozlarla gevşeyip toparlanman için sakinleştirici bir başlangıç seansı."},
        {name: "Dengeli Temeller", description: "Ayakta ve oturarak yapılan pozlarla denge ve güç kazanman için bir başlangıç seansı."},
        {name: "Merkez ve Esneme", description: "Basit pozlarla karın bölgeni güçlendirip esnekliğini artırman için bir başlangıç seansı."},
        {name: "Orta Seviye Merkez Gücü", description: "Merkez dengesini ve gücünü geliştiren dinamik bir orta seviye seans."},
        {name: "Kalça Açıcı Akış", description: "Daha fazla esneklik için kalçaları derinden esneten ve açan orta seviye bir seans."},
        {name: "Bükül ve Canlan", description: "Arınmak ve enerjini yükseltmek için burgulara dayalı orta seviye bir seans."},
        {name: "Denge Mücadelesi", description: "Ayakta pozlarla dengeyi ve koordinasyonu geliştiren orta seviye bir seans."},
        {name: "Güçlü Akış", description: "Dinamik geçişlerle dayanıklılık ve güç kazandıran, enerjisi yüksek orta seviye bir akış."},
        {name: "Kalp Açıcı Seans", description: "Geriye eğilmelerle göğsü açan ve sırtı güçlendiren orta seviye bir seans."},
        {name: "Merkez ve Denge", description: "Genel denge için merkez çalışmasını ve denge pozlarını birleştiren orta seviye bir seans."},
        {name: "Oturarak Esneklik", description: "Kalça ve arka bacak esnekliğini derinleştiren oturarak pozlardan oluşan orta seviye bir seans."},
        {name: "Savaşçı Gücü", description: "Güç ve özgüven kazandıran savaşçı pozlarına odaklanan orta seviye bir seans."},
        {name: "Enerji ve Denge", description: "Canlılığı artıran ve dengeyi geliştiren enerji verici orta seviye bir seans."},
        {name: "Yoğun İleri Merkez", description: "Zorlu pozlarla merkez gücünü yoğun biçimde çalıştıran ileri seviye bir seans."},
        {name: "Ters Duruş Keşfi", description: "Güç ve kontrol kazanarak ters duruşlarda ustalaşman için ileri seviye bir seans."},
        {name: "Uç Esneklik", description: "Derin esnemeler ve spagatlarla esneklik sınırlarını zorlayan ileri seviye bir seans."},
        {name: "Kol Dengesi Ustalığı", description: "Üst vücudu güçlendiren kol dengelerine odaklanan ileri seviye bir seans."},
        {name: "Derin Geriye Eğilmeler", description: "Göğsü ve omurgayı açarak geriye eğilmeleri derinleştiren ileri seviye bir seans."},
        {name: "Nihai Akış", description: "Güç, denge ve esnekliği birleştiren kapsamlı bir ileri seviye akış."},
        {name: "Hassasiyet ve Güç", description: "Hassas hizalanmayı ve güçlü pozları öne çıkaran ileri seviye bir seans."},
        {name: "Yoğun Kalça ve Kalp", description: "Esneklik ve duygusal rahatlama için kalçaları ve kalbi derinden açan ileri seviye bir seans."},
        {name: "Güç ve Kontrol", description: "Zorlu pozlarla güç ve kontrol kazandıran ileri seviye bir seans."},
        {name: "Yoga Ustalığı", description: "Deneyimli yogiler için gücü, dengeyi ve esnekliği zorlayan ileri seviye bir seans."},
        {name: "Başlangıç İçin Huzurlu Akış", description: "Isınma, ayakta güç ve denge pozları, yumuşak geriye eğilmeler, öne eğilmeler, kalça açıcılar ve dinlendirici pozlar arasında uyumla akan, sağlam bir temel kurmana yardımcı olan kapsamlı bir başlangıç seansı."}
      ]
    }
    it {
      title: "yoga"
      sessions: "sessioni"; poses: "posizioni"
      levels: {beginner: "principiante", intermediate: "intermedio", advanced: "avanzato"}
      ranks: {novice: "Novizio", practitioner: "Praticante", adept: "Adepto", devotee: "Devoto", teacher: "Insegnante", master: "Maestro"}
      paces: {swift: "veloce", balanced: "bilanciato", endurance: "resistenza"}
      levelRank: (n, rank) => "livello ${n} · ${rank}"
      streak: n => n == 1 ? "1 giorno di fila" : "${n} giorni di fila"
      xpLine: (xp, need, next) => "${xp} xp · ${need} al livello ${next}"
      completed: "fatta"
      sessionLine: (level, n, time) => "${level} · ${n} posizioni · ${time}"
      poseLine: (level, time, sides) => sides ? "${level} · tieni ${time} · entrambi i lati" : "${level} · tieni ${time}"
      how: "come"; benefits: "benefici"; inSessions: "nelle sessioni"
      startArrow: "inizia ›"
      getReady: "preparati"
      first: name => "prima: ${name}"
      introLine: (n, time) => "${n} posizioni · ${time} a questo ritmo"
      startNow: "inizia ora"
      poseOf: (i, n) => "posizione ${i} di ${n}"
      voiceOn: "voce attiva"; voiceOff: "voce spenta"
      nextPose: "prossima posizione"; paused: "in pausa"; readyNext: "preparati per la prossima…"
      firstSide: "primo lato"; secondSide: "secondo lato"; lastPose: "ultima posizione"
      quitAsk: "uscire dalla sessione?"; keepGoing: "continua"; quit: "esci"
      resume: "riprendi"; pause: "pausa"; skip: "salta"
      greatJob: "ottimo lavoro"
      levelUp: (n, rank) => "livello ${n}: ${rank}"
      xpHint: "gli xp arrivano con la prima sessione del giorno"
      done: "fine"; again: "ancora"
      poseText: [
        {name: "Barca", translation: "nāva = barca, āsana = posizione", description: "Siediti con le gambe distese. Espira, solleva le gambe a 45 gradi, inclinati un po’ indietro. Allunga le braccia in avanti, palmi rivolti l’uno verso l’altro. Trova l’equilibrio sugli ischi, attiva il core. Guarda le dita dei piedi, respira.", benefits: "Rafforza addome, flessori dell’anca e colonna. Stimola reni, tiroide, prostata e intestino. Aiuta ad alleviare lo stress. Migliora la digestione."},
        {name: "Mezza barca", translation: "ardha = metà, nāva = barca, āsana = posizione", description: "Siediti, ginocchia piegate, piedi sollevati. Inclinati un po’ indietro, tieni il retro delle cosce o allunga le braccia. Trova l’equilibrio, attiva il core, guarda avanti, respira.", benefits: "Rafforza addome, flessori dell’anca e colonna. Stimola reni, tiroide, prostata e intestino. Aiuta ad alleviare lo stress. Migliora la digestione."},
        {name: "Arco", translation: "dhanur = arco, āsana = posizione", description: "Sdraiati a pancia in giù. Piega le ginocchia, afferra le caviglie. Inspira, solleva petto e cosce, spingi i piedi contro le mani. Guarda avanti, respira.", benefits: "Allunga tutta la parte anteriore del corpo: caviglie, cosce e inguine, addome e petto, gola e flessori profondi dell’anca (psoas). Rafforza i muscoli della schiena. Migliora la postura. Stimola gli organi dell’addome e del collo."},
        {name: "Ponte", translation: "setu = ponte, bandha = chiusura, sarva = tutto, āṅga = arto, āsana = posizione", description: "Sdraiati sulla schiena, ginocchia piegate, piedi alla larghezza delle anche. Inspira, solleva il bacino, intreccia le mani sotto la schiena. Porta le spalle sotto, solleva il petto. Guarda in alto, respira.", benefits: "Allunga petto, collo e colonna. Stimola gli organi addominali, i polmoni e la tiroide. Rigenera le gambe stanche. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa. Allevia i dolori mestruali se fatta con un supporto. Riduce ansia, stanchezza, mal di schiena, mal di testa e insonnia. Utile in caso di asma, pressione alta, osteoporosi e sinusite."},
        {name: "Farfalla", translation: "baddha = legato, koṇa = angolo, āsana = posizione", description: "Siediti con le piante dei piedi unite, ginocchia verso l’esterno. Tieni i piedi, siediti dritto. Rilassa le spalle, respira profondamente.", benefits: "Apre anche e inguine. Allunga spalle, gabbia toracica e schiena. Stimola gli organi addominali, i polmoni e il cuore."},
        {name: "Cammello", translation: "uṣṭra = cammello, āsana = posizione", description: "Inginocchiati, mani sulla parte bassa della schiena. Inspira, solleva il petto, raggiungi i talloni se ti è comodo. Tieni il collo neutro, guarda avanti, respira.", benefits: "Allunga tutta la parte anteriore del corpo: caviglie, cosce e inguine, addome e petto, gola. Allunga i flessori profondi dell’anca (psoas). Rafforza i muscoli della schiena. Migliora la postura. Stimola gli organi dell’addome e del collo."},
        {name: "Gatto", translation: "marjarya = gatto, āsana = posizione", description: "A quattro zampe. Espira, inarca la schiena verso l’alto, porta il mento al petto. Attiva il core, guarda la pancia, respira.", benefits: "Scarica la colonna e il collo. Dà energia al corpo."},
        {name: "Mucca", translation: "bitil = mucca, āsana = posizione", description: "A quattro zampe. Inspira, incurva la schiena verso il basso, solleva coccige e petto. Guarda in alto, respira.", benefits: "Scaccia la stanchezza. Migliora la respirazione e la circolazione del sangue verso il cervello. Rigenera tutto il corpo."},
        {name: "Sedia", translation: "utkaṭa = potente, āsana = posizione", description: "In piedi, piedi uniti. Inspira, piega le ginocchia come per sederti, solleva le braccia sopra la testa. Peso sui talloni, guarda avanti, respira.", benefits: "Rafforza caviglie, cosce, polpacci e colonna. Allunga spalle e petto. Stimola gli organi addominali, il diaframma e il cuore. Attenua i piedi piatti. Dà energia a tutto il corpo."},
        {name: "Posizione del bambino", translation: "bala = bambino, āsana = posizione", description: "Inginocchiati, alluci a contatto, ginocchia divaricate. Espira, piegati in avanti, braccia distese. Fronte sul tappetino, rilassati, respira.", benefits: "Allunga dolcemente anche, cosce e caviglie. Calma la mente e aiuta ad alleviare stress e stanchezza. Allevia il dolore a schiena e collo se fatta con testa e busto sostenuti."},
        {name: "Cadavere", translation: "śava = cadavere, āsana = posizione", description: "Sdraiati sulla schiena, gambe distese, braccia lungo i fianchi, palmi in su. Chiudi gli occhi, rilassati del tutto, respira profondamente.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Rilassa il corpo. Riduce mal di testa, stanchezza e insonnia. Aiuta ad abbassare la pressione."},
        {name: "Affondo a mezzaluna", translation: "ashta = lato, chandra = luna, āsana = posizione", description: "Porta un piede avanti in affondo. Ginocchio dietro a terra o sollevato. Inspira, solleva le braccia sopra la testa. Abbassa il bacino, guarda avanti, respira.", benefits: "Allunga gabbia toracica, braccia e busto. Tonifica gli obliqui."},
        {name: "Corvo", translation: "baka = gru, āsana = posizione", description: "Accovacciati, mani sul tappetino alla larghezza delle spalle. Ginocchia sulla parte alta delle braccia. Espira, sposta il peso in avanti, solleva i piedi. Trova l’equilibrio, guarda avanti, respira.", benefits: "Rafforza braccia e polsi. Allunga la parte alta della schiena. Rafforza gli addominali. Apre l’inguine. Tonifica gli organi addominali."},
        {name: "Delfino", translation: "pīñcha = piuma, mayūra = pavone, āsana = posizione", description: "Dal Cane a testa in giù, scendi sugli avambracci, gomiti sotto le spalle. Solleva il bacino, spingi i talloni verso il basso. Attiva il core, guarda tra le mani, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Dà energia al corpo. Allunga spalle, femorali, polpacci, arcate plantari e mani. Rafforza braccia e gambe. Aiuta ad alleviare i sintomi della menopausa. Allevia i dolori mestruali se fatta con la testa sostenuta. Aiuta a prevenire l’osteoporosi. Migliora la digestione. Allevia mal di testa, insonnia, mal di schiena e stanchezza. Utile in caso di pressione alta, asma, piedi piatti, sciatica e sinusite. Scalda caviglie e dita dei piedi."},
        {name: "Cane a testa in giù", translation: "parivṛtta = ruotato, adho = verso il basso, mukha = volto, śvāna = cane, āsana = posizione", description: "A quattro zampe. Espira, solleva il bacino in alto e indietro. Distendi le gambe, spingi i talloni verso il basso. Allunga la colonna, guarda tra le gambe, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Dà energia al corpo. Allunga spalle, collo, femorali, polpacci, arcate plantari e mani. Rafforza braccia e gambe. Aiuta ad alleviare i sintomi della menopausa. Allevia i dolori mestruali se fatta con la testa sostenuta. Aiuta a prevenire l’osteoporosi. Migliora la digestione. Allevia mal di testa, insonnia, mal di schiena e stanchezza. Utile in caso di pressione alta, asma, piedi piatti, sciatica e sinusite."},
        {name: "Aquila", translation: "garuḍa = aquila, āsana = posizione", description: "In piedi, incrocia la gamba destra sopra la sinistra, aggancia il piede dietro il polpaccio. Incrocia il braccio sinistro sopra il destro, unisci i palmi. Solleva i gomiti, guarda avanti, respira.", benefits: "Rafforza e allunga caviglie e polpacci. Allunga cosce, anche, spalle e parte alta della schiena. Migliora la concentrazione. Migliora l’equilibrio."},
        {name: "Mano all’alluce", translation: "utthita = esteso, hasta = mano, pādāṅguṣṭha = alluce, āsana = posizione", description: "In piedi, solleva la gamba destra, afferra l’alluce con la mano destra. Distendi la gamba in avanti, bacino dritto. Guarda avanti, respira.", benefits: "Apre anche e inguine. Allunga femorali, bandelletta ileotibiale e gambe. Migliora l’equilibrio."},
        {name: "Angolo laterale esteso", translation: "utthita = esteso, pārśva = lato, koṇa = angolo, āsana = posizione", description: "Dal Guerriero 2, piega di più il ginocchio davanti. Allunga il braccio davanti sopra la testa, mano dietro sulla gamba o a terra. Apri il petto, guarda in alto, respira.", benefits: "Rafforza e allunga gambe, ginocchia e caviglie. Allunga inguine, colonna, vita, petto, polmoni e spalle. Stimola gli organi addominali. Aumenta la resistenza."},
        {name: "Verticale sugli avambracci", translation: "pīñcha = piuma, mayūra = pavone, āsana = posizione", description: "Dal Delfino, avvicina i piedi. Espira, solleva le gambe una alla volta, trova l’equilibrio sugli avambracci. Attiva il core, guarda avanti, respira.", benefits: "Rafforza braccia e spalle. Migliora concentrazione ed equilibrio. Allunga la parte alta e bassa della schiena. Rafforza gli addominali. Tonifica la zona addominale."},
        {name: "Piegamento in avanti con apertura delle spalle", translation: "uttāna = allungamento intenso, āsana = posizione", description: "In piedi, piegati in avanti, intreccia le mani dietro la schiena. Solleva dolcemente le braccia, rilassa la testa. Guarda in basso, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Stimola fegato e reni. Allunga femorali, polpacci e anche. Rafforza cosce e ginocchia. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa. Riduce stanchezza e ansia. Allevia mal di testa e insonnia. Apre le spalle."},
        {name: "Mezzaluna", translation: "ardha = metà, chandra = luna, āsana = posizione", description: "Dal Guerriero 3, mano a terra accanto al piede davanti. Solleva la gamba dietro parallela al suolo, allunga in alto il braccio opposto. Apri le anche, guarda in alto o in basso, respira.", benefits: "Rafforza addome, caviglie, cosce, glutei e colonna. Allunga inguine, femorali, polpacci, spalle, petto e colonna. Migliora coordinazione ed equilibrio. Aiuta ad alleviare lo stress. Migliora la digestione."},
        {name: "Verticale", translation: "adho = verso il basso, mukha = volto, vṛkṣa = albero, āsana = posizione", description: "Dal Cane a testa in giù, avvicina i piedi. Sposta il peso, slancia le gambe in alto, distendile. Attiva il core, guarda avanti, respira.", benefits: "Rafforza spalle, braccia e polsi. Allunga la pancia. Migliora l’equilibrio. Calma la mente e aiuta ad alleviare lo stress e la depressione lieve."},
        {name: "Affondo basso", translation: "aṅjaneya = lode, āsana = posizione", description: "Porta il piede destro avanti in affondo. Abbassa il ginocchio sinistro, mani sulla coscia o sopra la testa. Abbassa il bacino, guarda avanti, respira.", benefits: "Allunga petto, polmoni, collo, pancia e inguine (psoas). Rafforza spalle, braccia e muscoli della schiena. Rafforza e allunga cosce, polpacci e caviglie."},
        {name: "Piccione", translation: "supta = supino, kapota = piccione, āsana = posizione", description: "Sdraiati sulla schiena, incrocia la caviglia destra sul ginocchio sinistro. Porta il ginocchio sinistro al petto. Tieni la schiena a terra, guarda in alto, respira.", benefits: "Allunga femorali e quadricipiti. Se usi il gomito per spingere la coscia, apre anche le anche."},
        {name: "Piccione reale",translation: "eka = uno, pāda = piede o gamba, rāja = re, kapota = piccione, āsana = posizione", description: "Dal Piccione, piega il ginocchio dietro, afferra il piede con la mano. Solleva il petto, apri il cuore. Guarda avanti, respira.", benefits: "Allunga cosce, inguine (psoas), addome, petto, spalle e collo. Stimola gli organi addominali. Apre spalle e petto."},
        {name: "Plank", translation: "phalaka = asse, āsana = posizione", description: "A quattro zampe, porta i piedi indietro. Corpo dritto, mani sotto le spalle. Attiva il core, guarda in basso, respira.", benefits: "Rafforza braccia, polsi e colonna. Tonifica l’addome."},
        {name: "Aratro", translation: "hala = aratro, āsana = posizione", description: "Sdraiati sulla schiena. Espira, porta le gambe oltre la testa, punte dei piedi a terra dietro. Sostieni la schiena o intreccia le mani. Sguardo verso l’interno, respira.", benefits: "Calma la mente. Stimola gli organi addominali e la tiroide. Allunga spalle e colonna. Aiuta ad alleviare i sintomi della menopausa. Riduce stress e stanchezza. Utile in caso di mal di schiena, mal di testa, infertilità, insonnia e sinusite."},
        {name: "Piramide", translation: "pārśva = lato, uttāna = allungamento intenso, āsana = posizione", description: "Porta il piede destro avanti, il sinistro indietro. Piegati dalle anche sulla gamba davanti. Mani a terra o sui mattoncini. Guarda in basso, respira.", benefits: "Calma la mente. Allunga colonna, spalle, anche e femorali. Rafforza le gambe. Stimola gli organi addominali. Migliora postura ed equilibrio. Migliora la digestione."},
        {name: "Guerriero inverso", translation: "pārśva = lato, vīrabhadra = guerriero, āsana = posizione", description: "Dal Guerriero 2, allunga il braccio davanti sopra la testa e indietro. Fai scivolare la mano dietro lungo la gamba. Apri il petto, guarda in alto, respira.", benefits: "Rafforza e allunga gambe, ginocchia e caviglie. Allunga inguine, colonna, vita, petto, polmoni e spalle. Stimola gli organi addominali. Aumenta la resistenza. Allevia il mal di schiena, soprattutto nel secondo trimestre di gravidanza. Utile in caso di tunnel carpale, piedi piatti, infertilità, osteoporosi e sciatica."},
        {name: "Pinza da seduti", translation: "paśchima = dietro, uttāna = allungamento intenso, āsana = posizione", description: "Siediti, gambe distese. Inspira, allunga la colonna. Espira, piegati in avanti, raggiungi i piedi o gli stinchi. Tieni la colonna lunga, guarda avanti, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Allunga colonna, spalle e femorali. Stimola fegato, reni, ovaie e utero. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa e i dolori mestruali. Allevia mal di testa e ansia. Riduce la stanchezza. Utile in caso di pressione alta, infertilità, insonnia e sinusite. Secondo i testi tradizionali, Paschimottanasana aumenta l’appetito, riduce l’obesità e guarisce le malattie."},
        {name: "Loto", translation: "padma = loto, āsana = posizione", description: "Siediti, metti il piede destro sulla coscia sinistra e il sinistro sulla destra. Mani sulle ginocchia, siediti dritto, respira.", benefits: "Apre anche e inguine e allunga ginocchia, caviglie e cosce. Rafforza la schiena e calma la mente, riduce stress e ansia. Migliora la circolazione e il flusso di sangue nel bacino."},
        {name: "Mezza torsione", translation: "ardha = metà, matsya = pesce, indra = re", description: "Siediti, incrocia il ginocchio destro sopra il sinistro, ruota a destra. Gomito sinistro fuori dal ginocchio destro, mano destra dietro. Guarda oltre la spalla, respira.", benefits: "Allunga spalle, petto, cosce, inguine e addome. Rafforza gambe e caviglie. Migliora l’equilibrio."},
        {name: "Candela", translation: "sa = con, ālamba = sostegno, sarvāṅga = tutte le membra, āsana = posizione", description: "Sdraiati sulla schiena. Espira, solleva gambe e bacino, sostieni la schiena con le mani. Distendi le gambe, sguardo verso l’interno, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Stimola tiroide, prostata e organi addominali. Allunga spalle e collo. Tonifica gambe e glutei. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa. Riduce la stanchezza e allevia l’insonnia. Utile in caso di asma, infertilità e sinusite."},
        {name: "Plank laterale", translation: "vasiṣṭha = nome di un saggio, āsana = posizione", description: "Dalla Plank, ruota sul bordo esterno del piede destro. Sovrapponi i piedi, solleva il braccio sinistro. Attiva il core, guarda in alto, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Allunga spalle, femorali, polpacci e arcate plantari. Rafforza braccia e gambe. Aiuta ad alleviare i sintomi della menopausa. Aiuta a prevenire l’osteoporosi. Migliora la digestione. Allevia mal di testa, insonnia, mal di schiena e stanchezza. Utile in caso di pressione alta, asma, piedi piatti e sciatica."},
        {name: "Sfinge", translation: "sālamba = sostenuto, bhujaṅga = serpente, āsana = posizione", description: "Sdraiati a pancia in giù, avambracci sul tappetino, gomiti sotto le spalle. Inspira, solleva il petto, spingi le spalle verso il basso. Guarda avanti, respira.", benefits: "Rafforza la colonna. Allunga petto, polmoni, spalle e addome. Stimola gli organi addominali. Apre cuore e polmoni."},
        {name: "Spaccata", translation: "hanumān = divinità scimmia, āsana = posizione", description: "Dall’affondo, fai scivolare il piede davanti in avanti e quello dietro indietro. Abbassa il bacino, tienilo dritto. Mani a terra o sui mattoncini. Guarda avanti, respira.", benefits: "Allunga cosce, femorali e inguine. Stimola gli organi addominali."},
        {name: "Ghirlanda", translation: "mālā = ghirlanda o collana, āsana = posizione", description: "Accovacciati, piedi uniti o divaricati. Gomiti all’interno delle ginocchia, palmi uniti davanti al petto. Spingi le ginocchia in fuori, abbassa il bacino, guarda avanti, respira.", benefits: "Allunga caviglie, inguine e schiena. Tonifica la pancia."},
        {name: "Piegamento in avanti in piedi", translation: "uttāna = allungamento intenso, āsana = posizione", description: "In piedi, piegati in avanti, mani a terra o sugli stinchi. Tieni la colonna lunga, testa pesante. Guarda in basso, respira.", benefits: "Calma la mente e aiuta ad alleviare lo stress e la depressione lieve. Stimola fegato e reni. Allunga femorali, polpacci e anche. Rafforza cosce e ginocchia. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa. Riduce stanchezza e ansia. Allevia mal di testa e insonnia."},
        {name: "Mezzaluna in piedi", translation: "ashta = lato, chandra = luna, āsana = posizione", description: "In piedi, intreccia le mani sopra la testa. Inspira, inclinati da un lato, allunga il lato opposto. Guarda in alto, respira.", benefits: "Allunga gabbia toracica, braccia e busto. Tonifica gli obliqui."},
        {name: "Spaccata laterale", translation: "upaviṣṭha = seduto, koṇa = angolo, āsana = posizione", description: "Siediti, gambe divaricate. Espira, porta le mani in avanti, abbassa il busto. Tieni la colonna lunga, guarda in basso, respira.", benefits: "Allunga l’interno e il retro delle gambe. Stimola gli organi addominali. Rafforza la colonna. Calma la mente. Scioglie l’inguine."},
        {name: "Albero", translation: "vṛkṣa = albero, āsana = posizione", description: "In piedi, appoggia il piede destro sulla coscia o sul polpaccio sinistro. Palmi uniti sopra la testa o al petto. Trova l’equilibrio, guarda avanti, respira.", benefits: "Rafforza gambe, caviglie e piedi. Migliora la flessibilità di anche e ginocchia. Migliora l’equilibrio."},
        {name: "Triangolo", translation: "trikoṇa = triangolo, āsana = posizione", description: "In piedi a gambe larghe, ruota il piede destro verso l’esterno. Porta la mano destra verso lo stinco o a terra, braccio sinistro in alto. Apri il petto, guarda in alto, respira.", benefits: "Allunga e rafforza cosce, ginocchia e caviglie. Allunga anche, inguine, femorali, polpacci, spalle, petto e colonna. Stimola gli organi addominali. Aiuta ad alleviare lo stress. Migliora la digestione. Aiuta ad alleviare i sintomi della menopausa. Allevia il mal di schiena, soprattutto nel secondo trimestre di gravidanza. Utile in caso di ansia, piedi piatti, infertilità, dolore al collo, osteoporosi e sciatica."},
        {name: "Cane a testa in su", translation: "ūrdhva = verso l’alto, mukha = volto, śvāna = cane, āsana = posizione", description: "Sdraiati a pancia in giù, mani accanto alle spalle. Inspira, solleva petto e cosce, porta le spalle indietro. Guarda avanti, respira.", benefits: "Migliora la postura. Rafforza colonna, braccia e polsi. Allunga petto, polmoni, spalle e addome. Rassoda i glutei. Stimola gli organi addominali. Aiuta ad alleviare depressione lieve, stanchezza e sciatica. Utile in caso di asma."},
        {name: "Guerriero 1", translation: "vīrabhadra = guerriero, āsana = posizione", description: "Porta il piede sinistro indietro, piega il ginocchio destro a 90 gradi. Solleva le braccia sopra la testa, abbassa il bacino. Guarda avanti, respira.", benefits: "Allunga petto, polmoni, spalle, collo, pancia e inguine (psoas). Rafforza spalle, braccia e muscoli della schiena. Rafforza e allunga cosce, polpacci e caviglie."},
        {name: "Guerriero 2", translation: "vīrabhadra = guerriero, āsana = posizione", description: "Porta il piede sinistro indietro, piega il ginocchio destro a 90 gradi. Braccia parallele al suolo, abbassa il bacino. Guarda oltre la mano destra, respira.", benefits: "Rafforza e allunga gambe e caviglie. Allunga inguine, petto, polmoni e spalle. Stimola gli organi addominali. Aumenta la resistenza. Allevia il mal di schiena, soprattutto nel secondo trimestre di gravidanza. Utile in caso di tunnel carpale, piedi piatti, infertilità, osteoporosi e sciatica."},
        {name: "Guerriero 3", translation: "vīrabhadra = guerriero, āsana = posizione", description: "In piedi, sposta il peso sulla gamba destra. Solleva la gamba sinistra indietro parallela al suolo, braccia avanti o di lato. Trova l’equilibrio, guarda in basso, respira.", benefits: "Rafforza caviglie e gambe. Rafforza spalle e muscoli della schiena. Tonifica l’addome. Migliora equilibrio e postura."},
        {name: "Ruota", translation: "ūrdhva = verso l’alto, dhanu = arco, āsana = posizione", description: "Sdraiati sulla schiena con le ginocchia piegate e le mani accanto alle orecchie. Espira, poi solleva bacino e petto formando un arco. Guarda in alto e respira con calma.", benefits: "Rafforza braccia, polsi, gambe, glutei, addominali e colonna. Stimola tiroide e ipofisi. Dà energia, aiuta a contrastare la depressione ed è utile in caso di asma, mal di schiena, infertilità e osteoporosi."},
        {name: "Wild Thing", translation: "camatkāra = colpito da meraviglia, āsana = posizione", description: "Parti dal Cane a testa in giù, poi solleva la gamba destra e apri le anche. Appoggia la mano destra accanto al piede davanti, solleva il braccio sinistro, inarca la schiena, guarda in alto e respira profondamente.", benefits: "Allunga petto, spalle, schiena e gola. Rafforza e apre anche, flessori dell’anca e cosce."}
      ]
      sessionText: [
        {name: "Flow dolce per principianti", description: "Una sequenza rilassante per avvicinarti allo yoga con le posizioni di base e l’attenzione al respiro."},
        {name: "Risveglio mattutino", description: "Una sequenza adatta ai principianti per dare energia e allungare il corpo prima della giornata."},
        {name: "Basi rigeneranti", description: "Una sequenza calmante per principianti per rilassarti e recuperare con posizioni dolci."},
        {name: "Basi in equilibrio", description: "Una sequenza per principianti per costruire equilibrio e forza con posizioni in piedi e da seduti."},
        {name: "Core e allungamento", description: "Una sequenza per principianti per rafforzare il core e migliorare la flessibilità con posizioni semplici."},
        {name: "Forza del core intermedia", description: "Una sequenza intermedia dinamica per costruire stabilità e forza del core."},
        {name: "Flow per aprire le anche", description: "Una sequenza intermedia per allungare e aprire a fondo le anche per una maggiore flessibilità."},
        {name: "Torsioni ed energia", description: "Una sequenza intermedia di torsioni per depurarti e aumentare l’energia."},
        {name: "Sfida d’equilibrio", description: "Una sequenza intermedia per migliorare equilibrio e coordinazione con posizioni in piedi."},
        {name: "Flow vigoroso", description: "Un flow intermedio ad alta energia per costruire resistenza e forza con transizioni dinamiche."},
        {name: "Sequenza per aprire il cuore", description: "Una sequenza intermedia per aprire il petto e rafforzare la schiena con piegamenti all’indietro."},
        {name: "Core e stabilità", description: "Una sequenza intermedia che unisce lavoro sul core e posizioni di equilibrio per una stabilità generale."},
        {name: "Flessibilità da seduti", description: "Una sequenza intermedia di posizioni da seduti per aumentare la flessibilità di anche e femorali."},
        {name: "Forza del guerriero", description: "Una sequenza intermedia sulle posizioni del guerriero per costruire forza e sicurezza."},
        {name: "Energia ed equilibrio", description: "Una sequenza intermedia energizzante per aumentare la vitalità e migliorare l’equilibrio."},
        {name: "Core intensivo avanzato", description: "Una sequenza avanzata per lavorare intensamente sulla forza del core con posizioni impegnative."},
        {name: "Alla scoperta delle inversioni", description: "Una sequenza avanzata per padroneggiare le inversioni, costruendo forza e controllo."},
        {name: "Flessibilità estrema", description: "Una sequenza avanzata per spingere oltre i limiti della flessibilità con allungamenti profondi e spaccate."},
        {name: "Maestria negli equilibri sulle braccia", description: "Una sequenza avanzata sugli equilibri sulle braccia per rafforzare la parte alta del corpo."},
        {name: "Piegamenti all’indietro profondi", description: "Una sequenza avanzata per approfondire i piegamenti all’indietro, aprendo petto e colonna."},
        {name: "Flow definitivo", description: "Un flow avanzato completo che unisce forza, equilibrio e flessibilità."},
        {name: "Precisione e potenza", description: "Una sequenza avanzata che punta su un allineamento preciso e posizioni potenti."},
        {name: "Intensivo per anche e cuore",description: "Una sequenza avanzata per aprire a fondo anche e cuore, per flessibilità e rilascio emotivo."},
        {name: "Forza e controllo", description: "Una sequenza avanzata per costruire forza e controllo con posizioni impegnative."},
        {name: "Maestria nello yoga", description: "Una sequenza avanzata che mette alla prova forza, equilibrio e flessibilità di chi pratica da tempo."},
        {name: "Flow beato per principianti", description: "Una sequenza completa per principianti che scorre armoniosa tra riscaldamento, posizioni in piedi di forza ed equilibrio, piegamenti all’indietro dolci, piegamenti in avanti, aperture delle anche e posizioni rigeneranti, per costruire basi solide."}
      ]
    }
  }

