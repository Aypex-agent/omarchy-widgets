  let today = fmtTime(now ?? 0, "yyyy-MM-dd")
  let yesterday = fmtTime((now ?? 0) - 86400, "yyyy-MM-dd")
  let days = lastDay == today || lastDay == yesterday ? streak : 0
  let level = floor(sqrt(xp / 50)) + 1
  let rank = level >= 50 ? str.ranks.master : level >= 30 ? str.ranks.teacher : level >= 20 ? str.ranks.devotee : level >= 10 ? str.ranks.adept : level >= 5 ? str.ranks.practitioner : str.ranks.novice
  let floorXp = 50 * (level - 1) * (level - 1)
  let ceilXp = 50 * level * level
  let paces = [{name: "swift", v: 0.5}, {name: "balanced", v: 1}, {name: "endurance", v: 2}]
  let order = ["beginner", "intermediate", "advanced"]

  let session = sessions.find(c => c.id == sid) ?? sessions[0]
  let run = session.poses
  let shown = phase == "gap" ? idx + 1 : idx
  let pose = poses[run[shown] - 1]
  let dur = round(pose.time * pace)
  let remaining = phase == "gap" ? dur : paused ? left : max(0, endsAt - (now ?? 0))
  let total = sum(run.map(id => round(poses[id - 1].time * pace))) + len(run) - 1
  let flipped = pose.sides && phase == "hold" && remaining <= dur / 2

  at endsAt {
    step = phase == "intro" || phase == "gap" ? "hold" : idx >= len(run) - 1 ? "finish" : "gap"
    endsAt = step == "finish" ? 0 : step == "gap" ? now + 1 : now + round(poses[run[phase == "gap" ? idx + 1 : idx] - 1].time * pace)
    idx = phase == "gap" ? idx + 1 : idx
    gained = step == "finish" && lastDay != today ? 50 : 0
    streak = step != "finish" || lastDay == today ? streak : lastDay == yesterday ? streak + 1 : 1
    xp = xp + gained
    lastDay = step == "finish" ? today : lastDay
    done = step == "finish" && !contains(done, sid) ? done + [sid] : done
    view = step == "finish" ? "finish" : view
    phase = step
    haptic()
    // The next pose read out, or congratulations; nothing between poses.
    sound(!voice ? null : step == "hold" ? "${voiceUrl}${run[idx]}.mp3" : step == "finish" ? "${voiceUrl}congratulations.mp3" : null)
  }
  // Halfway through a pose held on both sides: switch.
  when flipped {
    haptic()
    sound(voice ? "${voiceUrl}switch_side.mp3" : null)
  }

  // A pose as big as fits, mirrored for the second side.
  component Pose(id, mirror = false, cap = 1000) {
    Canvas {
      fill: true
      let s = min(min(width, height), cap)
      scale(mirror ? -1 : 1, 1, width / 2, height / 2) { image("${art}${id}.svg", (width - s) / 2, (height - s) / 2, s, s) }
    }
  }
  component Thumb(id, s = 40) {
    Box { size: s; Pose { id: id } }
  }
  // A tab of the menu's bottom bar: an icon in a pill when it's the one open, and its name.
  component Tab(name, label, icon) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { tab = name; haptic("light") }
      Box {
        align: center
        width: 64
        height: 32
        Image { src: icon; size: 24; tint: tab == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: tab == name; color: tab == name ? foreground : muted }
    }
  }
  component Clock(secs, size = 56) {
    Text { text: "${floor(secs / 60)}:${pad(str(secs % 60), 2, "0")}"; fontSize: size; bold: true; font: mono; align: center }
  }

  Column {
    fill: true
    gap: 0
    // The views keep a margin, with room at the bottom for a session's buttons; the menu's bar runs to the edges.
    Column {
      weight: 1
      padding: [12, 0, 12, view == "menu" ? 0 : 12]
      gap: 12
      if view == "menu" {
        if xp > 0 {
          Column {
            gap: 6
            padding: 12
            border: 1
            radius: 8 * corners
            Row {
              Text { text: str.levelRank(level, rank); bold: true; weight: 1 }
              Text { text: str.streak(days); color: days > 0 ? accent : muted; width: 120; align: end }
            }
            Progress { value: xp - floorXp; max: ceilXp - floorXp }
            Text { text: str.xpLine(xp, ceilXp - xp, level + 1); style: small; color: muted }
          }
        }
        Column {
          scroll: true
          weight: 1
          gap: 10
          if tab == "sessions" {
            for c in sessions.sortBy(c => indexOf(order, c.level) * 100 + c.id) key c.id {
              Column {
                gap: 6
                padding: 12
                border: 1
                borderColor: contains(done, c.id) ? alpha(accent, 0.6) : border
                radius: 8 * corners
                onTap: { sid = c.id; view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) }
                Row {
                  Text { text: c.name; bold: true; weight: 1 }
                  if contains(done, c.id) { Text { text: str.completed; style: small; color: accent; width: 40; align: end } }
                }
                Text { text: c.description; style: small; color: muted; maxLines: 2 }
                Row {
                  gap: 6
                  height: 40
                  for id in c.poses.take(7) { Thumb { id: id } }
                  if len(c.poses) > 7 { Text { text: "+${len(c.poses) - 7}"; style: small; color: muted; width: 32 } }
                }
                Text { text: str.sessionLine(get(str.levels, c.level, c.level), len(c.poses), fmtDuration(sum(c.poses.map(id => round(poses[id - 1].time * pace))) + len(c.poses) - 1)); style: small; color: accent }
              }
            }
          } else {
            Grid {
              columns: 3
              gap: 10
              for p in poses.sortBy(p => p.name) key p.id {
                Column {
                  gap: 2
                  align: center
                  onTap: { pid = p.id; view = "pose" }
                  Thumb { id: p.id; s: 84 }
                  Text { text: p.name; style: small; align: center; maxLines: 2 }
                }
              }
            }
          }
        }
      } else if view == "pose" {
        let p = poses[pid - 1]
        Column {
          scroll: true
          weight: 1
          gap: 10
          Box { height: 220; fill: width; Pose { id: p.id } }
          Text { text: p.sanskrit; italic: true; align: center }
          Text { text: p.translation; style: small; color: muted; align: center }
          Text { text: str.poseLine(get(str.levels, p.level, p.level), replace(fmtDuration(round(p.time * pace)), " 0s", ""), p.sides); color: accent; align: center }
          Text { text: str.how; style: label; color: accent }
          Text { text: p.description }
          Text { text: str.benefits; style: label; color: accent }
          Text { text: p.benefits }
          let inSessions = sessions.filter(c => contains(c.poses, p.id))
          if len(inSessions) > 0 {
            Text { text: str.inSessions; style: label; color: accent }
            for c in inSessions key c.id {
              Row {
                onTap: { sid = c.id; view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) }
                Text { text: c.name; weight: 1 }
                Text { text: str.startArrow; color: accent; width: 60; align: end }
              }
            }
          }
        }
      } else if view == "session" && phase == "intro" {
        Column {
          weight: 1
          gap: 10
          align: center
          justify: center
          Text { text: str.getReady; style: label; color: muted; align: center }
          Text { text: session.description; color: muted; align: center }
          Box { height: 200; fill: width; Pose { id: run[0] } }
          Text { text: str.first(poses[run[0] - 1].name); style: small; color: muted; align: center }
          Text { text: "${max(0, endsAt - (now ?? 0))}"; fontSize: 64; bold: true; font: mono; color: accent; align: center }
          Row {
            gap: 6
            for pc in paces {
              Button { text: get(str.paces, pc.name, pc.name); color: pace == pc.v ? accent : muted; onTap: pace = pc.v }
            }
          }
          Text { text: str.introLine(len(run), fmtDuration(total)); style: small; color: muted; align: center }
        }
        Row {
          Spacer { weight: 1 }
          Button { text: str.startNow; onTap: endsAt = now }
        }
      } else if view == "session" {
        Row {
          Text { text: str.poseOf(shown + 1, len(run)); style: small; color: muted; weight: 1; maxLines: 1 }
          Button { text: voice ? str.voiceOn : str.voiceOff; color: voice ? accent : muted; onTap: { voice = !voice; sound("stop") } }
        }
        Progress { value: phase == "gap" ? shown : shown + (dur - remaining) / max(dur, 1); max: len(run) }
        Box {
          weight: 1
          fill: width
          Box { fill: true; opacity: phase == "gap" ? 0.5 : 1; Pose { id: pose.id; mirror: flipped; cap: 300 } }
        }
        Text { text: pose.name; style: title; align: center }
        Text { text: pose.plain; color: muted; align: center; maxLines: 1 }
        Clock { secs: remaining }
        Text {
          text: phase == "gap" ? str.nextPose : paused ? str.paused : remaining <= 3 && shown < len(run) - 1 ? str.readyNext : pose.sides ? (flipped ? str.secondSide : str.firstSide) : " "
          color: paused ? yellow : muted
          align: center
        }
        let upcoming = run.drop(shown + 1).take(6)
        Row {
          gap: 6
          height: 36
          fill: width
          justify: center
          if len(upcoming) == 0 { Text { text: str.lastPose; style: small; color: muted; align: center } }
          for id, i in upcoming { Box { opacity: i == 0 ? 1 : 0.5; Thumb { id: id; s: 36 } } }
        }
        if quitting {
          Row {
            gap: 8
            Text { text: str.quitAsk; weight: 1 }
            Button { text: str.keepGoing; onTap: quitting = false }
            Button { text: str.quit; color: red; onTap: { endsAt = 0; paused = false; quitting = false; view = "menu"; sound("stop") } }
          }
        } else {
          Row {
            gap: 8
            Button { text: str.quit; color: muted; onTap: quitting = true }
            Spacer { weight: 1 }
            Button { text: paused ? str.resume : str.pause; onTap: { left = paused ? left : remaining; endsAt = paused ? now + left : 0; paused = !paused; sound(paused ? "stop" : null) } }
            Button { text: str.skip; onTap: { paused = false; endsAt = now } }
          }
        }
      } else {
        Column {
          weight: 1
          gap: 10
          align: center
          justify: center
          Box { height: 180; fill: width; Pose { id: run[len(run) - 1] } }
          Text { text: str.greatJob; style: huge; align: center }
          Text { text: str.streak(days); style: title; color: accent; align: center }
          if gained > 0 { Text { text: "+${gained} xp"; bold: true; color: accent; align: center } }
          if gained > 0 && floor(sqrt((xp - gained) / 50)) + 1 < level { Text { text: str.levelUp(level, rank); bold: true; color: accent; align: center } }
          if gained == 0 { Text { text: str.xpHint; style: small; color: muted; align: center } }
        }
        Row {
          gap: 8
          Button { text: str.done; color: muted; onTap: { view = "menu"; sound("stop") } }
          Spacer { weight: 1 }
          Button { text: str.again; onTap: { view = "session"; phase = "intro"; idx = 0; paused = false; quitting = false; endsAt = now + 10; sound(voice ? "${voiceUrl}start_0${now % 3 + 1}.mp3" : null) } }
        }
      }
    }
    if view == "menu" {
      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "sessions"; label: str.sessions; icon: sessionsIcon }
        Tab { name: "poses"; label: str.poses; icon: posesIcon }
      }
    }
  }
}
