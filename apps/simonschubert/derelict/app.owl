        let dmgIn0 = sum(atk.map(e => e.k == 0 ? 5 + random() * 5 : (e.k == 1 ? (random() < 0.8 - sqrt(((e.x) - (px)) * ((e.x) - (px)) + ((e.y) - (py)) * ((e.y) - (py))) * 0.05 ? 2 + random() * 4 : 0) : 0)))
