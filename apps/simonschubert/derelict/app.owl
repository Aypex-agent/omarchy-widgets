        // ---- canisters that blew last frame hurt everything around them
        let hits2 = flatten(bq.map(c => en.filter(e => e.s != 4 && ((e.x) - (c.x)) * ((e.x) - (c.x)) + ((e.y) - (c.y)) * ((e.y) - (c.y)) < 7).map(e => {id: e.id, d: 75 * (1 - sqrt(((e.x) - (c.x)) * ((e.x) - (c.x)) + ((e.y) - (c.y)) * ((e.y) - (c.y))) / 2.65)})))
        let dmgBoom = sum(bq.map(c => [sqrt(((px) - (c.x)) * ((px) - (c.x)) + ((py) - (c.y)) * ((py) - (c.y)))].map(cd2 => cd2 < 2.65 ? 60 * (1 - cd2 / 2.65) : 0)[0]))
        bq = []

        // ---- damage on them
        let hits = hits0 + hits1 + hits2
        if len(hits) > 0 {
          let was = en
          en = en.map(e => [sum(hits.filter(h => h.id == e.id).map(h => h.d))].map(dm => dm <= 0 || e.s == 4 ? e : (e.hp - dm <= 0 ? merge(e, {hp: 0, s: 4, mv: false}) : merge(e, {
            hp: e.hp - dm,
            s: e.k == 3 ? 0 : (random() < KD[e.k].pain ? 3 : (e.s == 2 ? 2 : 1)),
            t: random() < KD[e.k].pain ? gt + 0.22 : e.t,
            lx: px, ly: py, fl: gt + 0.07
          })))[0])
          let died = en.filter((e, i) => e.s == 4 && was[i].s != 4)
          kills = kills + count(died, e => e.k != 3)
          bq = died.filter(e => e.k == 3).map(e => {x: e.x, y: e.y})
          fx = fx + bq.map(c => {x: c.x, y: c.y, t0: gt, life: 0.5, s: 1.5, b: 0})
          if len(bq) > 0 { haptic("strong") }
          if any(died, e => e.k == 4) {
            msg = "THE WARDEN IS DOWN"
            msgAt = gt
          }
        }

        // ---- damage on you: armor takes a third
        let dmgIn = dmgIn0 + sum(toMe.map(b => b.d)) + dmgBoom
        if dmgIn > 0 {
          let ab = min(ar, dmgIn / 3)
          ar = ar - ab
          hp = hp - (dmgIn - ab)
          hurtAt = gt
          haptic(dmgIn > 12 ? "strong" : "medium")
        }

        // ---- pickups, when they're of use
        let got = items.filter(t => ((t.x) - (px)) * ((t.x) - (px)) + ((t.y) - (py)) * ((t.y) - (py)) < 0.4 && (
          t.k == "m" || t.k == "n" ? hp < 100 : (t.k == "a" ? ar < 100 : (t.k == "r" ? am[0] < AMAX[0] : (t.k == "s" ? am[1] < AMAX[1] : (t.k == "c" ? am[2] < AMAX[2] : true))))))
        if len(got) > 0 {
          let gk = got.map(t => t.k)
          hp = min(100, hp + 25 * count(gk, k => k == "m") + 10 * count(gk, k => k == "n"))
          ar = min(100, ar + 50 * count(gk, k => k == "a"))
          am = [
            min(AMAX[0], am[0] + 20 * count(gk, k => k == "r")),
            min(AMAX[1], am[1] + 8 * count(gk, k => k == "s" || k == "g")),
            min(AMAX[2], am[2] + 40 * count(gk, k => k == "c" || k == "G"))
          ]
          if any(gk, k => k == "q") { kr = true }
          if any(gk, k => k == "Q") { kb = true }
          if any(gk, k => k == "g") {
            if !has[1] { wpn = 1 }
            has = [has[0], true, has[2]]
          }
          if any(gk, k => k == "G") {
            if !has[2] { wpn = 2 }
            has = [has[0], has[1], true]
          }
          items = items.filter(t => !any(got, g => g.id == t.id))
          msg = INAME[got[0].k]
          msgAt = gt
          pickAt = gt
          haptic("light")
        }

        // ---- one sound a frame, the loudest news first (the app has one player: a new one cuts the last off)
        if snd {
          if len(bq) > 0 {
            sound(S_BOOM)
          } else if fireNow {
            sound(wpn == 0 ? S_RIVET : (wpn == 1 ? S_SCATTER : S_PLASMA))
          } else if kills > kills0 {
            sound(S_DEATH)
          } else if hp < hp0 {
            sound(S_HURT)
          } else if len(items) < items0 {
            sound(S_PICKUP)
          } else if any(atk, e => e.k == 1) {
            sound(S_ZAP)
          } else if any(range(len(LD)), i => LD[i].k != 10 && dop0[i] == 0 && dop[i] > 0) {
            sound(S_DOOR)
          }
        }

        // ---- the lift out, or the end of you
        if hp <= 0 {
          hp = 0
          mode = "dead"
          endT = gt
          fingers = []
        } else if abs(px - LV.ex - 0.5) < 0.82 && abs(py - LV.ey - 0.5) < 0.82 {
          mode = lvl >= len(LVS) - 1 ? "won" : "done"
          endT = gt
          unlocked = max(unlocked, min(len(LVS), lvl + 2))
          carry = {hp: hp, ar: ar, am: am, has: has, wpn: wpn}
          fingers = []
          haptic("medium")
        }
      }
    }
  }

  // ---- (re)start the deck lvl with what's in carry
  on go {
    let K0 = carry ?? KIT[lvl]
    let L0 = LVS[lvl]
    hp = K0.hp
    ar = K0.ar
    am = K0.am
    has = K0.has
    wpn = K0.wpn
    px = L0.sx
    py = L0.sy
    pa = L0.sa
    en = L0.en
    items = L0.items
    shots = []
    fx = []
    bq = []
    dop = L0.doors.map(d => 0)
    kr = false
    kb = false
    kills = 0
    secrets = 0
    t0 = gt
    fireAt = gt + 0.3
    shotAt = -9
    hurtAt = -9
    pickAt = -9
    msg = L0.name
    msgAt = gt
    fingers = []
    lookId = -1
    mode = "play"
  }

  Box {
    fill: true
    background: #07080a

    Column {
      fill: true
      gap: 0
      Shader {
        width: W
        height: VH
        // drawn a little larger than its place, so it covers the camera cutout's strip on either side
        scale: (W + 2 * BLEED) / W
        fallback: #14171c
        uniforms: {
          lvmap: lvl == 0 ? MAP1 : (lvl == 1 ? MAP2 : MAP3),
          tex: TEX,
          spr: SPR,
          enm: ENM,
          cam: [px, py, pa, mode == "play" ? sin(walk * 7) * 0.022 : 0],
          vw: [TANH, gt, SINCE < 0.07 ? (wpn == 2 ? 0.25 : 0.45) : 0, mode == "play" || mode == "paused" ? 1 : 0],
          dA: DOP16.take(4), dB: DOP16.drop(4).take(4), dC: DOP16.drop(8).take(4), dD: DOP16.drop(12),
          sp: SPU,
          sz: SZU,
          gun: [mode == "play" || mode == "paused" ? GUNF : -1, sin(walk * 3.5) * 0.035, abs(cos(walk * 3.5)) * 0.035 + KICK, wpn],
          tint: [clamp(1 - (gt - hurtAt) * 2.2, 0, 1), clamp(1 - (gt - pickAt) * 3, 0, 1), mode == "play" ? 0 : (mode == "paused" ? 0.45 : 0.55), hp < 25 && mode == "play" ? 1 : 0]
        }
        code: """
          uniform shader lvmap;
          uniform shader tex;
          uniform shader spr;
          uniform shader enm;
          uniform float4 cam;
          uniform float4 vw;
          uniform float4 dA;
          uniform float4 dB;
          uniform float4 dC;
          uniform float4 dD;
          uniform float4 sp[16];
          uniform float2 sz[16];
          uniform float4 gun;
          uniform float4 tint;

          // a cell's value in one of the map's three panels: 0 wall kind, 1 door number or floor kind, 2 light
          float cellv(float2 c, float k) {
            half4 v = lvmap.eval(float2((c.x + 32.0 * k + 0.5) / 96.0, (c.y + 0.5) / 32.0));
            return floor(float(v.r) * 15.0 + 0.5);
          }
          float lightAt(float2 c) {
            float n = cellv(c, 2.0);
            if (n > 14.5) {
              float f = fract(sin(floor(vw.y * 9.0) * 12.9898 + c.x * 7.1) * 43758.5);
              return f > 0.55 ? 0.95 : 0.22;
            }
            return n / 14.0;
          }
          float dopen(float i) {
            float4 k = float4(0.0, 1.0, 2.0, 3.0);
            return dot(dA, 1.0 - min(abs(float4(i) - k), 1.0)) + dot(dB, 1.0 - min(abs(float4(i) - k - 4.0), 1.0))
              + dot(dC, 1.0 - min(abs(float4(i) - k - 8.0), 1.0)) + dot(dD, 1.0 - min(abs(float4(i) - k - 12.0), 1.0));
          }
          float3 texel(float id, float2 uv) {
            float2 t = (floor(fract(uv) * 64.0) + 0.5) / 64.0;
            float2 c = float2(mod(id, 8.0), floor(id / 8.0));
            return float3(tex.eval((c + t) / float2(8.0, 2.0)).rgb);
          }
          half4 sprt(float id, float2 uv) {
            if (id > 63.5) {
              float j = id - 64.0;
              float2 t2 = (floor(clamp(uv, 0.0, 0.999) * 128.0) + 0.5) / 128.0;
              return enm.eval((float2(mod(j, 4.0), floor(j / 4.0)) + t2) / 4.0);
            }
            float2 t = (floor(clamp(uv, 0.0, 0.999) * 64.0) + 0.5) / 64.0;
            float2 c = float2(mod(id, 8.0), floor(id / 8.0));
            return spr.eval((c + t) / 8.0);
          }

          half4 main(float2 p) {
            float px = max(2.0, floor(min(size.x / 300.0, size.y / 230.0)));
            float2 q = (floor(p / px) + 0.5) * px;
            float Wd = size.x;
            float Ht = size.y;
            float2 pos = cam.xy;
            float2 d = float2(cos(cam.z), sin(cam.z));
            float2 pr = float2(-d.y, d.x);
            float cx = 2.0 * q.x / Wd - 1.0;
            float2 ray = d + pr * (vw.x * cx);
            if (abs(ray.x) < 0.0001) { ray.x = 0.0001; }
            if (abs(ray.y) < 0.0001) { ray.y = 0.0001; }
            float F = Wd * 0.5 / vw.x;
            float dy = Ht * 0.5 - q.y;
            float eye = 0.5 + cam.w;

            // ---- walls: step from cell to cell along the ray until one stops this pixel
            float2 cell = floor(pos);
            float2 dd = abs(1.0 / ray);
            float2 st = sign(ray);
            float2 sd = (st * (cell - pos) + max(st, 0.0)) * dd;
            float zb = 40.0;
            float ht = 0.0;
            float side = 0.0;
            float hop = 0.0;
            float2 pc = cell;
            for (int i = 0; i < 48; i++) {
              float dist = 0.0;
              float s = 0.0;
              float2 prev = cell;
              if (sd.x < sd.y) { dist = sd.x; sd.x += dd.x; cell.x += st.x; s = 0.0; }
              else { dist = sd.y; sd.y += dd.y; cell.y += st.y; s = 1.0; }
              float t = cellv(cell, 0.0);
              if (t > 0.5) {
                float h = eye + dy * dist / F;
                float o = 0.0;
                if ((t > 5.5 && t < 8.5) || t > 9.5) { o = dopen(cellv(cell, 1.0)); }
                if (!(h >= 0.0 && h < o)) { zb = dist; ht = t; side = s; hop = o; pc = prev; break; }
              }
            }

            float hz = eye + dy * zb / F;
            float3 col = float3(0.0);
            float dist = zb;
            float lt = 1.0;
            if (ht > 0.5 && hz >= 0.0 && hz <= 1.0) {
              float2 hp = pos + ray * zb;
              float u = fract(side < 0.5 ? hp.y : hp.x);
              if ((side < 0.5 && ray.x < 0.0) || (side > 0.5 && ray.y > 0.0)) { u = 1.0 - u; }
              float id = ht > 9.5 ? 0.0 : ht - 1.0;
              col = texel(id, float2(u, 1.0 - hz + hop));
              if (side > 0.5) { col *= 0.8; }
              lt = lightAt(pc);
            } else if (dy < 0.0) {
              dist = eye * F / -dy;
              float2 w = pos + ray * dist;
              float2 fc = floor(w);
              float ft = cellv(fc, 0.0) > 0.5 ? 1.0 : cellv(fc, 1.0);
              col = texel(ft > 2.5 ? 14.0 : (ft > 1.5 ? 13.0 : (ft > 0.5 ? 10.0 : 9.0)), w);
              lt = lightAt(fc);
            } else {
              dist = (1.0 - eye) * F / max(dy, 0.001);
              float2 w = pos + ray * dist;
              float2 fc = floor(w);
              lt = lightAt(fc);
              col = texel(lt < 0.6 ? 15.0 : (mod(fc.x + fc.y * 2.0, 3.0) < 0.5 ? 11.0 : 12.0), w);
            }
            float fog = clamp(1.2 - dist * 0.065, 0.06, 1.0);
            col *= lt * fog + vw.z * fog;

            // ---- things: the nearest sprite texel in front of this pixel's wall
            float best = zb;
            half4 sc = half4(0.0);
            float2 sl = pos;
            float sfl = 0.0;
            for (int i = 0; i < 16; i++) {
              float4 s = sp[i];
              float2 rel = s.xy - pos;
              float dep = dot(rel, d);
              if (dep > 0.1 && dep < best) {
                float2 z = sz[i];
                float wx = cx * vw.x * dep - dot(rel, pr);
                float hh = eye + dy * dep / F;
                float2 uv = float2(wx / z.x + 0.5, 1.0 - (hh - z.y) / z.x);
                if (uv.x >= 0.0 && uv.x < 1.0 && uv.y >= 0.0 && uv.y < 1.0) {
                  half4 c = sprt(s.z, uv);
                  if (c.a > 0.5) { best = dep; sc = c; sl = s.xy; sfl = s.w; }
                }
              }
            }
            if (sc.a > 0.5) {
              float f2 = clamp(1.2 - best * 0.065, 0.06, 1.0);
              if (sfl > 1.5) { col = float3(sc.rgb); }
              else if (sfl > 0.5) { col = float3(1.0, 0.95, 0.9); }
              else { col = float3(sc.rgb) * (lightAt(floor(sl)) * f2 + vw.z * f2); }
            }

            // ---- the gun
            if (gun.x >= 0.0) {
              float gs = min(Wd, Ht * 1.05) * 0.62;
              float2 g0 = float2(Wd * 0.5 - gs * 0.5 + gun.y * gs, Ht - gs * 0.94 + gun.z * gs);
              float2 gu = (q - g0) / gs;
              if (gu.x >= 0.0 && gu.x < 1.0 && gu.y >= 0.0 && gu.y < 1.0) {
                half4 c = sprt(gun.x, gu);
                if (c.a > 0.5) { col = float3(c.rgb) * (0.45 + 0.55 * lightAt(floor(pos)) + vw.z); }
              }
            }

            // ---- hurt, pickup, low health and the menus' dimming
            col = mix(col, float3(0.75, 0.02, 0.0), tint.x * 0.45);
            col = mix(col, float3(1.0, 0.85, 0.3), tint.y * 0.22);
            if (tint.w > 0.5) {
              float2 e = (p / size - 0.5) * 2.0;
              col = mix(col, float3(0.5, 0.0, 0.0), clamp(dot(e, e) * 0.35, 0.0, 0.5) * (0.6 + 0.4 * sin(vw.y * 5.0)));
            }
            col *= 1.0 - tint.z;
            return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
          }
        """
      }
      if !LAND {
        // the status bar and the thumbs' room
        Canvas {
          width: W
          height: H - VH
          let bh = BARH
          rect(0, 0, W, bh, fill: #1a1e24)
          rect(0, 0, W, 3, fill: #56606e)
          rect(0, bh - 3, W, 3, fill: #0b0d10)
          if mode == "play" || mode == "paused" {
          for i in range(4) { rect(W * [0, 0.235, 0.455, 0.645][i] + (i == 0 ? 0 : -1), 6, 2, bh - 12, fill: #0b0d10) }
          text("HEALTH", 10, 16, size: 7, color: #8a929c, font: PIX)
          text("${round(hp)}", 10, 40, size: 17, color: hp < 25 ? #ff4030 : #f0e8d8, font: PIX)
          text("ARMOR", W * 0.235 + 8, 16, size: 7, color: #8a929c, font: PIX)
          text("${round(ar)}", W * 0.235 + 8, 40, size: 17, color: #60d880, font: PIX)
          text("AMMO", W * 0.455 + 8, 16, size: 7, color: #8a929c, font: PIX)
          text("${am[wpn]}", W * 0.455 + 8, 40, size: 17, color: #ffc840, font: PIX)
          rect(W * 0.645 + 8, 12, 13, 18, fill: kr ? #ff3a30 : #2a2f36)
          rect(W * 0.645 + 8, 34, 13, 18, fill: kb ? #3a8aff : #2a2f36)
          for i in range(3) {
            let sx = SLX + i * (SLW + 4)
            rect(sx, 15, SLW, SLW, fill: wpn == i ? #ffc840 : (has[i] ? #3a4048 : #20242a))
            rect(sx + 2, 17, SLW - 4, SLW - 4, fill: wpn == i ? #2a2410 : #14171c)
            text("${i + 1}", sx + SLW / 2, 15 + SLW / 2, size: 11, align: center, color: wpn == i ? #ffc840 : (has[i] ? #c8d0da : #3a4048), font: PIX)
          }
          }
          // the floor under the thumbs
          let cy0 = bh
          let ch = H - VH - bh
          rect(0, cy0, W, ch, fill: #0d0f12)
          for i in range(floor(W / 32) + 1) { rect(i * 32, cy0, 1, ch, fill: #15181d) }
          for j in range(floor(ch / 32) + 1) { rect(0, cy0 + j * 32, W, 1, fill: #15181d) }
        }
      }
    }

    // ---- thumbs, words over the view, and the menus; every touch lands here
    Canvas {
      fill: true
      let LFd = first(fingers.filter(f => f.startX < W / 2 && (LAND || f.startY < BARY || f.startY > CTY)))
      let RFd = first(fingers.filter(f => f.startX >= W / 2 && (LAND || f.startY < BARY || f.startY > CTY)))
      let fireOn = RFd != null && ((RFd.startX) - (FBX)) * ((RFd.startX) - (FBX)) + ((RFd.startY) - (FBY)) * ((RFd.startY) - (FBY)) < FBR * FBR * 1.7
      if mode == "play" {
        // crosshair
        rect(W / 2 - 1, VH / 2 - 7, 2, 4, fill: alpha(#ffffff, 0.7))
        rect(W / 2 - 1, VH / 2 + 3, 2, 4, fill: alpha(#ffffff, 0.7))
        rect(W / 2 - 7, VH / 2 - 1, 4, 2, fill: alpha(#ffffff, 0.7))
        rect(W / 2 + 3, VH / 2 - 1, 4, 2, fill: alpha(#ffffff, 0.7))
        // the stick
        let sbx = LFd == null ? (LAND ? 110 : W * 0.25) : LFd.startX
        let sby = LFd == null ? (LAND ? H - 100 - INS : FBY) : LFd.startY
        circle(sbx, sby, 46, stroke: alpha(#c8d0da, LFd == null ? 0.25 : 0.5), width: 3)
        if LFd != null {
          let kx = sbx + clamp(LFd.x - sbx, -46, 46)
          let ky = sby + clamp(LFd.y - sby, -46, 46)
          circle(kx, ky, 20, fill: alpha(#c8d0da, 0.45))
        } else {
          text("MOVE", sbx, sby, size: 9, align: center, color: alpha(#c8d0da, 0.45), font: PIX)
        }
        if RFd != null && !fireOn {
          circle(RFd.startX, RFd.startY, 34, stroke: alpha(#c8d0da, 0.35), width: 2)
          circle(RFd.startX, RFd.startY, 104, stroke: alpha(#c8d0da, 0.18), width: 2)
          circle(RFd.startX + clamp(RFd.x - RFd.startX, -104, 104), RFd.startY, 18, fill: alpha(#c8d0da, 0.4))
        }
        // the fire button: an octagon on a darker ledge, sunk while held
        let fo = fireOn ? 4 : 0
        path(range(8).map(i => [FBX + cos(rad(i * 45 + 22.5)) * FBR, FBY + 6 + sin(rad(i * 45 + 22.5)) * FBR]), closed: true, fill: #5a140e)
        path(range(8).map(i => [FBX + cos(rad(i * 45 + 22.5)) * FBR, FBY + fo + sin(rad(i * 45 + 22.5)) * FBR]), closed: true, fill: fireOn ? #ff5a3a : #c8321e)
        path(range(8).map(i => [FBX + cos(rad(i * 45 + 22.5)) * (FBR - 8), FBY + fo + sin(rad(i * 45 + 22.5)) * (FBR - 8)]), closed: true, fill: fireOn ? #ff7a50 : #e0462a)
        text("FIRE", FBX, FBY + fo, size: 11, align: center, color: #fff4e0, font: PIX)
        text("SLIDE OR HOLD TO TURN", FBX - (LAND ? 40 : 0), FBY + FBR + (LAND ? 16 : 22), size: 7, align: center, color: alpha(#c8d0da, 0.4), font: PIX)
        if LAND {
          text("HP ${round(hp)}", 16, 20, size: 12, color: hp < 25 ? #ff4030 : #f0e8d8, font: PIX)
          text("AR ${round(ar)}", 120, 20, size: 12, color: #60d880, font: PIX)
          text("AMMO ${am[wpn]}", 220, 20, size: 12, color: #ffc840, font: PIX)
          rect(360, 12, 10, 16, fill: kr ? #ff3a30 : alpha(#2a2f36, 0.6))
          rect(376, 12, 10, 16, fill: kb ? #3a8aff : alpha(#2a2f36, 0.6))
          for i in range(3) {
            let lx0 = SLX + i * (SLW + 6)
            rect(lx0, SLY, SLW, SLW, fill: wpn == i ? #ffc840 : (has[i] ? #3a4048 : #20242a))
            rect(lx0 + 2, SLY + 2, SLW - 4, SLW - 4, fill: wpn == i ? #2a2410 : #14171c)
            text("${i + 1}", lx0 + SLW / 2, SLY + SLW / 2, size: 11, align: center, color: wpn == i ? #ffc840 : (has[i] ? #c8d0da : #3a4048), font: PIX)
          }
        }
      }

      // ---- the menus
      if mode != "play" {
        let big = min(W, H) / 12
        let my = LAND ? H * 0.16 : VH * 0.3
        if mode == "title" {
          text("DERELICT", W / 2 + 3, my + 3, size: big, align: center, color: #5a140e, font: PIX)
          text("DERELICT", W / 2, my, size: big, align: center, color: #e0462a, font: PIX)
          text("THE STATION WENT DARK. GO IN.", W / 2, my + big * 1.3, size: 8, align: center, color: #c8d0da, font: PIX)
          for i in range(len(LVS)) {
            let by = MENUY + i * MENUH
            let opn = i < unlocked
            rect(W / 2 - MENUW / 2, by + 5, MENUW, MENUH - 12, fill: opn ? #5a140e : #14171c)
            rect(W / 2 - MENUW / 2, by, MENUW, MENUH - 12, fill: opn ? #c8321e : #20242a)
            text("${i + 1} ${LVS[i].name}", W / 2, by + (MENUH - 12) / 2, size: 11, align: center, color: opn ? #fff4e0 : #4a5058, font: PIX)
          }
          text("TAP A DECK", W / 2, MENUY + len(LVS) * MENUH + 14, size: 8, align: center, color: #8a929c, font: PIX)
          text("LEFT THUMB MOVES - RIGHT THUMB TURNS - HOLD FIRE", W / 2, MENUY + len(LVS) * MENUH + 36, size: 6, align: center, color: #5a626c, font: PIX)
          text(snd ? "SOUND ON" : "SOUND OFF", W / 2, MENUY + len(LVS) * MENUH + 72, size: 8, align: center, color: snd ? #c8d0da : #5a626c, font: PIX)
        } else if mode == "paused" {
          text("PAUSED", W / 2, my, size: big, align: center, color: #ffc840, font: PIX)
          rect(W / 2 - MENUW / 2, MENUY + 5, MENUW, MENUH - 12, fill: #5a140e)
          rect(W / 2 - MENUW / 2, MENUY, MENUW, MENUH - 12, fill: #c8321e)
          text("RESUME", W / 2, MENUY + (MENUH - 12) / 2, size: 11, align: center, color: #fff4e0, font: PIX)
          rect(W / 2 - MENUW / 2, MENUY + MENUH + 5, MENUW, MENUH - 12, fill: #14171c)
          rect(W / 2 - MENUW / 2, MENUY + MENUH, MENUW, MENUH - 12, fill: #3a4048)
          text("QUIT TO TITLE", W / 2, MENUY + MENUH + (MENUH - 12) / 2, size: 11, align: center, color: #c8d0da, font: PIX)
          rect(W / 2 - MENUW / 2, MENUY + 2 * MENUH + 5, MENUW, MENUH - 12, fill: #14171c)
          rect(W / 2 - MENUW / 2, MENUY + 2 * MENUH, MENUW, MENUH - 12, fill: #3a4048)
          text(snd ? "SOUND ON" : "SOUND OFF", W / 2, MENUY + 2 * MENUH + (MENUH - 12) / 2, size: 11, align: center, color: #c8d0da, font: PIX)
        } else if mode == "dead" {
          text("YOU DIED", W / 2 + 3, my + 3, size: big, align: center, color: #300806, font: PIX)
          text("YOU DIED", W / 2, my, size: big, align: center, color: #ff3a20, font: PIX)
          text("${LV.name}  -  ${kills}/${LV.nk} KILLS", W / 2, my + big * 1.4, size: 8, align: center, color: #c8d0da, font: PIX)
          text("TAP TO TRY THE DECK AGAIN", W / 2, my + big * 1.4 + 50, size: 9, align: center, color: #ffc840, font: PIX)
        } else {
          let won = mode == "won"
          text(won ? "STATION CLEAR" : "DECK CLEAR", W / 2, my, size: big * (won ? 0.8 : 1), align: center, color: #60d880, font: PIX)
          text(LV.name, W / 2, my + big * 1.4, size: 9, align: center, color: #c8d0da, font: PIX)
          text("KILLS    ${kills} / ${LV.nk}", W / 2, my + big * 1.4 + 30, size: 9, align: center, color: #f0e8d8, font: PIX)
          text("SECRETS  ${secrets} / ${LV.ns}", W / 2, my + big * 1.4 + 52, size: 9, align: center, color: #f0e8d8, font: PIX)
          text("TIME     ${floor((endT - t0) / 60)}:${pad(floor((endT - t0) % 60), 2, "0")}", W / 2, my + big * 1.4 + 74, size: 9, align: center, color: #f0e8d8, font: PIX)
          text(won ? "TAP FOR THE TITLE" : "TAP FOR THE NEXT DECK", W / 2, my + big * 1.4 + 112, size: 9, align: center, color: #ffc840, font: PIX)
        }
      }

      onTouch: {
        let fresh = touches.filter(t => !any(fingers, f => f.id == t.id))
        let tf = first(fresh)
        if tf != null {
          if mode == "play" {
            // weapon slots
            let slot = first(range(3).filter(i => tf.x >= SLX + i * (SLW + (LAND ? 6 : 4)) - 3 && tf.x < SLX + i * (SLW + (LAND ? 6 : 4)) + SLW + 3 && tf.y >= SLY - 6 && tf.y < SLY + SLW + 6))
            if slot != null && has[slot] {
              wpn = slot
              fireAt = max(fireAt, gt + 0.25)
              haptic("light")
            }
          } else if mode == "title" {
            let pick = first(range(len(LVS)).filter(i => i < unlocked && tf.y >= MENUY + i * MENUH && tf.y < MENUY + (i + 1) * MENUH - 8 && abs(tf.x - W / 2) < MENUW / 2))
            if abs(tf.y - (MENUY + len(LVS) * MENUH + 72)) < 20 && abs(tf.x - W / 2) < 90 {
              snd = !snd
            }
            if pick != null {
              lvl = pick
              carry = KIT[pick]
              go = go + 1
            }
          } else if mode == "paused" {
            if abs(tf.x - W / 2) < MENUW / 2 && tf.y >= MENUY && tf.y < MENUY + MENUH - 8 {
              mode = "play"
              lookId = -1
            } else if abs(tf.x - W / 2) < MENUW / 2 && tf.y >= MENUY + 2 * MENUH && tf.y < MENUY + 3 * MENUH - 8 {
              snd = !snd
            } else if abs(tf.x - W / 2) < MENUW / 2 && tf.y >= MENUY + MENUH && tf.y < MENUY + 2 * MENUH - 8 {
              mode = "title"
              lvl = 0
              px = LVS[0].sx
              py = LVS[0].sy
              en = []
              items = []
              shots = []
            }
          } else if mode == "dead" && gt - endT > 0.8 {
            go = go + 1
          } else if mode == "done" && gt - endT > 0.8 {
            lvl = lvl + 1
            go = go + 1
          } else if mode == "won" && gt - endT > 0.8 {
            mode = "title"
            lvl = 0
            carry = null
            px = LVS[0].sx
            py = LVS[0].sy
            en = []
            items = []
          }
        }
        fingers = touches
      }
    }

    // messages over the view: their own small Canvas, as they fade by the clock
    if mode == "play" && gt - msgAt < 2.2 {
      Canvas {
        fill: true
        let fa = clamp((2.2 - (gt - msgAt)) * 2, 0, 1)
        text(msg, W / 2 + 2, (LAND ? 52 : (screenTop ?? 0) + 30) + 2, size: 10, align: center, color: alpha(#000000, fa), font: PIX)
        text(msg, W / 2, LAND ? 52 : (screenTop ?? 0) + 30, size: 10, align: center, color: alpha(#ffc840, fa), font: PIX)
      }
    }
  }

}
