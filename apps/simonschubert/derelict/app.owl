        }

        // ---- your shot
        let canFire = has[wpn] && am[wpn] > 0
        if firing && gt >= fireAt && !canFire {
          let alt = first(range(3).filter(i => has[2 - i] && am[2 - i] > 0))
          if alt != null { wpn = 2 - alt }
          msg = "OUT OF AMMO"
          msgAt = gt
          fireAt = gt + 0.5
        }
        let fireNow = firing && gt >= fireAt && canFire
