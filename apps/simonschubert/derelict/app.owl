app "derelict" {
  meta { owl: 23; description: "A retro first-person shooter on a space station gone dark: clear three decks of husks, drones and brutes, find the keycards and the secrets, reach the exit lift"; version: "1.0"; license: "MIT"; category: "games" }
  // How it works: the view is one AGSL shader, a grid raycaster in the spirit of the early 90s. Each deck is a
  // 32 x 32 grid, kept twice: as lists here, for walking, sight and shots, and as a small grey image the shader
  // reads (wall kind, door number or floor kind, and light, side by side), so a ray only samples a texture per
  // cell it crosses. Walls, floors and ceilings come from a 64 px texture sheet; enemies, items and the gun from
  // a sprite sheet, the 16 nearest things in front passed in as uniforms and depth-tested against the wall each
  // pixel's ray hit. Doors slide up: the shader gets how far each one is open, and a ray passes under it.
  // Everything moves in `every frame` by `dt`. The left thumb is a stick wherever it lands; the right thumb
  // turns by sliding, and fires while it started on the fire button.
  title: ""
  statusBar: false
  edge: true
  fps: mode == "play" ? 60 : (modes.saver ? 15 : 30)
  source modes = android.modes
  back: mode == "play"
  onBack: mode = "paused"
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges">
    <defs><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath></defs>
    <g clip-path="url(#t)">
      <rect width="256" height="256" fill="#0b0d10"/>
      <path d="M0 0H256L196 60H60Z" fill="#3a3f48"/>
      <path d="M0 256H256L196 196H60Z" fill="#2a2f36"/>
      <path d="M0 0L60 60V196L0 256Z" fill="#56606e"/>
      <path d="M256 0L196 60V196L256 256Z" fill="#4a5360"/>
      <rect x="92" y="36" width="8" height="30" fill="#30343a"/>
      <rect x="88" y="28" width="16" height="12" fill="#ff4040"/>
      <rect x="40" y="104" width="44" height="52" fill="#c04030"/>
      <rect x="172" y="104" width="44" height="52" fill="#902a20"/>
      <rect x="72" y="64" width="112" height="120" fill="#9aa4b0"/>
      <rect x="72" y="64" width="112" height="20" fill="#c8d0da"/>
      <rect x="72" y="164" width="112" height="20" fill="#6a7480"/>
      <rect x="160" y="84" width="24" height="80" fill="#7a8490"/>
      <rect x="96" y="96" width="64" height="64" fill="#140606"/>
      <rect x="104" y="104" width="48" height="48" fill="#ff2a20"/>
      <rect x="112" y="112" width="16" height="16" fill="#ffd8d0"/>
      <rect x="108" y="184" width="40" height="14" fill="#6a7480"/>
      <rect x="116" y="198" width="24" height="26" fill="#40d0ff"/>
      <rect x="122" y="198" width="12" height="18" fill="#e0ffff"/>
    </g>
  </svg>"""

  asset MAP1 = base64""
  asset MAP2 = base64""
  asset MAP3 = base64""
  asset TEX = base64""
  asset SPR = base64""
  asset ENM = base64""
  asset S_RIVET = base64""
  asset S_SCATTER = base64""
  asset S_PLASMA = base64""
  asset S_HURT = base64""
  asset S_DEATH = base64""
  asset S_PICKUP = base64""
  asset S_DOOR = base64""
  asset S_BOOM = base64""
