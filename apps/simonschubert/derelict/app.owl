  let KD = [
    {sp: 1.9, r: 0.28, cd: 1.25, size: 0.95, base: 0, f0: 64, pain: 0.7},
    {sp: 2.2, r: 0.25, cd: 1.5, size: 0.62, base: 0.24, f0: 69, pain: 0.9},
