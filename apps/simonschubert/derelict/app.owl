  let INAME = {m: "MEDKIT", n: "STIM", a: "ARMOR VEST", r: "RIVETS", s: "SHELLS", c: "POWER CELLS", q: "RED KEYCARD", Q: "BLUE KEYCARD", g: "SCATTERGUN", G: "PLASMA CUTTER"}
  let WNAME = ["RIVET GUN", "SCATTERGUN", "PLASMA CUTTER"]
  let AMAX = [200, 50, 300]
  // what you carry into a deck picked on the title
  let KIT = [
    {hp: 100, ar: 0, am: [50, 0, 0], has: [true, false, false], wpn: 0},
    {hp: 100, ar: 25, am: [80, 16, 0], has: [true, true, false], wpn: 1},
    {hp: 100, ar: 50, am: [100, 24, 80], has: [true, true, true], wpn: 1}
  ]

  // ---- state ----------------------------------------------------------------------------------------------------
  // "title", "play", "paused", "dead", "done" (a deck cleared) or "won"
  state mode = "title"
  // decks open on the title, and what you carried into the deck you're on
  state unlocked = 1 persist
  state carry = null persist
  state lvl = 0
  // bumped to (re)start the deck lvl from carry
  state go = 0
  state gt = 0
  state fn = 0
  // the player: where, which way (radians, 0 is +x, the grid's y runs down so +angle turns right)
  state px = 2.5
  state py = 21.5
  state pa = 0
  state walk = 0
  state hp = 100
  state ar = 0
  state am = [50, 0, 0]
  state has = [true, false, false]
  state wpn = 0
  state kr = false
  state kb = false
  state en = []
  state items = []
  state shots = []
  state fx = []
  // canisters that blew this frame, to hurt what's around them next frame
  state bq = []
  state dop = []
  state nextId = 1
  state fireAt = 0
  state shotAt = -9
  state hurtAt = -9
  state pickAt = -9
  state msg = ""
  state msgAt = -9
  state kills = 0
  state secrets = 0
  state t0 = 0
  state endT = 0
  state fingers = []
  state lookId = -1
  state lookX = 0
  state snd = true persist
  // set by the store's screens to hold a picture still
  state still = false

  // ---- layout ---------------------------------------------------------------------------------------------------
  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let INS = screenInset ?? 0
  let LAND = W > H
  // portrait: the view on top, the status bar under it, the thumbs' room below; landscape: the view fills it
  let VH = LAND ? H : floor(min(H * 0.56, W * 1.12))
  let BARY = LAND ? 0 : VH
  let BARH = LAND ? 0 : 64
  let CTY = BARY + BARH
  let FBR = LAND ? 50 : 56
  let FBX = W - (LAND ? 86 : 96)
  let FBY = LAND ? H - 84 - INS : CTY + (H - CTY - INS) / 2
