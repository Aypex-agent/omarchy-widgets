app "mtg cards" {
  meta { owl: 23; description: "Magic: The Gathering cards from Scryfall: search with Scryfall's syntax, card pages with prices, legality, printings and rulings, a random card, and deck lists"; version: "1.3"; license: "MIT"; category: "games" }
  // chips are as wide as len(label) * 8 + 28; the five sort chips share a row
  strings {
    en {
      card: "card"
      randomCard: "random card"
      search: "search"
      random: "random"
      decks: "decks"
      settings: "settings"
      noMatch: "no cards match"
      busy: "Scryfall is busy; try again in a minute"
      unreachable: "couldn't reach Scryfall"
      cantLoadCard: "couldn't load the card"
      noCardFilter: "no card matches that filter"
      noAnswer: c => "Scryfall didn't answer: ${c}"
      notFound: names => "not found: ${names}. "
      imported: n => "imported ${n} cards. "
      importing: "importing…"
      tryAgain: "try again"
      loading: "loading…"
      flipTo: name => "↻ flip to ${name}"
      loyalty: v => "loyalty ${v}"
      defense: v => "defense ${v}"
      illustrated: a => "illustrated by ${a}"
      prices: "prices"
      noPrices: "Scryfall has no prices for this printing"
      deck: "deck"
      addToDeck: "add to a deck"
      inIt: n => "${n} in it"
      addedTo: d => "added to ${d}"
      addedToSide: d => "added to ${d}'s sideboard"
      plusMain: "+ main"
      plusSide: "+ side"
      firstDeck: "name your first deck"
      orNewDeck: "or a new deck"
      create: "create"
      done: "done"
      legality: "legality"
      legal: "legal"
      banned: "banned"
      restricted: "restricted"
      notLegal: "not legal"
      printings: (n, more) => "${n}${more ? "+" : ""} printings"
      showAll: "show all"
      rulings: "rulings"
      showRulings: "show rulings"
      noRulings: "no rulings for this card"
      cantRulings: "couldn't load the rulings"
      share: "share"
      cards: n => "${n} cards"
      plusSideboard: n => " + ${n} sideboard"
      sideboardN: n => "sideboard ${n}"
      noSideboard: "no sideboard"
      updatingPrices: "updating prices…"
      pricesJust: "prices just updated"
      pricesFrom: a => "prices from ${a} ago"
      manaCurve: "mana curve"
      addCards: "add cards"
      importList: "import"
      shareList: "share list"
      copy: "copy"
      updatePrices: "update prices"
      rename: "rename"
      delete: "delete"
      copiedList: "copied the list"
      deckName: "deck name"
      deleteQ: d => "delete ${d}?"
      cardSearch: "a card's name, or any Scryfall search"
      searching: "searching…"
      side: "side"
      pasteHelp: "Paste a deck list, one card a line like \"4 Lightning Bolt\" or \"1 Sol Ring (C21) 263\", with \"Sideboard\" before the sideboard."
      impCount: (n, l) => "${n} cards in ${l} lines"
      emptyDeck: "An empty deck: add cards from a card's page, search for them under add cards, or import a list."
      group: i => ["creature", "planeswalker", "battle", "land", "instant", "sorcery", "artifact", "enchantment", "other"][i]
      sideboard: "sideboard"
      searchHint: "search cards, e.g. t:dragon c:r"
      sortName: "name"
      sortNew: "new"
      sortMana: "mana"
      sortPrice: "price"
      recent: "recent"
      try: "try"
      example: i => ["legendary dragons", "cheap blue card draw", "Golgari commanders", "big creatures in Pauper", "cards worth $100 or more", "this year's mythics", "art with cats in it"][i]
      syntaxHelp: "Searches use Scryfall's syntax: t: type, o: rules text, c: colors, id: color identity, mv: mana value, f: format, r: rarity, s: set, usd: price."
      syntaxGuide: "the full syntax guide"
      prev: "‹ prev"
      next: "next ›"
      page: n => "page ${n}"
      filter: i => ["any card", "commander", "planeswalker", "mythic", "silly", "pricey"][i]
      ownFilter: "or your own filter, e.g. t:goblin"
      another: "another"
      decksEmpty: "Keep your deck lists here: name one, then add cards from their pages, search for them inside the deck, or paste a list."
      newDeckName: "new deck name"
      pricesIn: "prices in"
      usd: "US dollars"
      eur: "euros"
      tix: "MTGO tickets"
      searchResults: "search results"
      listPrices: "a list with prices"
      gridCards: "a grid of cards"
      everyPrinting: "every printing, not one per card"
      clearRecent: "clear recent searches"
      disclaimer: "Cards, prices and images come from Scryfall, fetched only while the app is open. Prices are updated once a day. Mana symbols and card images are Wizards of the Coast's; this app isn't affiliated with Wizards of the Coast or Scryfall."
    }
