      impCount: (n, l) => "${n} kartu dalam ${l} baris"
      emptyDeck: "Dek kosong: tambahkan kartu dari halaman kartu, cari di tambah kartu, atau impor daftar."
      group: i => ["makhluk", "planeswalker", "pertempuran", "tanah", "instan", "sihir", "artefak", "pesona", "lainnya"][i]
