  // ---- saved -------------------------------------------------------------------------------------
  // title, starter, map, battle, party, bag, shop, den, log
  state scene = "title" persist
  state started = false persist
  state area = 0 persist
  state hx = 5 persist
  state hy = 9 persist
  // facing: 0 down, 1 up, 2 left, 3 right
  state hf = 0 persist
  // a kin: species, level, experience, health, max health, attack, defence, speed, moves
  state party = [] persist
  state den = [] persist
  state gold = 100 persist
  // tonics, elixirs, wake herbs, charms, gold charms
  state inv = [3, 0, 1, 5, 0] persist
  state sig = [false, false, false, false, false] persist
  state seen = [] persist
  state caught = [] persist
  state wins = 0 persist
  // a battle: wild or not, the keeper, the foes and the one out, our one out, and the stat stages
  state bt = null persist
  // menu (choose), anim (a turn plays), swap (pick the next after a faint)
  state bphase = "menu" persist
  state bnext = "menu" persist
  // a talk on the map: its pages, the page, and the keeper whose battle follows
  state talk = null persist

  // ---- for now -----------------------------------------------------------------------------------
  state evs = []
  state tq = 0
  state bv = [null, null]
  state bAct = null
  state bGo = 0
  state bdone = false
  // the bag or the kin list over the battle buttons, and the item picked
  state sub = ""
  state selIt = -1
  state hint = ""
  state fxTap = 0
  state fxAt = 0
  state fxLen = 0
  when fxAt == -1 && time != fxTap { fxAt = time }
  state walking = false
  state wp = []
  state wTap = 0
  state wAt = 0
  state wLen = 0
  state wNext = null
  when wAt == -1 && time != wTap { wAt = time }
  state pSel = -1
  state denPg = 0
  state sure = false
  state downAt = [-1, -1]

  // ---- the screen --------------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let INS = max(screenInset ?? 0, 12)
  let LS = SW > SH
  let W = 11
  let H = 15
  let N = 165
  let STEP = 0.17
  let T = floor(LS ? min((SH - TOP - INS - 44) / H, SW * 0.55 / W) : min((SW - 8) / W, (SH - TOP - INS - 250) / H))
  let q = T / 12
  let BX = LS ? 10 : floor((SW - W * T) / 2)
  let BY = TOP + 34
  let PX = LS ? BX + W * T + 14 : 10
  let PW = LS ? SW - PX - 12 : SW - 20
  let PY = LS ? TOP + 34 : BY + H * T + 10
  let PB = SH - INS - 6
  // the panel's buttons
  let PBH = 46
  let PBY = PB - PBH
  let PBW = (PW - 18) / 4
  // the battle: the scene, then the message and the buttons below it (beside it, held sideways)
  let SCW = LS ? floor(SW * 0.52) : SW
  let SCH = LS ? SH - TOP - INS : floor(min(SH * 0.5, SW * 1.15))
  let CX0 = LS ? SCW + 10 : 10
  let CW = LS ? SW - CX0 - 12 : SW - 20
  let CY0 = LS ? TOP + 10 : TOP + SCH + 6
  let MBH = 70
  let BTY = CY0 + MBH + 10
  let BBW = (CW - 8) / 2
  let BBH = floor(clamp((SH - INS - BTY - 78) / 2, 44, 76))
  let B3Y = BTY + 2 * BBH + 12
  let B3W = (CW - 16) / 3
  let LRY = BTY
  let LRH = floor(min(60, (SH - INS - LRY - 58) / 6))
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"
  let INK = "#14121c"
  let BTN = {
    wood: ["#f0c890", "#b07a44", "#84542a", "#3e2410"],
    off: ["#6a6680", "#46425a", "#36324a", "#1a1824"],
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
