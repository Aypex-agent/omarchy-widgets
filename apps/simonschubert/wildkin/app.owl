  let MAPS = [
    "TTTTT=TTTTTTf...=...fTT.RRR=BBB.TT.HDH=HDH.TT....=....TT=========TT.f..=..f.TT.VVV=....TT.HDH=.~~.TT....=.~~.TTff..=....TT...!=...fTTf...=...TTTT..f=..TTTTTTTTTTTTTT",
    "TTTT#G#TTTTT,,,.=.,,,TT,,,.=.,,,TT,,.f=f.,,TT.PPP=.,,,TT.HdH=.,,,TT....=....T===========T.,,,=,,,.TT.,,,=,,,.TT..,.=.,..TTf...=..f.TT,,..=..,,TT,,..=..,,TTTTTT=TTTTT",
    "TTTTTTTTTTTT,,T,,,T,,TT,,,,T,,,,TTT,PPP,,T,TT,,HdH,,,,TT,,,=,,T,,TT,T,=,,,,TTT,,,=======TT,,=,,T,,TT,,,=,,,,,TT,T,,,T,,,TT,,,,,,,T,TTT,,T,,,,,TT,,,,,T,,TTTTTTTTTTTTT",
    "#########~~#..ss,,s~~~#,,sss,ss~~#,,sPPPs~~~#,ssHdHss~~#,,sssss,~~#,sss,ss,s~ssssss,,ss~#,,ss,,ss~~#,,,ss,,s~~#f,sss,,ss~#,,ss,,,s~~#,sss,,ss~~##,,sss,s~~##########~",
    "####cGc#####,,,c=c,,,##,LL,=,,,L##,LL,=,PPP##,,,c=cHdH##c,,c=c,c,##,,#c=c#,,##,,,c=c,,,##LL,,=,,LL##LL,,=,,,L##,,N.=.,,,##,,,,=,,,,##c,,c=c,,c##,,,c=c,,,######=#####",
    "############T.PPPPP.T##..HHdHH..##T,,.=.,,T##,,,,=,,,,##T,,,=,,,T##,,#.=.#,,##,,,,=,,,,##T,,,=,,,T##,,,,=,,,,##,,#,=,#,,##T,,,=,,,T##,,,,=,,,,##T,,,=,,,T######=#####"
  ]
  // what can be talked to: the healers, the shop, the den, a sign, the keepers and the wardens
  let IA = [
    {a: 0, c: 36, k: "heal"}, {a: 0, c: 40, k: "shop"}, {a: 0, c: 91, k: "den"}, {a: 0, c: 125, k: "sign"},
    {a: 1, c: 58, k: "keeper", n: 0}, {a: 1, c: 5, k: "gate", n: 2},
    {a: 2, c: 48, k: "keeper", n: 1},
    {a: 3, c: 49, k: "keeper", n: 2},
    {a: 4, c: 52, k: "keeper", n: 3}, {a: 4, c: 113, k: "heal"}, {a: 4, c: 5, k: "gate", n: 4},
    {a: 5, c: 27, k: "keeper", n: 4}
  ]
  // wild kin in each area's tall grass: species, lowest and highest level, and how often
  let WL = [
    [],
    [[6, 2, 4, 40], [8, 3, 4, 25], [10, 2, 4, 20], [18, 3, 4, 15]],
    [[12, 6, 9, 35], [18, 6, 9, 25], [8, 7, 9, 20], [6, 6, 8, 20]],
    [[14, 9, 12, 40], [10, 9, 12, 25], [8, 10, 12, 15], [6, 10, 12, 15], [7, 14, 14, 5]],
    [[16, 14, 18, 40], [10, 15, 18, 25], [12, 15, 17, 25], [11, 19, 19, 10]],
    [[7, 22, 26, 25], [9, 22, 26, 25], [13, 23, 26, 20], [11, 23, 26, 20], [17, 23, 25, 7], [20, 30, 30, 3]]
  ]
  let KP = [
    {n: "ROWAN", t: "KEEPER ROWAN", g: 150, tm: [[6, 6], [18, 7]],
      intro: ["I AM ROWAN, KEEPER OF THE MEADOW.", "SHOW ME HOW YOU CARE FOR YOUR KIN!"],
      win: ["WELL RAISED! TAKE THE LEAF SIGIL.", "THE WARDEN NORTH LETS THROUGH|ANYONE WITH TWO SIGILS."],
      after: ["MOSSGROVE LIES WEST, AND THE|BRINE SHORE EAST. GOOD LUCK!"]},
    {n: "MAVE", t: "KEEPER MAVE", g: 300, tm: [[12, 11], [8, 11], [12, 13]],
      intro: ["SHH... THE GROVE IS LISTENING.", "MY SHADE KIN WILL TEST YOUR NERVE."],
      win: ["YOU DIDN'T FLINCH.|THE SHADE SIGIL IS YOURS."],
      after: ["SHADE HITS SHADE HARD.|PLAIN MOVES BARELY TOUCH IT."]},
    {n: "NERIS", t: "KEEPER NERIS", g: 450, tm: [[14, 14], [2, 15], [15, 17]],
      intro: ["THE TIDE COMES IN FOR EVERYONE.", "LET'S SEE IF YOU CAN SWIM!"],
      win: ["WASHED OUT!|THE TIDE SIGIL IS YOURS."],
      after: ["LEAF AND VOLT MOVES HIT MY|KIN HARD. NOW YOU KNOW."]},
    {n: "BRAND", t: "KEEPER BRAND", g: 600, tm: [[16, 19], [11, 20], [17, 22]],
      intro: ["HOT ENOUGH FOR YOU?", "MY KIN WERE BORN IN THE LAVA!"],
      win: ["BURNED OUT...|THE EMBER SIGIL IS YOURS."],
      after: ["THE ELDER WAITS ON STORMRIDGE,|PAST THE STONE WARDEN."]},
    {n: "ODA", t: "ELDER ODA", g: 1000, tm: [[7, 28], [13, 28], [11, 29], [17, 30], [20, 32]],
      intro: ["SO. YOU HOLD FOUR SIGILS.", "I AM ODA, THE ELDER. SHOW ME|ALL THAT YOU AND YOUR KIN|HAVE LEARNED!"],
      win: ["...MAGNIFICENT.", "YOU ARE A TRUE FRIEND OF KIN.|THE STORM SIGIL IS YOURS.", "THANKS FOR PLAYING WILDKIN!|CATCH ALL 21 KIN, OR CLIMB|BACK HERE FOR A REMATCH."],
      after: []}
  ]
  let SIGN = ["HOLLOW, HOME OF KIN TAMERS.", "NORTH: FERNWAY MEADOW.|WILD KIN HIDE IN TALL GRASS."]
  // the battle backdrop for each area: sky, far sky, ground, and the patches the kin stand on
  let BGS = [
    ["#8ad0f8", "#d8f0ff", "#7ac85a", "#5aa848"],
    ["#8ad0f8", "#d8f0ff", "#7ac85a", "#5aa848"],
    ["#4a7a6a", "#8ab8a0", "#3e7a40", "#2a5a30"],
    ["#7ac8f0", "#e0f4ff", "#e8d49a", "#d0b878"],
    ["#4a2a3a", "#a8504a", "#5a3a34", "#3e2a26"],
    ["#a8b8d8", "#e8eef8", "#e8eef8", "#c4d0e4"]
  ]
  let nsig = count(sig, s => s)

  // ---- the area ----------------------------------------------------------------------------------
  let TL = range(N).map(c => sub(MAPS[area], c, c + 1))
  let th = ATH[area]
  let PASS = TL.map(ch => ch == "." || ch == "," || ch == "=" || ch == "s" || ch == "f" || ch == "c" || (ch == "G" && nsig >= GN[area]))
  // steps from the hero to every cell, 99 past thirty-six
  let DH = reduce(range(36), (A, k) => A.map((d, c) => d < 99 ? d : PASS[c] && ((c % W > 0 && A[c - 1] == k) || (c % W < W - 1 && A[c + 1] == k) || (c >= W && A[c - W] == k) || (c < N - W && A[c + W] == k)) ? k + 1 : 99), range(N).map(c => c == hy * W + hx ? 0 : 99))
  let alive = any(party, m => m.hp > 0)

  // ---- macros: a new kin, the experience it needs, a level up ------------------------------------
  // the kin out on each side, and their names in the log


  // ---- a move: side S uses move MID on side O ----------------------------------------------------

  // ---- what the player does: a move, an item, a swap or a run -------------------------------------

  // ---- after both have acted: experience, the keeper's next kin, the end ---------------------------


  // ---- a turn --------------------------------------------------------------------------------------
  on bGo {
    if scene == "battle" && bt != null && (bphase == "menu" || bphase == "swap") && bAct != null {
      evs = []
      tq = 0.05
      bv = [party[bt.pi], bt.fo[bt.fi]]
      bdone = false
      bnext = "menu"
      sub = ""
      hint = ""
      if bAct.k == "fsw" {
        bt = merge(bt, {pi: bAct.to, st: set(bt.st, 0, [0, 0])})
        bv = [null, bt.fo[bt.fi]]
        evs = evs + [{k: "in", sd: 0, v: party[bt.pi], t: tq}]
        evs = evs + [{k: "msg", s: "GO, ${(SP[party[bt.pi].s].n)}!", t: tq}]
        tq = tq + 0.85
      } else {
        let fo = bt.fo[bt.fi]
        let me = party[bt.pi]
        let fm = bt.w ? fo.m[random(len(fo.m))] : fo.m.sortBy(x => -((MV[x].p == 0 ? 30 : MV[x].p * EF[MV[x].e][SP[me.s].e] * (SP[fo.s].e == MV[x].e ? 1.25 : 1)) + random(30)))[0]
        if bAct.k != "mv" || me.sp >= fo.sp {
          if bAct.k == "mv" {
            let mv3 = MV[party[bt.pi].m[bAct.i]]
            let am3 = (party[bt.pi])
            let dm3 = (bt.fo[bt.fi])
            let an3 = (SP[party[bt.pi].s].n)
            let dn3 = ((bt.w ? "WILD " : "FOE ") + SP[bt.fo[bt.fi].s].n)
            evs = evs + [{k: "msg", s: "${an3} USES ${mv3.n}!", t: tq}, {k: "atk", sd: 0, t: tq + 0.3, e: mv3.e}]
            tq = tq + 0.85
            if mv3.p > 0 {
              if random(100) >= mv3.a {
                evs = evs + [{k: "msg", s: "BUT IT MISSED!", t: tq}]
                tq = tq + 0.85
              } else {
                let ef3 = EF[mv3.e][SP[dm3.s].e]
                let cr3 = random(16) == 0
                let as3 = bt.st[0][0]
                let ds3 = bt.st[1][1]
                let dmg3 = max(1, floor((floor((floor(2 * am3.lv / 5) + 2) * mv3.p * (am3.at * (as3 >= 0 ? (2 + as3) / 2 : 2 / (2 - as3))) / (dm3.df * (ds3 >= 0 ? (2 + ds3) / 2 : 2 / (2 - ds3))) / 42) + 2) * (0 == 1 && bt.w ? 0.85 : 1) * (SP[am3.s].e == mv3.e ? 1.25 : 1) * ef3 * (cr3 ? 1.5 : 1) * random(85, 100) / 100))
                let nh3 = max(0, dm3.hp - dmg3)
                bt = merge(bt, {fo: set(bt.fo, bt.fi, merge(dm3, {hp: nh3}))})
                evs = evs + [{k: "hit", sd: 1, t: tq - 0.45, e: mv3.e}, {k: "hp", sd: 1, a: dm3.hp, b: nh3, t: tq - 0.4}]
                if cr3 {
                  evs = evs + [{k: "msg", s: "A CRITICAL HIT!", t: tq}]
                  tq = tq + 0.85
                }
                if ef3 > 1 {
                  evs = evs + [{k: "msg", s: "IT'S SUPER EFFECTIVE!", t: tq}]
                  tq = tq + 0.85
                }
                if ef3 < 1 {
                  evs = evs + [{k: "msg", s: "IT'S NOT VERY EFFECTIVE...", t: tq}]
                  tq = tq + 0.85
                }
                if mv3.x == 6 && am3.hp < am3.mh {
                  let gh3 = min(am3.mh - am3.hp, max(1, floor((dm3.hp - nh3) / 2)))
                  party = set(party, bt.pi, merge(am3, {hp: am3.hp + gh3}))
                  evs = evs + [{k: "hp", sd: 0, a: am3.hp, b: am3.hp + gh3, t: tq}]
                  evs = evs + [{k: "msg", s: "${an3} DRAINS ${gh3} HP!", t: tq}]
                  tq = tq + 0.85
                }
                if nh3 <= 0 {
                  evs = evs + [{k: "faint", sd: 1, t: tq}]
                  evs = evs + [{k: "msg", s: "${dn3} FAINTED!", t: tq}]
                  tq = tq + 0.85
                }
              }
            } else if mv3.x == 1 {
              bt = merge(bt, {st: set(bt.st, 1, set(bt.st[1], 0, clamp(bt.st[1][0] + -1, -3, 3)))})
              evs = evs + [{k: "msg", s: "${dn3}'S ATTACK FELL!", t: tq}]
              tq = tq + 0.85
            } else if mv3.x == 2 {
              bt = merge(bt, {st: set(bt.st, 0, set(bt.st[0], 1, clamp(bt.st[0][1] + 1, -3, 3)))})
              evs = evs + [{k: "msg", s: "${an3}'S DEFENCE ROSE!", t: tq}]
              tq = tq + 0.85
            } else if mv3.x == 3 {
              bt = merge(bt, {st: set(bt.st, 0, set(bt.st[0], 0, clamp(bt.st[0][0] + 1, -3, 3)))})
              evs = evs + [{k: "msg", s: "${an3}'S ATTACK ROSE!", t: tq}]
              tq = tq + 0.85
            } else if mv3.x == 4 {
              bt = merge(bt, {st: set(bt.st, 1, set(bt.st[1], 1, clamp(bt.st[1][1] + -1, -3, 3)))})
              evs = evs + [{k: "msg", s: "${dn3}'S DEFENCE FELL!", t: tq}]
              tq = tq + 0.85
            } else {
              let hl3 = min(am3.mh - am3.hp, ceil(am3.mh / 2))
              party = set(party, bt.pi, merge(am3, {hp: am3.hp + hl3}))
              evs = evs + [{k: "hp", sd: 0, a: am3.hp, b: am3.hp + hl3, t: tq}]
              evs = evs + [{k: "msg", s: hl3 > 0 ? "${an3} HEALS ${hl3} HP!" : "${an3} IS ALREADY HEALTHY!", t: tq}]
              tq = tq + 0.85
            }
          } else if bAct.k == "it" && bAct.it >= 3 {
            let it2 = bAct.it
            let f2 = bt.fo[bt.fi]
            let ch2 = clamp(SP[f2.s].cr * (1 - 0.7 * f2.hp / f2.mh) * (it2 == 4 ? 2 : 1) + 0.05, 0.03, 0.97)
            let ok2 = random(1000) < ch2 * 1000
            let wob2 = ok2 ? 3 : random(1000) < ch2 * 1800 ? 2 : random(2)
            inv = set(inv, it2, inv[it2] - 1)
