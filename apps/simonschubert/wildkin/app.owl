          tq = tq + 0.85
          let up96 = range(len(party)).filter(i => party[i].lv > old96[i].lv)
          let lm96 = flatten(up96.map(i => ["${SP[old96[i].s].n} GREW TO LV ${party[i].lv}!"] + (party[i].s != old96[i].s ? ["WHAT? ${SP[old96[i].s].n} EVOLVED|INTO ${SP[party[i].s].n}!"] : []) + party[i].m.filter(x => indexOf(old96[i].m, x) < 0).map(x => "${SP[party[i].s].n} LEARNED ${MV[x].n}!")))
          evs = evs + [{k: "set", sd: 0, v: party[bt.pi], t: tq}] + (party[bt.pi].s != old96[bt.pi].s ? [{k: "evo", sd: 0, t: tq}] : []) + lm96.map((s, j) => {k: "msg", s: s, t: tq + j * 0.85})
          tq = tq + len(lm96) * 0.85
          if bt.w {
            let gg96 = f96.lv * 3
            gold = gold + gg96
            evs = evs + [{k: "msg", s: "YOU FIND ${gg96} GOLD.", t: tq}]
            tq = tq + 0.85
            bnext = "won"
          } else if bt.fi + 1 < len(bt.fo) {
            bt = merge(bt, {fi: bt.fi + 1, st: set(bt.st, 1, [0, 0])})
            seen = set(seen, bt.fo[bt.fi].s, true)
            evs = evs + [{k: "in", sd: 1, v: bt.fo[bt.fi], t: tq + 0.1}]
            evs = evs + [{k: "msg", s: "${KP[bt.kp].n} SENDS OUT ${SP[bt.fo[bt.fi].s].n}!", t: tq}]
            tq = tq + 0.85
          } else {
            gold = gold + KP[bt.kp].g
            sig = set(sig, bt.kp, true)
            evs = evs + [{k: "msg", s: "YOU BEAT ${KP[bt.kp].t}!", t: tq}]
            tq = tq + 0.85
            evs = evs + [{k: "msg", s: "YOU EARN ${KP[bt.kp].g} GOLD.", t: tq}]
            tq = tq + 0.85
            bnext = "won"
          }
        } else if !bdone && party[bt.pi].hp <= 0 {
          if any(party, m => m.hp > 0) {
            bnext = "swap"
          } else {
            evs = evs + [{k: "msg", s: "ALL YOUR KIN ARE DOWN...", t: tq}]
            tq = tq + 0.85
            bnext = "lost"
          }
        }
      }
      fxLen = tq + 0.1
      fxTap = time
      fxAt = -1
      bphase = "anim"
    }
  }

  // ---- a turn's end: back to the menu, or out of the battle ------------------------------------------
  when bphase == "anim" && fxAt >= 0 && (time - fxAt > fxLen || time < fxAt - 1) {
    bphase = bnext
    if bnext == "won" || bnext == "caught" || bnext == "fled" {
      let k103 = bt.kp
      scene = "map"
      if bnext == "won" && k103 >= 0 {
        talk = {ls: KP[k103].win, i: 0, kp: -1}
        if k103 == 4 {
          wins = wins + 1
        }
      }
      bt = null
      bphase = "menu"
    } else if bnext == "lost" {
      scene = "map"
      bt = null
      bphase = "menu"
      area = 0
      hx = 3
      hy = 4
      hf = 1
      party = party.map(m => merge(m, {hp: m.mh}))
      gold = floor(gold / 2)
      talk = {ls: ["YOU HURRY BACK TO THE TENDER.", "YOUR KIN ARE HEALED... BUT YOU|DROPPED HALF YOUR GOLD."], i: 0, kp: -1}
    }
  }
  // after a restart the events are gone: finish the turn
  when bphase == "anim" && len(evs) == 0 {
    bphase = bnext
    if bnext == "won" || bnext == "caught" || bnext == "fled" {
      let k104 = bt.kp
      scene = "map"
      if bnext == "won" && k104 >= 0 {
        talk = {ls: KP[k104].win, i: 0, kp: -1}
        if k104 == 4 {
          wins = wins + 1
        }
      }
      bt = null
      bphase = "menu"
    } else if bnext == "lost" {
      scene = "map"
      bt = null
      bphase = "menu"
      area = 0
      hx = 3
      hy = 4
      hf = 1
      party = party.map(m => merge(m, {hp: m.mh}))
      gold = floor(gold / 2)
      talk = {ls: ["YOU HURRY BACK TO THE TENDER.", "YOUR KIN ARE HEALED... BUT YOU|DROPPED HALF YOUR GOLD."], i: 0, kp: -1}
    }
  }

  // ---- the map: battles, talks and the way out ----------------------------------------------------




  when walking && wAt >= 0 && (time - wAt > wLen || time < wAt - 1) {
    walking = false
    let wn105 = wNext
    wNext = null
    if wn105 != null {
      if wn105.k == "enc" {
        let tb106 = WL[area]
        let cum106 = range(len(tb106)).map(i => sum(tb106.take(i + 1).map(e => e[3])))
        let r106 = random(cum106[len(cum106) - 1])
        let e106 = tb106[range(len(tb106)).find(i => r106 < cum106[i])]
        let fo106 = ([SP[e106[0]]].map(P206 => [random(e106[1], e106[2])].map(L206 => {s: e106[0], lv: L206, xp: 0, mh: floor(P206.hp * L206 / 50) + L206 + 10, hp: floor(P206.hp * L206 / 50) + L206 + 10, at: floor(P206.at * L206 / 50) + 5, df: floor(P206.df * L206 / 50) + 5, sp: floor(P206.sp * L206 / 50) + 5, m: [P206.ls.filter(e206 => e206[0] <= L206).map(e206 => e206[1])].map(ms206 => ms206.drop(max(0, len(ms206) - 4)))[0]})[0])[0])
        let pi106 = range(len(party)).find(i => party[i].hp > 0)
        bt = {w: true, kp: -1, fo: [fo106], fi: 0, pi: pi106, st: [[0, 0], [0, 0]]}
        seen = set(seen, fo106.s, true)
        evs = [{k: "intro", t: 0}, {k: "in", sd: 1, v: fo106, t: 0.35}, {k: "msg", s: "A WILD ${SP[fo106.s].n} APPEARS!", t: 0.35}, {k: "in", sd: 0, v: party[pi106], t: 1.25}, {k: "msg", s: "GO, ${SP[party[pi106].s].n}!", t: 1.2}]
        bv = [null, null]
        bnext = "menu"
        sub = ""
        hint = ""
        fxLen = 2.0
        fxTap = time
        fxAt = -1
        bphase = "anim"
        scene = "battle"
      } else if wn105.k == "ia" {
        let z108 = IA.find(z => z.a == area && z.c == wn105.c)
        if z108.k == "heal" {
          party = party.map(m => merge(m, {hp: m.mh}))
          talk = {ls: [area == 0 ? "THE TENDER: REST A WHILE..." : "A TENDER KEEPS A CAMP HERE.", "YOUR KIN ARE FULLY HEALED!"], i: 0, kp: -1}
        } else if z108.k == "shop" {
          scene = "shop"
        } else if z108.k == "den" {
          scene = "den"
          denPg = 0
        } else if z108.k == "sign" {
          talk = {ls: SIGN, i: 0, kp: -1}
        } else if z108.k == "gate" {
          talk = {ls: ["A STONE WARDEN BARS THE WAY.", "ONLY ONE HOLDING ${z108.n} SIGILS|MAY PASS. YOU HAVE ${nsig}."], i: 0, kp: -1}
        } else if sig[z108.n] && z108.n < 4 {
          talk = {ls: KP[z108.n].after, i: 0, kp: -1}
        } else if !alive {
          talk = {ls: ["YOUR KIN ARE TOO TIRED TO FIGHT.|REST AT A TENDER FIRST."], i: 0, kp: -1}
        } else {
          talk = {ls: KP[z108.n].intro, i: 0, kp: z108.n}
        }
      } else {
        let d109 = hy == 0 ? 0 : hx == W - 1 ? 1 : hy == H - 1 ? 2 : 3
        let to109 = NB[area][d109]
        if to109 >= 0 {
          area = to109
          if d109 == 0 {
            hy = H - 1
          } else if d109 == 2 {
            hy = 0
          } else if d109 == 1 {
            hx = 0
          } else {
            hx = W - 1
          }
        }
      }
    }
  }

  // ---- a new game ----------------------------------------------------------------------------------

  back: scene != "title" && scene != "battle"
  onBack: {
    if scene == "map" || scene == "starter" {
      scene = "title"
      sure = false
    } else {
      scene = "map"
      pSel = -1
      selIt = -1
    }
  }

  // ---- drawing helpers -----------------------------------------------------------------------------
  // a pixel button: light band on top, the face, a dark lip under it; pressed while a finger is on it
  // a health bar
  // a panel card
  // a screen's header with a close button

  Box {
    fill: true
    background: background
    // ---- the map: drawn again only when it changes ---------------------------------------------
    Canvas {
      fill: true
      if scene == "map" {
        rect(BX - 3, BY - 3, W * T + 6, H * T + 6, radius: 3, fill: INK)
        for c in range(N) {
          let ch = TL[c]
          let x0 = BX + c % W * T
          let y0 = BY + floor(c / W) * T
          if ch == "." || ch == "N" || ch == "!" || ch == "R" || ch == "B" || ch == "V" || ch == "P" {
            image(hash(area, c) < 0.5 ? [GR0, GR1, GR2, GR3, GR4][th] : [GS0, GS1, GS2, GS3, GS4][th], x0, y0, T, T)
          }
          if ch == "," {
            image([TA0, TA1, TA2, TA3, TA4][th], x0, y0, T, T)
          } else if ch == "T" {
            image([TR0, TR1, TR2, TR3, TR4][th], x0, y0, T, T)
          } else if ch == "#" {
            image([RK0, RK1, RK2, RK3, RK4][th], x0, y0, T, T)
          } else if ch == "=" || ch == "c" || ch == "G" {
            image([PA0, PA1, PA2, PA3, PA4][th], x0, y0, T, T)
          } else if ch == "~" {
            image(WA, x0, y0, T, T)
          } else if ch == "s" {
            image(SA, x0, y0, T, T)
          } else if ch == "f" {
            image([FL0, FL1, FL2, FL3, FL4][th], x0, y0, T, T)
          } else if ch == "L" {
            image(LA, x0, y0, T, T)
          } else if ch == "!" {
            image([SG0, SG1, SG2, SG3, SG4][th], x0, y0, T, T)
          } else if ch == "R" || ch == "B" || ch == "V" || ch == "P" {
            let lf = c % W > 0 && TL[c - 1] == ch
            let rt = c % W < W - 1 && TL[c + 1] == ch
            image(get({R: lf ? (rt ? RMR : RRR) : RLR, B: lf ? (rt ? RMB : RRB) : RLB, V: lf ? (rt ? RMV : RRV) : RLV, P: lf ? (rt ? RMP : RRP) : RLP}, ch), x0, y0, T, T)
          } else if ch == "H" {
            image(get({R: WLR, B: WLB, V: WLV, P: WLP}, TL[c - W], WLR), x0, y0, T, T)
          } else if ch == "D" || ch == "d" {
            image(get({R: DRR, B: DRB, V: DRV, P: DRP}, TL[c - W], DRR), x0, y0, T, T)
          }
          if ch == "N" {
            image(TENDER, x0, y0, T, T)
          }
          if ch == "G" && nsig < GN[area] {
            image(GUARD, x0, y0, T, T)
          }
        }
      }
    }
    // ---- the hero: reads the clock only while walking --------------------------------------------
    Canvas {
      fill: true
      if scene == "map" {
        let tt = walking ? time : 0
        let e = walking && wAt >= 0 ? clamp((tt - wAt) / STEP, 0, len(wp) - 1) : len(wp) > 0 && walking ? 0 : 0
        let i = min(floor(e), max(0, len(wp) - 2))
        let fr = e - i
        let a = walking && len(wp) > 1 ? wp[i] : hy * W + hx
        let b = walking && len(wp) > 1 ? wp[i + 1] : a
        let px = lerp(a % W, b % W, walking ? fr : 0)
        let py = lerp(floor(a / W), floor(b / W), walking ? fr : 0)
        let dir = walking && b != a ? (b - a == W ? 0 : b - a == -W ? 1 : b - a == -1 ? 2 : 3) : hf
        let st = walking ? floor(e * 2) % 2 : 0
        let art = [[HD0, HD1], [HU0, HU1], [HL0, HL1], [HR0, HR1]][dir][st]
        rect(BX + px * T + 2 * q, BY + py * T + 10 * q, 8 * q, 2 * q, radius: q, fill: alpha("#000000", 0.3))
        image(art, BX + px * T, BY + py * T - (walking ? (st == 1 ? q : 0) : 0), T, T)
      }
    }
    // ---- the battle: the backdrop, then the kin and what the turn set going -------------------------
    Canvas {
      fill: true
      if scene == "battle" && bt != null {
        let bg = BGS[area]
        rect(0, 0, SCW, TOP + SCH, fill: linear(0, 0, 0, TOP + SCH * 0.55, [bg[0], bg[1]]))
        rect(0, TOP + SCH * 0.55, SCW, SCH * 0.45, fill: bg[2])
        rect(0, TOP + SCH * 0.55, SCW, 3, fill: alpha("#ffffff", 0.35))
        for k in range(14) {
          rect(hash(area, k) * SCW, TOP + SCH * (0.6 + hash(area, k, 2) * 0.38), 6 + hash(k) * 10, 3, fill: alpha(bg[3], 0.7))
        }
        scale(1, 0.28, SCW * 0.7, TOP + SCH * 0.42) { circle(SCW * 0.7, TOP + SCH * 0.42, SCW * 0.22, fill: bg[3]) }
        scale(1, 0.28, SCW * 0.28, TOP + SCH * 0.86) { circle(SCW * 0.28, TOP + SCH * 0.86, SCW * 0.25, fill: bg[3]) }
        rect(0, TOP + SCH, SCW, 3, fill: INK)
      }
    }
    Canvas {
      fill: true
      if scene == "battle" && bt != null {
        let an = bphase == "anim"
        let tt = time
        let now0 = !an ? 99 : fxAt < 0 ? 0 : tt - fxAt
        let now = now0 < 0 || now0 > 60 ? 99 : now0
        let FX = an ? evs.filter(z => z.t <= now) : []
        // ---- each side as it shows now ----
        let DS = [0, 1].map(sd => an ? reduce(FX.filter(z => z.sd == sd), (D, z) => z.k == "in" ? merge(z.v, {it: z.t}) : D == null ? null : z.k == "set" ? merge(z.v, {it: D.it ?? -9}) : z.k == "hp" ? merge(D, {hp: lerp(z.a, z.b, clamp((now - z.t) / 0.45, 0, 1))}) : z.k == "faint" ? merge(D, {ft: z.t}) : z.k == "out" ? merge(D, {ot: z.t}) : D, bv[sd]) : (sd == 0 ? (bt.pi == null ? null : party[bt.pi]) : bt.fo[bt.fi]))
        let thr = FX.filter(z => z.k == "throw").last()
        for sd in [1, 0] {
          let D = DS[sd]
          let qq = sd == 0 ? min(7, SCW / 58) : min(6, SCW / 68)
          let cx = sd == 0 ? SCW * 0.28 : SCW * 0.7
          let cy = sd == 0 ? TOP + SCH * 0.86 : TOP + SCH * 0.42
          let hidden = D == null || (!an && D.hp <= 0) || (D.ft != null && now > D.ft + 0.5) || (D.ot != null && now > D.ot + 0.3) || (sd == 1 && thr != null && now > thr.t + 0.5 && (thr.ok || now < thr.t + 0.6 + thr.n * 0.6))
          if !hidden {
            let atk = FX.filter(z => z.k == "atk" && z.sd == sd && now < z.t + 0.3).last()
            let hit = FX.filter(z => z.k == "hit" && z.sd == sd && now < z.t + 0.4).last()
            let evo = FX.filter(z => z.k == "evo" && z.sd == sd && now < z.t + 1.4).last()
            let ln = atk == null ? 0 : sin((now - atk.t) / 0.3 * 3.1416) * 22
            let sh = hit == null ? 0 : sin((now - hit.t) * 60) * 4
            let pop = D.it != null && now - D.it < 0.3 ? clamp((now - D.it) / 0.3, 0.05, 1) : 1
            let fe = D.ft != null ? clamp((now - D.ft) / 0.5, 0, 1) : 0
            let oe = D.ot != null ? clamp((now - D.ot) / 0.3, 0, 1) : 0
            let bob = floor(tt * 2 + sd) % 2 * qq * 0.6
            let dx = (sd == 0 ? ln : -ln) + sh
            let dy = (sd == 0 ? -ln * 0.5 : ln * 0.5) + fe * 30 - (fe > 0 ? 0 : bob)
            let fl = (hit != null && floor((now - hit.t) * 14) % 2 == 0) || (evo != null && floor((now - evo.t) * 10) % 2 == 0)
            rect(cx - 6 * qq, cy - qq, 12 * qq, 2 * qq, radius: qq, fill: alpha("#000000", 0.25 * (1 - fe)))
            layer(1 - fe) {
              scale(pop * (1 - oe) * (sd == 0 ? -1 : 1), pop * (1 - oe), cx, cy) {
                if fl {
                  image(KI[D.s], cx - 8 * qq + dx * (sd == 0 ? -1 : 1), cy - 16 * qq + dy, 16 * qq, 16 * qq, color: "#ffffff")
                } else {
                  image(KI[D.s], cx - 8 * qq + dx * (sd == 0 ? -1 : 1), cy - 16 * qq + dy, 16 * qq, 16 * qq)
                }
              }
            }
            if hit != null {
              let he = (now - hit.t) / 0.4
              for k in range(7) {
                rect(cx + cos(k * 0.9 + 0.3) * he * 14 * qq * 0.5 - 3, cy - 8 * qq + sin(k * 0.9 + 0.3) * he * 14 * qq * 0.5 - 3, 6, 6, fill: alpha(EC[hit.e], 1 - he))
              }
            }
          }
        }
        // ---- a keeper steps up ----
        let kpe = FX.filter(z => z.k == "kp" && now < z.t + 0.95).last()
        if kpe != null {
          let qk = min(6, SCW / 68)
          image([KP0, KP1, KP2, KP3, KP4][kpe.n], SCW * 0.7 - 6 * qk, TOP + SCH * 0.42 - 12 * qk, 12 * qk, 12 * qk)
        }
        // ---- a charm thrown ----
        if thr != null {
          let ci = ITI[thr.it]
          let fx0 = SCW * 0.7
          let fy0 = TOP + SCH * 0.42 - 12
          let e1 = (now - thr.t) / 0.5
          let endT = thr.t + 0.6 + thr.n * 0.6
          if e1 < 1 {
            let px = lerp(SCW * 0.3, fx0, e1)
            let py = lerp(TOP + SCH * 0.75, fy0, e1) - sin(e1 * 3.1416) * SCH * 0.25
            image(ci, px - 12, py - 12, 24, 24)
          } else if thr.ok || now < endT {
            let we = (now - thr.t - 0.6) / 0.6
            let wb = now < endT && we >= 0 && we < thr.n ? sin((we % 1) * 6.283) * 18 : 0
            rotate(wb, fx0, fy0 + 12) { image(ci, fx0 - 12, fy0 - 12, 24, 24) }
            if thr.ok && now > endT {
              for k in range(6) {
                let se = clamp((now - endT) / 0.5, 0, 1)
                rect(fx0 + cos(k * 1.05) * se * 40 - 3, fy0 + sin(k * 1.05) * se * 40 - 3, 6, 6, fill: alpha("#ffe14a", 1 - se))
              }
            }
          } else if now < endT + 0.3 {
            let be = (now - endT) / 0.3
            circle(fx0, fy0, 10 + be * 40, fill: alpha("#ffffff", 0.8 * (1 - be)))
          }
        }
        // ---- the boxes: the foe's name and health, and ours with numbers and experience ----
        let F = DS[1]
        let M = DS[0]
        let bw = min(210, SCW * 0.52)
        if F != null && !(F.ft != null && now > F.ft + 0.5) {
          rect(12, TOP + 16, bw, 52, radius: 6 * corners, fill: alpha(surface, 0.94), stroke: INK, width: 2)
          text(SP[F.s].n, 22, TOP + 32, size: 9, color: foreground, font: press)
          text("LV${F.lv}", 12 + bw - 10, TOP + 32, size: 8, color: muted, font: press, align: end)
          rect(22, TOP + 44, 20, 12, radius: 2, fill: EC[SP[F.s].e])
          text("HP", 32, TOP + 50, size: 6, color: INK, font: press, align: center)
          rect(46, TOP + 46, bw - 44, 8, radius: 2, fill: INK)
          rect(46 + 2, TOP + 46 + 2, (bw - 44 - 4) * clamp(F.hp / max(1, F.mh), 0, 1), 4, radius: 1, fill: F.hp <= F.mh / 5 ? "#ff5a4a" : F.hp <= F.mh / 2 ? "#ffd23a" : "#6fe05a")
          if caught[F.s] && bt.w && !an {
            image(IT3, 12 + bw - 22, TOP + 4, 14, 14)
          }
        }
        if M != null && !(M.ft != null && now > M.ft + 0.5) && !(!an && M.hp <= 0) {
          let mx = SCW - 12 - bw
          let my = TOP + SCH * 0.5
          rect(mx, my, bw, 64, radius: 6 * corners, fill: alpha(surface, 0.94), stroke: INK, width: 2)
          text(SP[M.s].n, mx + 10, my + 16, size: 9, color: foreground, font: press)
          text("LV${M.lv}", mx + bw - 10, my + 16, size: 8, color: muted, font: press, align: end)
          rect(mx + 10, my + 28, 20, 12, radius: 2, fill: EC[SP[M.s].e])
          text("HP", mx + 20, my + 34, size: 6, color: INK, font: press, align: center)
          rect(mx + 34, my + 30, bw - 44, 8, radius: 2, fill: INK)
          rect(mx + 34 + 2, my + 30 + 2, (bw - 44 - 4) * clamp(M.hp / max(1, M.mh), 0, 1), 4, radius: 1, fill: M.hp <= M.mh / 5 ? "#ff5a4a" : M.hp <= M.mh / 2 ? "#ffd23a" : "#6fe05a")
          text("${round(M.hp)}/${M.mh}", mx + bw - 10, my + 48, size: 7, color: foreground, font: press, align: end)
          rect(mx + 10, my + 56, bw - 20, 3, fill: alpha(foreground, 0.15))
          rect(mx + 10, my + 56, (bw - 20) * clamp(M.xp / (floor((M.lv) * (M.lv) * 0.8) + 10), 0, 1), 3, fill: "#4ab0ff")
        }
        // ---- the opening flash ----
        let ie = an ? now / 0.35 : 9
        if ie < 1 {
          for k in range(8) {
            rect(k % 2 == 0 ? -SCW * ie : SCW * ie, TOP + k * SCH / 8, SCW, SCH / 8 + 1, fill: INK)
          }
        }
        // ---- the message ----
        let msg = an ? (FX.filter(z => z.k == "msg").last().s ?? "") : bphase == "swap" ? "CHOOSE YOUR NEXT KIN." : hint != "" ? hint : sub == "bag" ? "USE WHICH ITEM?" : sub == "bagT" ? "USE THE ${ITN[selIt]} ON WHICH KIN?" : sub == "swap" ? "SEND OUT WHICH KIN?" : "WHAT WILL ${SP[party[bt.pi].s].n} DO?"
        rect(CX0, CY0, CW, MBH, radius: 6 * corners, fill: surface, stroke: INK, width: 2)
        rect(CX0 + 4, CY0 + 4, CW - 8, MBH - 8, radius: 4 * corners, fill: "none", stroke: alpha(accent, 0.5), width: 1)
        for s, j in split(msg, "|") {
          text(s, CX0 + 14, CY0 + 22 + j * 18, size: 8, color: foreground, font: press)
        }
        // ---- the buttons ----
        if !an && bphase == "menu" && sub == "" {
          let ms = party[bt.pi].m
          for i in range(4) {
            let bx = CX0 + (i % 2) * (BBW + 8)
            let by = BTY + floor(i / 2) * (BBH + 6)
            if i < len(ms) {
              let mv = MV[ms[i]]
              let pd = downAt[0] >= bx && downAt[0] < bx + BBW && downAt[1] >= by && downAt[1] < by + BBH ? 3 : 0
              rect(bx, by + 4, BBW, BBH - 4, radius: 4, fill: mix(EC[mv.e], "#000000", 0.6))
              rect(bx, by + pd, BBW, BBH - 4, radius: 4, fill: mix(EC[mv.e], "#000000", 0.25), stroke: INK, width: 2)
              rect(bx + 3, by + pd + 3, BBW - 6, 3, radius: 1.5, fill: mix(EC[mv.e], "#ffffff", 0.4))
              text(mv.n, bx + 11, by + pd + 19, size: 8, color: INK, font: press)
              text(mv.n, bx + 10, by + pd + 18, size: 8, color: "#ffffff", font: press)
              let ef = EF[mv.e][SP[bt.fo[bt.fi].s].e]
              text(mv.p > 0 ? "${EN[mv.e]} ${mv.p}" : "${EN[mv.e]} ·", bx + 10, by + pd + BBH - 18, size: 6, color: alpha("#ffffff", 0.8), font: press)
              if mv.p > 0 && ef != 1 && caught[bt.fo[bt.fi].s] {
                text(ef > 1 ? "▲" : "▼", bx + BBW - 12, by + pd + BBH - 18, size: 8, color: ef > 1 ? "#b4ff9a" : "#ffb0a8", align: center)
              }
            } else {
              rect(bx, by, BBW, BBH - 4, radius: 4, fill: alpha(foreground, 0.06), stroke: alpha(foreground, 0.15), width: 1)
              text("—", bx + BBW / 2, by + (BBH - 4) / 2, size: 8, color: muted, font: press, align: center)
            }
          }
          let pd112 = downAt[0] >= CX0 && downAt[0] < CX0 + B3W && downAt[1] >= B3Y && downAt[1] < B3Y + 54 ? 3 : 0
          let pl112 = true ? BTN.wood : BTN.off
          rect(CX0, B3Y + 4, B3W, 54 - 4, radius: 4, fill: pl112[3])
          rect(CX0, B3Y + pd112, B3W, 54 - 4, radius: 4, fill: pl112[1], stroke: INK, width: 2)
          rect(CX0 + 3, B3Y + pd112 + 3, B3W - 6, 3, radius: 1.5, fill: pl112[0])
          text("BAG", CX0 + B3W / 2 + 1, B3Y + pd112 + (54 - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
          text("BAG", CX0 + B3W / 2, B3Y + pd112 + (54 - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
          let pd113 = downAt[0] >= CX0 + B3W + 8 && downAt[0] < CX0 + B3W + 8 + B3W && downAt[1] >= B3Y && downAt[1] < B3Y + 54 ? 3 : 0
          let pl113 = len(party) > 1 ? BTN.blue : BTN.off
          rect(CX0 + B3W + 8, B3Y + 4, B3W, 54 - 4, radius: 4, fill: pl113[3])
          rect(CX0 + B3W + 8, B3Y + pd113, B3W, 54 - 4, radius: 4, fill: pl113[1], stroke: INK, width: 2)
          rect(CX0 + B3W + 8 + 3, B3Y + pd113 + 3, B3W - 6, 3, radius: 1.5, fill: pl113[0])
          text("KIN", CX0 + B3W + 8 + B3W / 2 + 1, B3Y + pd113 + (54 - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
          text("KIN", CX0 + B3W + 8 + B3W / 2, B3Y + pd113 + (54 - 4) / 2, size: 9, color: len(party) > 1 ? "#ffffff" : "#a8a2c0", font: press, align: center)
          let pd114 = downAt[0] >= CX0 + 2 * (B3W + 8) && downAt[0] < CX0 + 2 * (B3W + 8) + B3W && downAt[1] >= B3Y && downAt[1] < B3Y + 54 ? 3 : 0
          let pl114 = bt.w ? BTN.red : BTN.off
          rect(CX0 + 2 * (B3W + 8), B3Y + 4, B3W, 54 - 4, radius: 4, fill: pl114[3])
          rect(CX0 + 2 * (B3W + 8), B3Y + pd114, B3W, 54 - 4, radius: 4, fill: pl114[1], stroke: INK, width: 2)
          rect(CX0 + 2 * (B3W + 8) + 3, B3Y + pd114 + 3, B3W - 6, 3, radius: 1.5, fill: pl114[0])
          text("RUN", CX0 + 2 * (B3W + 8) + B3W / 2 + 1, B3Y + pd114 + (54 - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
          text("RUN", CX0 + 2 * (B3W + 8) + B3W / 2, B3Y + pd114 + (54 - 4) / 2, size: 9, color: bt.w ? "#ffffff" : "#a8a2c0", font: press, align: center)
        }
        // ---- the bag ----
        if !an && bphase == "menu" && sub == "bag" {
          for it in range(5) {
            let ry = LRY + it * (LRH + 4)
            let ok = inv[it] > 0 && (it < 3 || bt.w)
            rect(CX0, ry + 3, CW, LRH, radius: 6 * corners, fill: alpha("#000000", 0.3))
            rect(CX0, ry, CW, LRH, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
            layer(ok ? 1 : 0.4) {
              image(ITI[it], CX0 + 10, ry + LRH / 2 - 12, 24, 24)
              text(ITN[it], CX0 + 44, ry + LRH / 2 - 6, size: 8, color: foreground, font: press)
              text(it >= 3 && !bt.w ? "NOT ON A KEEPER'S KIN" : ITD[it], CX0 + 44, ry + LRH / 2 + 9, size: 6, color: muted, font: press)
              text("×${inv[it]}", CX0 + CW - 12, ry + LRH / 2, size: 9, color: accent, font: press, align: end)
            }
          }
          let pd116 = downAt[0] >= CX0 && downAt[0] < CX0 + CW && downAt[1] >= LRY + 5 * (LRH + 4) + 4 && downAt[1] < LRY + 5 * (LRH + 4) + 4 + 44 ? 3 : 0
          let pl116 = true ? BTN.off : BTN.off
          rect(CX0, LRY + 5 * (LRH + 4) + 4 + 4, CW, 44 - 4, radius: 4, fill: pl116[3])
          rect(CX0, LRY + 5 * (LRH + 4) + 4 + pd116, CW, 44 - 4, radius: 4, fill: pl116[1], stroke: INK, width: 2)
          rect(CX0 + 3, LRY + 5 * (LRH + 4) + 4 + pd116 + 3, CW - 6, 3, radius: 1.5, fill: pl116[0])
          text("BACK", CX0 + CW / 2 + 1, LRY + 5 * (LRH + 4) + 4 + pd116 + (44 - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
          text("BACK", CX0 + CW / 2, LRY + 5 * (LRH + 4) + 4 + pd116 + (44 - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        }
        // ---- the kin, to swap or to use an item on ----
        if !an && (bphase == "swap" || (bphase == "menu" && (sub == "swap" || sub == "bagT"))) {
          for m, i in party {
            let ry = LRY + i * (LRH + 4)
            let ok = sub == "bagT" ? (selIt == 2 ? m.hp <= 0 : m.hp > 0 && m.hp < m.mh) : m.hp > 0 && (i != bt.pi || bphase == "swap")
            rect(CX0, ry + 3, CW, LRH, radius: 6 * corners, fill: alpha("#000000", 0.3))
            rect(CX0, ry, CW, LRH, radius: 6 * corners, fill: i == bt.pi && bphase != "swap" ? mix(surface, accent, 0.25) : surface, stroke: i == bt.pi && bphase != "swap" ? accent : INK, width: 2)
            layer(ok ? 1 : 0.45) {
              image(KI[m.s], CX0 + 8, ry + LRH / 2 - 18, 36, 36)
              text(SP[m.s].n, CX0 + 52, ry + LRH / 2 - 8, size: 8, color: foreground, font: press)
              text("LV${m.lv}", CX0 + 52, ry + LRH / 2 + 8, size: 7, color: muted, font: press)
              rect(CX0 + CW * 0.52, ry + LRH / 2 - 10, CW * 0.44, 8, radius: 2, fill: INK)
              rect(CX0 + CW * 0.52 + 2, ry + LRH / 2 - 10 + 2, (CW * 0.44 - 4) * clamp(m.hp / max(1, m.mh), 0, 1), 4, radius: 1, fill: m.hp <= m.mh / 5 ? "#ff5a4a" : m.hp <= m.mh / 2 ? "#ffd23a" : "#6fe05a")
              text(m.hp <= 0 ? "FAINTED" : "${m.hp}/${m.mh}", CX0 + CW - 12, ry + LRH / 2 + 10, size: 7, color: m.hp <= 0 ? "#ff5a4a" : foreground, font: press, align: end)
            }
          }
          if bphase != "swap" {
            let pd119 = downAt[0] >= CX0 && downAt[0] < CX0 + CW && downAt[1] >= LRY + 6 * (LRH + 4) + 4 && downAt[1] < LRY + 6 * (LRH + 4) + 4 + 44 ? 3 : 0
            let pl119 = true ? BTN.off : BTN.off
            rect(CX0, LRY + 6 * (LRH + 4) + 4 + 4, CW, 44 - 4, radius: 4, fill: pl119[3])
            rect(CX0, LRY + 6 * (LRH + 4) + 4 + pd119, CW, 44 - 4, radius: 4, fill: pl119[1], stroke: INK, width: 2)
            rect(CX0 + 3, LRY + 6 * (LRH + 4) + 4 + pd119 + 3, CW - 6, 3, radius: 1.5, fill: pl119[0])
            text("BACK", CX0 + CW / 2 + 1, LRY + 6 * (LRH + 4) + 4 + pd119 + (44 - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
            text("BACK", CX0 + CW / 2, LRY + 6 * (LRH + 4) + 4 + pd119 + (44 - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
          }
        }
      }
    }
    // ---- the panel under the map, the screens over it, the title; touches land here -------------
    Canvas {
      fill: true
      onPress: { downAt = [x, y] }
      onRelease: { downAt = [-1, -1] }
      ripple: false
      onTap: {
        if scene == "title" {
          let going = started && len(party) > 0
          let by = SH * 0.68
          if y >= by && y < by + 54 && abs(x - SW / 2) < 120 {
            haptic()
            if going {
              scene = bt != null ? "battle" : "map"
            } else {
              started = true
              area = 0
              hx = 5
              hy = 9
              hf = 0
              party = []
              den = []
              gold = 100
              inv = [3, 0, 1, 5, 0]
              sig = [false, false, false, false, false]
              seen = range(NK).map(i => false)
              caught = range(NK).map(i => false)
              wins = 0
              bt = null
              talk = null
              bphase = "menu"
              scene = "starter"
            }
          } else if going && y >= by + 70 && y < by + 110 && abs(x - SW / 2) < 110 {
            if sure {
              sure = false
              started = true
              area = 0
              hx = 5
              hy = 9
              hf = 0
              party = []
              den = []
              gold = 100
              inv = [3, 0, 1, 5, 0]
              sig = [false, false, false, false, false]
              seen = range(NK).map(i => false)
              caught = range(NK).map(i => false)
              wins = 0
              bt = null
              talk = null
              bphase = "menu"
              scene = "starter"
            } else {
              sure = true
            }
          }
        } else if scene == "starter" {
          let rh = floor(min(190, (SH - TOP - INS - 140) / 3))
          let j = floor((y - TOP - 100) / (rh + 10))
          if y >= TOP + 100 && j >= 0 && j < 3 {
            let s = [0, 2, 4][j]
            party = [([SP[s]].map(P208 => [6].map(L208 => {s: s, lv: L208, xp: 0, mh: floor(P208.hp * L208 / 50) + L208 + 10, hp: floor(P208.hp * L208 / 50) + L208 + 10, at: floor(P208.at * L208 / 50) + 5, df: floor(P208.df * L208 / 50) + 5, sp: floor(P208.sp * L208 / 50) + 5, m: [P208.ls.filter(e208 => e208[0] <= L208).map(e208 => e208[1])].map(ms208 => ms208.drop(max(0, len(ms208) - 4)))[0]})[0])[0])]
            seen = set(seen, s, true)
            caught = set(caught, s, true)
            scene = "map"
            talk = {ls: ["WELCOME TO HOLLOW! ${SP[s].n}|WILL BE GLAD OF A FRIEND LIKE YOU.", "TAP THE MAP TO WALK. WILD KIN|HIDE IN THE TALL GRASS NORTH.", "WEAR ONE DOWN, THEN THROW A|CHARM TO MAKE IT YOURS.", "BEAT THE FOUR KEEPERS FOR THEIR|SIGILS, THEN FACE THE ELDER|ON STORMRIDGE. GOOD LUCK!"], i: 0, kp: -1}
            haptic()
          }
        } else if scene == "map" {
          if talk != null {
            if talk.i < len(talk.ls) - 1 {
              talk = merge(talk, {i: talk.i + 1})
            } else {
              let k = talk.kp
              talk = null
              if k >= 0 {
                let fo125 = KP[k].tm.map(e => ([SP[e[0]]].map(P209 => [e[1]].map(L209 => {s: e[0], lv: L209, xp: 0, mh: floor(P209.hp * L209 / 50) + L209 + 10, hp: floor(P209.hp * L209 / 50) + L209 + 10, at: floor(P209.at * L209 / 50) + 5, df: floor(P209.df * L209 / 50) + 5, sp: floor(P209.sp * L209 / 50) + 5, m: [P209.ls.filter(e209 => e209[0] <= L209).map(e209 => e209[1])].map(ms209 => ms209.drop(max(0, len(ms209) - 4)))[0]})[0])[0]))
                let pi125 = range(len(party)).find(i => party[i].hp > 0)
                bt = {w: false, kp: k, fo: fo125, fi: 0, pi: pi125, st: [[0, 0], [0, 0]]}
                seen = set(seen, fo125[0].s, true)
                evs = [{k: "intro", t: 0}, {k: "kp", n: k, t: 0.35}, {k: "msg", s: "${KP[k].t} WANTS TO BATTLE!", t: 0.35}, {k: "in", sd: 1, v: fo125[0], t: 1.3}, {k: "msg", s: "${KP[k].n} SENDS OUT ${SP[fo125[0].s].n}!", t: 1.25}, {k: "in", sd: 0, v: party[pi125], t: 2.2}, {k: "msg", s: "GO, ${SP[party[pi125].s].n}!", t: 2.15}]
                bv = [null, null]
                bnext = "menu"
                sub = ""
                hint = ""
                fxLen = 3.0
                fxTap = time
                fxAt = -1
                bphase = "anim"
                scene = "battle"
              }
            }
          } else if y >= PBY && y < PBY + PBH && x >= PX && x < PX + PW {
            let b = min(3, floor((x - PX) / (PBW + 6)))
            if b == 0 {
              scene = "party"
              pSel = -1
            } else if b == 1 {
              scene = "bag"
              selIt = -1
            } else if b == 2 {
              scene = "log"
            } else {
              scene = "title"
              sure = false
            }
          } else if !walking && y >= BY && y < BY + H * T && x >= BX && x < BX + W * T {
            let tc = floor((y - BY) / T) * W + floor((x - BX) / T)
            let hc = hy * W + hx
            let ia = IA.find(z => z.a == area && z.c == tc && !(z.k == "gate" && nsig >= z.n))
            let dest = ia != null ? [tc + W, tc - 1, tc + 1, tc - W].filter(n => n >= 0 && n < N && abs(n % W - tc % W) <= 1 && PASS[n] && DH[n] < 99).sortBy(n => DH[n])[0] : PASS[tc] && DH[tc] < 99 ? tc : null
            if dest != null {
              let P0 = reduce(range(DH[dest]), (P, k) => [[P[0] - W, P[0] + W, P[0] - 1, P[0] + 1].filter(n => n >= 0 && n < N && abs(n % W - P[0] % W) <= 1 && DH[n] == DH[P[0]] - 1)[0]] + P, [dest])
              let ei = len(P0) > 1 && alive && len(WL[area]) > 0 ? range(1, len(P0)).find(i => TL[P0[i]] == "," && random(100) < 11) : null
              let PP = ei == null ? P0 : P0.take(ei + 1)
              let last = PP[len(PP) - 1]
              let edge = last % W == 0 || last % W == W - 1 || last < W || last >= N - W
              wp = PP
              hx = last % W
              hy = floor(last / W)
              if len(PP) > 1 {
                let dd = last - PP[len(PP) - 2]
                hf = dd == W ? 0 : dd == -W ? 1 : dd == -1 ? 2 : 3
              }
              if ia != null && ei == null {
                let df = tc - last
                hf = df == W ? 0 : df == -W ? 1 : df == -1 ? 2 : 3
              }
              wNext = ei != null ? {k: "enc"} : ia != null ? {k: "ia", c: tc} : edge ? {k: "exit"} : null
              if len(PP) > 1 {
                wLen = (len(PP) - 1) * STEP
                wTap = time
                wAt = -1
                walking = true
              } else {
                walking = false
                let wn127 = wNext
                wNext = null
                if wn127 != null {
                  if wn127.k == "enc" {
                    let tb128 = WL[area]
                    let cum128 = range(len(tb128)).map(i => sum(tb128.take(i + 1).map(e => e[3])))
                    let r128 = random(cum128[len(cum128) - 1])
                    let e128 = tb128[range(len(tb128)).find(i => r128 < cum128[i])]
                    let fo128 = ([SP[e128[0]]].map(P210 => [random(e128[1], e128[2])].map(L210 => {s: e128[0], lv: L210, xp: 0, mh: floor(P210.hp * L210 / 50) + L210 + 10, hp: floor(P210.hp * L210 / 50) + L210 + 10, at: floor(P210.at * L210 / 50) + 5, df: floor(P210.df * L210 / 50) + 5, sp: floor(P210.sp * L210 / 50) + 5, m: [P210.ls.filter(e210 => e210[0] <= L210).map(e210 => e210[1])].map(ms210 => ms210.drop(max(0, len(ms210) - 4)))[0]})[0])[0])
                    let pi128 = range(len(party)).find(i => party[i].hp > 0)
                    bt = {w: true, kp: -1, fo: [fo128], fi: 0, pi: pi128, st: [[0, 0], [0, 0]]}
                    seen = set(seen, fo128.s, true)
                    evs = [{k: "intro", t: 0}, {k: "in", sd: 1, v: fo128, t: 0.35}, {k: "msg", s: "A WILD ${SP[fo128.s].n} APPEARS!", t: 0.35}, {k: "in", sd: 0, v: party[pi128], t: 1.25}, {k: "msg", s: "GO, ${SP[party[pi128].s].n}!", t: 1.2}]
                    bv = [null, null]
                    bnext = "menu"
                    sub = ""
                    hint = ""
                    fxLen = 2.0
                    fxTap = time
                    fxAt = -1
                    bphase = "anim"
                    scene = "battle"
                  } else if wn127.k == "ia" {
                    let z130 = IA.find(z => z.a == area && z.c == wn127.c)
                    if z130.k == "heal" {
                      party = party.map(m => merge(m, {hp: m.mh}))
                      talk = {ls: [area == 0 ? "THE TENDER: REST A WHILE..." : "A TENDER KEEPS A CAMP HERE.", "YOUR KIN ARE FULLY HEALED!"], i: 0, kp: -1}
                    } else if z130.k == "shop" {
                      scene = "shop"
                    } else if z130.k == "den" {
                      scene = "den"
                      denPg = 0
                    } else if z130.k == "sign" {
                      talk = {ls: SIGN, i: 0, kp: -1}
                    } else if z130.k == "gate" {
                      talk = {ls: ["A STONE WARDEN BARS THE WAY.", "ONLY ONE HOLDING ${z130.n} SIGILS|MAY PASS. YOU HAVE ${nsig}."], i: 0, kp: -1}
                    } else if sig[z130.n] && z130.n < 4 {
                      talk = {ls: KP[z130.n].after, i: 0, kp: -1}
                    } else if !alive {
                      talk = {ls: ["YOUR KIN ARE TOO TIRED TO FIGHT.|REST AT A TENDER FIRST."], i: 0, kp: -1}
                    } else {
                      talk = {ls: KP[z130.n].intro, i: 0, kp: z130.n}
                    }
                  } else {
                    let d131 = hy == 0 ? 0 : hx == W - 1 ? 1 : hy == H - 1 ? 2 : 3
                    let to131 = NB[area][d131]
                    if to131 >= 0 {
                      area = to131
                      if d131 == 0 {
                        hy = H - 1
                      } else if d131 == 2 {
                        hy = 0
                      } else if d131 == 1 {
                        hx = 0
                      } else {
                        hx = W - 1
                      }
                    }
                  }
                }
              }
            }
          }
        } else if scene == "battle" {
          if bphase == "menu" && sub == "" && y >= BTY && y < BTY + 2 * (BBH + 6) && x >= CX0 && x < CX0 + CW {
            let i = floor((y - BTY) / (BBH + 6)) * 2 + min(1, floor((x - CX0) / (BBW + 8)))
            if i < len(party[bt.pi].m) {
              bAct = {k: "mv", i: i}
              bGo = bGo + 1
            }
          } else if bphase == "menu" && sub == "" && y >= B3Y && y < B3Y + 54 && x >= CX0 {
            let b = min(2, floor((x - CX0) / (B3W + 8)))
            if b == 0 {
              sub = "bag"
              hint = ""
            } else if b == 1 {
              if len(party) > 1 {
                sub = "swap"
                hint = ""
              }
            } else if bt.w {
              bAct = {k: "run"}
              bGo = bGo + 1
            } else {
              hint = "THERE'S NO RUNNING FROM|A KEEPER!"
            }
          } else if bphase == "menu" && sub == "bag" && y >= LRY {
            let it = floor((y - LRY) / (LRH + 4))
            if it == 5 || it > 5 {
              sub = ""
            } else if inv[it] > 0 {
              if it >= 3 {
                if bt.w {
                  bAct = {k: "it", it: it, tg: -1}
                  bGo = bGo + 1
                } else {
                  hint = "THE KEEPER BLOCKS THE CHARM!"
                }
              } else {
                selIt = it
                sub = "bagT"
              }
            }
          } else if (bphase == "swap" || (bphase == "menu" && (sub == "swap" || sub == "bagT"))) && y >= LRY {
            let i = floor((y - LRY) / (LRH + 4))
            if i >= 6 && bphase != "swap" {
              sub = ""
            } else if i < len(party) {
              let m = party[i]
              if bphase == "swap" {
                if m.hp > 0 {
                  bAct = {k: "fsw", to: i}
                  bGo = bGo + 1
                }
              } else if sub == "swap" {
                if m.hp > 0 && i != bt.pi {
                  bAct = {k: "sw", to: i}
                  bGo = bGo + 1
                }
              } else if selIt == 2 ? m.hp <= 0 : m.hp > 0 && m.hp < m.mh {
                bAct = {k: "it", it: selIt, tg: i}
                bGo = bGo + 1
              }
            }
          }
        } else if y < TOP + 44 && x > SW - 70 {
          scene = "map"
          pSel = -1
          selIt = -1
        } else if scene == "party" {
          let rh = floor(min(80, (SH - TOP - INS - 60 - (pSel >= 0 ? 190 : 0)) / 6))
          let dy = SH - INS - 190
          if pSel >= 0 && y >= dy + 124 && y < dy + 170 {
            if x < SW / 2 {
              if pSel > 0 {
                party = [party[pSel]] + party.filter((m, i) => i != pSel)
                pSel = 0
                haptic()
              }
            } else {
              pSel = -1
            }
          } else if y >= TOP + 52 && (pSel < 0 || y < dy) {
            let i = floor((y - TOP - 52) / (rh + 4))
            if i < len(party) {
              pSel = i == pSel ? -1 : i
            }
          }
        } else if scene == "bag" {
          let ly = TOP + 52 + 5 * 62 + 10
          if y >= TOP + 52 && y < TOP + 52 + 5 * 62 {
            let it = floor((y - TOP - 52) / 62)
            selIt = it < 3 && inv[it] > 0 && selIt != it ? it : -1
          } else if selIt >= 0 && y >= ly + 18 {
            let rh = floor(min(52, (SH - INS - ly - 24) / 6))
            let i = floor((y - ly - 18) / (rh + 4))
            if i < len(party) {
              let m = party[i]
              let ok = selIt == 2 ? m.hp <= 0 : m.hp > 0 && m.hp < m.mh
              if ok {
                party = set(party, i, merge(m, {hp: selIt == 0 ? min(m.mh, m.hp + 30) : selIt == 1 ? m.mh : max(1, floor(m.mh / 2))}))
                inv = set(inv, selIt, inv[selIt] - 1)
                haptic()
                if inv[selIt] <= 0 {
                  selIt = -1
                }
              }
            }
          }
        } else if scene == "shop" {
          if x >= SW - 110 && y >= TOP + 80 && y < TOP + 80 + 5 * 70 {
            let it = floor((y - TOP - 80) / 70)
            if gold >= ITP[it] {
              gold = gold - ITP[it]
              inv = set(inv, it, min(99, inv[it] + 1))
              haptic()
            }
          }
        } else if scene == "den" {
          let cw = (SW - 30) / 2
          let rh = floor(min(70, (SH - TOP - INS - 140) / 6))
          let ny = TOP + 94 + 6 * (rh + 4) + 6
          let i = floor((y - TOP - 94) / (rh + 4))
          if y >= ny && y < ny + 40 && x > 20 + cw {
            if x < 20 + cw * 1.5 {
              denPg = max(0, denPg - 1)
            } else if (denPg + 1) * 6 < len(den) {
              denPg = denPg + 1
            }
          } else if y >= TOP + 94 && i < 6 {
            if x < 10 + cw && i < len(party) && len(party) > 1 && any(party.filter((m, j) => j != i), m => m.hp > 0) {
              den = den + [merge(party[i], {hp: party[i].mh})]
              party = party.filter((m, j) => j != i)
              haptic()
            } else if x > 20 + cw && denPg * 6 + i < len(den) && len(party) < 6 {
              party = party + [den[denPg * 6 + i]]
              den = den.filter((m, j) => j != denPg * 6 + i)
              denPg = min(denPg, max(0, floor((len(den) - 1) / 6)))
              haptic()
            }
          }
        }
      }
      if scene == "map" {
        // ---- the top bar: where, gold and sigils ----
        text(AN[area], BX, TOP + 16, size: 10, color: accent, font: press)
        image(COIN, SW - BX - 18, TOP + 7, 16, 16)
        text("${gold}", SW - BX - 24, TOP + 16, size: 9, color: foreground, font: press, align: end)
        // ---- the kin, the sigils and the buttons ----
        let sw = (PW - 25) / 6
        let sh = min(112, PBY - PY - 50)
        for i in range(6) {
          let x0 = PX + i * (sw + 5)
          if i < len(party) {
            let m = party[i]
            rect(x0, PY + 3, sw, sh, radius: 6 * corners, fill: alpha("#000000", 0.3))
            rect(x0, PY, sw, sh, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
            layer(m.hp > 0 ? 1 : 0.4) { image(KI[m.s], x0 + sw / 2 - min(24, sw / 2 - 4), PY + 6, min(48, sw - 8), min(48, sw - 8)) }
            text("L${m.lv}", x0 + sw / 2, PY + sh - 26, size: 7, color: foreground, font: press, align: center)
            rect(x0 + 5, PY + sh - 15, sw - 10, 8, radius: 2, fill: INK)
            rect(x0 + 5 + 2, PY + sh - 15 + 2, (sw - 10 - 4) * clamp(m.hp / max(1, m.mh), 0, 1), 4, radius: 1, fill: m.hp <= m.mh / 5 ? "#ff5a4a" : m.hp <= m.mh / 2 ? "#ffd23a" : "#6fe05a")
          } else {
            rect(x0, PY, sw, sh, radius: 6 * corners, fill: alpha(foreground, 0.04), stroke: alpha(foreground, 0.12), width: 1)
          }
        }
        let sy = PY + sh + 14
        text("SIGILS", PX, sy + 8, size: 7, color: muted, font: press)
        for k in range(5) {
          image(sig[k] ? SIGIL : SIGOFF, PX + 58 + k * 26, sy, 18, 18)
        }
        text(WL[area] == [] || len(WL[area]) == 0 ? "A SAFE PLACE" : "WILD KIN LV ${WL[area][0][1]}+", PX + PW, sy + 8, size: 7, color: muted, font: press, align: end)
        let nk = range(4).find(k => !sig[k])
        let goal = nk != null ? "NEXT: ${KP[nk].t}, ${AN[[1, 2, 3, 4][nk]]}" : !sig[4] ? "NEXT: ELDER ODA ON STORMRIDGE" : "CATCH THEM ALL: ${count(caught, s => s)} OF ${NK}"
        text(goal, PX + PW / 2, (sy + 18 + PBY) / 2, size: 7, color: foreground, font: press, align: center)
        let pd139 = downAt[0] >= PX && downAt[0] < PX + PBW && downAt[1] >= PBY && downAt[1] < PBY + PBH ? 3 : 0
        let pl139 = true ? BTN.blue : BTN.off
        rect(PX, PBY + 4, PBW, PBH - 4, radius: 4, fill: pl139[3])
        rect(PX, PBY + pd139, PBW, PBH - 4, radius: 4, fill: pl139[1], stroke: INK, width: 2)
        rect(PX + 3, PBY + pd139 + 3, PBW - 6, 3, radius: 1.5, fill: pl139[0])
        text("KIN", PX + PBW / 2 + 1, PBY + pd139 + (PBH - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
        text("KIN", PX + PBW / 2, PBY + pd139 + (PBH - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        let pd140 = downAt[0] >= PX + PBW + 6 && downAt[0] < PX + PBW + 6 + PBW && downAt[1] >= PBY && downAt[1] < PBY + PBH ? 3 : 0
        let pl140 = true ? BTN.wood : BTN.off
        rect(PX + PBW + 6, PBY + 4, PBW, PBH - 4, radius: 4, fill: pl140[3])
        rect(PX + PBW + 6, PBY + pd140, PBW, PBH - 4, radius: 4, fill: pl140[1], stroke: INK, width: 2)
        rect(PX + PBW + 6 + 3, PBY + pd140 + 3, PBW - 6, 3, radius: 1.5, fill: pl140[0])
        text("BAG", PX + PBW + 6 + PBW / 2 + 1, PBY + pd140 + (PBH - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
        text("BAG", PX + PBW + 6 + PBW / 2, PBY + pd140 + (PBH - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        let pd141 = downAt[0] >= PX + 2 * (PBW + 6) && downAt[0] < PX + 2 * (PBW + 6) + PBW && downAt[1] >= PBY && downAt[1] < PBY + PBH ? 3 : 0
        let pl141 = true ? BTN.go : BTN.off
        rect(PX + 2 * (PBW + 6), PBY + 4, PBW, PBH - 4, radius: 4, fill: pl141[3])
        rect(PX + 2 * (PBW + 6), PBY + pd141, PBW, PBH - 4, radius: 4, fill: pl141[1], stroke: INK, width: 2)
        rect(PX + 2 * (PBW + 6) + 3, PBY + pd141 + 3, PBW - 6, 3, radius: 1.5, fill: pl141[0])
        text("LOG", PX + 2 * (PBW + 6) + PBW / 2 + 1, PBY + pd141 + (PBH - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
        text("LOG", PX + 2 * (PBW + 6) + PBW / 2, PBY + pd141 + (PBH - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        let pd142 = downAt[0] >= PX + 3 * (PBW + 6) && downAt[0] < PX + 3 * (PBW + 6) + PBW && downAt[1] >= PBY && downAt[1] < PBY + PBH ? 3 : 0
        let pl142 = true ? BTN.off : BTN.off
        rect(PX + 3 * (PBW + 6), PBY + 4, PBW, PBH - 4, radius: 4, fill: pl142[3])
        rect(PX + 3 * (PBW + 6), PBY + pd142, PBW, PBH - 4, radius: 4, fill: pl142[1], stroke: INK, width: 2)
        rect(PX + 3 * (PBW + 6) + 3, PBY + pd142 + 3, PBW - 6, 3, radius: 1.5, fill: pl142[0])
        text("MENU", PX + 3 * (PBW + 6) + PBW / 2 + 1, PBY + pd142 + (PBH - 4) / 2 + 1, size: 9, color: INK, font: press, align: center)
        text("MENU", PX + 3 * (PBW + 6) + PBW / 2, PBY + pd142 + (PBH - 4) / 2, size: 9, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        // ---- a talk ----
        if talk != null {
          let ty = LS ? PY + sh + 40 : PY
          let thh = min(124, LS ? PBY - ty - 8 : PBY - PY - 8)
          rect(PX - 2, ty + 3, PW + 4, thh, radius: 8 * corners, fill: alpha("#000000", 0.35))
          rect(PX - 2, ty, PW + 4, thh, radius: 8 * corners, fill: surface, stroke: INK, width: 2)
          rect(PX + 3, ty + 5, PW - 6, thh - 10, radius: 5 * corners, fill: "none", stroke: alpha(accent, 0.6), width: 1)
          for s, j in split(talk.ls[talk.i], "|") {
            text(s, PX + 16, ty + 28 + j * 22, size: 8, color: foreground, font: press)
          }
          text(talk.i < len(talk.ls) - 1 ? "▼" : "■", PX + PW - 18, ty + thh - 20, size: 10, color: accent, align: center)
        }
      }
      if scene == "party" {
        rect(0, 0, SW, SH, fill: background)
        text("YOUR KIN", 16, TOP + 22, size: 12, color: accent, font: press)
        let pd146 = downAt[0] >= SW - 62 && downAt[0] < SW - 62 + 50 && downAt[1] >= TOP + 6 && downAt[1] < TOP + 6 + 34 ? 3 : 0
        let pl146 = true ? BTN.red : BTN.off
        rect(SW - 62, TOP + 6 + 4, 50, 34 - 4, radius: 4, fill: pl146[3])
        rect(SW - 62, TOP + 6 + pd146, 50, 34 - 4, radius: 4, fill: pl146[1], stroke: INK, width: 2)
        rect(SW - 62 + 3, TOP + 6 + pd146 + 3, 50 - 6, 3, radius: 1.5, fill: pl146[0])
        text("X", SW - 62 + 50 / 2 + 1, TOP + 6 + pd146 + (34 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
        text("X", SW - 62 + 50 / 2, TOP + 6 + pd146 + (34 - 4) / 2, size: 10, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        let rh = floor(min(80, (SH - TOP - INS - 60 - (pSel >= 0 ? 190 : 0)) / 6))
        for m, i in party {
          let ry = TOP + 52 + i * (rh + 4)
          rect(10, ry + 3, SW - 20, rh, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(10, ry, SW - 20, rh, radius: 6 * corners, fill: i == pSel ? mix(surface, accent, 0.25) : surface, stroke: i == pSel ? accent : INK, width: 2)
          image(KI[m.s], 18, ry + rh / 2 - min(24, rh / 2 - 4), min(48, rh - 8), min(48, rh - 8))
          text(SP[m.s].n, 76, ry + rh / 2 - 12, size: 9, color: m.hp > 0 ? foreground : muted, font: press)
          rect(76, ry + rh / 2 + 2, 52, 12, radius: 2, fill: EC[SP[m.s].e])
          text(EN[SP[m.s].e], 102, ry + rh / 2 + 8, size: 6, color: INK, font: press, align: center)
          text("LV${m.lv}", 138, ry + rh / 2 + 8, size: 7, color: muted, font: press)
          rect(SW * 0.56, ry + rh / 2 - 16, SW * 0.4 - 14, 8, radius: 2, fill: INK)
          rect(SW * 0.56 + 2, ry + rh / 2 - 16 + 2, (SW * 0.4 - 14 - 4) * clamp(m.hp / max(1, m.mh), 0, 1), 4, radius: 1, fill: m.hp <= m.mh / 5 ? "#ff5a4a" : m.hp <= m.mh / 2 ? "#ffd23a" : "#6fe05a")
          text(m.hp <= 0 ? "FAINTED" : "${m.hp}/${m.mh}", SW - 22, ry + rh / 2 + 2, size: 7, color: m.hp <= 0 ? "#ff5a4a" : foreground, font: press, align: end)
          rect(SW * 0.56, ry + rh / 2 + 14, SW * 0.4 - 14, 3, fill: alpha(foreground, 0.15))
          rect(SW * 0.56, ry + rh / 2 + 14, (SW * 0.4 - 14) * clamp(m.xp / (floor((m.lv) * (m.lv) * 0.8) + 10), 0, 1), 3, fill: "#4ab0ff")
          if i == 0 {
            text("LEAD", SW - 22, ry + 12, size: 6, color: accent, font: press, align: end)
          }
        }
        if pSel >= 0 && pSel < len(party) {
          let m = party[pSel]
          let dy = SH - INS - 190
          rect(10, dy + 3, SW - 20, 182, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(10, dy, SW - 20, 182, radius: 6 * corners, fill: true ? mix(surface, accent, 0.25) : surface, stroke: true ? accent : INK, width: 2)
          text("ATK ${m.at}   DEF ${m.df}   SPD ${m.sp}", 22, dy + 20, size: 7, color: foreground, font: press)
          text(SP[m.s].ev > 0 ? "EVOLVES AT LV ${SP[m.s].ev}" : "FULLY GROWN", SW - 22, dy + 20, size: 6, color: muted, font: press, align: end)
          for mv, j in m.m {
            let mx = 22 + (j % 2) * ((SW - 44) / 2 + 4)
            let my = dy + 36 + floor(j / 2) * 40
            rect(mx, my, (SW - 44) / 2 - 4, 34, radius: 4, fill: mix(EC[MV[mv].e], "#000000", 0.3), stroke: INK, width: 1.5)
            text(MV[mv].n, mx + 8, my + 12, size: 7, color: "#ffffff", font: press)
            text(MV[mv].p > 0 ? "${EN[MV[mv].e]} · ${MV[mv].p} · ${MV[mv].a}%" : "${EN[MV[mv].e]} · STATUS", mx + 8, my + 25, size: 5, color: alpha("#ffffff", 0.8), font: press)
          }
          let pd150 = downAt[0] >= 22 && downAt[0] < 22 + (SW - 52) / 2 && downAt[1] >= dy + 124 && downAt[1] < dy + 124 + 46 ? 3 : 0
          let pl150 = pSel > 0 ? BTN.go : BTN.off
          rect(22, dy + 124 + 4, (SW - 52) / 2, 46 - 4, radius: 4, fill: pl150[3])
          rect(22, dy + 124 + pd150, (SW - 52) / 2, 46 - 4, radius: 4, fill: pl150[1], stroke: INK, width: 2)
          rect(22 + 3, dy + 124 + pd150 + 3, (SW - 52) / 2 - 6, 3, radius: 1.5, fill: pl150[0])
          text("MAKE LEAD", 22 + (SW - 52) / 2 / 2 + 1, dy + 124 + pd150 + (46 - 4) / 2 + 1, size: 8, color: INK, font: press, align: center)
          text("MAKE LEAD", 22 + (SW - 52) / 2 / 2, dy + 124 + pd150 + (46 - 4) / 2, size: 8, color: pSel > 0 ? "#ffffff" : "#a8a2c0", font: press, align: center)
          let pd151 = downAt[0] >= 30 + (SW - 52) / 2 && downAt[0] < 30 + (SW - 52) / 2 + (SW - 52) / 2 && downAt[1] >= dy + 124 && downAt[1] < dy + 124 + 46 ? 3 : 0
          let pl151 = true ? BTN.off : BTN.off
          rect(30 + (SW - 52) / 2, dy + 124 + 4, (SW - 52) / 2, 46 - 4, radius: 4, fill: pl151[3])
          rect(30 + (SW - 52) / 2, dy + 124 + pd151, (SW - 52) / 2, 46 - 4, radius: 4, fill: pl151[1], stroke: INK, width: 2)
          rect(30 + (SW - 52) / 2 + 3, dy + 124 + pd151 + 3, (SW - 52) / 2 - 6, 3, radius: 1.5, fill: pl151[0])
          text("CLOSE", 30 + (SW - 52) / 2 + (SW - 52) / 2 / 2 + 1, dy + 124 + pd151 + (46 - 4) / 2 + 1, size: 8, color: INK, font: press, align: center)
          text("CLOSE", 30 + (SW - 52) / 2 + (SW - 52) / 2 / 2, dy + 124 + pd151 + (46 - 4) / 2, size: 8, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        }
      }
      if scene == "bag" {
        rect(0, 0, SW, SH, fill: background)
        text("BAG", 16, TOP + 22, size: 12, color: accent, font: press)
        let pd155 = downAt[0] >= SW - 62 && downAt[0] < SW - 62 + 50 && downAt[1] >= TOP + 6 && downAt[1] < TOP + 6 + 34 ? 3 : 0
        let pl155 = true ? BTN.red : BTN.off
        rect(SW - 62, TOP + 6 + 4, 50, 34 - 4, radius: 4, fill: pl155[3])
        rect(SW - 62, TOP + 6 + pd155, 50, 34 - 4, radius: 4, fill: pl155[1], stroke: INK, width: 2)
        rect(SW - 62 + 3, TOP + 6 + pd155 + 3, 50 - 6, 3, radius: 1.5, fill: pl155[0])
        text("X", SW - 62 + 50 / 2 + 1, TOP + 6 + pd155 + (34 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
        text("X", SW - 62 + 50 / 2, TOP + 6 + pd155 + (34 - 4) / 2, size: 10, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        for it in range(5) {
          let ry = TOP + 52 + it * 62
          rect(10, ry + 3, SW - 20, 56, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(10, ry, SW - 20, 56, radius: 6 * corners, fill: it == selIt ? mix(surface, accent, 0.25) : surface, stroke: it == selIt ? accent : INK, width: 2)
          layer(inv[it] > 0 ? 1 : 0.45) {
            image(ITI[it], 20, ry + 12, 32, 32)
            text(ITN[it], 64, ry + 20, size: 9, color: foreground, font: press)
            text(it >= 3 ? "${ITD[it]} (IN BATTLE)" : ITD[it], 64, ry + 38, size: 6, color: muted, font: press)
            text("×${inv[it]}", SW - 24, ry + 28, size: 10, color: accent, font: press, align: end)
          }
        }
        if selIt >= 0 {
          let ly = TOP + 52 + 5 * 62 + 10
          text("USE THE ${ITN[selIt]} ON:", 14, ly + 6, size: 7, color: accent, font: press)
          let rh = floor(min(52, (SH - INS - ly - 24) / 6))
          for m, i in party {
            let ry = ly + 18 + i * (rh + 4)
            let ok = selIt == 2 ? m.hp <= 0 : m.hp > 0 && m.hp < m.mh
            rect(10, ry + 3, SW - 20, rh, radius: 6 * corners, fill: alpha("#000000", 0.3))
            rect(10, ry, SW - 20, rh, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
            layer(ok ? 1 : 0.45) {
              image(KI[m.s], 16, ry + rh / 2 - 16, 32, 32)
              text(SP[m.s].n, 56, ry + rh / 2, size: 8, color: foreground, font: press)
              rect(SW * 0.5, ry + rh / 2 - 10, SW * 0.46 - 12, 8, radius: 2, fill: INK)
              rect(SW * 0.5 + 2, ry + rh / 2 - 10 + 2, (SW * 0.46 - 12 - 4) * clamp(m.hp / max(1, m.mh), 0, 1), 4, radius: 1, fill: m.hp <= m.mh / 5 ? "#ff5a4a" : m.hp <= m.mh / 2 ? "#ffd23a" : "#6fe05a")
              text(m.hp <= 0 ? "FAINTED" : "${m.hp}/${m.mh}", SW - 22, ry + rh / 2 + 10, size: 7, color: foreground, font: press, align: end)
            }
          }
        }
      }
      if scene == "shop" {
        rect(0, 0, SW, SH, fill: background)
        text("SHOP", 16, TOP + 22, size: 12, color: accent, font: press)
        let pd162 = downAt[0] >= SW - 62 && downAt[0] < SW - 62 + 50 && downAt[1] >= TOP + 6 && downAt[1] < TOP + 6 + 34 ? 3 : 0
        let pl162 = true ? BTN.red : BTN.off
        rect(SW - 62, TOP + 6 + 4, 50, 34 - 4, radius: 4, fill: pl162[3])
        rect(SW - 62, TOP + 6 + pd162, 50, 34 - 4, radius: 4, fill: pl162[1], stroke: INK, width: 2)
        rect(SW - 62 + 3, TOP + 6 + pd162 + 3, 50 - 6, 3, radius: 1.5, fill: pl162[0])
        text("X", SW - 62 + 50 / 2 + 1, TOP + 6 + pd162 + (34 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
        text("X", SW - 62 + 50 / 2, TOP + 6 + pd162 + (34 - 4) / 2, size: 10, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        image(COIN, 16, TOP + 48, 18, 18)
        text("${gold} GOLD", 42, TOP + 57, size: 9, color: foreground, font: press)
        for it in range(5) {
          let ry = TOP + 80 + it * 70
          let ok = gold >= ITP[it]
          rect(10, ry + 3, SW - 20, 62, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(10, ry, SW - 20, 62, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
          image(ITI[it], 20, ry + 15, 32, 32)
          text(ITN[it], 64, ry + 18, size: 9, color: foreground, font: press)
          text(ITD[it], 64, ry + 34, size: 6, color: muted, font: press)
          text("YOU HAVE ${inv[it]}", 64, ry + 48, size: 6, color: muted, font: press)
          let pd164 = downAt[0] >= SW - 110 && downAt[0] < SW - 110 + 90 && downAt[1] >= ry + 10 && downAt[1] < ry + 10 + 42 ? 3 : 0
          let pl164 = ok ? BTN.go : BTN.off
          rect(SW - 110, ry + 10 + 4, 90, 42 - 4, radius: 4, fill: pl164[3])
          rect(SW - 110, ry + 10 + pd164, 90, 42 - 4, radius: 4, fill: pl164[1], stroke: INK, width: 2)
          rect(SW - 110 + 3, ry + 10 + pd164 + 3, 90 - 6, 3, radius: 1.5, fill: pl164[0])
          text("${ITP[it]}G", SW - 110 + 90 / 2 + 1, ry + 10 + pd164 + (42 - 4) / 2 + 1, size: 8, color: INK, font: press, align: center)
          text("${ITP[it]}G", SW - 110 + 90 / 2, ry + 10 + pd164 + (42 - 4) / 2, size: 8, color: ok ? "#ffffff" : "#a8a2c0", font: press, align: center)
        }
        text("TAP A PRICE TO BUY ONE", SW / 2, TOP + 80 + 5 * 70 + 16, size: 7, color: muted, font: press, align: center)
      }
      if scene == "den" {
        rect(0, 0, SW, SH, fill: background)
        text("THE DEN", 16, TOP + 22, size: 12, color: accent, font: press)
        let pd168 = downAt[0] >= SW - 62 && downAt[0] < SW - 62 + 50 && downAt[1] >= TOP + 6 && downAt[1] < TOP + 6 + 34 ? 3 : 0
        let pl168 = true ? BTN.red : BTN.off
        rect(SW - 62, TOP + 6 + 4, 50, 34 - 4, radius: 4, fill: pl168[3])
        rect(SW - 62, TOP + 6 + pd168, 50, 34 - 4, radius: 4, fill: pl168[1], stroke: INK, width: 2)
        rect(SW - 62 + 3, TOP + 6 + pd168 + 3, 50 - 6, 3, radius: 1.5, fill: pl168[0])
        text("X", SW - 62 + 50 / 2 + 1, TOP + 6 + pd168 + (34 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
        text("X", SW - 62 + 50 / 2, TOP + 6 + pd168 + (34 - 4) / 2, size: 10, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        text("TAP A KIN TO MOVE IT", 16, TOP + 56, size: 7, color: muted, font: press)
        let cw = (SW - 30) / 2
        let rh = floor(min(70, (SH - TOP - INS - 140) / 6))
        text("TEAM ${len(party)}/6", 10 + cw / 2, TOP + 80, size: 8, color: accent, font: press, align: center)
        text("DEN ${len(den)}", 20 + cw * 1.5, TOP + 80, size: 8, color: accent, font: press, align: center)
        for m, i in party {
          let ry = TOP + 94 + i * (rh + 4)
          rect(10, ry + 3, cw, rh, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(10, ry, cw, rh, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
          image(KI[m.s], 16, ry + rh / 2 - 18, 36, 36)
          text(SP[m.s].n, 58, ry + rh / 2 - 6, size: 6, color: foreground, font: press)
          text("LV${m.lv}", 58, ry + rh / 2 + 10, size: 6, color: muted, font: press)
        }
        let pg = den.drop(denPg * 6).take(6)
        for m, i in pg {
          let ry = TOP + 94 + i * (rh + 4)
          rect(20 + cw, ry + 3, cw, rh, radius: 6 * corners, fill: alpha("#000000", 0.3))
          rect(20 + cw, ry, cw, rh, radius: 6 * corners, fill: false ? mix(surface, accent, 0.25) : surface, stroke: false ? accent : INK, width: 2)
          image(KI[m.s], 26 + cw, ry + rh / 2 - 18, 36, 36)
          text(SP[m.s].n, 68 + cw, ry + rh / 2 - 6, size: 6, color: foreground, font: press)
          text("LV${m.lv}", 68 + cw, ry + rh / 2 + 10, size: 6, color: muted, font: press)
        }
        let ny = TOP + 94 + 6 * (rh + 4) + 6
        if len(den) > 6 {
          let pd171 = downAt[0] >= 20 + cw && downAt[0] < 20 + cw + cw / 2 - 4 && downAt[1] >= ny && downAt[1] < ny + 40 ? 3 : 0
          let pl171 = denPg > 0 ? BTN.wood : BTN.off
          rect(20 + cw, ny + 4, cw / 2 - 4, 40 - 4, radius: 4, fill: pl171[3])
          rect(20 + cw, ny + pd171, cw / 2 - 4, 40 - 4, radius: 4, fill: pl171[1], stroke: INK, width: 2)
          rect(20 + cw + 3, ny + pd171 + 3, cw / 2 - 4 - 6, 3, radius: 1.5, fill: pl171[0])
          text("<", 20 + cw + cw / 2 - 4 / 2 + 1, ny + pd171 + (40 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
          text("<", 20 + cw + cw / 2 - 4 / 2, ny + pd171 + (40 - 4) / 2, size: 10, color: denPg > 0 ? "#ffffff" : "#a8a2c0", font: press, align: center)
          let pd172 = downAt[0] >= 24 + cw * 1.5 && downAt[0] < 24 + cw * 1.5 + cw / 2 - 4 && downAt[1] >= ny && downAt[1] < ny + 40 ? 3 : 0
          let pl172 = (denPg + 1) * 6 < len(den) ? BTN.wood : BTN.off
          rect(24 + cw * 1.5, ny + 4, cw / 2 - 4, 40 - 4, radius: 4, fill: pl172[3])
          rect(24 + cw * 1.5, ny + pd172, cw / 2 - 4, 40 - 4, radius: 4, fill: pl172[1], stroke: INK, width: 2)
          rect(24 + cw * 1.5 + 3, ny + pd172 + 3, cw / 2 - 4 - 6, 3, radius: 1.5, fill: pl172[0])
          text(">", 24 + cw * 1.5 + cw / 2 - 4 / 2 + 1, ny + pd172 + (40 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
          text(">", 24 + cw * 1.5 + cw / 2 - 4 / 2, ny + pd172 + (40 - 4) / 2, size: 10, color: (denPg + 1) * 6 < len(den) ? "#ffffff" : "#a8a2c0", font: press, align: center)
        }
        text("KIN IN THE DEN ARE KEPT HEALED", SW / 2, SH - INS - 16, size: 6, color: muted, font: press, align: center)
      }
      if scene == "log" {
        rect(0, 0, SW, SH, fill: background)
        text("KIN LOG", 16, TOP + 22, size: 12, color: accent, font: press)
        let pd176 = downAt[0] >= SW - 62 && downAt[0] < SW - 62 + 50 && downAt[1] >= TOP + 6 && downAt[1] < TOP + 6 + 34 ? 3 : 0
        let pl176 = true ? BTN.red : BTN.off
        rect(SW - 62, TOP + 6 + 4, 50, 34 - 4, radius: 4, fill: pl176[3])
        rect(SW - 62, TOP + 6 + pd176, 50, 34 - 4, radius: 4, fill: pl176[1], stroke: INK, width: 2)
        rect(SW - 62 + 3, TOP + 6 + pd176 + 3, 50 - 6, 3, radius: 1.5, fill: pl176[0])
        text("X", SW - 62 + 50 / 2 + 1, TOP + 6 + pd176 + (34 - 4) / 2 + 1, size: 10, color: INK, font: press, align: center)
        text("X", SW - 62 + 50 / 2, TOP + 6 + pd176 + (34 - 4) / 2, size: 10, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        text("SEEN ${count(seen, s => s)}  ·  CAUGHT ${count(caught, s => s)} OF ${NK}", 16, TOP + 56, size: 7, color: muted, font: press)
        let cw = (SW - 32) / 3
        let rh = floor(min(cw, (SH - TOP - INS - 80) / 7))
        for k in range(NK) {
          let cx = 10 + (k % 3) * (cw + 6)
          let cy = TOP + 70 + floor(k / 3) * rh
          let sz = min(rh - 22, 48)
          rect(cx, cy, cw, rh - 4, radius: 6 * corners, fill: alpha(foreground, caught[k] ? 0.08 : 0.04))
          if caught[k] {
            image(KI[k], cx + cw / 2 - sz / 2, cy + 2, sz, sz)
          } else if seen[k] {
            layer(0.5) { image(KI[k], cx + cw / 2 - sz / 2, cy + 2, sz, sz) }
          } else {
            image(KI[k], cx + cw / 2 - sz / 2, cy + 2, sz, sz, color: alpha(foreground, 0.15))
          }
          text(seen[k] || caught[k] ? SP[k].n : "???", cx + cw / 2, cy + rh - 13, size: 6, color: caught[k] ? foreground : muted, font: press, align: center)
        }
      }
      if scene == "starter" {
        rect(0, 0, SW, SH, fill: linear(0, 0, 0, SH, ["#7ac8f0", "#d8f0ff"]))
        text("CHOOSE YOUR", SW / 2, TOP + 50, size: 12, color: INK, font: press, align: center)
        text("FIRST KIN", SW / 2, TOP + 74, size: 16, color: "#c84a3a", font: press, align: center)
        let ch = [0, 2, 4]
        let blurb = ["QUICK AND FIERY", "STEADY AND CALM", "TOUGH AND PATIENT"]
        let rh = floor(min(190, (SH - TOP - INS - 140) / 3))
        for s, j in ch {
          let ry = TOP + 100 + j * (rh + 10)
          let pd = downAt[1] >= ry && downAt[1] < ry + rh ? 3 : 0
          rect(20, ry + 4, SW - 40, rh, radius: 10 * corners, fill: alpha("#000000", 0.25))
          rect(20, ry + pd, SW - 40, rh, radius: 10 * corners, fill: "#fff8e8", stroke: INK, width: 2)
          let sz = min(rh - 24, 128)
          image(KI[s], 34, ry + pd + rh / 2 - sz / 2, sz, sz)
          text(SP[s].n, 50 + sz, ry + pd + rh / 2 - 20, size: 12, color: INK, font: press)
          rect(50 + sz, ry + pd + rh / 2 - 4, 70, 16, radius: 3, fill: EC[SP[s].e], stroke: INK, width: 1.5)
          text(EN[SP[s].e], 85 + sz, ry + pd + rh / 2 + 4, size: 7, color: INK, font: press, align: center)
          text(blurb[j], 50 + sz, ry + pd + rh / 2 + 30, size: 7, color: "#5a5468", font: press)
        }
      }
      if scene == "title" {
        let tt = time
        rect(0, 0, SW, SH, fill: linear(0, 0, 0, SH, ["#7ac8f0", "#d8f0ff"]))
        rect(0, SH * 0.58, SW, SH * 0.42, fill: "#5aa848")
        rect(0, SH * 0.58, SW, 4, fill: "#6ac05a")
        for k in range(16) {
          rect(hash(k, 1) * SW, SH * (0.62 + hash(k, 2) * 0.34), 8 + hash(k, 3) * 12, 4, fill: "#4a9040")
        }
        for k in range(3) {
          let cx = (hash(k, 9) * 1.3 * SW + tt * (8 + k * 4)) % (SW * 1.3) - SW * 0.15
          rect(cx, SH * (0.08 + k * 0.07), 60 + k * 10, 14, radius: 7, fill: alpha("#ffffff", 0.8))
          rect(cx + 14, SH * (0.08 + k * 0.07) - 8, 34, 14, radius: 7, fill: alpha("#ffffff", 0.8))
        }
        let ls = min(42, (SW - 40) / 7)
        text("WILDKIN", SW / 2 + 4, SH * 0.2 + 4, size: ls, color: INK, font: press, align: center)
        text("WILDKIN", SW / 2, SH * 0.2, size: ls, color: "#ffd23a", font: press, align: center)
        text("CATCH · TRAIN · EVOLVE", SW / 2, SH * 0.2 + ls * 0.5 + 20, size: 8, color: INK, font: press, align: center)
        let par = [0, 6, 2, 12, 4, 8]
        let ks = min(64, (SW - 40) / 6)
        for k, j in par {
          let kx = 20 + j * ks
          let ky = SH * 0.58 - ks + 6 - abs(sin(tt * 3 + j)) * 8
          rect(kx + ks * 0.15, SH * 0.58 + 2, ks * 0.7, 6, radius: 3, fill: alpha("#000000", 0.2))
          image(KI[k], kx, ky, ks, ks)
        }
        let going = started && len(party) > 0
        let by = SH * 0.68
        let pd179 = downAt[0] >= SW / 2 - 120 && downAt[0] < SW / 2 - 120 + 240 && downAt[1] >= by && downAt[1] < by + 54 ? 3 : 0
        let pl179 = true ? BTN.go : BTN.off
        rect(SW / 2 - 120, by + 4, 240, 54 - 4, radius: 4, fill: pl179[3])
        rect(SW / 2 - 120, by + pd179, 240, 54 - 4, radius: 4, fill: pl179[1], stroke: INK, width: 2)
        rect(SW / 2 - 120 + 3, by + pd179 + 3, 240 - 6, 3, radius: 1.5, fill: pl179[0])
        text(going ? "CONTINUE" : "NEW GAME", SW / 2 - 120 + 240 / 2 + 1, by + pd179 + (54 - 4) / 2 + 1, size: 13, color: INK, font: press, align: center)
        text(going ? "CONTINUE" : "NEW GAME", SW / 2 - 120 + 240 / 2, by + pd179 + (54 - 4) / 2, size: 13, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
        if going {
          let pd180 = downAt[0] >= SW / 2 - 110 && downAt[0] < SW / 2 - 110 + 220 && downAt[1] >= by + 70 && downAt[1] < by + 70 + 40 ? 3 : 0
          let pl180 = true ? sure ? BTN.red : BTN.off : BTN.off
          rect(SW / 2 - 110, by + 70 + 4, 220, 40 - 4, radius: 4, fill: pl180[3])
          rect(SW / 2 - 110, by + 70 + pd180, 220, 40 - 4, radius: 4, fill: pl180[1], stroke: INK, width: 2)
          rect(SW / 2 - 110 + 3, by + 70 + pd180 + 3, 220 - 6, 3, radius: 1.5, fill: pl180[0])
          text(sure ? "SURE? TAP AGAIN" : "NEW GAME", SW / 2 - 110 + 220 / 2 + 1, by + 70 + pd180 + (40 - 4) / 2 + 1, size: 8, color: INK, font: press, align: center)
          text(sure ? "SURE? TAP AGAIN" : "NEW GAME", SW / 2 - 110 + 220 / 2, by + 70 + pd180 + (40 - 4) / 2, size: 8, color: true ? "#ffffff" : "#a8a2c0", font: press, align: center)
          text("${count(caught, s => s)} KIN CAUGHT · ${nsig} SIGILS", SW / 2, by + 132, size: 7, color: INK, font: press, align: center)
        }
      }
    }
  }

  // ---- the screens over the map ------------------------------------------------------------------






  // ---- the panel's buttons and the map ---------------------------------------------------------------


  // ---- the title and the first kin -----------------------------------------------------------------

}
