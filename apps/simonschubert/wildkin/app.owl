  // ---- text --------------------------------------------------------------------------------------
  strings {
    en {
      // All drawn in capitals in a pixel font, about 8 px a letter at size 8. A "|" starts a new line:
      // a talk page has room for 4 lines and a battle message for 3, about 36 letters each.
      // "Kin" is the game's word for its creatures, one or many. Kin, keeper and place names stay as they are.
      // The seven elements, in a small badge: 7 letters at most.
      elems: ["PLAIN", "EMBER", "TIDE", "LEAF", "VOLT", "STONE", "SHADE"]
      // The moves, in MV's order, on the battle buttons: 20 letters at most.
      moves: ["TACKLE", "SCRATCH", "GROWL", "HARDEN", "EMBER", "FLAME RUSH", "INFERNO", "SPRAY", "WAVE CRASH", "RIPTIDE", "LEAF CUT", "VINE LASH", "SAP DRAIN", "BLOOM", "SPARK", "BOLT", "THUNDERFALL", "PEBBLE TOSS", "ROCKSLIDE", "QUAKE", "HEX", "NIGHT FANG", "GUST", "FOCUS", "GLARE", "DIVE STRIKE", "NIGHTMARE", "BODY SLAM", "THORN STORM"]
      // The bag: tonic, elixir, wake herb, charm, gold charm, and what each does.
      items: ["TONIC", "ELIXIR", "WAKE HERB", "CHARM", "GOLD CHARM"]
      itemDesc: ["HEALS 30 HP", "HEALS ALL HP", "WAKES A FAINTED KIN", "CATCHES A WILD KIN", "CATCHES TWICE AS WELL"]
      // The four keepers and the Elder: their title, and the talk pages before a battle, after winning it, and later.
      keepers: [
        {t: "KEEPER ROWAN", intro: ["I AM ROWAN, KEEPER OF THE MEADOW.", "SHOW ME HOW YOU CARE FOR YOUR KIN!"], win: ["WELL RAISED! TAKE THE LEAF SIGIL.", "THE WARDEN NORTH LETS THROUGH|ANYONE WITH TWO SIGILS."], after: ["MOSSGROVE LIES WEST, AND THE|BRINE SHORE EAST. GOOD LUCK!"]},
        {t: "KEEPER MAVE", intro: ["SHH... THE GROVE IS LISTENING.", "MY SHADE KIN WILL TEST YOUR NERVE."], win: ["YOU DIDN'T FLINCH.|THE SHADE SIGIL IS YOURS."], after: ["SHADE HITS SHADE HARD.|PLAIN MOVES BARELY TOUCH IT."]},
        {t: "KEEPER NERIS", intro: ["THE TIDE COMES IN FOR EVERYONE.", "LET'S SEE IF YOU CAN SWIM!"], win: ["WASHED OUT!|THE TIDE SIGIL IS YOURS."], after: ["LEAF AND VOLT MOVES HIT MY|KIN HARD. NOW YOU KNOW."]},
        {t: "KEEPER BRAND", intro: ["HOT ENOUGH FOR YOU?", "MY KIN WERE BORN IN THE LAVA!"], win: ["BURNED OUT...|THE EMBER SIGIL IS YOURS."], after: ["THE ELDER WAITS ON STORMRIDGE,|PAST THE STONE WARDEN."]},
        {t: "ELDER ODA", intro: ["SO. YOU HOLD FOUR SIGILS.", "I AM ODA, THE ELDER. SHOW ME|ALL THAT YOU AND YOUR KIN|HAVE LEARNED!"], win: ["...MAGNIFICENT.", "YOU ARE A TRUE FRIEND OF KIN.|THE STORM SIGIL IS YOURS.", "THANKS FOR PLAYING WILDKIN!|CATCH ALL 21 KIN, OR CLIMB|BACK HERE FOR A REMATCH."], after: []}
      ]
      sign: ["HOLLOW, HOME OF KIN TAMERS.", "NORTH: FERNWAY MEADOW.|WILD KIN HIDE IN TALL GRASS."]
      // Under each of the three starters.
      blurb: ["QUICK AND FIERY", "STEADY AND CALM", "TOUGH AND PATIENT"]
      // Battle messages; who is a kin's name, or wild(name) or foe(name) for the other side's.
      wild: name => "WILD ${name}"
      foe: name => "FOE ${name}"
      go: name => "GO, ${name}!"
      comeBack: name => "COME BACK, ${name}!"
      uses: (who, move) => "${who} USES ${move}!"
      missed: "BUT IT MISSED!"
      crit: "A CRITICAL HIT!"
      superEff: "IT'S SUPER EFFECTIVE!"
      notVery: "IT'S NOT VERY EFFECTIVE..."
      drains: (who, n) => "${who} DRAINS ${n} HP!"
      fainted: who => "${who} FAINTED!"
      atkFell: who => "${who}'S ATTACK FELL!"
      defRose: who => "${who}'S DEFENCE ROSE!"
      atkRose: who => "${who}'S ATTACK ROSE!"
