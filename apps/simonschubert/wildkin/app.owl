  // ---- saved -------------------------------------------------------------------------------------
  // title, starter, map, battle, party, bag, shop, den, log
  state scene = "title" persist
  state started = false persist
  state area = 0 persist
  state hx = 5 persist
  state hy = 9 persist
  // facing: 0 down, 1 up, 2 left, 3 right
  state hf = 0 persist
  // a kin: species, level, experience, health, max health, attack, defence, speed, moves
  state party = [] persist
  state den = [] persist
  state gold = 100 persist
  // tonics, elixirs, wake herbs, charms, gold charms
  state inv = [3, 0, 1, 5, 0] persist
  state sig = [false, false, false, false, false] persist
  state seen = [] persist
  state caught = [] persist
  state wins = 0 persist
  // a battle: wild or not, the keeper, the foes and the one out, our one out, and the stat stages
  state bt = null persist
  // menu (choose), anim (a turn plays), swap (pick the next after a faint)
  state bphase = "menu" persist
  state bnext = "menu" persist
  // a talk on the map: its pages, the page, and the keeper whose battle follows
  state talk = null persist

  // ---- for now -----------------------------------------------------------------------------------
  state evs = []
  state tq = 0
  state bv = [null, null]
  state bAct = null
  state bGo = 0
  state bdone = false
  // the bag or the kin list over the battle buttons, and the item picked
  state sub = ""
  state selIt = -1
  state hint = ""
  state fxTap = 0
  state fxAt = 0
  state fxLen = 0
  when fxAt == -1 && time != fxTap {
    fxAt = time
    sqi = 0
  }
  state walking = false
  state wp = []
  state wTap = 0
  state wAt = 0
  state wLen = 0
  state wNext = null
  when wAt == -1 && time != wTap { wAt = time }
  state pSel = -1
  state denPg = 0
  state sure = false
  state downAt = [-1, -1]
  // sounds, on unless turned off on the title
  state snd = true persist
  // A turn's sounds, from its events: {t, u} with t in seconds from `fxAt` and u one of the S_
  // below (0 a charm thrown, 1 a hit, 2 a faint, 3 a battle starting, 4 a level up or an evolution,
  // 5 a catch or a keeper beaten, 6 all kin down; a message says which in its cue), by time and, at the same time, the one that
  // matters most last. `sqi` is how many have played; a dropped frame skips to the latest. The
  // sounds are spelled out in `sound` so the store can list them.
  let sq = bphase != "anim" ? [] : evs.map(e => {t: e.t, u: e.k == "throw" ? 0 : e.k == "hit" ? 1 : e.k == "faint" ? 2 : e.k == "intro" ? 3 : e.k != "msg" ? -1 : e.cue ?? -1}).filter(e => e.u >= 0).sortBy(e => e.t * 1000 + e.u)
  state sqi = 0
  let sqDue = bphase != "anim" || fxAt < 0 || time < fxAt ? 0 : count(sq, e => time - fxAt >= e.t)
  when sqDue > sqi {
    let u = sq[sqDue - 1].u
    if snd { sound(u == 0 ? S_THROW : u == 1 ? S_HIT : u == 2 ? S_FAINT : u == 3 ? S_ENC : u == 4 ? S_LEVEL : u == 5 ? S_WIN : S_LOSE) }
    sqi = sqDue
  }
  // Sounds from Google's sound library (actions.google.com/sounds, CC BY 4.0), trimmed and made
  // mono Opus to fit in the file: swoosh, slap with glove, deflate, concussive guitar hit, xylophone tip toe scale up, tympani bing, slide whistle to drum and loose change on wood.
  asset S_THROW = base64""
  asset S_HIT = base64""
  asset S_FAINT = base64""
  asset S_ENC = base64""
  asset S_LEVEL = base64""
  asset S_WIN = base64""
  asset S_LOSE = base64""
  asset S_COIN = base64""

  // ---- the screen --------------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let INS = max(screenInset ?? 0, 12)
  let LS = SW > SH
  let W = 11
  let H = 15
  let N = 165
  let STEP = 0.17
  let T = floor(LS ? min((SH - TOP - INS - 44) / H, SW * 0.55 / W) : min((SW - 8) / W, (SH - TOP - INS - 250) / H))
  let q = T / 12
  let BX = LS ? 10 : floor((SW - W * T) / 2)
  let BY = TOP + 34
  let PX = LS ? BX + W * T + 14 : 10
  let PW = LS ? SW - PX - 12 : SW - 20
  let PY = LS ? TOP + 34 : BY + H * T + 10
  let PB = SH - INS - 6
  // the panel's buttons
  let PBH = 46
  let PBY = PB - PBH
  let PBW = (PW - 18) / 4
  // the battle: the scene, then the message and the buttons below it (beside it, held sideways)
  let SCW = LS ? floor(SW * 0.52) : SW
  let SCH = LS ? SH - TOP - INS : floor(min(SH * 0.5, SW * 1.15))
  let CX0 = LS ? SCW + 10 : 10
  let CW = LS ? SW - CX0 - 12 : SW - 20
  let CY0 = LS ? TOP + 10 : TOP + SCH + 6
  let MBH = 70
  let BTY = CY0 + MBH + 10
  let BBW = (CW - 8) / 2
  let BBH = floor(clamp((SH - INS - BTY - 78) / 2, 44, 76))
  let B3Y = BTY + 2 * BBH + 12
  let B3W = (CW - 16) / 3
  let LRY = BTY
  let LRH = floor(min(60, (SH - INS - LRY - 58) / 6))
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"
  let INK = "#14121c"
  let BTN = {
    wood: ["#f0c890", "#b07a44", "#84542a", "#3e2410"],
    off: ["#6a6680", "#46425a", "#36324a", "#1a1824"],
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
    red: ["#ffaa94", "#e8504a", "#b8333a", "#621822"],
    blue: ["#a8d0ff", "#4a7ad0", "#2e5096", "#16264a"]
  }

  // ---- the kin -----------------------------------------------------------------------------------
  let EN = str.elems
  let EC = ["#c8c0a8", "#ff7a3a", "#4a9ae8", "#5ac85a", "#ffd23a", "#b08a5a", "#a87ae8"]
  // how hard an element (row) hits another (column)
  let EF = [
    [1, 1, 1, 1, 1, 1, 0.5],
    [1, 0.5, 0.5, 2, 1, 0.5, 1],
    [1, 2, 0.5, 0.5, 1, 2, 1],
    [1, 0.5, 2, 0.5, 1, 2, 1],
    [1, 1, 2, 0.5, 0.5, 0.5, 1],
    [1, 2, 1, 0.5, 2, 1, 1],
    [1, 1, 1, 1, 2, 0.5, 2]
  ]
  // moves: power (0 for the rest), accuracy, and x: 1 foe's attack down, 2 own defence up, 3 own
  // attack up, 4 foe's defence down, 5 heal half, 6 drain half the damage
  let MV0 = [
    {n: "TACKLE", e: 0, p: 35, a: 95, x: 0},
    {n: "SCRATCH", e: 0, p: 40, a: 100, x: 0},
    {n: "GROWL", e: 0, p: 0, a: 100, x: 1},
    {n: "HARDEN", e: 0, p: 0, a: 100, x: 2},
    {n: "EMBER", e: 1, p: 40, a: 100, x: 0},
    {n: "FLAME RUSH", e: 1, p: 70, a: 90, x: 0},
    {n: "INFERNO", e: 1, p: 95, a: 80, x: 0},
    {n: "SPRAY", e: 2, p: 40, a: 100, x: 0},
    {n: "WAVE CRASH", e: 2, p: 70, a: 90, x: 0},
    {n: "RIPTIDE", e: 2, p: 95, a: 80, x: 0},
    {n: "LEAF CUT", e: 3, p: 40, a: 100, x: 0},
    {n: "VINE LASH", e: 3, p: 65, a: 95, x: 0},
    {n: "SAP DRAIN", e: 3, p: 55, a: 100, x: 6},
    {n: "BLOOM", e: 3, p: 0, a: 100, x: 5},
    {n: "SPARK", e: 4, p: 40, a: 100, x: 0},
    {n: "BOLT", e: 4, p: 75, a: 90, x: 0},
    {n: "THUNDERFALL", e: 4, p: 100, a: 75, x: 0},
    {n: "PEBBLE TOSS", e: 5, p: 40, a: 95, x: 0},
    {n: "ROCKSLIDE", e: 5, p: 75, a: 85, x: 0},
    {n: "QUAKE", e: 5, p: 100, a: 75, x: 0},
    {n: "HEX", e: 6, p: 50, a: 100, x: 0},
    {n: "NIGHT FANG", e: 6, p: 75, a: 90, x: 6},
    {n: "GUST", e: 0, p: 45, a: 100, x: 0},
    {n: "FOCUS", e: 0, p: 0, a: 100, x: 3},
    {n: "GLARE", e: 6, p: 0, a: 100, x: 4},
    {n: "DIVE STRIKE", e: 0, p: 80, a: 90, x: 0},
    {n: "NIGHTMARE", e: 6, p: 100, a: 80, x: 0},
    {n: "BODY SLAM", e: 0, p: 70, a: 95, x: 0},
    {n: "THORN STORM", e: 3, p: 95, a: 80, x: 0}
  ]
  // with their names in the phone's language
  let MV = MV0.map((m, i) => merge(m, {n: str.moves[i]}))
  // species: element, base stats, the level it evolves at and into what, how easily it's caught,
  // and the moves it learns by level
  let SP = [
    {n: "CINDLE", e: 1, hp: 44, at: 52, df: 40, sp: 60, ev: 16, to: 1, cr: 0.4, ls: [[1, 1], [1, 2], [5, 4], [9, 23], [14, 5], [22, 21], [30, 6]]},
    {n: "PYRROX", e: 1, hp: 70, at: 84, df: 62, sp: 88, ev: 0, to: 0, cr: 0.2, ls: [[1, 1], [1, 2], [5, 4], [9, 23], [14, 5], [22, 21], [26, 27], [30, 6]]},
    {n: "DRIZZLET", e: 2, hp: 50, at: 46, df: 50, sp: 48, ev: 16, to: 3, cr: 0.4, ls: [[1, 0], [1, 2], [5, 7], [9, 3], [14, 8], [21, 27], [30, 9]]},
    {n: "TORRENTAIL", e: 2, hp: 82, at: 74, df: 80, sp: 70, ev: 0, to: 0, cr: 0.2, ls: [[1, 0], [1, 2], [5, 7], [9, 3], [14, 8], [21, 27], [30, 9]]},
    {n: "SPROUTLE", e: 3, hp: 48, at: 48, df: 56, sp: 44, ev: 16, to: 5, cr: 0.4, ls: [[1, 0], [1, 3], [5, 10], [9, 12], [14, 11], [20, 13], [30, 28]]},
    {n: "THORNBACK", e: 3, hp: 80, at: 78, df: 90, sp: 58, ev: 0, to: 0, cr: 0.2, ls: [[1, 0], [1, 3], [5, 10], [9, 12], [14, 11], [20, 13], [30, 28]]},
    {n: "PUFFWICK", e: 0, hp: 40, at: 40, df: 36, sp: 56, ev: 14, to: 7, cr: 0.75, ls: [[1, 0], [1, 2], [4, 22], [10, 23], [16, 25], [24, 27]]},
    {n: "GUSTOWL", e: 0, hp: 66, at: 68, df: 58, sp: 90, ev: 0, to: 0, cr: 0.3, ls: [[1, 0], [1, 2], [4, 22], [10, 23], [16, 25], [24, 27]]},
    {n: "SPARKBUG", e: 4, hp: 36, at: 48, df: 36, sp: 62, ev: 18, to: 9, cr: 0.6, ls: [[1, 0], [3, 14], [8, 3], [14, 15], [22, 23], [30, 16]]},
    {n: "VOLTMOTH", e: 4, hp: 60, at: 86, df: 56, sp: 96, ev: 0, to: 0, cr: 0.25, ls: [[1, 0], [3, 14], [8, 3], [14, 15], [22, 23], [30, 16]]},
    {n: "PEBBIT", e: 5, hp: 46, at: 52, df: 66, sp: 30, ev: 20, to: 11, cr: 0.55, ls: [[1, 0], [1, 3], [6, 17], [12, 2], [18, 18], [28, 19]]},
    {n: "BOULDERN", e: 5, hp: 80, at: 92, df: 110, sp: 40, ev: 0, to: 0, cr: 0.25, ls: [[1, 0], [1, 3], [6, 17], [12, 2], [18, 18], [24, 27], [28, 19]]},
    {n: "WISPET", e: 6, hp: 40, at: 54, df: 40, sp: 58, ev: 22, to: 13, cr: 0.45, ls: [[1, 1], [1, 24], [6, 20], [12, 2], [20, 21], [30, 26]]},
    {n: "HAUNTLE", e: 6, hp: 64, at: 92, df: 62, sp: 86, ev: 0, to: 0, cr: 0.2, ls: [[1, 1], [1, 24], [6, 20], [12, 2], [20, 21], [30, 26]]},
    {n: "BUBBLOAT", e: 2, hp: 56, at: 40, df: 48, sp: 36, ev: 18, to: 15, cr: 0.5, ls: [[1, 0], [1, 3], [5, 7], [11, 2], [17, 8], [26, 9]]},
    {n: "MARSHMAW", e: 2, hp: 92, at: 76, df: 74, sp: 52, ev: 0, to: 0, cr: 0.25, ls: [[1, 0], [1, 3], [5, 7], [11, 2], [17, 8], [22, 19], [26, 9]]},
    {n: "SCORCHNEWT", e: 1, hp: 42, at: 56, df: 40, sp: 56, ev: 20, to: 17, cr: 0.45, ls: [[1, 1], [1, 24], [6, 4], [12, 23], [18, 5], [28, 6]]},
    {n: "MAGMANDER", e: 1, hp: 70, at: 94, df: 64, sp: 80, ev: 0, to: 0, cr: 0.2, ls: [[1, 1], [1, 24], [6, 4], [12, 23], [18, 5], [22, 18], [28, 6]]},
    {n: "MOSSLING", e: 3, hp: 54, at: 42, df: 54, sp: 34, ev: 19, to: 19, cr: 0.55, ls: [[1, 0], [1, 2], [6, 10], [11, 12], [16, 13], [22, 11], [32, 28]]},
    {n: "SPORELORD", e: 3, hp: 92, at: 74, df: 84, sp: 46, ev: 0, to: 0, cr: 0.25, ls: [[1, 0], [1, 2], [6, 10], [11, 12], [16, 13], [22, 11], [32, 28]]},
    {n: "STORMAW", e: 4, hp: 90, at: 110, df: 86, sp: 100, ev: 0, to: 0, cr: 0.06, ls: [[1, 15], [1, 21], [1, 16], [1, 25]]}
  ]
  let NK = 21
  let KI = [K0, K1, K2, K3, K4, K5, K6, K7, K8, K9, K10, K11, K12, K13, K14, K15, K16, K17, K18, K19, K20]
  let ITN = str.items
  let ITD = str.itemDesc
  let ITP = [20, 90, 60, 30, 100]
  let ITI = [IT0, IT1, IT2, IT3, IT4]

  // ---- the world ---------------------------------------------------------------------------------
  let AN = ["HOLLOW", "FERNWAY MEADOW", "MOSSGROVE", "BRINE SHORE", "EMBER CRAGS", "STORMRIDGE"]
  let ATH = [0, 0, 1, 2, 3, 4]
  // the neighbours north, east, south and west
  let NB = [[1, -1, -1, -1], [4, 3, 0, 2], [-1, 1, -1, -1], [-1, -1, -1, 1], [5, -1, 1, -1], [-1, -1, 4, -1]]
  // the sigils the stone warden at the area's north edge wants
  let GN = [0, 2, 0, 0, 4, 0]
  let MAPS = [
    "TTTTT=TTTTTTf...=...fTT.RRR=BBB.TT.HDH=HDH.TT....=....TT=========TT.f..=..f.TT.VVV=....TT.HDH=.~~.TT....=.~~.TTff..=....TT...!=...fTTf...=...TTTT..f=..TTTTTTTTTTTTTT",
    "TTTT#G#TTTTT,,,.=.,,,TT,,,.=.,,,TT,,.f=f.,,TT.PPP=.,,,TT.HdH=.,,,TT....=....T===========T.,,,=,,,.TT.,,,=,,,.TT..,.=.,..TTf...=..f.TT,,..=..,,TT,,..=..,,TTTTTT=TTTTT",
    "TTTTTTTTTTTT,,T,,,T,,TT,,,,T,,,,TTT,PPP,,T,TT,,HdH,,,,TT,,,=,,T,,TT,T,=,,,,TTT,,,=======TT,,=,,T,,TT,,,=,,,,,TT,T,,,T,,,TT,,,,,,,T,TTT,,T,,,,,TT,,,,,T,,TTTTTTTTTTTTT",
    "#########~~#..ss,,s~~~#,,sss,ss~~#,,sPPPs~~~#,ssHdHss~~#,,sssss,~~#,sss,ss,s~ssssss,,ss~#,,ss,,ss~~#,,,ss,,s~~#f,sss,,ss~#,,ss,,,s~~#,sss,,ss~~##,,sss,s~~##########~",
    "####cGc#####,,,c=c,,,##,LL,=,,,L##,LL,=,PPP##,,,c=cHdH##c,,c=c,c,##,,#c=c#,,##,,,c=c,,,##LL,,=,,LL##LL,,=,,,L##,,N.=.,,,##,,,,=,,,,##c,,c=c,,c##,,,c=c,,,######=#####",
    "############T.PPPPP.T##..HHdHH..##T,,.=.,,T##,,,,=,,,,##T,,,=,,,T##,,#.=.#,,##,,,,=,,,,##T,,,=,,,T##,,,,=,,,,##,,#,=,#,,##T,,,=,,,T##,,,,=,,,,##T,,,=,,,T######=#####"
  ]
  // what can be talked to: the healers, the shop, the den, a sign, the keepers and the wardens
  let IA = [
    {a: 0, c: 36, k: "heal"}, {a: 0, c: 40, k: "shop"}, {a: 0, c: 91, k: "den"}, {a: 0, c: 125, k: "sign"},
    {a: 1, c: 58, k: "keeper", n: 0}, {a: 1, c: 5, k: "gate", n: 2},
    {a: 2, c: 48, k: "keeper", n: 1},
    {a: 3, c: 49, k: "keeper", n: 2},
    {a: 4, c: 52, k: "keeper", n: 3}, {a: 4, c: 113, k: "heal"}, {a: 4, c: 5, k: "gate", n: 4},
    {a: 5, c: 27, k: "keeper", n: 4}
  ]
  // wild kin in each area's tall grass: species, lowest and highest level, and how often
  let WL = [
    [],
    [[6, 2, 4, 40], [8, 3, 4, 25], [10, 2, 4, 20], [18, 3, 4, 15]],
    [[12, 6, 9, 35], [18, 6, 9, 25], [8, 7, 9, 20], [6, 6, 8, 20]],
    [[14, 9, 12, 40], [10, 9, 12, 25], [8, 10, 12, 15], [6, 10, 12, 15], [7, 14, 14, 5]],
    [[16, 14, 18, 40], [10, 15, 18, 25], [12, 15, 17, 25], [11, 19, 19, 10]],
    [[7, 22, 26, 25], [9, 22, 26, 25], [13, 23, 26, 20], [11, 23, 26, 20], [17, 23, 25, 7], [20, 30, 30, 3]]
  ]
  // the keepers: name, gold for beating them and their team; their title and words are in strings
  let KP = [
    {n: "ROWAN", g: 150, tm: [[6, 6], [18, 7]]},
    {n: "MAVE", g: 300, tm: [[12, 11], [8, 11], [12, 13]]},
    {n: "NERIS", g: 450, tm: [[14, 14], [2, 15], [15, 17]]},
    {n: "BRAND", g: 600, tm: [[16, 19], [11, 20], [17, 22]]},
    {n: "ODA", g: 1000, tm: [[7, 28], [13, 28], [11, 29], [17, 30], [20, 32]]}
  ].map((k, i) => merge(k, str.keepers[i]))
  let SIGN = str.sign
  // the battle backdrop for each area: sky, far sky, ground, and the patches the kin stand on
  let BGS = [
    ["#8ad0f8", "#d8f0ff", "#7ac85a", "#5aa848"],
    ["#8ad0f8", "#d8f0ff", "#7ac85a", "#5aa848"],
    ["#4a7a6a", "#8ab8a0", "#3e7a40", "#2a5a30"],
    ["#7ac8f0", "#e0f4ff", "#e8d49a", "#d0b878"],
    ["#4a2a3a", "#a8504a", "#5a3a34", "#3e2a26"],
    ["#a8b8d8", "#e8eef8", "#e8eef8", "#c4d0e4"]
  ]
  let nsig = count(sig, s => s)

  // ---- the area ----------------------------------------------------------------------------------
  let TL = range(N).map(c => sub(MAPS[area], c, c + 1))
  let th = ATH[area]
  let PASS = TL.map(ch => ch == "." || ch == "," || ch == "=" || ch == "s" || ch == "f" || ch == "c" || (ch == "G" && nsig >= GN[area]))
  // steps from the hero to every cell, 99 past thirty-six
  let DH = reduce(range(36), (A, k) => A.map((d, c) => d < 99 ? d : PASS[c] && ((c % W > 0 && A[c - 1] == k) || (c % W < W - 1 && A[c + 1] == k) || (c >= W && A[c - W] == k) || (c < N - W && A[c + W] == k)) ? k + 1 : 99), range(N).map(c => c == hy * W + hx ? 0 : 99))
  let alive = any(party, m => m.hp > 0)

  // ---- macros: a new kin, the experience it needs, a level up ------------------------------------
  // the kin out on each side, and their names in the log


  // ---- a move: side S uses move MID on side O ----------------------------------------------------

  // ---- what the player does: a move, an item, a swap or a run -------------------------------------

  // ---- after both have acted: experience, the keeper's next kin, the end ---------------------------


  // ---- a turn --------------------------------------------------------------------------------------
  on bGo {
    if scene == "battle" && bt != null && (bphase == "menu" || bphase == "swap") && bAct != null {
      evs = []
      tq = 0.05
      bv = [party[bt.pi], bt.fo[bt.fi]]
      bdone = false
      bnext = "menu"
      sub = ""
      hint = ""
      if bAct.k == "fsw" {
        bt = merge(bt, {pi: bAct.to, st: set(bt.st, 0, [0, 0])})
        bv = [null, bt.fo[bt.fi]]
        evs = evs + [{k: "in", sd: 0, v: party[bt.pi], t: tq}]
        evs = evs + [{k: "msg", s: str.go(SP[party[bt.pi].s].n), t: tq}]
        tq = tq + 0.85
      } else {
        let fo = bt.fo[bt.fi]
        let me = party[bt.pi]
        let fm = bt.w ? fo.m[random(len(fo.m))] : fo.m.sortBy(x => -((MV[x].p == 0 ? 30 : MV[x].p * EF[MV[x].e][SP[me.s].e] * (SP[fo.s].e == MV[x].e ? 1.25 : 1)) + random(30)))[0]
        if bAct.k != "mv" || me.sp >= fo.sp {
          if bAct.k == "mv" {
            let mv3 = MV[party[bt.pi].m[bAct.i]]
            let am3 = (party[bt.pi])
            let dm3 = (bt.fo[bt.fi])
            let an3 = (SP[party[bt.pi].s].n)
            let dn3 = (bt.w ? str.wild(SP[bt.fo[bt.fi].s].n) : str.foe(SP[bt.fo[bt.fi].s].n))
            evs = evs + [{k: "msg", s: str.uses(an3, mv3.n), t: tq}, {k: "atk", sd: 0, t: tq + 0.3, e: mv3.e}]
            tq = tq + 0.85
            if mv3.p > 0 {
              if random(100) >= mv3.a {
                evs = evs + [{k: "msg", s: str.missed, t: tq}]
                tq = tq + 0.85
              } else {
                let ef3 = EF[mv3.e][SP[dm3.s].e]
                let cr3 = random(16) == 0
                let as3 = bt.st[0][0]
                let ds3 = bt.st[1][1]
                let dmg3 = max(1, floor((floor((floor(2 * am3.lv / 5) + 2) * mv3.p * (am3.at * (as3 >= 0 ? (2 + as3) / 2 : 2 / (2 - as3))) / (dm3.df * (ds3 >= 0 ? (2 + ds3) / 2 : 2 / (2 - ds3))) / 42) + 2) * (0 == 1 && bt.w ? 0.85 : 1) * (SP[am3.s].e == mv3.e ? 1.25 : 1) * ef3 * (cr3 ? 1.5 : 1) * random(85, 100) / 100))
                let nh3 = max(0, dm3.hp - dmg3)
                bt = merge(bt, {fo: set(bt.fo, bt.fi, merge(dm3, {hp: nh3}))})
                evs = evs + [{k: "hit", sd: 1, t: tq - 0.45, e: mv3.e}, {k: "hp", sd: 1, a: dm3.hp, b: nh3, t: tq - 0.4}]
                if cr3 {
                  evs = evs + [{k: "msg", s: str.crit, t: tq}]
                  tq = tq + 0.85
                }
                if ef3 > 1 {
                  evs = evs + [{k: "msg", s: str.superEff, t: tq}]
                  tq = tq + 0.85
                }
                if ef3 < 1 {
                  evs = evs + [{k: "msg", s: str.notVery, t: tq}]
                  tq = tq + 0.85
                }
                if mv3.x == 6 && am3.hp < am3.mh {
                  let gh3 = min(am3.mh - am3.hp, max(1, floor((dm3.hp - nh3) / 2)))
                  party = set(party, bt.pi, merge(am3, {hp: am3.hp + gh3}))
                  evs = evs + [{k: "hp", sd: 0, a: am3.hp, b: am3.hp + gh3, t: tq}]
                  evs = evs + [{k: "msg", s: str.drains(an3, gh3), t: tq}]
                  tq = tq + 0.85
                }
