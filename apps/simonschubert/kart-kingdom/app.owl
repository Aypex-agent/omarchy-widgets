app "kart kingdom" {
  // A go-kart attraction on an isometric plot. Start on a small field with a little cash, lay a
  // track cell by cell, with ramps, bridges over other tracks and over footpaths, and crossings, buy
  // karts, and charge guests at the gate and per session. Karts wear out as they run: repair them,
  // or hire mechanics from a workshop, before they break down. Buy more land to build more and
  // bigger tracks, shops, grandstands and gardens.
  //
  // There's no game loop. The cash is `bank` plus what the attraction makes a second times the
  // seconds since `since`, worked out from what's built. It's settled into `bank` every 20 seconds
  // and on every purchase, and a closed app earns for an hour at most. The karts' wear is added up
  // every 20 seconds from how busy each track was. Karts and guests are drawn from the clock.

  meta { owl: 23; description: "A go-kart tycoon: build your own kart tracks cell by cell with ramps, bridges and crossings, buy karts, repair them, and grow your attraction"; version: "1.2"; license: "MIT"; category: "games" }

  // panel text at 11 to 14sp beside the steppers; the three buttons in a row are about 110dp wide,
  // so their words stay short
  strings {
    en {
      kd: i => ["Snack Bar", "Drinks", "Restrooms", "Helmet Shop", "Workshop", "Grandstand", "Tyre Wall", "Tree", "Flowers", "Litter Bin", "Fountain", "Flags"][i]
      kc: i => ["Rookie", "Sport", "Pro"][i]
      tab: i => ["Track", "Shops", "Garden", "Paths", "Park"][i]
      trackName: i => ["Thunder Lane", "Apex Alley", "Rubber Ridge", "Hairpin Hollow", "Turbo Twist", "Pit Viper", "Grip Gully", "Skid Row"][i]
      exc: i => ["low", "medium", "good", "great", "superb"][i]
      diff: i => ["easy", "tricky", "hard", "wild", "brutal"][i]
      hungry: "I'm hungry"
      thirsty: "I'm thirsty"
      restroom: "I need a restroom"
      litterThought: "These paths are covered in litter"
      wantTwists: "I want a track with more twists and bridges"
      feeThought: "The entry fee is steep"
      wantSeat: "I'd love a seat to watch the races"
      pretty: "This place is really pretty"
      notPaying: (p, t) => "I'm not paying ${p} for ${t}"
      tooDangerous: t => "${t} looks too dangerous"
      sawCrash: t => "I saw a nasty crash at ${t}"
      halfBroken: t => "Half the karts at ${t} are broken"
      amazing: t => "${t} was amazing!"
      queueLong: t => "The queue for ${t} is too long"
      buyLand: "Buy this land first (Park)"
      startGround: "The start line needs clear, dry ground"
      minPieces: "A track needs at least 10 pieces"
      bringBack: "Bring the track back to the start line"
      comeDown: "Come down to level 1 first"
      carryOn: "Carry on from the end of the track"
      startStraight: "The start is 3 straight pieces"
      cellTaken: "That cell is taken"
      bridgePath: "Raise the track to level 2 to bridge a path"
      bridgeWater: "Raise the track to cross water"
      bridgeTrack: "A bridge needs 2 levels over the track below"
      builder: "Track builder"
      tapStart: "Tap clear ground for the start line"
      layMore: n => n == 1 ? "Lay 1 more straight start piece" : "Lay ${n} more straight start pieces"
      tapOpen: "Tap the start line to open the track"
      tapNext: "Tap or drag next to the gold dot"
      nextLevel: "Next piece level"
      rampsHint: "Ramps climb or drop 1 level a piece"
      aiming: h => "Aiming for ${h} · 2 levels clear a track or path"
      piecesLine: (n, spent, next) => "${n} pieces · spent ${spent} · next ${next}"
      startKarts: "The start line comes with 2 rookie karts: $700"
      undoPiece: "Undo piece"
      tapConfirm: "Tap to confirm"
      scrap: "Scrap"
      done: "Done"
      stillBuilt: "Still being built. Pick Track to carry on."
      scrapFor: c => "Scrap +${c}"
      excLine: (e, el, d, dl) => "Excitement ${e} ${el} · Difficulty ${d} ${dl}"
      statsLine: (m, lap, top, cr) => "${m} m · lap ${lap} s · top ${top} km/h · ${cr} crossing${cr == 1 ? "" : "s"}"
      allBroken: "All karts broken: repair them"
      closed: "Closed"
      noPathStart: "No path reaches the start line"
      driversLine: (n, q, c) => "${n} drivers a minute · queue ${q} · ${c}/min"
      ticket: "Ticket"
      worth: p => "worth up to ${p}"
      tooDear: "guests think it's too dear"
      karts: k => "${k} karts"
      runningLine: (n, c) => "${n} running · ${c} each"
      condition: "Condition"
      repair: c => "Repair ${c}"
      likeNew: "Like new"
      close: "Close"
      open: "Open"
      topKarts: "Top karts"
      confirm: "Confirm"
      sell: c => "Sell +${c}"
      noPathIt: "No path reaches it"
      customersLine: (n, c) => "${n} customers a minute · ${c}/min"
      guestsTooDear: "Guests think it's too dear"
      guestsPay: p => "Guests pay up to ${p}"
      price: "Price"
      mechHere: "Mechanics work from here, 3 to a workshop"
      fansWatch: "Fans watch the races and tell their friends"
      putBeside: "Put it beside a track for the fans to watch"
      tyreHint: "Beside a corner, it keeps crashes harmless"
      binHint: "Guests drop their litter in it"
      decorHint: "Decorations raise the rating"
      kartTrack: "Kart track"
      footpath: "Footpath"
      fromCost: "from $700"
      perCell: "$10 a cell"
      hintTrack: "Lay a track; tyre walls by its corners stop crashes."
      hintShops: "Shops sell to every guest. They need a path."
      hintGarden: "Gardens raise the rating; bins keep litter down."
      hintPaths: "Tap or drag on grass to lay path, tap a path to lift it."
      entryFee: "Entry fee"
      feeSteep: "too steep for this place"
      feeFair: "guests think it's fair"
      mechanics: "Mechanics"
      workshopFirst: "build a workshop first"
      coverage: (p, k) => "${p}% of ${k} karts looked after"
      handymen: "Handymen"
      litterLine: n => "${n} litter on the paths"
      land: "Land"
      landWhole: s => "${s}×${s}, the whole plot"
      landNext: (s, n) => "${s}×${s}, next ${n}×${n}"
      allYours: "All yours"
      buy: c => "Buy ${c}"
      thinking: "What the guests are thinking"
      noGuests: "No guests yet. Build a track by a path."
      happy: "Everyone's happy."
      perMin: c => "${c}/min"
      guests: "guests"
      rating: "rating"
      pickTrack: "Pick Kart track below and tap the map"
      notEnough: "Not enough cash"
      isOpen: t => "${t} is open!"
      pathsUnder: "Paths go under bridges of level 2 or more"
      noRoom: "No room here"
      layPath: "Lay a path to it from the gate"
      bestKarts: "These are the best karts there are"
      newKarts: k => "New ${k} karts!"
      maxKarts: "12 karts is the most a track takes"
      alreadyNew: "The karts are like new"
      repaired: "Karts repaired"
      needWorkshop: "Mechanics need a workshop"
      threeMech: "Each workshop takes 3 mechanics"
      hiring: "Hiring costs $300"
      moreLand: s => "More land! Now ${s}×${s}"
    }
    id {
      kd: i => ["Kedai Camilan", "Minuman", "Toilet", "Toko Helm", "Bengkel", "Tribun", "Dinding Ban", "Pohon", "Bunga", "Tempat Sampah", "Air Mancur", "Bendera"][i]
