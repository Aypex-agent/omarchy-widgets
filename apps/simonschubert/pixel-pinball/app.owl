    <rect x="112" y="104" width="56" height="8" fill="#a3a6cc"/>
    <rect x="168" y="104" width="24" height="8" fill="#5d6094"/>
    <rect x="224" y="104" width="8" height="8" fill="#ffffff"/>
    <rect x="80" y="112" width="24" height="8" fill="#d9dbf2"/>
    <rect x="104" y="112" width="56" height="8" fill="#a3a6cc"/>
    <rect x="160" y="112" width="32" height="8" fill="#5d6094"/>
    <rect x="64" y="120" width="8" height="8" fill="#bfe6ff"/>
    <rect x="80" y="120" width="8" height="8" fill="#d9dbf2"/>
    <rect x="88" y="120" width="64" height="8" fill="#a3a6cc"/>
    <rect x="152" y="120" width="40" height="8" fill="#5d6094"/>
    <rect x="88" y="128" width="48" height="8" fill="#a3a6cc"/>
    <rect x="136" y="128" width="48" height="8" fill="#5d6094"/>
    <rect x="232" y="128" width="8" height="8" fill="#3f2f99"/>
    <rect x="96" y="136" width="32" height="8" fill="#a3a6cc"/>
    <rect x="128" y="136" width="48" height="8" fill="#5d6094"/>
    <rect x="216" y="136" width="8" height="8" fill="#5a46c8"/>
    <rect x="104" y="144" width="16" height="8" fill="#a3a6cc"/>
    <rect x="120" y="144" width="48" height="8" fill="#5d6094"/>
    <rect x="200" y="144" width="8" height="8" fill="#7b5cff"/>
    <rect x="120" y="152" width="32" height="8" fill="#5d6094"/>
    <rect x="160" y="160" width="40" height="8" fill="#ff4f8b"/>
    <rect x="128" y="168" width="32" height="8" fill="#ff4f8b"/>
    <rect x="160" y="168" width="48" height="8" fill="#f4f2ff"/>
    <rect x="88" y="176" width="40" height="8" fill="#ff4f8b"/>
