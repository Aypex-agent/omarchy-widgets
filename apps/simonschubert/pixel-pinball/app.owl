  // where the film ends, and the steps until the ball stopped rolling (drained, back on the
  // plunger, or warped)
  let fin = film[359]
  let endK = count(film, f => f.st == 0)

  when !booted {
    booted = true
    if mode == "play" || mode == "pause" {
      mode = "pause"
      seg = merge(seg, {st: seg.st == 0 ? 4 : seg.st, hL: false, hR: false})
    }
  }
  // Reloading the file starts the clock again, but keeps the times kept here.
  when segT > time + 1 { segT = time }
  when msgT > time + 10 { msgT = time - 10 }
  when warpT > time + 10 { warpT = time - 10 }
  when chargeT > time + 1 { chargeT = time }
  when msgT == -1 && time != tapT { msgT = time }
  when charging && chargeT == -1 && time != tapT { chargeT = time }

  // A flipper pressed or let go, or a pause: a new film from where the ball is now. A press turns
  // the lit top lanes (and the skill shot's lane while the ball waits) the way of that flipper.
  when pend && time != tapT {
    pend = false
    let j = clamp(floor((time - segT) * 120), 0, 359)
    let b = film[j]
    let ln = rot == 1 ? [b.ln[1], b.ln[2], b.ln[0]] : rot == 2 ? [b.ln[2], b.ln[0], b.ln[1]] : b.ln
    let sk = b.st == 3 && rot == 1 ? (b.sk + 2) % 3 : b.st == 3 && rot == 2 ? (b.sk + 1) % 3 : b.sk
    let st = want == "pause" && b.st == 0 ? 4 : want == "resume" && b.st == 4 ? 0 : b.st
    seg = merge(b, {ln: ln, sk: sk, st: st, aL: (seg.hL ? max((-26), seg.aL - 12.5 * j) : min(30, seg.aL + 12.5 * j)), aR: (seg.hR ? max((-26), seg.aR - 12.5 * j) : min(30, seg.aR + 12.5 * j)), hL: Lh, hR: Rh, fk: b.fk - j, ek: b.ek - j})
    segT = time
    if want == "pause" {
      mode = "pause"
    } else if want == "resume" {
      mode = "play"
    }
    want = ""
    rot = 0
  }

  // The plunger let go: the longer it was held (up to 0.9 s), the harder the launch. Not while the
  // warp to a new table is still showing.
  when lpend && chargeT >= 0 && time != tapT {
    lpend = false
    charging = false
    let j = clamp(floor((time - segT) * 120), 0, 359)
    let b = film[j]
    if b.st == 3 && time > warpT + 2.4 {
      seg = merge(b, {st: 0, vx: 0, vy: 0 - (150 + 190 * clamp((time - chargeT) / 0.9, 0, 1)), ag: 0, sn: 0, aL: (seg.hL ? max((-26), seg.aL - 12.5 * j) : min(30, seg.aL + 12.5 * j)), aR: (seg.hR ? max((-26), seg.aR - 12.5 * j) : min(30, seg.aR + 12.5 * j)), hL: Lh, hR: Rh, fk: b.fk - j, ek: b.ek - j})
      segT = time
