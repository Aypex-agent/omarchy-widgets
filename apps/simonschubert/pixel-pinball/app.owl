    <rect x="80" y="72" width="32" height="8" fill="#ffffff"/>
    <rect x="112" y="72" width="40" height="8" fill="#d9dbf2"/>
    <rect x="152" y="72" width="40" height="8" fill="#a3a6cc"/>
    <rect x="80" y="80" width="24" height="8" fill="#ffffff"/>
    <rect x="104" y="80" width="40" height="8" fill="#d9dbf2"/>
