        path(T.outline.map(p => [X + p[0] * q, Y + p[1] * q]), stroke: TH.railD, width: 3.2 * q)
        path(T.outline.map(p => [X + p[0] * q, Y + p[1] * q]), stroke: TH.rail, width: 1.5 * q)
        path(T.outline.map(p => [X + (p[0] - 0.3) * q, Y + (p[1] - 0.35) * q]), stroke: alpha("#ffffff", 0.7), width: 0.45 * q)
        // the targets, standing out of the left wall or on a bar of their own
        if T.bank {
          path([[X + 4 * q, Y + 58 * q], [X + 8 * q, Y + 61 * q], [X + 8 * q, Y + 89 * q], [X + 4 * q, Y + 92 * q]], closed: true, fill: TH.railD)
        } else {
          let f0 = TGS[0]
          let f2 = TGS[2]
          line(X + (f0[0] - f0[4] * 2) * q, Y + (f0[1] - f0[5] * 2) * q, X + (f2[2] - f2[4] * 2) * q, Y + (f2[3] - f2[5] * 2) * q, stroke: TH.railD, width: 2.6 * q, cap: round)
          line(X + (f0[0] - f0[4] * 2) * q, Y + (f0[1] - f0[5] * 2) * q, X + (f2[2] - f2[4] * 2) * q, Y + (f2[3] - f2[5] * 2) * q, stroke: TH.rail, width: q, cap: round)
        }
        for f, i in TGS {
          path([[X + f[0] * q, Y + f[1] * q], [X + f[2] * q, Y + f[3] * q], [X + (f[2] - f[4] * 2.5) * q, Y + (f[3] - f[5] * 2.5) * q], [X + (f[0] - f[4] * 2.5) * q, Y + (f[1] - f[5] * 2.5) * q]], closed: true, fill: TH.caps[i])
          line(X + f[0] * q, Y + f[1] * q, X + f[2] * q, Y + f[3] * q, stroke: alpha("#ffffff", 0.7), width: 0.6 * q)
        }
        // the shooter lane's wall, its gate and its floor
        line(X + 92 * q, Y + 60 * q, X + 92 * q, Y + 176 * q, stroke: TH.railD, width: 2.4 * q)
        line(X + 91.6 * q, Y + 60 * q, X + 91.6 * q, Y + 176 * q, stroke: TH.rail, width: 0.8 * q)
        line(X + 92 * q, Y + 60 * q, X + 100 * q, Y + 52 * q, stroke: "#ffd23f", width: 1.4 * q, cap: round)
        rect(X + 92.5 * q, Y + 170 * q, 7.5 * q, 6 * q, fill: TH.railD)
        // the top lanes' posts
        for x in [30, 42, 54, 66] {
          line(X + (x + 0.6) * q, Y + 19 * q, X + (x + 0.6) * q, Y + 29 * q, stroke: alpha("#000000", 0.45), width: 3.4 * q, cap: round)
          line(X + x * q, Y + 18 * q, X + x * q, Y + 28 * q, stroke: TH.railD, width: 3.4 * q, cap: round)
          line(X + x * q, Y + 18 * q, X + x * q, Y + 28 * q, stroke: TH.rail, width: 1.8 * q, cap: round)
          line(X + (x - 0.4) * q, Y + 18 * q, X + (x - 0.4) * q, Y + 27 * q, stroke: alpha("#ffffff", 0.75), width: 0.5 * q, cap: round)
        }
        // the inlane guides
        for g in [GL, GR] {
          path(g.map(p => [X + p[0] * q, Y + (p[1] + 0.8) * q]), stroke: alpha("#000000", 0.45), width: 3 * q, cap: round)
          path(g.map(p => [X + p[0] * q, Y + p[1] * q]), stroke: TH.railD, width: 3 * q, cap: round)
          path(g.map(p => [X + p[0] * q, Y + p[1] * q]), stroke: TH.rail, width: 1.5 * q, cap: round)
          path(g.map(p => [X + (p[0] - 0.3) * q, Y + (p[1] - 0.35) * q]), stroke: alpha("#ffffff", 0.7), width: 0.45 * q, cap: round)
        }
        // the slingshots: plastic with a white rubber on the side that kicks
        for g in [SL, SR] {
          path(g.map(p => [X + p[0] * q, Y + (p[1] + 1) * q]), closed: true, fill: alpha("#000000", 0.5))
          path(g.map(p => [X + p[0] * q, Y + p[1] * q]), closed: true, fill: linear(X + g[0][0] * q, Y + g[0][1] * q, X + g[2][0] * q, Y + g[2][1] * q, [mix(TH.sling, "#ffffff", 0.25), TH.sling, mix(TH.sling, "#000000", 0.3)]))
          path(g.map(p => [X + p[0] * q, Y + p[1] * q]), closed: true, stroke: mix(TH.sling, "#000000", 0.55), width: 0.5 * q)
          path([[X + (g[0][0] * 0.6 + g[1][0] * 0.2 + g[2][0] * 0.2) * q, Y + (g[0][1] * 0.3 + g[1][1] * 0.4 + g[2][1] * 0.3) * q], [X + (g[0][0] * 0.2 + g[1][0] * 0.6 + g[2][0] * 0.2) * q, Y + (g[0][1] * 0.15 + g[1][1] * 0.65 + g[2][1] * 0.2) * q], [X + (g[0][0] * 0.25 + g[1][0] * 0.3 + g[2][0] * 0.45) * q, Y + (g[0][1] * 0.2 + g[1][1] * 0.35 + g[2][1] * 0.45) * q]], closed: true, fill: alpha("#000000", 0.25))
          line(X + g[0][0] * q, Y + g[0][1] * q, X + g[2][0] * q, Y + g[2][1] * q, stroke: "#ffffff", width: 1.3 * q, cap: round)
        }
        // the pop bumpers' bases; their caps light up, so they're drawn with what moves
        for p in POPS {
          circle(X + (p[0] + 0.8) * q, Y + (p[1] + 1.3) * q, (p[2] + 0.8) * q, fill: alpha("#000000", 0.55))
          circle(X + p[0] * q, Y + p[1] * q, (p[2] + 0.6) * q, fill: linear(X + (p[0] - p[2]) * q, Y + (p[1] - p[2]) * q, X + (p[0] + p[2]) * q, Y + (p[1] + p[2]) * q, ["#ffffff", TH.rail, TH.railD, "#000000"]))
          circle(X + p[0] * q, Y + p[1] * q, (p[2] - 0.5) * q, fill: TH.railD)
          circle(X + p[0] * q, Y + p[1] * q, (p[2] - 0.5) * q, stroke: TH.ring, width: 0.6 * q)
        }
        // rubber posts
        for p in T.posts {
          circle(X + p[0] * q, Y + (p[1] + 0.6) * q, p[2] * q, fill: alpha("#000000", 0.5))
          circle(X + p[0] * q, Y + p[1] * q, p[2] * q, fill: "#f4f2ff")
          circle(X + p[0] * q, Y + p[1] * q, (p[2] - 0.9) * q, fill: TH.sling)
        }
        // the black hole
        circle(X + SAU[0] * q, Y + SAU[1] * q, 6.5 * q, fill: radial(X + SAU[0] * q, Y + SAU[1] * q, 6.5 * q, [alpha("#ff4fd8", 0.55), alpha("#7b5cff", 0.25), alpha("#7b5cff", 0)]))
        circle(X + SAU[0] * q, Y + SAU[1] * q, 3.6 * q, fill: "#030108")
        circle(X + SAU[0] * q, Y + SAU[1] * q, 3.6 * q, stroke: "#c6b8ff", width: 0.7 * q)

        // the display's glass
        rect(OX, DY + 2 * q, 104 * q, 22 * q, radius: 1.5 * q, fill: "#1c0e04")
      }

      // ---- what moves and lights up, the light shows and the words ----
      Canvas {
        fill: true
        let tt = time
        let X = OX
        let Y = OY
        let j = J
        let b = B
        let blink = tt % 0.4 < 0.2
        let att = mode == "title"
        let ch = floor(tt * 7) % 12
        let parked = b.st == 3
        // what the ball hit, while it flashes and throws sparks, and where that is
        let ha = j - b.fk
        let fl = ha < 14 ? b.fb : -1
        let hp = b.fb >= 5 && b.fb < 30 ? POPS[b.fb - 5] : b.fb == 0 ? [23, 126.5] : b.fb == 1 ? [73, 126.5] : b.fb >= 2 && b.fb <= 4 ? [(TGS[b.fb - 2][0] + TGS[b.fb - 2][2]) / 2, (TGS[b.fb - 2][1] + TGS[b.fb - 2][3]) / 2] : b.fb == 30 ? SAU : b.fb >= 41 && b.fb <= 47 ? SPOTS[b.fb - 41] : null
        let hc = b.fb >= 5 && b.fb < 30 ? TH.caps[(b.fb - 5) % 3] : b.fb <= 1 ? TH.sling : b.fb <= 4 ? TH.caps[b.fb - 2] : b.fb == 30 ? "#ff4fd8" : TH.lane
        let hpts = b.fb >= 0 && b.fb < 30 ? PTS[b.fb] * b.mu : b.fb >= 41 && b.fb <= 43 ? 1000 * b.mu : b.fb >= 46 ? 500 * b.mu : 100 * b.mu
        // a big moment: a light show from where it happened
        let ea = j - b.ek
        let show = mode == "play" && ea < 160 && b.em > 0 && b.em != 5 && b.em != 6
        let ep = b.em == 3 || b.em == 7 || b.em == 8 ? SAU : b.em == 2 ? [(TGS[0][0] + TGS[2][2]) / 2, (TGS[0][1] + TGS[2][3]) / 2] : [48, 23]
        let ec = b.em == 3 ? "#ff4fd8" : b.em == 7 ? "#ffffff" : b.em == 8 ? "#7dff8a" : b.em == 1 ? "#ffd23f" : b.em == 4 ? "#38e1ff" : TH.lane
        let chase = floor(tt * 14)

        // stars that twinkle
        for s, i in take(STARS, 12) {
          rect(X + s[0] * q, Y + s[1] * q, s[2] * q, s[2] * q, fill: alpha("#ffffff", 0.9 * abs(sin(tt * (0.7 + i * 0.13) + i))))
        }

        // ---- the lamps ----
        let lamps = [
          [36, 34, 2.2, TH.lane, b.ln[0] == 1 || (parked && b.sk == 0 && blink) || fl == 41 || (att && ch == 0)],
          [48, 34, 2.2, TH.lane, b.ln[1] == 1 || (parked && b.sk == 1 && blink) || fl == 42 || (att && ch == 1)],
          [60, 34, 2.2, TH.lane, b.ln[2] == 1 || (parked && b.sk == 2 && blink) || fl == 43 || (att && ch == 2)],
          [T.tlamps[0][0], T.tlamps[0][1], 1.6, TH.caps[0], b.tg[0] == 1 || fl == 2 || (att && ch == 9)],
          [T.tlamps[1][0], T.tlamps[1][1], 1.6, TH.caps[1], b.tg[1] == 1 || fl == 3 || (att && ch == 8)],
          [T.tlamps[2][0], T.tlamps[2][1], 1.6, TH.caps[2], b.tg[2] == 1 || fl == 4 || (att && ch == 7)],
          [36, 127, 2.8, "#ffd23f", b.mu >= 2 || (att && ch == 3)],
          [44, 129, 2.8, "#ffd23f", b.mu >= 3 || (att && ch == 4)],
          [52, 129, 2.8, "#ffd23f", b.mu >= 4 || (att && ch == 5)],
          [60, 127, 2.8, "#ffd23f", b.mu >= 5 || (att && ch == 6)],
          [48, 139, 2.2, "#ff6a3d", (b.bs && (parked || (b.st == 0 && b.ag < 1200 && blink))) || (att && ch == 10)]
        ]
        for l, i in lamps {
          if l[4] || (show && (chase + i) % 4 == 0) {
            circle(X + l[0] * q, Y + l[1] * q, l[2] * 2.3 * q, fill: alpha(l[3], 0.22))
            circle(X + l[0] * q, Y + l[1] * q, l[2] * q, fill: l[3])
            rect(X + (l[0] - l[2] * 0.55) * q, Y + (l[1] - l[2] * 0.55) * q, 0.8 * q, 0.8 * q, fill: "#ffffff")
          }
        }
        // the inserts: the way to the black hole (pink for the jackpot, green and fast for the warp),
        // to the targets until they're done, under the lanes not yet lit, the warp's lamps, the
        // inlanes as the ball rolls over, and the shooter lane's power
        let p3 = floor(tt * 6) % 3
        let p3f = floor(tt * 12) % 3
        let pull0 = parked && charging && chargeT >= 0 ? clamp((tt - chargeT) / 0.9, 0, 1) : 0
        for n in T.ins {
          let on = att ? (ch + n.i + n.g) % 4 == 0
            : n.g == 0 ? (b.wp ? p3f == n.i : b.jp && p3 == n.i)
            : n.g == 1 ? b.gt || p3 == n.i
            : n.g == 2 ? b.ln[n.i] == 0 && floor(tt * 3) % 3 == n.i
            : n.g == 3 ? (b.wp ? blink : n.i < 3 ? b.gl || b.ln[n.i] == 1 : b.gt || b.tg[n.i - 3] == 1)
            : n.g == 4 ? fl == 44 + n.i
            : n.g == 5 ? (parked && (charging ? pull0 * 10 > n.i : floor(tt * 8) % 10 == n.i)) || (b.st == 0 && b.ag < 50 && (floor(tt * 24) + n.i) % 3 == 0)
            : false
          if on || (show && (chase + n.i + n.g) % 3 == 0) {
            let cc = n.g == 0 && b.wp ? "#7dff8a" : n.c
            circle(X + n.m[0] * q, Y + n.m[1] * q, 4 * q, fill: alpha(cc, 0.2))
            if n.k == 2 {
              circle(X + n.p[0] * q, Y + n.p[1] * q, n.p[2] * q, fill: cc)
              rect(X + (n.p[0] - n.p[2] * 0.5) * q, Y + (n.p[1] - n.p[2] * 0.5) * q, 0.7 * q, 0.7 * q, fill: "#ffffff")
            } else {
              path(n.p.map(p => [X + p[0] * q, Y + p[1] * q]), closed: true, fill: cc)
            }
          }
        }
        if b.wp {
          circle(X + SAU[0] * q, Y + SAU[1] * q, (5 + (tt * 12) % 6) * q, stroke: alpha("#7dff8a", 0.8 - ((tt * 12) % 6) * 0.12), width: 0.8 * q)
        }
        // the kickback's arrow in the outlane
        if b.kb || (att && ch == 11) {
          path([[X + 5 * q, Y + 150 * q], [X + 7.5 * q, Y + 144 * q], [X + 10 * q, Y + 150 * q]], closed: true, fill: fl == 46 && blink ? "#ffffff" : "#7dff8a")
        }

        // ---- the pop bumpers, the slingshots and the targets, flashing when hit ----
        for p, i in POPS {
          let hot = fl == 5 + i
          let cx = X + p[0] * q
          let cy = Y + p[1] * q
          let c = TH.caps[i % 3]
          if hot {
            circle(cx, cy, (p[2] + 3 + ha * 0.25) * q, fill: alpha(c, 0.35 - ha * 0.02))
            circle(cx, cy, (p[2] + 1 + ha * 0.5) * q, stroke: alpha("#ffffff", 0.8 - ha * 0.05), width: 0.7 * q)
          }
          circle(cx, cy, (p[2] - 1.1) * q, fill: hot ? "#ffffff" : radial(cx - p[2] * 0.35 * q, cy - p[2] * 0.4 * q, (p[2] + 0.6) * q, [TH.capsl[i % 3], c, mix(c, "#000000", 0.5)]))
          circle(cx, cy, (p[2] - 2.6) * q, stroke: alpha(hot ? c : "#ffffff", 0.6), width: 0.45 * q)
          rect(cx - 0.4 * q, cy - 1.6 * q, 0.8 * q, 3.2 * q, fill: alpha(hot ? c : "#ffffff", 0.5))
          rect(cx - 1.6 * q, cy - 0.4 * q, 3.2 * q, 0.8 * q, fill: alpha(hot ? c : "#ffffff", 0.5))
          rect(cx - (p[2] - 3.4) * q, cy - (p[2] - 2.6) * q, 1.4 * q, 0.8 * q, fill: alpha("#ffffff", 0.9))
        }
        if fl == 0 || fl == 1 {
          let g = fl == 0 ? SL : SR
          path(g.map(p => [X + p[0] * q, Y + p[1] * q]), closed: true, fill: alpha("#ffffff", 0.45))
          line(X + g[0][0] * q, Y + g[0][1] * q, X + g[2][0] * q, Y + g[2][1] * q, stroke: "#fff3a0", width: 2.2 * q, cap: round)
        }
        if fl >= 2 && fl <= 4 {
          let f = TGS[fl - 2]
          path([[X + f[0] * q, Y + f[1] * q], [X + f[2] * q, Y + f[3] * q], [X + (f[2] - f[4] * 2.5) * q, Y + (f[3] - f[5] * 2.5) * q], [X + (f[0] - f[4] * 2.5) * q, Y + (f[1] - f[5] * 2.5) * q]], closed: true, fill: alpha("#ffffff", 0.85))
        }
        if b.hk > 0 || fl == 30 {
          circle(X + SAU[0] * q, Y + SAU[1] * q, (4 + (tt * 10) % 5) * q, stroke: alpha("#ff4fd8", 0.7), width: 0.6 * q)
          circle(X + SAU[0] * q, Y + SAU[1] * q, (4 + (tt * 10 + 2.5) % 5) * q, stroke: alpha("#ffffff", 0.5), width: 0.5 * q)
        }

        // ---- sparks from what was hit ----
        if hp != null && ha < 40 && mode == "play" {
          for i in range(10) {
            let a = i * 0.628 + hash(b.fk, i) * 0.5
            let d = (10 + hash(i, b.fk) * 18) * (ha / 120) * (1.8 - ha / 60)
            let z = (1 - ha / 40) * 0.9 + 0.3
            rect(X + (hp[0] + cos(a) * d - z / 2) * q, Y + (hp[1] + sin(a) * d - z / 2) * q, z * q, z * q, fill: alpha(i % 3 == 0 ? "#ffffff" : hc, 1 - ha / 40))
          }
        }

        // ---- the light show ----
        if show {
          clip(X + 4 * q, Y, 96 * q, 176 * q) {
            for r in range(3) {
              let e2 = ea - r * 14
              if e2 > 0 && e2 < 110 {
                circle(X + ep[0] * q, Y + ep[1] * q, e2 * 1.5 * q, stroke: alpha(r == 1 ? "#ffffff" : ec, 0.8 * (1 - e2 / 110)), width: (2.6 - e2 / 50) * q)
              }
            }
            if (b.em == 3 || b.em == 7) && ea < 40 {
              rect(X, Y, 104 * q, 176 * q, fill: alpha(ec, 0.35 * (1 - ea / 40)))
            }
          }
        }

        // ---- the ball: a chrome ball and the trail it leaves ----
        let pull = parked && charging && chargeT >= 0 ? clamp((tt - chargeT) / 0.9, 0, 1) : 0
        let bx = b.x
        let by = parked ? 167.5 + pull * 4 : b.y
        if mode != "title" && by < 177 && b.st != 5 {
          if j > 6 && b.st == 0 && b.hk == 0 {
            circle(X + film[j - 6].x * q, Y + film[j - 6].y * q, 1 * q, fill: alpha("#bfe6ff", 0.1))
            circle(X + film[j - 4].x * q, Y + film[j - 4].y * q, 1.4 * q, fill: alpha("#bfe6ff", 0.16))
            circle(X + film[j - 2].x * q, Y + film[j - 2].y * q, 1.9 * q, fill: alpha("#bfe6ff", 0.26))
          }
          let br = b.hk > 0 ? 2.5 * min(1, max(0.3, b.hk / 40)) : 2.5
          circle(X + (bx + 0.7) * q, Y + (by + 0.9) * q, br * q, fill: alpha("#000000", 0.35))
          circle(X + bx * q, Y + by * q, br * q, fill: radial(X + (bx - 0.9) * q, Y + (by - 0.9) * q, 3.4 * q, ["#ffffff", "#c9cbe6", "#55588a"]))
          rect(X + (bx - 1.4) * q, Y + (by - 1.4) * q, 0.9 * q, 0.9 * q, fill: "#ffffff")
        }

        // ---- the plunger ----
        let pz = 170 + pull * 4
        rect(X + 95.6 * q, Y + pz * q, 1.8 * q, (177 - pz) * q, fill: "#9a9cc8")
        rect(X + 93.6 * q, Y + pz * q, 5.8 * q, 1.6 * q, fill: TH.sling)
        for i in range(3) { rect(X + 94.2 * q, Y + (pz + 2.4 + i * (1.6 - pull * 0.3)) * q, 4.6 * q, 0.6 * q, fill: "#c9cbe6") }

        // ---- the flippers: white, with a rubber along the top ----
        for f in [[29, 149, 1, (seg.hL ? max((-26), seg.aL - 12.5 * j) : min(30, seg.aL + 12.5 * j))], [67, 149, -1, (seg.hR ? max((-26), seg.aR - 12.5 * j) : min(30, seg.aR + 12.5 * j))]] {
          let ca = cos(f[3] * 0.0174533)
          let sa = sin(f[3] * 0.0174533)
          let ux = f[2] * ca
          let x0 = X + f[0] * q
          let y0 = Y + f[1] * q
          let x1 = x0 + ux * 15 * q
          let y1 = y0 + sa * 15 * q
          let nx = -sa * q
          let ny = ux * q
          path([[x0 + nx * 2.5, y0 + ny * 2.5 + 0.8 * q], [x1 + nx * 1.5, y1 + ny * 1.5 + 0.8 * q], [x1 - nx * 1.5, y1 - ny * 1.5 + 0.8 * q], [x0 - nx * 2.5, y0 - ny * 2.5 + 0.8 * q]], closed: true, fill: alpha("#000000", 0.35))
          let fg = linear(x0 - f[2] * nx * 2.5, y0 - f[2] * ny * 2.5, x0 + f[2] * nx * 2.5, y0 + f[2] * ny * 2.5, ["#ffffff", "#dcdcf2", "#8e90bf"])
          circle(x0, y0, 2.9 * q, fill: mix(TH.railD, "#000000", 0.3))
          path([[x0 + nx * 2.5, y0 + ny * 2.5], [x1 + nx * 1.5, y1 + ny * 1.5], [x1 - nx * 1.5, y1 - ny * 1.5], [x0 - nx * 2.5, y0 - ny * 2.5]], closed: true, fill: fg)
          circle(x0, y0, 2.5 * q, fill: fg)
          circle(x1, y1, 1.5 * q, fill: fg)
          line(x0 - f[2] * nx * 2.1, y0 - f[2] * ny * 2.1, x1 - f[2] * nx * 1.1, y1 - f[2] * ny * 1.1, stroke: TH.sling, width: 0.9 * q, cap: round)
          circle(x0, y0, 0.9 * q, fill: TH.ring)
        }

        // ---- the apron, which the ball drains under: the balls to come, and the warp's goals ----
        path([[X + 4 * q, Y + 162 * q], [X + 30 * q, Y + 162 * q], [X + 36 * q, Y + 166 * q], [X + 60 * q, Y + 166 * q], [X + 66 * q, Y + 162 * q], [X + 92 * q, Y + 162 * q], [X + 92 * q, Y + 177 * q], [X + 4 * q, Y + 177 * q]], closed: true, fill: TH.cab)
        path([[X + 4 * q, Y + 162 * q], [X + 30 * q, Y + 162 * q], [X + 36 * q, Y + 166 * q], [X + 60 * q, Y + 166 * q], [X + 66 * q, Y + 162 * q], [X + 92 * q, Y + 162 * q]], stroke: TH.sling, width: 0.8 * q)
        for i in range(3) {
          circle(X + (10 + i * 5) * q, Y + 171.5 * q, 1.5 * q, fill: (mode == "play" || mode == "pause") && i < 3 - ball ? "#c9cbe6" : alpha("#ffffff", 0.12))
        }
        for g, i in [[b.gl, TH.lane], [b.gt, "#ffd23f"], [b.wp && blink, "#7dff8a"]] {
          circle(X + (76 + i * 5) * q, Y + 171.5 * q, 1.5 * q, fill: g[0] ? g[1] : alpha("#ffffff", 0.12))
        }

        // ---- a ball lost or saved ----
        let mt = tt - msgT
        if mode == "play" && msgT >= 0 && mt < 0.7 && msg != "" {
          rect(X, Y - 2 * q, 104 * q, 180 * q, fill: alpha(msg == "BALL SAVED" ? "#7dff8a" : "#ff3d5a", 0.28 * (1 - mt / 0.7)))
        }

        // ---- the warp: stars streaking out, a white flash, and the new table ----
        let wt = tt - warpT
        if wt >= 0 && wt < 2.8 {
          let cx = SW / 2
          let cy = OY + 80 * q
          rect(0, OY - 3 * q, SW, SH - OY + 3 * q, fill: alpha("#05030c", wt < 1.2 ? min(1, wt / 0.4) * 0.92 : max(0, 0.92 * (1 - (wt - 1.2) / 1.4))))
          if wt < 1.3 {
            for i in range(44) {
              let a = (i * 8.18 + hash(i) * 6) * 0.0174533
              let ph = (wt * (0.6 + hash(i, 3) * 0.9) + hash(i, 5)) % 1
              let r0 = ph * ph * 130 * q
              let ln = (6 + wt * 50) * ph * q
              line(cx + cos(a) * r0, cy + sin(a) * r0, cx + cos(a) * (r0 + ln), cy + sin(a) * (r0 + ln), stroke: alpha(i % 3 == 0 ? "#38e1ff" : i % 3 == 1 ? "#ffffff" : "#ff4fd8", min(1, ph * 2)), width: (0.4 + ph) * q)
            }
          }
          if wt > 1.0 && wt < 1.7 {
            rect(0, 0, SW, SH, fill: alpha("#ffffff", min(1, (1 - abs(wt - 1.2) / 0.5) * 1.2)))
          }
        }

        // ---- the display's own animations, behind its words ----
        let dcy = DY + 13 * q
        clip(OX, DY + 2 * q, 104 * q, 22 * q) {
          if (b.em == 3 || b.em == 7 || b.em == 8) && show && ea < 130 {
            for i in range(32) {
              let a = i * 0.19635
              let r = ea * 0.55
              rect(OX + round(52 + cos(a) * r * 1.7) * q, DY + 2 * q + round(11 + sin(a) * r * 0.6) * q, q, q, fill: alpha(DMD, 1 - ea / 130))
            }
          } else if show {
            for i in range(20) {
              if (floor(tt * 12) + i) % 3 == 0 {
                rect(OX + floor(hash(i, b.ek) * 104) * q, DY + 2 * q + floor(hash(b.ek, i) * 22) * q, q, q, fill: alpha(DMD, 0.6))
              }
            }
          }
          if wt >= 0 && wt < 2.8 {
            for i in range(18) {
              let row = floor(hash(i, 7) * 22)
              let x = 104 - (tt * (40 + hash(i) * 90) + hash(i, 2) * 104) % 110
              rect(OX + round(x) * q, DY + 2 * q + row * q, (2 + floor(hash(i, 9) * 5)) * q, q, fill: alpha(DMD, 0.75))
            }
          }
        }

        if mode == "title" || mode == "pause" || mode == "over" {
          rect(0, OY - 3 * q, SW, SH - OY + 3 * q, fill: alpha(CAB, mode == "pause" ? 0.55 : 0.66))
        }
        // what a hit scored, rising from it
        let words = [["+${hpts}", X + (hp == null ? 0 : hp[0]) * q, Y + ((hp == null ? 0 : hp[1]) - 6 - ha / 8) * q, 0.4 * q, 0.5, alpha("#fff3c4", 1 - ha / 72), mode == "play" && hp != null && ha < 72 && b.fb != 30]]
        for w in words {
        if w[6] {
          let ix = range(len(w[0])).map(i => max(0, indexOf(ORDER, sub(w[0], i, i + 1))))
          let xs = scan(ix, (a, g) => a + ADV[g], 0)
          let x0 = OX + round((w[1] - (xs[len(xs) - 1] - 1) * w[3] * w[4] - OX) / q) * q
          for g, i in ix { sprite(GLYPHS[g], x0 + (xs[i] - ADV[g]) * w[3], w[2], w[3], fill: w[5]) }
        }
      }
      }

      // ---- the words: drawn again only when they change ----
      // The display's, and over the table the title's, the pause's and the end's, all in the
      // display's 5 by 7 dots. Each is [text, x, y of its top, dot size, where x is along it (0 its
      // start, 0.5 its middle, 1 its end), color, shown].
      Canvas {
        fill: true
        let X = OX
        let Y = OY
        let blink = tick % 4 < 2
        let DMID = OX + 52 * q
        let small = DY + 3 * q
        let big = DY + 10 * q
        let ev = WEM > 0
        let evc = blink ? "#ffe2b8" : DMD
        let page = floor(tick / 25) % 4
        let evWords = WEM == 1 ? ["MULTIPLIER", "${WMU}X"] : WEM == 2 ? ["IS LIT", "JACKPOT"] : WEM == 3 ? [fmtNum(25000 * WMU), "JACKPOT"] : WEM == 4 ? ["SHOT 10,000", "SKILL"] : WEM == 5 ? ["BLACK HOLE", fmtNum(2500 * WMU)] : WEM == 7 ? ["HYPERSPACE", "WARP!"] : WEM == 8 ? ["SHOOT THE HOLE", "WARP"] : ["", "KICKBACK"]
        let msgWords = msg == "BALL SAVED" ? ["BALL", "SAVED"] : msg == "GAME OVER" ? ["GAME", "OVER"] : ["", msg]
        let two = mode == "title" ? (page == 0 ? ["PIXEL", "PINBALL"] : page == 1 ? ["PRESS TO", "PLAY"] : page == 2 ? ["FOUR TABLES", "WARP"] : ["BEST", fmtNum(best)])
          : mode == "over" ? (floor(tick / 20) % 2 == 0 ? ["GAME", "OVER"] : ["SCORE", fmtNum(last)])
          : WARPING ? ["TABLE ${lvl + 1}", T.name] : ev ? evWords : SHOWMSG ? msgWords : mode == "pause" && blink ? ["", "PAUSED"] : null
        let sc = fmtNum(WSC)
        let pulse = alpha("#fff3c4", 0.6 + 0.3 * sin(tick * 0.4))
        let dw = [
          [two == null ? "-" : two[0], DMID, small, q, 0.5, ev ? evc : DMD, two != null && two[0] != ""],
          [two == null ? "-" : two[1], DMID, two != null && two[0] == "" ? DY + 6 * q : big, len(two == null ? "" : two[1]) > 8 ? q : 2 * q, 0.5, ev ? evc : DMD, two != null],
          [WWP ? "WARP READY" : "BALL ${ball}", OX + 2 * q, small, q, 0, alpha(DMD, 0.75), two == null && (!WWP || blink)],
          ["${WMU}X", OX + 102 * q, small, q, 1, alpha(DMD, 0.75), two == null],
          [sc, DMID, len(sc) > 9 ? DY + 12 * q : big, len(sc) > 9 ? q : 2 * q, 0.5, DMD, two == null]
        ]
        let words = [
          // the apron, and the multiplier's lamps
          [T.name, X + 48 * q, Y + 170 * q, 0.42 * q, 0.5, alpha(TH.rail, 0.7), true],
          ["2X", X + 36.2 * q, Y + 125.5 * q, 0.45 * q, 0.5, WMU >= 2 ? "#3a2200" : alpha(TH.rail, 0.45), true],
          ["3X", X + 44.2 * q, Y + 127.5 * q, 0.45 * q, 0.5, WMU >= 3 ? "#3a2200" : alpha(TH.rail, 0.45), true],
          ["4X", X + 52.2 * q, Y + 127.5 * q, 0.45 * q, 0.5, WMU >= 4 ? "#3a2200" : alpha(TH.rail, 0.45), true],
          ["5X", X + 60.2 * q, Y + 125.5 * q, 0.45 * q, 0.5, WMU >= 5 ? "#3a2200" : alpha(TH.rail, 0.45), true],
          // printed on the playfield, lit by what they name
          ["JACKPOT", X + T.jl[0] * q, Y + T.jl[1] * q, 0.35 * q, 0.5, WJP && blink ? "#ff4fd8" : WJP ? "#ffc2f2" : alpha("#ff4fd8", 0.45), true],
          ["WARP", X + 48 * q, Y + 119 * q, 0.35 * q, 0.5, WWP ? (blink ? "#7dff8a" : "#ffffff") : alpha(TH.rail, 0.5), true],
          ["SAVE", X + 48 * q, Y + 142.6 * q, 0.3 * q, 0.5, alpha("#ff6a3d", 0.75), true],
          // the title
          ["PIXEL", SW / 2 + q, OY + 30 * q, 2.6 * q, 0.5, "#120b30", mode == "title"],
          ["PIXEL", SW / 2, OY + 29 * q, 2.6 * q, 0.5, "#38e1ff", mode == "title"],
          ["PINBALL", SW / 2 + q, OY + 51 * q, 2.2 * q, 0.5, "#120b30", mode == "title"],
          ["PINBALL", SW / 2, OY + 50 * q, 2.2 * q, 0.5, "#ff4fd8", mode == "title"],
          ["PRESS TO PLAY", SW / 2, OY + 76 * q, 0.9 * q, 0.5, "#fff3c4", mode == "title" && tick % 12 < 9],
          ["BEST ${fmtNum(best)}", SW / 2, OY + 88 * q, 0.7 * q, 0.5, "#ffd23f", mode == "title" && best > 0],
          ["LEFT HALF: LEFT FLIPPER", SW / 2, OY + 104 * q, 0.55 * q, 0.5, "#b8acff", mode == "title"],
          ["RIGHT HALF: RIGHT FLIPPER", SW / 2, OY + 110 * q, 0.55 * q, 0.5, "#b8acff", mode == "title"],
          ["HOLD RIGHT, LET GO: LAUNCH", SW / 2, OY + 116 * q, 0.55 * q, 0.5, "#b8acff", mode == "title"],
          ["TAP THE DISPLAY: PAUSE", SW / 2, OY + 122 * q, 0.55 * q, 0.5, "#b8acff", mode == "title"],
          ["LANES + TARGETS LIGHT THE WARP", SW / 2, OY + 132 * q, 0.5 * q, 0.5, "#7dff8a", mode == "title"],
          ["SHOOT THE BLACK HOLE TO WARP", SW / 2, OY + 137.5 * q, 0.5 * q, 0.5, "#7dff8a", mode == "title"],
          // the pause
          ["PAUSED", SW / 2, OY + 56 * q, 2.2 * q, 0.5, "#fff3c4", mode == "pause"],
          ["PRESS TO GO ON", SW / 2, OY + 78 * q, 0.8 * q, 0.5, "#b8acff", mode == "pause" && tick % 12 < 9],
          // the end
          ["GAME OVER", SW / 2, OY + 44 * q, 1.6 * q, 0.5, "#ff4fd8", mode == "over"],
          [fmtNum(last), SW / 2, OY + 62 * q, len(fmtNum(last)) > 9 ? 1.2 * q : 1.7 * q, 0.5, "#fff3c4", mode == "over"],
          [last >= best && last > 0 ? "NEW BEST!" : "BEST ${fmtNum(best)}", SW / 2, OY + 81 * q, 0.8 * q, 0.5, "#ffd23f", mode == "over"],
          ["REACHED TABLE ${lvl + 1}", SW / 2, OY + 90 * q, 0.6 * q, 0.5, "#b8acff", mode == "over"],
          ["PRESS TO PLAY AGAIN", SW / 2, OY + 104 * q, 0.7 * q, 0.5, "#b8acff", mode == "over" && overReady && tick % 12 < 9],
          // the warp
          ["TABLE ${lvl + 1}", SW / 2 + q, OY + 66 * q, 1.2 * q, 0.5, "#120b30", WARP2],
          ["TABLE ${lvl + 1}", SW / 2, OY + 65 * q, 1.2 * q, 0.5, "#ffffff", WARP2],
          [T.name, SW / 2 + q, OY + 79 * q, 1.6 * q, 0.5, "#120b30", WARP2],
          [T.name, SW / 2, OY + 78 * q, 1.6 * q, 0.5, TH.lane, WARP2],
          // how to launch, on the first ball
          ["HOLD RIGHT, LET GO", SW / 2, OY + 106 * q, 0.6 * q, 0.5, pulse, mode == "play" && WPARK && ball == 1 && WSC == 0 && !charging && !WARPING],
          ["TO LAUNCH THE BALL", SW / 2, OY + 112 * q, 0.6 * q, 0.5, pulse, mode == "play" && WPARK && ball == 1 && WSC == 0 && !charging && !WARPING]
        ]
        clip(OX, DY + 2 * q, 104 * q, 22 * q) {
          for w in dw {
        if w[6] {
          let ix = range(len(w[0])).map(i => max(0, indexOf(ORDER, sub(w[0], i, i + 1))))
          let xs = scan(ix, (a, g) => a + ADV[g], 0)
          let x0 = OX + round((w[1] - (xs[len(xs) - 1] - 1) * w[3] * w[4] - OX) / q) * q
          for g, i in ix { sprite(GLYPHS[g], x0 + (xs[i] - ADV[g]) * w[3], w[2], w[3], fill: w[5]) }
        }
      }
        }
        for w in words {
        if w[6] {
          let ix = range(len(w[0])).map(i => max(0, indexOf(ORDER, sub(w[0], i, i + 1))))
          let xs = scan(ix, (a, g) => a + ADV[g], 0)
          let x0 = OX + round((w[1] - (xs[len(xs) - 1] - 1) * w[3] * w[4] - OX) / q) * q
          for g, i in ix { sprite(GLYPHS[g], x0 + (xs[i] - ADV[g]) * w[3], w[2], w[3], fill: w[5]) }
        }
      }
      }

      // ---- the display's dots, over its words: drawn once ----
      Canvas {
        fill: true
        let y0 = DY + 2 * q
        for i in range(1, 104) { line(OX + i * q, y0, OX + i * q, y0 + 22 * q, stroke: alpha("#1c0e04", 0.8), width: 0.32 * q) }
        for i in range(1, 22) { line(OX, y0 + i * q, OX + 104 * q, y0 + i * q, stroke: alpha("#1c0e04", 0.8), width: 0.32 * q) }
        rect(OX, y0, 104 * q, 22 * q, radius: 1.5 * q, stroke: "#4a2a10", width: 0.8 * q)
      }
    }

    // ---- the touches: the display pauses, each half of the table is a flipper ----
    Column {
      fill: true
      gap: 0
      Box {
        fill: width
        height: OY - 3 * q
        ripple: false
        onTap: {
          if mode == "play" {
            want = "pause"
            Lh = false
            Rh = false
            charging = false
            lpend = false
            pend = true
            tapT = time
          }
        }
      }
      Row {
        fill: width
        weight: 1
        gap: 0
        Box {
          weight: 1
          fill: height
          onPress: {
            if mode == "play" {
              Lh = true
              rot = 1
              pend = true
              tapT = time
              haptic()
            } else if mode == "pause" {
              want = "resume"
              pend = true
              tapT = time
            } else if mode == "title" || (mode == "over" && overReady) {
              mode = "play"
              ball = 1
              tb = 0
              lvl = 0
              seg = {x: 96.5, y: 167.5, vx: 0, vy: 0, st: 3, sc: 0, ln: [0, 0, 0], tg: [0, 0, 0], mu: 1, jp: false, kb: true, bs: true, gl: false, gt: false, wp: false, sn: 0, hk: 0, hc: 0, sk: random(3), ag: 0, fb: -1, fk: -999, em: 0, ek: -999, aL: 30, hL: false, aR: 30, hR: false}
              segT = time
              msg = "BALL 1"
              msgT = -1
              tapT = time
              haptic()
            }
          }
          onRelease: {
            if Lh {
              Lh = false
              pend = true
              tapT = time
            }
          }
        }
        Box {
          weight: 1
          fill: height
          onPress: {
            if mode == "play" {
              if seg.st == 3 {
                charging = true
                chargeT = -1
                tapT = time
                haptic()
              } else {
                Rh = true
                rot = 2
                pend = true
                tapT = time
                haptic()
              }
            } else if mode == "pause" {
              want = "resume"
              pend = true
              tapT = time
            } else if mode == "title" || (mode == "over" && overReady) {
              mode = "play"
              ball = 1
              tb = 0
              lvl = 0
              seg = {x: 96.5, y: 167.5, vx: 0, vy: 0, st: 3, sc: 0, ln: [0, 0, 0], tg: [0, 0, 0], mu: 1, jp: false, kb: true, bs: true, gl: false, gt: false, wp: false, sn: 0, hk: 0, hc: 0, sk: random(3), ag: 0, fb: -1, fk: -999, em: 0, ek: -999, aL: 30, hL: false, aR: 30, hR: false}
              segT = time
              msg = "BALL 1"
              msgT = -1
              tapT = time
              haptic()
            }
          }
          onRelease: {
            if charging {
              lpend = true
              tapT = time
            } else if Rh {
              Rh = false
              pend = true
              tapT = time
            }
          }
        }
      }
    }
  }
}
