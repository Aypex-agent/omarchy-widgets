    <rect x="96" y="184" width="88" height="8" fill="#f4f2ff"/>
    <rect x="32" y="192" width="32" height="8" fill="#ff4f8b"/>
    <rect x="64" y="192" width="104" height="8" fill="#f4f2ff"/>
    <rect x="24" y="200" width="120" height="8" fill="#f4f2ff"/>
    <rect x="24" y="208" width="96" height="8" fill="#f4f2ff"/>
    <rect x="24" y="216" width="72" height="8" fill="#f4f2ff"/>
    <rect x="32" y="224" width="40" height="8" fill="#f4f2ff"/>
    <rect x="216" y="224" width="8" height="8" fill="#ffd23f"/>
  </svg>"""

  // "title", "play", "pause" or "over"
  state mode = "title" persist
  state best = 0 persist
  state last = 0 persist
  // the ball in play, 1 to 3; the table (0 to 3), and how many warps this game
  state ball = 1 persist
  state tb = 0 persist
  state lvl = 0 persist
  state seg = {x: 96.5, y: 167.5, vx: 0, vy: 0, st: 3, sc: 0, ln: [0, 0, 0], tg: [0, 0, 0], mu: 1, jp: false, kb: true, bs: true, gl: false, gt: false, wp: false, sn: 0, hk: 0, hc: 0, sk: 1, ag: 0, fb: -1, fk: -999, em: 0, ek: -999, aL: 30, hL: false, aR: 30, hR: false} persist
  // when the film began, on the frame clock, and when the last warp did
  state segT = 0
  state warpT = -10
  state booted = false
  // the flippers held; a new film wanted (pend), with the lanes turned (rot: 1 left, 2 right) and
  // a pause or a resume (want); the touch's own time, which the next frame's has to differ from
  state Lh = false
  state Rh = false
  state pend = false
  state rot = 0
  state want = ""
  state tapT = 0
  // the plunger: held since chargeT (-1 until the next frame), and let go (lpend)
  state charging = false
  state chargeT = 0
  state lpend = false
  // a message on the display that isn't the ball's: "BALL 2", "BALL SAVED", "GAME OVER"
  state msg = ""
  state msgT = -10
  state overReady = true

  // ---- the tables --------------------------------------------------------------------------------
  // A table is 104 by 176 art pixels. Everything the ball bounces off is a collider: t 0 a wall
  // the ball can be on either side of, 1 a wall with one side (sd) to the playfield, 2 the gate at
  // the top of the shooter lane, which lets the ball out but not back, 3 a round post or bumper.
  // A wall runs from ax, ay by dx, dy (il is one over its length squared), nx, ny is its normal and
  // r its half thickness; e is how much of a hit it gives back, k how hard it kicks (bumpers and
  // slingshots), id what scores when it's hit: 0-1 the slingshots, 2-4 the targets, 5 on the pop
  // bumpers. `cells` lists, for each 8 by 8 cell, the colliders a ball in it can touch, so a step
  // only looks at a few; `pts` is what each id scores; `sau` is the black hole, the way it kicks
  // and where the ball leaves it from. The rest is for drawing: the bumpers, the targets' faces
  // and the way they face, the rubber posts, whether the targets stand out of the left wall, the
  // jackpot's arrow, the targets' lamps and the playfield's outline.
  let TABLES = [
