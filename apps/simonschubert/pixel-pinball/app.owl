    pts: [10, 10, 500, 500, 500, 100, 100, 100, 100, 100], sau: [48, 66, 0, 150, 48, 71], pops: [[48, 49, 5], [64.17, 60.75, 5], [57.99, 79.75, 5], [38.01, 79.75, 5], [31.83, 60.75, 5]], tgs: [[8, 62.52, 8, 70.15, 1, 0], [8, 71.19, 8, 78.81, 1, 0], [8, 79.85, 8, 87.48, 1, 0]], posts: [], bank: true, arrow: [[48, 72.5], [44.5, 79], [51.5, 79]], tlamps: [[13, 66.34], [13, 75], [13, 83.66]],
    outline: [[4, 176], [4, 92], [8, 89], [8, 61], [4, 58], [4, 44], [4.73, 37.4], [6.89, 31], [10.43, 25], [15.23, 19.57], [21.15, 14.89], [28, 11.09], [35.58, 8.29], [43.66, 6.58], [52, 6], [60.34, 6.58], [68.42, 8.29], [76, 11.09], [82.85, 14.89], [88.77, 19.57], [93.57, 25], [97.11, 31], [99.27, 37.4], [100, 44], [100, 176]]}
  ]
  let T = TABLES[tb]
  let COL = T.col
  let CELLS = T.cells
  let PTS = T.pts
  let SAU = T.sau

  // ---- the ball ------------------------------------------------------------------------------------
  // Each step: the table's tilt pulls the ball down and it moves, then it bounces off what it now
  // overlaps in its cell: off a wall's side, or straight out from a wall's end or a post, giving
  // back e of the hit and a bumper's or slingshot's kick. Low on the table it also meets a
  // flipper, a capsule turning about its pivot, which hits the ball as hard as it's moving where
  // they touch. Then what it ran over or into scores: the lanes it rolls over, a hit, the black
  // hole when it comes in slowly enough (it holds the ball 0.8 s and kicks it out again, or with
  // the warp lit, sends it on), and the kickback, which sends the ball back up the left outlane
  // while it's lit. Lanes all lit raise the multiplier, the targets all down light the jackpot in
  // the black hole and the kickback, and both done on a table light the warp.
  let film = scan(range(360), (s, k) =>
    ((s.st != 0)
      ? s
      : ((s.hk > 0)
        ? ((s.hk == 1)
          ? (s.wp
            ? merge(s, {hk: 0, st: 5})
