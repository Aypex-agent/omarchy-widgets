    <rect x="80" y="88" width="16" height="8" fill="#ffffff"/>
    <rect x="96" y="88" width="40" height="8" fill="#d9dbf2"/>
    <rect x="136" y="88" width="56" height="8" fill="#a3a6cc"/>
