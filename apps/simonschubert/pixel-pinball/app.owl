app "pixel pinball" {
  // Pinball in pixel art, on four tables out in space: the comet, Saturn, a nebula and a
  // supernova. Each has pop bumpers, slingshots, three top lanes, a bank of three targets, a black
  // hole that holds the ball and kicks it back, a kickback in the left outlane, and an orange
  // dot-matrix display for the score. Light the lanes and the targets, then shoot the black hole
  // to warp to the next table. Press the left or right half of the screen for that flipper; hold
  // the right half and let go to pull the plunger.
  //
  // There's no game loop, as in pocket links. The ball is worked out ahead in one go: `film` steps
  // it 120 times a second for three seconds from `seg`, with the flippers as they're held, and the
  // canvas draws the step the clock is in. A press or a let-go of a flipper starts a new film from
  // where the ball is right then (on the next frame, as a touch's own time can be off the frame
  // clock), and so does the end of a film while the ball is still in play.
  //
  // `seg` is where a film starts. Besides the ball (x, y, vx, vy) it carries everything the ball can
  // change on its way, so that's worked out in the film too: st (0 rolling, 1 drained, 2 back on the
  // plunger, 3 waiting on the plunger, 4 paused, 5 gone through the warp), sc the score, ln the top
  // lanes, tg the targets, mu the multiplier, jp the jackpot, kb the kickback, bs the ball save, gl
  // and gt the lanes and the targets done on this table, wp the warp lit, sn the lane it's on, hk
  // how long the black hole still holds it and hc until when it can't take it again, sk the lane
  // for the skill shot, ag the steps since it was launched, fb and fk what it last hit and when (to
  // flash it), em and ek the last message for the display and when; and the flippers: aL and aR
  // their angles at the start, hL and hR held or not. fk and ek count in steps of this film, so
  // they go negative for what came before it.

  meta { owl: 14; description: "Pixel art pinball on four tables in space: bumpers, slingshots, lanes, targets, a black hole that warps you to the next table, light shows and a dot-matrix score"; version: "1.0"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges">
    <rect width="256" height="256" rx="56" fill="#22175a"/>
    <rect x="104" y="24" width="8" height="8" fill="#ff4fd8"/>
    <rect x="208" y="32" width="8" height="8" fill="#bfe6ff"/>
    <rect x="120" y="40" width="32" height="8" fill="#ffffff"/>
    <rect x="40" y="48" width="8" height="8" fill="#ffffff"/>
