  when mode == "play" && fin.st == 0 && time >= segT + 359 / 120 {
    seg = merge(fin, {aL: (seg.hL ? max((-26), seg.aL - 12.5 * 359) : min(30, seg.aL + 12.5 * 359)), aR: (seg.hR ? max((-26), seg.aR - 12.5 * 359) : min(30, seg.aR + 12.5 * 359)), hL: Lh, hR: Rh, fk: fin.fk - 359, ek: fin.ek - 359})
