      notPaying: (p, n) => "Não vou pagar ${p} por ${n}"; tooIntense: n => "${n} parece intenso demais"; amazing: n => "${n} foi incrível!"; queueLong: n => "A fila de ${n} está longa demais"
      stationGround: "A estação precisa de chão livre e seco"; need8: "Uma montanha-russa precisa de pelo menos 8 peças"; bringUp: "Leve o trilho até a estação"
      comeDown: "Desça primeiro para a altura 1"; carryOn: "Continue a partir do fim do trilho"; station3: "A estação tem 3 peças retas"
