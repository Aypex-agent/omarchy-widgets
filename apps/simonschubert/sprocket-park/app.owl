app "sprocket park" {
  // A theme park on an isometric map. Lay paths from the gate, put rides and shops beside them,
  // plant gardens, and design roller coasters piece by piece: each piece climbs on a chain lift or
  // drops, and the coaster is rated by how it runs, its top speed, its biggest drop and its turns.
  //
  // There's no game loop. The cash is `bank` plus what the park makes a second times the seconds
  // since `since`, worked out from what's built: how many guests the rides and the park's rating
  // draw, how many ride each ride, what they pay, and what the shops sell. It's settled into `bank`
  // every 20 seconds and on every purchase, and a closed app earns for an hour at most. The guests
  // walking about are worked out from the clock: each one picks a ride or a shop for every round of
  // 26 seconds and walks there along the paths and back.

  meta { owl: 16; description: "An isometric theme park tycoon: lay paths, open shops and rides, and design your own roller coasters piece by piece, with drops, climbs and ratings"; version: "1.1"; license: "MIT"; category: "games" }

  strings {
    en {
      kd: i => ["Carousel", "Spinning Cups", "Big Wheel", "Swing Tower", "Burger Bar", "Lemonade", "Balloons", "Restrooms", "Tree", "Flowers", "Litter Bin", "Fountain"][i]
      tab: i => ["Rides", "Shops", "Garden", "Paths", "Park"][i]
      exc: i => ["low", "medium", "good", "great", "superb"][i]; int: i => ["gentle", "mild", "thrilling", "intense", "extreme"][i]
      hungry: "I'm hungry"; thirsty: "I'm thirsty"; restroom: "I need a restroom"; litter: "These paths are covered in litter"
      thrill: "I want something more thrilling"; steep: "The entry fee is steep"; pretty: "This park is really pretty"
      notPaying: (p, n) => "I'm not paying ${p} for ${n}"; tooIntense: n => "${n} looks too intense"; amazing: n => "${n} was amazing!"; queueLong: n => "The queue for ${n} is too long"
      stationGround: "The station needs clear, dry ground"; need8: "A coaster needs at least 8 pieces"; bringUp: "Bring the track up to the station"
      comeDown: "Come down to height 1 first"; carryOn: "Carry on from the end of the track"; station3: "The station is 3 straight pieces"
      taken: "That cell is taken"; raise: "Raise the track to cross water"
      workshop: "Coaster workshop"; tapGround: "Tap clear ground for the station"; layMore: n => "Lay ${n} more straight station piece${n == 1 ? "" : "s"}"
      tapStation: "Tap the station to open the ride"; tapNext: "Tap or drag next to the gold dot"; nextHeight: "Next piece height"
      climbs: "Climbs go up 1 a piece, drops down 2"; aiming: h => "Aiming for ${h} · up 1 or down 2 a piece"; pieces: (n, s, x) => "${n} pieces · spent ${s} · next ${x}"
      undo: "Undo piece"; confirm: "Tap to confirm"; scrap: "Scrap"; done: "Done"; stillBuilding: "Still being built. Pick Coaster to carry on."
      ratings: (e, el, i, il) => "Excitement ${e} ${el} · Intensity ${i} ${il}"; topSpeed: (s, d, l) => "Top speed ${s} km/h · drop ${d} m · ${l} m long"
      noPathStation: "No path reaches the station"; noPathIt: "No path reaches it"; closed: "Closed"
      ridersMin: (r, q, c) => "${r} riders a minute · queue ${q} · ${c}/min"; customersMin: (r, c) => "${r} customers a minute · ${c}/min"
      tooDear: "Guests think it's too dear"; payUpTo: p => "Guests pay up to ${p}"; binInfo: "Guests drop their litter in it"; gardenInfo: "Gardens raise the park's rating"
      ticket: "Ticket price"; price: "Price"; worth: p => "worth up to ${p}"; tooDearL: "guests think it's too dear"
      close: "Close"; open: "Open"; sell: c => "Sell +${c}"; coaster: "Coaster"; footpath: "Footpath"; fromCost: "from $150"; perCell: "$10 a cell"
      hint: i => ["Rides go next to a path. Pick Coaster to design one.", "Shops sell to every guest in the park.", "Gardens raise the rating; bins keep litter down.", "Tap or drag on grass to lay path, tap a path to lift it."][i]
      entryFee: "Entry fee"; tooSteep: "too steep for this park"; fair: "guests think it's fair"; handymen: "Handymen"; litterOn: n => "${n} litter on the paths"
      thinking: "What the guests are thinking"; noGuests: "No guests yet. Build a ride by a path."; happy: "Everyone's happy."
      noCash: "Not enough cash"; isOpen: n => "${n} is open!"; noRoom: "No room here"; layPath: "Lay a path to it from the gate"; hiring: "Hiring costs $300"
      guests: "guests"; rating: "rating"; park: "Park"; pickRide: "Pick a ride below and tap the map"
    }
    id {
      kd: i => ["Komidi Putar", "Cangkir Putar", "Bianglala", "Menara Ayun", "Kedai Burger", "Limun", "Balon", "Toilet", "Pohon", "Bunga", "Tempat Sampah", "Air Mancur"][i]
      tab: i => ["Wahana", "Toko", "Kebun", "Jalan", "Taman"][i]
      exc: i => ["rendah", "sedang", "bagus", "hebat", "luar biasa"][i]; int: i => ["santai", "ringan", "seru", "intens", "ekstrem"][i]
      hungry: "Aku lapar"; thirsty: "Aku haus"; restroom: "Aku perlu toilet"; litter: "Jalannya penuh sampah"
      thrill: "Aku mau yang lebih seru"; steep: "Tiket masuknya mahal"; pretty: "Taman ini indah sekali"
      notPaying: (p, n) => "Aku nggak mau bayar ${p} untuk ${n}"; tooIntense: n => "${n} kelihatan terlalu ekstrem"; amazing: n => "${n} luar biasa!"; queueLong: n => "Antrean ${n} terlalu panjang"
      stationGround: "Stasiun butuh tanah kosong yang kering"; need8: "Roller coaster butuh minimal 8 potong"; bringUp: "Bawa lintasan kembali ke stasiun"
      comeDown: "Turun dulu ke tinggi 1"; carryOn: "Lanjutkan dari ujung lintasan"; station3: "Stasiun terdiri dari 3 potong lurus"
      taken: "Petak itu sudah terpakai"; raise: "Naikkan lintasan untuk menyeberangi air"
      workshop: "Bengkel roller coaster"; tapGround: "Ketuk tanah kosong untuk stasiun"; layMore: n => "Pasang ${n} potong stasiun lurus lagi"
      tapStation: "Ketuk stasiun untuk membuka wahana"; tapNext: "Ketuk atau seret di samping titik emas"; nextHeight: "Tinggi potongan berikut"
      climbs: "Naik 1 per potong, turun 2"; aiming: h => "Menuju ${h} · naik 1 atau turun 2 per potong"; pieces: (n, s, x) => "${n} potong · terpakai ${s} · berikut ${x}"
      undo: "Batalkan"; confirm: "Konfirmasi"; scrap: "Bongkar"; done: "Selesai"; stillBuilding: "Masih dibangun. Pilih Roller Coaster untuk lanjut."
      ratings: (e, el, i, il) => "Keseruan ${e} ${el} · Intensitas ${i} ${il}"; topSpeed: (s, d, l) => "Kecepatan ${s} km/j · turunan ${d} m · panjang ${l} m"
      noPathStation: "Tidak ada jalan ke stasiun"; noPathIt: "Tidak ada jalan ke sini"; closed: "Tutup"
      ridersMin: (r, q, c) => "${r} penumpang per menit · antre ${q} · ${c}/mnt"; customersMin: (r, c) => "${r} pembeli per menit · ${c}/mnt"
      tooDear: "Menurut tamu terlalu mahal"; payUpTo: p => "Tamu mau bayar sampai ${p}"; binInfo: "Tamu membuang sampah di sini"; gardenInfo: "Kebun menaikkan rating taman"
      ticket: "Harga tiket"; price: "Harga"; worth: p => "layak sampai ${p}"; tooDearL: "menurut tamu terlalu mahal"
      close: "Tutup"; open: "Buka"; sell: c => "Jual +${c}"; coaster: "Roller Coaster"; footpath: "Jalan setapak"; fromCost: "mulai $150"; perCell: "$10 per petak"
      hint: i => ["Wahana dipasang di samping jalan. Pilih Roller Coaster untuk merancang.", "Toko menjual ke semua tamu di taman.", "Kebun menaikkan rating; tempat sampah mengurangi sampah.", "Ketuk atau seret di rumput untuk membuat jalan, ketuk jalan untuk mengangkatnya."][i]
      entryFee: "Tiket masuk"; tooSteep: "terlalu mahal untuk taman ini"; fair: "menurut tamu wajar"; handymen: "Petugas kebersihan"; litterOn: n => "${n} sampah di jalan"
      thinking: "Apa yang dipikirkan tamu"; noGuests: "Belum ada tamu. Bangun wahana di samping jalan."; happy: "Semua senang."
      noCash: "Uang tidak cukup"; isOpen: n => "${n} sudah buka!"; noRoom: "Tidak ada tempat di sini"; layPath: "Buat jalan ke sini dari gerbang"; hiring: "Merekrut butuh $300"
      guests: "tamu"; rating: "rating"; park: "Taman"; pickRide: "Pilih wahana di bawah lalu ketuk peta"
    }
    es {
      kd: i => ["Tiovivo", "Tazas Locas", "Noria", "Sillas Voladoras", "Hamburguesería", "Limonada", "Globos", "Aseos", "Árbol", "Flores", "Papelera", "Fuente"][i]
      tab: i => ["Juegos", "Tiendas", "Jardín", "Caminos", "Parque"][i]
      exc: i => ["baja", "media", "buena", "genial", "sublime"][i]; int: i => ["suave", "leve", "emocionante", "intensa", "extrema"][i]
      hungry: "Tengo hambre"; thirsty: "Tengo sed"; restroom: "Necesito un baño"; litter: "Los caminos están llenos de basura"
      thrill: "Quiero algo más emocionante"; steep: "La entrada es cara"; pretty: "Este parque es precioso"
      notPaying: (p, n) => "No pienso pagar ${p} por ${n}"; tooIntense: n => "${n} me parece demasiado fuerte"; amazing: n => "¡${n} ha sido increíble!"; queueLong: n => "La cola de ${n} es demasiado larga"
      stationGround: "La estación necesita suelo libre y seco"; need8: "Una montaña rusa necesita al menos 8 piezas"; bringUp: "Lleva la vía hasta la estación"
      comeDown: "Baja primero a altura 1"; carryOn: "Sigue desde el final de la vía"; station3: "La estación son 3 piezas rectas"
      taken: "Esa casilla está ocupada"; raise: "Sube la vía para cruzar el agua"
      workshop: "Taller de montañas rusas"; tapGround: "Toca suelo libre para la estación"; layMore: n => n == 1 ? "Pon 1 pieza recta más de estación" : "Pon ${n} piezas rectas más de estación"
      tapStation: "Toca la estación para abrir la atracción"; tapNext: "Toca o arrastra junto al punto dorado"; nextHeight: "Altura de la siguiente pieza"
      climbs: "Sube 1 por pieza, baja 2"; aiming: h => "Hacia ${h} · sube 1 o baja 2 por pieza"; pieces: (n, s, x) => "${n} piezas · gastado ${s} · siguiente ${x}"
      undo: "Deshacer"; confirm: "Confirmar"; scrap: "Desmontar"; done: "Listo"; stillBuilding: "Aún en obras. Elige Montaña rusa para seguir."
      ratings: (e, el, i, il) => "Emoción ${e} ${el} · Intensidad ${i} ${il}"; topSpeed: (s, d, l) => "Velocidad máx. ${s} km/h · caída ${d} m · ${l} m de largo"
      noPathStation: "Ningún camino llega a la estación"; noPathIt: "Ningún camino llega aquí"; closed: "Cerrado"
      ridersMin: (r, q, c) => "${r} viajeros por minuto · cola ${q} · ${c}/min"; customersMin: (r, c) => "${r} clientes por minuto · ${c}/min"
      tooDear: "A los visitantes les parece caro"; payUpTo: p => "Los visitantes pagan hasta ${p}"; binInfo: "Los visitantes tiran aquí su basura"; gardenInfo: "Los jardines suben la valoración del parque"
      ticket: "Precio del viaje"; price: "Precio"; worth: p => "vale hasta ${p}"; tooDearL: "a los visitantes les parece caro"
      close: "Cerrar"; open: "Abrir"; sell: c => "Vender +${c}"; coaster: "Montaña rusa"; footpath: "Camino"; fromCost: "desde $150"; perCell: "$10 la casilla"
      hint: i => ["Las atracciones van junto a un camino. Elige Montaña rusa para diseñar una.", "Las tiendas venden a todos los visitantes.", "Los jardines suben la valoración; las papeleras reducen la basura.", "Toca o arrastra sobre la hierba para poner camino; toca un camino para quitarlo."][i]
      entryFee: "Entrada"; tooSteep: "demasiado cara para este parque"; fair: "a los visitantes les parece justa"; handymen: "Barrenderos"; litterOn: n => "basura en los caminos: ${n}"
      thinking: "Lo que piensan los visitantes"; noGuests: "Aún no hay visitantes. Construye una atracción junto a un camino."; happy: "Todos están contentos."
      noCash: "No tienes bastante dinero"; isOpen: n => "¡${n} abre!"; noRoom: "No hay sitio aquí"; layPath: "Haz un camino hasta aquí desde la entrada"; hiring: "Contratar cuesta $300"
      guests: "visitantes"; rating: "valoración"; park: "Parque"; pickRide: "Elige una atracción abajo y toca el mapa"
    }
    pt {
      kd: i => ["Carrossel", "Xícaras Malucas", "Roda-Gigante", "Chapéu Mexicano", "Hamburgueria", "Limonada", "Balões", "Banheiros", "Árvore", "Flores", "Lixeira", "Fonte"][i]
      tab: i => ["Brinquedos", "Lojas", "Jardim", "Caminhos", "Parque"][i]
      exc: i => ["baixa", "média", "boa", "ótima", "incrível"][i]; int: i => ["suave", "leve", "emocionante", "intensa", "extrema"][i]
