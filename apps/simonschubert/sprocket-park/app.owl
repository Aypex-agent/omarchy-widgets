      entryFee: "Entrada"; tooSteep: "cara demais para este parque"; fair: "os visitantes acham justa"; handymen: "Faxineiros"; litterOn: n => "lixo nos caminhos: ${n}"
      thinking: "O que os visitantes estão pensando"; noGuests: "Nenhum visitante ainda. Construa um brinquedo ao lado de um caminho."; happy: "Todos estão felizes."
