0\nf 118 119 123 122\nf 120 124 123 119\nf 125 128 127 126\nf 129 130 131 132\nf 125 129 132 128\nf 126 127 131 130\nf 128 132 131 127\nf 133 136 135 134\nf 137 138 139 140\nf 133 137 140 136\nf 134 135 139 138\nf 136 140 139 135\nf 141 144 143 142\nf 145 146 147 148\nf 141 145 148 144\nf 142 143 147 146\nf 144 148 147 143\nf 149 152 151 150\nf 153 154 155 156\nf 149 153 156 152\nf 150 151 155 154\nf 152 156 155 151", MAT)
  // The whale breaches every 16 s; between, it lies at the surface and blows now and then.
  let wc = (gt % 16) / 16
  let breach = wc < 0.17
  let wt = wc / 0.17
  // A ring: a tube of 6 sides bent round 16 times.
  let M_RING = mesh(
    flatten(range(16).map(i => range(6).map(j => [(1 + 0.12 * cos(rad(j * 60))) * cos(rad(i * 22.5)), (1 + 0.12 * cos(rad(j * 60))) * sin(rad(i * 22.5)), 0.12 * sin(rad(j * 60))]))),
    flatten(range(16).map(i => range(6).map(j => [i * 6 + j, (i + 1) % 16 * 6 + j, (i + 1) % 16 * 6 + (j + 1) % 6, i * 6 + (j + 1) % 6])))
  )

  // The balloon drifts round the valley, slowly.
  let BAL = [-25 + 70 * cos(gt * 1.3), 74 + 3 * sin(gt * 9), 30 + 70 * sin(gt * 1.3)]

  // The camera: behind the glider and a little above, leaning a little into its turns, never under the ground.
  let cF = [-sin(rad(camH)), -cos(rad(camH))]
  let camRoll = rad(bank * 0.35)
  // after a landing the camera rises and draws back over the spot
  let up = mode == "landed" ? clamp(gt - landedAt, 0, 2.5) / 2.5 : 0
  let camD = mode == "title" ? 16 : 7.5 + up * 9
  let eyeX = px - cF[0] * camD
  let eyeZ = pz - cF[1] * camD
  let eyeY = max(py + (mode == "title" ? 6 : 2.4 + up * 10), [[clamp((eyeX) / 5 + 48, 0, 95.999), clamp((eyeZ) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0] + 2)
  let cam = {
    eye: [eyeX, eyeY, eyeZ],
    look: [px + cF[0] * (8 + up * 30), py + 0.2 + pit * 0.04 + up * 4, pz + cF[1] * (8 + up * 30)],
    up: [-sin(camRoll) * cF[1], cos(camRoll), sin(camRoll) * cF[0]],
    fov: 62, near: 0.3, far: 240
  }
  // What's close enough and not behind a hill, from the camera: worked out five times a second, in this order.
  let SEEN_T = [0.25, 0.5, 0.75, 0.9]
  let TARGETS = PLACES.map(p => [p.at[0], p.at[1] + 6, p.at[2]]) + RINGS.map(r => [r[0], r[1], r[2]]) + THERMALS.map(t => [t[0], CB, t[1]]) + SECRETS.map(p => [p.at[0], p.at[1] + 3, p.at[2]])
  let NT = len(THERMALS)
  let NP = len(PLACES)
  let NR = len(RINGS)

  let km = flown * 4 / 1000

  // The goal: every place in the valley. The tag points to the nearest one not found yet (once all are, the
  // nearest not seen on this flight).
  let NAMES = PLACES.map(p => [p.id, p.name]) + [["balloon", "the balloon"]]
  let ALLP = PLACES.map(p => {id: p.id, name: p.name, x: p.at[0], z: p.at[2]}) + [{id: "balloon", name: "the balloon", x: BAL[0], z: BAL[2]}]
  // and the rings: the tag leads to the nearest ring or place not caught yet; once every one is, to what this
  // flight hasn't caught, for all of them in one flight
  let allDone = len(seen) >= NPLACES && len(ringsSeen) >= len(RINGS)
  // The rings are a course round the valley, in order: the tag leads to the first one this flight hasn't caught,
  // and once they're all caught, to the nearest place not found yet.
  let nextRing = range(NR).find(k => !any(got, g => g == k))
  let todo = ALLP.filter(p => allDone ? !any(trip, t => t == p.id) : !any(seen, s => s == p.id))
  let next = nextRing != null
    ? [RINGS[nextRing]].map(r => {x: r[0], z: r[2], y: r[1], name: "ring ${nextRing + 1} of ${NR}"})[0]
    : todo.sortBy(p => (p.x - px) * (p.x - px) + (p.z - pz) * (p.z - pz))[0]
  let nextRel = next == null ? 0 : ((deg(atan2(px - next.x, pz - next.z)) - camH) % 360 + 540) % 360 - 180
  let nextM = next == null ? 0 : round(dist([next.x, next.z], [px, pz]) * 0.4) * 10

  every frame {
    if !still {
      gt = gt + dt
      if gt >= visAt || gt < visAt - 1 {
        visAt = gt + 0.2
        vis = TARGETS.map(o => dist([o[0], o[2]], [eyeX, eyeZ]) < 250 && all(SEEN_T, t => [[clamp((eyeX + (o[0] - eyeX) * t) / 5 + 48, 0, 95.999), clamp((eyeZ + (o[2] - eyeZ) * t) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0] < eyeY + (o[1] - eyeY) * t))
      }
      if mode == "title" {
        // On the title the glider circles in the warm air over the village by itself.
        let a = gt * 0.16
        px = THERMALS[1][0] + 34 * cos(a)
        pz = THERMALS[1][1] + 34 * sin(a)
        py = 64 + 3 * sin(gt * 0.4)
        hd = 180 - deg(a)
        bank = 16
        pit = -2
        camH = hd + 18
      }
      if mode == "fly" {
        let ix = tilted ? clamp((m.x - restX) * 2, -1, 1) : stickX
        let iy = tilted ? clamp((m.y - restY) * 2.8, -1, 1) : stickY
        // Too slow and the nose drops by itself.
        let tp = v < 6 ? -12 : iy * 24 - 3
        bank = bank + (ix * 42 - bank) * min(1, 2.2 * dt)
        pit = pit + (tp - pit) * min(1, 1.6 * dt)
        // Far from the middle of the valley, the air turns it home.
        let home = clamp(max(abs(px) - 190, abs(pz) - 205) / 30, 0, 1)
        let toHome = ((deg(atan2(px, pz)) - hd) % 360 + 540) % 360 - 180
        hd = hd - deg(9.8 * tan(rad(bank)) / max(v, 4)) * dt + toHome * home * 0.9 * dt
        v = clamp(v + (-9.8 * sin(rad(pit)) * 0.55 + (10.5 - v) * 0.25) * dt, 3, 26)
        let gy = [[clamp((px) / 5 + 48, 0, 95.999), clamp((pz) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0]
        // Warm air under the clouds, strongest in the middle and fading toward the cloud base.
        let warm = sum(THERMALS.map(t => [(px - t[0]) * (px - t[0]) + (pz - t[1]) * (pz - t[1])].map(d2 => d2 < t[2] * t[2] ? t[3] * (1 - d2 * d2 / (t[2] * t[2] * t[2] * t[2])) : 0)[0])) * clamp((CB - 6 - py) / 12, 0, 1)
        // The sea wind blows north and rises up the slopes it meets.
        let hN = max([[clamp((px) / 5 + 48, 0, 95.999), clamp((pz - 6) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0], [[clamp((px) / 5 + 48, 0, 95.999), clamp((pz - 12) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0])
        let ridge = clamp((hN - max(gy, 0)) / 9, 0, 1.2) * 1.9 * clamp(1 - (py - hN) / 30, 0, 1)
        let sink = 0.5 + 0.016 * (v - 10) * (v - 10) + abs(bank) / 42 * 0.45 + (gy < 0.5 ? 0.25 : 0)
        // once the tank runs dry it needs a moment before it pushes again
        boosting = holding && (boosting ? fuel > 0 : fuel > 0.08)
        if boosting {
          v = min(v + 9 * dt, 24)
          fuel = max(0, fuel - dt / 3)
        } else {
          fuel = min(1, fuel + dt / 10)
        }
        let vy = v * sin(rad(pit)) - sink + warm + ridge + (boosting ? 3.2 : 0)
        let hv = v * cos(rad(pit))
        let nx = px - sin(rad(hd)) * hv * dt
        let nz = pz - cos(rad(hd)) * hv * dt
        let ny = min(py + vy * dt, CB - 2)
        let ng = [[clamp((nx) / 5 + 48, 0, 95.999), clamp((nz) / 5 + 48, 0, 95.999)]].map(f => [[floor(f[0]), floor(f[1]), f[0] - floor(f[0]), f[1] - floor(f[1])]].map(q => q[3] >= q[2] ? HM[q[1]][q[0]] + q[3] * (HM[q[1] + 1][q[0]] - HM[q[1]][q[0]]) + q[2] * (HM[q[1] + 1][q[0] + 1] - HM[q[1] + 1][q[0]]) : HM[q[1]][q[0]] + q[2] * (HM[q[1]][q[0] + 1] - HM[q[1]][q[0]]) + q[3] * (HM[q[1] + 1][q[0] + 1] - HM[q[1]][q[0] + 1]))[0])[0]
        px = nx
        pz = nz
        py = max(ny, ng + 0.3)
        vario = vario + (vy - vario) * min(1, 2 * dt)
        air = air + (warm + ridge - air) * min(1, 2 * dt)
        flown = flown + hv * dt
        aloft = aloft + dt
        camH = camH + (((hd - camH) % 360 + 540) % 360 - 180) * min(1, 2.4 * dt)

        // Rings within reach of the glider.
        let ringHit = range(len(RINGS)).filter(k => !any(got, g => g == k) && abs(RINGS[k][0] - px) < 7 && abs(RINGS[k][2] - pz) < 7 && dist([RINGS[k][0], RINGS[k][1], RINGS[k][2]], [px, py, pz]) < 6.6)
        if len(ringHit) > 0 {
          got = got + ringHit
          ringWasNew = any(ringHit, k => !any(ringsSeen, g => g == k))
          ringNew = ringNew + count(ringHit, k => !any(ringsSeen, g => g == k))
          ringsSeen = unique(ringsSeen + ringHit)
          ringAt = gt
          // a ring gives a burst of speed, to spend on height
          v = min(v + 5 * len(ringHit), 22)
          haptic("light")
        }
        // Places: close by and not far above; the arch only by flying under it, the balloon wherever it is.
        let placeHit = PLACES.filter(p => !any(trip, t => t == p.id) && (p.id == "arch" ? dist([p.at[0], 5, p.at[2]], [px, py, pz]) < 8 : dist([p.at[0], p.at[2]], [px, pz]) < 16 && py - p.at[1] < 30))
          + (!any(trip, t => t == "balloon") && dist(BAL, [px, py, pz]) < 13 ? [{id: "balloon", name: "the balloon"}] : [])
        if len(placeHit) > 0 {
          trip = trip + placeHit.map(p => p.id)
          note = placeHit[0].name
          noteNew = !any(seen, s => s == placeHit[0].id)
          noteSecret = false
          noteAt = gt
          seen = unique(seen + placeHit.map(p => p.id))
          haptic("medium")
        }
        let secretHit = SECRETS.filter(p => !any(trip, t => t == p.id) && dist([p.at[0], p.at[2]], [px, pz]) < p.r && py - p.at[1] < p.h)
        if len(secretHit) > 0 {
          trip = trip + secretHit.map(p => p.id)
          note = secretHit[0].name
          noteNew = !any(secretsSeen, s => s == secretHit[0].id)
          noteSecret = true
          noteAt = gt
          secretsSeen = unique(secretsSeen + secretHit.map(p => p.id))
          haptic("medium")
        }

        if ny <= ng + 0.3 {
          let cell = CQ[clamp(floor(pz / 5 + 48), 0, 95)][clamp(floor(px / 5 + 48), 0, 95)]
          let land = LANDS[cell]
          landedOn = land == "sea" ? "splashdown in the sea" : land == "lake" ? "splashdown in the lake" : land == "beach" ? "landed on the beach" : land == "field" ? "landed in a field" : land == "meadow" ? "landed in a meadow" : land == "forest" ? "landed in the treetops" : land == "snow" ? "landed in the snow" : land == "village" ? "landed on a roof" : "landed on the rocks"
          mode = "landed"
          landedAt = gt
          flights = flights + 1
          bestKm = max(bestKm, flown * 4 / 1000)
          bestRings = max(bestRings, len(got))
          haptic("strong")
        }
      }
      if mode == "fly" && !tilted {
        stickX = stickX * pow(0.4, dt)
        stickY = stickY * pow(0.4, dt)
      }
    }
  }

  Box {
    fill: true
    background: HAZE
    Canvas {
      fill: true
      clip: true
      ripple: false
      // The sky: blue overhead, fading to the fog's haze at the horizon (where the camera's level line meets the
      // screen, tilted as the camera leans), so the world's far edge melts into it.
      let hz = project([eyeX + cF[0] * 2000, eyeY, eyeZ + cF[1] * 2000], cam, width, height)
      let hy = hz == null ? height * 0.5 : hz.y
      rotate(deg(camRoll), width / 2, hy) {
        rect(-width, hy - height * 2, width * 3, height * 2, fill: linear(0, hy - height * 0.75, 0, hy, [SKY_TOP, HAZE]))
      }
      let sun = project([eyeX - 600, eyeY + 420, eyeZ - 500], cam, width, height)
      if sun != null {
        circle(sun.x, sun.y, 90, fill: alpha(#fff6d8, 0.25))
        circle(sun.x, sun.y, 30, fill: #fffaf0)
      }
      // The sea, under everything, out past the end of the map.
      scene(cam, fog: HAZE, light: [-0.5, 0.9, -0.4], ambient: 0.42) {
        model(SEA, at: [round(eyeX / 40) * 40, -3, round(eyeZ / 40) * 40], scale: 960, color: PAL[0])
      }
      scene(cam, fog: HAZE, light: [-0.5, 0.9, -0.4], ambient: 0.42) {
        for c in CHUNKS {
          if (c.x - eyeX) * (c.x - eyeX) + (c.z - eyeZ) * (c.z - eyeZ) < 280 * 280 && (c.x - eyeX) * cF[0] + (c.z - eyeZ) * cF[1] > -48 {
            model(c.m, at: [c.x, 0, c.z], scale: 5)
          }
        }
      }
      scene(cam, fog: HAZE, light: [-0.5, 0.9, -0.4], ambient: 0.5) {
        for p, k in PLACES {
          if vis[k] == true {
            if p.id == "lighthouse" { model(M_LIGHT, at: p.at) }
            if p.id == "windmill" {
              model(M_MILL, at: p.at, turn: [0, 200, 0])
              model(M_SAILS, at: [p.at[0] + sin(rad(200)) * 2.75, p.at[1] + 7.4, p.at[2] + cos(rad(200)) * 2.75], turn: [0, 200, gt * 40], twoSided: true)
            }
            if p.id == "castle" { model(M_CASTLE, at: p.at, turn: [0, 12, 0]) }
            if p.id == "arch" { model(M_ARCH, at: p.at, turn: [0, 90, 0]) }
            if p.id == "hut" { model(M_HUT, at: p.at, turn: [0, 30, 0]) }
            if p.id == "church" {
              model(M_VILLAGE, at: VILLAGE_AT)
              model(M_CHURCH, at: p.at, turn: [0, 8, 0])
            }
          }
        }
        for r, k in RINGS {
          if mode != "title" && vis[NP + k] == true && !any(got, g => g == k) {
            model(M_RING, at: [r[0], r[1], r[2]], turn: [0, r[3] + gt * 20, 0], scale: 5.6, color: any(ringsSeen, g => g == k) ? #f3ead2 : GOLD, ambient: 0.75, twoSided: true)
          }
        }
        if dist([BAL[0], BAL[2]], [eyeX, eyeZ]) < 250 {
          model(M_BALLOON, at: BAL, turn: [0, gt * 6, 0])
        }
        for t, k in THERMALS {
          if vis[NP + NR + k] == true {
            model(M_CLOUD, at: [t[0], CB + 2, t[1]], scale: [t[2] * 0.8, t[2] * 0.36, t[2] * 0.8], ambient: 0.8)
          }
        }
        for p, k in SECRETS {
          if vis[NP + NR + NT + k] == true {
            if p.id == "wreck" { model(M_WRECK, at: [p.at[0], p.at[1] + 0.4, p.at[2]], turn: [4, 35, 16]) }
            if p.id == "stones" { model(M_STONES, at: p.at) }
            if p.id == "ufo" { model(M_UFO, at: [p.at[0], p.at[1] + sin(gt * 1.1) * 1.5, p.at[2]], turn: [0, gt * 50, 5 * sin(gt * 0.7)], ambient: 0.7) }
            if p.id == "whale" {
              if breach {
                model(M_WHALE, at: [p.at[0], -5 + 11 * sin(wt * 180 * 0.01745), p.at[2] + (0.5 - wt) * 14], turn: [-60 * cos(wt * 180 * 0.01745), 0, 0], twoSided: true)
              } else {
                model(M_WHALE, at: [p.at[0], -3.6, p.at[2]], twoSided: true)
                if gt % 5 < 1.3 {
                  model(M_SPOUT, at: [p.at[0], -2.2, p.at[2] - 4], scale: [1, 0.4 + (gt % 5) * 0.6, 1], ambient: 0.85, twoSided: true)
                }
              }
            }
          }
        }
        for t, k in THERMALS.take(6) {
          for b in [0, 1] {
            model(M_BIRD, at: [t[0] + 9 * cos(gt * 0.5 + k + b * 3), 52 + k * 5 + b * 7, t[1] + 9 * sin(gt * 0.5 + k + b * 3)], turn: [0, -deg(gt * 0.5 + k + b * 3), 18], scale: 1, twoSided: true)
          }
        }
      }
      if mode != "landed" || gt - landedAt < 1 {
        scene(cam, light: [-0.5, 0.9, -0.4], ambient: 0.6) {
          model(M_GLIDER, at: [px, py, pz], turn: [pit + sin(gt * 5.3) * air * 0.8, hd, -bank + sin(gt * 7.1) * air * 1.6], scale: 1.3, twoSided: true, smooth: false)
        }
      }
      onDrag: {
        if mode == "fly" && !tilted {
          stickX = clamp(stickX + dx / 90, -1, 1)
          stickY = clamp(stickY + dy / 110, -1, 1)
        }
      }
      onPress: {
        if mode == "fly" {
          holding = true
          if fuel > 0.08 { haptic("light") }
        }
      }
      onRelease: { holding = false }
      onTap: {
        if mode == "title" || (mode == "landed" && gt - landedAt > 1.2) {
          fuel = 1
          holding = false
          boosting = false
          mode = "fly"
          px = LAUNCH[0]
          py = LAUNCH[1]
          pz = LAUNCH[2]
          hd = LAUNCH[3]
          camH = LAUNCH[3]
          bank = 0
          pit = -3
          v = 10.5
          vario = 0
          got = []
          ringNew = 0
          ringAt = -10
          trip = []
          flown = 0
          aloft = 0
          note = ""
          stickX = 0
          stickY = 0
          restX = tilted ? clamp(m.x, -0.4, 0.4) : 0
          restY = tilted ? clamp(m.y, -0.3, 0.95) : 0
        }
      }
    }

    // While flying: almost nothing, the height, how fast it climbs or sinks, the rings, and a place just found.
    if mode == "fly" {
      Canvas {
        fill: true
        let alt = round(py * 4)
        let vs = round(vario * 4, 1)
        let vt = (vs >= 0 ? "+" : "") + fixed(vs, 1)
        text("${alt} m", 19, TOP + 15, size: 21, font: HAND, color: alpha(INK, 0.55))
        text("${alt} m", 18, TOP + 14, size: 21, font: HAND, color: PAPER)
        text(vt, 19, TOP + 39, size: 17, font: HAND, color: alpha(INK, 0.55))
        text(vt, 18, TOP + 38, size: 17, font: HAND, color: vs >= 0 ? #c9f0b4 : #ffd0bd)
        // the rings caught, all flights together, on a tag that jumps at each catch; and a word over the glider
        let pop = 1 + 0.35 * clamp(1 - (gt - ringAt) * 2.5, 0, 1)
        scale(pop, pop, width - 52, TOP + 20) {
          rotate(2, width - 52, TOP + 20) {
            rect(width - 96, TOP - 2, 84, 46, fill: PAPER)
            circle(width - 74, TOP + 21, 11, stroke: GOLD, width: 4.5)
            text("${len(ringsSeen)}", width - 44, TOP + 13, size: 22, font: HAND, color: INK, align: center)
            text("of ${NR}", width - 44, TOP + 33, size: 13, font: HAND, color: alpha(INK, 0.6), align: center)
          }
        }
        if gt - ringAt < 1.4 {
          let rp = gt - ringAt
          let ra = clamp(min(rp * 6, (1.4 - rp) * 3), 0, 1)
          let rw = ringWasNew ? "new ring!  ${len(ringsSeen)} of ${NR}" : "+1 ring"
          text(rw, width / 2 + 1, height * 0.36 - rp * 40 + 1, size: 30, font: HAND, color: alpha(INK, 0.5 * ra), align: center)
          text(rw, width / 2, height * 0.36 - rp * 40, size: 30, font: HAND, color: alpha(ringWasNew ? GOLD : PAPER, ra), align: center)
        }
        // while it boosts, wind streaks fly out past the glider
        if boosting {
          let gp = project([px, py, pz], cam, width, height)
          if gp != null {
            for i in range(10) {
              let a = rad(i * 36 + 17)
              let d = 60 + (gt * 520 + i * 61) % 240
              line(gp.x + cos(a) * d, gp.y + sin(a) * d * 0.7, gp.x + cos(a) * (d + 34), gp.y + sin(a) * (d + 34) * 0.7, stroke: alpha(white, 0.8), width: 2.5, cap: round)
            }
          }
        }
        // the boost's tank, at the bottom: a ring that empties while held and fills again
        let gx = width / 2
        let gy = height - BOT - 58
        let ready = fuel >= 1 && !boosting
        circle(gx, gy, 24, fill: alpha(INK, 0.25))
        arc(gx, gy, 24, 0, 360, stroke: alpha(PAPER, 0.35), width: 4)
        arc(gx, gy, 24, 0, fuel * 360, stroke: ready ? PAPER : alpha(PAPER, 0.8), width: ready ? 4 + sin(gt * 5) * 1.2 : 4, cap: round)
        line(gx - 10, gy - 6, gx + 7, gy - 6, stroke: ready ? PAPER : alpha(PAPER, 0.5), width: 2.5, cap: round)
        line(gx - 12, gy, gx + 10, gy, stroke: ready ? PAPER : alpha(PAPER, 0.5), width: 2.5, cap: round)
        line(gx - 7, gy + 6, gx + 5, gy + 6, stroke: ready ? PAPER : alpha(PAPER, 0.5), width: 2.5, cap: round)
        if ready {
          text("hold for a boost", gx + 1, gy + 41, size: 15, font: HAND, color: alpha(INK, 0.55), align: center)
          text("hold for a boost", gx, gy + 40, size: 15, font: HAND, color: PAPER, align: center)
        }
        // the tag to the next place: an arrow turned the way to fly, its name and how far
        if next != null {
          let cx = width / 2
          let nd = nextM >= 1000 ? "${fixed(nextM / 1000, 1)} km" : "${nextM} m"
          let nh = next.y == null ? "" : (next.y > py + 6 ? " · higher" : (next.y < py - 6 ? " · lower" : ""))
          rotate(-1.5, cx - 10, TOP + 20) {
            rect(cx - 92, TOP - 2, 166, 46, fill: PAPER)
            rotate(-nextRel, cx - 70, TOP + 21) {
              path([[cx - 70, TOP + 7], [cx - 61, TOP + 31], [cx - 70, TOP + 26], [cx - 79, TOP + 31]], closed: true, fill: #c8463a)
            }
            text(next.name, cx + 6, TOP + 12, size: 18, font: HAND, color: INK, align: center)
            text(nd + nh, cx + 6, TOP + 31, size: 14, font: HAND, color: alpha(INK, 0.65), align: center)
          }
        }
      }
      if note != "" && gt - noteAt < 4 {
        Column {
          fill: width
          align: center
          padding: [0, TOP + 70, 0, 0]
          opacity: clamp(min((gt - noteAt) * 3, (4 - (gt - noteAt)) * 1.5), 0, 1)
          Column {
            align: center
            gap: 0
            padding: [18, 6]
            background: PAPER
            rotation: -2
            Text { text: note; font: HAND; fontSize: 28; color: INK; align: center }
            Text { text: noteSecret ? (noteNew ? "a secret! ${len(secretsSeen)} of ${NS} found" : "a secret, found before") : (noteNew ? "a new place - ${len(seen)} of ${NPLACES} found" : "${len(seen)} of ${NPLACES} found"); font: HAND; fontSize: 15; color: alpha(INK, 0.7); align: center }
          }
        }
      }
    }

    if mode == "title" {
      Column {
        fill: true
        align: center
        padding: [24, TOP + 60, 24, BOT + 36]
        Column {
          align: center
          gap: 0
          padding: [30, 8, 30, 12]
          width: min(W - 56, 360)
          background: PAPER
          rotation: -3
          Text { text: "Glider"; font: HAND; fontSize: 64; color: INK; align: center }
          Text { text: tilted ? "tilt to steer, lean forward to dive" : "drag to steer, down to climb"; font: HAND; fontSize: 17; color: alpha(INK, 0.75); align: center }
        }
        Spacer { weight: 1 }
        Column {
          align: center
          gap: 2
          padding: [22, 10]
          width: min(W - 56, 360)
          background: PAPER
          rotation: 1.5
          Text { text: "tap to launch"; font: HAND; fontSize: 30; color: INK; align: center }
          Text { text: allDone ? "every ring and place is yours. now fly the whole course in one go" : "fly the ring course round the valley: ${NR} rings, ${NPLACES} places"; font: HAND; fontSize: 19; color: INK; align: center }
          Spacer { height: 2 }
          Canvas {
            width: NR * 19
            height: 22
            for k in range(NR) {
              if any(ringsSeen, g => g == k) {
                circle(9.5 + k * 19, 11, 7, stroke: GOLD, width: 3.5)
                if any(got, g => g == k) && false { circle(9.5 + k * 19, 11, 3, fill: #c8463a) }
              } else {
                circle(9.5 + k * 19, 11, 7, stroke: alpha(INK, 0.25), width: 2)
              }
            }
          }
          Text { text: "${len(ringsSeen)} of ${NR} rings caught" + (bestRings > 0 ? " · most in one flight ${bestRings}" : ""); font: HAND; fontSize: 15; color: alpha(INK, 0.7); align: center }
          Spacer { height: 4 }
          Flow {
            gap: 10
            justify: center
            for n in NAMES {
              Text { text: (any(seen, s => s == n[0]) ? "✓ " : "· ") + n[1]; font: HAND; fontSize: 15; color: any(seen, s => s == n[0]) ? #2f7a3b : alpha(INK, 0.55) }
            }
          }
          Text { text: len(secretsSeen) == 0 ? "and ${NS} secrets hide off the course" : "secrets: " + join(SECRETS.map(p => any(secretsSeen, x => x == p.id) ? p.name : "?"), " · "); font: HAND; fontSize: 15; color: len(secretsSeen) > 0 ? #7a4fa0 : alpha(INK, 0.55); align: center }
          Spacer { height: 4 }
          Text { text: "the tag at the top leads to the next ring. when it says higher, circle in the warm air under a cloud to climb. the cliffs hold you up too. rings give a burst of speed, and holding a finger down boosts"; font: HAND; fontSize: 14; color: alpha(INK, 0.7); align: center }
          if flights > 0 {
            Text { text: "best flight ${fixed(bestKm, 1)} km"; font: HAND; fontSize: 14; color: alpha(INK, 0.6); align: center }
          }
        }
      }
    }

    if mode == "landed" {
      Column {
        fill: true
        align: center
        justify: center
        padding: [24, TOP, 24, BOT]
        Column {
          align: center
          gap: 4
          padding: [28, 14]
          width: min(W - 48, 380)
          background: PAPER
          rotation: -1.5
          Text { text: landedOn; font: HAND; fontSize: 34; color: INK; align: center }
          Text { text: "${fixed(km, 1)} km in ${floor(aloft / 60)}:${pad(floor(aloft % 60), 2, "0")}"; font: HAND; fontSize: 22; color: INK; align: center }
          Text { text: "${len(got)} " + (len(got) == 1 ? "ring" : "rings") + " this flight" + (ringNew > 0 ? ", ${ringNew} new" : ""); font: HAND; fontSize: 22; color: INK; align: center }
          Canvas {
            width: NR * 19
            height: 22
            for k in range(NR) {
              if any(ringsSeen, g => g == k) {
                circle(9.5 + k * 19, 11, 7, stroke: GOLD, width: 3.5)
                if any(got, g => g == k) && true { circle(9.5 + k * 19, 11, 3, fill: #c8463a) }
              } else {
                circle(9.5 + k * 19, 11, 7, stroke: alpha(INK, 0.25), width: 2)
              }
            }
          }
          Text { text: len(ringsSeen) >= NR ? "all ${NR} rings caught" + (len(got) >= NR ? ", in one flight!" : " · most in one flight ${bestRings}") : "${len(ringsSeen)} of ${NR} rings caught"; font: HAND; fontSize: 16; color: alpha(INK, 0.7); align: center }
          if len(trip) > 0 {
            Text { text: "saw " + join(trip.map(t => t == "balloon" ? "the balloon" : (PLACES + SECRETS).find(p => p.id == t).name), ", "); font: HAND; fontSize: 18; color: alpha(INK, 0.8); align: center }
          }
          Text { text: "${len(seen)} of ${NPLACES} places found"; font: HAND; fontSize: 16; color: alpha(INK, 0.6); align: center }
          Spacer { height: 6 }
          Text { text: "tap to fly again"; font: HAND; fontSize: 20; color: #c8463a; align: center }
        }
      }
    }
  }
}
