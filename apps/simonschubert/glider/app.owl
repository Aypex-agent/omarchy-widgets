  let M_UFO = parseObj("v 0 -0.90 1.20\nv 0.60 -0.90 1.04\nv 1.04 -0.90 0.60\nv 1.20 -0.90 0\nv 1.04 -0.90 -0.60\nv 0.60 -0.90 -1.04\nv 0 -0.90 -1.20\nv -0.60 -0.90 -1.04\nv -1.04 -0.90 -0.60\nv -1.20 -0.90 -0\nv -1.04 -0.90 0.60\nv -0.60 -0.90 1.04\nv 0 0 4.40\nv 2.20 0 3.81\nv 3.81 0 2.20\nv 4.40 0 0\nv 3.81 0 -2.20\nv 2.20 0 -3.81\nv 0 0 -4.40\nv -2.20 0 -3.81\nv -3.81 0 -2.20\nv -4.40 0 -0\nv -3.81 0 2.20\nv -2.20 0 3.81\nv 0 0 4.40\nv 2.20 0 3.81\nv 3.81 0 2.20\nv 4.40 0 0\nv 3.81 0 -2.20\nv 2.20 0 -3.81\nv 0 0 -4.40\nv -2.20 0 -3.81\nv -3.81 0 -2.20\nv -4.40 0 -0\nv -3.81 0 2.20\nv -2.20 0 3.81\nv 0 0.50 3.20\nv 1.60 0.50 2.77\nv 2.77 0.50 1.60\nv 3.20 0.50 0\nv 2.77 0.50 -1.60\nv 1.60 0.50 -2.77\nv 0 0.50 -3.20\nv -1.60 0.50 -2.77\nv -2.77 0.50 -1.60\nv -3.20 0.50 -0\nv -2.77 0.50 1.60\nv -1.60 0.50 2.77\nv 0 -0.90 1.20\nv 0.60 -0.90 1.04\nv 1.04 -0.90 0.60\nv 1.20 -0.90 0\nv 1.04 -0.90 -0.60\nv 0.60 -0.90 -1.04\nv 0 -0.90 -1.20\nv -0.60 -0.90 -1.04\nv -1.04 -0.90 -0.60\nv -1.20 -0.90 -0\nv -1.04 -0.90 0.60\nv -0.60 -0.90 1.04\nv 0 -0.90 0\nv 0 0.50 2\nv 1.18 0.50 1.62\nv 1.90 0.50 0.62\nv 1.90 0.50 -0.62\nv 1.18 0.50 -1.62\nv 0 0.50 -2\nv -1.18 0.50 -1.62\nv -1.90 0.50 -0.62\nv -1.90 0.50 0.62\nv -1.18 0.50 1.62\nv 0 1.60 1.40\nv 0.82 1.60 1.13\nv 1.33 1.60 0.43\nv 1.33 1.60 -0.43\nv 0.82 1.60 -1.13\nv 0 1.60 -1.40\nv -0.82 1.60 -1.13\nv -1.33 1.60 -0.43\nv -1.33 1.60 0.43\nv -0.82 1.60 1.13\nv 0 1.60 1.40\nv 0.82 1.60 1.13\nv 1.33 1.60 0.43\nv 1.33 1.60 -0.43\nv 0.82 1.60 -1.13\nv 0 1.60 -1.40\nv -0.82 1.60 -1.13\nv -1.33 1.60 -0.43\nv -1.33 1.60 0.43\nv -0.82 1.60 1.13\nv 0 2.40 0\nv -0.25 -0.05 4.05\nv 0.25 -0.05 4.05\nv 0.25 0.35 4.05\nv -0.25 0.35 4.05\nv -0.25 -0.05 4.55\nv 0.25 -0.05 4.55\nv 0.25 0.35 4.55\nv -0.25 0.35 4.55\nv 2.79 -0.05 2.79\nv 3.29 -0.05 2.79\nv 3.29 0.35 2.79\nv 2.79 0.35 2.79\nv 2.79 -0.05 3.29\nv 3.29 -0.05 3.29\nv 3.29 0.35 3.29\nv 2.79 0.35 3.29\nv 4.05 -0.05 -0.25\nv 4.55 -0.05 -0.25\nv 4.55 0.35 -0.25\nv 4.05 0.35 -0.25\nv 4