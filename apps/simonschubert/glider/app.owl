app "glider" {
  meta { owl: 23; description: "A calm 3D glide: tilt to fly a paper glider over a valley, ride the warm air under the clouds and along the sea cliffs, and find rings and places"; version: "1.0"; license: "MIT"; category: "games" }
  // How it works: the valley is a 96 x 96 heightmap made once by a script (its heights in quarter units and a
  // colour for every cell are the two big lists below), cut into 8 x 8 terrain() chunks, of which only those
  // near the camera and in front of it are drawn; the fog hides where they end. The ground's height under any
  // point is worked out from the same triangles the launcher builds, so the glider lands where it touches.
  //
  // `every frame` flies the glider: tilting the phone sideways banks it and the bank turns it, leaning it
  // forward dives (faster, lower), back climbs (slower, until it stalls and the nose drops). It always sinks a
  // little, and rises in thermals, the columns of warm air under each cloud, and where the sea wind meets a
  // slope (the cliffs, the hills facing south). Rings and places count when it passes close; the places
  // found stay found. Things in the air or on the ground are hidden while a hill stands between them and the
  // camera, since scenes have no depth buffer.
  title: ""
  statusBar: false
  edge: true
  fps: mode == "fly" ? 60 : (modes.saver ? 15 : 30)
  source modes = android.modes
  source m = android.motion
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <defs>
      <linearGradient id="s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5f9fd6"/><stop offset="1" stop-color="#cfe3ec"/></linearGradient>
      <clipPath id="c"><rect width="256" height="256" rx="56"/></clipPath>
    </defs>
    <g clip-path="url(#c)">
      <rect width="256" height="256" fill="url(#s)"/>
      <path d="M0 186L52 150L96 170L150 128L206 160L256 140V256H0Z" fill="#6c9f4c"/>
      <path d="M0 214L70 190L130 206L196 186L256 200V256H0Z" fill="#a7c46a"/>
      <path d="M0 236L256 222V256H0Z" fill="#d8c46a"/>
      <path d="M150 52a16 16 0 0 1 30 -4a14 14 0 0 1 22 14h-60a10 10 0 0 1 8 -10z" fill="#ffffff"/>
      <path d="M52 132L206 76L120 150Z" fill="#ffffff"/>
      <path d="M120 150L206 76L132 176Z" fill="#d6d0c2"/>
      <path d="M120 150L132 176L112 160Z" fill="#b9b2a2"/>
    </g>
  </svg>"""

  // "title", "fly" or "landed"
  state mode = "title"
  state gt = 0
  // the glider: where, heading (degrees, 0 flies toward -z, 90 toward -x), bank, pitch and speed (units a second)
  state px = 0
  state py = 60
  state pz = 0
  state hd = 0
  state bank = 0
  state pit = -3
  state v = 10
  state vario = 0
  // how much the air is lifting it, smoothed: the wings wobble in it
  state air = 0
  // the boost: it pushes while a finger is down, from a tank that empties in 3 s and fills again in 10 s
  state fuel = 1
  state holding = false
  state boosting = false
  // the camera's heading, which follows the glider's a moment behind
  state camH = 0
  // the tilt that counts as level, taken at launch; the finger's stick on a phone without a motion sensor
  state restX = 0
  state restY = 0.6
  state stickX = 0
  state stickY = 0
  // this flight: rings passed, places found, distance, time in the air, how it ended
  state got = []
  state trip = []
  state flown = 0
  state aloft = 0
  state landedOn = ""
  state landedAt = 0
  // the last place found, shown for a few seconds
  state note = ""
  state noteNew = false
  state noteSecret = false
  state noteAt = -10
  // every place ever found, and the best flights
  state seen = [] persist
  // every ring ever caught (by number), and the last catch, for the flourish
  state ringsSeen = [] persist
  // the secrets found: things off the course, kept quiet on the title until they're found
  state secretsSeen = [] persist
  state ringAt = -10
  state ringWasNew = false
  state ringNew = 0
  state bestKm = 0 persist
  state bestRings = 0 persist
  state flights = 0 persist
  // set by the store's screenshots (screens.txt) to hold a scene still while it's drawn
  state still = false
  state vis = []
  state visAt = 0

  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let BOT = screenInset ?? 0
  let tilted = m.available == true
  let HAND = "https://raw.githubusercontent.com/google/fonts/main/ofl/patrickhand/PatrickHand-Regular.ttf"
  let INK = #2d3b4e
  let PAPER = #f7f2e6
  let SKY_TOP = #6fa6d8
  let HAZE = #d5e5ec
  let GOLD = #f2b84b

  // The valley, from the script: heights in quarter units from -4, one row per 5 units of z, north (-z) first.
  let HQ = [
