    off: ["#8e88ac", "#5a5474", "#443e5c", "#221e36"],
    dim: ["#7e7a94", "#56526a", "#44405a", "#26223a"]
  }
  // a button's pixel, in dp
  let BP = 3
  // the banner's ribbon by what it says
  let RIB = {OGRE: ["#e0484a", "#8a1f2a"], BAT: ["#9a5ae0", "#4a2a7a"], CLEAR: ["#4fbf55", "#1f6a2c"]}
  // small icons for the panels, in sprite letters
  let ICONPAL = {o: INK, Z: "#ffffff", S: "#b7b3c4", s: "#7d7891", Y: "#ffd34e", y: "#c8902a", T: "#b07a45", C: "#9ff0ff", c: "#3fb6e6", U: "#ffb35a", u: "#e8782a", V: "#d7a8ff", v: "#8a4fe0"}
  let swordIcon = """
