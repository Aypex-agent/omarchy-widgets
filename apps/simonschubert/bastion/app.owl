app "bastion" {
  // An endless tower defense in pixel art. Monsters pour out of a rift and wind down the road to
  // the keep; archers, cannons, frost spires and tesla coils on the grass stop them. Every tower
  // can be upgraded without end, and every wave is a little stronger than the last.
  //
  // There's no game loop. `film` plays the battle forward from `base`, the state at `ev`, in
  // steps of DT game seconds, a little over a second ahead; the canvas draws the step the clock
  // is in, sliding the monsters between steps. Once a second, and whenever a tower is built,
  // upgraded or sold, the step that has been reached becomes the new `base`.

  meta { owl: 14; description: "An endless pixel-art tower defense: build archers, cannons, frost spires and tesla coils along a winding road and upgrade them without end"; version: "1.1.1"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath>
    <g clip-path="url(#t)">
    <rect width="256" height="256" fill="#2b2140"/>
    <rect y="64" width="256" height="64" fill="#4a2f5e"/>
    <rect y="128" width="256" height="48" fill="#7a3f68"/>
    <rect y="176" width="256" height="80" fill="#5a9e45"/>
    <rect y="188" width="256" height="68" fill="#4e9140"/>
    <rect x="0" y="212" width="256" height="20" fill="#c9a46c"/>
    </g>
    <rect x="68" y="118" width="120" height="108" fill="#1e1726"/>
    <rect x="116" y="34" width="12" height="60" fill="#1e1726"/>
    <rect x="104" y="82" width="48" height="12" fill="#1e1726"/>
    <rect x="92" y="94" width="72" height="12" fill="#1e1726"/>
    <rect x="80" y="106" width="96" height="12" fill="#1e1726"/>
    <rect x="56" y="130" width="144" height="12" fill="#1e1726"/>
    <rect x="128" y="34" width="12" height="12" fill="#1e1726"/>
    <rect x="152" y="46" width="12" height="12" fill="#1e1726"/>
    <rect x="164" y="58" width="12" height="12" fill="#1e1726"/>
    <rect x="80" y="142" width="96" height="36" fill="#b07a45"/>
    <rect x="104" y="94" width="48" height="36" fill="#d24a3c"/>
    <rect x="80" y="118" width="96" height="12" fill="#d24a3c"/>
    <rect x="92" y="106" width="72" height="12" fill="#d24a3c"/>
    <rect x="80" y="190" width="96" height="24" fill="#b7b3c4"/>
    <rect x="80" y="178" width="96" height="12" fill="#a8803a"/>
    <rect x="140" y="106" width="24" height="24" fill="#962f2f"/>
    <rect x="140" y="94" width="12" height="12" fill="#962f2f"/>
    <rect x="164" y="118" width="12" height="12" fill="#962f2f"/>
    <rect x="128" y="46" width="24" height="24" fill="#e8c06a"/>
    <rect x="152" y="58" width="12" height="12" fill="#e8c06a"/>
    <rect x="104" y="190" width="12" height="12" fill="#7d7891"/>
    <rect x="152" y="190" width="12" height="12" fill="#7d7891"/>
    <rect x="128" y="202" width="12" height="12" fill="#7d7891"/>
    <rect x="164" y="202" width="12" height="12" fill="#7d7891"/>
    <rect x="164" y="142" width="12" height="36" fill="#7d5232"/>
    <rect x="92" y="154" width="12" height="12" fill="#2a2238"/>
    <rect x="152" y="154" width="12" height="12" fill="#2a2238"/>
  </svg>"""

  source now = clock every 1s

  // "title", "play" or "over"
  state mode = "title" persist
  state best = 0 persist
  // each tower: its cell, kind, level and the gold spent on it (for selling)
  state towers = [] persist
  // the battle at ev: game time, monsters, tower cooldowns, the shots and deaths of its last
  // step, gold, lives and the next monster's id
  state base = {t: 0, es: [], cd: [], sh: [], dd: [], lk: [], gold: 200, lives: 20, nid: 0} persist
  state ev = 0
  state wave = 0 persist
  // the game time the next wave comes at; 0 while one is on
  state nextAt = 0 persist
  state speed = 1 persist
  // the selected cell, or -1
  state sel = -1
  state overT = 0
  // a banner across the field, and when it went up
  state msg = ""
  state msgT = -99
  // where a finger is down, so the button under it shows pressed
  state downAt = [-1, -1]
  // the field's rows, fixed when a game starts so that turning the phone keeps every tower in place
  state grows = 0 persist

  // ---- the screen, in dp ------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  // Clear of a camera cutout and the navigation bar, and of the screen's rounded corners, which
  // Android doesn't tell an app about: the top bar keeps 12 dp from the edge and 14 dp from the
  // sides, the panel at least 16 dp from the bottom.
  let TOP = max(screenTop ?? 0, 12)
  let INS = max(screenInset ?? 0, 16)
  let HUD = 40
  let FY = TOP + HUD + 4

  // ---- the field --------------------------------------------------------------------------------
  // 9 cells across, and as many rows (13 to 18) as the screen has room for beside the panel: below
  // the field and 150 dp high, or in landscape (LS) right of it and 220 dp wide, where the field
  // lies on its side. The road runs between these cell centres, in from the rift above the top row
  // to the keep's gate; it's laid out for 13 rows, and on a longer field its rows spread out.
  let LS = SW > SH
  let COLS = 9
  let FIT = LS ? clamp(floor((SW - 244) / floor((SH - FY - INS - 4) / COLS)), 13, 18) : clamp(floor((SH - FY - INS - 158) / floor((SW - 8) / COLS)), 13, 18)
  let ROWS = mode == "title" || grows < 13 ? FIT : grows
  let C = floor(LS ? min((SH - FY - INS - 4) / COLS, (SW - 244) / ROWS) : min((SW - 8) / COLS, (SH - FY - INS - 158) / ROWS))
  let WP = [[1, -1], [1, 2], [7, 2], [7, 5], [4, 5], [4, 8], [1, 8], [1, 11], [8, 11]].map(p => [p[0], p[1] <= 0 ? p[1] : round(p[1] * (ROWS - 1) / 12)])
  let segs = scan(range(len(WP) - 1), (a, i) => {
    ax: WP[i][0], ay: WP[i][1], bx: WP[i + 1][0], by: WP[i + 1][1],
    ux: sign(WP[i + 1][0] - WP[i][0]), uy: sign(WP[i + 1][1] - WP[i][1]),
    s: a.e, e: a.e + abs(WP[i + 1][0] - WP[i][0]) + abs(WP[i + 1][1] - WP[i][1])
  }, {e: 0})
  let PL = last(segs).e
  let pathCells = unique(flatten(segs.map(g => range(g.e - g.s + 1).map(k => (g.ay + g.uy * k) * COLS + g.ax + g.ux * k)))).filter(c => c >= 0)
  let trees = [[3, 0], [8, 0], [0, 6], [8, 8], [5, 12], [0, 12]].map(p => [p[0], round(p[1] * (ROWS - 1) / 12)])
  let rocks = [[0, 3], [6, 12]].map(p => [p[0], round(p[1] * (ROWS - 1) / 12)])
  // the pond's top row, and the keep's
  let PR = round(7 * (ROWS - 1) / 12)
  let KY = last(WP)[1]
  let pond = [[6, PR], [7, PR], [6, PR + 1], [7, PR + 1]]
  let blocked = pathCells + (trees + rocks + pond + [[8, KY - 1]]).map(p => p[1] * COLS + p[0])
  // grass tufts and flowers, in art pixels: [x, y, kind]
  let tufts = range(COLS * ROWS).filter(c => indexOf(blocked, c) < 0 && hash(c, 7) < 0.75).map(c => [c % COLS * 12 + 1 + floor(hash(c, 8) * 8), floor(c / COLS) * 12 + 2 + floor(hash(c, 9) * 7), hash(c, 10) < 0.3 ? 1 + floor(hash(c, 11) * 3) : 0])
  let pebbles = range(30).map(i => [hash(i, 21) * PL, floor(hash(i, 22) * 7) - 3]).map(z => [segs.find(g => z[0] <= g.e)].map(g => [floor((g.ax + g.ux * (z[0] - g.s)) * 12 + 5 + abs(g.uy) * z[1]), floor((g.ay + g.uy * (z[0] - g.s)) * 12 + 5 + abs(g.ux) * z[1])])[0])

  // ---- towers and monsters ----------------------------------------------------------------------
  // range and splash in cells, rate in shots a second
  let KD = [
    {n: "ARCHER", cost: 50, dmg: 7, rate: 1.5, rng: 2.4, sp: 0},
    {n: "CANNON", cost: 100, dmg: 18, rate: 0.5, rng: 2.1, sp: 0.9},
    {n: "FROST", cost: 80, dmg: 3, rate: 1, rng: 1.8, sp: 0},
    {n: "TESLA", cost: 150, dmg: 12, rate: 0.8, rng: 2.2, sp: 0}
  ]
  // slime, bat, knight, ogre; speed in cells a second
  let ED = [
    {hp: 18, v: 0.95, g: 4},
    {hp: 11, v: 1.6, g: 3},
    {hp: 55, v: 0.6, g: 9},
    {hp: 420, v: 0.42, g: 70}
  ]
  // a tower's stats at level l, and what the next level costs
  let tw0 = towers.map(t => {
    c: t.c, k: t.k, l: t.l, x: t.c % COLS, y: floor(t.c / COLS),
    dmg: KD[t.k].dmg * pow(1.45, t.l - 1),
    per: 1 / min(4, KD[t.k].rate * (1 + 0.06 * (t.l - 1))),
    r: KD[t.k].rng + min(1.5, 0.1 * (t.l - 1)),
    sp: KD[t.k].sp + min(0.6, 0.04 * (t.l - 1)),
    slow: min(0.7, 0.35 + 0.025 * (t.l - 1)),
    ch: t.k == 3 ? min(7, 3 + floor((t.l - 1) / 3)) : 99,
    up: round(KD[t.k].cost * 0.8 * pow(1.45, t.l - 1)),
    sell: floor(t.sp * 0.7)
  })
  // The stretches of road in a tower's range, as distances along it: where a straight piece of
  // road crosses the circle.
  let tw1 = tw0.map(t => merge(t, {cov: segs.map(g => [(t.x - g.ax) * g.ux + (t.y - g.ay) * g.uy, abs((t.x - g.ax) * g.uy - (t.y - g.ay) * g.ux), g.s, g.e - g.s]).map(o => [o[2] + max(0, o[0] - sqrt(max(0, t.r * t.r - o[1] * o[1]))), o[2] + min(o[3], o[0] + sqrt(max(0, t.r * t.r - o[1] * o[1])))]).filter(iv => iv[1] - iv[0] > 0.01)}))
  let tw = tw1.map(t => merge(t, {lo: min(t.cov.map(iv => iv[0])) ?? 999, hi: max(t.cov.map(iv => iv[1])) ?? -999}))
  let frz = tw.filter(t => t.k == 2)

  // ---- the battle, played forward -----------------------------------------------------------------
  // Each step: monsters walk (slowed by frost in range), then each tower whose cooldown is up
  // shoots the monster furthest along the road in its range: an archer that one, a cannon all
  // around it, frost all in range, tesla a chain of them. The dead pay out; who reaches the keep
  // costs a life (an ogre five).
  let DT = 0.25
  let NS = 6 * speed
  let s0 = merge(base, {cd: range(len(tw)).map(i => base.cd[i] ?? 0)})
  let film = [s0] + scan(range(NS), (S, j) =>
    [S.es.map(e => [e.d >= 0 ? max([0] + frz.filter(t => e.d >= t.lo && e.d <= t.hi && any(t.cov, iv => e.d >= iv[0] && e.d <= iv[1])).map(t => t.slow)) * (e.k == 3 ? 0.5 : 1) : 0].map(sv => [e.d + e.v * DT * (1 - sv)].map(nd => [segs.find(g => nd <= g.e) ?? last(segs)].map(g => merge(e, {pd: e.d, ph: e.hp, px: e.x, py: e.y, d: nd, sl: sv > 0, x: g.ax + g.ux * (nd - g.s), y: g.ay + g.uy * (nd - g.s)}))[0])[0])[0])]
    .map(es1 => reduce(range(len(tw)), (A, ti) => [[tw[ti], (A.cd[ti] ?? 0) - DT]].map(z => z[1] > 0.001 ? merge(A, {cd: set(A.cd, ti, z[1])})
      : [A.es.filter(e => e.hp > 0 && e.d >= z[0].lo && e.d <= z[0].hi && any(z[0].cov, iv => e.d >= iv[0] && e.d <= iv[1])).sortBy(e => -e.d)].map(tg => len(tg) == 0 ? merge(A, {cd: set(A.cd, ti, 0)})
      : [tg.take(z[0].ch).map(e => e.i)].map(ids => {
          es: A.es.map(e => (z[0].k == 1 ? e.hp > 0 && e.d >= 0 && pow(e.x - tg[0].x, 2) + pow(e.y - tg[0].y, 2) <= z[0].sp * z[0].sp : z[0].k == 0 ? e.i == tg[0].i : indexOf(ids, e.i) >= 0) ? merge(e, {hp: e.hp - z[0].dmg}) : e),
          cd: set(A.cd, ti, z[1] + z[0].per),
          sh: A.sh + [{k: z[0].k, ax: z[0].x, ay: z[0].y, bx: tg[0].x, by: tg[0].y, r: z[0].r, sp: z[0].sp, p: z[0].k == 3 ? tg.take(z[0].ch).map(e => [e.x, e.y]) : []}]
        })[0])[0])[0], {es: es1, cd: S.cd, sh: []}))
    .map(A => {
      t: S.t + DT,
      es: A.es.filter(e => e.hp > 0 && e.d < PL),
      cd: A.cd,
      sh: A.sh,
      dd: A.es.filter(e => e.hp <= 0),
      lk: A.es.filter(e => e.hp > 0 && e.d >= PL),
      gold: reduce(A.es.filter(e => e.hp <= 0), (s, e) => s + e.g, S.gold),
      lives: reduce(A.es.filter(e => e.hp > 0 && e.d >= PL), (s, e) => s - (e.k == 3 ? 5 : 1), S.lives),
      nid: S.nid
    })[0], s0)

  // Once a second the battle so far becomes the base, and waves come and go.
  on now {
    if mode == "play" {
      let hu = clamp((time - ev) * speed / DT, 0, NS)
      let hj = floor(hu)
      let hS = film[hj]
      ev = time - (hu - hj) * DT / speed
      if hS.lives <= 0 {
        base = merge(hS, {lives: 0})
        best = max(best, wave)
        overT = time
        mode = "over"
      } else if nextAt > 0 && hS.t >= nextAt {
        // Every fifth wave is a swarm of bats, every tenth brings an ogre; from the third on,
        // knights march with the slimes, and from the seventh bats too.
        let hn = wave + 1
        let hboss = hn % 10 == 0
        let hswarm = hn % 5 == 0
        let hcnt = min(40, hboss ? 8 + floor(hn / 3) : hswarm ? 12 + hn : 8 + hn + floor(hn / 4))
        let hhp = pow(1.12, hn - 1) * (1 + 0.03 * (hn - 1))
        let hv = 1 + min(0.35, (hn - 1) * 0.01)
        let hg = 1 + 0.08 * (hn - 1)
        let hnew = range(hcnt).map(i => [hboss && i == 0 ? 3 : hswarm ? 1 : hn >= 3 && i % 4 == 3 ? 2 : hn >= 7 && i % 5 == 1 ? 1 : 0].map(k => [-(i * (hswarm ? 0.55 : 0.95)) - (hboss && i > 0 ? 1.5 : 0)].map(d => {i: hS.nid + i, k: k, d: d, pd: d, hp: ED[k].hp * hhp, ph: ED[k].hp * hhp, mh: ED[k].hp * hhp, v: ED[k].v * hv, g: round(ED[k].g * hg), x: 1, y: d - 1, px: 1, py: d - 1, sl: false})[0])[0])
        base = merge(hS, {es: hS.es + hnew, nid: hS.nid + hcnt})
        wave = hn
        nextAt = 0
        msg = hboss ? "OGRE WAVE ${hn}" : hswarm ? "BAT SWARM ${hn}" : "WAVE ${hn}"
        msgT = time
      } else if nextAt == 0 && len(hS.es) == 0 && wave > 0 {
        base = merge(hS, {gold: hS.gold + 15 + 3 * wave})
        nextAt = hS.t + 8
        msg = "CLEAR +${15 + 3 * wave}"
        msgT = time
      } else {
        base = hS
      }
    }
  }

  // ---- the rest of the screen ----
  // A point of the field (x along its 9 cells, y along its rows) is on screen at
  // FX + (LS ? y : x) * C, FY + (LS ? x : y) * C. FW and FHt are its size on screen.
  let FW = (LS ? ROWS : COLS) * C
  let FHt = (LS ? COLS : ROWS) * C
  let FX = LS ? 8 : floor((SW - FW) / 2)
  // the panel, its build cards (CC a row) and its upgrade and sell buttons
  let PX = LS ? FX + FW + 8 : 8
  let PY = LS ? FY : FY + FHt + 8
  let PW = LS ? SW - PX - 16 : SW - 16
  let PH = SH - INS - (LS ? 4 : 8) - PY
  let CC = LS ? 2 : 4
  let CWd = (PW - 16 - (CC - 1) * 6) / CC
  let CY = PY + 26
  let CH = LS ? min((PH - 40) / 2, 120) : min(PH - 34, 120)
  let BW = LS ? PW - 16 : min(150, floor(PW * 0.4))
  let BX = PX + PW - 8 - BW
  let BH = LS ? min(44, (PH - 24) / 4) : min(52, (PH - 24) / 2)
  let UY = LS ? PY + PH - 2 * BH - 16 : PY + 8
  let SY = UY + BH + 8
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"

  // ---- the art ----------------------------------------------------------------------------------
  // A letter is a color. Each art is its outline as polygons, then rectangles of the colors inside.
  let PAL = {o: "#1e1726", Z: "#ffffff", S: "#b7b3c4", s: "#7d7891", d: "#55506a", T: "#b07a45", t: "#7d5232", K: "#2a2238", M: "#4a4a5e", m: "#2e2e3c", C: "#9ff0ff", c: "#3fb6e6", Q: "#e8fdff", U: "#e09a4a", u: "#a8602a", V: "#d7a8ff", v: "#8a4fe0", L: "#86e05a", l: "#4fa83a", B: "#8a5ab8", b: "#55307a", E: "#ff4848", e: "#b02a3a", A: "#d4d8e4", a: "#8a90a6", G: "#7fae4a", g: "#4f7a2e", H: "#e8dcc0", n: "#5a3a22", F: "#d24a3c", I: "#3f8f3a", i: "#2c6a2e", j: "#5fb048", R: "#d24a3c", r: "#962f2f", Y: "#e8c06a", y: "#a8803a"}
  let archerArt = {o: [[[5, 0], [7, 0], [7, 1], [9, 1], [9, 2], [10, 2], [10, 3], [6, 3], [6, 4], [8, 4], [8, 5], [9, 5], [9, 6], [10, 6], [10, 7], [11, 7], [11, 8], [12, 8], [12, 9], [11, 9], [11, 16], [1, 16], [1, 9], [0, 9], [0, 8], [1, 8], [1, 7], [2, 7], [2, 6], [3, 6], [3, 5], [4, 5], [4, 4], [5, 4]]], r: [[2, 9, 8, 3, "T"], [4, 5, 4, 3, "R"], [2, 7, 8, 1, "R"], [3, 6, 6, 1, "R"], [2, 13, 8, 2, "S"], [2, 12, 8, 1, "y"], [7, 6, 2, 2, "r"], [7, 5, 1, 1, "r"], [9, 7, 1, 1, "r"], [6, 1, 2, 2, "Y"], [8, 2, 1, 1, "Y"], [4, 13, 1, 1, "s"], [8, 13, 1, 1, "s"], [6, 14, 1, 1, "s"], [9, 14, 1, 1, "s"], [9, 9, 1, 3, "t"], [3, 10, 1, 1, "K"], [8, 10, 1, 1, "K"]]}
  let cannonArt = {o: [[[3, 2], [9, 2], [9, 5], [8, 5], [8, 6], [9, 6], [9, 7], [10, 7], [10, 6], [12, 6], [12, 16], [0, 16], [0, 6], [2, 6], [2, 7], [3, 7], [3, 6], [4, 6], [4, 5], [3, 5]]], r: [[1, 8, 10, 6, "S"], [10, 8, 1, 6, "s"], [3, 10, 1, 1, "s"], [8, 10, 1, 1, "s"], [1, 12, 1, 1, "s"], [8, 12, 1, 1, "s"], [3, 13, 1, 1, "s"], [9, 13, 2, 1, "s"], [1, 9, 10, 1, "y"], [1, 14, 10, 1, "d"], [5, 11, 2, 3, "K"], [5, 3, 3, 1, "K"], [5, 4, 2, 4, "M"], [4, 3, 1, 2, "M"], [7, 3, 1, 1, "M"], [6, 5, 1, 3, "m"], [7, 4, 1, 1, "m"], [1, 7, 1, 1, "R"], [3, 7, 1, 1, "R"], [8, 7, 1, 1, "R"], [10, 7, 1, 1, "R"], [5, 4, 1, 1, "Z"]]}
  let frostArt = {o: [[[5, 0], [7, 0], [7, 1], [8, 1], [8, 3], [9, 3], [9, 5], [10, 5], [10, 6], [9, 6], [9, 7], [8, 7], [8, 8], [10, 8], [10, 9], [11, 9], [11, 16], [1, 16], [1, 9], [2, 9], [2, 8], [4, 8], [4, 7], [3, 7], [3, 6], [2, 6], [2, 5], [3, 5], [3, 3], [4, 3], [4, 1], [5, 1]]], r: [[2, 10, 8, 4, "S"], [5, 3, 3, 4, "c"], [5, 7, 2, 1, "c"], [5, 12, 2, 1, "c"], [8, 5, 1, 1, "c"], [5, 1, 2, 3, "C"], [4, 4, 2, 2, "C"], [5, 11, 2, 1, "C"], [4, 6, 1, 1, "C"], [2, 9, 8, 1, "y"], [2, 14, 8, 1, "d"], [9, 11, 1, 3, "s"], [8, 10, 1, 1, "s"], [3, 11, 1, 1, "s"], [4, 13, 1, 1, "s"], [7, 13, 1, 1, "s"], [3, 8, 6, 1, "Y"], [5, 1, 1, 2, "Q"], [4, 3, 1, 2, "Q"], [3, 5, 1, 1, "Q"]]}
  let teslaArt = {o: [[[4, 0], [8, 0], [8, 1], [9, 1], [9, 3], [8, 3], [8, 4], [7, 4], [7, 5], [8, 5], [8, 6], [9, 6], [9, 7], [8, 7], [8, 8], [9, 8], [9, 9], [8, 9], [8, 10], [10, 10], [10, 11], [11, 11], [11, 16], [1, 16], [1, 11], [2, 11], [2, 10], [4, 10], [4, 9], [3, 9], [3, 8], [4, 8], [4, 7], [3, 7], [3, 6], [4, 6], [4, 5], [5, 5], [5, 4], [4, 4], [4, 3], [3, 3], [3, 1], [4, 1]]], r: [[2, 12, 8, 2, "S"], [4, 6, 4, 1, "u"], [4, 8, 4, 1, "u"], [2, 11, 8, 1, "Y"], [2, 14, 8, 1, "d"], [4, 1, 4, 2, "V"], [5, 3, 2, 1, "V"], [5, 5, 2, 1, "U"], [5, 7, 2, 1, "U"], [5, 9, 2, 1, "U"], [7, 2, 1, 1, "v"], [6, 3, 1, 1, "v"], [4, 12, 1, 1, "K"], [7, 12, 1, 1, "K"], [5, 1, 1, 1, "Z"], [8, 13, 1, 1, "s"]]}
