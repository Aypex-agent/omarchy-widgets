  // art size, and how big an art pixel is against a tower's
  let enemySize = [[10, 9], [12, 8], [10, 12], [16, 16]]
  let enemyScale = [0.8, 0.8, 0.85, 1.05]
  // the roofs and trims of towers as they level up: bronze, silver, gold, obsidian, sun
  let TIERS = [
    {R: "#d24a3c", r: "#962f2f", Y: "#e8c06a", y: "#a8803a"},
    {R: "#4a7ad8", r: "#2f4f9a", Y: "#e4e8f0", y: "#9aa0b4"},
