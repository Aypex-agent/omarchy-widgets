  // The game's own colours, the same in every theme: outlines, gold, and the buttons' faces, lights and lips.
  let INK = "#1e1726"
  let GOLD = "#ffd34e"
  // Buttons are pixel art: a light band on top, the face, a shaded band at its foot and a dark lip under it.
  let BTN = {
    go: ["#c4f78e", "#5ccf4f", "#3a9a3e", "#1f5a2a"],
    call: ["#ffd394", "#f2902e", "#c8601e", "#6e2a0e"],
    sell: ["#ffaa94", "#e8504a", "#b8333a", "#621822"],
