app "fox lanes" {
  // A swipe runner down a forest path at dusk, all pixel art. Swipe left and right to change
  // lanes, up to jump logs and rocks, down to slide under low boughs; boulders and brambles you
  // can only go around. Golden acorns lie along the way, and the path gets busier the longer the
  // fox lasts.
  //
  // There's no game loop, as in night owl. The path scrolls by a formula of the time since the
  // run started, the rows of obstacles come from the run's seed at set times, and a swipe changes
  // the fox's lane or pose: from those follows the moment it next hits something (`dieAt`), so a
  // frame only has to draw.

  meta { owl: 14; description: "A swipe runner in pixel art: a fox dashes down a forest path at dusk, changing lanes, jumping logs and sliding under boughs, gathering acorns"; version: "1.0.1"; license: "MIT"; category: "games" }

  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath>
    <g clip-path="url(#t)">
    <rect y="0" width="256" height="32" fill="#3f1f5e"/>
    <rect y="32" width="256" height="32" fill="#5c2766"/>
    <rect y="64" width="256" height="32" fill="#7f3069"/>
    <rect y="96" width="256" height="32" fill="#a53e66"/>
    <rect y="128" width="256" height="32" fill="#c95562"/>
    <rect y="160" width="256" height="32" fill="#e2735e"/>
    <rect y="192" width="256" height="64" fill="#f39a62"/>
    <circle cx="128" cy="196" r="72" fill="#ffd27a"/>
    <rect y="212" width="256" height="44" fill="#a0674a"/>
    </g>
    <rect x="56" y="60" width="12" height="12" fill="#2a1630"/>
    <rect x="188" y="60" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="68" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="176" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="188" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="200" y="72" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="84" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="84" width="24" height="12" fill="#2a1630"/>
    <rect x="80" y="84" width="12" height="12" fill="#2a1630"/>
    <rect x="164" y="84" width="12" height="12" fill="#2a1630"/>
    <rect x="176" y="84" width="24" height="12" fill="#2a1630"/>
    <rect x="200" y="84" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="96" width="12" height="12" fill="#e8742c"/>
    <rect x="68" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="80" y="96" width="12" height="12" fill="#e8742c"/>
    <rect x="92" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="152" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="164" y="96" width="12" height="12" fill="#e8742c"/>
    <rect x="176" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="188" y="96" width="12" height="12" fill="#e8742c"/>
    <rect x="200" y="96" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="108" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="108" width="48" height="12" fill="#e8742c"/>
    <rect x="104" y="108" width="48" height="12" fill="#2a1630"/>
    <rect x="152" y="108" width="48" height="12" fill="#e8742c"/>
    <rect x="200" y="108" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="120" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="120" width="12" height="12" fill="#ffab62"/>
    <rect x="68" y="120" width="120" height="12" fill="#e8742c"/>
    <rect x="188" y="120" width="12" height="12" fill="#ffab62"/>
    <rect x="200" y="120" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="132" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="132" width="12" height="12" fill="#e8742c"/>
    <rect x="68" y="132" width="24" height="12" fill="#2a1630"/>
    <rect x="92" y="132" width="72" height="12" fill="#e8742c"/>
    <rect x="164" y="132" width="24" height="12" fill="#2a1630"/>
    <rect x="188" y="132" width="12" height="12" fill="#e8742c"/>
    <rect x="200" y="132" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="144" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="144" width="12" height="12" fill="#e8742c"/>
    <rect x="68" y="144" width="24" height="12" fill="#2a1630"/>
    <rect x="92" y="144" width="72" height="12" fill="#e8742c"/>
    <rect x="164" y="144" width="24" height="12" fill="#2a1630"/>
    <rect x="188" y="144" width="12" height="12" fill="#e8742c"/>
    <rect x="200" y="144" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="156" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="156" width="24" height="12" fill="#fff1df"/>
    <rect x="80" y="156" width="96" height="12" fill="#e8742c"/>
    <rect x="176" y="156" width="24" height="12" fill="#fff1df"/>
    <rect x="200" y="156" width="12" height="12" fill="#2a1630"/>
    <rect x="44" y="168" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="168" width="48" height="12" fill="#fff1df"/>
    <rect x="104" y="168" width="48" height="12" fill="#e8742c"/>
    <rect x="152" y="168" width="48" height="12" fill="#fff1df"/>
    <rect x="200" y="168" width="12" height="12" fill="#2a1630"/>
    <rect x="56" y="180" width="12" height="12" fill="#2a1630"/>
    <rect x="68" y="180" width="48" height="12" fill="#fff1df"/>
    <rect x="116" y="180" width="24" height="12" fill="#2a1630"/>
    <rect x="140" y="180" width="48" height="12" fill="#fff1df"/>
    <rect x="188" y="180" width="12" height="12" fill="#2a1630"/>
    <rect x="68" y="192" width="12" height="12" fill="#2a1630"/>
    <rect x="80" y="192" width="96" height="12" fill="#fff1df"/>
    <rect x="176" y="192" width="12" height="12" fill="#2a1630"/>
    <rect x="80" y="204" width="24" height="12" fill="#2a1630"/>
    <rect x="104" y="204" width="48" height="12" fill="#fff1df"/>
    <rect x="152" y="204" width="24" height="12" fill="#2a1630"/>
    <rect x="104" y="216" width="48" height="12" fill="#2a1630"/>
  </svg>"""

  // Settles a run that ended with nobody swiping, and looks further down the lane once a second.
  source now = clock every 1s

  // "title", "play" or "over"
  state mode = "title"
  state best = 0 persist
  state seed = 1
  // the time the run started at
  state t0 = 0
  // the lane (0 to 2), where the fox was coming from (in lanes, maybe between two) and when it left
  state lane = 1
  state from = 1
  state lt = -9
  // the pose: 0 running, 1 jumping, 2 sliding, from ks to ke (seconds into the run); the height a
  // jump was at when a swipe down cut it short
  state pk = 0
  state ks = 0
  state ke = 0
  state dh = 0
  // when the fox last changed anything, or was last looked ahead for
  state ev = 0
  // acorns gathered before ev, and which
  state got = 0
  state taken = []
  state final = 0
  // the last stumble before ev, and the last acorn helmet that broke
  state lastS = -99
  state brk = -99
  // acorn helmets worn, the glide and the wisp picked up before ev (from, to), and the power-ups
  // gathered
  state shields = 0
  state g0 = -9
  state g1 = -9
  state m0 = -9
  state m1 = -9
  state gotPu = []
  // when the fox ran into the side of a boulder with the hound on its heels
  state crashAt = 9999
  // the swipe under the finger, and whether it has done its move yet
  state sx = 0
  state sy = 0
  state swiped = false

  // ---- the world, in metres and seconds ---------------------------------------------------------
  // The fox runs at V0, speeding up by ACC each second to VMAX; DC is the distance run by then.
  let V0 = 12
  let ACC = 0.32
  let VMAX = 26
  let TC = (VMAX - V0) / ACC
  let DC = V0 * TC + ACC * TC * TC / 2
  // a jump and a slide, in seconds, and how high a jump goes (art pixels)
  let JD = 0.62
  let SD = 0.7
  let JH = 24
  // Rows of obstacles reach the fox at set times: the first at R0, then every S0 seconds,
  // closing in to every S1 by row KC. RA bends one into the other; SKC is when row KC comes.
  let R0 = 2.2
  let S0 = 1.75
  let S1 = 0.82
  let KC = 80
  let RA = (S0 - S1) / (2 * KC)
  let SKC = S0 * KC - RA * KC * KC
  let NR = 300
  // A stumble brings the hound up behind the fox for WIN seconds; another one then and it's
  // caught. A leaf glider flies GD seconds, GH art pixels up; the wisp pulls acorns for MD.
  let WIN = 7
  let GD = 6
  let GH = 30
  let MD = 10
  // per kind: what it takes (0 a jump, 1 a slide, 2 another lane), its length in metres
  let kinds = [[0, 0.6], [0, 0.9], [1, 0.5], [2, 1.0], [2, 1.2]]

  // Each row: when it reaches the fox, how far down the path it is, and what's in each lane (a
  // kind, or -1). Early rows hold one thing, later ones two or three, but never three you can
  // only go around; now and then a fallen tree or a low bough spans the whole path.
  let base = range(NR).map(k => {
    k: k,
    t: R0 + (k < KC ? S0 * k - RA * k * k : SKC + S1 * (k - KC)) + 0.22 * hash(seed, k, 0),
    n: k < 5 ? 1 : k < 24 ? (hash(seed, k, 1) < 0.55 ? 1 : 2) : (hash(seed, k, 1) < 0.25 ? 1 : hash(seed, k, 1) < 0.72 ? 2 : 3),
    st: floor(hash(seed, k, 2) * 3),
    nd: 1 + floor(hash(seed, k, 3) * 2),
    wall: hash(seed, k, 4) < 0.3 ? (hash(seed, k, 5) < 0.6 ? 0 : 2) : -1
  })
  let raw = base.map(r => {
    k: r.k, t: r.t,
    d: r.t < TC ? V0 * r.t + ACC * r.t * r.t / 2 : DC + VMAX * (r.t - TC),
    hw: 0.32 / min(VMAX, V0 + ACC * r.t),
    c: range(3).map(l => r.n == 3 && r.wall >= 0 ? r.wall
      : r.n == 3 && l == r.st ? [0, 1, 2][floor(hash(seed, r.k, 10 + l) * 3)]
      : l == r.st || (r.n >= 2 && l == (r.st + r.nd) % 3) || r.n == 3 ? (r.k < 3 ? [0, 3][floor(hash(seed, r.k, 10 + l) * 2)] : floor(hash(seed, r.k, 10 + l) * 5))
      : -1)
  })
  // The acorns in the gap after each row: five in a lane, with when each reaches the fox. Now and
  // then a power-up lies in another lane there: 0 a leaf glider, 1 a wisp, 2 an acorn helmet.
  let rows = raw.map((r, i) => {
    k: r.k, t: r.t, d: r.d, hw: r.hw, c: r.c,
    ac: i + 1 < NR && hash(seed, i, 6) < 0.7
      ? range(5).map(j => {
          i: i * 5 + j,
          l: floor(hash(seed, i, 7) * 3),
          c: lerp(r.t + 0.2, raw[i + 1].t - 0.2, (j + 0.5) / 5),
          d: lerp(r.t + 0.2, raw[i + 1].t - 0.2, (j + 0.5) / 5) < TC ? V0 * lerp(r.t + 0.2, raw[i + 1].t - 0.2, (j + 0.5) / 5) + ACC * pow(lerp(r.t + 0.2, raw[i + 1].t - 0.2, (j + 0.5) / 5), 2) / 2 : DC + VMAX * (lerp(r.t + 0.2, raw[i + 1].t - 0.2, (j + 0.5) / 5) - TC)
        })
      : [],
    pw: i >= 6 && i + 1 < NR && hash(seed, i, 8) < 0.1
      ? [{
          i: i,
          l: (floor(hash(seed, i, 7) * 3) + 1 + floor(hash(seed, i, 9) * 2)) % 3,
          k: floor(hash(seed, i, 11) * 3),
          c: (r.t + raw[i + 1].t) / 2,
          d: (r.t + raw[i + 1].t) / 2 < TC ? V0 * (r.t + raw[i + 1].t) / 2 + ACC * pow((r.t + raw[i + 1].t) / 2, 2) / 2 : DC + VMAX * ((r.t + raw[i + 1].t) / 2 - TC)
        }]
      : []
  })

  // ---- what the fox runs into -------------------------------------------------------------------
  // The row about to come at ev, give or take one (each row is a little late, never early).
  let kev = ev - R0 <= 0 ? 0 : ev - R0 < SKC ? floor((S0 - sqrt(S0 * S0 - 4 * RA * (ev - R0))) / (2 * RA)) : floor(KC + (ev - R0 - SKC) / S1)
  let near = rows.drop(max(0, kev - 1)).take(12)
  // The first power-up in the lane from ev, picked up at wc if the fox gets that far: its kind
  // counts from then on.
  let pend = first(flatten(near.map(r => r.pw)).filter(w => w.l == lane && w.c >= ev))
  let wk = pend == null ? -1 : pend.k
  let wc = pend == null ? 9999 : pend.c
  // Each obstacle in the fox's lane meets it from a to b. Gliding, the fox passes over whatever it
  // meets. One to jump (or slide under) it clears only while it's in the air (or sliding) all that
  // time, or else it stumbles over it when it comes down too soon, or right away when it wasn't up
  // yet. One to go around it always runs into: a crash.
  let ahead = near.filter(r => r.c[lane] >= 0 && r.t + r.hw >= ev)
  let hl = ahead.map(r => {
    f: kinds[r.c[lane]][0] == 2,
    t: (max(r.t - r.hw, ev) >= g0 && max(r.t - r.hw, ev) <= g1) || (wk == 0 && max(r.t - r.hw, ev) >= wc && max(r.t - r.hw, ev) <= wc + GD) ? null
      : kinds[r.c[lane]][0] == 2 ? max(r.t - r.hw, ev)
      : pk == kinds[r.c[lane]][0] + 1 && ks <= max(r.t - r.hw, ev) ? (ke >= r.t + r.hw ? null : max(r.t - r.hw, ev, ke))
      : max(r.t - r.hw, ev)
  }).filter(h => h.t != null)
  // What each hit comes to, in turn: a helmet takes it (ab), or else it's a stumble, or the end
  // (dead) when it's a crash or the hound is still close. `last` is the last stumble by then, `sh`
  // the helmets left, `up` whether the helmet picked up at wc is gone.
  let fate = scan(hl, (s, h) => {
    t: h.t,
    f: h.f,
    ab: s.sh > 0 || (wk == 2 && h.t > wc && !s.up),
    dead: !(s.sh > 0 || (wk == 2 && h.t > wc && !s.up)) && (h.f || h.t - s.last < WIN),
    last: s.sh > 0 || (wk == 2 && h.t > wc && !s.up) || h.f ? s.last : h.t,
    sh: s.sh > 0 ? s.sh - 1 : 0,
    up: s.up || (s.sh == 0 && wk == 2 && h.t > wc)
  }, {t: -1, f: false, ab: false, dead: false, last: lastS, sh: shields, up: false})
  let dieAt = min(crashAt, first(fate.filter(x => x.dead)).t ?? 9999)
  let picked = pend != null && wc < dieAt
  // the acorns in the lane before then, and with the wisp in every lane
  let caught = flatten(near.map(r => r.ac)).filter(a => a.c >= ev && a.c < dieAt && (a.l == lane || (a.c >= m0 && a.c <= m1) || (wk == 1 && a.c >= wc && a.c <= wc + MD)))
  let caughtIds = caught.map(a => a.i)
  let distAtDeath = dieAt < TC ? V0 * dieAt + ACC * dieAt * dieAt / 2 : DC + VMAX * (dieAt - TC)

  on now {
    let T = time - t0
    if mode == "play" && T >= dieAt {
      got = got + len(caught)
      taken = taken + caughtIds
      final = floor(distAtDeath) + got * 10
      best = max(best, final)
      mode = "over"
    } else if mode == "play" && T > ev + 0.9 {
      // Looks further down the lane: what's behind is passed.
      let done = caught.filter(a => a.c < T)
      let lastF = last(fate.filter(x => x.t < T))
      let lastAb = last(fate.filter(x => x.t < T && x.ab))
      let pw = picked && wc < T ? pend : null
      got = got + len(done)
      taken = taken + done.map(a => a.i)
      if lastF != null {
        lastS = lastF.last
        shields = lastF.sh
      }
      if lastAb != null { brk = lastAb.t }
      if pw != null {
        gotPu = gotPu + [pw.i]
        if pw.k == 0 {
          g0 = pw.c
          g1 = pw.c + GD
        } else if pw.k == 1 {
          m0 = pw.c
          m1 = pw.c + MD
        } else if !(lastF != null && lastF.up) {
          shields = shields + 1
        }
      }
      ev = T
    }
  }

  // ---- the art ----------------------------------------------------------------------------------
  // One palette for every sprite; a letter is a color, "." is empty.
  let pal = {A: "#ffd870", a: "#d99a2a", B: "#c8f6ff", b: "#3a2220", C: "#8c5a30", c: "#5a3820", D: "#4e3c3e", d: "#7d6660", E: "#c94a2a", e: "#8a2c22", F: "#ffbf58", f: "#ec7f33", G: "#5f9248", g: "#36603a", H: "#3f6a3c", h: "#24402c", I: "#93c060", i: "#77a656", J: "#565074", j: "#2f2944", K: "#857ea3", k: "#3a1f2c", L: "#3f6238", l: "#22382a", M: "#ee6262", m: "#b82e44", N: "#64392c", n: "#3e2426", O: "#3f9fe0", o: "#2a1630", P: "#284a48", p: "#1a3236", Q: "#aaa3c4", q: "#3f6a5e", R: "#b04a22", r: "#e8742c", S: "#e6d2b2", s: "#fff0e0", T: "#774630", t: "#4a2a1e", U: "#e3ae74", u: "#b07a4c", V: "#ff9a58", v: "#8a5a3a", W: "#e2cdb8", w: "#fff1df", X: "#ff6f86", x: "#b8243e", Y: "#ffd27a", y: "#ffab62", Z: "#fff4c8", z: "#c9b48a"}
  let run0 = [
    "...o..........o...",
    "..oko........oko..",
    "..okko......okko..",
    "..orkyo....oykro..",
    "..oryyyooooyyyro..",
    ".oryyrrrrrrrryyro.",
    ".orrrrrrrrrrrrrro.",
    ".owrrrrrrrrrrrrwo.",
    ".owwRrrrrrrrrRwwo.",
    "..owwRRrrrrRRwwo..",
    "...ooooyyooRRoo...",
    "...ooyyyyyyoryo...",
    "..ooRrrrrrRRoryo..",
    "..ooRrrrrrRRorRo..",
    ".okoRrrrrrRRoRRo..",
    ".okoRrrrrrRRoRRo..",
    ".oooRrrrrrRRoRRo..",
    "...owwwwwwWWokko..",
    "...owwwwwwWWokko..",
    "....owwwwwWooooo..",
    ".....oowwoo......."
  ]
  let run1 = [
    "..................",
    "...o..........o...",
    "..oko........oko..",
    "..okko......okko..",
    "..orkyo....oykro..",
    "..oryyyooooyyyro..",
    ".oryyrrrrrrrryyro.",
    ".orrrrrrrrrrrrrro.",
    ".owrrrrrrrrrrrrwo.",
    ".owwRrrrrrrrrRwwo.",
    "..owwRRrrrrRRwwo..",
    "...ooRooyyooRoo...",
    "...oyoyyyyyyoyo...",
    "..oyoRrrrrrRRoyo..",
    "..oRoRrrrrrRRoRo..",
    ".oRRoRrrrrrRRoRo..",
    ".okkoRrrrrrRRoko..",
    ".okkoRrrrrrRRoko..",
    ".oooowwwwwwWWooo..",
    ".....owwwwwWo.....",
    "......oowwoo......"
  ]
  let run2 = [
    "...o..........o...",
    "..oko........oko..",
    "..okko......okko..",
    "..orkyo....oykro..",
    "..oryyyooooyyyro..",
    ".oryyrrrrrrrryyro.",
    ".orrrrrrrrrrrrrro.",
    ".owrrrrrrrrrrrrwo.",
    ".owwRrrrrrrrrRwwo.",
    "..owwRRrrrrRRwwo..",
    "...ooRRooyyoooo...",
    "...oyroyyyyyyoo...",
    "..oyroRrrrrrRRoo..",
    "..oRroRrrrrrRRoo..",
    ".oRRooRrrrrrRRoo..",
    ".oRRooRrrrrrRRoo..",
    ".oRRooRrrrrrRRoo..",
    ".okkoowwwwwwWWo...",
    ".okkoowwwwwwWWo...",
    ".oooo.owwwwwWo....",
    ".......oowwoo....."
  ]
  let run3 = [
    "..................",
    "...o..........o...",
    "..oko........oko..",
    "..okko......okko..",
    "..orkyo....oykro..",
    "..oryyyooooyyyro..",
    ".oryyrrrrrrrryyro.",
    ".orrrrrrrrrrrrrro.",
    ".owrrrrrrrrrrrrwo.",
    ".owwRrrrrrrrrRwwo.",
    "..owwRRrrrrRRwwo..",
    "...ooRooyyooRoo...",
    "...oyoyyyyyyoyo...",
    "..oyoRrrrrrRRoyo..",
    "..oRoRrrrrrRRoRo..",
    ".oRRoRrrrrrRRoRo..",
    ".okkoRrrrrrRRoko..",
    ".okkoRrrrrrRRoko..",
    ".oooowwwwwwWWooo..",
    ".....owwwwwWo.....",
    "......oowwoo......"
  ]
  let jumpArt = [
    "...o..........o...",
    "..oko........oko..",
    "..okko......okko..",
    "..orkyo....oykro..",
    "..oryyyooooyyyro..",
    ".oryyrrrrrrrryyro.",
    ".orrrrrrrrrrrrrro.",
    ".owrrrrrrrrrrrrwo.",
    ".owwRrrrrrrrrRwwo.",
    "..owwRRrrrrRRwwo..",
    "...ooRRrrrrRRoo...",
    "...oyrooyyooryo...",
    "..oyroyyyyyyoryo..",
    "..oRoRrrrrrRRoRo..",
    ".oRRoRrrrrrRRoRo..",
    ".okkoRrrrrrRRoko..",
    ".okkoowwwwwWokko..",
    ".oooo.oowwoooooo..",
    "........oo........",
    "..................",
    ".................."
  ]
  let slideArt = [
    "....oo..........oo....",
    "...oooo........oooo...",
    "..ookkooooooooookkoo..",
    "..ookrroooooooorrkoo..",
    ".ooryyyyyyyyyyyyyyroo.",
    ".oorrrrrrrrrrrrrrrroo.",
    ".ooRrrooorrrrooorrRoo.",
    "..ooRorrrrrrrrrroRoo..",
