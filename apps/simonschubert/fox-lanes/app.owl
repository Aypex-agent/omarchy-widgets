        t0 = time
        lane = 1
        from = 1
        lt = -9
        pk = 0
        ks = 0
        ke = 0
        dh = 0
        ev = 0
        got = 0
        taken = []
        lastS = -99
        brk = -99
        shields = 0
        g0 = -9
        g1 = -9
        m0 = -9
        m1 = -9
        gotPu = []
        crashAt = 9999
        mode = "play"
      }
    }

    onPress: {
      sx = 0
      sy = 0
      swiped = false
      // A run from before the clock started over (the app was reloaded) is dropped.
      if time - t0 < 0 && mode != "title" { mode = "title" }
    }

    onDrag: {
      let T = time - t0
      sx = sx + dx
      sy = sy + dy
      if mode == "play" && !swiped && (abs(sx) > 16 || abs(sy) > 16) {
        swiped = true
        if T >= dieAt {
          got = got + len(caught)
          taken = taken + caughtIds
          final = floor(distAtDeath) + got * 10
          best = max(best, final)
          mode = "over"
        } else {
          let done = caught.filter(a => a.c < T)
          let lastF = last(fate.filter(x => x.t < T))
          let lastAb = last(fate.filter(x => x.t < T && x.ab))
          let pw = picked && wc < T ? pend : null
          got = got + len(done)
          taken = taken + done.map(a => a.i)
          if lastF != null {
            lastS = lastF.last
            shields = lastF.sh
          }
          if lastAb != null { brk = lastAb.t }
          if pw != null {
            gotPu = gotPu + [pw.i]
            if pw.k == 0 {
              g0 = pw.c
              g1 = pw.c + GD
            } else if pw.k == 1 {
              m0 = pw.c
              m1 = pw.c + MD
            } else if !(lastF != null && lastF.up) {
              shields = shields + 1
            }
          }
          ev = T
          if abs(sx) > abs(sy) {
            let to = clamp(lane + (sx > 0 ? 1 : -1), 0, 2)
            // the side of a boulder or a bramble alongside: the fox bounces back and stumbles
            let side = to != lane && !(T >= g0 && T <= g1) && len(near.filter(r => r.c[to] >= 0 && kinds[r.c[to]][0] == 2 && r.t - r.hw <= T && T <= r.t + r.hw)) > 0
            if side {
              from = lane + (to - lane) * 0.45
              lt = T
              if shields > 0 {
                shields = shields - 1
                brk = T
              } else if T - lastS < WIN {
                crashAt = T
              } else {
                lastS = T
              }
            } else if to != lane {
              from = from + (lane - from) * clamp((T - lt) / 0.13, 0, 1)
              lane = to
              lt = T
            }
          } else if sy < 0 {
            if !(pk == 1 && T < ke) {
              pk = 1
              ks = T
              ke = T + JD
            }
          } else if pk == 1 && T < ke {
            // a dive: down from the jump, straight into a slide
            dh = JH * 4 * (T - ks) / JD * (1 - (T - ks) / JD)
            pk = 2
            ks = T
            ke = T + SD
          } else if pk == 2 && T < ke {
            ke = T + SD
          } else {
            dh = 0
            pk = 2
            ks = T
            ke = T + SD
          }
        }
      }
    }

    // ---- where things are ----
    // An art pixel is p dp. The fox runs at depth CZ, its feet at FY; the horizon is at HY. A
    // thing z metres from the camera is drawn at s = CZ / z of its size, its foot at
    // HY + (FY - HY) * s, and a lane is LS art pixels wide at the fox.
    let p = min(width / 128, height / 150)
    let W = width / p
    let H = height / p
    let top = (screenTop ?? 0) / p
    let HY = floor(H * 0.37)
    let FY = floor(H - 30 - (screenInset ?? 0) / p)
    let CZ = 6
    let LS = 28
    let SLEN = 2
    // seconds into the run, stopped where it ended; the distance run
    let fresh = mode == "title" || time < t0
    let rt = fresh ? 0 : min(time - t0, dieAt)
    let dist = fresh ? time * 8 : rt < TC ? V0 * rt + ACC * rt * rt / 2 : DC + VMAX * (rt - TC)
    let dead = !fresh && time - t0 >= dieAt
    let since = time - t0 - dieAt
    // the fox's lane as drawn, -1 to 1, and the camera half following it
    let fx = fresh ? 0 : from + (lane - from) * (1 - pow(1 - clamp((rt - lt) / 0.13, 0, 1), 2)) - 1
    let camX = fx * 0.55
    // the power-ups at work: the glide (from gs to ge), the wisp, the helmets left
    let gs = !fresh && rt >= g0 && rt <= g1 ? g0 : !fresh && wk == 0 && picked && rt >= wc && rt <= wc + GD ? wc : null
    let gliding = gs != null
    let wisping = !fresh && ((rt >= m0 && rt <= m1) || (wk == 1 && picked && rt >= wc && rt <= wc + MD))
    let wEnd = rt >= m0 && rt <= m1 ? m1 : wc + MD
    let fNow = fresh ? [] : fate.filter(x => x.t <= rt)
    let helmets = (last(fNow).sh ?? shields) + (wk == 2 && picked && wc <= rt && !(last(fNow).up ?? false) ? 1 : 0)
    let broke = max(brk, last(fNow.filter(x => x.ab)).t ?? -99)
    // the last stumble, and how close the hound is: on the fox's heels at the start, after a
    // stumble, and when it's over
    let stum = max(lastS, last(fNow.filter(x => !x.ab && !x.f)).t ?? -99)
    let hd = fresh ? 0 : dead ? 1 : max(rt < 2.5 ? 1 : max(0, 1 - (rt - 2.5) / 0.8), rt - stum < WIN ? min(1, (rt - stum) / 0.3) : max(0, 1 - (rt - stum - WIN) / 0.8))
    let jumping = !fresh && pk == 1 && rt < ke
    let sliding = !fresh && pk == 2 && rt < ke
    let fh = gliding ? GH * min(1, (rt - gs) / 0.35, (gs + GD - rt) / 0.35) : jumping ? JH * 4 * (rt - ks) / JD * (1 - (rt - ks) / JD) : sliding && dh > 0 && rt - ks < 0.1 ? dh * (1 - (rt - ks) / 0.1) : 0
    let nuts = got + count(caught, a => a.c < rt)
    let score = fresh ? 0 : mode == "over" ? final : floor(dist) + nuts * 10
    let kn = rt - R0 <= 0 ? 0 : rt - R0 < SKC ? floor((S0 - sqrt(S0 * S0 - 4 * RA * (rt - R0))) / (2 * RA)) : floor(KC + (rt - R0 - SKC) / S1)

    // ---- the sky ----
    let bandH = (HY - 8) / len(sky)
    for c, i in sky {
      rect(0, floor(i * bandH) * p, width, (i == len(sky) - 1 ? HY + 1 - floor(i * bandH) : ceil(bandH) + 1) * p, fill: c)
    }
    for s, i in stars {
      rect(floor(s[0] * W) * p, floor(top + s[1] * HY * 0.4) * p, p, p, fill: alpha("#ffe9d0", 0.35 + 0.35 * sin(time * s[2] + i)))
    }
    // the sun, low, and its glow
    let sunX = floor(W / 2 - camX * 4)
    let sunY = HY - 20
    for r in [34, 22] { circle(sunX * p, sunY * p, r * p, fill: alpha("#ffb070", 0.09)) }
    sprite(sunArt, (sunX - 11) * p, (sunY - 11) * p, p, palette: pal)
    // clouds drifting by
    for c, i in clouds {
      let cw = ((c[0] * W - time * c[2]) % (W + 60) + W + 60) % (W + 60) - 40
      sprite(cloudArt, floor(cw - camX * 3) * p, floor(top + c[1] * HY) * p, p, palette: {u: "#f7a28a", v: "#c86a86"})
    }

    // ---- far to near: mountains, hills, the forest ----
    let layers = [[mount, 3, 0, 46, "#8a4a7a", "#5a3468"], [hills, 6, 60, 22, "#5a3466", "#40264f"], [pines, 10, 100, 26, "#2e2242", "#21182f"]]
    for L, n in layers {
      for pass in [0, 1] {
        for k in range(ceil(W / 192) + 1) {
          translate((k * 192 - (camX * L[1] + L[2] + 40) % 192) * p, (HY + 1 - L[3]) * p) {
            scale(p, p, 0, 0) { translate(pass - 1, pass - 1) { path(L[0], closed: true, fill: L[4 + pass]) } }
          }
        }
      }
    }

    // ---- the ground ----
    let G = FY - HY
    rect(0, (HY + 1) * p, width, height - (HY + 1) * p, fill: "#3d5a3a")
    for j in range(floor((dist - CZ + 4) / SLEN), floor((dist - CZ + 70) / SLEN) + 1) {
      if j % 2 == 1 {
        let za = max(0.5, j * SLEN - dist + CZ)
        let zb = (j + 1) * SLEN - dist + CZ
        rect(0, floor(HY + G * CZ / zb) * p, width, (ceil(HY + G * CZ / za) - floor(HY + G * CZ / zb)) * p, fill: "#34503a")
      }
    }
    // The forest floor, the path's grassy edge, its dirt, darker in every other band, and the lines
    // between the lanes: each a piece of ground between two lines that run to the horizon, xa and
    // xb lanes from the middle, over rows y0 to y1. A piece is drawn stepped by art pixels, with a
    // corner wherever one of its lines moves on by one.
    let bands = range(floor((dist - CZ + 4) / SLEN), floor((dist - CZ + 70) / SLEN) + 1).map(j => {
      j: j,
      ya: max(HY + 1, floor(HY - 0.5 + CZ * G / ((j + 1) * SLEN - dist + CZ)) + 1),
      yb: min(ceil(H) - 1, floor(HY - 0.5 + CZ * G / max(0.5, j * SLEN - dist + CZ))),
      near: j * SLEN - dist + CZ < 60
    })
    let pieces = [[-40, -2.55, HY + 1, ceil(H) - 1, "#273a2c"], [2.55, 40, HY + 1, ceil(H) - 1, "#273a2c"], [-1.7, 1.7, HY + 1, ceil(H) - 1, "#2d402e"], [-1.6, 1.6, HY + 1, ceil(H) - 1, "#a0674a"]]
      + bands.filter(b => b.j % 2 == 1 && b.yb >= b.ya).map(b => [-1.6, 1.6, b.ya, b.yb, "#8f5a42"])
      + flatten(bands.filter(b => b.j % 2 == 0 && b.near && b.yb >= b.ya).map(b => [[-0.53, -0.47, b.ya, b.yb, "#c48a62"], [0.47, 0.53, b.ya, b.yb, "#c48a62"]]), 1)
    scale(p, p, 0, 0) {
      for q in pieces {
        // each line's slope, the column it starts and ends in, and the row each column starts at
        let ca = (q[0] - camX) * LS / G
        let cb = (q[1] - camX) * LS / G
        let na = clamp(floor(W / 2 + ca * (q[2] - HY + 0.5)), -1, ceil(W) + 1)
        let ma = clamp(floor(W / 2 + ca * (q[3] - HY + 0.5)), -1, ceil(W) + 1)
        let nb = clamp(floor(W / 2 + cb * (q[2] - HY + 0.5)), -1, ceil(W) + 1)
        let mb = clamp(floor(W / 2 + cb * (q[3] - HY + 0.5)), -1, ceil(W) + 1)
        let xsa = range(na, ma + (ma >= na ? 1 : -1), ma >= na ? 1 : -1)
        let xsb = range(nb, mb + (mb >= nb ? 1 : -1), mb >= nb ? 1 : -1)
        let fa = xsa.map(n => n == na ? q[2] : ca > 0 ? max(q[2], ceil(HY - 0.5 + (n - W / 2) / ca)) : max(q[2], floor(HY - 0.5 + (n + 1 - W / 2) / ca) + 1))
        let fb = xsb.map(n => n == nb ? q[2] : cb > 0 ? max(q[2], ceil(HY - 0.5 + (n - W / 2) / cb)) : max(q[2], floor(HY - 0.5 + (n + 1 - W / 2) / cb) + 1))
        path(flatten(xsa.map((n, i) => [[n, fa[i]], [n, i + 1 < len(xsa) ? fa[i + 1] : q[3] + 1]]), 1) + flatten(xsb.map((n, i) => [[n, fb[i]], [n, i + 1 < len(xsb) ? fb[i + 1] : q[3] + 1]]), 1).reverse(), closed: true, fill: q[4])
      }
    }
    // the haze where the path meets the trees
    rect(0, (HY - 6) * p, width, 24 * p, fill: linear(0, (HY - 6) * p, 0, (HY + 18) * p, [alpha("#e08a7a", 0), alpha("#d07a78", 0.55), alpha("#a06070", 0)]))

    // ---- trees along the path, then what's on it ----
    // Every 4 m along each side, a tree at the forest's edge, and now and then a bush, a fern or
    // mushrooms by the path, each by its place. Far off they're drawn with their biggest shapes.
    let decor = range(floor((dist - CZ + 1.5) / 4), floor((dist - CZ + 75) / 4) + 1).reverse()
    for pass in [0, 1] {
      for j in decor {
        let z = j * 4 - dist + CZ
        let s = CZ / z
        if (pass == 0) == (z > CZ) && z > 1.2 {
          for side in [-1, 1] {
            let kt = hash(j, side, 1) < 0.55 ? 0 : hash(j, side, 1) < 0.82 ? 1 : 2
            let tx = W / 2 + (side * (2.75 + hash(j, side, 2) * 1.0) - camX) * LS * s
            let ts = s * 1.25
            if tx > -40 && tx < W + 40 {
              translate((tx - treeSize[kt][0] * ts / 2) * p, (HY + G * s - treeSize[kt][1] * ts) * p) {
                scale(p * ts, p * ts, 0, 0) { for sh in treeShape[kt].take(s > 0.7 ? 99 : s > 0.3 ? 10 : 3) { path(sh[1], closed: true, fill: sh[0]) } }
              }
            }
            let kb = 3 + floor(hash(j, side, 4) * 3)
            let bx = W / 2 + (side * (2.0 + hash(j, side, 5) * 0.35) - camX) * LS * s
            if hash(j, side, 3) < 0.5 && z < 45 && bx > -20 && bx < W + 20 {
              translate((bx - treeSize[kb][0] * s / 2) * p, (HY + G * s - treeSize[kb][1] * s) * p) {
                scale(p * s, p * s, 0, 0) { for sh in treeShape[kb].take(s > 0.5 ? 99 : 3) { path(sh[1], closed: true, fill: sh[0]) } }
              }
            }
          }
        }
      }
      if pass == 0 {
        // the rows on the path, far to near: those past the fox come after it
        let vis = fresh ? [] : rows.drop(max(0, kn - 1)).take(7).reverse()
        let tx = W / 2 + (fx - camX) * LS
        for half in [0, 1] {
          for r in vis {
            let z = r.d - dist + CZ
            let s = CZ / z
            // the acorns in the gap after this row, further off than it
            for a in r.ac {
              let az = a.d - dist + CZ
              let as = CZ / max(az, 0.5)
              let mine = indexOf(caughtIds, a.i) >= 0
              let gone = indexOf(taken, a.i) >= 0 || (mine && a.c < rt)
              if (half == 0) == (az > CZ) && az > 1 && az < 80 {
                let ax = W / 2 + (a.l - 1 - camX) * LS * as
                let ay = HY + G * as
                if mine && a.l != lane && !gone && a.c - rt < 0.4 {
                  // pulled in by the wisp from another lane
                  let u = 1 - (a.c - rt) / 0.4
                  sprite(acornArt, (lerp(ax, tx, u) - 2.5) * p, (lerp(ay - 12 * as, FY - fh - 12, u) - 3.5) * p, p, palette: pal)
                } else if !gone {
                  let bob = (5 + sin(time * 4 + a.i) * 1.5) * as
                  circle(ax * p, (ay - bob - 3.5 * as) * p, 5 * as * p, fill: alpha("#ffd870", 0.16 + 0.08 * sin(time * 6 + a.i)))
                  if as > 0.35 {
                    sprite(acornArt, (ax - 2.5 * as) * p, (ay - bob - 7 * as) * p, p * as, palette: pal)
                  } else {
                    circle(ax * p, (ay - bob - 3.5 * as) * p, 2.5 * as * p, fill: "#ffd870")
                  }
                } else if rt >= a.c && rt - a.c < 0.3 {
                  // a gathered one bursts
                  let b = (rt - a.c) * 40
                  for q in range(4) {
                    rect(((a.l == lane ? ax : tx) + [b, -b, 0, 0][q]) * p, (FY - fh - 14 + [0, 0, b, -b][q]) * p, p, p, fill: "#ffe9a0")
                  }
                }
              }
            }
            // a power-up, glowing
            for w in r.pw {
              let wz = w.d - dist + CZ
              let ws = CZ / max(wz, 0.5)
              let wgone = indexOf(gotPu, w.i) >= 0 || (picked && pend.i == w.i && wc < rt)
              if (half == 0) == (wz > CZ) && wz > 1 && wz < 85 && !wgone {
                let art = [gliderArt, wispArt, helmetArt][w.k]
                let k = [0.5, 1.2, 1.1][w.k] * ws
                let wx = W / 2 + (w.l - 1 - camX) * LS * ws
                let wy = HY + G * ws - (9 + sin(time * 3 + w.i) * 2) * ws
                circle(wx * p, wy * p, 9 * ws * p, fill: alpha(["#ffbf58", "#8ad8ff", "#ffd870"][w.k], 0.22 + 0.1 * sin(time * 5)))
                sprite(art, (wx - len(art[0]) * k / 2) * p, (wy - len(art) * k / 2) * p, p * k, palette: pal)
              }
            }
            if (half == 0) == (z > CZ) && z > 0.8 && z < 95 {
              for l in range(3) {
                if r.c[l] >= 0 {
                  let ox = W / 2 + (l - 1 - camX) * LS * s
                  let gy = HY + G * s
                  rect((ox - 12 * s) * p, (gy - 1.5 * s) * p, 24 * s * p, 2.5 * s * p, fill: alpha("#1a0e1e", 0.35))
                  translate((ox - obsSize[r.c[l]][0] * s / 2) * p, (gy - (obsSize[r.c[l]][1] + (r.c[l] == 2 ? 14 : 0)) * s) * p) {
                    scale(p * s, p * s, 0, 0) { for sh in obsShape[r.c[l]].take(s > 0.4 ? 99 : 3) { path(sh[1], closed: true, fill: sh[0]) } }
                  }
                }
              }
            }
          }
          // ---- the fox, and the hound behind it ----
          if half == 0 {
            rect((tx - 8 + fh * 0.1) * p, (FY - 1) * p, (16 - fh * 0.2) * p, 2 * p, fill: alpha("#1a0e1e", 0.4))
            // after a stumble the fox blinks for a moment
            let blink = !dead && rt - stum < 0.9 && floor(rt * 14) % 2 == 0
            let kb = min(1, since * 4)
            let ky = FY + 7 * kb - 9 * sin(kb * 3.14)
            if dead {
              // knocked back towards us with a hop, and dizzy
              sprite(deadArt, (tx - 11) * p, (ky - 12) * p, p, palette: pal)
              for i in range(3) {
                let ang = time * 5 + i * 2.1
                rect((tx - 7 + cos(ang) * 7) * p, (ky - 16 + sin(ang) * 2) * p, p, p, fill: "#fff4c8")
              }
            } else if blink {
            } else if gliding {
              sprite(gliderArt, (tx - 11.5) * p, (FY - fh - 30) * p, p, palette: pal)
              sprite(jumpArt, (tx - 9) * p, (FY - fh - 21) * p, p, palette: pal)
            } else if sliding {
              sprite(slideArt, (tx - 11) * p, (FY - fh - 12) * p, p, palette: pal)
            } else if jumping {
              sprite(jumpArt, (tx - 9) * p, (FY - fh - 21) * p, p, palette: pal)
            } else {
              sprite(runArt[floor((fresh ? time : rt) * 11) % 4], (tx - 9) * p, (FY - 21) * p, p, palette: pal)
            }
            // the acorn helmet, and its pieces when it breaks
            if !dead && !blink && helmets > 0 {
              sprite(helmetArt, (tx - 5) * p, (FY - fh - (sliding ? 13 : 22)) * p, p, palette: pal)
            }
            if !fresh && rt - broke < 0.45 && rt >= broke {
              let b = (rt - broke) * 50
              for q in range(5) {
                rect((tx + cos(q * 1.26) * b) * p, (FY - fh - 20 - sin(q * 1.26) * b + b * b * 0.04) * p, 2 * p, p, fill: "#8c5a30")
              }
            }
            // the wisp, circling
            if !dead && wisping {
              let wa = time * 6
              let wxp = tx + cos(wa) * 13
              let wyp = FY - fh - 12 + sin(wa) * 4
              circle(wxp * p, wyp * p, 5 * p, fill: alpha("#8ad8ff", 0.3))
              sprite(wispArt, (wxp - 3.5) * p, (wyp - 3.5) * p, p, palette: pal)
            }
            if hd > 0 {
              // just behind the fox, below its feet; when it's over, beside it
              let hx = dead ? tx + 13 : W / 2 + (fx * 0.9 - camX) * LS
              let hy = dead ? ky + 6 + 20 * (1 - kb) : FY + 30 + 40 * (1 - hd)
              sprite([hound0, hound1][floor(time * 9) % 2], (hx - 11) * p, (hy - 24.2) * p, p * 1.1, palette: pal)
            }
          }
        }
      }
    }

    // ---- words ----
    if fresh {
      text("FOX LANES", width / 2 + p, (HY * 0.42 + top / 2) * p + p, size: 9 * p, color: "#2a1838", font: press, align: center)
      text("FOX LANES", width / 2, (HY * 0.42 + top / 2) * p, size: 9 * p, color: "#ffc46b", font: press, align: center)
      if time % 1.2 < 0.8 { text("TAP TO START", width / 2, (HY * 0.42 + top / 2 + 16) * p, size: 3.5 * p, color: "#fff0e0", font: press, align: center) }
      text("SWIPE TO CHANGE LANES,", width / 2, (FY + 12) * p, size: 3 * p, color: "#f0d8c0", font: press, align: center)
      text("UP TO JUMP, DOWN TO SLIDE", width / 2, (FY + 18) * p, size: 3 * p, color: "#f0d8c0", font: press, align: center)
      if best > 0 { text("BEST ${best}", width / 2, (FY + 25) * p, size: 3 * p, color: "#ffc46b", font: press, align: center) }
    } else {
      text(pad(str(score), 5, "0"), 6 * p, (top + 8) * p, size: 4 * p, color: "#fff3e0", font: press)
      text("HI ${pad(str(max(best, score)), 5, "0")}", width - 6 * p, (top + 8) * p, size: 4 * p, color: "#f0c0b0", font: press, align: end)
      sprite(acornArt, 6 * p, (top + 13) * p, p, palette: pal)
      text("${nuts}", 14 * p, (top + 16.5) * p, size: 3.5 * p, color: "#ffd36a", font: press)
      // the power-ups at work, with the time they have left
      let pows = (gliding ? [[gliderArt, (gs + GD - rt) / GD, "#ffbf58"]] : []) + (wisping ? [[wispArt, (wEnd - rt) / MD, "#8ad8ff"]] : []) + (helmets > 0 ? [[helmetArt, 1, "#c08850"]] : [])
      for pw, i in pows {
        let py = top + 24 + i * 9
        sprite(pw[0], 6 * p, (py - len(pw[0]) / 2) * p, p * min(1, 9 / len(pw[0][0])), palette: pal)
        rect(17 * p, (py - 1) * p, 20 * p, 2 * p, fill: alpha("#000000", 0.3))
        rect(17 * p, (py - 1) * p, 20 * clamp(pw[1], 0, 1) * p, 2 * p, fill: pw[2])
      }
      if dead {
        text("GAME OVER", width / 2 + p, (HY * 0.45 + top / 2) * p + p, size: 7 * p, color: "#2a1838", font: press, align: center)
        text("GAME OVER", width / 2, (HY * 0.45 + top / 2) * p, size: 7 * p, color: "#ff8a6a", font: press, align: center)
        text("SCORE ${final > 0 ? final : score}", width / 2, (HY * 0.45 + top / 2 + 12) * p, size: 4 * p, color: "#fff3e0", font: press, align: center)
        if since > 0.8 && time % 1.2 < 0.8 { text("TAP TO RUN AGAIN", width / 2, (HY * 0.45 + top / 2 + 24) * p, size: 3.5 * p, color: "#fff0e0", font: press, align: center) }
      }
    }
  }
}
