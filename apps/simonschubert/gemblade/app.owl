6 191.5h8.5v8.5h-8.5zM191.5 191.5h8.5v8.5h-8.5zM200 191.5h8.5v8.5h-8.5zM157.5 200h8.5v8.5h-8.5zM166 200h8.5v8.5h-8.5zM191.5 200h8.5v8.5h-8.5zM166 208.5h8.5v8.5h-8.5zM174.5 208.5h8.5v8.5h-8.5zM183 208.5h8.5v8.5h-8.5zM174.5 217h8.5v8.5h-8.5z"/><path fill="#a8c8ff" d="M149 149h8.5v8.5h-8.5zM157.5 149h8.5v8.5h-8.5zM149 157.5h8.5v8.5h-8.5z"/><path fill="#f0c040" d="M174.5 149h8.5v8.5h-8.5zM183 149h8.5v8.5h-8.5zM174.5 157.5h8.5v8.5h-8.5zM183 157.5h8.5v8.5h-8.5zM149 166h8.5v8.5h-8.5zM157.5 166h8.5v8.5h-8.5zM166 166h8.5v8.5h-8.5zM174.5 166h8.5v8.5h-8.5zM183 166h8.5v8.5h-8.5zM191.5 166h8.5v8.5h-8.5zM200 166h8.5v8.5h-8.5zM208.5 166h8.5v8.5h-8.5zM149 174.5h8.5v8.5h-8.5zM157.5 174.5h8.5v8.5h-8.5zM166 174.5h8.5v8.5h-8.5zM174.5 174.5h8.5v8.5h-8.5zM183 174.5h8.5v8.5h-8.5zM191.5 174.5h8.5v8.5h-8.5zM200 174.5h8.5v8.5h-8.5zM208.5 174.5h8.5v8.5h-8.5zM174.5 183h8.5v8.5h-8.5zM183 183h8.5v8.5h-8.5zM174.5 191.5h8.5v8.5h-8.5zM183 191.5h8.5v8.5h-8.5zM174.5 200h8.5v8.5h-8.5zM183 200h8.5v8.5h-8.5z"/><path fill="#24509e" d="M217 149h8.5v8.5h-8.5zM217 157.5h8.5v8.5h-8.5zM217 166h8.5v8.5h-8.5zM217 174.5h8.5v8.5h-8.5zM208.5 183h8.5v8.5h-8.5zM208.5 191.5h8.5v8.5h-8.5zM200 200h8.5v8.5h-8.5zM191.5 208.5h8.5v8.5h-8.5zM183 217h8.5v8.5h-8.5z"/></svg>"""

  // "title", "fight" or "camp"; `rmode` is where Continue goes back to
  state mode = "title" persist
  state rmode = "" persist
  // the fight, from 1; foe k is (stage - 1) % 10, and every ten the round starts again harder
  state stage = 1 persist
  state best = 0 persist
  // the knight: health, attack, level, experience, and the armor and mana gathered this fight
  state hero = {hp: 40, mh: 40, atk: 3, lv: 1, xp: 0, ar: 0, mp: 0} persist
  // the foe: kind, health, attack, armor, moves between its blows, moves left until the next
  state mon = {k: 0, hp: 18, mh: 18, atk: 4, def: 0, ev: 3, cd: 3} persist
  // 64 gems, row by row from the top: 0 blade, 1 skull, 2 shield, 3 heart, 4 star, 5 coin
  state board = [] persist
  state gold = 0 persist
  state kills = 0 persist
  // the camp's whetstone and armorer, bought this run
  state buys = [0, 0] persist
  // over the fight once its last move has played: "won" or "dead"
  state card = "" persist
  // what the last win brought
  state gain = {xp: 0, gold: 0, up: false} persist

  // a gem picked by a tap, waiting for a neighbour
  state sel = -1
  // the swap asked for, and the spell
  state sw = [0, 0]
  state swN = 0
  state spk = 0
  state spN = 0
  // what `on resN` resolves: the board, when its first match pops, whether it costs a move, the
  // events that come before, damage already dealt and moves added to the foe's count
  state pend = []
  state pendT = 0
  state useTurn = false
  state preFx = []
  state preDm = 0
  state preCd = 0
  state resN = 0
  // a new run, a new fight, a fresh board
  state fresh = 0
  state fightN = 0
  state shufN = 0
  // what the board did: the board before a swap, the swap, and each wave of the cascade
  state b0 = []
  state swp = {p: -1, q: -1, ok: true}
  state steps = []
  // the other events, and how long it all takes
  state fx = []
  state fxLen = 0
  // A tap's `time` lags the frame clock, so a move starts its events at the first frame after it.
  state fxTap = 0
  state fxAt = 0
  when fxAt == -1 && time != fxTap { fxAt = time }
  // while a move plays out; the board only reads the clock then
  state anim = false
  when anim && fxAt >= 0 && (time - fxAt > fxLen + 0.1 || time < fxAt) { anim = false }
  // where a finger went down, the gem under it, and a swipe so far
  state downAt = [-1, -1]
  state pc = -1
  state sx = 0
  state sy = 0
  state swiped = false

  // ---- the screen, in dp ------------------------------------------------------------------------
  let SW = screenWidth ?? 400
  let SH = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let INS = max(screenInset ?? 0, 16)
  // held sideways the board goes on the right
  let LS = SW > SH
  // a cell of the board, and an art pixel of a gem
  let T = floor(LS ? min((SH - TOP - INS - 16) / 8, SW * 0.52 / 8) : min((SW - 16) / 8, (SH - TOP - INS - 8 - 300) / 8))
  let q = T / 13
  let BX = LS ? SW - 8 * T - 16 : floor((SW - 8 * T) / 2)
  let BY = LS ? TOP + max(0, floor((SH - TOP - INS - 8 * T) / 2)) : SH - INS - 8 - 8 * T
  // the left of the screen, or the top: the fight above, and the knight's armor, mana and spells
  let LX = LS ? 14 : 10
  let LW = LS ? BX - 34 : SW - 20
  let PY = LS ? SH - INS - 96 : BY - 96
  let SPY = PY + 34
  let SPW = (LW - 16) / 3
  let AT = TOP + 34
  let GY = PY - 14
  // a pixel of the knight and the foe
  let P = clamp(floor(min((GY - AT - 70) / 16, LW * 0.3 / 16)), 3, 8)
  let HXc = LX + LW * 0.25
  let MXc = LX + LW * 0.73
  // the health bars over them
  let HBW = LW * 0.42
  let HBY = AT + 14
  let MBX = LX + LW - HBW
  // the mana bar
  let MPX = LX + 96
  let MPW = LW - 96
  // the title's buttons, the cards' and the camp's
  let TCX = LS ? SW * 0.7 : SW / 2
  let TBY = LS ? SH - INS - 120 : SH * 0.55
  let LGW = min(150, (SW - 20) / 2)
  let LGX = TCX - LGW + 6
  let LGY = LS ? TOP + 100 : TBY + 130
  let CY = LS ? TOP + 20 : SH * 0.24
  let OBY = CY + 210
  // the camp: the fire on the left or on top, the wares beside it or below
  let CYO = LS ? 0 : max(0, (SH - TOP - INS - 520) / 3)
  let SCX = LS ? SW * 0.27 : SW / 2
  let SCY = TOP + (LS ? 60 : 40 + CYO)
  let CX0 = LS ? SW * 0.7 : SW / 2
  let CW = LS ? min(SW * 0.4, 340) : min(SW - 32, 340)
  let CPY = LS ? TOP + 40 : TOP + 250 + CYO
  let press = "https://raw.githubusercontent.com/google/fonts/main/ofl/pressstart2p/PressStart2P-Regular.ttf"

  // ---- the foes and the spells ------------------------------------------------------------------
  // sp: 0 nothing more, 1 heals 3 each move, 2 drains 4 mana with a blow, 3 its blows pass armor
  let KD = [
    {n: "SLIME", hp: 18, atk: 4, def: 0, ev: 3, sp: 0},
    {n: "BAT", hp: 16, atk: 3, def: 0, ev: 2, sp: 0},
    {n: "GOBLIN", hp: 26, atk: 6, def: 1, ev: 3, sp: 0},
    {n: "SKELETON", hp: 32, atk: 6, def: 3, ev: 3, sp: 0},
    {n: "TROLL", hp: 54, atk: 10, def: 1, ev: 4, sp: 1},
    {n: "WOLF", hp: 40, atk: 6, def: 1, ev: 2, sp: 0},
    {n: "GOLEM", hp: 64, atk: 11, def: 6, ev: 4, sp: 0},
    {n: "WRAITH", hp: 48, atk: 8, def: 2, ev: 3, sp: 2},
    {n: "WARLOCK", hp: 56, atk: 10, def: 2, ev: 3, sp: 3},
    {n: "DRAGON", hp: 120, atk: 15, def: 4, ev: 4, sp: 3}
  ]
  let SPT = ["", "HEALS 3 A MOVE", "DRAINS MANA", "PIERCES ARMOR"]
  let SPN = ["FIRE", "FROST", "BLADES"]
  let COST = [7, 5, 9]
  let MAXAR = 30
  let MAXMP = 20
  // what the camp sells
  let PR = [12 + 8 * buys[0], 10 + 6 * buys[1], 8]

  // ---- the swaps that make a line --------------------------------------------------------------
  // A swap can only make a line through the two gems it moves, and only one that runs away from the
  // other: a line through both would need them alike. So a gem moving left needs a pair on its left,
  // above, below or one either side up and down. MH holds each gem that can swap with the one on its
  // right, MV each that can swap with the one below.
  let MH = len(board) < 64 ? [] : range(63).filter(c => c % 8 < 7 && board[c] != board[c + 1] && (
    (c % 8 >= 2 && board[c - 1] == board[c + 1] && board[c - 2] == board[c + 1]) ||
    (c >= 16 && board[c - 8] == board[c + 1] && board[c - 16] == board[c + 1]) ||
    (c >= 8 && c < 56 && board[c - 8] == board[c + 1] && board[c + 8] == board[c + 1]) ||
    (c < 48 && board[c + 8] == board[c + 1] && board[c + 16] == board[c + 1]) ||
    (c % 8 <= 4 && board[c + 2] == board[c] && board[c + 3] == board[c]) ||
    (c >= 15 && board[c - 7] == board[c] && board[c - 15] == board[c]) ||
    (c >= 7 && c < 55 && board[c - 7] == board[c] && board[c + 9] == board[c]) ||
    (c < 47 && board[c + 9] == board[c] && board[c + 17] == board[c])))
  let MV = len(board) < 64 ? [] : range(56).filter(c => board[c] != board[c + 8] && (
    (c >= 16 && board[c - 8] == board[c + 8] && board[c - 16] == board[c + 8]) ||
    (c % 8 >= 2 && board[c - 1] == board[c + 8] && board[c - 2] == board[c + 8]) ||
    (c % 8 <= 5 && board[c + 1] == board[c + 8] && board[c + 2] == board[c + 8]) ||
    (c % 8 >= 1 && c % 8 <= 6 && board[c - 1] == board[c + 8] && board[c + 1] == board[c + 8]) ||
    (c < 40 && board[c + 16] == board[c] && board[c + 24] == board[c]) ||
    (c % 8 >= 2 && board[c + 7] == board[c] && board[c + 6] == board[c]) ||
    (c % 8 <= 5 && board[c + 9] == board[c] && board[c + 10] == board[c]) ||
    (c % 8 >= 1 && c % 8 <= 6 && board[c + 7] == board[c] && board[c + 9] == board[c])))
  let dead = len(MH) + len(MV) == 0

  // ---- a new run, a fight, a board ---------------------------------------------------------------
  on fresh {
    hero = {hp: 40, mh: 40, atk: 3, lv: 1, xp: 0, ar: 0, mp: 0}
    stage = 1
    gold = 0
    kills = 0
    buys = [0, 0]
    fightN = fightN + 1
  }

  on fightN {
    let k = (stage - 1) % 10
    let lp = floor((stage - 1) / 10)
    let K = KD[k]
    let sc = 1 + lp * 0.7
    mon = {k: k, hp: round(K.hp * sc), mh: round(K.hp * sc), atk: round(K.atk * sc), def: K.def + lp * 2, ev: K.ev, cd: K.ev}
    hero = merge(hero, {ar: 0, mp: 0})
    card = ""
    sel = -1
    mode = "fight"
    rmode = "fight"
    shufN = shufN + 1
    fx = [{k: 7, s: lp > 0 ? "ROUND ${lp + 1}" : "STAGE ${stage}", s2: "A ${K.n} BLOCKS THE WAY", t0: 0.1}]
    fxLen = 1.6
  }

  // a board with no line in it: each gem, left to right and down, is the first kind from a random
  // one that doesn't make three with the two to its left or the two above
  on shufN {
    let S = random(1000000)
    board = reduce(range(64), (L, c) => L + [[floor(hash(S, c) * 6)].map(t0 => range(6).map(o => (t0 + o) % 6).find(t => !((c % 8 >= 2 && L[c - 1] == t && L[c - 2] == t) || (c >= 16 && L[c - 8] == t && L[c - 16] == t))))[0]], [])
    steps = []
    b0 = []
    swp = {p: -1, q: -1, ok: true}
    if mode == "fight" && fightN > 0 && len(fx) == 0 {
      fx = [{k: 12, s: "NO MOVES · NEW GEMS", t0: 0}]
      fxLen = 1
    }
    fxTap = time
    fxAt = -1
    anim = true
  }
  // a board with no swap left is dealt again, once the last move has played
  when mode == "fight" && !anim && card == "" && len(board) == 64 && dead { fx = []; shufN = shufN + 1 }

  // ---- a swap ------------------------------------------------------------------------------------
  on swN {
    let p = min(sw[0], sw[1])
    let pq = max(sw[0], sw[1])
    if mode == "fight" && card == "" && !anim && hero.hp > 0 && mon.hp > 0 && len(board) == 64 && p >= 0 && pq < 64 && ((pq - p == 1 && p % 8 < 7) || pq - p == 8) {
      let ok = pq - p == 1 ? indexOf(MH, p) >= 0 : indexOf(MV, p) >= 0
      b0 = board
      swp = {p: p, q: pq, ok: ok}
      sel = -1
      if ok {
        pend = set(set(board, p, board[pq]), pq, board[p])
        pendT = 0.16
        useTurn = true
        preFx = []
        preDm = 0
        preCd = 0
        resN = resN + 1
      } else {
        steps = []
        fx = []
        fxLen = 0.3
        fxTap = time
        fxAt = -1
        anim = true
      }
    }
  }

  // ---- a spell: it costs mana, not a move ----------------------------------------------------------
  on spN {
    if mode == "fight" && card == "" && !anim && hero.hp > 0 && mon.hp > 0 && len(board) == 64 && hero.mp >= COST[spk] {
      hero = merge(hero, {mp: hero.mp - COST[spk]})
      b0 = []
      swp = {p: -1, q: -1, ok: true}
      sel = -1
      useTurn = false
      preCd = 0
      preDm = 0
      if spk == 0 {
        // a fireball that no armor stops
        let dm = min(mon.hp, 10 + 3 * hero.lv)
        pend = board
        pendT = 0.5
        preDm = dm
        preFx = [{k: 8, t0: 0}, {k: 3, t0: 0.36}, {k: 2, w: 1, s: "-${dm}", c: "#ffb070", t0: 0.36, dm: dm}] + (dm >= mon.hp ? [{k: 11, t0: 0.42}] : [])
      } else if spk == 1 {
        // frost: the foe's count goes back two
        pend = board
        pendT = 0.5
        preCd = 2
        preFx = [{k: 9, t0: 0}, {k: 12, s: "FROZEN: +2 MOVES", t0: 0.1}]
      } else {
        // six gems turn to blades, and whatever lines up goes off
        let R = random(1000000)
        let pick = shuffle(range(64).filter(c => board[c] != 0)).take(6)
        b0 = board
        pend = range(64).map(c => indexOf(pick, c) >= 0 ? 0 : board[c])
        pendT = 0.42
        preFx = pick.map((c, n) => {k: 10, c: c, t0: n * 0.04})
      }
      resN = resN + 1
    }
  }

  // ---- what a move does: every wave of the cascade, and then the foe's turn -------------------------
  on resN {
    let R = random(1000000)
    let atk = hero.atk
    let def = mon.def
    // Each wave: mark every gem in a line of three, count them by kind, let the rest fall and new
    // ones drop in from above. `fy` is the row each gem falls from, above the board for new ones.
    let res = reduce(range(14), (A, n) => A.done ? A : [range(64).map(c =>
        (c % 8 >= 2 && A.b[c - 1] == A.b[c] && A.b[c - 2] == A.b[c]) ||
        (c % 8 >= 1 && c % 8 <= 6 && A.b[c - 1] == A.b[c] && A.b[c + 1] == A.b[c]) ||
        (c % 8 <= 5 && A.b[c + 1] == A.b[c] && A.b[c + 2] == A.b[c]) ||
        (c >= 16 && A.b[c - 8] == A.b[c] && A.b[c - 16] == A.b[c]) ||
        (c >= 8 && c < 56 && A.b[c - 8] == A.b[c] && A.b[c + 8] == A.b[c]) ||
        (c < 48 && A.b[c + 8] == A.b[c] && A.b[c + 16] == A.b[c]))].map(m => !any(m, v => v) ? merge(A, {done: true}) :
      [range(6).map(g => count(range(64), c => m[c] && A.b[c] == g))].map(N =>
      [range(8).map(x => range(7, -1, -1).filter(y => !m[y * 8 + x]))].map(CL =>
      [[N[0] > 0 ? max(N[0], N[0] * atk - def) : 0].map(h => min(A.mhp, h + N[1] * 2))[0]].map(dm =>
      [{h: min(A.mh - A.hp, N[3] * 2), a: min(MAXAR - A.ar, N[2]), p: min(MAXMP - A.mp, N[4])}].map(G => merge(A, {
        b: range(64).map(c => [CL[c % 8]].map(K => 7 - (c - c % 8) / 8 < len(K) ? A.b[K[7 - (c - c % 8) / 8] * 8 + c % 8] : floor(hash(R, n, c) * 6))[0]),
        st: A.st + [{b: A.b, m: m, t: A.t, fy: range(64).map(c => [CL[c % 8]].map(K => 7 - (c - c % 8) / 8 < len(K) ? K[7 - (c - c % 8) / 8] : (c - c % 8) / 8 - 8 + len(K))[0])}],
        fx: A.fx + range(64).filter(c => m[c]).map(c => {k: 1, c: c, g: A.b[c], t0: A.t + 0.04})
          + (dm > 0 ? [{k: 3, t0: A.t + 0.34}, {k: 2, w: 1, s: "-${dm}", c: "#ffffff", t0: A.t + 0.34, dm: dm}] : [])
          + (dm > 0 && dm >= A.mhp ? [{k: 11, t0: A.t + 0.4}] : [])
          + (N[0] > 0 && A.mhp > 0 ? [{k: 6, t0: A.t + 0.16}] : [])
          + (G.h > 0 ? [{k: 2, w: 0, s: "+${G.h}", c: "#6fe05a", t0: A.t + 0.34, dh: G.h}] : [])
          + (G.a > 0 ? [{k: 2, w: 2, s: "+${G.a}", c: "#8ab8ff", t0: A.t + 0.34, da: G.a}] : [])
          + (G.p > 0 ? [{k: 2, w: 3, s: "+${G.p}", c: "#d090ff", t0: A.t + 0.34, dp: G.p}] : [])
          + (N[5] > 0 ? [{k: 2, w: 4, s: "+${N[5]}", c: "#ffe14a", t0: A.t + 0.34}] : [])
          + (n >= 1 ? [{k: 12, s: "COMBO ×${n + 1}", t0: A.t}] : []),
        t: A.t + 0.42,
        mhp: A.mhp - dm,
        hp: A.hp + G.h,
        ar: A.ar + G.a,
        mp: A.mp + G.p,
        gold: A.gold + N[5],
        // a line of four or more
        ex: A.ex || any(range(64), c => (c % 8 <= 4 && A.b[c] == A.b[c + 1] && A.b[c] == A.b[c + 2] && A.b[c] == A.b[c + 3]) || (c < 40 && A.b[c] == A.b[c + 8] && A.b[c] == A.b[c + 16] && A.b[c] == A.b[c + 24]))
      }))[0])[0])[0])[0])[0],
      {b: pend, done: false, st: [], fx: [], t: pendT, mhp: mon.hp - preDm, mh: hero.mh, hp: hero.hp, ar: hero.ar, mp: hero.mp, gold: 0, ex: false})
    steps = res.st
    board = res.b
    gold = gold + res.gold
    let tE = res.t
    let lFx = preFx + res.fx
    let ex = res.ex && useTurn
    hero = merge(hero, {hp: res.hp, ar: res.ar, mp: res.mp})
    if res.mhp <= 0 {
      // the foe falls: experience, a purse, and the next level when there's enough
      mon = merge(mon, {hp: 0})
      let xg = 6 + stage * 3
      let gg = 5 + stage * 2
      let xp2 = hero.xp + xg
      let up = xp2 >= hero.lv * 10
      hero = up ? merge(hero, {xp: xp2 - hero.lv * 10, lv: hero.lv + 1, mh: hero.mh + 6, hp: min(hero.mh + 6, hero.hp + 6), atk: hero.atk + 1}) : merge(hero, {xp: xp2})
      gold = gold + gg
      kills = kills + 1
      best = max(best, stage)
      gain = {xp: xg, gold: gg + res.gold, up: up}
      card = "won"
      fx = lFx + [{k: 7, s: "VICTORY", s2: "THE ${KD[mon.k].n} FALLS", t0: tE + 0.3}]
      fxLen = tE + 1.8
      haptic()
    } else {
      // the foe's turn: its count goes down unless the move made a line of four, and at none it strikes
      let K = KD[mon.k]
      let rg = K.sp == 1 && useTurn ? min(3, mon.mh - res.mhp) : 0
      let cd1 = mon.cd + preCd - (useTurn && !ex ? 1 : 0)
      let strike = cd1 <= 0
      let dmg = strike ? max(1, mon.atk + random(-1, 1)) : 0
      let ab = K.sp == 3 ? 0 : min(hero.ar, dmg)
      let loss = min(hero.hp, dmg - ab)
      let dr = strike && K.sp == 2 ? min(hero.mp, 4) : 0
      mon = merge(mon, {hp: res.mhp + rg, cd: strike ? mon.ev : min(cd1, mon.ev + 3)})
      hero = merge(hero, {hp: hero.hp - loss, ar: hero.ar - ab, mp: hero.mp - dr})
      fx = lFx + (ex ? [{k: 12, s: "LINE OF FOUR: EXTRA MOVE", t0: tE}] : [])
        + (rg > 0 ? [{k: 2, w: 1, s: "+${rg}", c: "#6fe05a", t0: tE + 0.05, dm: -rg}] : [])
        + (strike ? [{k: 5, t0: tE + 0.08}, {k: 4, t0: tE + 0.24}]
          + (loss > 0 ? [{k: 2, w: 0, s: "-${loss}", c: "#ff5a4a", t0: tE + 0.24, dh: -loss}] : [])
          + (ab > 0 ? [{k: 2, w: 2, s: "-${ab}", c: "#8ab8ff", t0: tE + 0.24, da: -ab}] : [])
          + (dr > 0 ? [{k: 2, w: 3, s: "-${dr}", c: "#d090ff", t0: tE + 0.24, dp: -dr}] : [])
          + (loss == 0 ? [{k: 2, w: 0, s: "BLOCKED", c: "#8ab8ff", t0: tE + 0.24}] : []) : [])
      fxLen = tE + (strike ? 0.8 : 0.3)
      if hero.hp <= 0 {
        card = "dead"
        best = max(best, stage - 1)
        rmode = ""
        fx = fx + [{k: 7, s: "DEFEAT", s2: "THE ${K.n} WINS", t0: tE + 0.6}]
        fxLen = tE + 2
      }
      if strike { haptic() }
    }
    fxTap = time
    fxAt = -1
    anim = true
  }

  back: mode != "title"
  onBack: mode = "title"

  // ---- the art ----------------------------------------------------------------------------------
  let INK = "#0c0a10"
  let SP_BLADE = """
    .....oo.....
    ....oRho....
    ...oRhhRo...
    ..oRhRRRRo..
    .oRhRRRRRro.
    oRhRRRRRRrro
    oRRRRRRRrrro
    .oRRRRRrrro.
    ..oRRRrrro..
    ...oRrrro...
    ....orro....
    .....oo.....
  """
  let SP_SKULL = """
    ...oooooo...
    ..oWWWWWWo..
    .oWhWWWWWWo.
    .oWWWWWWWWo.
    .oWooWWooWo.
    .oWooWWooWo.
    .oWWWooWWWo.
    ..oWWWWWWo..
    ...oWoWoWo..
    ...oWWWWWo..
    ....ooooo...
    ............
  """
  let SP_SHIELD = """
    .oooooooooo.
    oBBBBBBBBBBo
    oBhhBXXBBBbo
    oBhBBXXBBBbo
    oBXXXXXXXXbo
    oBXXXXXXXXbo
    .oBBBXXBBbo.
    .oBBBXXBBbo.
    ..oBBXXBbo..
    ...oBBBbo...
    ....oBbo....
    .....oo.....
  """
  let SP_HEART = """
    ............
    .ooo....ooo.
    oGGGo..oGGGo
    oGhhGooGGGGo
    oGhGGGGGGGgo
    oGGGGGGGGGgo
    .oGGGGGGGgo.
    ..oGGGGGgo..
    ...oGGGgo...
    ....oGgo....
    .....oo.....
    ............
  """
  let SP_STAR = """
    .....oo.....
    ....oPPo....
    ....oPPo....
    ...oPhPPo...
    ooooPhPPPooo
    oPPPhPPPPPPo
    .oPPPPPPPPo.
    ..oPPPPPpo..
    ..oPPPPPpo..
    .oPPpooPPpo.
    .oPpo..oPpo.
    .ooo....ooo.
  """
  let SP_COIN = """
    ...oooooo...
    ..oYYYYYYo..
    .oYhhhYYYYo.
    oYhYyyyyYyYo
    oYhYyYYYYyYo
    oYYYyYYYYyYo
    oYYYyYYYYyYo
    oYYYyYYYYyYo
    oYYYYyyyyyYo
    .oYYYYYYyyo.
    ..oyyyyyyo..
    ...oooooo...
  """
  let P_BLADE = {o: INK, R: "#e8404a", h: "#ffb0a8", r: "#a8202e"}
  let P_SKULL = {o: INK, W: "#e8e4d8", h: "#ffffff"}
  let P_SHIELD = {o: INK, B: "#3e7ae0", h: "#a8c8ff", b: "#24509e", X: "#f0c040"}
  let P_HEART = {o: INK, G: "#4ec85a", h: "#b4f4a8", g: "#2e8a3a"}
  let P_STAR = {o: INK, P: "#b060f0", h: "#e8c0ff", p: "#7a30b0"}
  let P_COIN = {o: INK, Y: "#f0c040", h: "#fff0a0", y: "#b88a20"}
  // ---- the gems again as pictures, one drawing call each (made from the art above) ----
  asset IMG_BLADE = base64""
  asset IMG_SKULL = base64""
  asset IMG_SHIELD = base64""
  asset IMG_HEART = base64""
  asset IMG_STAR = base64""
  asset IMG_COIN = base64""
  let GA = [SP_BLADE, SP_SKULL, SP_SHIELD, SP_HEART, SP_STAR, SP_COIN]
  let GP = [P_BLADE, P_SKULL, P_SHIELD, P_HEART, P_STAR, P_COIN]
  let GI = [IMG_BLADE, IMG_SKULL, IMG_SHIELD, IMG_HEART, IMG_STAR, IMG_COIN]

  // the knight, facing the foe
  let SP_HERO = """
    ......oPPo......
    .....oPPPPo..oo.
    ....oHHHHHHo.oWo
    ...oHhhHHHHHooWo
    ...oHhHHHHHHooWo
    ...oHHHVVVVVooWo
    ...oHHHHHHHHooWo
    ....oHHHHHHo.oWo
    .oooooooooooooWo
    oSSSoBBbbBBoowwo
    oSXSoBBbbBBoKKo.
    oSXSoBBBBBBoKo..
    oSSSoBBBBBBoo...
    .oSoooLLoLLo....
    ..o..oLLoLLo....
    ....oFFFoFFFo...
  """
  let P_HERO = {o: INK, P: "#e8404a", H: "#b8c0d0", h: "#eef2fa", V: "#20202a", W: "#eef2fa", w: "#f0c040", K: "#e8b088", S: "#c8423a", X: "#f0c040", B: "#4a7ad0", b: "#2e5096", L: "#5a5068", F: "#3a3040"}
  let P_DEAD = {o: "#16141c", P: "#5a4448", H: "#5a5866", h: "#6e6c7a", V: "#16141c", W: "#6e6c7a", w: "#5a5866", K: "#5e5450", S: "#4a3a40", X: "#5a5866", B: "#3e3c4a", b: "#34323e", L: "#34323e", F: "#26242e"}
  // the foes, facing the knight
  let SP_SLIME = """
    ................
    ................
    ................
    ................
    ................
    ......oooo......
    ....ooGGGGoo....
    ...oGGhhGGGGo...
    ..oGGhGGGGGGGo..
    ..oGGGGGGGGGGo..
    .oGGGEEGGGEEGGo.
    .oGGGEoGGGEoGGo.
    .oGGGGGGGGGGGGo.
    oGGGGGGmmmGGGGGo
    oGGGGGGGGGGGGGgo
    .oooooooooooooo.
  """
  let SP_BAT = """
    ................
    ................
    ................
    o..............o
    oo....o..o....oo
    oWo...oooo...oWo
    oWWo.oBBBBo.oWWo
    oWWWoBEBBEBoWWWo
    oWWWWBBBBBBWWWWo
    .oWWWBBttBBWWWo.
    ..oWWoBBBBoWWo..
    ...oWooBBooWo...
    ....o..oo..o....
    ................
    ................
    ................
  """
  let SP_GOBLIN = """
    ................
    ................
    ....oooooooo....
    oo.oGGGGGGGGo.oo
    oGooGGGGGGGGooGo
    .oGGGYYGGYYGGGo.
    ..oGGYoGGYoGGo..
    ...oGGGGGGGGo...
    ....oGmmmmGo..o.
    ...ooooooooo.oWo
    ..oGoTTTTTToGWo.
    ..oGoTTTTTToWo..
    ...ooTTTTTToo...
    ....oGGooGGo....
    ....oGGooGGo....
    ...oooo..oooo...
  """
  let SP_SKELETON = """
    .....oooooo.....
    ....oWWWWWWo....
    ...oWWWWWWWWo...
    ...oWooWWooWo...
    ...oWooWWooWo...
    ...oWWWooWWWo...
    ....oWmWmWmo....
    .....oooooo..o..
    ...ooWWWWWWooWo.
    ..oWoWooooWoWo..
    ..oWoWWWWWWoo...
    ...ooWooooWo....
    .....oWWWWo.....
    .....oWooWo.....
    ....oWo..oWo....
    ....ooo..ooo....
  """
  let SP_TROLL = """
    ....oooooooo....
    ...oOOOOOOOOo...
    ..oOOOOOOOOOOo..
    ..oOOYoOOOYoOo..
    ..oOOOOOnnOOOo..
    ..oOtOOOOOOtOo..
    ...oOttttttOo...
    .oooOOOOOOOOooo.
    oOOoMMMMMMMMoOOo
    oOOoMMMMMMMMoOOo
    oOOoMMBBBBMMoOOo
    .ooOMMMMMMMMOoo.
    ...oMMMMMMMMo...
    ...oLLLooLLLo...
    ...oLLLooLLLo...
    ..oFFFFooFFFFo..
  """
  let SP_WOLF = """
    ................
    ................
    ................
    ................
    ..o.o...........
    .oGoGo..........
    .oGGGGo.........
    oGEGGGGo.....oo.
    oGGGGGGoooooogo.
    onnGGGGGGGGGGgo.
    .ooWGGGGGGGGGGo.
    ..oWWGGGGGGGGGo.
    ...oGGoooooGGo..
    ...oGo....oGo...
    ..oGo....oGo....
    ..oo.....oo.....
  """
  let SP_GOLEM = """
    ....oooooooo....
    ...oSSSSSSSSo...
    ...oSsSSSSsSo...
    ...oSCCSSCCSo...
    ...oSSSSSSSSo...
    .oooossssssoooo.
    oSSSoSSSSSSoSSSo
    oSsSoSSCCSSoSsSo
    oSSSoSSCCSSoSSSo
    oSSSoSSSSSSoSSSo
    oSsSosSSSSsoSsSo
    .ooooSSSSSSoooo.
    ....oSSSSSSo....
    ...oSSSooSSSo...
    ...oSSSooSSSo...
    ..ooooo..ooooo..
  """
  let SP_WRAITH = """
    ......oooo......
    ....ooKKKKoo....
    ...oKKKKKKKKo...
    ..oKKkkkkkkKKo..
    ..oKkkEkkEkkKo..
    ..oKkkkkkkkkKo..
    ..oKKkkkkkkKKo..
    .oKKKKKKKKKKKKo.
    oKKoKKKKKKKKoKKo
    oCCoKKKKKKKKoCCo
    .oo.oKKKKKKo.oo.
    ....oKKKKKKo....
    ....oKKKKKKKo...
    ...oKKKoKKKKo...
    ...oKKo.oKKo....
    ....oo...oo.....
  """
  let SP_WARLOCK = """
    ........oo......
    .......oPPo.....
    ......oPPo......
    .....oPPPPo.....
    ....oPPPPPPo....
    ..oooooooooooo..
    .oCo.oSSSSo.....
    .oCo.oYSSYo.....
    .oWo.oSSSSo.....
    .oWooPoWWoPo....
    .oWoPPPWWPPPo...
    .oWoPPPPPPPPo...
    .oWooPPPPPPo....
    .oWo.oPPPPPPo...
    .oWooPPPPPPPPo..
    ..o.ooooooooooo.
  """
  let SP_DRAGON = """
    ..o.o...........
    .oRoRo..........
    .oRRRRo...oo....
    oRYRRRRo.oWWo...
    oRRRRRRRoWWWWo..
    oRRRRRRRoWWWWWo.
    .ottoRRRRoWWWWo.
    ..oooRRRRRoWWWo.
    ....oRRRRRRoWWo.
    ...oRRRBBRRRooo.
    ..oRRRBBBBRRRo..
    ..oRRRBBBBRRRRo.
    ..oRRoBBBBRRRRRo
    ..oRo.oRRoRRooRo
    .oRRo.oRRooo..o.
    .ooo..ooo.......
  """
  let MA = [SP_SLIME, SP_BAT, SP_GOBLIN, SP_SKELETON, SP_TROLL, SP_WOLF, SP_GOLEM, SP_WRAITH, SP_WARLOCK, SP_DRAGON]
  let MP = [
    {o: INK, G: "#4cc4b0", h: "#b8f4e8", g: "#2a8a7a", E: "#ffffff", m: "#14303a"},
    {o: INK, W: "#6a4a7e", B: "#3e2e4e", E: "#ff5a4a", t: "#f0ead8"},
    {o: INK, G: "#7ab04a", Y: "#ffe14a", m: "#3a2020", T: "#8a5a30", W: "#d0d8e0"},
    {o: INK, W: "#e8e4d8", m: INK},
    {o: INK, O: "#7a9a6a", Y: "#ff5a4a", n: "#5a7a4a", t: "#f0ead8", M: "#7a5a3a", B: "#4a3a2a", L: "#5a6a4a", F: "#3a2a20"},
    {o: INK, G: "#8a8aa0", g: "#5a5a70", E: "#ffe14a", n: "#2a2a34", W: "#e0e0ec"},
    {o: INK, S: "#8a8478", s: "#6a645a", C: "#5ae0ff"},
    {o: INK, K: "#5a4a7a", k: "#14101c", E: "#7affd0", C: "#c8c0e0"},
    {o: INK, P: "#6a3aa0", S: "#2a1a3a", Y: "#ff5af0", C: "#ff5af0", W: "#8a5a30"},
    {o: INK, R: "#c8303a", Y: "#ffe14a", t: "#f0e8d0", W: "#8a2030", B: "#f0a050"}
  ]
  // the spells' icons
  let SP_FIRE = """
    ......o.....
    .....oRo....
    ....oRRo.o..
    ...oRYRooRo.
    ..oRYYRRoRo.
    .oRYYYYRRRo.
    .oRYWWYYRRo.
    oRYYWWWYYRRo
    oRYWWWWWYYRo
    .oRYWWWWYRo.
    ..oRYYYYRo..
    ...oooooo...
  """
  let SP_FROST = """
    .....oo.....
    ..o..oIo.o..
    .oIo.oIooIo.
    ..oIooIoIo..
    ooooIoIIoooo
    oIIIIIiIIIIo
    oooIIiIIoooo
    ..oIoIIoIo..
    .oIooIo.oIo.
    ..o..oIo.o..
    .....oIo....
    ......o.....
  """
  let P_FIRE = {o: INK, R: "#e8503a", Y: "#ffb040", W: "#fff0a0"}
  let P_FROST = {o: INK, I: "#a8e0ff", i: "#ffffff"}
  // the camp's fire
  let SP_LOGS = """
    ..oooo..oooo..
    .oLLLLooLLLLo.
    oLlLLLLLLLlLLo
    .oooooooooooo.
  """
  let P_LOGS = {o: INK, L: "#7a4a2a", l: "#a0683a"}
  // Buttons are pixel art: a light band on top, the face, a shaded band at its foot and a dark lip under it.
  let BTN = {
    wood: ["#f0c890", "#b07a44", "#84542a", "#3e2410"],
    off: ["#6a6680", "#46425a", "#36324a", "#1a1824"],
    go: ["#ffe9a0", "#f4b840", "#c8862a", "#6e400e"],
    red: ["#ffaa94", "#e8504a", "#b8333a", "#621822"],
    fire: ["#ffb89a", "#d8583a", "#a83a22", "#5a1a0e"],
    frost: ["#c8ecff", "#4a9ad8", "#2e70a8", "#123a5a"],
    blade: ["#ffb0b8", "#b8303e", "#8a2030", "#4a0e18"]
  }
  let SPB = [BTN.fire, BTN.frost, BTN.blade]
  let SPA = [SP_FIRE, SP_FROST, SP_BLADE]
  let SPP = [P_FIRE, P_FROST, P_BLADE]
  // where each gem flies when it pops: blades and skulls at the foe, shields to the armor, hearts to
  // the knight, stars to the mana, coins to the purse
  let GDX = LX + 9 * len("STAGE ${stage}") + 16
  let TG = [[MXc, GY - 8 * P], [MXc, GY - 8 * P], [LX + 11, PY + 11], [HXc, GY - 8 * P], [MPX + MPW / 2, PY + 12], [GDX + 8, TOP + 14]]
  let NP = [[HXc, GY - 16 * P - 8], [MXc, GY - 16 * P - 8], [LX + 12, PY - 6], [MPX + MPW / 2, PY - 6], [GDX + 20, TOP + 34]]

  Box {
    fill: true
    background: background
    // ---- what stays put: the title's faint bricks, the board's cells and the arena's floor -------
    Canvas {
      fill: true
      if mode == "title" || mode == "camp" {
        for r in range(ceil(SH / 16) + 1) {
          rect(0, r * 16, SW, 1, fill: alpha(foreground, 0.05))
          for k in range(ceil(SW / 32) + 1) { rect(k * 32 + (r % 2) * 16, r * 16, 1, 16, fill: alpha(foreground, 0.05)) }
        }
      }
      if mode == "fight" {
        rect(BX - 6, BY - 6, 8 * T + 12, 8 * T + 12, radius: 6 * corners, fill: INK)
        for c in range(64) { rect(BX + c % 8 * T, BY + floor(c / 8) * T, T, T, fill: (c % 8 + floor(c / 8)) % 2 == 0 ? "#221e2b" : "#2a2534") }
        // the floor they stand on, in flagstones
        rect(LX, GY, LW, 3, fill: alpha(foreground, 0.16))
        for k in range(ceil(LW / 28)) {
          rect(LX + k * 28 + (k % 2) * 6, GY + 9, 16, 2, fill: alpha(foreground, 0.07))
        }
      }
    }
    // ---- the gems: this reads the clock only while a move plays out ----------------------------
    Canvas {
      fill: true
      if mode == "fight" && len(board) == 64 {
        let tt = anim ? time : 0
        let now0 = !anim ? 99 : fxAt < 0 ? 0 : tt - fxAt
        // a time far ahead is from before a reload, when the clock started again
        let now = now0 < 0 || now0 > 30 ? 99 : now0
        let FX = now == 99 ? [] : fx
        // which wave of the cascade is playing: its gems pop, then the rest fall
        let wi = count(steps, s => now >= s.t) - 1
        let S = wi >= 0 ? steps[wi] : null
        let swapping = len(b0) == 64 && swp.p >= 0 && now < (swp.ok ? 0.16 : 0.3)
        let ph = swapping ? 1 : S != null && now < S.t + 0.18 ? 2 : S != null && now < S.t + 0.42 ? 3 : len(steps) > 0 && now < steps[0].t && len(b0) == 64 ? 4 : 0
        let DB = ph == 1 || ph == 4 ? b0 : ph == 2 ? S.b : ph == 3 ? (wi + 1 < len(steps) ? steps[wi + 1].b : board) : board
        let es = ph == 1 ? (swp.ok ? now / 0.16 : (now < 0.15 ? now / 0.15 : (0.3 - now) / 0.15)) : 0
        let ep = ph == 2 ? (now - S.t) / 0.18 : 0
        let ef = ph == 3 ? pow((now - S.t - 0.18) / 0.24, 2) : 1
        clip(BX, BY, 8 * T, 8 * T) {
          for c in range(64) {
            let g = DB[c]
            let cx = c % 8
            let cy = floor(c / 8)
            // a swap slides the two gems past each other
            let ox = ph == 1 && c == swp.p ? (swp.q % 8 - cx) * es : ph == 1 && c == swp.q ? (swp.p % 8 - cx) * es : 0
            let oy = ph == 1 && c == swp.p ? (floor(swp.q / 8) - cy) * es : ph == 1 && c == swp.q ? (floor(swp.p / 8) - cy) * es : 0
            let yy = ph == 3 ? lerp(S.fy[c], cy, ef) : cy + oy
            let x0 = BX + (cx + ox) * T + 0.5 * q
            let y0 = BY + yy * T + 0.5 * q
            if ph == 2 && S.m[c] {
              // popping: a white flash, then it shrinks away
              if ep < 0.4 {
                image(GI[g], x0, y0, 12 * q, 12 * q, color: "#ffffff")
              } else {
                scale(1.4 - ep, 1.4 - ep, x0 + 6 * q, y0 + 6 * q) { image(GI[g], x0, y0, 12 * q, 12 * q) }
              }
            } else if yy > -1 {
              image(GI[g], x0, y0, 12 * q, 12 * q)
            }
          }
        }
        // the gem a tap picked
        if sel >= 0 && !anim {
          rect(BX + sel % 8 * T + 1, BY + floor(sel / 8) * T + 1, T - 2, T - 2, radius: 4, stroke: "#ffffff", width: 3)
        }
        // ---- the popped gems flying off to where they count, and the blades' glints ----
        for f in FX {
          if f.k == 1 && now >= f.t0 && now < f.t0 + 0.3 {
            let e = (now - f.t0) / 0.3
            let ax = BX + (f.c % 8 + 0.5) * T
            let ay = BY + (floor(f.c / 8) + 0.5) * T
            let pz = lerp(q, 1.4, e)
            image(GI[f.g], lerp(ax, TG[f.g][0], e) - 6 * pz, lerp(ay, TG[f.g][1], e) - sin(e * 3.1416) * 40 - 6 * pz, 12 * pz, 12 * pz)
          } else if f.k == 10 && now >= f.t0 && now < f.t0 + 0.45 {
            let e = (now - f.t0) / 0.45
            let gx = BX + (f.c % 8 + 0.5) * T
            let gy = BY + (floor(f.c / 8) + 0.5) * T
            rect(gx - T / 2, gy - T / 2, T, T, fill: alpha("#ffffff", 0.5 * (1 - e)))
            for k in range(4) {
              let ang = k * 1.5708 + e * 1.2
              rect(gx + sin(ang) * e * 0.7 * T - 2, gy - cos(ang) * e * 0.7 * T - 2, 4, 4, fill: alpha("#ffd0d8", 1 - e))
            }
          }
        }
        // ---- a word over the fight: a combo, an extra move, a fresh deal ----
        for f in FX {
          if f.k == 12 && now >= f.t0 && now < f.t0 + 0.9 {
            let e = (now - f.t0) / 0.9
            let ty = AT + 100 - e * 16
            layer(clamp(min(e * 10, (1 - e) * 5), 0, 1)) {
              rect(LX + LW / 2 - 130, ty - 14, 260, 28, radius: 4, fill: alpha(INK, 0.8))
              text(f.s, LX + LW / 2 + 1, ty + 1, size: 9, color: INK, font: press, align: center)
              text(f.s, LX + LW / 2, ty, size: 9, color: "#ffe14a", font: press, align: center)
            }
          }
        }
      }
    }
    // ---- the knight and the foe, always moving a little, and the spells that strike ---------------
    Canvas {
      fill: true
      if mode == "fight" && len(board) == 64 {
        let tt = time
        let now0 = !anim ? 99 : fxAt < 0 ? 0 : tt - fxAt
        let now = now0 < 0 || now0 > 30 ? 99 : now0
        let FX = now == 99 ? [] : fx
        // ---- the knight: a step forward for each strike, a shake when hit ----
        let lu = FX.find(f => f.k == 6 && now >= f.t0 && now < f.t0 + 0.26)
        let hu = FX.find(f => f.k == 4 && now >= f.t0 && now < f.t0 + 0.3)
        let hx = HXc + (lu == null ? 0 : sin((now - lu.t0) / 0.26 * 3.1416) * (MXc - HXc) * 0.3) + (hu == null ? 0 : sin((now - hu.t0) * 70) * 3)
        rect(HXc - 6 * P, GY - 1.5 * P, 12 * P, 2.5 * P, radius: P, fill: alpha("#000000", 0.35))
        if card == "dead" && (now == 99 || now > fxLen - 1.4) {
          rotate(-90, hx, GY - 4 * P) { sprite(SP_HERO, hx - 8 * P, GY - 12 * P, P, palette: P_DEAD) }
        } else if hu != null && now - hu.t0 < 0.12 {
          sprite(SP_HERO, hx - 8 * P, GY - 16 * P, P, color: "#ffffff")
        } else {
          sprite(SP_HERO, hx - 8 * P, GY - 16 * P - floor(tt * 2) % 2 * 0.5 * P, P, palette: P_HERO)
        }
        // ---- the foe: it lunges at its blow, flashes when struck, and breaks up when it falls ----
        let dth = FX.find(f => f.k == 11)
        let ml = FX.find(f => f.k == 5 && now >= f.t0 && now < f.t0 + 0.3)
        let mh = FX.find(f => f.k == 3 && now >= f.t0 && now < f.t0 + 0.2)
        let fly = mon.k == 1 || mon.k == 7
        let lift = fly ? (3 + sin(tt * 7) * 1.5) * P : mon.k == 0 ? 0 : floor(tt * 1.6) % 2 * 0.5 * P
        let mx = MXc - (ml == null ? 0 : sin((now - ml.t0) / 0.3 * 3.1416) * (MXc - HXc) * 0.4) + (mh == null ? 0 : sin((now - mh.t0) * 70) * 3)
        let sq = mon.k == 0 ? 1 + sin(tt * 3.5) * 0.04 : 1
        if mon.hp > 0 || (dth != null && now < dth.t0) {
          rect(MXc - 6 * P, GY - 1.5 * P, 12 * P, 2.5 * P, radius: P, fill: alpha("#000000", fly ? 0.2 : 0.35))
          scale(1, sq, mx, GY) {
            if mh != null && now - mh.t0 < 0.12 {
              sprite(MA[mon.k], mx - 8 * P, GY - 16 * P - lift, P, color: "#ffffff")
            } else {
              layer(mon.k == 7 ? 0.85 : 1) { sprite(MA[mon.k], mx - 8 * P, GY - 16 * P - lift, P, palette: MP[mon.k]) }
            }
          }
        } else if dth != null && now < dth.t0 + 0.6 {
          let e = (now - dth.t0) / 0.6
          layer(1 - e) { sprite(MA[mon.k], MXc - 8 * P, GY - 16 * P - lift - e * 6 * P, P, color: "#ffffff") }
          for k in range(10) { rect(MXc + sin(k * 0.628 + 0.2) * e * 10 * P - P / 2, GY - 8 * P - cos(k * 0.628 + 0.2) * e * 10 * P - P / 2, P, P, fill: alpha(k % 2 == 0 ? "#ffffff" : "#ffe14a", 1 - e)) }
        }
        // ---- fire and frost ----
        for f in FX {
          if f.k == 8 && now >= f.t0 && now < f.t0 + 0.5 {
            // a fireball, and its burst
            let e = (now - f.t0) / 0.36
            if e < 1 {
              let fx0 = lerp(HXc + 4 * P, MXc, e)
              let fy0 = GY - 9 * P - sin(e * 3.1416) * 4 * P
              circle(fx0, fy0, 3 * P, fill: alpha("#ff7a3a", 0.6))
              sprite(SP_FIRE, fx0 - 6 * P / 3, fy0 - 6 * P / 3, P / 3 * 1.0, palette: P_FIRE)
            } else {
              let e2 = (e - 1) / 0.4
              circle(MXc, GY - 8 * P, (4 + 6 * e2) * P, fill: alpha("#ff9a3c", 0.7 * (1 - e2)))
            }
          } else if f.k == 9 && now >= f.t0 && now < f.t0 + 0.9 {
            // frost on the foe
            let e = (now - f.t0) / 0.9
            layer(1 - e * e) {
              rect(MXc - 7 * P, GY - 16 * P, 14 * P, 16 * P, radius: 2 * P, fill: alpha("#a8e0ff", 0.25))
              for k in range(6) { sprite(SP_FROST, MXc + sin(k * 1.047 + e * 1.5) * 7 * P - 6, GY - 8 * P - cos(k * 1.047 + e * 1.5) * 7 * P - 6, 1, palette: P_FROST) }
            }
          }
        }
      }
    }
    // ---- health, armor and mana, what the foe means to do, and the words: this reads the clock
    // only while a move plays out ----
    Canvas {
      fill: true
      if mode == "fight" && len(board) == 64 {
        let tt = anim ? time : 0
        let now0 = !anim ? 99 : fxAt < 0 ? 0 : tt - fxAt
        let now = now0 < 0 || now0 > 30 ? 99 : now0
        let FX = now == 99 ? [] : fx
        // health, armor and mana as they stand at this point of the move
        let FUT = FX.filter(f => f.k == 2 && f.t0 > now)
        let sHp = hero.hp - sum(FUT.map(f => f.dh ?? 0))
        let sAr = hero.ar - sum(FUT.map(f => f.da ?? 0))
        let sMp = hero.mp - sum(FUT.map(f => f.dp ?? 0))
        let sMh = mon.hp + sum(FUT.map(f => f.dm ?? 0))
        let K = KD[mon.k]
        // ---- the knight's bar ----
        text("KNIGHT LV${hero.lv}", LX, AT + 2, size: 8, color: accent, font: press)
        rect(LX, HBY, HBW, 16, radius: 3, fill: INK)
        rect(LX + 2, HBY + 2, (HBW - 4) * clamp(sHp / hero.mh, 0, 1), 12, radius: 2, fill: sHp <= hero.mh / 3 ? "#ff5a4a" : "#6fe05a")
        text("${max(0, sHp)}/${hero.mh}", LX + HBW / 2 + 1, HBY + 9, size: 7, color: INK, font: press, align: center)
        text("${max(0, sHp)}/${hero.mh}", LX + HBW / 2, HBY + 8, size: 7, color: "#ffffff", font: press, align: center)
        rect(LX, HBY + 20, HBW, 4, radius: 2, fill: alpha(foreground, 0.12))
        rect(LX, HBY + 20, HBW * clamp(hero.xp / (hero.lv * 10), 0, 1), 4, radius: 2, fill: accent)
        sprite(SP_BLADE, LX, HBY + 30, 1.3, palette: P_BLADE)
        text("ATK ${hero.atk}", LX + 20, HBY + 38, size: 7, color: foreground, font: press)
        // ---- the foe's bar, and what it means to do ----
        text(K.n, LX + LW, AT + 2, size: 8, color: "#ff8a7a", font: press, align: end)
        rect(MBX, HBY, HBW, 16, radius: 3, fill: INK)
        rect(MBX + 2, HBY + 2, (HBW - 4) * clamp(sMh / mon.mh, 0, 1), 12, radius: 2, fill: "#e8404a")
        text("${max(0, sMh)}/${mon.mh}", MBX + HBW / 2 + 1, HBY + 9, size: 7, color: INK, font: press, align: center)
        text("${max(0, sMh)}/${mon.mh}", MBX + HBW / 2, HBY + 8, size: 7, color: "#ffffff", font: press, align: center)
        if mon.hp > 0 {
          let soon = mon.cd <= 1
          text(soon ? "HITS NEXT MOVE: ${mon.atk}" : "HITS ${mon.atk} IN ${mon.cd}", LX + LW, HBY + 30, size: 7, color: soon ? "#ff5a4a" : foreground, font: press, align: end)
          for k in range(min(mon.cd, 7)) { rect(LX + LW - 6 - k * 10, HBY + 42, 7, 7, radius: 1, fill: soon ? "#ff5a4a" : alpha(foreground, 0.5)) }
          text((mon.def > 0 ? "ARMOR ${mon.def}" : "") + (mon.def > 0 && K.sp > 0 ? " · " : "") + SPT[K.sp], LX + LW, HBY + 60, size: 6, color: muted, font: press, align: end)
        }
        // ---- armor and mana ----
        sprite(SP_SHIELD, LX, PY, 1.8, palette: P_SHIELD)
        text("${sAr}", LX + 28, PY + 12, size: 10, color: sAr > 0 ? "#8ab8ff" : muted, font: press)
        sprite(SP_STAR, MPX - 26, PY, 1.8, palette: P_STAR)
        rect(MPX, PY + 3, MPW, 18, radius: 3, fill: INK)
        rect(MPX + 2, PY + 5, (MPW - 4) * clamp(sMp / MAXMP, 0, 1), 14, radius: 2, fill: "#9a4ae0")
        for k in range(1, MAXMP) { rect(MPX + 2 + (MPW - 4) * k / MAXMP, PY + 5, 1, 14, fill: alpha(INK, 0.35)) }
        text("${sMp}/${MAXMP}", MPX + MPW / 2 + 1, PY + 13, size: 7, color: INK, font: press, align: center)
        text("${sMp}/${MAXMP}", MPX + MPW / 2, PY + 12, size: 7, color: "#ffffff", font: press, align: center)
        // ---- the numbers and the banners ----
        for f in FX {
          if f.k == 2 && now >= f.t0 && now < f.t0 + 0.9 {
            let e = now - f.t0
            let nx = NP[f.w][0]
            let ny = NP[f.w][1] - e * 30
            layer(clamp((0.9 - e) * 4, 0, 1)) {
              text(f.s, nx + 1, ny + 1, size: 10, color: INK, font: press, align: center)
              text(f.s, nx, ny, size: 10, color: f.c, font: press, align: center)
            }
          } else if f.k == 7 && now >= f.t0 && now < f.t0 + 1.5 {
            // a banner across the fight
            let e = (now - f.t0) / 1.5
            let a = clamp(min(e * 8, (1 - e) * 6), 0, 1)
            let cy = (AT + GY) / 2 + 20
            layer(a) {
              rect(LX, cy - 30, LW, 60, fill: alpha(INK, 0.85))
              rect(LX, cy - 30, LW, 2, fill: "#ffe14a")
              rect(LX, cy + 28, LW, 2, fill: "#ffe14a")
              text(f.s, LX + LW / 2 + (1 - a) * 30, cy - 8, size: 16, color: "#ffffff", font: press, align: center)
              text(f.s2, LX + LW / 2 - (1 - a) * 30, cy + 14, size: 7, color: "#d8d4ec", font: press, align: center)
            }
          }
        }
      }
    }
    // ---- what moves on the title and at camp, on its own so the buttons are not drawn every frame ---
    Canvas {
      fill: true
      if mode == "camp" {
        let tt = time
        // the knight by the fire
        let fy0 = SCY + 96
        circle(SCX + 30, fy0 - 14, 46 + hash(floor(tt * 8)) * 4, fill: alpha("#ff9a3c", 0.1))
        sprite(SP_HERO, SCX - 86, fy0 - 80, 5, palette: P_HERO)
        sprite(SP_LOGS, SCX + 2, fy0 - 16, 4, palette: P_LOGS)
        for k in range(3) {
          let fl = hash(k, floor(tt * 9))
          let fh = (6 + fl * 4 - abs(k - 1) * 2) * 4
          rect(SCX + 14 + k * 10, fy0 - 14 - fh, 10, fh, radius: 4, fill: "#ff8a3a")
          rect(SCX + 17 + k * 10, fy0 - 14 - fh * 0.6, 4, fh * 0.6, radius: 2, fill: "#ffe08a")
        }
        rect(SCX - 100, fy0 + 2, 200, 3, fill: alpha(foreground, 0.16))
      }
      if mode == "title" {
        let tt = time
        // the knight facing a slime, gems tumbling between them
        let sc = LS ? 4 : min(6, SW / 70)
        let ay = LS ? SH * 0.62 : SH * 0.4
        let ax = LS ? SW * 0.27 : SW / 2
        rect(ax - 30 * sc, ay, 60 * sc, 1.5, fill: alpha(foreground, 0.2))
        sprite(SP_HERO, ax - 26 * sc, ay - 16 * sc - floor(tt * 2) % 2 * 0.5 * sc, sc, palette: P_HERO)
        scale(1, 1 + sin(tt * 3.5) * 0.05, ax + 18 * sc, ay) { sprite(SP_SLIME, ax + 10 * sc, ay - 16 * sc, sc, palette: MP[0]) }
        for k in range(3) {
          let g = floor(hash(k, floor(tt / 1.2 + k * 0.33), 5) * 6)
          let e = (tt / 1.2 + k * 0.33) % 1
          image(GI[g], ax - 3 * sc + (k - 1) * 3.5 * sc, ay - 22 * sc + e * 18 * sc - 3 * sc, 6 * sc, 6 * sc)
        }
      }
    }
    // ---- the top bar, the spells, the cards, the camp and the title; touches land here ------------
    Canvas {
      fill: true
      onPress: {
        downAt = [x, y]
        sx = 0
        sy = 0
        swiped = false
        pc = mode == "fight" && card == "" && x >= BX && x < BX + 8 * T && y >= BY && y < BY + 8 * T ? floor((y - BY) / T) * 8 + floor((x - BX) / T) : -1
      }
      onRelease: { downAt = [-1, -1] }
      // a swipe from a gem swaps it with the neighbour that way, once it has gone a third of a cell
      onDrag: {
        sx = sx + dx
        sy = sy + dy
        if pc >= 0 && !swiped && (abs(sx) > T * 0.35 || abs(sy) > T * 0.35) {
          swiped = true
          let d = abs(sx) > abs(sy) ? (sx > 0 ? 1 : -1) : (sy > 0 ? 8 : -8)
          let t2 = pc + d
          if t2 >= 0 && t2 < 64 && (abs(d) == 8 || floor(t2 / 8) == floor(pc / 8)) {
            sw = [pc, t2]
            swN = swN + 1
          }
        }
      }
      onTap: {
        if swiped {
          swiped = false
        } else if mode == "title" {
          let going = rmode != ""
          if y >= TBY && y < TBY + 56 && abs(x - TCX) < 120 {
            if going { mode = rmode } else { fresh = fresh + 1 }
            haptic()
          } else if going && y >= TBY + 70 && y < TBY + 106 && abs(x - TCX) < 110 {
            fresh = fresh + 1
          }
        } else if mode == "camp" {
          if x >= CX0 - CW / 2 && x < CX0 + CW / 2 && y >= CPY && y < CPY + 3 * 58 {
            let b = floor((y - CPY) / 58)
            if y - CPY - b * 58 < 50 && gold >= PR[b] && (b < 2 || hero.hp < hero.mh) {
              gold = gold - PR[b]
              if b == 0 {
                hero = merge(hero, {atk: hero.atk + 1})
                buys = set(buys, 0, buys[0] + 1)
              } else if b == 1 {
                hero = merge(hero, {mh: hero.mh + 8, hp: hero.hp + 8})
                buys = set(buys, 1, buys[1] + 1)
              } else {
                hero = merge(hero, {hp: min(hero.mh, hero.hp + 20)})
              }
              haptic()
            }
          } else if y >= CPY + 3 * 58 + 12 && y < CPY + 3 * 58 + 68 && abs(x - CX0) < CW / 2 {
            stage = stage + 1
            fightN = fightN + 1
            haptic()
          } else if x >= SW - 56 && y < TOP + 40 {
            mode = "title"
          }
        } else if card != "" {
          if !anim && y >= OBY && y < OBY + 50 && abs(x - SW / 2) < 110 {
            if card == "won" {
              // a rest on the way: back a third of full health
              hero = merge(hero, {hp: min(hero.mh, hero.hp + ceil(hero.mh * 0.3))})
              card = ""
              mode = "camp"
              rmode = "camp"
            } else {
              fresh = fresh + 1
            }
            haptic()
          }
        } else if x >= LX + LW - 46 && y < TOP + 32 {
          mode = "title"
        } else if y >= SPY && y < SPY + 46 && x >= LX && x < LX + LW {
          spk = min(2, floor((x - LX) / (SPW + 8)))
          spN = spN + 1
        } else if x >= BX && x < BX + 8 * T && y >= BY && y < BY + 8 * T && !anim {
          // a tap picks a gem; a tap on its neighbour swaps them
          let c = floor((y - BY) / T) * 8 + floor((x - BX) / T)
          if sel >= 0 && ((abs(c - sel) == 1 && floor(c / 8) == floor(sel / 8)) || abs(c - sel) == 8) {
            sw = [sel, c]
            swN = swN + 1
          } else {
            sel = c == sel ? -1 : c
          }
        }
      }
      if mode == "fight" && len(board) == 64 {
        // ---- the top bar: the stage, the purse, the best, and the way to the title ----
        let ty = TOP + 14
        text("STAGE ${stage}", LX, ty, size: 9, color: accent, font: press)
        sprite(SP_COIN, GDX, ty - 9, 1.5, palette: P_COIN)
        text("${gold}", GDX + 22, ty, size: 8, color: foreground, font: press)
        text("BEST ${best}", LX + LW - 54, ty, size: 7, color: muted, font: press, align: end)
        let md = downAt[0] >= LX + LW - 46 && downAt[1] < TOP + 32 ? 2 : 0
        rect(LX + LW - 38, TOP + 2, 38, 24, radius: 4, fill: INK)
        rect(LX + LW - 36, TOP + 4 + md, 34, 18, radius: 3, fill: "#4a4466")
        for k in range(3) { rect(LX + LW - 27, TOP + 8 + md + k * 4, 16, 2, fill: "#ffffff") }
        // ---- the spells ----
        for b in range(3) {
          let x0 = LX + b * (SPW + 8)
          let can = card == "" && hero.mp >= COST[b] && mon.hp > 0
          let pal = can ? SPB[b] : BTN.off
          let pd = downAt[1] >= SPY && downAt[1] < SPY + 46 && downAt[0] >= x0 && downAt[0] < x0 + SPW ? 3 : 0
          rect(x0, SPY + 4, SPW, 42, radius: 4, fill: pal[3])
          rect(x0, SPY + pd, SPW, 42, radius: 4, fill: pal[1], stroke: INK, width: 2)
          rect(x0 + 3, SPY + pd + 3, SPW - 6, 4, radius: 2, fill: pal[0])
          rect(x0 + 3, SPY + pd + 33, SPW - 6, 5, radius: 2, fill: pal[2])
          layer(can ? 1 : 0.45) { sprite(SPA[b], x0 + 8, SPY + pd + 9, 2, palette: SPP[b]) }
          text(SPN[b], x0 + 38 + (SPW - 38) / 2 + 1, SPY + pd + 15, size: 8, color: INK, font: press, align: center)
          text(SPN[b], x0 + 38 + (SPW - 38) / 2, SPY + pd + 14, size: 8, color: can ? "#ffffff" : "#a8a2c0", font: press, align: center)
          text("${COST[b]}", x0 + 38 + (SPW - 38) / 2 + 6, SPY + pd + 29, size: 7, color: can ? "#f0d8ff" : "#8a84a0", font: press, align: center)
          sprite(SP_STAR, x0 + 38 + (SPW - 38) / 2 - 14, SPY + pd + 23, 0.95, palette: P_STAR)
        }
        // ---- a fight won or lost ----
        if card != "" && !anim {
          rect(0, 0, SW, SH, fill: alpha("#06070b", 0.65))
          let ccw = min(SW - 40, 320)
          let ccx = SW / 2 - ccw / 2
          let won = card == "won"
          let BT = won ? BTN.go : BTN.red
          rect(ccx, CY + 4, ccw, 270, radius: 14 * corners, fill: alpha("#000000", 0.35))
          rect(ccx, CY, ccw, 270, radius: 14 * corners, fill: surface, stroke: INK, width: 2)
          rect(ccx - 10, CY + 16, ccw + 20, 44, radius: 4, fill: won ? "#c8862a" : "#8a2a32", stroke: INK, width: 2)
          rect(ccx - 7, CY + 19, ccw + 14, 3, radius: 1.5, fill: alpha("#ffffff", 0.3))
          let hd = won ? "VICTORY" : "DEFEAT"
          text(hd, SW / 2 + 2, CY + 41, size: 16, color: INK, font: press, align: center)
          text(hd, SW / 2, CY + 39, size: 16, color: "#ffffff", font: press, align: center)
          if won {
            text("THE ${KD[mon.k].n} FALLS", SW / 2, CY + 84, size: 8, color: foreground, font: press, align: center)
            text("+${gain.xp} XP", SW / 2 - 40, CY + 112, size: 8, color: accent, font: press, align: center)
            sprite(SP_COIN, SW / 2 + 12, CY + 103, 1.5, palette: P_COIN)
            text("+${gain.gold}", SW / 2 + 52, CY + 112, size: 8, color: foreground, font: press, align: center)
            if gain.up {
              text("LEVEL ${hero.lv}!", SW / 2, CY + 142, size: 11, color: "#6fe05a", font: press, align: center)
              text("ATK +1 · MAX HP +6", SW / 2, CY + 162, size: 7, color: foreground, font: press, align: center)
            }
            text("A REST AT CAMP HEALS A THIRD", SW / 2, CY + 186, size: 6, color: muted, font: press, align: center)
          } else {
            text("SLAIN BY THE ${KD[mon.k].n}", SW / 2, CY + 84, size: 8, color: foreground, font: press, align: center)
            text("ON STAGE ${stage}", SW / 2, CY + 108, size: 8, color: foreground, font: press, align: center)
            text("LEVEL ${hero.lv} · ${kills} FOES BEATEN", SW / 2, CY + 134, size: 7, color: muted, font: press, align: center)
            text("BEST: STAGE ${best}", SW / 2, CY + 164, size: 8, color: accent, font: press, align: center)
          }
          let pd = downAt[1] >= OBY && downAt[1] < OBY + 50 && abs(downAt[0] - SW / 2) < 110 ? 3 : 0
          rect(SW / 2 - 110, OBY + 4, 220, 46, radius: 4, fill: BT[3])
          rect(SW / 2 - 110, OBY + pd, 220, 46, radius: 4, fill: BT[1], stroke: INK, width: 2)
          rect(SW / 2 - 107, OBY + pd + 3, 214, 4, radius: 2, fill: BT[0])
          rect(SW / 2 - 107, OBY + pd + 37, 214, 6, radius: 2, fill: BT[2])
          let bl = won ? "TO CAMP" : "NEW RUN"
          text(bl, SW / 2 + 2, OBY + pd + 25, size: 13, color: INK, font: press, align: center)
          text(bl, SW / 2, OBY + pd + 23, size: 13, color: "#ffffff", font: press, align: center)
        }
      }
      // ---- the camp: a fire, a whetstone, an armorer and potions ----
      if mode == "camp" {
        text("CAMP", SCX, TOP + 30, size: 16, color: accent, font: press, align: center)
        let md = downAt[0] >= SW - 56 && downAt[1] < TOP + 40 ? 2 : 0
        rect(SW - 50, TOP + 6, 38, 24, radius: 4, fill: INK)
        rect(SW - 48, TOP + 8 + md, 34, 18, radius: 3, fill: "#4a4466")
        for k in range(3) { rect(SW - 39, TOP + 12 + md + k * 4, 16, 2, fill: "#ffffff") }
        let fy0 = SCY + 96
        // where the knight stands
        text("LEVEL ${hero.lv} · ATK ${hero.atk}", SCX, fy0 + 26, size: 8, color: foreground, font: press, align: center)
        text("HP ${hero.hp}/${hero.mh}", SCX, fy0 + 46, size: 8, color: hero.hp <= hero.mh / 3 ? "#ff5a4a" : "#6fe05a", font: press, align: center)
        sprite(SP_COIN, SCX - 30, fy0 + 57, 1.5, palette: P_COIN)
        text("${gold}", SCX - 8, fy0 + 66, size: 9, color: foreground, font: press)
        // the wares
        let WN = ["WHETSTONE", "ARMORER", "POTION"]
        let WD = ["ATTACK +1", "MAX HP +8", "HEAL 20 HP"]
        let WA = [SP_BLADE, SP_SHIELD, SP_HEART]
        let WP = [P_BLADE, P_SHIELD, P_HEART]
        for b in range(3) {
          let y0 = CPY + b * 58
          let x0 = CX0 - CW / 2
          let can = gold >= PR[b] && (b < 2 || hero.hp < hero.mh)
          let pal = can ? BTN.wood : BTN.off
          let pd = downAt[1] >= y0 && downAt[1] < y0 + 50 && abs(downAt[0] - CX0) < CW / 2 ? 3 : 0
          rect(x0, y0 + 4, CW, 46, radius: 4, fill: pal[3])
          rect(x0, y0 + pd, CW, 46, radius: 4, fill: pal[1], stroke: INK, width: 2)
          rect(x0 + 3, y0 + pd + 3, CW - 6, 4, radius: 2, fill: pal[0])
          rect(x0 + 3, y0 + pd + 37, CW - 6, 5, radius: 2, fill: pal[2])
          layer(can ? 1 : 0.5) { sprite(WA[b], x0 + 10, y0 + pd + 9, 2.2, palette: WP[b]) }
          text(WN[b], x0 + 46, y0 + pd + 16, size: 9, color: can ? "#ffffff" : "#a8a2c0", font: press)
          text(WD[b], x0 + 46, y0 + pd + 31, size: 7, color: can ? "#3e2410" : "#8a84a0", font: press)
          sprite(SP_COIN, x0 + CW - 60, y0 + pd + 15, 1.3, palette: P_COIN)
          text("${PR[b]}", x0 + CW - 42, y0 + pd + 23, size: 9, color: can ? "#ffe14a" : "#8a84a0", font: press)
        }
        // on to the next foe
        let ny = CPY + 3 * 58 + 12
        let nk = stage % 10
        let pd = downAt[1] >= ny && downAt[1] < ny + 56 && abs(downAt[0] - CX0) < CW / 2 ? 3 : 0
        rect(CX0 - CW / 2, ny + 5, CW, 50, radius: 4, fill: BTN.go[3])
        rect(CX0 - CW / 2, ny + pd, CW, 50, radius: 4, fill: BTN.go[1], stroke: INK, width: 2)
        rect(CX0 - CW / 2 + 3, ny + pd + 3, CW - 6, 4, radius: 2, fill: BTN.go[0])
        rect(CX0 - CW / 2 + 3, ny + pd + 41, CW - 6, 6, radius: 2, fill: BTN.go[2])
        text("FIGHT ON", CX0 + 2, ny + pd + 21, size: 13, color: INK, font: press, align: center)
        text("FIGHT ON", CX0, ny + pd + 19, size: 13, color: "#ffffff", font: press, align: center)
        text("NEXT: THE ${KD[nk].n}" + (nk == 0 ? " · ROUND ${floor(stage / 10) + 1}" : ""), CX0, ny + pd + 37, size: 6, color: "#6e400e", font: press, align: center)
      }
      // ---- the title ----
      if mode == "title" {
        let ty = LS ? TOP + 34 : SH * 0.13
        let ls = min(36, (SW - 30) / 8)
        text("GEMBLADE", SW / 2 + 3, ty + 3, size: ls, color: INK, font: press, align: center)
        text("GEMBLADE", SW / 2, ty, size: ls, color: accent, font: press, align: center)
        text("SWAP GEMS · SLAY MONSTERS", SW / 2, ty + ls * 0.5 + 18, size: 8, color: muted, font: press, align: center)
        // a run under way carries on; else a new one
        let going = rmode != ""
        if going { text("STAGE ${stage} · LEVEL ${hero.lv}", TCX, TBY - 18, size: 8, color: foreground, font: press, align: center) }
        let pd = downAt[1] >= TBY && downAt[1] < TBY + 56 && abs(downAt[0] - TCX) < 120 ? 3 : 0
        rect(TCX - 120, TBY + 5, 240, 50, radius: 4, fill: BTN.go[3])
        rect(TCX - 120, TBY + pd, 240, 50, radius: 4, fill: BTN.go[1], stroke: INK, width: 2)
        rect(TCX - 117, TBY + pd + 3, 234, 4, radius: 2, fill: BTN.go[0])
        rect(TCX - 117, TBY + pd + 41, 234, 6, radius: 2, fill: BTN.go[2])
        let dl = going ? "CONTINUE" : "FIGHT"
        text(dl, TCX + 2, TBY + pd + 26, size: 14, color: INK, font: press, align: center)
        text(dl, TCX, TBY + pd + 24, size: 14, color: "#ffffff", font: press, align: center)
        if going {
          let nd = downAt[1] >= TBY + 70 && downAt[1] < TBY + 106 && abs(downAt[0] - TCX) < 110 ? 2 : 0
          rect(TCX - 110, TBY + 72 + nd, 220, 32, radius: 4, fill: alpha(foreground, 0.08), stroke: alpha(foreground, 0.2), width: 1)
          text("NEW RUN", TCX, TBY + 88 + nd, size: 8, color: muted, font: press, align: center)
        }
        // what each gem does
        let LG = ["HIT FOR ATK", "HIT FOR 2", "ARMOR", "HEAL 2", "MANA", "GOLD"]
        for g in range(6) {
          let lx = LGX + (g % 2) * LGW
          let ly = LGY + floor(g / 2) * 26
          sprite(GA[g], lx, ly - 9, 1.5, palette: GP[g])
          text(LG[g], lx + 24, ly, size: 7, color: foreground, font: press)
        }
        text("LINE OF FOUR: AN EXTRA MOVE", TCX, LGY + 86, size: 6, color: muted, font: press, align: center)
        if best > 0 { text("BEST: STAGE ${best}", TCX, LGY + 108, size: 7, color: accent, font: press, align: center) }
      }
    }
  }
}
