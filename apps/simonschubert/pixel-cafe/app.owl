app "pixel cafe" {
  // A café in pixel art, one room seen from above. Buy tables and the customers come in through
  // the door, sit down and order; the cooks make it on the machines along the back wall, the
  // waiters carry it over, and they pay on the way out. Buy a coffee machine, a juicer, an oven,
  // a stove and a cake case for a longer menu, plants, lamps, a jukebox and an aquarium for more
  // customers and bigger tips, and hire cooks and waiters as it fills up.
  //
  // There's no game loop. The coins are `bank` plus what the café has made since `since`, so it
  // keeps earning while the app is closed; building, upgrading, hiring or selling settles them
  // into `bank`. The customers are worked out from the clock: every seat has a round of 30
  // seconds, and in each one a customer comes or doesn't, as many as the café can serve.

  meta { owl: 16; description: "A pixel art café: buy tables, a coffee machine, an oven and decor, hire cooks and waiters, and watch the customers come in, eat and pay"; version: "1.1"; license: "MIT"; category: "games" }

  strings {
    en {
      sign: "MENU"; kd: i => ["TABLE", "ROUND TABLE", "LONG TABLE", "COFFEE", "JUICER", "OVEN", "STOVE", "CAKE CASE", "PLANT", "LAMP", "JUKEBOX", "AQUARIUM"][i]
      tab: i => ["TABLES", "KITCHEN", "DECOR", "STAFF"][i]; welcome: c => "WELCOME BACK +${c}"; lane: "KEEP THE LANE FREE"
      noRoom: "NO ROOM HERE"; noCoins: "NOT ENOUGH COINS"; taken: "THAT SPOT IS TAKEN"; seatsOf: (g, n) => "${g} OF ${n} SEATS"
      seats: n => "${n} SEATS"; level: l => "LEVEL ${l}"; decor: "DECOR"; noWay: "NO WAY TO THIS TABLE"; leaveWay: "LEAVE A WAY FROM THE DOOR"
      fromPass: "AND FROM THE PASS"; eatHere: "CUSTOMERS EAT HERE"; ownRow1: "A TABLE IN A ROW OF ITS OWN"; ownRow2: "NEEDS A WAY TO IT"
      perDish: p => "+${p} A DISH"; doubles: l => "LEVEL ${l} DOUBLES IT"; best: "AS GOOD AS IT GETS"; upgrade: "UPGRADE"
      looks: b => "+${b} LOOKS"; nicer1: "A NICER ROOM BRINGS MORE"; nicer2: "CUSTOMERS AND BIGGER TIPS"; sell: "SELL"
      staffWarn: "STAFF!"; cooks: n => "COOKS ${n}"; waiters: n => "WAITERS ${n}"; dishesMin: n => "${n} DISHES A MINUTE"
      tripsMin: n => "${n} TRIPS A MINUTE"; full: "FULL"; hire: "HIRE"; menu1: "NOTHING ON THE MENU YET:"; menu2: "BUY A COFFEE MACHINE"
      cook1: "CUSTOMERS WAIT FOR FOOD:"; cook2: "HIRE A COOK"; machine1: "A COOK HAS NO MACHINE:"; machine2: "BUY ONE IN THE KITCHEN"
      waiter1: "CUSTOMERS WAIT FOR A WAITER:"; waiter2: "HIRE ONE"; ok1: "THE STAFF KEEP UP:"; ok2: "ROOM FOR MORE CUSTOMERS"
      tablesWay: "TABLES NEED A WAY FROM THE DOOR"; stars1: "A NICER ROOM: MORE STARS,"; stars2: "MORE CUSTOMERS, BIGGER TIPS"
      hintBuy1: "BUY A COFFEE MACHINE"; hintBuy2: "IN THE KITCHEN TAB"; pick1: "PICK A TABLE BELOW,"; pick2: "THEN TAP THE FLOOR"
      leave1: "LEAVE A WAY TO"; leave2: "THE TABLES"
    }
    id {
      sign: "MENU"; kd: i => ["MEJA", "MEJA BUNDAR", "MEJA PANJANG", "KOPI", "JUS", "OVEN", "KOMPOR", "ETALASE KUE", "TANAMAN", "LAMPU", "JUKEBOX", "AKUARIUM"][i]
      tab: i => ["MEJA", "DAPUR", "DEKOR", "STAF"][i]; welcome: c => "SELAMAT KEMBALI +${c}"; lane: "JANGAN HALANGI JALUR"
