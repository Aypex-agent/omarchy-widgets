app "braincup" {
  meta {
    owl: 23
    description: "Train your math skills, memory and focus: thirteen brain games from the Braincup app, with levels, medals and best scores."
    version: "1.1"
    license: "Apache-2.0"
    category: "games"
  }
  title: view == "menu" ? "Braincup" : shown.name
  back: view != "menu"
  onBack: { view = "menu"; endsAt = 0 }
  // The menu scrolls on under the navigation bar; the other views end above it (screenInset).
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <g transform="translate(0 4)">
    <path d="M126 58c-12-14-38-12-46 6-20-2-34 16-28 34-16 8-18 30-6 42-6 18 8 36 26 34 6 18 30 24 44 12 4 4 7 6 10 7V58z" fill="#F08A70"/>
    <path d="M130 58c12-14 38-12 46 6 20-2 34 16 28 34 16 8 18 30 6 42 6 18-8 36-26 34-6 18-30 24-44 12-4 4-7 6-10 7V58z" fill="#ED7354"/>
    <path d="M128 60v133" stroke="#1A1B26" stroke-width="6" stroke-linecap="round"/>
    <g fill="none" stroke="#B8492F" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M80 64c4 10 14 14 24 12"/>
      <path d="M52 98c10 2 20-2 26-10"/>
      <path d="M46 140c12 0 22-6 26-16"/>
      <path d="M72 174c4-10 14-16 26-14"/>
      <path d="M100 112c-8 6-10 16-6 26"/>
      <path d="M112 152c-6 2-10 8-10 14"/>
      <path d="M176 64c-4 10-14 14-24 12"/>
      <path d="M204 98c-10 2-20-2-26-10"/>
      <path d="M210 140c-12 0-22-6-26-16"/>
      <path d="M184 174c-4-10-14-16-26-14"/>
      <path d="M156 112c8 6 10 16 6 26"/>
      <path d="M144 152c6 2 10 8 10 14"/>
    </g>
    </g>
  </svg>"""

  source now = clock every 1s

  // The text a person reads. The app's name, Braincup, stays as it is; games, demoTitles, demoDescs
  // and science are by game id.
  strings {
    en {
      // The game list's sections.
      logic: "logic"; perception: "perception"; math: "math"
      // On the menu tiles in capitals (13 sp, one line on a tile about 150 dp wide), and the window's title.
      games: {math: "Mental Calculation", chain: "Chain Calculation", fraction: "Fraction Calculation", value: "Value Comparison", missing: "Missing Operators", path: "Path Finder", sudoku: "Mini Sudoku", lights: "Lights Out", sliding: "Sliding Puzzle", hanoi: "Tower of Hanoi", bulls: "Bulls & Cows", color: "Color Confusion", schulte: "Schulte Table"}
      // The page before a game: a heading over a demo that plays on its own, and what to do under it.
      demoTitles: {math: "Carry the result forward", chain: "Mind the order of operations", fraction: "Multiply the fractions", value: "Pick the biggest value", missing: "Find the missing operators", path: "Follow the arrows", sudoku: "Fill in the missing numbers", lights: "Switch them all off", sliding: "Slide them into order", hanoi: "Move the stack", bulls: "Crack the secret code", color: "Answer the ink, not the word", schulte: "Tap them in order"}
      demoDescs: {math: "Follow the mathematical expressions. Use the result as the base for the next calculation.", chain: "Follow the mathematical expressions.", fraction: "Solve the fractions.", value: "Select the expression with the highest value.", missing: "Select the operators to make the equation true. Operators are evaluated using standard mathematical precedence.", path: "Start on the orange tile and follow the arrows to the destination.", sudoku: "Fill the small grid so every row, column and block contains each number exactly once.", lights: "Turn off every light. Each tap toggles the cell and its four neighbours.", sliding: "Slide tiles into the empty space to put them in order.", hanoi: "Move the full stack to the right peg. Only one disk at a time, and never a larger disk on a smaller one.", bulls: "Guess the secret 4-digit number with unique digits. Bulls = correct digit in correct position. Cows = correct digit in wrong position.", color: "A color word appears in colored ink. Tap the color of the ink, not the color the word names.", schulte: "Tap the numbers in order: 1, 2, 3..."}
      carries: n => "${n} carries over from the previous result."
      // The demo captions, frame by frame ("" shows the game's demoDescs line).
      sudokuCaps: ["", "Two 1s in the same row is not allowed.", "Two 1s in the same row is not allowed.", "", "This row holds 1 to 4.", "This column holds 1 to 4 too.", "This box holds 1 to 4 too.", ""]
      colorCaps: ["The word says one color. The ink says another.", "Sometimes the two agree.", "Reading the word is the trap.", "The ink is always the answer."]
      science: {color: {paradigm: "Stroop Task", summary: "A standard measure of inhibition: naming the color a word is printed in, while reading the word itself supplies a faster, competing answer."}, hanoi: {paradigm: "Tower of Hanoi", summary: "A standard measure of planning: the puzzle needs moves that undo progress before the goal can be reached."}}
      scienceLine: p => "science · ${p}"
      // Color Confusion's words, in capitals: red, green, blue, yellow.
      colors: ["RED", "GREEN", "BLUE", "YELLOW"]
      highestDemo: "Which has the highest value?"
      goal: n => "goal ${n}"
      // Under a digit of a Bulls & Cows guess, small, 52 dp wide.
      roles: {bull: "bull", cow: "cow", miss: "miss"}
      // Each 76 dp wide.
      bulls: n => "${n} bull${n == 1 ? "" : "s"}"
      cows: n => "${n} cow${n == 1 ? "" : "s"}"
      best: s => "best ${s}"
      start: "Start"
      secs: n => "${n}s"
      tries: n => "${n} tries"
      level: n => "level ${n}"
      // The bar over a run.
      score: n => "score ${n}"
      triesBar: n => "tries ${n}"
      next: n => "next ${n}"
      moves: n => "${n} moves"
      wrongMath: (was, n) => "it was ${was}, start again from ${n}"
      mathHint: "work it out, then keep the result in your head"
      itWas: x => "it was ${x}"
      highest: "which is the highest?"
      cell: (x, y) => "column ${x}, row ${y}"
      sudokuHint: "tap a cell, then a digit"
      solved: n => "${n} solved"
      lightsHint: "turn off every light"
      slidingHint: "tap a tile next to the gap"
      fewest: n => "fewest moves: ${n}"
      bullsHint: "bulls: right digit, right place · cows: right digit, wrong place"
      giveUp: "give up"; guess: "guess"
      inkHint: "tap the color of the ink"
      // The result page.
      solvedIn: n => "solved in ${n} moves"
      gaveUp: "gave up"
      numberWas: x => "the number was ${x}"
      onToLevel: n => "on to level ${n}"
      newBest: "new best!"
      noMedal: "no medal yet"
      medals: {gold: "gold", silver: "silver", bronze: "bronze"}
      // After the medal: what gold takes.
      goldTime: n => "gold ≤ ${n}s"
      goldTries: n => "gold ≤ ${n} tries"
      goldLevel: n => "gold at level ${n}"
      goldScore: n => "gold at ${n}"
      menu: "menu"; nextLevel: "next level"; playAgain: "play again"
    }
    id {
      logic: "logika"; perception: "persepsi"; math: "matematika"
      games: {math: "Hitung Mental", chain: "Hitung Berantai", fraction: "Hitung Pecahan", value: "Bandingkan Nilai", missing: "Operator Hilang", path: "Cari Jalan", sudoku: "Sudoku Mini", lights: "Matikan Lampu", sliding: "Puzzle Geser", hanoi: "Menara Hanoi", bulls: "Banteng & Sapi", color: "Kacau Warna", schulte: "Tabel Schulte"}
      demoTitles: {math: "Bawa hasilnya ke soal berikut", chain: "Perhatikan urutan operasi", fraction: "Kalikan pecahannya", value: "Pilih nilai terbesar", missing: "Temukan operator yang hilang", path: "Ikuti panahnya", sudoku: "Isi angka yang hilang", lights: "Matikan semuanya", sliding: "Geser hingga berurutan", hanoi: "Pindahkan tumpukannya", bulls: "Pecahkan kode rahasia", color: "Jawab tintanya, bukan katanya", schulte: "Ketuk secara berurutan"}
      demoDescs: {math: "Ikuti ekspresi matematikanya. Pakai hasilnya sebagai dasar hitungan berikutnya.", chain: "Ikuti ekspresi matematikanya.", fraction: "Selesaikan pecahannya.", value: "Pilih ekspresi dengan nilai tertinggi.", missing: "Pilih operator agar persamaannya benar. Operator dihitung dengan urutan operasi matematika yang biasa.", path: "Mulai dari ubin oranye dan ikuti panah sampai tujuan.", sudoku: "Isi kotak kecil itu agar setiap baris, kolom, dan blok berisi tiap angka tepat satu kali.", lights: "Matikan semua lampu. Setiap ketukan membalik sel itu dan keempat tetangganya.", sliding: "Geser ubin ke ruang kosong hingga berurutan.", hanoi: "Pindahkan seluruh tumpukan ke tiang kanan. Satu cakram sekali pindah, dan cakram besar tidak boleh di atas yang kecil.", bulls: "Tebak angka rahasia 4 digit dengan digit berbeda. Banteng = digit benar di posisi benar. Sapi = digit benar di posisi salah.", color: "Sebuah kata warna muncul dengan tinta berwarna. Ketuk warna tintanya, bukan warna yang disebut kata itu.", schulte: "Ketuk angka secara berurutan: 1, 2, 3..."}
      carries: n => "${n} dibawa dari hasil sebelumnya."
      sudokuCaps: ["", "Dua angka 1 di baris yang sama tidak boleh.", "Dua angka 1 di baris yang sama tidak boleh.", "", "Baris ini berisi 1 sampai 4.", "Kolom ini juga berisi 1 sampai 4.", "Blok ini juga berisi 1 sampai 4.", ""]
      colorCaps: ["Katanya menyebut satu warna. Tintanya warna lain.", "Kadang keduanya sama.", "Membaca katanya adalah jebakan.", "Tintanya selalu jawabannya."]
      science: {color: {paradigm: "Tugas Stroop", summary: "Ukuran baku untuk inhibisi: menyebut warna tinta sebuah kata, sementara membaca kata itu sendiri memberi jawaban yang lebih cepat dan bersaing."}, hanoi: {paradigm: "Menara Hanoi", summary: "Ukuran baku untuk perencanaan: teka-teki ini butuh langkah yang membatalkan kemajuan sebelum tujuan bisa dicapai."}}
      scienceLine: p => "sains · ${p}"
      colors: ["MERAH", "HIJAU", "BIRU", "KUNING"]
      highestDemo: "Mana yang nilainya tertinggi?"
      goal: n => "target ${n}"
      roles: {bull: "banteng", cow: "sapi", miss: "meleset"}
      bulls: n => "${n} banteng"
      cows: n => "${n} sapi"
      best: s => "terbaik ${s}"
      start: "Mulai"
      secs: n => "${n} dtk"
      tries: n => "${n} tebakan"
      level: n => "level ${n}"
      score: n => "skor ${n}"
      triesBar: n => "tebakan ${n}"
      next: n => "berikut ${n}"
      moves: n => "${n} langkah"
      wrongMath: (was, n) => "jawabannya ${was}, mulai lagi dari ${n}"
      mathHint: "hitung, lalu ingat hasilnya"
      itWas: x => "jawabannya ${x}"
      highest: "mana yang tertinggi?"
      cell: (x, y) => "kolom ${x}, baris ${y}"
      sudokuHint: "ketuk sel, lalu angka"
      solved: n => "${n} selesai"
      lightsHint: "matikan semua lampu"
      slidingHint: "ketuk ubin di sebelah ruang kosong"
      fewest: n => "langkah tersedikit: ${n}"
      bullsHint: "banteng: digit benar, posisi benar · sapi: digit benar, posisi salah"
      giveUp: "menyerah"; guess: "tebak"
      inkHint: "ketuk warna tintanya"
      solvedIn: n => "selesai dalam ${n} langkah"
      gaveUp: "menyerah"
      numberWas: x => "angkanya ${x}"
      onToLevel: n => "lanjut ke level ${n}"
      newBest: "rekor baru!"
      noMedal: "belum ada medali"
      medals: {gold: "emas", silver: "perak", bronze: "perunggu"}
      goldTime: n => "emas ≤ ${n} dtk"
      goldTries: n => "emas ≤ ${n} tebakan"
      goldLevel: n => "emas di level ${n}"
      goldScore: n => "emas di ${n}"
      menu: "menu"; nextLevel: "level berikutnya"; playAgain: "main lagi"
    }
    es {
      logic: "lógica"; perception: "percepción"; math: "cálculo"
      games: {math: "Cálculo mental", chain: "Cálculo en cadena", fraction: "Fracciones", value: "Comparar valores", missing: "Operadores ocultos", path: "Buscacaminos", sudoku: "Mini sudoku", lights: "Apaga las luces", sliding: "Puzle deslizante", hanoi: "Torre de Hanói", bulls: "Picas y fijas", color: "Lío de colores", schulte: "Tabla de Schulte"}
      demoTitles: {math: "Arrastra el resultado", chain: "Ojo al orden de las operaciones", fraction: "Multiplica las fracciones", value: "Elige el valor más alto", missing: "Encuentra los operadores", path: "Sigue las flechas", sudoku: "Completa los números", lights: "Apágalas todas", sliding: "Ponlas en orden", hanoi: "Mueve la torre", bulls: "Descifra el código secreto", color: "Responde la tinta, no la palabra", schulte: "Tócalos en orden"}
      demoDescs: {math: "Sigue las expresiones matemáticas. Usa el resultado como base para el siguiente cálculo.", chain: "Sigue las expresiones matemáticas.", fraction: "Resuelve las fracciones.", value: "Elige la expresión con el valor más alto.", missing: "Elige los operadores que hacen cierta la ecuación. Se evalúan con la precedencia matemática habitual.", path: "Empieza en la casilla naranja y sigue las flechas hasta el destino.", sudoku: "Rellena la pequeña cuadrícula para que cada fila, columna y bloque tenga cada número exactamente una vez.", lights: "Apaga todas las luces. Cada toque cambia la casilla y sus cuatro vecinas.", sliding: "Desliza las fichas al hueco vacío para ponerlas en orden.", hanoi: "Mueve toda la torre a la varilla derecha. Un disco cada vez, y nunca uno grande sobre uno pequeño.", bulls: "Adivina el número secreto de 4 cifras distintas. Fija = cifra correcta en su sitio. Pica = cifra correcta en otro sitio.", color: "Aparece el nombre de un color escrito en tinta de color. Toca el color de la tinta, no el que dice la palabra.", schulte: "Toca los números en orden: 1, 2, 3..."}
      carries: n => "${n} viene del resultado anterior."
      sudokuCaps: ["", "No puede haber dos 1 en la misma fila.", "No puede haber dos 1 en la misma fila.", "", "Esta fila tiene del 1 al 4.", "Esta columna también tiene del 1 al 4.", "Este bloque también tiene del 1 al 4.", ""]
      colorCaps: ["La palabra dice un color. La tinta, otro.", "A veces coinciden.", "Leer la palabra es la trampa.", "La respuesta siempre es la tinta."]
      science: {color: {paradigm: "Test de Stroop", summary: "Una medida clásica de la inhibición: nombrar el color de la tinta de una palabra, mientras leer la palabra da una respuesta más rápida que compite."}, hanoi: {paradigm: "Torre de Hanói", summary: "Una medida clásica de la planificación: el puzle exige movimientos que deshacen avances antes de llegar a la meta."}}
      scienceLine: p => "ciencia · ${p}"
      colors: ["ROJO", "VERDE", "AZUL", "AMARILLO"]
      highestDemo: "¿Cuál tiene el valor más alto?"
      goal: n => "meta ${n}"
      roles: {bull: "fija", cow: "pica", miss: "nada"}
      bulls: n => n == 1 ? "1 fija" : "${n} fijas"
      cows: n => n == 1 ? "1 pica" : "${n} picas"
      best: s => "récord ${s}"
      start: "Empezar"
      secs: n => "${n}s"
      tries: n => n == 1 ? "1 intento" : "${n} intentos"
      level: n => "nivel ${n}"
      score: n => "puntos ${n}"
      triesBar: n => "intentos ${n}"
      next: n => "sigue ${n}"
      moves: n => n == 1 ? "1 movimiento" : "${n} movimientos"
      wrongMath: (was, n) => "era ${was}, empieza de nuevo desde ${n}"
      mathHint: "calcúlalo y guarda el resultado en la cabeza"
      itWas: x => "era ${x}"
      highest: "¿cuál es el más alto?"
      cell: (x, y) => "columna ${x}, fila ${y}"
      sudokuHint: "toca una casilla y luego una cifra"
      solved: n => n == 1 ? "1 resuelto" : "${n} resueltos"
      lightsHint: "apaga todas las luces"
      slidingHint: "toca una ficha junto al hueco"
      fewest: n => "mínimo de movimientos: ${n}"
      bullsHint: "fijas: cifra correcta en su sitio · picas: cifra correcta en otro sitio"
      giveUp: "rendirse"; guess: "probar"
      inkHint: "toca el color de la tinta"
      solvedIn: n => n == 1 ? "resuelto en 1 movimiento" : "resuelto en ${n} movimientos"
      gaveUp: "te rendiste"
      numberWas: x => "el número era ${x}"
      onToLevel: n => "al nivel ${n}"
      newBest: "¡nuevo récord!"
      noMedal: "aún sin medalla"
      medals: {gold: "oro", silver: "plata", bronze: "bronce"}
      goldTime: n => "oro ≤ ${n}s"
      goldTries: n => "oro ≤ ${n} intentos"
      goldLevel: n => "oro en el nivel ${n}"
      goldScore: n => "oro con ${n}"
      menu: "menú"; nextLevel: "siguiente nivel"; playAgain: "otra vez"
    }
    pt {
      logic: "lógica"; perception: "percepção"; math: "cálculo"
      games: {math: "Cálculo mental", chain: "Cálculo em cadeia", fraction: "Frações", value: "Comparar valores", missing: "Operadores ocultos", path: "Siga o caminho", sudoku: "Mini sudoku", lights: "Apague as luzes", sliding: "Quebra-cabeça", hanoi: "Torre de Hanói", bulls: "Touros e vacas", color: "Confusão de cores", schulte: "Tabela de Schulte"}
      demoTitles: {math: "Leve o resultado adiante", chain: "Atenção à ordem das operações", fraction: "Multiplique as frações", value: "Escolha o maior valor", missing: "Encontre os operadores", path: "Siga as setas", sudoku: "Complete os números", lights: "Apague todas", sliding: "Deslize até ficar em ordem", hanoi: "Mova a pilha", bulls: "Decifre o código secreto", color: "Responda a tinta, não a palavra", schulte: "Toque em ordem"}
      demoDescs: {math: "Siga as expressões matemáticas. Use o resultado como base para o próximo cálculo.", chain: "Siga as expressões matemáticas.", fraction: "Resolva as frações.", value: "Escolha a expressão com o maior valor.", missing: "Escolha os operadores que tornam a equação verdadeira. Eles seguem a precedência matemática padrão.", path: "Comece no quadrado laranja e siga as setas até o destino.", sudoku: "Preencha a pequena grade para que cada linha, coluna e bloco tenha cada número exatamente uma vez.", lights: "Apague todas as luzes. Cada toque inverte a casa e suas quatro vizinhas.", sliding: "Deslize as peças para o espaço vazio até ficarem em ordem.", hanoi: "Mova a pilha inteira para o pino da direita. Um disco por vez, e nunca um maior sobre um menor.", bulls: "Adivinhe o número secreto de 4 dígitos diferentes. Touro = dígito certo na posição certa. Vaca = dígito certo na posição errada.", color: "Uma palavra de cor aparece escrita em tinta colorida. Toque na cor da tinta, não na cor que a palavra diz.", schulte: "Toque nos números em ordem: 1, 2, 3..."}
      carries: n => "${n} vem do resultado anterior."
      sudokuCaps: ["", "Dois 1 na mesma linha não pode.", "Dois 1 na mesma linha não pode.", "", "Esta linha tem de 1 a 4.", "Esta coluna também tem de 1 a 4.", "Este bloco também tem de 1 a 4.", ""]
      colorCaps: ["A palavra diz uma cor. A tinta, outra.", "Às vezes as duas combinam.", "Ler a palavra é a armadilha.", "A tinta é sempre a resposta."]
      science: {color: {paradigm: "Teste de Stroop", summary: "Uma medida clássica de inibição: dizer a cor da tinta de uma palavra, enquanto ler a própria palavra dá uma resposta mais rápida que compete."}, hanoi: {paradigm: "Torre de Hanói", summary: "Uma medida clássica de planejamento: o quebra-cabeça exige jogadas que desfazem o progresso antes de chegar ao objetivo."}}
      scienceLine: p => "ciência · ${p}"
      colors: ["VERMELHO", "VERDE", "AZUL", "AMARELO"]
      highestDemo: "Qual tem o maior valor?"
      goal: n => "meta ${n}"
      roles: {bull: "touro", cow: "vaca", miss: "nada"}
      bulls: n => n == 1 ? "1 touro" : "${n} touros"
      cows: n => n == 1 ? "1 vaca" : "${n} vacas"
      best: s => "recorde ${s}"
      start: "Começar"
      secs: n => "${n}s"
      tries: n => n == 1 ? "1 tentativa" : "${n} tentativas"
      level: n => "nível ${n}"
      score: n => "pontos ${n}"
      triesBar: n => "tentativas ${n}"
      next: n => "próximo ${n}"
      moves: n => n == 1 ? "1 jogada" : "${n} jogadas"
      wrongMath: (was, n) => "era ${was}, recomece a partir de ${n}"
      mathHint: "faça a conta e guarde o resultado na cabeça"
      itWas: x => "era ${x}"
      highest: "qual é o maior?"
      cell: (x, y) => "coluna ${x}, linha ${y}"
      sudokuHint: "toque numa casa, depois num dígito"
      solved: n => n == 1 ? "1 resolvido" : "${n} resolvidos"
      lightsHint: "apague todas as luzes"
      slidingHint: "toque numa peça ao lado do espaço"
      fewest: n => "mínimo de jogadas: ${n}"
      bullsHint: "touros: dígito certo, lugar certo · vacas: dígito certo, lugar errado"
      giveUp: "desistir"; guess: "chutar"
      inkHint: "toque na cor da tinta"
      solvedIn: n => n == 1 ? "resolvido em 1 jogada" : "resolvido em ${n} jogadas"
      gaveUp: "você desistiu"
      numberWas: x => "o número era ${x}"
      onToLevel: n => "rumo ao nível ${n}"
