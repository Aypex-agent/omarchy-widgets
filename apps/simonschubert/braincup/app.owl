  let sdUnits = range(sdG).map(r => range(sdG).map(c => r * sdG + c)) + range(sdG).map(c => range(sdG).map(r => r * sdG + c)) + range(sdG).map(b => range(sdG).map(k => (floor(b / (sdG / sdBc)) * 2 + floor(k / sdBc)) * sdG + (b % (sdG / sdBc)) * sdBc + k % sdBc))
