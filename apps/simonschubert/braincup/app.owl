app "braincup" {
  meta {
    owl: 14
    description: "Train your math skills, memory and focus: thirteen brain games from the Braincup app, with levels, medals and best scores."
    version: "1.0.1"
    license: "Apache-2.0"
    category: "games"
  }
  title: view == "menu" ? "Braincup" : shown.name
  back: view != "menu"
  onBack: { view = "menu"; endsAt = 0 }
  // The menu scrolls on under the navigation bar; the other views end above it (screenInset).
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#1A1B26"/>
    <g transform="translate(0 4)">
    <path d="M126 58c-12-14-38-12-46 6-20-2-34 16-28 34-16 8-18 30-6 42-6 18 8 36 26 34 6 18 30 24 44 12 4 4 7 6 10 7V58z" fill="#F08A70"/>
    <path d="M130 58c12-14 38-12 46 6 20-2 34 16 28 34 16 8 18 30 6 42 6 18-8 36-26 34-6 18-30 24-44 12-4 4-7 6-10 7V58z" fill="#ED7354"/>
    <path d="M128 60v133" stroke="#1A1B26" stroke-width="6" stroke-linecap="round"/>
    <g fill="none" stroke="#B8492F" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M80 64c4 10 14 14 24 12"/>
      <path d="M52 98c10 2 20-2 26-10"/>
      <path d="M46 140c12 0 22-6 26-16"/>
      <path d="M72 174c4-10 14-16 26-14"/>
      <path d="M100 112c-8 6-10 16-6 26"/>
      <path d="M112 152c-6 2-10 8-10 14"/>
      <path d="M176 64c-4 10-14 14-24 12"/>
      <path d="M204 98c-10 2-20-2-26-10"/>
      <path d="M210 140c-12 0-22-6-26-16"/>
      <path d="M184 174c-4-10-14-16-26-14"/>
      <path d="M156 112c8 6 10 16 6 26"/>
      <path d="M144 152c6 2 10 8 10 14"/>
    </g>
    </g>
  </svg>"""

  source now = clock every 1s

  // The view: the game list, a run, or a run's result.
  state view = "menu"
  state game = "math"
  state starting = false
  state endsAt = 0
  state startedAt = 0
  state score = 0
  state result = 0
  state newBest = false
  state gaveUp = false
  // The answer just given, for the line under the board: ok, and what it should have been.
  state answered = 0
  state ok = true
  state was = ""

  // Best scores, kept on the phone: [{id, best}]. Higher is better, except for Schulte (seconds)
  // and Bulls & Cows (tries). A level game's best is the highest level solved; it goes on at the next.
  state scores = [] persist

  // There's no random(): a Park–Miller generator, seeded from the clock when a run starts, and
  // stepped by every answer. Each round is a function of the seed. Lists (a grid, a walk) take
  // one value per index from floor(abs(sin(seed % 100000 + (i) * 78.233 + k) * 43758.5453) * 1000), a sine hash of the seed; a generator step is linear in the
  // index, which only rotated a list.
  let M = 2147483647
  state seed = 1
  let s1 = (seed * 16807) % M
  let s2 = (s1 * 16807) % M
  let s3 = (s2 * 16807) % M
  let s4 = (s3 * 16807) % M

  let CATS = [["logic", "logic"], ["perception", "perception"], ["math", "math"]]
  let GAMES = [
    ["math", "Mental Calculation", "Follow the expressions; each result is the base for the next", "math", "timed", 18, 9, 0, blue],
    ["chain", "Chain Calculation", "Solve longer and longer formulas", "math", "timed", 8, 4, 0, blue],
    ["fraction", "Fraction Calculation", "Multiply two fractions to a whole number", "math", "timed", 14, 6, 0, blue],
    ["value", "Value Comparison", "Pick the expression with the highest value", "math", "timed", 16, 6, 0, blue],
    ["missing", "Missing Operators", "Find the operators that make the equation true", "math", "timed", 12, 6, 0, blue],
    ["path", "Path Finder", "Follow the arrows from the marked start", "logic", "timed", 13, 7, 0, green],
    ["sudoku", "Mini Sudoku", "Each row, column and block once per digit", "logic", "timed", 6, 3, 0, green],
    ["lights", "Lights Out", "Turn off every light; a tap toggles its neighbours", "logic", "level", 10, 5, 0, green],
    ["sliding", "Sliding Puzzle", "Slide the tiles into order", "logic", "level", 10, 5, 0, green],
    ["hanoi", "Tower of Hanoi", "Move the stack to the right peg", "logic", "level", 4, 2, 0, green],
    ["bulls", "Bulls & Cows", "Guess the secret 4-digit number", "logic", "tries", 3, 6, 12, green],
    ["color", "Color Confusion", "Tap the color a word is printed in, not the color it names", "perception", "timed", 40, 25, 0, magenta],
    ["schulte", "Schulte Table", "Tap 1 to 16 in order as fast as you can", "perception", "time", 8, 15, 0, magenta]
  ].map(t => [scores.find(s => s.id == t[0]).best ?? 0].map(b => {
    id: t[0], name: t[1], desc: t[2], cat: t[3], kind: t[4], gold: t[5], silver: t[6], tint: t[8], best: b,
    medal: b == 0 ? "" : t[4] == "time" || t[4] == "tries" ? (b <= t[5] ? "gold" : b <= t[6] ? "silver" : t[7] == 0 || b <= t[7] ? "bronze" : "") : (b >= t[5] ? "gold" : b >= t[6] ? "silver" : "bronze"),
    bestText: b == 0 ? "–" : t[4] == "time" ? "${b}s" : t[4] == "tries" ? "${b} tries" : t[4] == "level" ? "level ${b}" : "${b}"
  })[0])
  let shown = GAMES.find(g => g.id == game)
  let kind = shown.kind
  let bestOf = shown.best
  let playLevel = bestOf + 1
  let left = endsAt == 0 || now == null ? 0 : max(endsAt - now, 0)

  // Every run starts here, from the menu or from "play again".
  when starting {
    seed = (seed + now) % 2147483646 + 1
    score = 0
    answered = 0
    ok = true
    was = ""
    typed = ""
    gaveUp = false
    num = 2 + s3 % 13
    mRound = 0
    showSeed = true
    vRound = 0
    cLen = 2
    fRound = 0
    moRound = 0
    moOps = []
    sdRound = 0
    sdVals = ZEROS
    sdSel = -1
    pRound = 0
    nextN = 1
    wrongN = 0
    lights = lStart
    tiles = sStart
    pegs = [range(hDisks, 0, -1), [], []]
    hSel = -1
    hRej = -1
    moves = 0
    bGuess = ""
    bGuesses = []
    startedAt = now
    endsAt = kind == "timed" ? now + 60 : 0
    view = "play"
    starting = false
  }

  // A timed run ends after sixty seconds.
  at endsAt {
    result = score
    newBest = score > 0 && score > bestOf
    scores = scores.filter(s => s.id != game) + [{id: game, best: max(bestOf, score)}]
    view = view == "play" ? "done" : view
    endsAt = 0
  }

  // ---- Mental calculation: a running number, one operation at a time, harder as you go.
  state num = 7
  state mRound = 0
  state showSeed = true
  let maxN = mRound >= 19 ? 150 : mRound >= 13 ? 100 : mRound >= 9 ? 70 : mRound >= 5 ? 50 : 30
  let divs = [2, 3, 4, 5, 6, 7, 8, 9].filter(d => num % d == 0)
  let op = num < 10 ? (s1 % 2 == 0 ? "+" : "*") : num > 60 ? (s1 % 2 == 0 && len(divs) > 0 ? "/" : "-") : ["+", "*", "-"][s1 % 3]
  let mulHi = floor(maxN / num)
  let mulLo = min(2, mulHi - 1)
  let operand = op == "+" ? 3 + s3 % (max(maxN - num, 4) - 3) : op == "-" ? 3 + s3 % (max(num - 3, 4) - 3) : op == "*" ? max(mulLo + s3 % max(mulHi - mulLo, 1), 2) : divs[s2 % max(len(divs), 1)]
  let answer = op == "+" ? num + operand : op == "-" ? num - operand : op == "*" ? num * operand : num / operand
  let SIGN = {"+": "+", "-": "−", "*": "×", "/": "÷"}

  // ---- Chain calculation: one more number each round; brackets from five numbers on.
  state cLen = 2
  let cOps0 = range(cLen - 1).map(i => ["+", "-", "*"][floor(abs(sin(seed % 100000 + (i) * 78.233 + 1.1) * 43758.5453) * 1000) % 3])
  let cN = range(cLen).map(i => 2 + floor(abs(sin(seed % 100000 + (i) * 78.233 + 2.2) * 43758.5453) * 1000) % (i > 0 && cOps0[i - 1] == "*" ? 5 : 8))
  // No two multiplications in a row: every second one of a run becomes a plus.
  let cOps = cOps0.map((o, i) => o == "*" && (i - (last(range(i + 1).filter(j => cOps0[j] != "*")) ?? -1)) % 2 == 0 ? "+" : o)
  let cBr = cLen > 4
  let cS = cBr ? floor(abs(sin(seed % 100000 + (0) * 78.233 + 3.3) * 43758.5453) * 1000) % (cLen - 1) : 0
  let cE = cBr ? cS + 1 + floor(abs(sin(seed % 100000 + (0) * 78.233 + 4.4) * 43758.5453) * 1000) % (cLen - 1 - cS) : 0
  // The value with these operators, and with every minus made a plus (used when it comes out negative).
  let cVals = [cOps, cOps.map(o => o == "-" ? "+" : o)].map(O => [sum(range(cS, cE + 1).filter(i => i == cS || O[i - 1] != "*").map(t => (t == cS || O[t - 1] == "+" ? 1 : -1) * cN[t] * (O[t] == "*" && t < cE ? cN[t + 1] : 1)))].map(G => [take(cN, cS) + [G] + drop(cN, cE + 1), take(O, cS) + drop(O, cE)]).map(p => sum(range(len(p[0])).filter(i => i == 0 || p[1][i - 1] != "*").map(t => (t == 0 || p[1][t - 1] == "+" ? 1 : -1) * p[0][t] * (p[1][t] == "*" ? p[0][t + 1] * (p[1][t + 1] == "*" ? p[0][t + 2] : 1) : 1))))[0])
  let cFlip = cVals[0] < 0 ? 1 : 0
  let cAns = cVals[cFlip]
  let cShownOps = cFlip == 1 ? cOps.map(o => o == "-" ? "+" : o) : cOps
  let cText = join(range(cLen).map(i => (cBr && i == cS ? "(" : "") + "${cN[i]}" + (cBr && i == cE ? ")" : "") + (i < cLen - 1 ? " ${SIGN[cShownOps[i]]} " : "")), "")

  // ---- Fraction calculation: (a/b) × (c/d) that comes out whole.
  state fRound = 0
  let fMaxDown = fRound >= 10 ? 14 : fRound >= 5 ? 10 : fRound >= 2 ? 8 : 7
  let fMaxMul = fRound >= 10 ? 12 : fRound >= 5 ? 9 : fRound >= 2 ? 7 : 6
  let fDown = 2 + s1 % (fMaxDown - 1)
  let fAns = 3 + s2 % (fMaxMul - 2)
  let fUp = fDown * fAns
  let fUpDivs = range(2, fUp).filter(i => fUp % i == 0)
  let fDownDivs = range(2, fDown).filter(i => fDown % i == 0)
  let fUpDiv = len(fUpDivs) > 0 ? fUpDivs[s3 % len(fUpDivs)] : 1
  let fDownDiv = len(fDownDivs) > 0 ? fDownDivs[s4 % len(fDownDivs)] : 1

  // ---- The number pad, shared by mental, chain and fraction calculation. An answer is checked once
  // it has as many digits as the right one, as in Braincup.
  state typed = ""
  let kTarget = game == "math" ? "${answer}" : game == "chain" ? "${cAns}" : game == "fraction" ? "${fAns}" : ""
  when view == "play" && kTarget != "" && len(typed) >= len(kTarget) {
    ok = typed == kTarget
    was = kTarget
    answered = answered + 1
    score = score + (ok ? 1 : 0)
    num = game == "math" ? (ok ? answer : 2 + s4 % 13) : num
    showSeed = game == "math" ? !ok : showSeed
    mRound = mRound + (game == "math" ? 1 : 0)
    cLen = cLen + (game == "chain" ? 1 : 0)
    fRound = fRound + (game == "fraction" ? 1 : 0)
    seed = s4
    typed = ""
  }

  // ---- Value comparison: 2 to 4 expressions, the highest wins.
  state vRound = 0
  let vOp = vRound == 0 ? "+" : s1 % 2 == 0 ? "/" : "*"
  let vCount = vRound > 6 ? 4 : vRound > 3 ? 3 : 2
  let cands = range(10).map(i => {i: i, a: 2 + floor(abs(sin(seed % 100000 + (i) * 78.233 + 5.5) * 43758.5453) * 1000) % 10, b: 2 + floor(abs(sin(seed % 100000 + (i) * 78.233 + 6.6) * 43758.5453) * 1000) % 10}).map(c => {i: c.i, a: c.a, b: c.b, v: vOp == "+" ? c.a + c.b : vOp == "/" ? c.a / c.b : c.a * c.b})
  let vOpts = cands.filter(c => cands.find(d => d.v == c.v).i == c.i).take(vCount)
  let vWin = vOpts.sortBy(o => -o.v)[0]

  // ---- Missing operators: numbers and a result; find the operators in between.
  state moRound = 0
  state moOps = []
  let moCount = moRound >= 10 ? 5 : moRound >= 5 ? 4 : 3
  let moMax = moCount <= 3 ? 20 : 12
  let MO_OPS = moRound <= 2 ? ["+", "-"] : ["+", "-", "*", "/"]
  // 24 tries, the first that works: whole steps, products up to 200, no running total below 0
  // or above 200, and not the same as with every operator a plus.
  let moTries = range(24).map(j => {n: range(moCount).map(i => 2 + floor(abs(sin(seed % 100000 + (j * 7 + i) * 78.233 + 7.7) * 43758.5453) * 1000) % (moMax - 2)), o: range(moCount - 1).map(i => MO_OPS[floor(abs(sin(seed % 100000 + (j * 7 + i) * 78.233 + 8.8) * 43758.5453) * 1000) % len(MO_OPS)])}).map(e => {n: e.n, o: e.o, r: [{n: e.n, o: e.o}].map(E => [range(len(E.n)).filter(i => i == 0 || E.o[i - 1] == "+" || E.o[i - 1] == "-").map(s => [{v: E.n[s], bad: false, go: true, i: s}].map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => {sg: s == 0 || E.o[s - 1] == "+" ? 1 : -1, v: a.v, bad: a.bad})[0])].map(T => [range(len(T)).map(j => sum(take(T, j + 1).map(t => t.sg * t.v)))].map(P => {v: last(P) ?? 0, ok: !any(T, t => t.bad) && all(P, p => p >= 0 && p <= 200) && (last(P) ?? 0) > 0})[0])[0])[0]})
  let moPick = moTries.find(e => e.r.ok && (moCount <= 2 || sum(e.n) != e.r.v)) ?? {n: [12, 3, 4], o: ["-", "+"], r: {v: 13, ok: true}}
  let moT = moPick.r.v
  let moUser = [{n: moPick.n, o: moOps}].map(e => [{n: e.n, o: e.o}].map(E => [range(len(E.n)).filter(i => i == 0 || E.o[i - 1] == "+" || E.o[i - 1] == "-").map(s => [{v: E.n[s], bad: false, go: true, i: s}].map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => [a.go && (E.o[a.i] == "*" || E.o[a.i] == "/")].map(c => {v: c ? (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] : a.v / E.n[a.i + 1]) : a.v, bad: a.bad || (c && (E.o[a.i] == "*" ? a.v * E.n[a.i + 1] > 200 : a.v % E.n[a.i + 1] != 0)), go: c, i: a.i + 1})[0]).map(a => {sg: s == 0 || E.o[s - 1] == "+" ? 1 : -1, v: a.v, bad: a.bad})[0])].map(T => [range(len(T)).map(j => sum(take(T, j + 1).map(t => t.sg * t.v)))].map(P => {v: last(P) ?? 0, ok: !any(T, t => t.bad) && all(P, p => p >= 0 && p <= 200) && (last(P) ?? 0) > 0})[0])[0])[0])[0]
  when view == "play" && game == "missing" && len(moOps) >= moCount - 1 {
    ok = abs(moUser.v - moT) < 0.000001
    was = join(moPick.n.map((x, i) => "${x}" + (i < moCount - 1 ? " ${SIGN[moPick.o[i]]} " : "")), "") + " = ${moT}"
    answered = answered + 1
    score = score + (ok ? 1 : 0)
    moRound = moRound + 1
    seed = s4
    moOps = []
  }

  // ---- Path finder: arrows from a start on the top row; tap where they end. The walk never runs
  // off the grid and never takes the same direction twice in a row.
  state pRound = 0
  let pLen = min(3 + pRound, 24)
  let DIRS = [["↑", 0, -1], ["→", 1, 0], ["↓", 0, 1], ["←", -1, 0]]
  let pW0 = {x: s1 % 4, y: 0, d: "↑"}
  // Unrolled: no loops in owl.
  let pW1 = [pW0].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (1) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW2 = [pW1].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (2) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW3 = [pW2].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (3) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW4 = [pW3].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (4) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW5 = [pW4].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (5) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW6 = [pW5].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (6) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW7 = [pW6].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (7) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
  let pW8 = [pW7].map(p => [DIRS.filter(m => m[0] != p.d && p.x + m[1] >= 0 && p.x + m[1] < 4 && p.y + m[2] >= 0 && p.y + m[2] < 4)].map(c => c[floor(abs(sin(seed % 100000 + (8) * 78.233 + 13.1) * 43758.5453) * 1000) % len(c)]).map(m => {x: p.x + m[1], y: p.y + m[2], d: m[0]})[0])[0]
