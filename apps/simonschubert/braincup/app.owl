      goldTries: n => "ouro ≤ ${n} tentativas"
      goldLevel: n => "ouro no nível ${n}"
      goldScore: n => "ouro com ${n}"
      menu: "menu"; nextLevel: "próximo nível"; playAgain: "jogar de novo"
    }
    de {
      logic: "logik"; perception: "wahrnehmung"; math: "mathe"
