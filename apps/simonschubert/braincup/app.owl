  state sdVals = ZEROS
  state sdSel = -1
  let sdG = sdRound >= 8 ? 6 : 4
  let sdBc = sdG == 6 ? 3 : 2
  let sdClues = sdG == 6 ? (sdRound >= 12 ? 14 : sdRound >= 10 ? 16 : 18) : sdRound >= 5 ? 6 : sdRound >= 3 ? 8 : 10
  let sdDigits = range(1, sdG + 1).sortBy(i => floor(abs(sin(seed % 100000 + (i) * 78.233 + 9.1) * 43758.5453) * 1000))
  let sdRowGroups = range(sdG / 2).sortBy(i => floor(abs(sin(seed % 100000 + (i) * 78.233 + 9.2) * 43758.5453) * 1000))
  let sdColGroups = range(sdG / sdBc).sortBy(i => floor(abs(sin(seed % 100000 + (i) * 78.233 + 9.3) * 43758.5453) * 1000))
  let sdRows = range(sdG).map(i => sdRowGroups[floor(i / 2)] * 2 + range(2).sortBy(w => floor(abs(sin(seed % 100000 + (sdRowGroups[floor(i / 2)] * 10 + w) * 78.233 + 9.4) * 43758.5453) * 1000))[i % 2])
