app "pixel farm" {
  // A cozy farm in pixel art, seen from above. Plant seeds in the field, come back when they're
  // ripe and harvest them for coins, and fish the pond while you wait. Rarer seeds take longer
  // and pay more, and open up as the farm levels; more field is for sale three plots at a time.
  //
  // There's no game loop. Each plot keeps the crop and the Unix time it was planted, so crops go
  // on growing while the app is closed: a plot is ripe once the clock has passed its growing time.
  // The pond works the same way: it holds five fish, and one swims back every ten minutes from
  // `stockT`. Fishing goes by `time`: a cast picks the fish and the moment it bites, and while
  // reeling the hook and the fish slide by formulas of the time since it was hooked, so a tap
  // only has to compare where both are.

  meta { owl: 23; description: "A cozy pixel art farm: plant crops that grow in real time, even while the app is closed, harvest them for coins and fish the pond between harvests"; version: "1.2"; license: "MIT"; category: "games" }

  // A seed card is about 80dp wide at size 5-6, a book entry about 70dp: crop and fish names stay short.
  strings {
    en {
      welcome: "WELCOME BACK!"; readyHarvest: n => "${n} READY TO HARVEST"; levelUp: n => "LEVEL ${n}!"; seedsOf: c => "${c} SEEDS"
      resting: "THE FISH ARE RESTING"; backIn: t => "BACK IN ${t}"; tooSoon: "TOO SOON!"; snapped: "THE LINE SNAPPED"
      moreField: "MORE FIELD!"; noCoins: "NOT ENOUGH COINS"; morePlots: c => "3 MORE PLOTS: ${c}"; tapBuy: "TAP AGAIN TO BUY"
      giant: v => "GIANT! +${v}"; readyIn: t => "READY IN ${t}"; pickSeed: "PICK A SEED BELOW"; atLevel: n => "AT LEVEL ${n}"
      lv: n => "LV ${n}"; ready: n => "${n} READY"; growing: "GROWING"; tab: i => ["SEEDS", "FISH", "BOOK"][i]; level: n => "LEVEL ${n}"
      allField: "ALL FIELD"; tapAgain: "TAP AGAIN"; plus3: "+3 PLOTS"; open: "OPEN"
      tapSoil: c => "TAP SOIL TO PLANT ${c}"; noSeed: "NO SEED PICKED: TAPS ONLY HARVEST"
      drag1: "DRAG OVER THE FIELD TO HARVEST"; drag2: "AND SOW IN ONE GO"
      pondFull: "POND FULL"; next: t => "NEXT ${t}"; hold: "HOLD TO CAST"; letGoThrow: "LET GO TO THROW"; farther: "FARTHER OUT, RARER FISH"
      nightOnly: "SOME ONLY BITE AT NIGHT"; oneBack: t => "ONE BACK IN ${t}"; letGo: "LET GO!"; near: "NEAR"; far: "FAR"
      wait: "WAIT FOR A BITE"; bobber: "TAP WHEN THE BOBBER GOES UNDER"; tap: "TAP"; gotAway: "IT GOT AWAY"; castAgain: "TAP TO CAST AGAIN"
      hook1: "TAP WHEN THE HOOK"; hook2: "IS ON THE FISH"; coins: v => "+${v} COINS"; newBook: "NEW IN YOUR BOOK!"
      fishCount: n => "FISH ${n}/9"; soundOn: "SOUND ON"; soundOff: "SOUND OFF"; atNight: "AT NIGHT"; farOut: "FAR OUT"; harvests: n => "HARVESTS ${n}"
      hrs: n => "${n}H"; mins: n => "${n}M"; secs: n => "${n}S"
      crop: i => ["RADISH", "CARROT", "POTATO", "TOMATO", "CORN", "PUMPKIN", "STRAWBERRY"][i]
      fish: i => ["MINNOW", "PERCH", "CARP", "TROUT", "BASS", "CATFISH", "PIKE", "EEL", "GOLDEN KOI"][i]
    }
    id {
      welcome: "SELAMAT DATANG!"; readyHarvest: n => "${n} SIAP DIPANEN"; levelUp: n => "LEVEL ${n}!"; seedsOf: c => "BENIH ${c}"
      resting: "IKANNYA SEDANG ISTIRAHAT"; backIn: t => "KEMBALI DALAM ${t}"; tooSoon: "TERLALU CEPAT!"; snapped: "TALINYA PUTUS"
      moreField: "LADANG BERTAMBAH!"; noCoins: "KOIN TIDAK CUKUP"; morePlots: c => "3 PETAK LAGI: ${c}"; tapBuy: "KETUK LAGI UNTUK BELI"
      giant: v => "RAKSASA! +${v}"; readyIn: t => "SIAP DALAM ${t}"; pickSeed: "PILIH BENIH DI BAWAH"; atLevel: n => "DI LEVEL ${n}"
      lv: n => "LV ${n}"; ready: n => "${n} SIAP"; growing: "TUMBUH"; tab: i => ["BENIH", "IKAN", "BUKU"][i]; level: n => "LEVEL ${n}"
      allField: "SEMUA LADANG"; tapAgain: "KETUK LAGI"; plus3: "+3 PETAK"; open: "TERBUKA"
      tapSoil: c => "KETUK TANAH UNTUK MENANAM ${c}"; noSeed: "BELUM PILIH BENIH: KETUK HANYA MEMANEN"
      drag1: "SERET DI ATAS LADANG UNTUK MEMANEN"; drag2: "DAN MENANAM SEKALIGUS"
      pondFull: "KOLAM PENUH"; next: t => "BERIKUTNYA ${t}"; hold: "TAHAN UNTUK MELEMPAR"; letGoThrow: "LEPAS UNTUK MELEMPAR"; farther: "MAKIN JAUH, MAKIN LANGKA"
      nightOnly: "ADA YANG HANYA MAKAN MALAM"; oneBack: t => "SATU KEMBALI DALAM ${t}"; letGo: "LEPAS!"; near: "DEKAT"; far: "JAUH"
      wait: "TUNGGU GIGITAN"; bobber: "KETUK SAAT PELAMPUNG TENGGELAM"; tap: "KETUK"; gotAway: "IKANNYA LEPAS"; castAgain: "KETUK UNTUK MELEMPAR LAGI"
      hook1: "KETUK SAAT KAIL"; hook2: "ADA DI IKAN"; coins: v => "+${v} KOIN"; newBook: "BARU DI BUKUMU!"
      fishCount: n => "IKAN ${n}/9"; soundOn: "SUARA NYALA"; soundOff: "SUARA MATI"; atNight: "MALAM"; farOut: "JAUH"; harvests: n => "PANEN ${n}"
      hrs: n => "${n}J"; mins: n => "${n}M"; secs: n => "${n}D"
      crop: i => ["LOBAK", "WORTEL", "KENTANG", "TOMAT", "JAGUNG", "LABU", "STROBERI"][i]
      fish: i => ["WADER", "PERCH", "IKAN MAS", "TRAUT", "BASS", "LELE", "IKAN TOMBAK", "SIDAT", "KOI EMAS"][i]
    }
    es {
      welcome: "¡HOLA DE NUEVO!"; readyHarvest: n => "${n} LISTOS PARA COSECHAR"; levelUp: n => "¡NIVEL ${n}!"; seedsOf: c => "SEMILLAS DE ${c}"
