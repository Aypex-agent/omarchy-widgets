      tapSoil: c => "TOQUE NA TERRA PARA PLANTAR ${c}"; noSeed: "SEM SEMENTE: TOQUES SÓ COLHEM"
      drag1: "ARRASTE SOBRE O CAMPO PARA COLHER"; drag2: "E SEMEAR DE UMA VEZ"
      pondFull: "LAGO CHEIO"; next: t => "OUTRO EM ${t}"; hold: "SEGURE PARA LANÇAR"; letGoThrow: "SOLTE PARA ARREMESSAR"; farther: "MAIS LONGE, PEIXES MAIS RAROS"
