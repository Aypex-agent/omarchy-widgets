      moreField: "¡MÁS CAMPO!"; noCoins: "FALTAN MONEDAS"; morePlots: c => "3 PARCELAS MÁS: ${c}"; tapBuy: "TOCA OTRA VEZ PARA COMPRAR"
      giant: v => "¡GIGANTE! +${v}"; readyIn: t => "LISTO EN ${t}"; pickSeed: "ELIGE UNA SEMILLA ABAJO"; atLevel: n => "EN EL NIVEL ${n}"
      lv: n => "NV ${n}"; ready: n => "${n} LISTOS"; growing: "CRECIENDO"; tab: i => ["SEMILLAS", "PESCA", "LIBRO"][i]; level: n => "NIVEL ${n}"
      allField: "TODO EL CAMPO"; tapAgain: "TOCA OTRA VEZ"; plus3: "+3 PARCELAS"; open: "ABIERTO"
      tapSoil: c => "TOCA LA TIERRA PARA PLANTAR ${c}"; noSeed: "SIN SEMILLA: TOCAR SOLO COSECHA"
      drag1: "ARRASTRA SOBRE EL CAMPO PARA COSECHAR"; drag2: "Y SEMBRAR DE UNA VEZ"
      pondFull: "ESTANQUE LLENO"; next: t => "OTRO EN ${t}"; hold: "MANTÉN PARA LANZAR"; letGoThrow: "SUELTA PARA LANZAR"; farther: "MÁS LEJOS, PECES MÁS RAROS"
      nightOnly: "ALGUNOS SOLO PICAN DE NOCHE"; oneBack: t => "UNO VUELVE EN ${t}"; letGo: "¡SUELTA!"; near: "CERCA"; far: "LEJOS"
      wait: "ESPERA LA PICADA"; bobber: "TOCA CUANDO SE HUNDA EL CORCHO"; tap: "TOCA"; gotAway: "SE ESCAPÓ"; castAgain: "TOCA PARA LANZAR OTRA VEZ"
      hook1: "TOCA CUANDO EL ANZUELO"; hook2: "ESTÉ SOBRE EL PEZ"; coins: v => "+${v} MONEDAS"; newBook: "¡NUEVO EN TU LIBRO!"
      fishCount: n => "PECES ${n}/9"; soundOn: "SONIDO: SÍ"; soundOff: "SONIDO: NO"; atNight: "DE NOCHE"; farOut: "LEJOS"; harvests: n => "COSECHAS ${n}"
      hrs: n => "${n}H"; mins: n => "${n}M"; secs: n => "${n}S"
      crop: i => ["RÁBANO", "ZANAHORIA", "PATATA", "TOMATE", "MAÍZ", "CALABAZA", "FRESA"][i]
      fish: i => ["PECECILLO", "PERCA", "CARPA", "TRUCHA", "LOBINA", "BAGRE", "LUCIO", "ANGUILA", "KOI DORADO"][i]
    }
    pt {
      welcome: "BEM-VINDO DE VOLTA!"; readyHarvest: n => "${n} PRONTOS PARA COLHER"; levelUp: n => "NÍVEL ${n}!"; seedsOf: c => "SEMENTES DE ${c}"
      resting: "OS PEIXES ESTÃO DESCANSANDO"; backIn: t => "VOLTAM EM ${t}"; tooSoon: "CEDO DEMAIS!"; snapped: "A LINHA ARREBENTOU"
      moreField: "MAIS CAMPO!"; noCoins: "MOEDAS INSUFICIENTES"; morePlots: c => "MAIS 3 CANTEIROS: ${c}"; tapBuy: "TOQUE DE NOVO PARA COMPRAR"
      giant: v => "GIGANTE! +${v}"; readyIn: t => "PRONTO EM ${t}"; pickSeed: "ESCOLHA UMA SEMENTE ABAIXO"; atLevel: n => "NO NÍVEL ${n}"
      lv: n => "NV ${n}"; ready: n => "${n} PRONTOS"; growing: "CRESCENDO"; tab: i => ["SEMENTES", "PESCA", "LIVRO"][i]; level: n => "NÍVEL ${n}"
