  // what drawing each kind costs, in drawing calls: in full, and in half-size art (gardens are
  // drawn with a few rectangles either way)
  let KC = [[111, 50], [119, 44], [99, 99], [210, 112], [265, 107], [142, 77], [67, 50], [64, 49], [67, 51], [10, 10], [13, 13], [16, 16]]
  // How much each item is drawn in. A frame has 2000 drawing calls; what's left after the grass,
  // paths, guests, gate and panel goes to the rides and stalls: all of them in half-size art,
  // then each in full while it fits, the small ones first, as half of a small one is only 8
  // pixels across. Should even half-size art not fit, the last ones become plain blocks.
  // 2: full, 1: half, 0: a block.
  let room = 1940 - 350 - (tool >= 0 ? len(free) : 0) - len(checker) - len(tufts) - len(paths) - len(edges) - len(pines) - 7 * len(crowd)
  let pri = range(len(items)).sortBy(i => KD[items[i].k].w * 1000 + KD[items[i].k].t * 100 + i)
  let lod0 = reduce(reverse(pri), (A, i) => A.room < 0 && KD[items[i].k].t < 2 ? {room: A.room + KC[items[i].k][1] - 4, s: set(A.s, i, 0)} : A, {room: room - sum(items.map(it => KC[it.k][1])), s: items.map(it => 1)})
  let lod = reduce(pri, (A, i) => A.s[i] == 1 && A.room >= KC[items[i].k][0] - KC[items[i].k][1] ? {room: A.room - KC[items[i].k][0] + KC[items[i].k][1], s: set(A.s, i, 2)} : A, lod0).s
  // the coin fading as it rises (a layer() would cost a whole screen's worth of drawing)
  let coinFade = [1, 1, 1, 0.8].map(a => {o: alpha(PAL.o, a), Y: alpha(PAL.Y, a), W: alpha(PAL.W, a), y: alpha(PAL.y, a)})
  // a pine in the woods, in ninths of a cell, stepped like pixels, with its trunk
  let pineShape = [[3, 0], [5, 0], [5, 2], [6, 2], [6, 4], [7, 4], [7, 6], [4.5, 6], [4.5, 7], [3.5, 7], [3.5, 6], [1, 6], [1, 4], [2, 4], [2, 2], [3, 2]]
  let coinArt = ["..ooo..", ".oYYYo.", "oYWYYyo", "oYWYYyo", "oYYYYyo", ".oyyyo.", "..ooo.."]
  let starArt = ["..o..", ".oYo.", "oYYYo", ".oYo.", "..o.."]
  let signArt = ["oooooooooooooooooooooo", "oWWWWWWWWWWWWWWWWWWWWo", "oWWWWWWWWWWWWWWWWWWWWo", "oWWWWWWWWWWWWWWWWWWWWo", "oWWWWWWWWWWWWWWWWWWWWo", "oWWWWWWWWWWWWWWWWWWWWo", "oooooooooooooooooooooo", "....ot..........ot....", "....ot..........ot...."]
  let bubbleArt = [".ooooo.", "oWWRWWo", "oWWRWWo", "oWWRWWo", "oWWWWWo", "oWWRWWo", ".ooooo.", "...o..."]

  Canvas {
    fill: true
    background: UI.bg

    ripple: false
    onTap: {
      let ax = floor((x - MX) / C)
      let ay = floor((y - MY) / C)
      let cell = ay * 8 + ax
      if x >= MX && x < MX + MW && y >= MY && y < MY + MH {
        if ay < 12 - land {
          sel = sel == -2 ? -1 : -2
          tool = -1
        } else if tool == 12 {
          if isP[cell] {
            if cell != 91 && cell != 92 {
              bank = coins + 5
              since = tnow
              paths = paths.filter(c => c != cell)
            }
          } else if own[cell] < 0 {
            if coins >= 10 {
              bank = coins - 10
              since = tnow
              paths = paths + [cell]
            } else {
              msg = "NOT ENOUGH COINS"
              msgT = time
            }
          }
        } else if tool >= 0 {
          let w = KD[tool].w
          let fit = (w == 1 ? [cell] : [cell, cell - 1, cell - 8, cell - 9]).filter(a => a >= 0 && a % 8 <= ax && a % 8 <= 8 - w && floor(a / 8) >= 12 - land && floor(a / 8) <= 12 - w && all(w == 1 ? [a] : [a, a + 1, a + 8, a + 9], c => own[c] < 0 && !isP[c]))
          if len(fit) == 0 {
            msg = "NO ROOM HERE"
            msgT = time
          } else if coins < price[tool] {
            msg = "NOT ENOUGH COINS"
            msgT = time
          } else {
            bank = coins - price[tool]
            since = tnow
            items = items + [{c: fit[0], k: tool, l: 1, sp: price[tool]}]
            haptic()
          }
        } else if own[cell] >= 0 {
          sel = sel == items[own[cell]].c ? -1 : items[own[cell]].c
        } else {
          sel = -1
        }
      } else if (LS ? x >= PX : y >= PY) && sel == -2 {
        if x >= PX + PW - 34 && y < PY + 34 {
          sel = -1
        } else if y >= BY && land < 12 {
          if coins >= LANDCOST[(land - 6) / 2] {
            bank = coins - LANDCOST[(land - 6) / 2]
            since = tnow
            land = land + 2
            sel = -1
            msg = "MORE LAND!"
            msgT = time
            haptic()
          } else {
            msg = "NOT ENOUGH COINS"
            msgT = time
          }
        }
      } else if (LS ? x >= PX : y >= PY) && si >= 0 {
        let it = items[si]
        if x >= PX + PW - 34 && y < PY + 34 {
          sel = -1
        } else if y >= BY && x < PX + UW && KD[it.k].t < 2 {
          if coins >= upCost[si] {
            bank = coins - upCost[si]
            since = tnow
            items = set(items, si, merge(it, {l: it.l + 1, sp: it.sp + upCost[si]}))
            haptic()
          } else {
            msg = "NOT ENOUGH COINS"
            msgT = time
          }
        } else if y >= BY && x >= PX + UW + 8 {
          bank = coins + floor(it.sp / 2)
          since = tnow
          items = remove(items, si)
          sel = -1
        }
      } else if (LS ? x >= PX : y >= PY) && y < PY + TH {
        tab = clamp(floor((x - PX) / (PW / 4)), 0, 3)
        tool = tab == 3 ? 12 : -1
        sel = -1
      } else if (LS ? x >= PX : y >= PY) && tab < 3 && y >= CY && x >= PX {
        let hi = floor((y - CY) / (CH + 6)) * CC + floor((x - PX) / (CW + 6))
        if hi >= 0 && hi < len(TABS[tab]) {
          tool = tool == TABS[tab][hi] ? -1 : TABS[tab][hi]
          sel = -1
        }
      }
    }

    // a finger dragged over the grass lays path
    onDrag: {
      let ax = floor((x - MX) / C)
      let ay = floor((y - MY) / C)
      let cell = ay * 8 + ax
      if tool == 12 && x >= MX && x < MX + MW && ay >= 12 - land && ay < 12 {
        if !isP[cell] && own[cell] < 0 && coins >= 10 {
          bank = coins - 10
          since = tnow
          paths = paths + [cell]
        }
      }
    }

    // ---- the grass, a checkerboard of two greens ----
    rect(MX, MY, MW, MH, fill: "#6cbf4a")
    for g in checker { rect(g[0], g[1], C, C, fill: "#66b745") }
    for g in tufts { rect(g[0], g[1], g[2] == "#8ad860" ? 2 * q : q, q, fill: g[2]) }

    // ---- the paths, edged where they meet grass ----
    for c in paths { rect(MX + c % 8 * C, MY + floor(c / 8) * C, C, C, fill: "#e8d4a8") }
    for r in edges { rect(r[0], r[1], r[2], r[3], fill: len(r) > 4 ? "#d4bc8c" : "#c4a878") }

    // ---- the entrance below the park: a hedge, the plaza and the gate ----
    rect(MX, MY + MH, MW, GH, fill: "#d8c8a0")
    rect(MX, MY + MH, 3 * C, 4 * q, fill: "#3a8a3a")
    rect(MX + 5 * C, MY + MH, 3 * C, 4 * q, fill: "#3a8a3a")
    rect(MX, MY + MH - 2 * q, 3 * C, 2 * q, fill: "#4fa040")
    rect(MX + 5 * C, MY + MH - 2 * q, 3 * C, 2 * q, fill: "#4fa040")
    rect(MX + 3 * C, MY + MH, 2 * C, GH, fill: "#e8d4a8")

    // ---- the land still for sale: woods behind a fence ----
    if land < 12 {
      rect(MX, MY, MW, (12 - land) * C, fill: "#3f7f3a")
      for g in pines {
        path(pineShape.map(v => [g[0] + v[0] * C / 9, g[1] + v[1] * C / 9]), closed: true, fill: "#2c5e30")
      }
      rect(MX, MY + (12 - land) * C - 3 * q, MW, q, fill: "#8a5a32")
      rect(MX, MY + (12 - land) * C - 6 * q, MW, q, fill: "#8a5a32")
      for f in range(17) { rect(MX + f * C / 2 - q / 2, MY + (12 - land) * C - 8 * q, 1.5 * q, 7 * q, fill: "#6a4428") }
      let sq = C / 7
      let sx = MX + MW / 2 - 11 * sq
      let sy = MY + (12 - land) * C - 11 * sq
      sprite(signArt, sx, sy, sq, palette: PAL)
      text("FOR SALE", MX + MW / 2, sy + 2.3 * sq, size: 1.9 * sq, color: "#e04848", font: press, align: center)
      text([LANDCOST[(land - 6) / 2]].map(fmt)[0], MX + MW / 2, sy + 4.7 * sq, size: 1.7 * sq, color: "#2a1e30", font: press, align: center)
      if sel == -2 { rect(MX, MY, MW, (12 - land) * C, stroke: UI.gold, width: 2) }
    }

    // ---- the guests ----
    // Each round of 22 s a guest walks from the gate to a ride or stall picked by hash, stays 4 s,
    // walks back, and spends the rest of the round on the plaza by the gate. On a ride they're
    // out of sight; at a stall they stand by it.
    clip(MX, MY, MW, MH + GH) {
      for g, k in crowd {
        let ph = time / 22 + g.o
        let n = floor(ph)
        let tc = (ph - n) * 22
        let di = dest[floor(hash(k, n, 2) * len(dest))]
        let pts = routes[di]
        let S = len(pts) - 1
        let v = max(1.3, S / 8)
        let tw = S / v
        let f = tc < tw ? tc * v : tc < tw + 4 ? S : tc < 2 * tw + 4 ? S - (tc - tw - 4) * v : 0
        let i0 = min(floor(f), S - 1)
        let fr = f - i0
        // out on the plaza: to a spot of its own and back to the gate in time
        let pa = tc > 2 * tw + 4 ? clamp(min(tc - 2 * tw - 4, 22 - tc) / 2.5, 0, 1) : 0
        let gx = MX + (lerp(lerp(pts[i0][0], pts[i0 + 1][0], fr), 0.6 + hash(k, n, 3) * 6.8, pa) + g.dx) * C
        let gy = MY + (lerp(lerp(pts[i0][1], pts[i0 + 1][1], fr), 12.4 + hash(k, n, 4) * 0.3, pa) + g.dy * (1 - pa)) * C
        let step = (f < S && f > 0) || (pa > 0 && pa < 1) ? floor(time * 6 + k) % 2 : 0
        if f < S || info[di].t == 1 {
          if g.ball {
            rect(gx + q, gy - 12 * q, q / 2, 7 * q, fill: "#fff6e8")
            rect(gx, gy - 15 * q + sin(time * 2 + k) * q, 3 * q, 3 * q, fill: g.bc)
          }
          rect(gx - 1.5 * q, gy - q, 4 * q, 1.5 * q, fill: alpha("#000000", 0.18))
          rect(gx - q, gy - 7 * q, 2.5 * q, 2.5 * q, fill: "#f4c8a0")
          rect(gx - q, gy - 7.5 * q, 2.5 * q, q, fill: g.hair)
          rect(gx - 1.5 * q, gy - 4.5 * q, 3.5 * q, 3 * q, fill: g.shirt)
          rect(gx - q + step * 0.5 * q, gy - 1.5 * q, q, 2 * q, fill: "#2a1e30")
          rect(gx + q - step * 0.5 * q, gy - 1.5 * q, q, 2 * q, fill: "#2a1e30")
        }
      }
    }

    // ---- the gate, over the guests walking under it ----
    rect(MX + 3 * C - 3 * q, MY + MH - 10 * q, 3 * q, GH + 10 * q, fill: "#7a7490")
    rect(MX + 5 * C, MY + MH - 10 * q, 3 * q, GH + 10 * q, fill: "#7a7490")
    rect(MX + 3 * C - 3 * q, MY + MH - 10 * q, q, GH + 10 * q, fill: "#c0b8d0")
    rect(MX + 5 * C, MY + MH - 10 * q, q, GH + 10 * q, fill: "#c0b8d0")
    rect(MX + 3 * C - 5 * q, MY + MH - 16 * q, 2 * C + 10 * q, 7 * q, fill: "#2a1e30")
    rect(MX + 3 * C - 4 * q, MY + MH - 15 * q, 2 * C + 8 * q, 5 * q, fill: "#e04848")
    text("PARK", MX + 4 * C, MY + MH - 12.3 * q, size: 3.4 * q, color: "#ffd36a", font: press, align: center)
    for j in range(2) {
      let fx = MX + 3 * C - 3 * q + j * (2 * C + 3 * q)
      rect(fx + q, MY + MH - 22 * q, q / 2, 6 * q, fill: "#2a1e30")
      rect(fx + 1.5 * q, MY + MH - 22 * q, (3 + floor(time * 4 + j) % 2) * q, 2.5 * q, fill: j == 0 ? "#ffd36a" : "#4a90e0")
    }

    // ---- rides, stalls and gardens, from the back row to the front ----
    for i in order {
      let it = items[i]
      let K = it.k
      let ix = MX + it.c % 8 * C
      let iy = MY + floor(it.c / 8) * C
      let by = iy + KD[K].w * C
      let ph = hash(it.c, 12) * 10
      rect(ix + q, by - 2.5 * q, KD[K].w * C - 2 * q, 2 * q, fill: alpha("#000000", 0.15))
      if K == 9 {
        // a tree: a rounded crown on a trunk
        rect(ix + 7 * q, by - 7 * q, 2 * q, 5 * q, fill: "#6a4428")
        rect(ix + 2 * q, by - 16 * q, 12 * q, 9 * q, fill: "#2a1e30")
        rect(ix + 3 * q, by - 17 * q, 10 * q, 11 * q, fill: "#2a1e30")
        rect(ix + 3 * q, by - 15 * q, 10 * q, 7 * q, fill: "#3a8a3a")
        rect(ix + 4 * q, by - 16 * q, 8 * q, 9 * q, fill: "#3a8a3a")
        rect(ix + 3 * q, by - 15 * q, 9 * q, 5 * q, fill: "#5fb048")
        rect(ix + 4 * q, by - 16 * q, 7 * q, 7 * q, fill: "#5fb048")
        rect(ix + 5 * q, by - 15 * q, 3 * q, 2 * q, fill: "#8ad860")
      } else if K == 10 {
        // a flower bed
        rect(ix + q, by - 11 * q, 14 * q, 7 * q, fill: "#2a1e30")
        rect(ix + 2 * q, by - 12 * q, 12 * q, 9 * q, fill: "#2a1e30")
        rect(ix + 2 * q, by - 11 * q, 12 * q, 7 * q, fill: "#3a8a3a")
        rect(ix + 3 * q, by - 11 * q, 10 * q, 6 * q, fill: "#5fb048")
        for fl in [[4, 9, 0], [7, 10, 2], [10, 9, 4], [5, 7, 7], [9, 7, 5], [11, 6, 2], [3, 6, 4]] {
          rect(ix + fl[0] * q, by - (fl[1] + 1) * q, 2 * q, 2 * q, fill: BRIGHT[fl[2]])
        }
      } else if K == 11 {
        // a fountain, splashing
        rect(ix + q, by - 9 * q, 14 * q, 7 * q, fill: "#2a1e30")
        rect(ix + 2 * q, by - 10 * q, 12 * q, 9 * q, fill: "#2a1e30")
        rect(ix + 2 * q, by - 9 * q, 12 * q, 7 * q, fill: "#c0b8d0")
        rect(ix + 2 * q, by - 4 * q, 12 * q, 2 * q, fill: "#7a7490")
        rect(ix + 3 * q, by - 8 * q, 10 * q, 4 * q, fill: "#3a9ad8")
        rect(ix + 4 * q, by - 8 * q, 8 * q, 2 * q, fill: "#a8e8ff")
        rect(ix + 7 * q, by - 14 * q, 2 * q, 8 * q, fill: "#c0b8d0")
        rect(ix + 6 * q, by - 14 * q, 4 * q, q, fill: "#7a7490")
        for j in range(4) {
          let sp = (time * 1.2 + j / 4) % 1
          rect(ix + (7.5 + (j % 2 == 0 ? -1 : 1) * sp * 4) * q, by - (15 + sp * 3 - sp * sp * 9) * q, q, q, fill: "#a8e8ff")
        }
      } else if lod[i] == 1 {
        sprite(liteArt[K], ix, by - len(liteArt[K]) * 2 * q, 2 * q, palette: PAL)
      } else if lod[i] == 0 {
        // past what a frame can draw: a plain block in the kind's colour
        rect(ix + q, iy + q, KD[K].w * C - 2 * q, KD[K].w * C - 2 * q, fill: "#2a1e30")
        rect(ix + 2 * q, iy + 2 * q, KD[K].w * C - 4 * q, KD[K].w * C - 4 * q, fill: BRIGHT[K % 8])
      } else if K == 0 {
        sprite(carouselArt[floor(time * 6 + ph) % 4], ix, by - 18 * q, q, palette: PAL)
      } else if K == 1 {
        sprite(teaBaseArt, ix, by - 16 * q, q, palette: PAL)
        for j in range(3) {
          let a = time * 1.6 + ph + j * 2.094
          sprite(cupArt, ix + floor(5 + 4.5 * cos(a)) * q, by - 16 * q + floor(6.5 + 2.8 * sin(a)) * q, q, palette: tint[j * 2 + 1])
        }
      } else if K == 2 {
        for r in bumperArt {
          let rx = round(ix + r[0] * q)
          let ry = round(by - (32 - r[1]) * q)
          rect(rx, ry, round(ix + (r[0] + r[2]) * q) - rx, round(by - (32 - r[1] - r[3]) * q) - ry, fill: r[4])
        }
        for j in range(4) {
          let bx = floor(13 + 9 * sin(time * 0.9 + ph + j * 1.7))
          let byy = floor(14 + 8 * sin(time * 1.27 + ph + j * 2.3))
          sprite(carArt, ix + bx * q, by - 32 * q + byy * q, q, palette: tint[j])
          if floor(time * 8 + j * 3) % 9 == 0 { rect(ix + (bx + 2) * q, by - 33 * q + byy * q, 2 * q, q, fill: "#ffd36a") }
        }
      } else if K == 3 {
        let th = time * 16 + ph * 36
        sprite(wheelArt[floor(th / 11.25) % 4], ix, by - 34 * q, q, palette: PAL)
        for g in range(8) {
          let a = rad(th + g * 45)
          let gx = floor(16 + 12.5 * cos(a))
          let gy = floor(14 + 12.5 * sin(a))
          rect(ix + (gx - 2) * q, by - 34 * q + gy * q, 4 * q, 4 * q, fill: "#2a1e30")
          rect(ix + (gx - 1) * q, by - 34 * q + (gy + 1) * q, 2 * q, 2 * q, fill: BRIGHT[g % 6])
        }
      } else if K == 4 {
        sprite(flumeArt, ix, by - 32 * q, q, palette: PAL)
        for j in range(2) {
          let u = (time * 7 + ph + j * 24) % 48
          let u0 = floor(u)
          let fp = flumePath[u0]
          let np = flumePath[(u0 + 1) % 48]
          let lx = lerp(fp[0], np[0], u - u0)
          let ly = lerp(fp[1], np[1], u - u0)
          let hz = abs(np[0] - fp[0]) >= abs(np[1] - fp[1]) ? 0 : 1
          sprite(logArt[hz], ix + floor(lx - (hz == 0 ? 3 : 2)) * q, by - 32 * q + floor(ly - (hz == 0 ? 2 : 3)) * q, q, palette: PAL)
        }
        for j in range(3) {
          let sp = (time * 1.4 + j / 3) % 1
          rect(ix + (27 + j - sp * 2) * q, by - 32 * q + (16 - sp * 5 + sp * sp * 6) * q, q, q, fill: "#fff6e8")
        }
      } else if K == 5 {
        sprite(coasterArt, ix, by - 34 * q, q, palette: PAL)
        let u = (time * 16 + 3 * sin(time * 0.7) + ph) % 64
        for j in range(3) {
          let uu = (u - j * 2.2 + 64) % 64
          let u0 = floor(uu)
          let cp = coasterPath[u0]
          let np = coasterPath[(u0 + 1) % 64]
          let cx = floor(lerp(cp[0], np[0], uu - u0))
          let cy = floor(lerp(cp[1], np[1], uu - u0))
          rect(ix + (cx - 1) * q, by - 34 * q + (cy - 2) * q, 4 * q, 4 * q, fill: "#2a1e30")
          rect(ix + cx * q, by - 34 * q + (cy - 1) * q, 2 * q, 2 * q, fill: j == 0 ? "#ffd36a" : "#4a90e0")
          rect(ix + cx * q, by - 34 * q + (cy - 2) * q, q, q, fill: "#f4c8a0")
        }
      } else if K >= 6 {
        for r in stallArt[K - 6] {
          let rx = round(ix + r[0] * q)
          let ry = round(by - (18 - r[1]) * q)
          rect(rx, ry, round(ix + (r[0] + r[2]) * q) - rx, round(by - (18 - r[1] - r[3]) * q) - ry, fill: r[4])
        }
        for j in range(K == 8 ? 3 : 0) {
          rect(ix + (2 + j * 2) * q, by - (21 - j) * q, q / 2, (6 - j) * q, fill: "#2a1e30")
          rect(ix + (1 + j * 2) * q, by - (25 - j + sin(time * 2 + j) * 0.8) * q, 3 * q, 3 * q, fill: BRIGHT[[0, 4, 1][j]])
        }
      }
      // a ride or stall that no path reaches asks for one
      if !conn[i] && KD[K].t < 2 && time % 1.2 < 0.9 {
        sprite(bubbleArt, ix + (KD[K].w * 8 - 3.5) * q, iy - 9 * q, q, palette: PAL)
      }
      // and a coin now and then from those that earn
      if conn[i] && KD[K].t < 2 {
        let cyc = (time * 0.45 + hash(it.c, 13) * 2) % 2.2
        if cyc < 1 {
          sprite(coinArt, ix + (KD[K].w * 8 - 3.5) * q, iy - (4 + cyc * 8) * q, q, palette: coinFade[floor(cyc * 4)])
        }
      }
      if it.c == sel {
        rect(ix, iy, KD[K].w * C, KD[K].w * C, stroke: UI.gold, width: 2)
      }
    }

    // where the picked kind can go
    if tool >= 0 {
      for c in free { rect(MX + (c % 8 + 0.5) * C - q, MY + (floor(c / 8) + 0.5) * C - q, 2 * q, 2 * q, fill: alpha("#ffffff", 0.55)) }
    }

    // ---- what the park is making ----
    sprite(coinArt, 14, TOP + 6, 2.8, palette: PAL)
    text([coins].map(fmt)[0], 40, TOP + 14, size: 13, color: UI.text, font: press)
    text("${[rate].map(fmtRate)[0]}/S", 40, TOP + 31, size: 7, color: UI.dim, font: press)
    for s in range(5) {
      sprite(starArt, SW - 14 - (5 - s) * 13, TOP + 8, 2.2, palette: s < stars ? PAL : {o: alpha(UI.dim, 0.6)})
    }
    text("${guests} GUESTS", SW - 16, TOP + 31, size: 7, color: UI.dim, font: press, align: end)

    // ---- the panel ----
    if sel == -2 && land < 12 {
      text("MORE LAND", PX + 4, PY + 16, size: 11, color: UI.text, font: press)
      text("TWO MORE ROWS OF GRASS", PX + 4, PY + 38, size: 7, color: UI.dim, font: press)
      text("FOR RIDES, STALLS AND GARDENS", PX + 4, PY + 54, size: 7, color: UI.dim, font: press)
      text("✕", PX + PW - 14, PY + 14, size: 14, color: UI.dim, align: center)
      rect(PX, BY, PW, BH, fill: coins >= LANDCOST[(land - 6) / 2] ? UI.go : UI.card, radius: 6 * corners)
      text("BUY  ${[LANDCOST[(land - 6) / 2]].map(fmt)[0]}", PX + PW / 2, BY + BH / 2, size: 10, color: coins >= LANDCOST[(land - 6) / 2] ? UI.text : UI.dim, font: press, align: center)
    } else if si >= 0 {
      let it = items[si]
      let f = info[si]
      let ic = icons[it.k]
      rect(PX, PY + 2, 44, 44, fill: UI.card, radius: 6 * corners)
      for r in ic { rect(PX + 4 + r[0] * 3, PY + 6 + r[1] * 3, r[2] * 3, r[3] * 3, fill: r[4]) }
      text(KD[it.k].n, PX + 54, PY + 14, size: 10, color: UI.text, font: press)
      text(KD[it.k].t == 2 ? "GARDEN" : "LEVEL ${it.l}", PX + 54, PY + 34, size: 7, color: UI.dim, font: press)
      text("✕", PX + PW - 14, PY + 14, size: 14, color: UI.dim, align: center)
      if KD[it.k].t == 2 {
        text("+${KD[it.k].b * 10}% FOR EVERY RIDE", PX + 4, PY + 64, size: 7, color: UI.text, font: press)
        text("AND STALL NEXT TO IT", PX + 4, PY + 80, size: 7, color: UI.text, font: press)
      } else if !conn[si] {
        text("NO PATH TO THE GATE", PX + 4, PY + 64, size: 8, color: UI.warn, font: press)
        text("LAY ONE FROM THE PATH TAB", PX + 4, PY + 82, size: 7, color: UI.dim, font: press)
      } else {
        text("+${[earn[si]].map(fmtRate)[0]}/S", PX + 4, PY + 64, size: 10, color: UI.gold, font: press)
        text(KD[it.k].t == 0 ? "BRINGS ${floor(KD[it.k].pull * (1 + 0.15 * (it.l - 1)) * boost[si] * (0.6 + 0.2 * stars))} GUESTS" : "SELLS TO ${guests} GUESTS", PX + 4, PY + 84, size: 7, color: UI.dim, font: press)
        if f.beauty > 0 {
          text("GARDENS +${round(min(0.6, 0.1 * f.beauty) * 100)}%", PX + 4, PY + 100, size: 7, color: UI.go, font: press)
        }
      }
      if KD[it.k].t < 2 {
        rect(PX, BY, UW, BH, fill: coins >= upCost[si] ? UI.go : UI.card, radius: 6 * corners)
        text("UPGRADE", PX + UW / 2, BY + BH / 2 - 7, size: 8, color: coins >= upCost[si] ? UI.text : UI.dim, font: press, align: center)
        text([upCost[si]].map(fmt)[0], PX + UW / 2, BY + BH / 2 + 8, size: 8, color: coins >= upCost[si] ? UI.text : UI.dim, font: press, align: center)
      }
      rect(PX + UW + 8, BY, PW - UW - 8, BH, fill: UI.card, radius: 6 * corners)
      text("SELL", PX + UW + 8 + (PW - UW - 8) / 2, BY + BH / 2 - 7, size: 8, color: UI.text, font: press, align: center)
      text("+${[floor(it.sp / 2)].map(fmt)[0]}", PX + UW + 8 + (PW - UW - 8) / 2, BY + BH / 2 + 8, size: 8, color: UI.dim, font: press, align: center)
    } else {
      for t in range(4) {
        let tx = PX + t * PW / 4
        rect(tx + 2, PY, PW / 4 - 4, TH, fill: tab == t ? UI.gold : UI.card, radius: 6 * corners)
        text(["RIDES", "FOOD", "GARDEN", "PATH"][t], tx + PW / 8, PY + TH / 2, size: 7, color: tab == t ? UI.bg : UI.text, font: press, align: center)
      }
      if tab == 3 {
        text("TAP OR DRAG ON GRASS", PX + 4, CY + 12, size: 8, color: UI.text, font: press)
        text("TO LAY PATH, 10 A CELL", PX + 4, CY + 30, size: 8, color: UI.text, font: press)
        text("TAP A PATH TO TAKE IT UP", PX + 4, CY + 54, size: 7, color: UI.dim, font: press)
        text("RIDES AND STALLS EARN ONCE", PX + 4, CY + 74, size: 7, color: UI.dim, font: press)
        text("A PATH LEADS TO THE GATE", PX + 4, CY + 90, size: 7, color: UI.dim, font: press)
      } else {
        for k, j in TABS[tab] {
          let cx = PX + j % CC * (CW + 6)
          let cy = CY + floor(j / CC) * (CH + 6)
          let can = coins >= price[k]
          let ip = min(3, (CH - 30) / 12)
          rect(cx, cy, CW, CH, fill: UI.card, radius: 6 * corners)
          if tool == k { rect(cx + 1, cy + 1, CW - 2, CH - 2, stroke: UI.gold, width: 2, radius: 6 * corners) }
          for r in icons[k] { rect(round(cx + CW / 2 + (r[0] - 6) * ip), round(cy + 6 + r[1] * ip), round(r[2] * ip + 0.4), round(r[3] * ip + 0.4), fill: r[4]) }
          text(KD[k].n, cx + CW / 2, cy + CH - 22, size: CW < 120 ? 5 : 6, color: UI.text, font: press, align: center)
          text([price[k]].map(fmt)[0], cx + CW / 2, cy + CH - 9, size: 7, color: can ? UI.gold : UI.dim, font: press, align: center)
        }
        if tab > 0 {
          text(tab == 1 ? "STALLS EARN FROM EVERY GUEST" : "GARDENS: MORE FOR WHAT'S NEXT TO THEM", PX + 4, CY + CH + 20, size: 6, color: UI.dim, font: press)
          text(tab == 1 ? "IN THE PARK" : "AND MORE STARS FOR THE PARK", PX + 4, CY + CH + 34, size: 6, color: UI.dim, font: press)
        }
      }
    }

    // ---- a hint for a new park, and messages ----
    if len(items) == 0 {
      if time % 1.4 < 1 {
        text("PICK A RIDE BELOW,", MX + MW / 2, MY + MH - 3.2 * C, size: 8, color: "#2a1e30", font: press, align: center)
        text("THEN TAP THE GRASS", MX + MW / 2, MY + MH - 3.2 * C + 16, size: 8, color: "#2a1e30", font: press, align: center)
      }
    } else if len(dest) == 0 && any(info, f => f.t < 2) {
      if time % 1.4 < 1 {
        text("LAY A PATH FROM THE GATE", MX + MW / 2, MY + MH - 3.2 * C, size: 7, color: "#2a1e30", font: press, align: center)
        text("IN THE PATH TAB", MX + MW / 2, MY + MH - 3.2 * C + 14, size: 7, color: "#2a1e30", font: press, align: center)
      }
    }
    if time - msgT < 2.2 && time >= msgT {
      let ma = min(1, (2.2 - (time - msgT)) * 3)
      rect(MX + 8, MY + MH / 2 - 18, MW - 16, 36, fill: alpha("#2a1e30", 0.85 * ma), radius: 6 * corners)
      text(msg, MX + MW / 2, MY + MH / 2, size: 9, color: alpha("#ffd36a", ma), font: press, align: center)
    }
  }
}
