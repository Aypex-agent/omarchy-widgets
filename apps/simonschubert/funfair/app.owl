app "funfair" {
  meta { owl: 23; description: "A 3D fairground to build and run: lay paths, open food, drink, game and gift stands, set their prices, and keep guests fed, amused and tidy with benches, bins, flowers and staff"; version: "1.3"; license: "MIT"; category: "games" }
  // How it works. The fairground is 24 x 24 tiles, kept in a list, g (what's on a tile). Guests are simulated one by
  // one: each is a map with a wallet, hunger, thirst, bladder, energy, boredom and mood, walking from tile to tile along
  // the paths. Every frame moves them; a guest who reaches a tile's middle decides what to do next. Handlers have no
  // loops, so the deciding is a few passes of map() over the guests, each adding to the ones who are deciding, and
  // what they did (bought, dropped litter, joined a queue) is read off them afterwards and added to the cash, the
  // stands' numbers and the litter. No money comes from anywhere else: a sale is the price a guest paid, less what the
  // goods cost; wages, upkeep and interest go out as the day passes.
  //
  // Finding things: for each need (food, drink, toilets, cash, a seat, a game, a shop, the way out) and each staff job
  // (litter, dry flower beds, broken stands) there's a list of how far every path tile is from the nearest one, walked
  // out from them breadth first, one list a frame in turn. A guest with a pressing need steps to the neighbour nearer
  // to it; the others wander. So where paths lead, and what stands along them, is the game.
  //
  // Drawing: everything is 3D (Canvas scene and model). The ground is a few meshes of one flat square per tile, made
  // again only when the park changes, in a scene of its own so nothing is sorted under it. Stands are meshes made once
  // from boxes, roofs, cylinders, cones and balls, each with something on its roof that says what it sells. One finger
  // pans (or paints paths while that tool is out and the finger held still first), two fingers zoom and turn, a tap
  // builds or looks at what's there.
  title: ""
  statusBar: false
  edge: true
  fps: modes.saver ? 30 : 60
  source modes = android.modes
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath>
    <g clip-path="url(#t)">
    <rect width="256" height="256" fill="#8fd3f0"/>
    <rect y="176" width="256" height="80" fill="#6cc24a"/>
    <path d="M112 256 L122 176 L134 176 L144 256 Z" fill="#e8cf9a"/>
    <rect x="52" y="120" width="152" height="70" fill="#fff4dc"/>
    <rect x="52" y="120" width="19" height="70" fill="#e2483d"/><rect x="90" y="120" width="19" height="70" fill="#e2483d"/>
    <rect x="147" y="120" width="19" height="70" fill="#e2483d"/><rect x="185" y="120" width="19" height="70" fill="#e2483d"/>
    <rect x="109" y="140" width="38" height="50" fill="#3a2a3f"/>
    <path d="M128 44 L224 120 L32 120 Z" fill="#e2483d"/>
    <path d="M128 44 L160 120 L96 120 Z" fill="#fff4dc"/>
    <path d="M128 44 L208 120 L186 120 Z" fill="#fff4dc"/><path d="M128 44 L48 120 L70 120 Z" fill="#fff4dc"/>
    <rect x="126" y="20" width="4" height="26" fill="#3a2a3f"/><path d="M130 20 L156 28 L130 36 Z" fill="#ffc233"/>
    <circle cx="214" cy="60" r="16" fill="#ffc233"/><circle cx="44" cy="70" r="13" fill="#f48fb1"/>
    <rect x="43" y="83" width="2" height="40" fill="#3a2a3f"/>
    </g></svg>"""
