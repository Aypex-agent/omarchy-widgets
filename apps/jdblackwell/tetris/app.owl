app "tetris" {
  meta { owl: 10; description: "Touch Tetris with theme colors, ghost pieces, seven-bag randomizer and saved best score"; version: "1.3"; license: "MIT"; category: "games" }
  // The header below is the title: no title row, and the keys run on under the navigation bar.
  title: ""
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round">
    <path d="M6 30h12v-12h12v12h12v12H6z"/>
    <path d="M18 30v12M30 30v12M18 30h12"/>
    <path d="M24 6h12v12H24z"/>
  </svg>"""
  requires { pacman: [] }
  let shapes = [[[{"x":0,"y":1},{"x":1,"y":1},{"x":2,"y":1},{"x":3,"y":1}],[{"x":2,"y":0},{"x":2,"y":1},{"x":2,"y":2},{"x":2,"y":3}],[{"x":3,"y":2},{"x":2,"y":2},{"x":1,"y":2},{"x":0,"y":2}],[{"x":1,"y":3},{"x":1,"y":2},{"x":1,"y":1},{"x":1,"y":0}]],[[{"x":1,"y":0},{"x":2,"y":0},{"x":1,"y":1},{"x":2,"y":1}],[{"x":1,"y":0},{"x":2,"y":0},{"x":1,"y":1},{"x":2,"y":1}],[{"x":1,"y":0},{"x":2,"y":0},{"x":1,"y":1},{"x":2,"y":1}],[{"x":1,"y":0},{"x":2,"y":0},{"x":1,"y":1},{"x":2,"y":1}]],[[{"x":1,"y":0},{"x":0,"y":1},{"x":1,"y":1},{"x":2,"y":1}],[{"x":2,"y":1},{"x":1,"y":0},{"x":1,"y":1},{"x":1,"y":2}],[{"x":1,"y":2},{"x":2,"y":1},{"x":1,"y":1},{"x":0,"y":1}],[{"x":0,"y":1},{"x":1,"y":2},{"x":1,"y":1},{"x":1,"y":0}]],[[{"x":1,"y":0},{"x":2,"y":0},{"x":0,"y":1},{"x":1,"y":1}],[{"x":2,"y":1},{"x":2,"y":2},{"x":1,"y":0},{"x":1,"y":1}],[{"x":1,"y":2},{"x":0,"y":2},{"x":2,"y":1},{"x":1,"y":1}],[{"x":0,"y":1},{"x":0,"y":0},{"x":1,"y":2},{"x":1,"y":1}]],[[{"x":0,"y":0},{"x":1,"y":0},{"x":1,"y":1},{"x":2,"y":1}],[{"x":2,"y":0},{"x":2,"y":1},{"x":1,"y":1},{"x":1,"y":2}],[{"x":2,"y":2},{"x":1,"y":2},{"x":1,"y":1},{"x":0,"y":1}],[{"x":0,"y":2},{"x":0,"y":1},{"x":1,"y":1},{"x":1,"y":0}]],[[{"x":0,"y":0},{"x":0,"y":1},{"x":1,"y":1},{"x":2,"y":1}],[{"x":2,"y":0},{"x":1,"y":0},{"x":1,"y":1},{"x":1,"y":2}],[{"x":2,"y":2},{"x":2,"y":1},{"x":1,"y":1},{"x":0,"y":1}],[{"x":0,"y":2},{"x":1,"y":2},{"x":1,"y":1},{"x":1,"y":0}]],[[{"x":2,"y":0},{"x":0,"y":1},{"x":1,"y":1},{"x":2,"y":1}],[{"x":2,"y":2},{"x":1,"y":0},{"x":1,"y":1},{"x":1,"y":2}],[{"x":0,"y":2},{"x":2,"y":1},{"x":1,"y":1},{"x":0,"y":1}],[{"x":0,"y":0},{"x":1,"y":2},{"x":1,"y":1},{"x":1,"y":0}]]]
  let palette = [cyan, yellow, magenta, green, red, blue, orange]
  state board = range(200).map(i => -1)
  state bag = shuffle(range(7))
  state piece = 2
  state turn = 0
  state px = 3
  state py = 0
  state started = false
  state restart = 0
  state playing = false
  state over = false
  state score = 0
  state cleared = 0
  state best = 0 persist
  state event = {seq: 0, kind: ""}
  let level = 1 + floor(cleared / 10)
  let blocks = shapes[piece][turn]
  let cells = blocks.map(b => {x: px + b.x, y: py + b.y})
  let landing = (find(range(1, 22), d => any(cells, b => b.y + d >= 20 || board[(b.y + d) * 10 + b.x] >= 0)) ?? 21) - 1
  // Keep the record as soon as points are earned, including soft drops.
  on score first { best = max(best, value) }
  on restart {
    best = max(best, score)
    board = range(200).map(i => -1)
    score = 0
    cleared = 0
    bag = shuffle(range(7))
    piece = bag[0]
    bag = drop(bag, 1)
    px = 3
    py = 0
    turn = 0
    over = false
    started = true
    playing = true
  }
  every 1s {
    if playing { event = {seq: event.seq + 1, kind: "tick"} }
  }
  on event {
    if playing {
      let kind = value.kind
      let dx1 = kind == "left" ? -1 : kind == "right" ? 1 : 0
      let rotated = kind == "rotate" ? (turn + 1) % 4 : turn
      let drop1 = kind == "hard" ? landing : kind == "down" || kind == "tick" ? 1 : 0
      let offsets = kind == "rotate" ? [0, -1, 1, -2, 2] : [0]
      let kick = find(offsets, k => all(shapes[piece][rotated], b => px + dx1 + k + b.x >= 0 && px + dx1 + k + b.x < 10 && py + drop1 + b.y >= 0 && py + drop1 + b.y < 20 && board[(py + drop1 + b.y) * 10 + px + dx1 + k + b.x] < 0))
      if kick != null {
        px = px + dx1 + kick
        py = py + drop1
        turn = rotated
        if kind == "down" { score = score + 1 }
        if kind == "hard" { score = score + drop1 * 2 }
      }
      if kind == "hard" || ((kind == "down" || kind == "tick") && kick == null) {
        let locked = shapes[piece][turn].map(b => (py + b.y) * 10 + px + b.x)
        let filled = board.map((v, i) => contains(locked, i) ? piece : v)
        let full = range(20).filter(r => all(range(10), c => filled[r * 10 + c] >= 0))
        let remaining = range(20).filter(r => !contains(full, r)).map(r => range(10).map(c => filled[r * 10 + c]))
        board = flatten([range(len(full) * 10).map(i => -1), flatten(remaining)])
        score = score + [0, 100, 300, 500, 800][len(full)] * level
        cleared = cleared + len(full)
        best = max(best, score)
        piece = bag[0]
        bag = drop(bag, 1)
        if len(bag) < 7 { bag = flatten([bag, shuffle(range(7))]) }
        turn = 0
        px = 3
        py = 0
        if any(shapes[piece][0], b => board[b.y * 10 + 3 + b.x] >= 0) {
          over = true
          playing = false
        }
      }
    }
  }
  component Key(label, action) {
    Box {
      weight: 1
      height: 54
      background: surface
      border: 1
      borderColor: border
      radius: 8 * corners
      align: center
      onTap: { event = {seq: event.seq + 1, kind: action}; haptic() }
      Text { text: label; align: center; fontSize: 22; bold: true; color: accent }
    }
  }
  Column {
    fill: true
    padding: 16
    gap: 10
    Row {
      align: center
      Text { text: "TETRIS"; fontSize: 25; fontWeight: 900; letterSpacing: 3; color: accent }
      Spacer { weight: 1 }
      Text { text: "HIGH SCORE ${best}"; fontSize: 11; color: muted }
    }
    Row {
      gap: 12
      Text { text: "${score}"; fontSize: 22; bold: true; weight: 1 }
      Text { text: "LINES ${cleared}  ·  LV ${level}"; fontSize: 11; color: muted }
      Canvas {
        width: 48
        height: 28
        for b in shapes[bag[0]][0] { rect(b.x * 11, b.y * 11 + 2, 9, 9, radius: 1, fill: palette[bag[0]]) }
      }
    }
    Box {
      weight: 1
      fill: width
      clip: true
      Box {
        fill: true
        Canvas {
          fill: true
          onTap: event = {seq: event.seq + 1, kind: "rotate"}
          // Fit the board inside the space left ABOVE the controls.
          let unit = max(1, min((width - 2) / 10, (height - 2) / 20))
          let left = (width - unit * 10) / 2
          let top = (height - unit * 20) / 2
          rect(left, top, unit * 10, unit * 20, fill: surface, stroke: border, width: 1)
          translate(left, top) {
          for r in range(20) {
            for c in range(10) {
              let ink = board[r * 10 + c]
              rect(c * unit + 1, r * unit + 1, unit - 1, unit - 1, radius: 2 * corners, fill: ink >= 0 ? palette[ink] : alpha(foreground, 0.025))
            }
          }
          if !over {
            for b in cells {
              rect(b.x * unit + 2, (b.y + landing) * unit + 2, unit - 3, unit - 3, radius: 2 * corners, stroke: alpha(palette[piece], 0.5), width: 1)
              rect(b.x * unit + 1, b.y * unit + 1, unit - 1, unit - 1, radius: 2 * corners, fill: palette[piece])
              rect(b.x * unit + 3, b.y * unit + 3, unit - 5, 2, fill: alpha(foreground, 0.3))
            }
          }
          }
        }
        if !playing {
          Box {
            fill: true
            align: center
            background: alpha(background, 0.87)
            Column {
              align: center
              padding: 16
              gap: 14
              Text { text: over ? "GAME OVER" : started ? "PAUSED" : "READY?"; fontSize: 27; bold: true; color: accent; align: center }
              Text { text: over ? "${score} points" : "Tap the board to rotate.\nUse the buttons to move and drop."; align: center; fontSize: 12; color: foreground }
              Text { text: "SCORE ${score}  ·  HIGH SCORE ${best}"; align: center; fontSize: 12; color: accent }
              Button {
                text: over ? "PLAY AGAIN" : started ? "RESUME" : "PLAY"
                onTap: {
                  if over {
                    restart = restart + 1
                  } else {
                    started = true
                    playing = true
                  }
                }
              }
              if started && !over {
                Button { text: "RESTART"; onTap: restart = restart + 1 }
              }
            }
          }
        }
      }
    }
    Row {
      fill: width
      Key { label: "←"; action: "left" }
      Key { label: "↻"; action: "rotate" }
      Key { label: "→"; action: "right" }
    }
    Row {
      fill: width
      Key { label: "↓"; action: "down" }
      Key { label: "⤓ DROP"; action: "hard" }
      Box {
        weight: 1
        height: 54
        background: alpha(accent, 0.15)
        radius: 8 * corners
        align: center
        onTap: { if !over { started = true; playing = !playing } }
        Text { text: playing ? "PAUSE" : "RESUME"; align: center; fontSize: 12; bold: true; color: accent }
      }
    }
    Spacer { height: screenInset }
  }
}
