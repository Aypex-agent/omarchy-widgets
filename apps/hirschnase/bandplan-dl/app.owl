otfunk","l":"Notfunk = FM-Anruf","mode":null,"fS":"145,500"}]},{"id":"70","name":"70 cm","g":"UKW","lo":430000,"hi":440000,"loS":"430,000","hiS":"440,000","cls":{"A":"750 W PEP","E":"75 W PEP","N":"6,1 W ERP"},"notes":["FM-Simplex im 25-kHz-Raster: 433,400–433,575 MHz.","DL-Relais meist Ausgabe 438,650–439,575 MHz, Eingabe 7,6 MHz tiefer.","435–438 MHz nur Satellitenbetrieb.","IARU führt 432,000–432,400 als einen Schmalbandbereich; CW-Zentrum 432,050.","433,500 MHz ist FM-Anruf und zugleich Notfunk-Frequenz: kurz anrufen, dann auf einen freien Simplexkanal wechseln."],"segs":[{"lo":430000,"hi":432000,"k":"relais","l":"Relais-Eingaben (7,6 MHz) · Packet · Links","loS":"430,000","hiS":"432,000"},{"lo":432000,"hi":432100,"k":"cw","l":"Schmalband · CW bevorzugt","loS":"432,000","hiS":"432,100"},{"lo":432100,"hi":432400,"k":"ssb","l":"Schmalband · SSB · FT8","loS":"432,100","hiS":"432,400"},{"lo":432400,"hi":432500,"k":"bake","l":"Baken exklusiv","loS":"432,400","hiS":"432,500"},{"lo":432500,"hi":432600,"k":"daten","l":"APRS · Transponder","loS":"432,500","hiS":"432,600"},{"lo":432600,"hi":433000,"k":"relais","l":"Relais-Eingaben (2 MHz)","loS":"432,600","hiS":"433,000"},{"lo":433000,"hi":433400,"k":"relais","l":"Relais-Eingaben (1,6 MHz)","loS":"433,000","hiS":"433,400"},{"lo":433400,"hi":433600,"k":"fm","l":"FM/DV Simplex","loS":"433,400","hiS":"433,600"},{"lo":433600,"hi":434000,"k":"daten","l":"Digital · LoRa · Experimente","loS":"433,600","hiS":"434,000"},{"lo":434000,"hi":434600,"k":"andere","l":"All Mode · DATV/Digital","loS":"434,000","hiS":"434,600"},{"lo":434600,"hi":435000,"k":"relais","l":"Relais-Ausgaben (1,6/2 MHz)","loS":"434,600","hiS":"435,000"},{"lo":435000,"hi":438000,"k":"sat","l":"Satelliten","loS":"435,000","hiS":"438,000"},{"lo":438000,"hi":438650,"k":"daten","l":"Digitale Kommunikation · Packet","loS":"438,000","hiS":"438,650"},{"lo":438650,"hi":439600,"k":"relais","l":"Relais-Ausgaben (−7,6 MHz)","loS":"438,650","hiS":"439,600"},{"lo":439600,"hi":440000,"k":"daten","l":"Digital-Links · Funkruf","loS":"439,600","hiS":"440,000"}],"mk":[{"f":432050,"t":"call","l":"CW-Anruf","mode":"cw","fS":"432,050"},{"f":432174,"t":"ft8","l":"FT8","mode":null,"fS":"432,174"},{"f":432200,"t":"call","l":"SSB-Anruf","mode":"ssb","fS":"432,200"},{"f":432500,"t":"info","l":"APRS","mode":null,"fS":"432,500"},{"f":433450,"t":"info","l":"DV-Anruf","mode":null,"fS":"433,450"},{"f":433500,"t":"call","l":"FM-Anruf","mode":"fm","fS":"433,500"},{"f":433500,"t":"notfunk","l":"Notfunk = FM-Anruf","mode":null,"fS":"433,500"},{"f":433775,"t":"info","l":"LoRa APRS","mode":null,"fS":"433,775"},{"f":439987.5,"t":"info","l":"POCSAG","mode":null,"fS":"439,9875"}]},{"id":"23","name":"23 cm","g":"UKW","lo":1240000,"hi":1300000,"loS":"1240,000","hiS":"1300,000","cls":{"A":"750 W PEP","E":"75 W PEP"},"notes":["Sekundär: Primärnutzer sind Ortungsfunk und Satellitennavigation – Störungen unbedingt vermeiden.","1247–1263 MHz: max. 3,05 W ERP, dort keine fernbedienten oder automatischen Stationen (AFuV).","Bandbreite max. 2 MHz (ATV 7 bzw. 18 MHz).","Lokaler Schmalbandverkehr bei Contesten und Überreichweiten: 1296,500–1296,800 MHz.","FM-Raster 25 kHz. Relais RM: Ausgabe 1297,000–1297,475, Eingabe 6 MHz tiefer; RS: Ausgabe 1242,025–1242,700, Eingabe 28 MHz höher.","1297,900–1297,975 MHz: Simplex-Internet-Gateways."],"segs":[{"lo":1240000,"hi":1241000,"k":"daten","l":"Digitale Kommunikation · Reserve Schmalband","loS":"1240,000","hiS":"1241,000"},{"lo":1241000,"hi":1243250,"k":"relais","l":"Relais-Ausgaben RS1–RS28 · Digital","loS":"1241,000","hiS":"1243,250"},{"lo":1243250,"hi":1260000,"k":"andere","l":"ATV · Digital-ATV","loS":"1243,250","hiS":"1260,000"},{"lo":1260000,"hi":1270000,"k":"sat","l":"Satelliten","loS":"1260,000","hiS":"1270,000"},{"lo":1270000,"hi":1272000,"k":"relais","l":"Relais-Eingaben RS1–RS28 · Digital","loS":"1270,000","hiS":"1272,000"},{"lo":1272000,"hi":1290994,"k":"andere","l":"ATV · Digital-ATV","loS":"1272,000","hiS":"1290,994"},{"lo":1290994,"hi":1291494,"k":"relais","l":"FM/DV-Relais-Eingaben RM0–RM19","loS":"1290,994","hiS":"1291,494"},{"lo":1291494,"hi":1296000,"k":"andere","l":"All Modes · DATV-Relais-Eingaben","loS":"1291,494","hiS":"1296,000"},{"lo":1296000,"hi":1296150,"k":"cw","l":"CW · MGM · EME","loS":"1296,000","hiS":"1296,150"},{"lo":1296150,"hi":1296800,"k":"ssb","l":"SSB · CW · MGM","loS":"1296,150","hiS":"1296,800"},{"lo":1296800,"hi":1296994,"k":"bake","l":"Baken exklusiv","loS":"1296,800","hiS":"1296,994"},{"lo":1296994,"hi":1297494,"k":"relais","l":"FM/DV-Relais-Ausgaben RM0–RM19","loS":"1296,994","hiS":"1297,494"},{"lo":1297494,"hi":1298000,"k":"fm","l":"FM/DV Simplex SM20–SM39","loS":"1297,494","hiS":"1298,000"},{"lo":1298000,"hi":1299000,"k":"allmode","l":"All Mode · 25-kHz-Kanäle","loS":"1298,000","hiS":"1299,000"},{"lo":1299000,"hi":1299750,"k":"daten","l":"Highspeed-Daten · 5 × 150 kHz","loS":"1299,000","hiS":"1299,750"},{"lo":1299750,"hi":1300000,"k":"fm","l":"FM/DV · 8 Kanäle","loS":"1299,750","hiS":"1300,000"}],"mk":[{"f":1296000,"t":"info","l":"EME 1296,000–1296,025","mode":null,"fS":"1296,000"},{"f":1296174,"t":"ft8","l":"FT8","mode":null,"fS":"1296,174"},{"f":1296200,"t":"call","l":"CW/SSB-Anruf","mode":"cw","fS":"1296,200"},{"f":1296200,"t":"call","l":"CW/SSB-Anruf","mode":"ssb","fS":"1296,200"},{"f":1296500,"t":"info","l":"SSTV/Bild","mode":null,"fS":"1296,500"},{"f":1296600,"t":"info","l":"Schmalband-Daten","mode":null,"fS":"1296,600"},{"f":1297500,"t":"call","l":"FM-Anruf","mode":"fm","fS":"1297,500"},{"f":1297725,"t":"info","l":"DV-Anruf","mode":null,"fS":"1297,725"}]}],"kinds":{"cw":{"n":"CW","modes":["cw"],"ex":false,"c":"#6a9bf0"},"schmal":{"n":"Schmalband · Digimodes","modes":["cw","ft8"],"ex":false,"c":"#a585ec"},"auto":{"n":"Digimodes · automatische Stationen","modes":["cw"],"ex":false,"c":"#a585ec"},"ssb":{"n":"Alle Modes · Phonie (SSB)","modes":["ssb","cw"],"ex":false,"c":"#47bf86"},"allmode":{"n":"All Mode inkl. FM","modes":["ssb","cw","fm"],"ex":false,"c":"#3cbaae"},"fm":{"n":"FM Simplex","modes":["fm"],"ex":false,"c":"#f2894a"},"relais":{"n":"Relais · kein Simplex","modes":[],"ex":true,"c":"#8b969e"},"daten":{"n":"Daten · keine Sprache","modes":[],"ex":true,"c":"#8b969e"},"andere":{"n":"Sonstige Nutzung","modes":[],"ex":true,"c":"#8b969e"},"guard":{"n":"Schutzband","modes":[],"ex":true,"c":"#8b969e"},"bake":{"n":"Baken · nicht senden","modes":[],"ex":true,"c":"#ef6363"},"sat":{"n":"Satellit · kein Erdfunk","modes":[],"ex":true,"c":"#d8b03e"}},"fw":{"2":{"144500":{"w":true,"t":"Breit-FM möglich · bis 20 kHz"},"144975":{"w":false,"t":"NBFM · 12,5-kHz-Raster"},"145206":{"w":false,"t":"NBFM · 12,5-kHz-Raster"},"145575":{"w":false,"t":"NBFM · 12,5-kHz-Raster"}},"6":{"50500":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"},"50700":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"},"51200":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"},"51400":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"},"51600":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"},"51800":{"w":false,"t":"nur NBFM · AFuV max. 12 kHz"}},"10":{"29000":{"w":true,"t":"Breit-FM möglich · AFuV bis 40 kHz"},"29100":{"w":false,"t":"NBFM · 10-kHz-Raster"},"29520":{"w":false,"t":"NBFM · max. 6 kHz"},"29590":{"w":false,"t":"NBFM · max. 6 kHz"},"29605":{"w":false,"t":"NBFM · max. 6 kHz"},"29615":{"w":false,"t":"NBFM · max. 6 kHz"}},"23":{"1290994":{"w":true,"t":"FM bis 20 kHz Bandbreite · 25-kHz-Raster"},"1296994":{"w":true,"t":"FM bis 20 kHz Bandbreite · 25-kHz-Raster"},"1297494":{"w":true,"t":"FM bis 20 kHz Bandbreite · 25-kHz-Raster"},"1298000":{"w":true,"t":"bis 20 kHz Bandbreite · 25-kHz-Kanäle"},"1299750":{"w":true,"t":"FM bis 20 kHz Bandbreite · 25-kHz-Kanäle"}},"70":{"430000":{"w":false,"t":"NBFM · 12,5-kHz-Raster"},"433000":{"w":false,"t":"NBFM · max. 12 kHz"},"433400":{"w":false,"t":"NBFM · 25-kHz-Raster, max. 12 kHz"},"434600":{"w":false,"t":"NBFM · 12,5-kHz-Raster"},"438650":{"w":false,"t":"NBFM · ältere Relais teils noch breit, Relaisliste prüfen"}}},"dials":{"10":{"sb":"USB","low":false,"edge":29697,"edgeS":"29,697","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 29,697, sonst ragt das Signal über die Bandgrenze 29,700."},"12":{"sb":"USB","low":false,"edge":24987,"edgeS":"24,987","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 24,987, sonst ragt das Signal über die Bandgrenze 24,990."},"15":{"sb":"USB","low":false,"edge":21447,"edgeS":"21,447","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 21,447, sonst ragt das Signal über die Bandgrenze 21,450."},"17":{"sb":"USB","low":false,"edge":18165,"edgeS":"18,165","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 18,165, sonst ragt das Signal über die Bandgrenze 18,168."},"20":{"sb":"USB","low":false,"edge":14347,"edgeS":"14,347","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 14,347, sonst ragt das Signal über die Bandgrenze 14,350."},"40":{"sb":"LSB","low":true,"edge":7053,"edgeS":"7,053","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das LSB-Signal liegt bis ca. 2,7 kHz darunter. Deshalb Dial nicht unter 7,053, sonst liegt das Signal unterhalb des Phonie-Bereichs."},"60":{"sb":"USB","low":false,"edge":5363,"edgeS":"5,363","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das USB-Signal liegt bis ca. 2,7 kHz darüber. Deshalb Dial höchstens 5,363, sonst ragt das Signal über die Bandgrenze 5,3665."},"80":{"sb":"LSB","low":true,"edge":3603,"edgeS":"3,603","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das LSB-Signal liegt bis ca. 2,7 kHz darunter. Deshalb Dial nicht unter 3,603, sonst liegt das Signal unterhalb des Phonie-Bereichs."},"160":{"sb":"LSB","low":true,"edge":1843,"edgeS":"1,843","why":"Bei SSB zeigt das Gerät die Trägerfrequenz, das LSB-Signal liegt bis ca. 2,7 kHz darunter. Deshalb Dial nicht unter 1,843, sonst liegt das Signal unterhalb des Phonie-Bereichs."}}}""")
  let bands = data.bands

  state cls = "A" persist
  state cw = true persist
  state ssb = true persist
  state ft8 = true persist
  state fm = true persist
  state bandId = "40" persist
  state view = "band" persist
  state fromSheet = false
  state q = ""
  state copied = ""

  let klass = cls == "E" || cls == "N" ? cls : "A"
  let b = bands.find(x => x.id == bandId) ?? bands.find(x => x.id == "40")
  let power = get(b.cls, klass, null)
  let who = join(keys(b.cls), " · ")

  let typed = trim(q)
  let t = replace(replace(replace(replace(lower(typed), " ", ""), ",", "."), "khz", ""), "mhz", "")
  let t2 = replace(t, "hz", "")
  let valid = typed != "" && match(t2, '^\d+(\.\d+)?$') != null
  let v = valid ? num(t2) : null
  let asIs = v == null ? null : round(v, 1)
  let asMhz = v == null ? null : round(v * 1000, 1)
  let asHz = v == null ? null : round(v / 1000, 1)
  let primary = v == null ? null : (v < 1000 ? asMhz : (v >= 1000000 ? asHz : asIs))
  let hitPrimary = primary != null && any(bands, x => primary >= x.lo && primary <= x.hi)
  let hitAsIs = asIs != null && any(bands, x => asIs >= x.lo && asIs <= x.hi)
  let hitAsMhz = asMhz != null && any(bands, x => asMhz >= x.lo && asMhz <= x.hi)
  let hitAsHz = asHz != null && any(bands, x => asHz >= x.lo && asHz <= x.hi)
  let hitK = !valid ? null : (hitPrimary ? primary : (hitAsIs ? asIs : (hitAsMhz ? asMhz : (hitAsHz ? asHz : primary))))
  let hitBand = hitK == null ? null : bands.find(x => hitK >= x.lo && hitK <= x.hi)
  let hitSeg = hitBand == null ? null : (hitBand.segs.find(s => hitK >= s.lo && hitK < s.hi) ?? last(hitBand.segs))
  let kind = hitSeg == null ? null : get(data.kinds, hitSeg.k)
  let extraFt8 = kind != null && any(hitBand.mk, m => m.t == "ft8" && m.f >= hitSeg.lo && m.f < hitSeg.hi) && !any(kind.modes, m => m == "ft8")
  let fitNames = kind == null ? [] : kind.modes.map(m => m == "cw" ? "CW" : m == "ssb" ? "SSB" : m == "fm" ? "FM" : "FT8") + (extraFt8 ? ["FT8"] : [])
  let fwCell = hitSeg == null ? null : get(get(data.fw, hitBand.id), hitSeg.lo)
  let kRaw = hitK == null ? "" : fixed(hitK / 1000, 4)
  let kS = kRaw == "" ? "" : replace(endsWith(kRaw, "0") ? sub(kRaw, 0, len(kRaw) - 1) : kRaw, ".", ",")
  let near = !valid || hitBand != null || hitK == null ? null : bands.sortBy(x => min(abs(hitK - x.lo), abs(hitK - x.hi)))[0]
  let tol = hitBand == null ? 0 : (hitBand.g == "KW" ? 3 : 12.5)
  let warnKeep = hitBand == null ? [] : hitBand.mk.filter(m => (m.t == "notfunk" || m.t == "bake") && abs(m.f - hitK) <= tol)
  let dHit = hitBand == null ? null : get(data.dials, hitBand.id)
  let dialHigh = dHit != null && !dHit.low && hitK > dHit.edge
  let dialLow = dHit != null && dHit.low && hitK < dHit.edge && hitK >= dHit.edge - 10
  let classWarn = hitBand != null && get(hitBand.cls, klass, null) == null
  let warns = (!valid || hitBand == null ? [] : (classWarn ? ["${hitBand.name} ist für Klasse ${klass} nicht zugelassen."] : []) + warnKeep.map(m => m.t == "notfunk" ? "Notfunk-Frequenz ${m.fS} in der Nähe, nur im Notfall belegen." : "Bake auf ${m.fS}, nicht senden.") + (dialHigh ? ["USB-Sprache: Dial höchstens ${dHit.edgeS}. Auf ${kS} ragt das Signal über die Bandgrenze ${hitBand.hiS}."] : []) + (dialLow ? ["LSB-Sprache: Dial nicht unter ${dHit.edgeS}. Auf ${kS} liegt das Signal unterhalb des Phonie-Bereichs."] : []))

  let modeMarks = b.mk.filter(m => m.t == "ft8" ? ft8 : m.t == "call" ? ((m.mode == "cw" && cw) || (m.mode == "ssb" && ssb) || (m.mode == "fm" && fm)) : true)
  let dial = get(data.dials, b.id)
  let marksAll = (values(groupBy(modeMarks, m => "${m.f}|${m.l}")).map(g => g[0]) + (ssb && dial != null ? [{f: dial.edge, fS: dial.edgeS, t: "dial", l: dial.low ? "LSB: Dial nicht tiefer" : "USB: Dial nicht höher", mode: "ssb"}] : [])).sortBy(m => m.f)
  let noteList = b.notes + (ssb && dial != null ? [dial.why] : [])

  // Bereiche einer Betriebsart, aneinanderliegende Segmente zu einer Zeile zusammengezogen.
  component GoRows(item, compact) {
    Column {
      gap: 8
      let cwSegs = item.segs.filter(s => s.k == "cw")
      let ssbSegs = item.segs.filter(s => s.k == "ssb" || s.k == "allmode")
      let fmSegs = item.segs.filter(s => s.k == "fm" || s.k == "allmode")
      let cwRanges = reduce(cwSegs, (acc, s) => len(acc) > 0 && abs(last(acc).hi - s.lo) < 0.01 ? set(acc, -1, merge(last(acc), {hi: s.hi, hiS: s.hiS})) : acc + [s], [])
      let ssbRanges = reduce(ssbSegs, (acc, s) => len(acc) > 0 && abs(last(acc).hi - s.lo) < 0.01 ? set(acc, -1, merge(last(acc), {hi: s.hi, hiS: s.hiS})) : acc + [s], [])
      let fmRanges = reduce(fmSegs, (acc, s) => len(acc) > 0 && abs(last(acc).hi - s.lo) < 0.01 ? set(acc, -1, merge(last(acc), {hi: s.hi, hiS: s.hiS})) : acc + [s], [])
      let cwCalls = item.mk.filter(m => m.t == "call" && m.mode == "cw")
      let ssbCalls = item.mk.filter(m => m.t == "call" && m.mode == "ssb")
      let fmCalls = item.mk.filter(m => m.t == "call" && m.mode == "fm")
      let ft8s = item.mk.filter(m => m.t == "ft8")
      let dial = get(data.dials, item.id)
      let fwMap = get(data.fw, item.id)
      let fwVals = fwMap == null ? [] : values(fwMap)
      let wideSegs = fwMap == null ? [] : item.segs.filter(s => get(fwMap, s.lo).w == true)
      let fmNote = len(fwVals) == 0 ? "" : (all(fwVals, f => f.w) ? "FM bis 20 kHz Bandbreite, Breit-FM (±5 kHz) zulässig" : (len(wideSegs) > 0 ? "Schmalband-FM (NBFM). Breit-FM nur " + join(wideSegs.map(s => "${s.loS}–${s.hiS}"), ", ") : "Nur Schmalband-FM (NBFM, ±2,5 kHz Hub)"))
      if cw {
        Column {
          gap: 1
          Text { text: "CW"; style: small; bold: true; color: #6a9bf0 }
          if len(cwRanges) == 0 {
            Text { text: "überall außer Baken"; style: small }
          } else {
            for r in cwRanges key "c${r.lo}" {
              Text {
                text: "${r.loS}–${r.hiS}"
                font: mono
                style: small
                onTap: { copy("${r.loS}–${r.hiS}"); copied = "${r.loS}–${r.hiS}"; haptic() }
              }
            }
            if !compact {
              Text { text: "CW ist überall erlaubt, außer in Bakenbereichen"; style: small; color: muted }
            }
            if len(cwCalls) > 0 {
              Text { text: "Anruf ${join(cwCalls.map(c => c.fS), ", ")}"; style: small; color: muted }
            }
          }
        }
      }
      if ssb {
        Column {
          gap: 1
          Text { text: "SSB"; style: small; bold: true; color: #47bf86 }
          if len(ssbRanges) == 0 {
            Text { text: item.id == "30" ? "nicht erlaubt" : "nicht vorgesehen"; style: small; color: muted }
          } else {
            for r in ssbRanges key "s${r.lo}" {
              Text {
                text: "${r.loS}–${r.hiS}"
                font: mono
                style: small
                onTap: { copy("${r.loS}–${r.hiS}"); copied = "${r.loS}–${r.hiS}"; haptic() }
              }
            }
            if dial != null {
              Text {
                text: compact ? (dial.low ? "LSB · Dial ab ${dial.edgeS}" : "USB · Dial bis ${dial.edgeS}") : (dial.low ? "LSB · Dial nicht unter ${dial.edgeS}, das Signal liegt bis ca. 3 kHz darunter" : "USB · Dial höchstens ${dial.edgeS}, sonst ragt das Signal über die Bandgrenze ${item.hiS}")
                style: small
                color: muted
              }
            }
            if len(ssbCalls) > 0 {
              Text { text: "Anruf ${join(ssbCalls.map(c => c.fS), ", ")}"; style: small; color: muted }
            }
          }
        }
      }
      if ft8 {
        Column {
          gap: 1
          Text { text: "FT8"; style: small; bold: true; color: #a585ec }
          if len(ft8s) == 0 {
            Text { text: "nicht vorgesehen"; style: small; color: muted }
          } else {
            for m in ft8s key "t${m.f}" {
              Text {
                text: m.fS
                font: mono
                style: small
                onTap: { copy(m.fS); copied = m.fS; haptic() }
              }
            }
            if !compact {
              Text { text: "Dial-Frequenz, USB"; style: small; color: muted }
            }
          }
        }
      }
      if fm {
        Column {
          gap: 1
          Text { text: "FM"; style: small; bold: true; color: #f2894a }
          if len(fmRanges) == 0 {
            Text { text: "nicht vorgesehen"; style: small; color: muted }
          } else {
            for r in fmRanges key "f${r.lo}" {
              Text {
                text: "${r.loS}–${r.hiS}"
                font: mono
                style: small
                onTap: { copy("${r.loS}–${r.hiS}"); copied = "${r.loS}–${r.hiS}"; haptic() }
              }
            }
            if fmNote != "" {
              Text { text: fmNote; style: small; color: muted }
            }
            if len(fmCalls) > 0 {
              Text { text: "Anruf ${join(fmCalls.map(c => c.fS), ", ")}"; style: small; color: muted }
            }
          }
        }
      }
    }
  }

  Column {
    padding: [12, 4, 12, 0]
    gap: 8
    Row {
      gap: 6
      align: center
      Text {
        text: "A"
        style: small
        bold: klass == "A"
        align: center
        color: klass == "A" ? #1a1208 : foreground
        background: klass == "A" ? accent : alpha(foreground, 0.08)
        padding: [12, 6]
        radius: 8 * corners
        onTap: { cls = "A"; haptic() }
      }
      Text {
        text: "E"
        style: small
        bold: klass == "E"
        align: center
        color: klass == "E" ? #1a1208 : foreground
        background: klass == "E" ? accent : alpha(foreground, 0.08)
        padding: [12, 6]
        radius: 8 * corners
        onTap: { cls = "E"; haptic() }
      }
      Text {
        text: "N"
        style: small
        bold: klass == "N"
        align: center
        color: klass == "N" ? #1a1208 : foreground
        background: klass == "N" ? accent : alpha(foreground, 0.08)
        padding: [12, 6]
        radius: 8 * corners
        onTap: { cls = "N"; haptic() }
      }
      Spacer { weight: 1 }
      Text {
        text: "Band"
        style: small
        bold: view == "band"
        align: center
        color: view == "band" ? #1a1208 : foreground
        background: view == "band" ? accent : alpha(foreground, 0.08)
        padding: [10, 6]
        radius: 8 * corners
        onTap: { view = "band"; fromSheet = false; haptic() }
      }
      Text {
        text: "Spick"
        style: small
        bold: view == "sheet"
        align: center
        color: view == "sheet" ? #1a1208 : foreground
        background: view == "sheet" ? accent : alpha(foreground, 0.08)
        padding: [10, 6]
        radius: 8 * corners
        onTap: { view = "sheet"; fromSheet = false; haptic() }
      }
    }
    Flow {
      gap: 6
      Text {
        text: "CW"
        style: small
        bold: cw
        color: cw ? #1a1208 : #6a9bf0
        background: cw ? #6a9bf0 : alpha(#6a9bf0, 0.16)
        padding: [10, 5]
        radius: 8 * corners
        onTap: { cw = !cw || !(ssb || ft8 || fm); haptic() }
      }
      Text {
        text: "SSB"
        style: small
        bold: ssb
        color: ssb ? #1a1208 : #47bf86
        background: ssb ? #47bf86 : alpha(#47bf86, 0.16)
        padding: [10, 5]
        radius: 8 * corners
        onTap: { ssb = !ssb || !(cw || ft8 || fm); haptic() }
      }
      Text {
        text: "FT8"
        style: small
        bold: ft8
        color: ft8 ? #1a1208 : #a585ec
        background: ft8 ? #a585ec : alpha(#a585ec, 0.16)
        padding: [10, 5]
        radius: 8 * corners
        onTap: { ft8 = !ft8 || !(cw || ssb || fm); haptic() }
      }
      Text {
        text: "FM"
        style: small
        bold: fm
        color: fm ? #1a1208 : #f2894a
        background: fm ? #f2894a : alpha(#f2894a, 0.16)
        padding: [10, 5]
        radius: 8 * corners
        onTap: { fm = !fm || !(cw || ssb || ft8); haptic() }
      }
    }
    Flow {
      gap: 6
      Text { text: "KW"; style: small; color: muted; padding: [2, 6] }
      for item in bands.filter(x => x.g == "KW") key item.id {
        Text {
          text: item.name
          style: small
          bold: view == "band" && bandId == item.id
          color: view == "band" && bandId == item.id ? #1a1208 : foreground
          background: view == "band" && bandId == item.id ? accent : alpha(foreground, 0.08)
          opacity: get(item.cls, klass, null) == null && !(view == "band" && bandId == item.id) ? 0.4 : 1
          padding: [8, 5]
          radius: 8 * corners
          onTap: { bandId = item.id; view = "band"; fromSheet = false; haptic() }
        }
      }
    }
    Flow {
      gap: 6
      Text { text: "UKW"; style: small; color: muted; padding: [2, 6] }
      for item in bands.filter(x => x.g == "UKW") key item.id {
        Text {
          text: item.name
          style: small
          bold: view == "band" && bandId == item.id
          color: view == "band" && bandId == item.id ? #1a1208 : foreground
          background: view == "band" && bandId == item.id ? accent : alpha(foreground, 0.08)
          opacity: get(item.cls, klass, null) == null && !(view == "band" && bandId == item.id) ? 0.4 : 1
          padding: [8, 5]
          radius: 8 * corners
          onTap: { bandId = item.id; view = "band"; fromSheet = false; haptic() }
        }
      }
    }
    Row {
      gap: 8
      align: center
      Input {
        weight: 1
        text: q
        placeholder: "Frequenz: 145,500 oder 7074"
        onChange: q = value
        onSubmit: { bandId = hitBand != null ? hitBand.id : bandId; view = hitBand != null ? "band" : view; fromSheet = false }
      }
      if typed != "" {
        Text { text: "×"; fontSize: 22; color: muted; padding: [8, 2]; onTap: { q = ""; copied = "" } }
      }
    }
    if copied != "" {
      Text { text: "kopiert: ${copied}"; style: small; color: accent }
    }
    if typed != "" {
      Column {
        gap: 3
        padding: 10
        radius: 8 * corners
        background: !valid || hitBand == null ? alpha(#ef6363, 0.14) : alpha(kind.c, 0.16)
        border: 1.5
        borderColor: !valid || hitBand == null ? #ef6363 : kind.c
        if !valid {
          Text { text: "Bitte eine Zahl eingeben, zum Beispiel 14074 (kHz) oder 145,500 (MHz)."; style: small }
        } else if hitBand == null {
          Text { text: "${kS} MHz liegt außerhalb der Bänder auf dieser Seite."; bold: true }
          Text { text: "Nächstes Band: ${near.name} (${near.loS}–${near.hiS} MHz)."; style: small; color: muted }
        } else {
          Text { text: "${kS} MHz · ${hitBand.name} · ${hitSeg.l}"; bold: true; maxLines: 3 }
          Text { text: "${hitSeg.loS}–${hitSeg.hiS} MHz · ${kind.n}"; font: mono; style: small; color: muted; maxLines: 2 }
          Text { text: kind.ex ? "Hier kein eigener Betrieb." : "Passend für: ${join(fitNames, ", ")}"; style: small }
          if fwCell != null {
            Text { text: "FM-Bandbreite: ${fwCell.t}"; style: small }
          }
          for w, i in warns key "${i}" {
            Text { text: w; style: small; bold: true; color: #ef6363; maxLines: 4 }
          }
          Text {
            text: "Im Band zeigen"
            style: small
            bold: true
            color: #1a1208
            background: accent
            padding: [10, 6]
            radius: 6 * corners
            onTap: { bandId = hitBand.id; view = "band"; fromSheet = false; haptic() }
          }
        }
      }
    }
    Column {
      scroll: true
      weight: 1
      gap: 10
      if view == "sheet" {
        for item in bands key item.id {
          Column {
            gap: 6
            padding: 10
            radius: 8 * corners
            background: alpha(foreground, 0.05)
            onTap: { bandId = item.id; view = "band"; fromSheet = true; haptic() }
            let cardPower = get(item.cls, klass, null)
            let keep = item.mk.filter(m => m.t == "notfunk" || m.t == "bake")
            Row {
              align: center
              gap: 8
              Text { text: item.name; bold: true }
              Spacer { weight: 1 }
              Text { text: "${item.loS}–${item.hiS}"; font: mono; style: small; color: muted }
            }
            Text {
              text: cardPower != null ? "Klasse ${klass}: ${cardPower}" : "nicht für Klasse ${klass}"
              style: small
              color: cardPower != null ? foreground : #ef6363
            }
            GoRows { item: item; compact: true }
            if len(keep) > 0 {
              Flow {
                gap: 4
                for m in keep key "${m.f}${m.t}" {
                  Text {
                    text: "${m.fS} ${m.l}"
                    style: small
                    maxLines: 2
                    color: m.t == "notfunk" ? #1a1208 : #ef6363
                    background: m.t == "notfunk" ? #ef6363 : alpha(#ef6363, 0.12)
                    border: m.t == "bake" ? 1 : 0
                    borderColor: #ef6363
                    padding: [6, 2]
                    radius: 4 * corners
                  }
                }
              }
            }
          }
        }
      } else {
        Column {
          gap: 2
          Row {
            align: bottom
            gap: 8
            Text { text: b.name; style: title; weight: 1 }
            Text { text: "${b.loS}–${b.hiS}"; font: mono; color: muted }
          }
          Text {
            text: power != null ? "Klasse ${klass}: ${power}" : "Nicht für Klasse ${klass}"
            bold: true
            color: power != null ? foreground : #ef6363
          }
          Text { text: "Zugelassen: ${who}"; style: small; color: muted }
          if power == null {
            Text {
              text: "Mit Klasse ${klass} darfst du auf ${b.name} nicht senden. Zugelassen: Klasse ${replace(who, " · ", ", ")}."
              style: small
              color: #ef6363
              maxLines: 3
            }
          }
        }
        Row {
          height: 10
          clip: true
          radius: 4 * corners
          for s in b.segs key "bar${s.lo}" {
            Box { weight: max(s.hi - s.lo, 0.1); height: 10; background: get(data.kinds, s.k).c }
          }
        }
        for s in b.segs key "${s.lo}" {
          Column {
            let info = get(data.kinds, s.k)
            let hasFt8 = ft8 && any(b.mk, m => m.t == "ft8" && m.f >= s.lo && m.f < s.hi)
            let on = !info.ex && (any(info.modes, m => (m == "cw" && cw) || (m == "ssb" && ssb) || (m == "fm" && fm) || (m == "ft8" && ft8)) || hasFt8)
            let dim = !info.ex && !on
            let here = hitBand != null && hitBand.id == b.id && hitK >= s.lo && (hitK < s.hi || (hitK == b.hi && s.hi == b.hi))
            let pills = marksAll.filter(m => m.f >= s.lo && (m.f < s.hi || (m.f == b.hi && s.hi == b.hi)))
            let cell = get(get(data.fw, b.id), s.lo)
            Row {
              gap: 8
              align: top
              padding: [8, 8]
              radius: 8 * corners
              background: here ? alpha(info.c, 0.3) : alpha(info.c, info.ex ? 0.08 : 0.14)
              opacity: dim ? 0.4 : 1
              border: here ? 1.5 : 0
              borderColor: info.c
              onTap: { copy("${s.loS}–${s.hiS}"); copied = "${s.loS}–${s.hiS}"; haptic() }
              Box { width: 6; height: 28; radius: 3; background: info.c }
              Column {
                weight: 1
                gap: 2
                Text { text: s.l; bold: true; maxLines: 3 }
                Text { text: "${s.loS}–${s.hiS} · ${info.n}"; font: mono; style: small; color: muted; maxLines: 2 }
                if fm && cell != null {
                  Text { text: cell.t; style: small; bold: true; color: #f2894a; maxLines: 2 }
                }
                if len(pills) > 0 {
                  Flow {
                    gap: 4
                    for m in pills key "${m.f}${m.l}" {
                      Text {
                        text: "${m.fS} ${m.l}"
                        style: small
                        maxLines: 2
                        padding: [6, 2]
                        radius: 4 * corners
                        color: m.t == "ft8" || m.t == "notfunk" ? #1a1208 : (m.t == "bake" ? #ef6363 : foreground)
                        background: m.t == "ft8" ? #a585ec : (m.t == "notfunk" ? #ef6363 : (m.t == "call" ? alpha(accent, 0.28) : alpha(foreground, 0.08)))
                        border: m.t == "bake" || m.t == "dial" ? 1 : 0
                        borderColor: m.t == "bake" ? #ef6363 : accent
                        onTap: { copy(m.fS); copied = m.fS; haptic() }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Column {
          gap: 6
          padding: 10
          radius: 8 * corners
          background: alpha(foreground, 0.05)
          Text { text: "Hier kannst du funken · MHz"; style: label; color: muted }
          GoRows { item: b; compact: false }
        }
        if len(b.mk.filter(m => m.t == "notfunk" || m.t == "bake")) > 0 {
          Column {
            gap: 6
            padding: 10
            radius: 8 * corners
            background: alpha(foreground, 0.05)
            Text { text: "Freihalten"; style: label; color: muted }
            Flow {
              gap: 4
              for m in b.mk.filter(m => m.t == "notfunk" || m.t == "bake") key "keep${m.f}${m.t}" {
                Text {
                  text: "${m.fS} ${m.l}"
                  style: small
                  maxLines: 2
                  padding: [6, 2]
                  radius: 4 * corners
                  color: m.t == "notfunk" ? #1a1208 : #ef6363
                  background: m.t == "notfunk" ? #ef6363 : alpha(#ef6363, 0.12)
                  border: m.t == "bake" ? 1 : 0
                  borderColor: #ef6363
                  onTap: { copy(m.fS); copied = m.fS; haptic() }
                }
              }
            }
          }
        }
        if len(noteList) > 0 {
          Column {
            gap: 4
            padding: 10
            radius: 8 * corners
            background: alpha(foreground, 0.05)
            Text { text: "Hinweise ${b.name}"; style: label; color: muted }
            for n, i in noteList key "${i}" {
              Text { text: n; style: small; maxLines: 8 }
            }
          }
        }
        Flow {
          gap: 8
          Text { text: "CW"; style: small; color: #6a9bf0 }
          Text { text: "Digi"; style: small; color: #a585ec }
          Text { text: "SSB"; style: small; color: #47bf86 }
          Text { text: "All"; style: small; color: #3cbaae }
          Text { text: "FM"; style: small; color: #f2894a }
          Text { text: "Relais"; style: small; color: #8b969e }
          Text { text: "Bake"; style: small; color: #ef6363 }
          Text { text: "Sat"; style: small; color: #d8b03e }
        }
      }
      Text {
        text: "Bandplan DL 1.3.0 · IARU-Empfehlung, verbindlich ist die AFuV. Tippen kopiert eine Frequenz."
        style: small
        color: muted
        maxLines: 3
        onTap: url("https://github.com/mooxle/bandplan-dl")
      }
      Spacer { height: screenInset + 16 }
    }
  }
}
